  6: type BackendUser = {
  7:   id: string;
  8:   email: string;
  9:   name?: string | null;
 10:   image?: string | null;
 11:   role?: string | null;
 12: };
 13: type BackendResponse = {
 14:   success: boolean;
 15:   message?: string;
 16:   data?: {
 17:     user?: BackendUser;
 18:   };
 19: };
 20: const resolvedNextAuthSecret = process.env.NEXTAUTH_SECRET;
 21: if (!resolvedNextAuthSecret) {
 22:   throw new Error(
 23:     "NEXTAUTH_SECRET is required for authentication. Please configure apps/frontend/.env.local and restart the dev server."
 24:   );
 25: }
 26: const nextAuthSecret = resolvedNextAuthSecret;
 27: const apiBaseUrl =
 28:   process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:5000/api";
 29: function buildBackendAccessToken(payload: {
 30:   sub?: string | null;
 31:   email?: string | null;
 32:   role?: string | null;
 33: }): string | undefined {
 34:   if (!payload.sub) {
 35:     return undefined;
 36:   }
 37:   try {
 38:     return jwt.sign(
 39:       {
 40:         sub: payload.sub,
 41:         email: payload.email ?? undefined,
 42:         role: payload.role ?? "RESEARCHER",
 43:       },
 44:       nextAuthSecret,
 45:       { expiresIn: "1h" }
 46:     );
 47:   } catch (error) {
 48:     if (process.env.NODE_ENV === "development") {
 49:       console.error("Failed to sign backend access token", error);
 50:     }
 51:     return undefined;
 52:   }
 53: }
 54: async function authenticateWithCredentials(
 55:   email: string,
 56:   password: string
 57: ): Promise<BackendUser> {
 58:   const response = await fetch(`${apiBaseUrl}/auth/signin`, {
 59:     method: "POST",
 60:     headers: { "Content-Type": "application/json" },
 61:     body: JSON.stringify({ email, password }),
 62:   });
 63:   if (!response.ok) {
 64:     let message = "Invalid email or password";
 65:     try {
 66:       const errorBody = (await response.json()) as BackendResponse;
 67:       message = errorBody.message || message;
 68:     } catch {
 69:     }
 70:     throw new Error(message);
 71:   }
 72:   const body = (await response.json()) as BackendResponse;
 73:   const user = body?.data?.user;
 74:   if (!user) {
 75:     throw new Error(
 76:       "Authentication succeeded but no user information was returned"
 77:     );
 78:   }
 79:   return user;
 80: }
 81: async function syncOAuthUser(params: {
 82:   user: BackendUser;
 83:   account: Account | null | undefined;
 84:   profile: Profile | undefined;
 85: }): Promise<BackendUser | null> {
 86:   const { user, account, profile } = params;
 87:   if (!account) {
 88:     return null;
 89:   }
 90:   const profileData = profile as Record<string, unknown> | undefined;
 91:   const response = await fetch(`${apiBaseUrl}/auth/oauth/signin`, {
 92:     method: "POST",
 93:     headers: { "Content-Type": "application/json" },
 94:     body: JSON.stringify({
 95:       profile: {
 96:         email: user.email,
 97:         name: user.name,
 98:         image: user.image,
 99:         picture: profileData?.["picture"],
100:         avatar_url: profileData?.["avatar_url"],
101:       },
102:       account: {
103:         type: account["type"] ?? "oauth",
104:         provider: account["provider"] ?? "unknown",
105:         providerAccountId:
106:           (account["providerAccountId"] as string | undefined) ?? user.id,
107:         refresh_token: account["refresh_token"],
108:         access_token: account["access_token"],
109:         expires_at: account["expires_at"],
110:         token_type: account["token_type"],
111:         scope: account["scope"],
112:         id_token: account["id_token"],
113:         session_state: account["session_state"],
114:       },
115:     }),
116:   });
117:   if (!response.ok) {
118:     if (process.env.NODE_ENV === "development") {
119:       console.error(
120:         "Failed to sync OAuth user with backend",
121:         await response.text()
122:       );
123:     }
124:     return null;
125:   }
126:   const body = (await response.json()) as BackendResponse;
127:   return body?.data?.user ?? null;
128: }
129: export const authOptions: NextAuthOptions = {
130:   secret: nextAuthSecret,
131:   session: {
132:     strategy: "jwt",
133:     maxAge: 60 * 60,
134:   },
135:   pages: {
136:     signIn: "/login",
137:     error: "/auth/error",
138:   },
139:   providers: [
140:     CredentialsProvider({
141:       name: "Credentials",
142:       credentials: {
143:         email: { label: "Email", type: "email" },
144:         password: { label: "Password", type: "password" },
145:       },
146:       async authorize(credentials) {
147:         const email = credentials?.email;
148:         const password = credentials?.password;
149:         if (!email || !password) {
150:           throw new Error("Please provide both email and password");
151:         }
152:         const backendUser = await authenticateWithCredentials(email, password);
153:         return {
154:           id: backendUser.id,
155:           email: backendUser.email,
156:           name: backendUser.name ?? null,
157:           image: backendUser.image ?? null,
158:           role: backendUser.role ?? "RESEARCHER",
159:         };
160:       },
161:     }),
162:     GoogleProvider({
163:       clientId: process.env.GOOGLE_CLIENT_ID ?? "",
164:       clientSecret: process.env.GOOGLE_CLIENT_SECRET ?? "",
165:     }),
166:     GitHubProvider({
167:       clientId: process.env.GITHUB_CLIENT_ID ?? "",
168:       clientSecret: process.env.GITHUB_CLIENT_SECRET ?? "",
169:     }),
170:   ],
171:   callbacks: {
172:     async signIn({ user, account, profile }) {
173:       if (account?.provider === "credentials") {
174:         return true;
175:       }
176:       const backendUser = await syncOAuthUser({ user, account, profile });
177:       if (backendUser) {
178:         user.id = backendUser.id;
179:         user.role = backendUser.role ?? "RESEARCHER";
180:         user.email = backendUser.email;
181:         user.name = backendUser.name ?? null;
182:         user.image = backendUser.image ?? null;
183:         return true;
184:       }
185:       return false;
186:     },
187:     async jwt({ token, user }) {
188:       if (user) {
189:         token.id = user.id;
190:         token.sub = user.id;
191:         token.email = user.email;
192:         token.name = user.name;
193:         token.picture = user.image;
194:         token.role = user.role ?? "RESEARCHER";
195:       }
196:       token.backendAccessToken = buildBackendAccessToken({
197:         sub: token.sub as string | undefined,
198:         email: token.email as string | undefined,
199:         role: token.role as string | undefined,
200:       });
201:       return token;
202:     },
203:     async session({ session, token }) {
204:       if (token?.sub) {
205:         session.user = {
206:           id: token.sub,
207:           email: (token.email as string) ?? "",
208:           name: (token.name as string | null | undefined) ?? null,
209:           image: (token.picture as string | null | undefined) ?? null,
210:           role: (token.role as string | undefined) ?? "RESEARCHER",
211:         };
212:       }
213:       if (token?.backendAccessToken) {
214:         session.accessToken = token.backendAccessToken;
215:       } else {
216:         delete session.accessToken;
217:       }
218:       return session;
219:     },
220:   },
221:   events: {
222:     async signOut() {
223:       return;
224:     },
225:   },
226: };
