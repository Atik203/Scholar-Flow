1679:   if (!pdfBrowserPromise) {
1680:     pdfBrowserPromise = puppeteer
1681:       .launch({
1682:         headless: true,
1683:         args: [
1684:           "--no-sandbox",
1685:           "--disable-setuid-sandbox",
1686:           "--disable-dev-shm-usage",
1687:         ],
1688:       })
1689:       .catch((error) => {
1690:         pdfBrowserPromise = null;
1691:         throw error;
1692:       });
