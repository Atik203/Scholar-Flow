<file path="apps/backend/src/app/modules/Admin/analytics.service.ts">
  1: import prisma from "../../shared/prisma";
  2: export const analyticsService = {
  3:   async getRevenueAnalytics(timeRange: "7d" | "30d" | "90d" | "1y" = "30d") {
  4:     const now = new Date();
  5:     const rangeMap = {
  6:       "7d": 7,
  7:       "30d": 30,
  8:       "90d": 90,
  9:       "1y": 365,
 10:     };
 11:     const days = rangeMap[timeRange];
 12:     const startDate = new Date(now.getTime() - days * 24 * 60 * 60 * 1000);
 13:     const subscriptionStats = await prisma.$queryRaw<
 14:       Array<{ status: string; count: bigint }>
 15:     >`
 16:       SELECT
 17:         status::text,
 18:         COUNT(*)::bigint as count
 19:       FROM "Subscription"
 20:       WHERE "isDeleted" = false
 21:       GROUP BY status
 22:     `;
 23:     const subscriptionsByPlan = await prisma.$queryRaw<
 24:       Array<{ planName: string; count: bigint }>
 25:     >`
 26:       SELECT
 27:         p.name as "planName",
 28:         COUNT(s.id)::bigint as count
 29:       FROM "Subscription" s
 30:       JOIN "Plan" p ON s."planId" = p.id
 31:       WHERE s."isDeleted" = false
 32:         AND s.status = 'ACTIVE'
 33:       GROUP BY p.name
 34:       ORDER BY count DESC
 35:     `;
 36:     const mrrData = await prisma.$queryRaw<
 37:       Array<{ totalMrr: string; currency: string }>
 38:     >`
 39:       SELECT
 40:         SUM(
 41:           CASE
 42:             WHEN p.interval = 'month' THEN p."priceCents"
 43:             WHEN p.interval = 'year' THEN p."priceCents" / 12
 44:             ELSE 0
 45:           END
 46:         )::numeric / 100 as "totalMrr",
 47:         p.currency
 48:       FROM "Subscription" s
 49:       JOIN "Plan" p ON s."planId" = p.id
 50:       WHERE s."isDeleted" = false
 51:         AND s.status = 'ACTIVE'
 52:         AND s."cancelAtPeriodEnd" = false
 53:       GROUP BY p.currency
 54:     `;
 55:     const arr =
 56:       mrrData.length > 0 ? parseFloat(mrrData[0].totalMrr || "0") * 12 : 0;
 57:     const mrr = mrrData.length > 0 ? parseFloat(mrrData[0].totalMrr || "0") : 0;
 58:     const revenueData = await prisma.$queryRaw<
 59:       Array<{ totalRevenue: string; currency: string }>
 60:     >`
 61:       SELECT
 62:         SUM("amountCents")::numeric / 100 as "totalRevenue",
 63:         currency
 64:       FROM "Payment"
 65:       WHERE status = 'SUCCEEDED'
 66:         AND "createdAt" >= ${startDate}
 67:       GROUP BY currency
 68:     `;
 69:     const revenueTrend = await prisma.$queryRaw<
 70:       Array<{ date: Date; revenue: string; count: bigint }>
 71:     >`
 72:       SELECT
 73:         DATE("createdAt") as date,
 74:         SUM("amountCents")::numeric / 100 as revenue,
 75:         COUNT(*)::bigint as count
 76:       FROM "Payment"
 77:       WHERE status = 'SUCCEEDED'
 78:         AND "createdAt" >= ${startDate}
 79:       GROUP BY DATE("createdAt")
 80:       ORDER BY date ASC
 81:     `;
 82:     const failedPayments = await prisma.$queryRaw<Array<{ count: bigint }>>`
 83:       SELECT COUNT(*)::bigint as count
 84:       FROM "Payment"
 85:       WHERE status = 'FAILED'
 86:         AND "createdAt" >= ${startDate}
 87:     `;
 88:     const newSubscriptions = await prisma.$queryRaw<Array<{ count: bigint }>>`
 89:       SELECT COUNT(*)::bigint as count
 90:       FROM "Subscription"
 91:       WHERE "createdAt" >= ${startDate}
 92:         AND "isDeleted" = false
 93:     `;
 94:     const canceledSubscriptions = await prisma.$queryRaw<
 95:       Array<{ count: bigint }>
 96:     >`
 97:       SELECT COUNT(*)::bigint as count
 98:       FROM "Subscription"
 99:       WHERE "canceledAt" >= ${startDate}
100:         AND "isDeleted" = false
101:     `;
102:     const arpuData = await prisma.$queryRaw<
103:       Array<{ arpu: string; activeUsers: bigint }>
104:     >`
105:       SELECT
106:         (SUM(p."priceCents")::numeric / COUNT(DISTINCT s."userId")::numeric / 100) as arpu,
107:         COUNT(DISTINCT s."userId")::bigint as "activeUsers"
108:       FROM "Subscription" s
109:       JOIN "Plan" p ON s."planId" = p.id
110:       WHERE s."isDeleted" = false
111:         AND s.status = 'ACTIVE'
112:         AND s."cancelAtPeriodEnd" = false
113:     `;
114:     const churnData = await prisma.$queryRaw<
115:       Array<{ churnRate: string; canceled: bigint; totalActive: bigint }>
116:     >`
117:       WITH canceled_in_period AS (
118:         SELECT COUNT(*)::bigint as canceled
119:         FROM "Subscription"
120:         WHERE "canceledAt" >= ${startDate}
121:           AND "isDeleted" = false
122:       ),
123:       active_at_start AS (
124:         SELECT COUNT(*)::bigint as "totalActive"
125:         FROM "Subscription"
126:         WHERE "createdAt" < ${startDate}
127:           AND "isDeleted" = false
128:           AND (status = 'ACTIVE' OR "canceledAt" >= ${startDate})
129:       )
130:       SELECT
131:         CASE
132:           WHEN a."totalActive" > 0
133:           THEN (c.canceled::numeric / a."totalActive"::numeric * 100)::text
134:           ELSE '0'
135:         END as "churnRate",
136:         c.canceled,
137:         a."totalActive"
138:       FROM canceled_in_period c, active_at_start a
139:     `;
140:     return {
141:       mrr: {
142:         amount: mrr,
143:         currency: mrrData[0]?.currency || "USD",
144:       },
145:       arr: {
146:         amount: arr,
147:         currency: mrrData[0]?.currency || "USD",
148:       },
149:       totalRevenue: {
150:         amount:
151:           revenueData.length > 0 ? parseFloat(revenueData[0].totalRevenue) : 0,
152:         currency: revenueData[0]?.currency || "USD",
153:         period: timeRange,
154:       },
155:       subscriptions: {
156:         byStatus: subscriptionStats.map((s) => ({
157:           status: s.status,
158:           count: Number(s.count),
159:         })),
160:         byPlan: subscriptionsByPlan.map((p) => ({
161:           plan: p.planName,
162:           count: Number(p.count),
163:         })),
164:         new: Number(newSubscriptions[0]?.count || 0),
165:         canceled: Number(canceledSubscriptions[0]?.count || 0),
166:       },
167:       payments: {
168:         failed: Number(failedPayments[0]?.count || 0),
169:       },
170:       metrics: {
171:         arpu:
172:           arpuData.length > 0 && arpuData[0].arpu
173:             ? parseFloat(arpuData[0].arpu)
174:             : 0,
175:         activeUsers: Number(arpuData[0]?.activeUsers || 0),
176:         churnRate:
177:           churnData.length > 0 && churnData[0].churnRate
178:             ? parseFloat(churnData[0].churnRate)
179:             : 0,
180:       },
181:       revenueTrend: revenueTrend.map((r) => ({
182:         date: r.date.toISOString().split("T")[0],
183:         revenue: parseFloat(r.revenue),
184:         transactionCount: Number(r.count),
185:       })),
186:       timeRange,
187:     };
