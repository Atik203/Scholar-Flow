216: async function fetchDataCiteByDoi(doi: string): Promise<{
217:   title: string;
218:   authors: string[];
219:   year: number | null;
220:   abstract: string;
221: }> {
222:   const res = await axios.get(
223:     `https://api.datacite.org/dois/${encodeURIComponent(doi)}`,
224:     { timeout: 8000 },
225:   );
226:   const attrs = res.data?.data?.attributes;
227:   if (!attrs) throw new Error(`DataCite: no record for ${doi}`);
228:   const creators = (attrs.creators || [])
229:     .map(
230:       (c: any) =>
231:         c?.name || `${c?.givenName || ""} ${c?.familyName || ""}`.trim(),
232:     )
233:     .filter(Boolean);
234:   const abstractEntry = (attrs.descriptions || []).find(
235:     (d: any) => (d?.descriptionType || "").toLowerCase() === "abstract",
236:   );
237:   return {
238:     title: attrs.titles?.[0]?.title || "",
239:     authors: creators,
240:     year: attrs.publicationYear
241:       ? parseInt(attrs.publicationYear, 10)
242:       : null,
243:     abstract: abstractEntry?.description
244:       ? stripHtmlTags(decodeEntities(abstractEntry.description))
245:       : "",
246:   };
247: }
248: /**
249:  * OpenAlex — free gap-fill source when Crossref/DataCite lack an abstract
250:  * or authors. Reconstructs the abstract from abstract_inverted_index.
251:  */
252: async function fetchOpenAlexByDoi(doi: string): Promise<{
253:   title: string;
254:   authors: string[];
255:   year: number | null;
256:   abstract: string;
257:   citedBy: number;
258: } | null> {
259:   const res = await axios.get(
260:     `https://api.openalex.org/works/doi:${encodeURIComponent(doi)}`,
261:     { timeout: 8000 },
262:   );
263:   const work = res.data;
264:   if (!work?.title) return null;
265:   const inverted: Record<string, number[]> | null =
266:     work.abstract_inverted_index || null;
267:   let abstract = "";
268:   if (inverted) {
269:     const words: Array<{ pos: number; word: string }> = [];
270:     for (const [word, positions] of Object.entries(inverted)) {
271:       for (const pos of positions) words.push({ pos, word });
272:     }
273:     abstract = words
274:       .sort((a, b) => a.pos - b.pos)
275:       .map((w) => w.word)
276:       .join(" ");
277:   }
278:   return {
279:     title: work.title,
280:     authors: (work.authorships || [])
281:       .map((a: any) => a?.author?.display_name)
282:       .filter(Boolean),
283:     year: work.publication_year || null,
284:     abstract,
285:     citedBy: work.cited_by_count || 0,
286:   };
287: }
