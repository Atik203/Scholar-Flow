 591:   async getSummarySourceText(
 592:     paperId: string,
 593:     record: PaperSummaryRecord
 594:   ): Promise<{
 595:     text: string;
 596:     source: "chunks" | "content" | "abstract" | "metadata" | "empty";
 597:     chunkCount: number;
 598:   }> {
 599:     const chunks = await prisma.$queryRaw<Array<{ content: string }>>`
 600:       SELECT content
 601:       FROM "PaperChunk"
 602:       WHERE "paperId" = ${paperId} AND "isDeleted" = false
 603:       ORDER BY idx ASC
 604:       LIMIT 200
 605:     `;
 606:     const chunkText = chunks
 607:       .map((chunk) => chunk.content?.trim())
 608:       .filter((content): content is string => Boolean(content))
 609:       .join("\n\n");
 610:     if (chunkText) {
 611:       return {
 612:         text: truncateText(chunkText, MAX_SUMMARY_SOURCE_LENGTH),
 613:         source: "chunks",
 614:         chunkCount: chunks.length,
 615:       };
 616:     }
 617:     const contentText = htmlToPlainText(record.contentHtml);
 618:     if (contentText) {
 619:       return {
 620:         text: truncateText(contentText, MAX_SUMMARY_SOURCE_LENGTH),
 621:         source: "content",
 622:         chunkCount: chunks.length,
 623:       };
 624:     }
 625:     if (record.abstract) {
 626:       return {
 627:         text: truncateText(record.abstract, MAX_SUMMARY_SOURCE_LENGTH),
 628:         source: "abstract",
 629:         chunkCount: chunks.length,
 630:       };
 631:     }
 632:     const metadataAbstract = record.metadata?.abstract;
 633:     if (typeof metadataAbstract === "string" && metadataAbstract.trim()) {
 634:       return {
 635:         text: truncateText(metadataAbstract, MAX_SUMMARY_SOURCE_LENGTH),
 636:         source: "metadata",
 637:         chunkCount: chunks.length,
 638:       };
 639:     }
 640:     return {
 641:       text: "",
 642:       source: "empty",
 643:       chunkCount: chunks.length,
 644:     };
 645:   },
