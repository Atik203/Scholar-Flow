239: export function createQueryLogger(_prisma: PrismaClient) {
240:   return async (params: any, next: (params: any) => Promise<any>) => {
241:     const before = Date.now();
242:     const result = await next(params);
243:     const after = Date.now();
244:     const duration = after - before;
245:     if (duration > 1000) {
246:       console.error(
247:         `SLOW QUERY (${duration}ms): ${params.model}.${params.action}`,
248:         params.args
249:       );
250:     } else if (duration > 500) {
251:       console.warn(
252:         `Slow query (${duration}ms): ${params.model}.${params.action}`
253:       );
254:     }
255:     if (process.env.NODE_ENV === "development" && duration > 100) {
256:       console.log(
257:         `Query: ${params.model}.${params.action} - ${duration}ms`,
258:         params.args
259:       );
260:     }
261:     return result;
262:   };
263: }
