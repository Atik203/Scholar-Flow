  1: "use client";
  2: import { getRoleSlug } from "./roles";
  3: export function getRoleDashboardUrl(role?: string): string {
  4:   const roleSlug = getRoleSlug(role);
  5:   return `/dashboard/${roleSlug}`;
  6: }
  7: export function getCallbackUrl(
  8:   searchParams?: URLSearchParams,
  9:   defaultUrl: string = "/dashboard"
 10: ): string {
 11:   if (typeof window === "undefined") return defaultUrl;
 12:   if (searchParams) {
 13:     const callbackUrl = searchParams.get("callbackUrl");
 14:     if (callbackUrl) {
 15:       return validateCallbackUrl(callbackUrl, defaultUrl);
 16:     }
 17:   }
 18:   const urlParams = new URLSearchParams(window.location.search);
 19:   const callbackUrl = urlParams.get("callbackUrl");
 20:   if (callbackUrl) {
 21:     return validateCallbackUrl(callbackUrl, defaultUrl);
 22:   }
 23:   return defaultUrl;
 24: }
 25: export function validateCallbackUrl(
 26:   url: string,
 27:   fallback: string = "/dashboard"
 28: ): string {
 29:   try {
 30:     if (url.startsWith("/")) {
 31:       const allowedPaths = [
 32:         "/dashboard",
 33:         "/dashboard/researcher",
 34:         "/dashboard/pro-researcher",
 35:         "/dashboard/team-lead",
 36:         "/dashboard/admin",
 37:         "/papers",
 38:         "/collections",
 39:         "/collaborate",
 40:       ];
 41:       const isAllowed = allowedPaths.some(
 42:         (path) => url === path || url.startsWith(path + "/")
 43:       );
 44:       return isAllowed ? url : fallback;
 45:     }
 46:     const parsedUrl = new URL(url);
 47:     const currentOrigin = window.location.origin;
 48:     if (parsedUrl.origin === currentOrigin) {
 49:       return validateCallbackUrl(parsedUrl.pathname, fallback);
 50:     }
 51:     return fallback;
 52:   } catch {
 53:     return fallback;
 54:   }
 55: }
 56: export function buildLoginUrl(callbackUrl?: string): string {
 57:   const loginUrl = new URL("/login", window.location.origin);
 58:   if (callbackUrl) {
 59:     const validatedCallback = validateCallbackUrl(callbackUrl);
 60:     if (validatedCallback !== "/dashboard") {
 61:       loginUrl.searchParams.set("callbackUrl", validatedCallback);
 62:     }
 63:   }
 64:   return loginUrl.toString();
 65: }
 66: export function buildRegisterUrl(callbackUrl?: string): string {
 67:   const registerUrl = new URL("/register", window.location.origin);
 68:   if (callbackUrl) {
 69:     const validatedCallback = validateCallbackUrl(callbackUrl);
 70:     if (validatedCallback !== "/dashboard") {
 71:       registerUrl.searchParams.set("callbackUrl", validatedCallback);
 72:     }
 73:   }
 74:   return registerUrl.toString();
 75: }
 76: export function handleAuthRedirect(
 77:   isSuccess: boolean,
 78:   searchParams?: URLSearchParams,
 79:   errorUrl: string = "/login",
 80:   userRole?: string
 81: ): string {
 82:   if (isSuccess) {
 83:     const callbackUrl = getCallbackUrl(searchParams);
 84:     if (callbackUrl === "/dashboard" && userRole) {
 85:       return getRoleDashboardUrl(userRole);
 86:     }
 87:     return callbackUrl;
 88:   }
 89:   return errorUrl;
 90: }
 91: export function getSmartRedirectUrl(
 92:   isAuthenticated: boolean,
 93:   currentPath: string,
 94:   userRole?: string
 95: ): string | null {
 96:   if (
 97:     isAuthenticated &&
 98:     ["/login", "/register", "/auth/signin"].includes(currentPath)
 99:   ) {
100:     if (userRole) {
101:       return getRoleDashboardUrl(userRole);
102:     }
103:     return "/dashboard";
104:   }
105:   const protectedRoutes = [
106:     "/dashboard",
107:     "/dashboard/researcher",
108:     "/dashboard/pro-researcher",
109:     "/dashboard/team-lead",
110:     "/dashboard/admin",
111:     "/papers",
112:     "/collections",
113:     "/collaborate",
114:   ];
115:   const isProtectedRoute = protectedRoutes.some(
116:     (route) => currentPath === route || currentPath.startsWith(route + "/")
117:   );
118:   if (!isAuthenticated && isProtectedRoute) {
119:     return buildLoginUrl(currentPath);
120:   }
121:   return null;
122: }
123: export function getGetStartedUrl(
124:   isAuthenticated: boolean,
125:   currentPath: string = "/",
126:   userRole?: string
127: ): string {
128:   if (isAuthenticated) {
129:     if (userRole) {
130:       return getRoleDashboardUrl(userRole);
131:     }
132:     return "/dashboard";
133:   }
134:   if (
135:     currentPath !== "/" &&
136:     currentPath !== "/login" &&
137:     currentPath !== "/register"
138:   ) {
139:     return buildLoginUrl(currentPath);
140:   }
141:   return "/login";
142: }
