 87:   suffix = "",
 88:   duration = 2,
 89:   decimals = 0,
 90: }: {
 91:   target: number;
 92:   suffix?: string;
 93:   duration?: number;
 94:   decimals?: number;
 95: }) => {
 96:   const [count, setCount] = useState(0);
 97:   const [isVisible, setIsVisible] = useState(false);
 98:   const ref = useRef<HTMLSpanElement>(null);
 99:   useEffect(() => {
100:     const observer = new IntersectionObserver(
101:       ([entry]) => {
102:         if (entry.isIntersecting && !isVisible) {
103:           setIsVisible(true);
104:         }
105:       },
106:       { threshold: 0.5 },
107:     );
108:     if (ref.current) observer.observe(ref.current);
109:     return () => observer.disconnect();
110:   }, [isVisible]);
111:   useEffect(() => {
112:     if (!isVisible) return;
113:     const steps = 60;
114:     const increment = target / steps;
115:     let current = 0;
116:     const timer = setInterval(() => {
117:       current += increment;
118:       if (current >= target) {
119:         setCount(target);
120:         clearInterval(timer);
121:       } else {
122:         setCount(decimals > 0 ? parseFloat(current.toFixed(decimals)) : Math.floor(current));
123:       }
124:     }, (duration * 1000) / steps);
125:     return () => clearInterval(timer);
126:   }, [isVisible, target, duration, decimals]);
127:   return (
128:     <span ref={ref}>
129:       {decimals > 0 ? count.toFixed(decimals) : count.toLocaleString()}
130:       {suffix}
131:     </span>
132:   );
133: };
