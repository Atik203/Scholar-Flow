180:                 </TableHeader>
181:                 <TableBody>
182:                   {subscribers.map((s) => {
183:                     const busy = actionId === s.subscriptionId;
184:                     return (
185:                       <TableRow key={s.subscriptionId}>
186:                         <TableCell>
187:                           <div className="font-medium">{s.userName || "N/A"}</div>
188:                           <div className="text-xs text-muted-foreground">
