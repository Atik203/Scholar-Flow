  1: import { SerializedError } from "@reduxjs/toolkit";
  2: import { FetchBaseQueryError } from "@reduxjs/toolkit/query";
  3: export interface ApiErrorResponse {
  4:   success: false;
  5:   message: string;
  6:   statusCode: number;
  7:   errorCode?: string;
  8:   details?: Record<string, any>;
  9:   timestamp?: string;
 10: }
 11: export const isFetchBaseQueryError = (
 12:   error: unknown
 13: ): error is FetchBaseQueryError => {
 14:   return typeof error === "object" && error !== null && "status" in error;
 15: };
 16: export const isSerializedError = (error: unknown): error is SerializedError => {
 17:   return (
 18:     typeof error === "object" &&
 19:     error !== null &&
 20:     "message" in error &&
 21:     !("status" in error)
 22:   );
 23: };
 24: export const getErrorMessage = (
 25:   error: FetchBaseQueryError | SerializedError | undefined
 26: ): string => {
 27:   if (!error) return "An unknown error occurred";
 28:   if (isFetchBaseQueryError(error)) {
 29:     if ("data" in error && error.data) {
 30:       const apiError = error.data as ApiErrorResponse;
 31:       return apiError.message || `Request failed with status ${error.status}`;
 32:     }
 33:     switch (error.status) {
 34:       case 400:
 35:         return "Invalid request. Please check your input and try again.";
 36:       case 401:
 37:         return "Authentication required. Please sign in and try again.";
 38:       case 403:
 39:         return "You do not have permission to perform this action.";
 40:       case 404:
 41:         return "The requested resource was not found.";
 42:       case 409:
 43:         return "A conflict occurred. The resource may already exist.";
 44:       case 413:
 45:         return "File too large. Please select a smaller file.";
 46:       case 429:
 47:         return "Too many requests. Please wait a moment and try again.";
 48:       case 500:
 49:         return "Server error. Please try again later.";
 50:       case 503:
 51:         return "Service temporarily unavailable. Please try again later.";
 52:       case "FETCH_ERROR":
 53:         return "Network error. Please check your connection and try again.";
 54:       case "TIMEOUT_ERROR":
 55:         return "Request timed out. Please try again.";
 56:       case "PARSING_ERROR":
 57:         return "Invalid server response. Please try again.";
 58:       default:
 59:         return `Request failed with status ${error.status}`;
 60:     }
 61:   }
 62:   if (isSerializedError(error)) {
 63:     return error.message || "An error occurred";
 64:   }
 65:   return "An unknown error occurred";
 66: };
 67: export const getErrorDetails = (
 68:   error: FetchBaseQueryError | SerializedError | undefined
 69: ) => {
 70:   if (!error) return null;
 71:   if (isFetchBaseQueryError(error)) {
 72:     if ("data" in error && error.data) {
 73:       const apiError = error.data as ApiErrorResponse;
 74:       return {
 75:         statusCode: error.status,
 76:         errorCode: apiError.errorCode,
 77:         message: apiError.message,
 78:         details: apiError.details,
 79:         timestamp: apiError.timestamp,
 80:       };
 81:     }
 82:     return {
 83:       statusCode: error.status,
 84:       message: getErrorMessage(error),
 85:     };
 86:   }
 87:   if (isSerializedError(error)) {
 88:     return {
 89:       message: error.message,
 90:       code: error.code,
 91:       name: error.name,
 92:       stack: error.stack,
 93:     };
 94:   }
 95:   return null;
 96: };
 97: export const showApiErrorToast = (
 98:   error: FetchBaseQueryError | SerializedError | undefined,
 99:   fallbackMessage?: string
100: ) => {
101:   const message =
102:     getErrorMessage(error) || fallbackMessage || "Something went wrong";
103:   if (
104:     isFetchBaseQueryError(error) &&
105:     (error.status === "FETCH_ERROR" || error.status === 0)
106:   ) {
107:     return;
108:   }
109:   import("@/components/providers/ToastProvider").then(({ showErrorToast }) => {
110:     showErrorToast(message);
111:   });
112: };
113: export const shouldRetryRequest = (
114:   error: FetchBaseQueryError | SerializedError | undefined
115: ): boolean => {
116:   if (!error) return false;
117:   if (isFetchBaseQueryError(error)) {
118:     const status = error.status;
119:     return (
120:       (typeof status === "number" && (status >= 500 || status === 0)) ||
121:       status === "FETCH_ERROR" ||
122:       status === "TIMEOUT_ERROR"
123:     );
124:   }
125:   return false;
126: };
127: export class AppError extends Error {
128:   public readonly statusCode: number;
129:   public readonly errorCode?: string;
130:   public readonly details?: Record<string, any>;
131:   constructor(
132:     message: string,
133:     statusCode: number = 500,
134:     errorCode?: string,
135:     details?: Record<string, any>
136:   ) {
137:     super(message);
138:     this.name = "AppError";
139:     this.statusCode = statusCode;
140:     this.errorCode = errorCode;
141:     this.details = details;
142:   }
143: }
</file>

