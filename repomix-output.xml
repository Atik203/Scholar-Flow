  1: import type { NodeHttpHandlerOptions } from "@smithy/node-http-handler";
  2: import {
  3:   GetObjectCommand,
  4:   GetObjectCommandInput,
  5:   PutObjectCommand,
  6:   PutObjectCommandInput,
  7:   S3Client,
  8: } from "@aws-sdk/client-s3";
  9: import { getSignedUrl } from "@aws-sdk/s3-request-presigner";
 10: import http from "http";
 11: import https from "https";
 12: export interface PutObjectParams {
 13:   key: string;
 14:   body: Buffer | Uint8Array | string;
 15:   contentType?: string;
 16: }
 17: class StorageServiceClass {
 18:   private s3: S3Client;
 19:   private bucket: string;
 20:   constructor() {
 21:     const bucket = process.env.AWS_BUCKET_NAME || process.env.S3_BUCKET;
 22:     if (!bucket)
 23:       throw new Error(
 24:         "StorageService: bucket env var (AWS_BUCKET_NAME or S3_BUCKET) not set"
 25:       );
 26:     const region = process.env.AWS_REGION || "us-east-1";
 27:     const isDev = process.env.NODE_ENV !== "production";
 28:     const httpAgent = new http.Agent({
 29:       keepAlive: true,
 30:       keepAliveMsecs: 30000,
 31:       maxSockets: 10,
 32:       maxFreeSockets: 5,
 33:       timeout: 60000,
 34:     });
 35:     const httpsAgent = new https.Agent({
 36:       keepAlive: true,
 37:       keepAliveMsecs: 30000,
 38:       maxSockets: 10,
 39:       maxFreeSockets: 5,
 40:       timeout: 60000,
 41:     });
 42:     const requestHandlerConfig = {
 43:       requestTimeout: isDev ? 30000 : 60000,
 44:       connectionTimeout: isDev ? 10000 : 15000,
 45:       httpAgent,
 46:       httpsAgent,
 47:     } as NodeHttpHandlerOptions;
 48:     this.s3 = new S3Client({
 49:       region,
 50:       credentials: {
 51:         accessKeyId:
 52:           process.env.AWS_ACCESS_KEY_ID || process.env.S3_ACCESS_KEY || "",
 53:         secretAccessKey:
 54:           process.env.AWS_SECRET_ACCESS_KEY || process.env.S3_SECRET_KEY || "",
 55:       },
 56:       requestHandler: requestHandlerConfig,
 57:       maxAttempts: isDev ? 1 : 3,
 58:       retryMode: isDev ? "standard" : "adaptive",
 59:       followRegionRedirects: true,
 60:       systemClockOffset: 0,
 61:     });
 62:     this.bucket = bucket;
 63:     console.log(
 64:       `[StorageService] Initialized bucket=${bucket} region=${region} env=${isDev ? "dev" : "prod"} keepAlive=true maxAttempts=${isDev ? 1 : 3}`
 65:     );
 66:   }
 67:   async testConnection(): Promise<boolean> {
 68:     try {
 69:       console.log(`[StorageService] Testing S3 connection...`);
 70:       const { HeadBucketCommand } = await import("@aws-sdk/client-s3");
 71:       const command = new HeadBucketCommand({ Bucket: this.bucket });
 72:       await this.s3.send(command);
 73:       console.log(`[StorageService] S3 connection test successful`);
 74:       return true;
 75:     } catch (error) {
 76:       console.error(`[StorageService] S3 connection test failed:`, error);
 77:       return false;
 78:     }
 79:   }
 80:   async putObject(params: PutObjectParams) {
 81:     const uploadStart = Date.now();
 82:     const sizeMB = (params.body.length / 1024 / 1024).toFixed(2);
 83:     console.log(
 84:       `[StorageService] S3 putObject key=${params.key} size=${sizeMB}MB`
 85:     );
 86:     try {
 87:       const putObjectInput: PutObjectCommandInput = {
 88:         Bucket: this.bucket,
 89:         Key: params.key,
 90:         Body: params.body,
 91:         ContentType: params.contentType || "application/octet-stream",
 92:       };
 93:       const command = new PutObjectCommand(putObjectInput);
 94:       await this.s3.send(command);
 95:       const uploadTime = Date.now() - uploadStart;
 96:       console.log(
 97:         `[StorageService] S3 putObject done ${uploadTime}ms (${sizeMB}MB)`
 98:       );
 99:       return { key: params.key };
100:     } catch (error) {
101:       const uploadTime = Date.now() - uploadStart;
102:       console.error(
103:         `[StorageService] S3 putObject FAILED after ${uploadTime}ms:`,
104:         error instanceof Error ? error.message : error
105:       );
106:       throw error;
107:     }
108:   }
109:   async getObject(key: string): Promise<Buffer> {
110:     const getObjectInput: GetObjectCommandInput = {
111:       Bucket: this.bucket,
112:       Key: key,
113:     };
114:     const command = new GetObjectCommand(getObjectInput);
115:     const result = await this.s3.send(command);
116:     const chunks: Buffer[] = [];
117:     const stream = result.Body as NodeJS.ReadableStream;
118:     return new Promise((resolve, reject) => {
119:       stream.on("data", (chunk: Buffer) => chunks.push(chunk));
120:       stream.on("error", reject);
121:       stream.on("end", () => resolve(Buffer.concat(chunks)));
122:     });
123:   }
124:   async getSignedUrl(key: string, expiresSeconds = 300): Promise<string> {
125:     const getObjectInput: GetObjectCommandInput = {
126:       Bucket: this.bucket,
127:       Key: key,
128:     };
129:     const command = new GetObjectCommand(getObjectInput);
130:     return await getSignedUrl(this.s3, command, {
131:       expiresIn: expiresSeconds,
132:     });
133:   }
134:   async uploadFile(
135:     buffer: Buffer,
136:     originalName: string,
137:     contentType: string
138:   ): Promise<{ url: string; filename: string; key: string }> {
139:     const timestamp = Date.now();
140:     const fileExtension = originalName.split(".").pop();
141:     const filename = `editor-images/${timestamp}-${Math.random().toString(36).substring(2)}.${fileExtension}`;
142:     console.log(
143:       `[StorageService] uploadFile key=${filename} size=${buffer.length} type=${contentType}`
144:     );
145:     const putObjectInput: PutObjectCommandInput = {
146:       Bucket: this.bucket,
147:       Key: filename,
148:       Body: buffer,
149:       ContentType: contentType,
150:     };
151:     const command = new PutObjectCommand(putObjectInput);
152:     await this.s3.send(command);
153:     const url = await this.getSignedUrl(filename, 604800);
154:     return {
155:       url,
156:       filename: originalName,
157:       key: filename,
158:     };
159:   }
160: }
161: const globalForStorage = globalThis as unknown as {
162:   __storageService?: StorageServiceClass;
163: };
164: const getStorageService = (): StorageServiceClass => {
165:   if (!globalForStorage.__storageService) {
166:     globalForStorage.__storageService = new StorageServiceClass();
167:   }
168:   return globalForStorage.__storageService;
169: };
170: export const StorageService = new Proxy({} as StorageServiceClass, {
171:   get(_target, prop, receiver) {
172:     return Reflect.get(getStorageService(), prop, receiver);
173:   },
174: });
175: export { StorageServiceClass };
