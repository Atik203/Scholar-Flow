275:     skip: number = 0
276:   ) {
277:     try {
278:       const collections = await prisma.$queryRaw<CollectionAggregateRow[]>`
279:         SELECT
280:           c.id,
281:           c.name,
282:           c.description,
283:           c."isPublic",
284:           c."visibility"::text,
