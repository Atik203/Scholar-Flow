<file path="figma-make/components/form/date-picker.tsx">
  1: "use client";
  2: import { Calendar, ChevronLeft, ChevronRight, X } from "lucide-react";
  3: import { AnimatePresence, motion } from "motion/react";
  4: import React from "react";
  5: function cn(...classes: (string | undefined | null | false)[]): string {
  6:   return classes.filter(Boolean).join(" ");
  7: }
  8: export interface DatePickerProps {
  9:   value?: Date | Date[];
 10:   onChange?: (date: Date | Date[] | undefined) => void;
 11:   placeholder?: string;
 12:   label?: string;
 13:   helperText?: string;
 14:   error?: string;
 15:   disabled?: boolean;
 16:   range?: boolean;
 17:   minDate?: Date;
 18:   maxDate?: Date;
 19:   className?: string;
 20:   format?: string;
 21: }
 22: export const DatePicker: React.FC<DatePickerProps> = ({
 23:   value,
 24:   onChange,
 25:   placeholder = "Pick a date",
 26:   label,
 27:   helperText,
 28:   error,
 29:   disabled = false,
 30:   range = false,
 31:   minDate,
 32:   maxDate,
 33:   className,
 34:   format = "MMM dd, yyyy",
 35: }) => {
 36:   const [isOpen, setIsOpen] = React.useState(false);
 37:   const [currentMonth, setCurrentMonth] = React.useState(() => {
 38:     if (value) {
 39:       const date = Array.isArray(value) ? value[0] : value;
 40:       return new Date(date.getFullYear(), date.getMonth(), 1);
 41:     }
 42:     return new Date();
 43:   });
 44:   const containerRef = React.useRef<HTMLDivElement>(null);
 45:   React.useEffect(() => {
 46:     const handleClickOutside = (event: MouseEvent) => {
 47:       if (
 48:         containerRef.current &&
 49:         !containerRef.current.contains(event.target as Node)
 50:       ) {
 51:         setIsOpen(false);
 52:       }
 53:     };
 54:     document.addEventListener("mousedown", handleClickOutside);
 55:     return () => document.removeEventListener("mousedown", handleClickOutside);
 56:   }, []);
 57:   const formatDate = React.useCallback(
 58:     (date: Date): string => {
 59:       const months = [
 60:         "Jan",
 61:         "Feb",
 62:         "Mar",
 63:         "Apr",
 64:         "May",
 65:         "Jun",
 66:         "Jul",
 67:         "Aug",
 68:         "Sep",
 69:         "Oct",
 70:         "Nov",
 71:         "Dec",
 72:       ];
 73:       return format
 74:         .replace("MMM", months[date.getMonth()])
 75:         .replace("dd", date.getDate().toString().padStart(2, "0"))
 76:         .replace("yyyy", date.getFullYear().toString());
 77:     },
 78:     [format]
 79:   );
 80:   const getDaysInMonth = (year: number, month: number) => {
 81:     return new Date(year, month + 1, 0).getDate();
 82:   };
 83:   const getFirstDayOfMonth = (year: number, month: number) => {
 84:     return new Date(year, month, 1).getDay();
 85:   };
 86:   const isDateInRange = (date: Date) => {
 87:     if (minDate && date < minDate) return false;
 88:     if (maxDate && date > maxDate) return false;
 89:     return true;
 90:   };
 91:   const isDateSelected = (date: Date) => {
 92:     if (!value) return false;
 93:     if (Array.isArray(value)) {
 94:       return value.some(
 95:         (d) =>
 96:           d.getDate() === date.getDate() &&
 97:           d.getMonth() === date.getMonth() &&
 98:           d.getFullYear() === date.getFullYear()
 99:       );
100:     }
101:     return (
102:       date.getDate() === value.getDate() &&
103:       date.getMonth() === value.getMonth() &&
104:       date.getFullYear() === value.getFullYear()
105:     );
106:   };
107:   const isDateInSelectionRange = (date: Date) => {
108:     if (!range || !Array.isArray(value) || value.length !== 2) return false;
109:     const [start, end] = value;
110:     return date >= start && date <= end;
111:   };
112:   const handleDateClick = (date: Date) => {
113:     if (!onChange || !isDateInRange(date)) return;
114:     if (range) {
115:       if (!Array.isArray(value) || value.length === 0) {
116:         onChange([date]);
117:       } else if (value.length === 1) {
118:         const [start] = value;
119:         if (date < start) {
120:           onChange([date, start]);
121:         } else {
122:           onChange([start, date]);
123:         }
124:         setIsOpen(false);
125:       } else {
126:         onChange([date]);
127:       }
128:     } else {
129:       onChange(date);
130:       setIsOpen(false);
131:     }
132:   };
133:   const handleClear = (e: React.MouseEvent) => {
134:     e.stopPropagation();
135:     if (onChange) {
136:       onChange(undefined);
137:     }
138:   };
139:   const goToPrevMonth = () => {
140:     setCurrentMonth(
141:       new Date(currentMonth.getFullYear(), currentMonth.getMonth() - 1, 1)
142:     );
143:   };
144:   const goToNextMonth = () => {
145:     setCurrentMonth(
146:       new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1)
147:     );
148:   };
149:   const renderCalendar = () => {
150:     const year = currentMonth.getFullYear();
151:     const month = currentMonth.getMonth();
152:     const daysInMonth = getDaysInMonth(year, month);
153:     const firstDay = getFirstDayOfMonth(year, month);
154:     const days = [];
155:     for (let i = 0; i < firstDay; i++) {
156:       days.push(<div key={`empty-${i}`} className="h-9" />);
157:     }
158:     for (let day = 1; day <= daysInMonth; day++) {
159:       const date = new Date(year, month, day);
160:       const isSelected = isDateSelected(date);
161:       const isInRange = isDateInSelectionRange(date);
162:       const isValid = isDateInRange(date);
163:       days.push(
164:         <motion.button
165:           key={day}
166:           type="button"
167:           whileHover={isValid ? { scale: 1.1 } : undefined}
168:           whileTap={isValid ? { scale: 0.95 } : undefined}
169:           onClick={() => handleDateClick(date)}
170:           disabled={!isValid}
171:           className={cn(
172:             "h-9 w-9 rounded-md text-sm transition-colors",
173:             "hover:bg-accent hover:text-accent-foreground",
174:             isSelected && "bg-primary text-primary-foreground",
175:             isInRange && !isSelected && "bg-primary/20",
176:             !isValid && "opacity-50 cursor-not-allowed",
177:             !isValid && "hover:bg-transparent hover:text-muted-foreground"
178:           )}
179:         >
180:           {day}
181:         </motion.button>
182:       );
183:     }
184:     return days;
185:   };
186:   const displayValue = React.useMemo(() => {
187:     if (!value) return placeholder;
188:     if (Array.isArray(value)) {
189:       if (value.length === 0) return placeholder;
190:       if (value.length === 1) return formatDate(value[0]);
191:       if (value.length === 2) {
192:         return `${formatDate(value[0])} - ${formatDate(value[1])}`;
193:       }
194:       return `${value.length} dates selected`;
195:     }
196:     return formatDate(value);
197:   }, [value, placeholder, formatDate]);
198:   return (
199:     <div className={cn("space-y-2", className)} ref={containerRef}>
200:       {label && (
201:         <label className="text-sm font-medium text-foreground">{label}</label>
202:       )}
203:       <div className="relative">
204:         <button
205:           type="button"
206:           role="combobox"
207:           aria-expanded={isOpen}
208:           disabled={disabled}
209:           onClick={() => !disabled && setIsOpen(!isOpen)}
210:           className={cn(
211:             "w-full h-10 px-3 rounded-lg border bg-background",
212:             "flex items-center justify-between gap-2",
213:             "text-sm text-left",
214:             "focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2",
215:             "disabled:opacity-50 disabled:cursor-not-allowed",
216:             error && "border-destructive focus:ring-destructive",
217:             isOpen && "ring-2 ring-ring ring-offset-2"
218:           )}
219:         >
220:           <span
221:             className={cn("flex-1 truncate", !value && "text-muted-foreground")}
222:           >
223:             {displayValue}
224:           </span>
225:           <div className="flex items-center gap-1">
226:             <AnimatePresence>
227:               {value && (
228:                 <motion.button
229:                   initial={{ opacity: 0, scale: 0.8 }}
230:                   animate={{ opacity: 1, scale: 1 }}
231:                   exit={{ opacity: 0, scale: 0.8 }}
232:                   type="button"
233:                   onClick={handleClear}
234:                   disabled={disabled}
235:                   className={cn(
236:                     "p-1 rounded-full",
237:                     "hover:bg-destructive hover:text-destructive-foreground",
238:                     "transition-colors"
239:                   )}
240:                 >
241:                   <X className="h-3 w-3" />
242:                 </motion.button>
243:               )}
244:             </AnimatePresence>
245:             <Calendar className="h-4 w-4 opacity-50" />
246:           </div>
247:         </button>
248:         <AnimatePresence>
249:           {isOpen && (
250:             <motion.div
251:               initial={{ opacity: 0, y: -10, scale: 0.95 }}
252:               animate={{ opacity: 1, y: 0, scale: 1 }}
253:               exit={{ opacity: 0, y: -10, scale: 0.95 }}
254:               transition={{ duration: 0.15 }}
255:               className={cn(
256:                 "absolute z-50 mt-1",
257:                 "bg-popover border border-border rounded-lg shadow-lg",
258:                 "p-3"
259:               )}
260:             >
261:               {}
262:               <div className="flex items-center justify-between mb-3">
263:                 <motion.button
264:                   type="button"
265:                   whileHover={{ scale: 1.1 }}
266:                   whileTap={{ scale: 0.9 }}
267:                   onClick={goToPrevMonth}
268:                   className="h-7 w-7 p-0 flex items-center justify-center rounded-md hover:bg-accent"
269:                 >
270:                   <ChevronLeft className="h-4 w-4" />
271:                 </motion.button>
272:                 <div className="text-sm font-medium">
273:                   {currentMonth.toLocaleDateString("en-US", {
274:                     month: "long",
275:                     year: "numeric",
276:                   })}
277:                 </div>
278:                 <motion.button
279:                   type="button"
280:                   whileHover={{ scale: 1.1 }}
281:                   whileTap={{ scale: 0.9 }}
282:                   onClick={goToNextMonth}
283:                   className="h-7 w-7 p-0 flex items-center justify-center rounded-md hover:bg-accent"
284:                 >
285:                   <ChevronRight className="h-4 w-4" />
286:                 </motion.button>
287:               </div>
288:               {}
289:               <div className="grid grid-cols-7 gap-1 mb-2">
290:                 {["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"].map((day) => (
291:                   <div
292:                     key={day}
293:                     className="h-9 flex items-center justify-center text-xs font-medium text-muted-foreground"
294:                   >
295:                     {day}
296:                   </div>
297:                 ))}
298:               </div>
299:               {}
300:               <div className="grid grid-cols-7 gap-1">{renderCalendar()}</div>
301:               {}
302:               <div className="mt-3 pt-3 border-t border-border flex gap-2">
303:                 <motion.button
304:                   type="button"
305:                   whileHover={{ scale: 1.02 }}
306:                   whileTap={{ scale: 0.98 }}
307:                   onClick={() => {
308:                     const today = new Date();
309:                     handleDateClick(today);
310:                     setCurrentMonth(
311:                       new Date(today.getFullYear(), today.getMonth(), 1)
312:                     );
313:                   }}
314:                   className="flex-1 px-3 py-1.5 text-xs rounded-md bg-accent hover:bg-accent/80 transition-colors"
315:                 >
316:                   Today
317:                 </motion.button>
318:                 {value && (
319:                   <motion.button
320:                     type="button"
321:                     whileHover={{ scale: 1.02 }}
322:                     whileTap={{ scale: 0.98 }}
323:                     onClick={handleClear}
324:                     className="flex-1 px-3 py-1.5 text-xs rounded-md border border-border hover:bg-muted transition-colors"
325:                   >
