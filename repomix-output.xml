 49:   message: string;
 50:   data: AppNotification;
 51: }
 52: export type NotificationCategory =
 53:   | "PAPERS"
 54:   | "DISCUSSIONS"
 55:   | "COLLECTIONS"
 56:   | "WORKSPACE"
 57:   | "TEAM"
 58:   | "BILLING"
 59:   | "SECURITY"
 60:   | "ACHIEVEMENT"
 61:   | "SYSTEM";
 62: export interface CategoryChannelSetting {
 63:   email: boolean;
 64:   push: boolean;
 65:   inApp: boolean;
 66: }
 67: export interface NotificationPreferences {
 68:   channels: { inApp: boolean; email: boolean; push: boolean };
 69:   categories: Record<NotificationCategory, CategoryChannelSetting>;
 70:   quietHours: {
 71:     enabled: boolean;
 72:     startTime: string;
 73:     endTime: string;
 74:     days: string[];
 75:   };
 76:   digestFrequency: "instant" | "daily" | "weekly";
 77:   muteAll: boolean;
 78: }
 79: export const notificationApi = apiSlice
 80:   .injectEndpoints({
 81:     endpoints: (builder) => ({
 82:       getNotifications: builder.query<
 83:         GetNotificationsResponse,
 84:         { cursor?: string; limit?: number; type?: string; read?: string; starred?: string }
 85:       >({
 86:         query: (params) => ({
 87:           url: "/notifications",
 88:           params,
 89:         }),
 90:         providesTags: (result) =>
 91:           result?.data
 92:             ? [
 93:                 ...result.data.map(({ id }) => ({ type: "Notification" as const, id })),
 94:                 { type: "Notification", id: "LIST" },
 95:               ]
 96:             : [{ type: "Notification", id: "LIST" }],
 97:       }),
 98:       getUnreadCount: builder.query<GetUnreadCountResponse, void>({
 99:         query: () => "/notifications/unread-count",
100:         providesTags: [{ type: "Notification", id: "UNREAD_COUNT" }],
101:       }),
102:       markAsRead: builder.mutation<BaseNotificationResponse, string>({
103:         query: (id) => ({
104:           url: `/notifications/${id}/read`,
105:           method: "PUT",
106:         }),
107:         async onQueryStarted(id, { dispatch, getState, queryFulfilled }) {
108:           const patches: Array<{ undo: () => void }> = [];
109:           let wasUnread = false;
110:           for (const arg of notificationApi.util.selectCachedArgsForQuery(
111:             getState(),
112:             "getNotifications"
113:           )) {
114:             patches.push(
115:               dispatch(
116:                 notificationApi.util.updateQueryData(
117:                   "getNotifications",
118:                   arg,
119:                   (draft) => {
120:                     if (!draft?.data) return;
121:                     if (arg?.read === "unread") {
