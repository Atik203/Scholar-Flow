 1: import { NextFunction, Request, Response } from "express";
 2: import { AnyZodObject, ZodError } from "zod";
 3: import ApiError from "../errors/ApiError";
 4: export const validateRequest = (schema: AnyZodObject) => {
 5:   return async (req: Request, res: Response, next: NextFunction) => {
 6:     try {
 7:       await schema.parseAsync({
 8:         body: req.body,
 9:         query: req.query,
10:         params: req.params,
11:         cookies: req.cookies,
12:       });
13:       next();
14:     } catch (error) {
15:       if (error instanceof ZodError) {
16:         const validationErrors = error.issues
17:           .map((issue) => `${issue.path.join(".")}: ${issue.message}`)
18:           .join(", ");
19:         return next(
20:           new ApiError(400, `Validation failed: ${validationErrors}`)
21:         );
22:       }
23:       next(error);
24:     }
25:   };
26: };
