 624:     }
 625:     if (!["view", "edit"].includes(permission)) {
 626:       throw new ApiError(400, "Permission must be 'view' or 'edit'");
 627:     }
 628:     const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
 629:     if (!emailRegex.test(recipientEmail)) {
 630:       throw new ApiError(400, "Invalid email format");
 631:     }
 632:     try {
 633:       const paper = (await prisma.$queryRaw`
 634:         SELECT p.id, p.title, p."contentHtml", u.name as author_name
 635:         FROM "Paper" p
 636:         JOIN "User" u ON p."uploaderId" = u.id
 637:         WHERE p.id = ${paperId}
 638:       `) as any[];
 639:       if (!paper.length) {
 640:         throw new ApiError(404, "Paper not found");
 641:       }
 642:       const paperData = paper[0];
 643:       // Check if user has permission to share this paper
 644:       const hasPermission = (await prisma.$queryRaw`
 645:         SELECT 1 FROM "Paper" p
 646:         WHERE p.id = ${paperId}
 647:         AND (
 648:           p."uploaderId" = ${authReq.user.id}
 649:           OR EXISTS (
 650:             SELECT 1 FROM "CollectionPaper" cp
 651:             JOIN "CollectionMember" cm ON cp."collectionId" = cm."collectionId"
 652:             WHERE cp."paperId" = ${paperId}
 653:             AND cm."userId" = ${authReq.user.id}
 654:             AND cm.permission = 'EDIT'
 655:           )
 656:         )
 657:       `) as any[];
 658:       if (!hasPermission.length) {
 659:         throw new ApiError(
 660:           403,
 661:           "You don't have permission to share this paper"
 662:         );
 663:       }
 664:       // Generate paper link (assuming frontend URL structure)
 665:       const paperLink = `${process.env.FRONTEND_URL || "http://localhost:3000"}/papers/${paperId}`;
 666:       // Import and use email service
 667:       const { emailService } = await import("../../shared/emailService");
 668:       await emailService.sendPaperShareEmail({
 669:         recipientEmail,
 670:         senderName: authReq.user.name || authReq.user.email,
 671:         paperTitle: paperData.title,
 672:         paperLink,
 673:         permission,
 674:       });
