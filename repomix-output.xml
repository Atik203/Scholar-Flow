<file path="apps/frontend/src/components/navigation/Breadcrumbs.tsx">
  1: import { cn } from "@/lib/utils";
  2: import { ChevronRight, Home, MoreHorizontal } from "lucide-react";
  3: import Link from "next/link";
  4: import * as React from "react";
  5: import { Button } from "../ui/button";
  6: import {
  7:   DropdownMenu,
  8:   DropdownMenuContent,
  9:   DropdownMenuItem,
 10:   DropdownMenuTrigger,
 11: } from "../ui/dropdown-menu";
 12: export interface BreadcrumbItem {
 13:   label: string;
 14:   href?: string;
 15:   icon?: React.ComponentType<{ className?: string }>;
 16:   onClick?: () => void;
 17: }
 18: export interface BreadcrumbsProps {
 19:   items: BreadcrumbItem[];
 20:   separator?: React.ReactNode;
 21:   maxItems?: number;
 22:   showHome?: boolean;
 23:   className?: string;
 24:   itemClassName?: string;
 25:   separatorClassName?: string;
 26: }
 27: export const Breadcrumbs: React.FC<BreadcrumbsProps> = ({
 28:   items,
 29:   separator = <ChevronRight className="h-4 w-4 text-muted-foreground" />,
 30:   maxItems = 5,
 31:   showHome = true,
 32:   className,
 33:   itemClassName,
 34:   separatorClassName,
 35: }) => {
 36:   const [isExpanded, setIsExpanded] = React.useState(false);
 37:   const allItems = React.useMemo(() => {
 38:     const homeItem: BreadcrumbItem = {
 39:       label: "Home",
 40:       href: "/",
 41:       icon: Home,
 42:     };
 43:     return showHome ? [homeItem, ...items] : items;
 44:   }, [items, showHome]);
 45:   const displayItems = React.useMemo(() => {
 46:     if (allItems.length <= maxItems || isExpanded) {
 47:       return allItems;
 48:     }
 49:     const visibleItems = allItems.slice(-maxItems + 1);
 50:     const hiddenItems = allItems.slice(0, -maxItems + 1);
 51:     return [
 52:       ...hiddenItems.slice(0, 1),
 53:       { label: "...", icon: MoreHorizontal },
 54:       ...visibleItems,
 55:     ];
 56:   }, [allItems, maxItems, isExpanded]);
 57:   const handleItemClick = (item: BreadcrumbItem, index: number) => {
 58:     if (item.onClick) {
 59:       item.onClick();
 60:     }
 61:     if (index === displayItems.length - 1) {
 62:       return;
 63:     }
 64:     if (item.href) {
 65:       return;
 66:     }
 67:   };
 68:   const renderItem = (item: BreadcrumbItem, index: number) => {
 69:     const isLast = index === displayItems.length - 1;
 70:     const isClickable = item.href || item.onClick;
 71:     const isHidden = item.label === "..." && item.icon === MoreHorizontal;
 72:     if (isHidden) {
 73:       return (
 74:         <DropdownMenu key={`hidden-${index}`}>
 75:           <DropdownMenuTrigger asChild>
 76:             <Button
 77:               variant="ghost"
 78:               size="sm"
 79:               className="h-6 px-2 hover:bg-accent"
 80:             >
 81:               <MoreHorizontal className="h-3 w-3" />
 82:             </Button>
 83:           </DropdownMenuTrigger>
 84:           <DropdownMenuContent align="start" className="w-48">
 85:             {allItems.slice(1, -maxItems + 1).map((hiddenItem, hiddenIndex) => (
 86:               <DropdownMenuItem key={hiddenIndex} asChild>
 87:                 {hiddenItem.href ? (
 88:                   <Link
 89:                     href={hiddenItem.href}
 90:                     className="flex items-center gap-2"
 91:                   >
 92:                     {hiddenItem.icon && <hiddenItem.icon className="h-3 w-3" />}
 93:                     {hiddenItem.label}
 94:                   </Link>
 95:                 ) : (
 96:                   <button
 97:                     onClick={hiddenItem.onClick}
 98:                     className="flex items-center gap-2 w-full text-left"
 99:                   >
100:                     {hiddenItem.icon && <hiddenItem.icon className="h-3 w-3" />}
101:                     {hiddenItem.label}
102:                   </button>
103:                 )}
104:               </DropdownMenuItem>
105:             ))}
106:           </DropdownMenuContent>
107:         </DropdownMenu>
108:       );
109:     }
110:     const itemContent = (
111:       <>
112:         {item.icon && <item.icon className="h-4 w-4" />}
113:         <span className="truncate">{item.label}</span>
114:       </>
115:     );
116:     if (isClickable && !isLast) {
117:       if (item.href) {
118:         return (
119:           <Link
120:             key={item.label}
121:             href={item.href}
122:             className={cn(
123:               "flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors",
124:               itemClassName
125:             )}
126:           >
127:             {itemContent}
128:           </Link>
129:         );
130:       } else {
131:         return (
132:           <button
133:             key={item.label}
134:             onClick={() => handleItemClick(item, index)}
135:             className={cn(
136:               "flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors",
137:               itemClassName
138:             )}
139:           >
140:             {itemContent}
141:           </button>
142:         );
143:       }
144:     }
145:     return (
146:       <span
147:         key={item.label}
148:         className={cn(
149:           "flex items-center gap-2 text-sm",
150:           isLast ? "text-foreground font-medium" : "text-muted-foreground",
151:           itemClassName
152:         )}
153:       >
154:         {itemContent}
155:       </span>
156:     );
157:   };
158:   return (
159:     <nav
160:       aria-label="Breadcrumb"
161:       className={cn("flex items-center gap-2", className)}
162:     >
163:       {displayItems.map((item, index) => (
164:         <React.Fragment key={`${item.label}-${index}`}>
165:           {renderItem(item, index)}
166:           {index < displayItems.length - 1 && (
167:             <span className={cn("flex-shrink-0", separatorClassName)}>
168:               {separator}
169:             </span>
170:           )}
171:         </React.Fragment>
172:       ))}
173:       {allItems.length > maxItems && (
174:         <Button
175:           variant="ghost"
176:           size="sm"
177:           onClick={() => setIsExpanded(!isExpanded)}
178:           className="h-6 px-2 ml-2 text-xs"
179:         >
180:           {isExpanded ? "Show Less" : "Show More"}
181:         </Button>
182:       )}
183:     </nav>
184:   );
185: };
186: export const CompactBreadcrumbs: React.FC<BreadcrumbsProps> = ({
187:   items,
188:   showHome = true,
189:   className,
190: }) => {
191:   const allItems = React.useMemo(() => {
192:     const homeItem: BreadcrumbItem = {
193:       label: "Home",
194:       href: "/",
195:       icon: Home,
196:     };
197:     return showHome ? [homeItem, ...items] : items;
198:   }, [items, showHome]);
199:   const displayItems = React.useMemo(() => {
200:     if (allItems.length <= 2) {
201:       return allItems;
202:     }
203:     return [
204:       allItems[0],
205:       { label: "...", icon: MoreHorizontal },
206:       allItems[allItems.length - 1],
207:     ];
208:   }, [allItems]);
209:   return (
210:     <Breadcrumbs
211:       items={displayItems}
212:       maxItems={3}
213:       showHome={false}
214:       className={className}
215:     />
216:   );
217: };
218: export const BreadcrumbsWithBack: React.FC<
219:   BreadcrumbsProps & {
220:     onBack?: () => void;
221:     backLabel?: string;
222:   }
223: > = ({ items, onBack, backLabel = "Back", ...props }) => {
224:   return (
225:     <div className="flex items-center gap-4">
226:       {onBack && (
227:         <Button
228:           variant="outline"
229:           size="sm"
230:           onClick={onBack}
231:           className="flex items-center gap-2"
232:         >
233:           <ChevronRight className="h-4 w-4 rotate-180" />
234:           {backLabel}
235:         </Button>
236:       )}
237:       <Breadcrumbs items={items} {...props} />
238:     </div>
239:   );
240: };
</file>

