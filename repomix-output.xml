<file path="apps/frontend/src/components/papers/SaveExternalPaperButton.tsx">
 1: "use client";
 2: import { useState } from "react";
 3: import { useRouter } from "next/navigation";
 4: import { Bookmark, Check, Loader2 } from "lucide-react";
 5: import { Button, ButtonProps } from "@/components/ui/button";
 6: import { showErrorToast, showSuccessToast } from "@/components/providers/ToastProvider";
 7: import {
 8:   useImportByArxivMutation,
 9:   useImportByDOIMutation,
10:   useImportBySmartURLMutation,
11: } from "@/redux/api/importApi";
12: import { useListWorkspacesQuery } from "@/redux/api/workspaceApi";
13: import type { DiscoveryItem } from "@/redux/api/searchApi";
14: const ARXIV_ID_RE = /^\d{4}\.\d{4,5}(?:v\d+)?$|^[a-z-]+(?:\.[a-z-]+)*\/\d{7}$/i;
15: function extractDoi(input: string): string | null {
16:   const m = input.match(/10\.\d{4,9}\/[-._;()/:a-z0-9]+/i);
17:   return m ? m[0].replace(/\.$/, "") : null;
18: }
19: /**
20:  * Save an external discovery item (arXiv/OpenAlex) into the user's first
21:  * accessible workspace via the existing import flow — arXiv ID, DOI, or
22:  * smart URL depending on what the item carries. Shows a success toast and
23:  * navigates to the created paper.
24:  */
25: export function SaveExternalPaperButton({
26:   item,
27:   className,
28:   variant = "outline",
29:   size = "sm",
30: }: {
31:   item: DiscoveryItem;
32:   className?: string;
33:   variant?: ButtonProps["variant"];
34:   size?: ButtonProps["size"];
35: }) {
36:   const router = useRouter();
37:   const [saving, setSaving] = useState(false);
38:   const [saved, setSaved] = useState(false);
39:   const { data: workspaces } = useListWorkspacesQuery({ limit: 10, scope: "all" });
40:   const [importByArxiv] = useImportByArxivMutation();
41:   const [importByDOI] = useImportByDOIMutation();
42:   const [importBySmartURL] = useImportBySmartURLMutation();
43:   const workspace = workspaces?.data?.[0];
44:   const handleSave = async () => {
45:     if (saving || saved) return;
46:     if (!workspace) {
47:       showErrorToast("Create or join a workspace first to save papers");
48:       return;
49:     }
50:     setSaving(true);
51:     try {
52:       const workspaceId = workspace.id;
53:       const sourceInput = item.externalUrl ?? item.id;
54:       const doi = extractDoi(sourceInput);
55:       let result: { id?: string; paper?: { id?: string } } = {};
56:       if (item.source === "arxiv" && ARXIV_ID_RE.test(item.id)) {
57:         result = await importByArxiv({ arxivId: item.id, workspaceId }).unwrap();
58:       } else if (doi && (item.source === "openalex" || /doi\.org|10\.\d{4,9}\//i.test(sourceInput))) {
59:         result = await importByDOI({ doi, workspaceId }).unwrap();
60:       } else {
61:         result = await importBySmartURL({ url: sourceInput, workspaceId }).unwrap();
62:       }
63:       setSaved(true);
64:       showSuccessToast("Paper saved to your library");
65:       const paperId = result.paper?.id ?? result.id;
66:       if (paperId) {
67:         setTimeout(() => router.push(`/dashboard/papers/${paperId}`), 800);
68:       }
69:     } catch (e: unknown) {
70:       const err = e as { data?: { message?: string } };
71:       showErrorToast(err?.data?.message || "Failed to save paper");
72:     } finally {
73:       setSaving(false);
74:     }
75:   };
76:   return (
77:     <Button
78:       variant={saved ? "secondary" : variant}
79:       size={size}
80:       className={className}
81:       onClick={handleSave}
82:       disabled={saving}
83:     >
84:       {saving ? (
85:         <Loader2 className="h-4 w-4 mr-2 animate-spin" />
86:       ) : saved ? (
87:         <Check className="h-4 w-4 mr-2" />
88:       ) : (
89:         <Bookmark className="h-4 w-4 mr-2" />
90:       )}
91:       {saved ? "Saved" : "Save to Library"}
92:     </Button>
93:   );
94: }
</file>

