 58:         "Content-Type": "application/json",
 59:         "x-api-key": apiKey,
 60:         "anthropic-version": "2023-06-01",
 61:       },
 62:       body: JSON.stringify({
 63:         model,
 64:         max_tokens: maxTokens,
 65:         system: systemPrompt,
 66:         messages: [{ role: "user", content: userMessage }],
 67:       }),
 68:       signal: controller.signal,
 69:     });
 70:     if (!response.ok) {
 71:       const errorText = await response.text().catch(() => "Unknown error");
 72:       throw new Error(
 73:         `Claude API error: ${response.status} - ${errorText}`
 74:       );
 75:     }
 76:     return await response.json();
 77:   } finally {
 78:     clearTimeout(timeout);
 79:   }
 80: };
