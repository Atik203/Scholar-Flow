 1: import { createHmac, randomBytes } from "crypto";
 2: const PEPPER = (): string => {
 3:   const env = process.env.WEBHOOK_PEPPER;
 4:   if (env) return env;
 5:   if (process.env.NODE_ENV === "production") {
 6:     throw new Error("WEBHOOK_PEPPER is not configured");
 7:   }
 8:   return "scholarflow-dev-pepper";
 9: };
10: export const hashWebhookSecret = (raw: string): string => {
11:   return createHmac("sha256", PEPPER()).update(raw).digest("hex");
12: };
13: export const signWebhookPayload = (
14:   rawSecret: string,
15:   payload: string
16: ): string => {
17:   return createHmac("sha256", rawSecret).update(payload).digest("hex");
18: };
19: export const generateWebhookSecret = (): {
20:   raw: string;
21:   prefix: string;
22:   hash: string;
23: } => {
24:   const random = randomBytes(20).toString("hex");
25:   const raw = `whsec_${random}`;
26:   return {
27:     raw,
28:     prefix: raw.slice(0, 8),
29:     hash: hashWebhookSecret(raw),
30:   };
