 49:         return MessageSquare;
 50:     }
 51:   };
 52:   const getAnnotationColor = (type: AnnotationType) => {
 53:     switch (type) {
 54:       case "HIGHLIGHT":
 55:         return "text-yellow-700 dark:text-yellow-300 bg-yellow-100 dark:bg-yellow-900/30 border-yellow-300 dark:border-yellow-700";
 56:       case "UNDERLINE":
 57:         return "text-blue-700 dark:text-blue-300 bg-blue-100 dark:bg-blue-900/30 border-blue-300 dark:border-blue-700";
 58:       case "STRIKETHROUGH":
 59:         return "text-red-700 dark:text-red-300 bg-red-100 dark:bg-red-900/30 border-red-300 dark:border-red-700";
 60:       case "AREA":
 61:         return "text-purple-700 dark:text-purple-300 bg-purple-100 dark:bg-purple-900/30 border-purple-300 dark:border-purple-700";
 62:       case "COMMENT":
 63:         return "text-blue-700 dark:text-blue-300 bg-blue-100 dark:bg-blue-900/30 border-blue-300 dark:border-blue-700";
 64:       case "NOTE":
 65:         return "text-green-700 dark:text-green-300 bg-green-100 dark:bg-green-900/30 border-green-300 dark:border-green-700";
 66:       case "INK":
 67:         return "text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-900/30 border-gray-300 dark:border-gray-700";
 68:       default:
 69:         return "text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-900/30 border-gray-300 dark:border-gray-700";
 70:     }
 71:   };
 72:   const getPlaceholder = (type: AnnotationType) => {
 73:     switch (type) {
 74:       case "HIGHLIGHT":
 75:         return "Add a note about this highlight (optional)...";
 76:       case "UNDERLINE":
