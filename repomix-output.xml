<file path="apps/socket-server/src/server.ts">
  1: import cors from "cors";
  2: import express from "express";
  3: import http from "http";
  4: import jwt from "jsonwebtoken";
  5: import { Server, Socket } from "socket.io";
  6: const PORT = parseInt(process.env.PORT || "5001", 10);
  7: const JWT_SECRET = process.env.NEXTAUTH_SECRET;
  8: const FRONTEND_URL = process.env.FRONTEND_URL || "http://localhost:3000";
  9: interface AuthenticatedSocket extends Socket {
 10:   userId?: string;
 11:   userName?: string;
 12: }
 13: const app = express();
 14: app.use(
 15:   cors({
 16:     origin: FRONTEND_URL,
 17:     credentials: true,
 18:   })
 19: );
 20: app.get("/health", (_req, res) => {
 21:   res.json({
 22:     status: "ok",
 23:     uptime: process.uptime(),
 24:     timestamp: new Date().toISOString(),
 25:   });
 26: });
 27: const httpServer = http.createServer(app);
 28: const io = new Server(httpServer, {
 29:   cors: {
 30:     origin: FRONTEND_URL,
 31:     methods: ["GET", "POST"],
 32:     credentials: true,
 33:   },
 34:   pingTimeout: 60000,
 35:   pingInterval: 25000,
 36: });
 37: io.use((socket: Socket, next) => {
 38:   const token =
 39:     socket.handshake.auth.token ||
 40:     socket.handshake.headers.authorization?.replace("Bearer ", "");
 41:   if (!token) {
 42:     return next(new Error("Authentication required"));
 43:   }
 44:   if (!JWT_SECRET) {
 45:     return next(new Error("JWT secret not configured"));
 46:   }
 47:   try {
 48:     const decoded = jwt.verify(token, JWT_SECRET) as unknown as {
 49:       sub?: string;
 50:       id?: string;
 51:       name?: string;
 52:     };
 53:     const userId = decoded.sub || decoded.id;
 54:     if (!userId) {
 55:       return next(new Error("Invalid token: missing user identifier"));
 56:     }
 57:     (socket as AuthenticatedSocket).userId = userId;
 58:     (socket as AuthenticatedSocket).userName = decoded.name || "Unknown";
 59:     next();
 60:   } catch {
 61:     next(new Error("Invalid or expired token"));
 62:   }
 63: });
 64: const onlineUsers = new Map<string, Set<string>>();
 65: const UUID_SOURCE = "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}";
 66: const ROOM_RE = new RegExp(
 67:   `^(paper|discussion|workspace):(${UUID_SOURCE})$`,
 68:   "i"
 69: );
 70: const guardRoom = (socket: Socket, room: unknown): room is string => {
 71:   if (typeof room === "string" && ROOM_RE.test(room) && socket.rooms.has(room)) {
 72:     return true;
 73:   }
 74:   socket.emit("room:error", {
 75:     room,
 76:     message: "Access denied: join the room first",
 77:   });
 78:   return false;
 79: };
 80: io.on("connection", (socket: AuthenticatedSocket) => {
 81:   const { userId, userName } = socket;
 82:   if (!userId) { socket.disconnect(true); return; }
 83:   if (!onlineUsers.has(userId)) onlineUsers.set(userId, new Set());
 84:   onlineUsers.get(userId)!.add(socket.id);
 85:   console.log(`[WS] ${userName} (${userId}) connected`);
 86:   socket.broadcast.emit("presence:online", {
 87:     userId, userName, timestamp: new Date().toISOString(),
 88:   });
 89:   socket.on("room:join", (room: string) => {
 90:     if (typeof room !== "string" || !ROOM_RE.test(room)) {
 91:       socket.emit("room:error", { room, message: "Access denied: invalid room" });
 92:       return;
 93:     }
 94:     socket.join(room);
 95:     const count = io.sockets.adapter.rooms.get(room)?.size || 0;
 96:     socket.emit("room:joined", { room, memberCount: count });
 97:     socket.to(room).emit("presence:joined", { userId, userName, room, memberCount: count });
 98:   });
 99:   socket.on("room:leave", (room: string) => {
100:     socket.leave(room);
101:     const count = io.sockets.adapter.rooms.get(room)?.size || 0;
102:     socket.to(room).emit("presence:left", { userId, userName, room, memberCount: count });
103:   });
104:   socket.on("typing:start", ({ room, context }: { room: string; context?: string } = {} as { room: string; context?: string }) => {
105:     if (!guardRoom(socket, room)) return;
106:     socket.to(room).emit("typing:update", { userId, userName, room, isTyping: true, context });
107:   });
108:   socket.on("typing:stop", ({ room }: { room: string } = {} as { room: string }) => {
109:     if (!guardRoom(socket, room)) return;
110:     socket.to(room).emit("typing:update", { userId, userName, room, isTyping: false });
111:   });
112:   socket.on("editor:update", ({ room, update }: { room: string; update: number[] } = {} as { room: string; update: number[] }) => {
113:     if (!guardRoom(socket, room)) return;
114:     socket.to(room).emit("editor:update", { userId, update });
115:   });
116:   socket.on("editor:awareness", ({ room, state }: { room: string; state: any } = {} as { room: string; state: any }) => {
117:     if (!guardRoom(socket, room)) return;
118:     socket.to(room).emit("editor:awareness", { userId, userName, state });
119:   });
120:   socket.on("editor:sync-request", ({ room }: { room?: string } = {}) => {
121:     if (!guardRoom(socket, room)) return;
122:     socket.to(room).emit("editor:sync-request", { room });
123:   });
124:   socket.on("editor:sync-response", ({ room, update }: { room: string; update: number[] } = {} as { room: string; update: number[] }) => {
125:     if (!guardRoom(socket, room)) return;
126:     socket.to(room).emit("editor:sync-response", { update });
127:   });
128:   socket.on("discussion:message", ({ room, content, threadId }: { room: string; content: string; threadId?: string } = {} as { room: string; content: string; threadId?: string }) => {
129:     if (!guardRoom(socket, room)) return;
130:     if (typeof content !== "string" || !content.trim()) return;
131:     const message = {
132:       id: `${Date.now()}-${Math.random().toString(36).slice(2, 9)}`,
133:       userId, userName, content: content.slice(0, 5000), threadId,
134:       timestamp: new Date().toISOString(),
135:     };
136:     io.to(room).emit("discussion:message", message);
137:   });
138:   socket.on("disconnect", () => {
139:     if (userId && onlineUsers.has(userId)) {
140:       onlineUsers.get(userId)!.delete(socket.id);
141:       if (onlineUsers.get(userId)!.size === 0) onlineUsers.delete(userId);
142:     }
143:     socket.broadcast.emit("presence:offline", { userId, userName, timestamp: new Date().toISOString() });
144:     console.log(`[WS] ${userName} (${userId}) disconnected`);
145:   });
146:   socket.emit("auth:success", { userId, userName });
147: });
148: httpServer.listen(PORT, () => {
149:   console.log(`[SocketServer] Running on port ${PORT}`);
150:   console.log(`[SocketServer] CORS origin: ${FRONTEND_URL}`);
151: });
152: export default app;
</file>

<file path="IMPLEMENTATION.md">
  1: # Scholar-Flow Implementation Roadmap
  2: 
  3: **Architecture:** `/dashboard/(app)/*` for all roles, `/dashboard/(admin)/*` for admins.
  4: **Design system:** All dashboard pages must match `figma-make/pages/dashboard/**` exactly.
  5: **Animation:** `motion` (v12.40.0) installed at root.
  6: **DB policy:** Prefer Prisma ORM for new code; keep existing `$queryRaw` as-is.
  7: **Page coverage:** 98/102 figma-make (96.1%)
  8: 
  9: ---
 10: 
 11: ## Phase 1: Static Marketing Pages ✅
 12: 18-20 static pages — products (4), resources (4), company (4), enterprise (4), standalone (3). Backend: Faq/Testimonial/NewsletterSubscriber/ContactSubmission/PageContent models.
 13: 
 14: ## Phase 2: Auth & Onboarding ✅
 15: Login/Register/Forgot/Reset/Verify pages, onboarding flow, 7 form components, better-auth + JWT backend, onboarding fields on User.
 16: 
 17: ## Phase 3: Dashboard Shell ✅
 18: Route restructure to `(app)/` + `(modules)/` route groups, DashboardLayout with AppSidebar, core pages (home, profile, settings), UserPreference model.
 19: 
 20: ## Phase 4: Papers & Collections ✅
 21: Papers CRUD (upload/detail/search/import/editor) + Collections CRUD (create/detail/shared). AI recommendations service, paper importer (DOI/arXiv/URL/BibTeX/RIS), CollectionPaper status/star tracking.
 22: 
 23: ## Phase 5: Workspaces & Team ✅
 24: Workspaces (list/create/detail/members/settings) + Team (members/invitations/activity/settings/collaborator profile). WorkspaceSettings 1:1 model, WorkspaceVisibility enum, RBAC middleware (requireRole/requireTeamLead/requireAdmin), Resend email dispatcher.
 25: 
 26: ## Phase 6: Discussions, Notes & Citations ✅
 27: Discussions (threaded, pin/resolve), Notebook hierarchy (sections + ordering), 5 NoteTypes, 9 citation formats (VANCOUVER + ACS added), 3 new RTK slices.
 28: 
 29: ## Phase 7: Analytics, Notifications & Admin ✅
 30: Real SSE notification broadcaster, persisted notification settings, 6 new Prisma models (AdminReport/SystemAlert/WebhookEndpoint/WebhookDelivery/ApiKey/ContentReport), 8 admin pages, 7 analytics pages, NotificationBell popover.
 31: 
 32: ## Phase 8: Architecture Stabilization & Production Hardening ✅
 33: Unified entry points (server.ts), removed dead code (errorHandler.ts/AppError.ts/auth.controller.new.ts/Paper/ module), killed phase2Api RTK instance, fixed all `any` types, renamed modules to PascalCase, standardized to named exports, collapsed auth double-query, added EmptyState/ErrorState components, fixed proxy.ts (28 missing routes).
 34: 
 35: ## Phase 9: Polish & Performance ✅
 36: 8 remaining pages + invitation public backend (GET/POST /api/invitations/:token), eslint-plugin-jsx-a11y with 18 WCAG 2.1 AA rules (0 errors), route-level code splitting (Suspense + loading.tsx for 4 route groups), ResponsiveTable component, Cache-Control headers on API responses.
 37: 
 38: ---
 39: 
 40: ## 🔥 Phase 10 — FINAL PHASE: AI, Editor, Collaboration & Enterprise (Complete ✅)
 41: 
 42: Phase 10 is **complete**. Scholar-Flow v1.3.5 is a production-grade, AI-powered academic SaaS platform.
