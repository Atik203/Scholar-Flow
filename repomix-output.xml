 52:   useEffect(() => {
 53:     if (hydrated || isLoading) return;
 54:     const stored = (data?.data?.metadata?.editorSettings ?? {}) as Partial<
 55:       EditorSettings
 56:     >;
 57:     const local = readEditorSettings();
 58:     setSettings({
