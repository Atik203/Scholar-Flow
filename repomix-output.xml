118:             <p className="p-12 text-center text-muted-foreground">
119:               No payments found.
120:             </p>
121:           ) : (
122:             <div className="overflow-x-auto">
123:               <table className="w-full text-sm">
124:                 <thead>
125:                   <tr className="border-b text-xs text-muted-foreground">
126:                     <th className="text-left py-2">User</th>
127:                     <th className="text-left py-2">Amount</th>
128:                     <th className="text-left py-2">Status</th>
129:                     <th className="text-left py-2">Date</th>
130:                     <th className="text-right py-2">Action</th>
131:                   </tr>
132:                 </thead>
133:                 <tbody>
134:                   {payments.map((p) => (
135:                     <tr key={p.id} className="border-b last:border-0">
