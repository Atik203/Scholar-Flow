<file path="apps/backend/src/app/builders/QueryBuilder.ts">
  1: import { Prisma } from "@prisma/client";
  2: class QueryBuilder {
  3:   public query: Record<string, unknown>;
  4:   public prismaQuery: any;
  5:   public modelName: string;
  6:   constructor(modelName: string, query: Record<string, unknown>) {
  7:     this.modelName = modelName;
  8:     this.query = query;
  9:     this.prismaQuery = {
 10:       where: {},
 11:       orderBy: {},
 12:       skip: 0,
 13:       take: 10,
 14:       select: undefined,
 15:       include: undefined,
 16:     };
 17:   }
 18:   search(searchableFields: string[]) {
 19:     const searchTerm = this.query?.searchTerm as string;
 20:     if (searchTerm && searchableFields.length > 0) {
 21:       const searchConditions = searchableFields.map((field) => {
 22:         const fieldParts = field.split(".");
 23:         if (fieldParts.length === 1) {
 24:           return {
 25:             [field]: {
 26:               contains: searchTerm,
 27:               mode: "insensitive" as Prisma.QueryMode,
 28:             },
 29:           };
 30:         } else {
 31:           const [parent, child] = fieldParts;
 32:           return {
 33:             [parent]: {
 34:               [child]: {
 35:                 contains: searchTerm,
 36:                 mode: "insensitive" as Prisma.QueryMode,
 37:               },
 38:             },
 39:           };
 40:         }
 41:       });
 42:       if (this.prismaQuery.where.OR) {
 43:         this.prismaQuery.where.OR.push(...searchConditions);
 44:       } else {
 45:         this.prismaQuery.where.OR = searchConditions;
 46:       }
 47:     }
 48:     return this;
 49:   }
 50:   filter() {
 51:     const queryObj = { ...this.query };
 52:     const excludedFields = ["searchTerm", "page", "limit", "sort", "fields"];
 53:     excludedFields.forEach((field) => {
 54:       delete queryObj[field];
 55:     });
 56:     Object.entries(queryObj).forEach(([key, value]) => {
 57:       if (value !== undefined && value !== null && value !== "") {
 58:         // Handle different types of filters
 59:         if (typeof value === "string") {
 60:           if (key.includes("Id") || key === "id") {
 61:             this.prismaQuery.where[key] = value;
 62:           } else {
 63:             this.prismaQuery.where[key] = {
 64:               contains: value,
 65:               mode: "insensitive" as Prisma.QueryMode,
 66:             };
 67:           }
 68:         } else if (typeof value === "boolean") {
 69:           this.prismaQuery.where[key] = value;
 70:         } else if (typeof value === "number") {
 71:           this.prismaQuery.where[key] = value;
 72:         } else if (Array.isArray(value)) {
 73:           this.prismaQuery.where[key] = {
 74:             in: value,
 75:           };
 76:         } else {
 77:           this.prismaQuery.where[key] = value;
 78:         }
 79:       }
 80:     });
 81:     return this;
 82:   }
 83:   sort() {
 84:     const sortString = this.query.sort as string;
 85:     if (sortString) {
 86:       const sortFields = sortString.split(",");
 87:       const orderBy: any[] = [];
 88:       sortFields.forEach((field) => {
 89:         const trimmedField = field.trim();
 90:         if (trimmedField.startsWith("-")) {
 91:           const fieldName = trimmedField.substring(1);
 92:           const fieldParts = fieldName.split(".");
 93:           if (fieldParts.length === 1) {
 94:             orderBy.push({ [fieldName]: "desc" });
 95:           } else {
 96:             const [parent, child] = fieldParts;
 97:             orderBy.push({
 98:               [parent]: {
 99:                 [child]: "desc",
100:               },
101:             });
102:           }
103:         } else {
104:           const fieldParts = trimmedField.split(".");
105:           if (fieldParts.length === 1) {
106:             orderBy.push({ [trimmedField]: "asc" });
107:           } else {
108:             const [parent, child] = fieldParts;
109:             orderBy.push({
110:               [parent]: {
111:                 [child]: "asc",
112:               },
113:             });
114:           }
115:         }
116:       });
117:       this.prismaQuery.orderBy = orderBy;
118:     } else {
119:       this.prismaQuery.orderBy = { createdAt: "desc" };
120:     }
121:     return this;
122:   }
123:   paginate() {
124:     const page = this.query?.page ? parseInt(this.query.page as string) : 1;
125:     const limit = this.query?.limit ? parseInt(this.query.limit as string) : 10;
126:     const validPage = Math.max(1, page);
127:     const validLimit = Math.max(1, Math.min(100, limit));
128:     const skip = (validPage - 1) * validLimit;
129:     this.prismaQuery.skip = skip;
130:     this.prismaQuery.take = validLimit;
131:     return this;
132:   }
133:   fields(defaultFields?: string[]) {
134:     const fieldsString = this.query.fields as string;
135:     if (fieldsString) {
136:       const fields = fieldsString.split(",").map((f) => f.trim());
