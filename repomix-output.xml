 46:   const handleFileSelect = (event: React.ChangeEvent<HTMLInputElement>) => {
 47:     const file = event.target.files?.[0];
 48:     if (!file) return;
 49:     const allowedTypes = ["image/jpeg", "image/jpg", "image/png", "image/webp"];
