231:                                   )
232:                                 }
233:                               >
234:                                 <Pause className="h-3 w-3" />
235:                               </Button>
236:                             )}
237:                             {s.status === "ACTIVE" && s.cancelAtPeriodEnd && (
238:                               <Button
239:                                 size="sm"
240:                                 variant="outline"
241:                                 disabled={busy}
242:                                 title="Reactivate"
243:                                 onClick={() =>
244:                                   runAction(
245:                                     s.subscriptionId,
