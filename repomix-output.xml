281:       label: "Collaboration",
282:       href: "/collaborate",
283:       permission: "collaboration:join",
284:     },
285:   ];
286:   const teamLeadItems: NavigationLink[] = [
287:     { label: "Team", href: "/team", permission: "profile:read_team" },
288:   ];
289:   const adminItems: NavigationLink[] = [
290:     { label: "Admin", href: "/admin-overview", permission: "admin:dashboard" },
291:     { label: "Users", href: "/users", permission: "user:read" },
292:     { label: "Settings", href: "/dashboard/admin/settings", permission: "admin:settings" },
293:   ];
294:   let items = [...resolveNavigationLinks(userRole, baseItems)];
295:   if (hasRoleAccess(userRole, USER_ROLES.PRO_RESEARCHER)) {
296:     items = [...items, ...resolveNavigationLinks(userRole, proItems)];
297:   }
298:   if (hasRoleAccess(userRole, USER_ROLES.TEAM_LEAD)) {
299:     items = [...items, ...resolveNavigationLinks(userRole, teamLeadItems)];
300:   }
301:   if (hasRoleAccess(userRole, USER_ROLES.ADMIN)) {
302:     items = [...items, ...resolveNavigationLinks(userRole, adminItems)];
303:   }
304:   return items;
305: };
306: export const hasPermission = (
307:   userRole: string,
308:   permission: string
309: ): boolean => {
310:   const rolePermissions =
311:     ROLE_PERMISSIONS[userRole as keyof typeof ROLE_PERMISSIONS];
312:   return rolePermissions?.includes(permission as any) || false;
313: };
314: export const hasRoleAccess = (
315:   userRole?: string,
316:   requiredRole?: string
317: ): boolean => {
318:   if (!userRole || !requiredRole) return false;
319:   const userLevel =
320:     ROLE_HIERARCHY[userRole as keyof typeof ROLE_HIERARCHY] || 0;
321:   const requiredLevel =
322:     ROLE_HIERARCHY[requiredRole as keyof typeof ROLE_HIERARCHY] || 0;
323:   return userLevel >= requiredLevel;
324: };
325: export const canAccessRoute = (
326:   userRole: string,
327:   routePermission: string
328: ): boolean => {
329:   return hasPermission(userRole, routePermission);
330: };
331: export const getRoleBadgeVariant = (role: string) => {
332:   switch (role) {
333:     case USER_ROLES.ADMIN:
334:       return "destructive";
335:     case USER_ROLES.TEAM_LEAD:
336:       return "default";
337:     case USER_ROLES.PRO_RESEARCHER:
338:       return "secondary";
339:     case USER_ROLES.RESEARCHER:
340:     default:
341:       return "outline";
342:   }
343: };
344: export const getRoleColor = (role: string) => {
345:   switch (role) {
346:     case USER_ROLES.ADMIN:
347:       return "text-red-600 bg-red-50 border-red-200";
348:     case USER_ROLES.TEAM_LEAD:
349:       return "text-blue-600 bg-blue-50 border-blue-200";
350:     case USER_ROLES.PRO_RESEARCHER:
351:       return "text-green-600 bg-green-50 border-green-200";
352:     case USER_ROLES.RESEARCHER:
353:     default:
