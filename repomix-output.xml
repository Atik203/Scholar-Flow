306: /**
307:  * Attribute-order-agnostic HTML <meta>/<link> parser. Collects every meta by
308:  * its name/property/itemprop key (multi-values joined with \0) plus
309:  * rel="citation_pdf_url" links. Enables og:title, DC.date, article:author,
310:  * prism.doi etc. without brittle positional regexes.
311:  */
312: function parseMetaTags(html: string): Map<string, string> {
313:   const map = new Map<string, string>();
314:   const metaRe = /<meta\b[^>]*>/gi;
315:   let m: RegExpExecArray | null;
316:   while ((m = metaRe.exec(html)) !== null) {
317:     const tag = m[0];
318:     const attr = (name: string): string => {
319:       const a = tag.match(
320:         new RegExp(`${name}\\s*=\\s*(?:"([^"]*)"|'([^']*)'|([^\\s>]+))`, "i"),
321:       );
322:       return a ? decodeEntities(a[1] ?? a[2] ?? a[3] ?? "") : "";
323:     };
324:     const key = (attr("name") || attr("property") || attr("itemprop") || "").toLowerCase();
325:     const content = attr("content");
326:     if (!key || !content) continue;
327:     const previous = map.get(key);
328:     map.set(key, previous ? `${previous}\u0000${content}` : content);
329:   }
330:   const linkRe = /<link\b[^>]*>/gi;
331:   let lm: RegExpExecArray | null;
332:   while ((lm = linkRe.exec(html)) !== null) {
333:     const rel = lm[0].match(/rel\s*=\s*["']([^"']+)["']/i)?.[1]?.toLowerCase() || "";
334:     const href = lm[0].match(/href\s*=\s*["']([^"']+)["']/i)?.[1] || "";
335:     if (rel.includes("citation_pdf_url") && href && !map.has("citation_pdf_url")) {
336:       map.set("citation_pdf_url", decodeEntities(href));
337:     }
338:   }
339:   return map;
340: }
341: function findMeta(map: Map<string, string>, candidates: string[]): string {
342:   for (const key of candidates) {
343:     const value = map.get(key);
344:     if (value) return value;
345:   }
346:   return "";
347: }
348: function sanitizeFilename(name: string): string {
