410:       const mammothResult = await mammoth.convertToHtml(mammothBuffer, {
411:         styleMap: [
412:           "p[style-name='Heading 1'] => h1:fresh",
413:           "p[style-name='Heading 2'] => h2:fresh",
414:           "p[style-name='Heading 3'] => h3:fresh",
415:           "p[style-name='Title'] => h1.title:fresh",
416:           "p[style-name='Quote'] => blockquote:fresh",
417:         ],
418:       });
419:       const htmlContent = mammothResult.value;
420:       const plainTextResult = await mammoth.extractRawText(mammothBuffer);
421:       const extractedText = plainTextResult.value;
422:       console.log(
423:         `[DocumentExtraction] DOCX extraction completed. Text length: ${extractedText.length}, HTML length: ${htmlContent.length}`
424:       );
