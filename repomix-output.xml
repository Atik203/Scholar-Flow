  1: import { Prisma } from "../shared/prisma";
  2: import { NextFunction, Request, Response } from "express";
  3: import { ZodError } from "zod";
  4: import config from "../config";
  5: import {
  6:   ApiError,
  7:   handleDuplicateError,
  8:   handleJWTError,
  9:   handlePostgresError,
 10:   handlePrismaError,
 11:   handleTokenExpiredError,
 12:   handleZodError,
 13: } from "../errors";
 14: import { TErrorSources } from "../interfaces/error";
 15: const globalErrorHandler = (
 16:   err: unknown,
 17:   req: Request,
 18:   res: Response,
 19:   _next: NextFunction
 20: ) => {
 21:   console.error("❌ GLOBAL ERROR HANDLER CAUGHT:", {
 22:     errorType: err?.constructor?.name,
 23:     message: (err as Error)?.message,
 24:     code: (err as any)?.code,
 25:     stack: config.env === "development" ? (err as Error)?.stack : undefined,
 26:     details: (err as any)?.detail,
 27:     column: (err as any)?.column,
 28:     constraint: (err as any)?.constraint,
 29:     table: (err as any)?.table,
 30:   });
 31:   let statusCode = 500;
 32:   let message = "Something went wrong!";
 33:   let errorSources: TErrorSources = [
 34:     {
 35:       path: "",
 36:       message: "Something went wrong!",
 37:     },
 38:   ];
 39:   // Handle Zod validation errors
 40:   if (err instanceof ZodError) {
 41:     const simplifiedError = handleZodError(err);
 42:     statusCode = simplifiedError?.statusCode;
 43:     message = simplifiedError?.message;
 44:     errorSources = simplifiedError?.errorSources;
 45:   }
 46:   // Handle Prisma known request errors
 47:   else if (err instanceof Prisma.PrismaClientKnownRequestError) {
 48:     const simplifiedError = handlePrismaError(err);
 49:     statusCode = simplifiedError?.statusCode;
 50:     message = simplifiedError?.message;
 51:     errorSources = simplifiedError?.errorSources;
 52:   }
 53:   // Handle Prisma validation errors
 54:   else if (err instanceof Prisma.PrismaClientValidationError) {
 55:     statusCode = 400;
 56:     message = "Validation Error";
 57:     errorSources = [
 58:       {
 59:         path: "validation",
 60:         message: err.message,
 61:       },
 62:     ];
 63:   }
 64:   else if ((err as any)?.name === "MulterError") {
 65:     const multerCode = (err as any)?.code as string | undefined;
 66:     statusCode = multerCode === "LIMIT_FILE_SIZE" ? 413 : 400;
 67:     message =
 68:       multerCode === "LIMIT_FILE_SIZE"
 69:         ? "File too large"
 70:         : `Upload failed: ${multerCode ?? "unknown multer error"}`;
 71:     errorSources = [
 72:       {
 73:         path: "upload",
 74:         message,
 75:       },
 76:     ];
 77:   }
 78:   else if ((err as any)?.code && typeof (err as any).code === "string") {
 79:     const simplifiedError = handlePostgresError(err);
 80:     statusCode = simplifiedError?.statusCode;
 81:     message = simplifiedError?.message;
 82:     errorSources = simplifiedError?.errorSources;
 83:   }
 84:   else if ((err as Error)?.name === "JsonWebTokenError") {    const simplifiedError = handleJWTError();
 85:     statusCode = simplifiedError?.statusCode;
 86:     message = simplifiedError?.message;
 87:     errorSources = simplifiedError?.errorSources;
 88:   }
 89:   else if ((err as Error)?.name === "TokenExpiredError") {
 90:     const simplifiedError = handleTokenExpiredError();
 91:     statusCode = simplifiedError?.statusCode;
 92:     message = simplifiedError?.message;
 93:     errorSources = simplifiedError?.errorSources;
 94:   }
 95:   else if ((err as any)?.code === 11000) {
 96:     const simplifiedError = handleDuplicateError(err);
 97:     statusCode = simplifiedError?.statusCode;
 98:     message = simplifiedError?.message;
 99:     errorSources = simplifiedError?.errorSources;
100:   }
101:   else if (err instanceof ApiError) {
102:     statusCode = err?.statusCode;
103:     message = err?.message;
104:     errorSources = [
105:       {
106:         path: "",
107:         message: err?.message,
108:       },
109:     ];
110:   }
111:   // Handle generic Error instances
112:   else if (err instanceof Error) {
113:     message = err?.message;
114:     errorSources = [
115:       {
116:         path: "",
117:         message: err?.message,
118:       },
119:     ];
120:   }
121:   return res.status(statusCode).json({
122:     success: false,
123:     message,
124:     errorSources,
125:     stack: config.env === "development" ? (err as Error)?.stack : null,
126:   });
127: };
128: export default globalErrorHandler;
</file>

