 1: import type { TUser } from "@/types/user";
 2: import { createSlice, PayloadAction } from "@reduxjs/toolkit";
 3: import { clearAuthCookie, setAuthCookie } from "@/lib/auth/authCookies";
 4: export interface AuthState {
 5:   user: TUser | null;
 6:   accessToken: string | null;
 7:   sessionToken: string | null;
 8:   isAuthenticated: boolean;
 9:   isLoading: boolean;
10: }
11: const initialState: AuthState = {
12:   user: null,
13:   accessToken: null,
14:   sessionToken: null,
15:   isAuthenticated: false,
16:   isLoading: true,
17: };
18: const authSlice = createSlice({
19:   name: "auth",
20:   initialState,
21:   reducers: {
22:     setCredentials: (
23:       state,
24:       action: PayloadAction<{
25:         user: TUser;
26:         accessToken: string;
27:         sessionToken?: string | null;
28:       }>
29:     ) => {
30:       state.user = action.payload.user;
31:       state.accessToken = action.payload.accessToken;
32:       state.sessionToken = action.payload.sessionToken ?? null;
33:       state.isAuthenticated = true;
34:       state.isLoading = false;
35:       setAuthCookie();
36:     },
37:     clearCredentials: (state) => {
38:       state.user = null;
39:       state.accessToken = null;
40:       state.sessionToken = null;
41:       state.isAuthenticated = false;
42:       state.isLoading = false;
43:       clearAuthCookie();
44:     },
45:     setLoading: (state, action: PayloadAction<boolean>) => {
46:       state.isLoading = action.payload;
47:     },
48:     updateUser: (state, action: PayloadAction<Partial<TUser>>) => {
49:       if (state.user) {
50:         state.user = { ...state.user, ...action.payload };
51:       }
52:     },
53:   },
54: });
55: export const { setCredentials, clearCredentials, setLoading, updateUser } =
56:   authSlice.actions;
57: export default authSlice.reducer;
58: export const selectCurrentUser = (state: { auth: AuthState }) =>
59:   state.auth.user;
60: export const selectAccessToken = (state: { auth: AuthState }) =>
61:   state.auth.accessToken;
62: export const selectSessionToken = (state: { auth: AuthState }) =>
63:   state.auth.sessionToken;
64: export const selectIsAuthenticated = (state: { auth: AuthState }) =>
65:   state.auth.isAuthenticated;
66: export const selectAuthLoading = (state: { auth: AuthState }) =>
67:   state.auth.isLoading;
