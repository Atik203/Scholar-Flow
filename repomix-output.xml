  6: import { promisify } from "util";
  7: const execFileAsync = promisify(execFile);
  8: interface ExtractionResult {
  9:   success: boolean;
 10:   text?: string;
 11:   pageCount?: number;
 12:   method: "poppler" | "ocr" | "unpdf" | "fallback";
 13:   error?: string;
