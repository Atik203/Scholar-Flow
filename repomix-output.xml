  7: } from "@/lib/auth/roles";
  8: import { cn } from "@/lib/utils";
  9: interface RoleBadgeProps {
 10:   role: string;
 11:   size?: "sm" | "md" | "lg";
 12:   variant?: "solid" | "outline" | "soft";
 13:   className?: string;
 14: }
 15: export function RoleBadge({
 16:   role,
 17:   size = "md",
 18:   variant = "soft",
 19:   className,
 20: }: RoleBadgeProps) {
 21:   const roleLabel = ROLE_LABELS[role as keyof typeof ROLE_LABELS] || role;
 22:   const sizeClasses = {
 23:     sm: "text-xs px-2 py-0.5",
 24:     md: "text-sm px-2.5 py-0.5",
 25:     lg: "text-base px-3 py-1",
 26:   };
 27:   const getVariantClasses = () => {
 28:     switch (variant) {
 29:       case "solid":
 30:         return getRoleBadgeVariant(role);
 31:       case "outline":
 32:         return (
 33:           "border-2 bg-transparent " +
 34:           getRoleColor(role).replace("bg-", "border-").replace("-50", "-200")
 35:         );
 36:       case "soft":
 37:       default:
 38:         return cn("border", getRoleColor(role));
 39:     }
 40:   };
 41:   return (
 42:     <Badge
 43:       variant={variant === "solid" ? getRoleBadgeVariant(role) : "outline"}
 44:       className={cn(
 45:         sizeClasses[size],
 46:         variant !== "solid" && getRoleColor(role),
 47:         "font-medium",
 48:         className
 49:       )}
 50:     >
 51:       {roleLabel}
 52:     </Badge>
 53:   );
 54: }
 55: interface RoleIndicatorProps {
 56:   role: string;
 57:   showLabel?: boolean;
 58:   size?: "sm" | "md" | "lg";
 59: }
 60: export function RoleIndicator({
 61:   role,
 62:   showLabel = true,
 63:   size = "md",
 64: }: RoleIndicatorProps) {
 65:   const getIndicatorColor = () => {
 66:     switch (role) {
 67:       case USER_ROLES.ADMIN:
 68:         return "bg-red-500";
 69:       case USER_ROLES.TEAM_LEAD:
 70:         return "bg-blue-500";
 71:       case USER_ROLES.PRO_RESEARCHER:
 72:         return "bg-green-500";
 73:       case USER_ROLES.RESEARCHER:
 74:       default:
 75:         return "bg-gray-500";
 76:     }
