 52: const useTypewriter = (
 53:   words: string[],
 54:   typingSpeed = 100,
 55:   deletingSpeed = 50,
 56:   pauseDuration = 2000,
 57: ) => {
 58:   const [currentWordIndex, setCurrentWordIndex] = useState(0);
 59:   const [currentText, setCurrentText] = useState("");
 60:   const [isDeleting, setIsDeleting] = useState(false);
 61:   useEffect(() => {
 62:     const word = words[currentWordIndex];
 63:     const timeout = setTimeout(
 64:       () => {
 65:         if (!isDeleting) {
 66:           if (currentText.length < word.length) {
 67:             setCurrentText(word.slice(0, currentText.length + 1));
 68:           } else {
 69:             setTimeout(() => setIsDeleting(true), pauseDuration);
 70:           }
 71:         } else {
 72:           if (currentText.length > 0) {
 73:             setCurrentText(word.slice(0, currentText.length - 1));
 74:           } else {
 75:             setIsDeleting(false);
 76:             setCurrentWordIndex((prev) => (prev + 1) % words.length);
 77:           }
 78:         }
 79:       },
 80:       isDeleting ? deletingSpeed : typingSpeed,
 81:     );
 82:     return () => clearTimeout(timeout);
 83:   }, [
 84:     currentText,
 85:     isDeleting,
 86:     currentWordIndex,
 87:     words,
 88:     typingSpeed,
 89:     deletingSpeed,
 90:     pauseDuration,
 91:   ]);
 92:   return currentText;
 93: };
 94: // Animated counter component with IntersectionObserver
 95: const AnimatedCounter = ({
 96:   target,
 97:   suffix = "",
 98:   duration = 2,
 99:   decimals = 0,
100: }: {
101:   target: number;
102:   suffix?: string;
103:   duration?: number;
104:   decimals?: number;
105: }) => {
106:   const [count, setCount] = useState(0);
107:   const [isVisible, setIsVisible] = useState(false);
108:   const ref = useRef<HTMLSpanElement>(null);
109:   useEffect(() => {
110:     const observer = new IntersectionObserver(
111:       ([entry]) => {
112:         if (entry.isIntersecting && !isVisible) {
113:           setIsVisible(true);
114:         }
115:       },
116:       { threshold: 0.5 },
117:     );
118:     if (ref.current) {
119:       observer.observe(ref.current);
120:     }
121:     return () => observer.disconnect();
122:   }, [isVisible]);
123:   useEffect(() => {
124:     if (!isVisible) return;
125:     const steps = 60;
126:     const increment = target / steps;
127:     let current = 0;
128:     const timer = setInterval(
129:       () => {
130:         current += increment;
131:         if (current >= target) {
132:           setCount(target);
133:           clearInterval(timer);
134:         } else {
135:           setCount(
136:             decimals > 0
137:               ? parseFloat(current.toFixed(decimals))
138:               : Math.floor(current),
139:           );
140:         }
141:       },
142:       (duration * 1000) / steps,
143:     );
144:     return () => clearInterval(timer);
145:   }, [isVisible, target, duration, decimals]);
146:   return (
147:     <span ref={ref}>
148:       {decimals > 0 ? count.toFixed(decimals) : count.toLocaleString()}
149:       {suffix}
150:     </span>
151:   );
152: };
