226:       errorCode === "ETIMEDOUT" ||
227:       errorMessage.includes("Redis") ||
228:       errorMessage.includes("connection")
229:     ) {
230:       console.warn(
231:         `[DocumentQueue] Redis connection issue detected for paper: ${paperId}. Throwing error to trigger fallback.`
232:       );
233:       throw new Error("QUEUE_NOT_AVAILABLE");
234:     }
235:     throw error;
236:   }
237: }
238: export async function queuePDFExtraction(paperId: string): Promise<void> {
239:   return queueDocumentExtraction(paperId);
