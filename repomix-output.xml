 817:   /**
 818:    * Upsert WorkspaceSettings for a workspace. Caller must be the owner.
 819:    */
 820:   static async updateWorkspaceSettings(
 821:     userId: string,
 822:     workspaceId: string,
 823:     data: {
 824:       color?: string;
 825:       coverImageKey?: string | null;
 826:       iconKey?: string | null;
 827:       allowExternalSharing?: boolean;
 828:       allowDownload?: boolean;
 829:       defaultMemberRole?: string;
 830:       requireApprovalForJoin?: boolean;
 831:       allowMemberInvites?: boolean;
 832:       allowPublicCollections?: boolean;
 833:       aiFeaturesEnabled?: boolean;
 834:       enforce2FAForMembers?: boolean;
 835:       allowedEmailDomains?: string[];
 836:     }
 837:   ) {
 838:     const perm = await prisma.$queryRaw<any[]>`
 839:       SELECT m.role, w."ownerId"
 840:       FROM "WorkspaceMember" m JOIN "Workspace" w ON w.id = m."workspaceId"
 841:       WHERE m."userId" = ${userId} AND m."workspaceId" = ${workspaceId} AND m."isDeleted" = false AND w."isDeleted" = false
 842:       LIMIT 1
 843:     `;
 844:     const ctx = perm[0];
 845:     if (!ctx) throw new ApiError(403, "Not a member of this workspace");
 846:     if (ctx.role !== "OWNER" && ctx.ownerId !== userId) {
 847:       throw new ApiError(403, "Only workspace owner can update settings");
 848:     }
 849:     const updated = await prisma.workspaceSettings.upsert({
 850:       where: { workspaceId },
 851:       create: {
 852:         workspaceId,
 853:         color: data.color,
 854:         coverImageKey: data.coverImageKey,
 855:         iconKey: data.iconKey,
 856:         allowExternalSharing: data.allowExternalSharing,
 857:         allowDownload: data.allowDownload,
 858:         defaultMemberRole: data.defaultMemberRole as any,
 859:         requireApprovalForJoin: data.requireApprovalForJoin,
 860:         allowMemberInvites: data.allowMemberInvites,
 861:         allowPublicCollections: data.allowPublicCollections,
 862:         aiFeaturesEnabled: data.aiFeaturesEnabled,
 863:         enforce2FAForMembers: data.enforce2FAForMembers,
 864:         allowedEmailDomains: data.allowedEmailDomains ?? [],
 865:       },
 866:       update: {
 867:         ...(data.color !== undefined && { color: data.color }),
 868:         ...(data.coverImageKey !== undefined && { coverImageKey: data.coverImageKey }),
 869:         ...(data.iconKey !== undefined && { iconKey: data.iconKey }),
 870:         ...(data.allowExternalSharing !== undefined && { allowExternalSharing: data.allowExternalSharing }),
 871:         ...(data.allowDownload !== undefined && { allowDownload: data.allowDownload }),
 872:         ...(data.defaultMemberRole !== undefined && { defaultMemberRole: data.defaultMemberRole as any }),
 873:         ...(data.requireApprovalForJoin !== undefined && { requireApprovalForJoin: data.requireApprovalForJoin }),
 874:         ...(data.allowMemberInvites !== undefined && { allowMemberInvites: data.allowMemberInvites }),
 875:         ...(data.allowPublicCollections !== undefined && { allowPublicCollections: data.allowPublicCollections }),
 876:         ...(data.aiFeaturesEnabled !== undefined && { aiFeaturesEnabled: data.aiFeaturesEnabled }),
 877:         ...(data.enforce2FAForMembers !== undefined && { enforce2FAForMembers: data.enforce2FAForMembers }),
 878:         ...(data.allowedEmailDomains !== undefined && { allowedEmailDomains: data.allowedEmailDomains }),
 879:       },
 880:     });
 881:     // Keep denormalized color in sync
 882:     if (data.color) {
 883:       await prisma.workspace.update({
 884:         where: { id: workspaceId },
 885:         data: { color: data.color },
 886:       });
 887:     }
 888:     // Log activity
 889:     await prisma.activityLogEntry.create({
 890:       data: {
 891:         userId,
 892:         workspaceId,
 893:         entity: "WorkspaceSettings",
 894:         entityId: workspaceId,
 895:         action: "UPDATE",
 896:         severity: "INFO",
 897:       },
 898:     });
 899:     return updated;
 900:   }
 901:   /**
 902:    * Get aggregated stats for a workspace (papers, collections, members, storage estimate).
 903:    */
 904:   static async getWorkspaceStats(userId: string, workspaceId: string) {
 905:     await this.getWorkspace(userId, workspaceId);
 906:     const [papers, collections, members] = await Promise.all([
 907:       prisma.paper.count({ where: { workspaceId, isDeleted: false } }),
 908:       prisma.collection.count({ where: { workspaceId, isDeleted: false } }),
 909:       prisma.workspaceMember.count({ where: { workspaceId, isDeleted: false } }),
 910:     ]);
 911:     // Storage estimate: ~250KB per paper, 50KB per collection (rough heuristic)
 912:     const storageBytes = papers * 250_000 + collections * 50_000;
 913:     const storageMB = Math.round(storageBytes / (1024 * 1024) * 10) / 10;
 914:     return {
 915:       papers,
 916:       collections,
 917:       members,
 918:       storage: storageMB < 1 ? `${Math.round(storageBytes / 1024)} KB` : `${storageMB} MB`,
 919:     };
 920:   }
 921:   static async getWorkspaceActivity(
 922:     userId: string,
 923:     workspaceId: string,
 924:     limit: number,
 925:     cursor: string | undefined
 926:   ) {
 927:     await this.getWorkspace(userId, workspaceId);
 928:     const take = limit + 1;
 929:     const where: any = {
 930:       workspaceId,
 931:       isDeleted: false,
 932:     };
 933:     if (cursor) {
 934:       const cur = await prisma.activityLogEntry.findUnique({
 935:         where: { id: cursor },
 936:         select: { createdAt: true },
 937:       });
 938:       if (cur) where.createdAt = { lt: cur.createdAt };
 939:     }
 940:     const entries = await prisma.activityLogEntry.findMany({
 941:       where,
 942:       take,
 943:       orderBy: [{ createdAt: "desc" }, { id: "desc" }],
 944:       include: {
 945:         user: {
 946:           select: {
 947:             id: true,
 948:             name: true,
 949:             firstName: true,
 950:             lastName: true,
 951:             image: true,
 952:           },
 953:         },
 954:       },
 955:     });
 956:     const hasMore = entries.length > limit;
 957:     const sliced = hasMore ? entries.slice(0, -1) : entries;
 958:     return {
 959:       result: sliced,
 960:       meta: {
 961:         limit,
 962:         hasMore,
 963:         nextCursor: hasMore ? sliced[sliced.length - 1].id : null,
 964:       },
 965:     };
 966:   }
