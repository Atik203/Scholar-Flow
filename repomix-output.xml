239:               </div>
240:               <Button
241:                 variant="ghost"
242:                 size="sm"
243:                 onClick={() =>
244:                   setCurrentMonth(
245:                     new Date(
246:                       currentMonth.getFullYear(),
247:                       currentMonth.getMonth() + 1,
248:                       1
249:                     )
250:                   )
251:                 }
252:                 className="h-7 w-7 p-0"
253:               >
254:                 <ChevronRight className="h-4 w-4" />
255:               </Button>
256:             </div>
257:             <div className="grid grid-cols-7 gap-1 mb-2">
258:               {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map((day) => (
