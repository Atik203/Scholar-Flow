138:   const [sort, setSort] = useState<SortMode>("page-asc");
139:   const [pendingDelete, setPendingDelete] = useState<Annotation | null>(null);
140:   const hasActiveFilters = search.length > 0 || typeFilter !== null || colorFilter !== null;
141:   const filtered = useMemo(() => {
