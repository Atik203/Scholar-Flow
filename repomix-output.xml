 27: export class DiscussionService {
 28:   static async createThread(
 29:     req: AuthRequest,
 30:     data: CreateDiscussionRequest
 31:   ): Promise<any> {
 32:     const userId = req.user?.id;
 33:     if (!userId) {
 34:       throw new ApiError(401, 'User not authenticated');
 35:     }
 36:     try {
 37:       if (data.paperId) {
 38:         const paper = await prisma.paper.findFirst({
 39:           where: {
 40:             id: data.paperId,
 41:             isDeleted: false,
 42:             OR: [
 43:               { uploaderId: userId },
 44:               {
 45:                 workspace: {
 46:                   members: {
 47:                     some: {
 48:                       userId: userId,
 49:                       isDeleted: false
 50:                     }
 51:                   }
 52:                 }
 53:               }
 54:             ]
 55:           }
 56:         });
 57:         if (!paper) {
 58:           throw new ApiError(404, 'Paper not found or access denied');
 59:         }
 60:       }
 61:       if (data.collectionId) {
 62:         const collection = await prisma.collection.findFirst({
 63:           where: {
 64:             id: data.collectionId,
 65:             isDeleted: false,
 66:             OR: [
 67:               { ownerId: userId },
 68:               {
 69:                 members: {
 70:                   some: {
 71:                     userId: userId,
 72:                     status: 'ACCEPTED',
 73:                     isDeleted: false
 74:                   }
 75:                 }
 76:               }
 77:             ]
 78:           }
 79:         });
 80:         if (!collection) {
 81:           throw new ApiError(404, 'Collection not found or access denied');
 82:         }
 83:       }
 84:       if (data.workspaceId) {
 85:         const workspace = await prisma.workspace.findFirst({
 86:           where: {
 87:             id: data.workspaceId,
 88:             isDeleted: false,
 89:             OR: [
 90:               { ownerId: userId },
 91:               {
 92:                 members: {
 93:                   some: {
 94:                     userId: userId,
 95:                     isDeleted: false
 96:                   }
 97:                 }
 98:               }
 99:             ]
100:           }
101:         });
102:         if (!workspace) {
103:           throw new ApiError(404, 'Workspace not found or access denied');
104:         }
105:       }
106:       const thread = await prisma.discussionThread.create({
107:         data: {
108:           paperId: data.paperId,
109:           collectionId: data.collectionId,
110:           workspaceId: data.workspaceId,
111:           userId,
112:           title: data.title,
113:           content: data.content,
114:           tags: data.tags || []
115:         },
116:         include: {
117:           user: {
118:             select: {
119:               id: true,
120:               name: true,
121:               firstName: true,
122:               lastName: true,
123:               image: true
124:             }
125:           },
126:           paper: {
127:             select: {
128:               id: true,
129:               title: true
130:             }
131:           },
132:           collection: {
133:             select: {
134:               id: true,
135:               name: true
136:             }
137:           },
138:           workspace: {
139:             select: {
140:               id: true,
141:               name: true
142:             }
143:           },
144:           _count: {
145:             select: {
146:               messages: true
147:             }
148:           }
149:         }
150:       });
151:       await this.logActivity(userId, data.workspaceId || null, 'discussion', thread.id, 'created', {
152:         title: data.title,
153:         entityType: data.paperId ? 'paper' : data.collectionId ? 'collection' : 'workspace',
154:         entityId: data.paperId || data.collectionId || data.workspaceId
155:       });
156:       return thread;
157:     } catch (error) {
158:       if (error instanceof ApiError) throw error;
159:       throw new ApiError(500, 'Failed to create discussion thread');
160:     }
161:   }
162:   static async getThreads(
163:     req: AuthRequest,
164:     filters: {
165:       paperId?: string;
166:       collectionId?: string;
167:       workspaceId?: string;
168:       isResolved?: boolean;
169:       isPinned?: boolean;
170:       tags?: string[];
171:       limit?: number;
172:       offset?: number;
173:     }
174:   ): Promise<{ threads: any[]; total: number }> {
175:     const userId = req.user?.id;
176:     if (!userId) {
177:       throw new ApiError(401, 'User not authenticated');
178:     }
179:     try {
180:       const where: any = {
181:         isDeleted: false,
182:         OR: [
183:           { userId },
184:           { paperId: { not: null } },
185:           { collectionId: { not: null } },
186:           { workspaceId: { not: null } }
187:         ]
188:       };
189:       if (filters.paperId) {
190:         where.paperId = filters.paperId;
191:         const paper = await prisma.paper.findFirst({
192:           where: {
193:             id: filters.paperId,
194:             isDeleted: false,
195:             OR: [
196:               { uploaderId: userId },
197:               {
198:                 workspace: {
199:                   members: {
200:                     some: {
201:                       userId: userId,
202:                       isDeleted: false
203:                     }
204:                   }
205:                 }
206:               }
207:             ]
208:           }
209:         });
210:         if (!paper) {
211:           throw new ApiError(404, 'Paper not found or access denied');
212:         }
213:       }
214:       if (filters.collectionId) {
215:         where.collectionId = filters.collectionId;
216:         const collection = await prisma.collection.findFirst({
217:           where: {
218:             id: filters.collectionId,
219:             isDeleted: false,
220:             OR: [
221:               { ownerId: userId },
222:               {
223:                 members: {
224:                   some: {
225:                     userId: userId,
226:                     status: 'ACCEPTED',
227:                     isDeleted: false
228:                   }
229:                 }
230:               }
231:             ]
232:           }
233:         });
234:         if (!collection) {
235:           throw new ApiError(404, 'Collection not found or access denied');
236:         }
237:       }
238:       if (filters.workspaceId) {
239:         where.workspaceId = filters.workspaceId;
240:         const workspace = await prisma.workspace.findFirst({
241:           where: {
242:             id: filters.workspaceId,
243:             isDeleted: false,
244:             OR: [
245:               { ownerId: userId },
246:               {
247:                 members: {
248:                   some: {
249:                     userId: userId,
250:                     isDeleted: false
251:                   }
252:                 }
253:               }
254:             ]
255:           }
256:         });
257:         if (!workspace) {
258:           throw new ApiError(404, 'Workspace not found or access denied');
259:         }
260:       }
261:       if (filters.isResolved !== undefined) {
262:         where.isResolved = filters.isResolved;
263:       }
264:       if (filters.isPinned !== undefined) {
265:         where.isPinned = filters.isPinned;
266:       }
267:       if (filters.tags && filters.tags.length > 0) {
268:         where.tags = {
269:           hasSome: filters.tags
270:         };
271:       }
272:       const [threads, total] = await Promise.all([
273:         prisma.discussionThread.findMany({
274:           where,
275:           include: {
276:             user: {
277:               select: {
278:                 id: true,
279:                 name: true,
280:                 firstName: true,
281:                 lastName: true,
282:                 image: true
283:               }
284:             },
285:             paper: {
286:               select: {
287:                 id: true,
288:                 title: true
289:               }
290:             },
291:             collection: {
292:               select: {
293:                 id: true,
294:                 name: true
295:               }
296:             },
297:             workspace: {
298:               select: {
299:                 id: true,
300:                 name: true
301:               }
302:             },
303:             _count: {
304:               select: {
305:                 messages: true
306:               }
307:             },
308:             messages: {
309:               take: 1,
310:               orderBy: {
311:                 createdAt: 'desc'
