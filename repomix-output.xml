332:   /**
333:    * Get user statistics for dashboard cards
334:    */
335:   async getUserStats() {
336:     const stats = await prisma.$queryRaw<
337:       Array<{
338:         totalUsers: bigint;
339:         activeUsers: bigint;
340:         proUsers: bigint;
341:         adminUsers: bigint;
342:         deletedUsers: bigint;
343:         verifiedUsers: bigint;
344:       }>
345:     >`
346:       SELECT
347:         COUNT(*)::bigint as "totalUsers",
348:         COUNT(*) FILTER (WHERE "isDeleted" = false)::bigint as "activeUsers",
349:         COUNT(*) FILTER (WHERE role = 'PRO_RESEARCHER' AND "isDeleted" = false)::bigint as "proUsers",
350:         COUNT(*) FILTER (WHERE role = 'ADMIN' AND "isDeleted" = false)::bigint as "adminUsers",
351:         COUNT(*) FILTER (WHERE "isDeleted" = true)::bigint as "deletedUsers",
352:         COUNT(*) FILTER (WHERE "emailVerified" = true AND "isDeleted" = false)::bigint as "verifiedUsers"
353:       FROM "User"
354:     `;
355:     return {
356:       totalUsers: Number(stats[0]?.totalUsers || 0),
357:       activeUsers: Number(stats[0]?.activeUsers || 0),
358:       proUsers: Number(stats[0]?.proUsers || 0),
359:       adminUsers: Number(stats[0]?.adminUsers || 0),
360:       deletedUsers: Number(stats[0]?.deletedUsers || 0),
361:       verifiedUsers: Number(stats[0]?.verifiedUsers || 0),
362:     };
363:   },
364:   /**
365:    * Update user role (admin only)
366:    */
367:   async updateUserRole(userId: string, newRole: string, adminId: string) {
368:     // Validate that the user exists and is not deleted
369:     const existingUser = await prisma.$queryRaw<
370:       Array<{ id: string; role: string; isDeleted: boolean }>
371:     >`
372:       SELECT id, role::text, "isDeleted"
373:       FROM "User"
374:       WHERE id = ${userId}
375:     `;
376:     if (!existingUser.length || existingUser[0].isDeleted) {
377:       throw new ApiError(httpStatus.NOT_FOUND, "User not found");
378:     }
379:     // Prevent self role change to avoid admin lockout
380:     if (userId === adminId) {
381:       throw new ApiError(httpStatus.FORBIDDEN, "Cannot change your own role");
382:     }
383:     // Update the role
384:     const updatedUser = await prisma.$executeRaw`
385:       UPDATE "User"
386:       SET
387:         role = ${newRole}::"Role",
388:         "updatedAt" = NOW()
389:       WHERE id = ${userId}
390:         AND "isDeleted" = false
391:     `;
392:     if (updatedUser === 0) {
393:       throw new ApiError(httpStatus.BAD_REQUEST, "Failed to update user role");
394:     }
395:     // Return updated user data
396:     const updated = await prisma.$queryRaw<
397:       Array<{
398:         id: string;
399:         name: string | null;
400:         email: string;
401:         role: string;
402:         updatedAt: Date;
403:       }>
404:     >`
405:       SELECT id, name, email, role::text, "updatedAt"
406:       FROM "User"
407:       WHERE id = ${userId}
408:     `;
409:     return {
410:       id: updated[0].id,
411:       name: updated[0].name,
412:       email: updated[0].email,
413:       role: updated[0].role,
414:       updatedAt: updated[0].updatedAt,
415:     };
416:   },
417:   /**
418:    * Soft delete user (deactivate)
419:    */
420:   async deactivateUser(userId: string, adminId: string) {
421:     // Validate that the user exists and is not already deleted
422:     const existingUser = await prisma.$queryRaw<
423:       Array<{ id: string; isDeleted: boolean }>
424:     >`
425:       SELECT id, "isDeleted"
426:       FROM "User"
427:       WHERE id = ${userId}
428:     `;
429:     if (!existingUser.length) {
430:       throw new ApiError(httpStatus.NOT_FOUND, "User not found");
431:     }
432:     if (existingUser[0].isDeleted) {
433:       throw new ApiError(httpStatus.BAD_REQUEST, "User is already deactivated");
434:     }
435:     // Prevent self-deletion to avoid admin lockout
436:     if (userId === adminId) {
437:       throw new ApiError(
438:         httpStatus.FORBIDDEN,
439:         "Cannot deactivate your own account"
440:       );
441:     }
442:     // Soft delete the user
443:     const deletedUser = await prisma.$executeRaw`
444:       UPDATE "User"
445:       SET
446:         "isDeleted" = true,
447:         "updatedAt" = NOW()
448:       WHERE id = ${userId}
449:         AND "isDeleted" = false
450:     `;
451:     if (deletedUser === 0) {
452:       throw new ApiError(httpStatus.BAD_REQUEST, "Failed to deactivate user");
453:     }
454:     return {
455:       message: "User deactivated successfully",
456:       userId,
457:     };
458:   },
459:   /**
460:    * Reactivate user (restore soft-deleted user)
461:    */
462:   async reactivateUser(userId: string) {
463:     // Validate that the user exists and is deleted
464:     const existingUser = await prisma.$queryRaw<
465:       Array<{ id: string; isDeleted: boolean }>
466:     >`
467:       SELECT id, "isDeleted"
468:       FROM "User"
469:       WHERE id = ${userId}
470:     `;
471:     if (!existingUser.length) {
472:       throw new ApiError(httpStatus.NOT_FOUND, "User not found");
473:     }
474:     if (!existingUser[0].isDeleted) {
475:       throw new ApiError(httpStatus.BAD_REQUEST, "User is already active");
476:     }
477:     // Reactivate the user
478:     const reactivatedUser = await prisma.$executeRaw`
479:       UPDATE "User"
480:       SET
481:         "isDeleted" = false,
482:         "updatedAt" = NOW()
483:       WHERE id = ${userId}
484:         AND "isDeleted" = true
485:     `;
486:     if (reactivatedUser === 0) {
487:       throw new ApiError(httpStatus.BAD_REQUEST, "Failed to reactivate user");
488:     }
489:     return {
490:       message: "User reactivated successfully",
491:       userId,
492:     };
493:   },
494:   /**
495:    * Permanently delete user (hard delete - use with caution)
496:    */
497:   async permanentlyDeleteUser(userId: string, adminId: string) {
498:     // Validate that the user exists
499:     const existingUser = await prisma.$queryRaw<Array<{ id: string }>>`
500:       SELECT id
501:       FROM "User"
502:       WHERE id = ${userId}
503:     `;
504:     if (!existingUser.length) {
505:       throw new ApiError(httpStatus.NOT_FOUND, "User not found");
506:     }
507:     // Prevent self-deletion
508:     if (userId === adminId) {
509:       throw new ApiError(
510:         httpStatus.FORBIDDEN,
511:         "Cannot permanently delete your own account"
512:       );
513:     }
514:     // Hard delete user - cascade will handle related records
515:     const deletedUser = await prisma.$executeRaw`
516:       DELETE FROM "User"
517:       WHERE id = ${userId}
518:     `;
519:     if (deletedUser === 0) {
520:       throw new ApiError(
521:         httpStatus.BAD_REQUEST,
522:         "Failed to permanently delete user"
523:       );
524:     }
525:     return {
526:       message: "User permanently deleted",
527:       userId,
528:     };
529:   },
530: };
