58:         {}
59:         {showCommentForm && (
60:           <CommentForm
61:             paperId={paperId}
62:             onSuccess={() => setShowCommentForm(false)}
63:             onCancel={() => setShowCommentForm(false)}
64:           />
65:         )}
66:         {}
67:         <ScrollArea className="h-96">
68:           <div className="space-y-4">
69:             {topLevelComments.length === 0 ? (
70:               <div className="text-center py-8 text-muted-foreground">
71:                 <MessageSquare className="h-8 w-8 mx-auto mb-2 opacity-50" />
72:                 <p className="text-sm">No comments yet</p>
