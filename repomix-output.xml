127:           success: true,
128:           message: "User profile retrieved successfully",
129:           data: { user },
130:         });
131:       } catch (error) {
132:         sendResponse(res, {
133:           statusCode: 401,
134:           success: false,
135:           message: AUTH_ERROR_MESSAGES.INVALID_TOKEN,
136:         });
137:       }
138:     }
139:   );
140: }
