 40:           if (!attributes.src) {
 41:             return {};
 42:           }
 43:           return {
 44:             src: attributes.src,
 45:           };
 46:         },
 47:       },
 48:       alt: {
 49:         default: null,
 50:         parseHTML: (element) => element.getAttribute("alt"),
 51:         renderHTML: (attributes) => {
 52:           if (!attributes.alt) {
 53:             return {};
 54:           }
 55:           return {
 56:             alt: attributes.alt,
