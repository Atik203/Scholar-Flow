<file path="apps/frontend/src/components/papers/PdfProcessingStatus.tsx">
  1: "use client";
  2: import { showErrorToast } from "@/components/providers/ToastProvider";
  3: import { Badge } from "@/components/ui/badge";
  4: import { Button } from "@/components/ui/button";
  5: import {
  6:   Card,
  7:   CardContent,
  8:   CardDescription,
  9:   CardHeader,
 10:   CardTitle,
 11: } from "@/components/ui/card";
 12: import { Progress } from "@/components/ui/progress";
 13: import {
 14:   useGetProcessingStatusQuery,
 15:   useProcessPDFDirectMutation,
 16:   useProcessPDFMutation,
 17: } from "@/redux/api/paperApi";
 18: import {
 19:   AlertCircle,
 20:   CheckCircle,
 21:   Clock,
 22:   FileText,
 23:   Loader2,
 24:   Play,
 25:   RefreshCw,
 26:   XCircle,
 27: } from "lucide-react";
 28: import { useEffect, useRef, useState } from "react";
 29: interface PdfProcessingStatusProps {
 30:   paperId: string;
 31:   currentStatus?: "UPLOADED" | "PROCESSING" | "PROCESSED" | "FAILED";
 32:   onStatusChange?: (status: string) => void;
 33:   showTriggerButton?: boolean;
 34:   compact?: boolean;
 35: }
 36: export function PdfProcessingStatus({
 37:   paperId,
 38:   currentStatus,
 39:   onStatusChange,
 40:   showTriggerButton = true,
 41:   compact = false,
 42: }: PdfProcessingStatusProps) {
 43:   const [isPolling, setIsPolling] = useState(false);
 44:   const pollingTimeoutRef = useRef<NodeJS.Timeout | null>(null);
 45:   const {
 46:     data: processingData,
 47:     isLoading,
 48:     error,
 49:     refetch,
 50:   } = useGetProcessingStatusQuery(paperId, {
 51:     pollingInterval: isPolling ? 2000 : 0,
 52:     skip: false,
 53:     refetchOnMountOrArgChange: true,
 54:   });
 55:   const [processPDF, { isLoading: isProcessing }] = useProcessPDFMutation();
 56:   const [processPDFDirect, { isLoading: isProcessingDirect }] =
 57:     useProcessPDFDirectMutation();
 58:   const status =
 59:     processingData?.data?.processingStatus || currentStatus || "UPLOADED";
 60:   const processingError = processingData?.data?.processingError;
 61:   const processedAt = processingData?.data?.processedAt;
 62:   const chunksCount = processingData?.data?.chunksCount || 0;
 63:   const chunks = processingData?.data?.chunks || [];
 64:   useEffect(() => {
 65:     const shouldPoll = status === "PROCESSING";
 66:     setIsPolling((prev) => (prev !== shouldPoll ? shouldPoll : prev));
 67:     if (shouldPoll) {
 68:       console.log("Starting polling for paper:", paperId);
 69:       if (!pollingTimeoutRef.current) {
 70:         pollingTimeoutRef.current = setTimeout(
 71:           () => {
 72:             console.warn(`Polling timeout reached for paper: ${paperId}`);
 73:             setIsPolling(false);
 74:             if (pollingTimeoutRef.current) {
 75:               clearTimeout(pollingTimeoutRef.current);
 76:               pollingTimeoutRef.current = null;
 77:             }
 78:           },
 79:           5 * 60 * 1000
 80:         );
 81:       }
 82:     } else {
 83:       console.log("Stopping polling for paper:", paperId, "Status:", status);
 84:       if (pollingTimeoutRef.current) {
 85:         clearTimeout(pollingTimeoutRef.current);
 86:         pollingTimeoutRef.current = null;
 87:       }
 88:     }
 89:     return () => {
 90:       if (!shouldPoll && pollingTimeoutRef.current) {
 91:         clearTimeout(pollingTimeoutRef.current);
 92:         pollingTimeoutRef.current = null;
 93:       }
 94:     };
 95:   }, [status, paperId]);
 96:   useEffect(() => {
 97:     onStatusChange?.(status);
 98:   }, [status, onStatusChange]);
 99:   const handleProcessPDF = async () => {
100:     try {
101:       console.log(
102:         `[PdfProcessingStatus] Starting PDF processing for paper: ${paperId}`
103:       );
104:       const result = await processPDF(paperId).unwrap();
105:       console.log("PDF processing started:", result);
106:       setIsPolling(true);
107:       refetch();
108:     } catch (error) {
109:       console.error("Failed to start PDF processing:", error);
110:       setIsPolling(false);
111:       let errorMessage = "Failed to start PDF processing";
112:       if (
113:         error &&
114:         typeof error === "object" &&
115:         "data" in error &&
116:         error.data &&
117:         typeof error.data === "object" &&
118:         "message" in error.data
119:       ) {
