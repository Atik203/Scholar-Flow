<file path="apps/frontend/src/lib/auth/signout.ts">
 1: import { clearAuthCookie } from "@/lib/auth/authCookies";
 2: import { apiSlice } from "@/redux/api/apiSlice";
 3: import { clearCredentials } from "@/redux/auth/authSlice";
 4: import { getAppStore, getPersistor } from "@/redux/storeAccess";
 5: const API_BASE_URL =
 6:   process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:5000/api";
 7: const BETTER_AUTH_COOKIES = [
 8:   "better-auth.session_token",
 9:   "__Secure-better-auth.session_token",
10:   "better-auth.csrf_token",
11:   "__Host-better-auth.csrf_token",
12:   "better-auth.session-data",
13:   "better-auth.callback_url",
14: ];
15: function clearBetterAuthCookies(): void {
16:   if (typeof document === "undefined") return;
17:   const hostname = window.location.hostname;
18:   const paths = ["/"];
19:   const expirations = [
20:     "Thu, 01 Jan 1970 00:00:00 GMT",
21:   ];
22:   for (const name of BETTER_AUTH_COOKIES) {
23:     for (const path of paths) {
24:       document.cookie = `${name}=; expires=${expirations[0]}; path=${path};`;
25:       document.cookie = `${name}=; expires=${expirations[0]}; path=${path}; secure;`;
26:       document.cookie = `${name}=; expires=${expirations[0]}; path=${path}; domain=${hostname};`;
27:     }
28:   }
29: }
30: async function purgePersistedState(): Promise<void> {
31:   const persistor = getPersistor();
32:   if (!persistor) return;
33:   await new Promise<void>((resolve) => {
34:     persistor.purge();
35:     setTimeout(resolve, 0);
36:   });
37: }
38: async function flushPersistedState(): Promise<void> {
39:   const persistor = getPersistor();
40:   if (!persistor) return;
41:   await persistor.flush();
42: }
43: async function invalidateBackendSession(): Promise<void> {
44:   const store = getAppStore();
45:   if (!store) return;
46:   const token = store.getState().auth.accessToken;
47:   if (!token) return;
48:   const controller = new AbortController();
49:   const timeoutId = setTimeout(() => controller.abort(), 2000);
50:   try {
51:     await fetch(`${API_BASE_URL}/auth/session/delete`, {
52:       method: "DELETE",
53:       headers: {
54:         "Content-Type": "application/json",
55:         Authorization: `Bearer ${token}`,
56:       },
57:       body: JSON.stringify({ token }),
58:       signal: controller.signal,
59:     });
60:   } catch {
61:   } finally {
62:     clearTimeout(timeoutId);
63:   }
64: }
65: export async function handleSignOut(redirectUrl: string = "/"): Promise<void> {
66:   const store = getAppStore();
67:   if (store) {
68:     store.dispatch(apiSlice.util.resetApiState());
69:   }
70:   await purgePersistedState();
71:   if (store) {
72:     store.dispatch(clearCredentials());
73:   }
74:   await flushPersistedState();
75:   clearAuthCookie();
76:   clearBetterAuthCookies();
77:   await invalidateBackendSession();
78:   if (typeof window !== "undefined") {
79:     window.location.href = redirectUrl;
80:   }
81: }
82: export async function handleSignOutWithLoading(
83:   setLoading: (loading: boolean) => void,
84:   redirectUrl: string = "/"
85: ): Promise<void> {
86:   setLoading(true);
87:   try {
88:     await handleSignOut(redirectUrl);
89:   } catch (error) {
90:     if (process.env.NODE_ENV !== "production") {
91:       console.error("Signout error:", error);
92:     }
93:     if (typeof window !== "undefined") {
94:       window.location.href = redirectUrl;
95:     }
96:   }
97: }
</file>

