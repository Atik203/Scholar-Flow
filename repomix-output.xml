221: function Breadcrumbs({ currentPath }: { currentPath?: string }) {
222:   if (!currentPath) return null;
223:   const segments = currentPath.split("/").filter(Boolean);
224:   const breadcrumbs = [];
225:   for (let i = 0; i < segments.length; i++) {
226:     const segment = segments[i];
227:     const href = "/" + segments.slice(0, i + 1).join("/");
228:     if (segment === "dashboard") continue;
229:     const label = segment
230:       .split("-")
231:       .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
232:       .join(" ");
233:     breadcrumbs.push({ label, href });
234:   }
235:   if (breadcrumbs.length === 0) {
236:     return <span className="font-medium">Dashboard</span>;
237:   }
238:   return (
239:     <nav className="flex items-center gap-2 text-sm">
240:       {breadcrumbs.map((crumb, index) => (
241:         <span key={crumb.href} className="flex items-center gap-2">
242:           {index > 0 && (
243:             <ChevronRight className="h-4 w-4 text-muted-foreground" />
