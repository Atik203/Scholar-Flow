19:   socialProviders: {
20:     google: {
21:       clientId: process.env.GOOGLE_CLIENT_ID || "",
22:       clientSecret: process.env.GOOGLE_CLIENT_SECRET || "",
23:       // Redirect to our backend OAuth handler
