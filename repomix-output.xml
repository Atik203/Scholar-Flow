  1: import ApiError from "../../errors/ApiError";
  2: import prisma from "../../shared/prisma";
  3: export class WorkspaceService {
  4:   static async listUserWorkspaces(
  5:     userId: string,
  6:     limit: number,
  7:     skip: number,
  8:     scope: "all" | "owned" | "shared" = "all"
  9:   ) {
 10:     const whereOwned = scope === "owned";
 11:     const whereShared = scope === "shared";
 12:     const rows = await prisma.$queryRaw<any[]>`
 13:       WITH filtered_workspaces AS (
 14:         SELECT w.*
 15:         FROM "Workspace" w
 16:         JOIN "WorkspaceMember" m ON m."workspaceId" = w.id AND m."isDeleted" = false
 17:         WHERE m."userId" = ${userId}
 18:           AND w."isDeleted" = false
 19:           AND (${whereOwned} = false OR w."ownerId" = ${userId})
 20:           AND (${whereShared} = false OR w."ownerId" != ${userId})
 21:       )
 22:       SELECT
 23:         fw.*,
 24:         (fw."ownerId" = ${userId})::boolean AS "isOwner",
 25:         COALESCE(member_counts.member_count, 0)::int AS "memberCount",
 26:         COALESCE(collection_counts.collection_count, 0)::int AS "collectionCount",
 27:         COALESCE(paper_counts.paper_count, 0)::int AS "paperCount"
 28:       FROM filtered_workspaces fw
 29:       LEFT JOIN (
 30:         SELECT "workspaceId", COUNT(*)::int AS member_count
 31:         FROM "WorkspaceMember"
 32:         WHERE "isDeleted" = false
 33:         GROUP BY "workspaceId"
 34:       ) member_counts ON member_counts."workspaceId" = fw.id
 35:       LEFT JOIN (
 36:         SELECT "workspaceId", COUNT(*)::int AS collection_count
 37:         FROM "Collection"
 38:         WHERE "isDeleted" = false
 39:         GROUP BY "workspaceId"
 40:       ) collection_counts ON collection_counts."workspaceId" = fw.id
 41:       LEFT JOIN (
 42:         SELECT "workspaceId", COUNT(*)::int AS paper_count
 43:         FROM "Paper"
 44:         WHERE "isDeleted" = false
 45:         GROUP BY "workspaceId"
 46:       ) paper_counts ON paper_counts."workspaceId" = fw.id
 47:       ORDER BY fw."createdAt" DESC
 48:       LIMIT ${limit} OFFSET ${skip}
 49:     `;
 50:     const totalRes = await prisma.$queryRaw<any[]>`
 51:       SELECT COUNT(*)::int as count
 52:       FROM "Workspace" w
 53:       JOIN "WorkspaceMember" m ON m."workspaceId" = w.id AND m."isDeleted" = false
 54:       WHERE m."userId" = ${userId}
 55:         AND w."isDeleted" = false
 56:         AND (${whereOwned} = false OR w."ownerId" = ${userId})
 57:         AND (${whereShared} = false OR w."ownerId" != ${userId})
 58:     `;
 59:     return {
 60:       result: rows,
 61:       meta: {
 62:         page: skip / limit + 1,
 63:         limit,
 64:         total: totalRes[0]?.count || 0,
 65:         totalPage: Math.ceil((totalRes[0]?.count || 0) / limit),
 66:       },
 67:     };
 68:   }
 69:   static async createWorkspace(ownerId: string, name: string) {
 70:     try {
 71:       const workspace = await prisma.$queryRaw<any[]>`
 72:         INSERT INTO "Workspace" (id, name, "ownerId", "createdAt", "updatedAt", "isDeleted")
 73:         VALUES (gen_random_uuid(), ${name}, ${ownerId}, now(), now(), false)
 74:         RETURNING *
 75:       `;
 76:       const w = workspace[0];
 77:       await prisma.$executeRaw`
 78:         INSERT INTO "WorkspaceMember" (id, "workspaceId", "userId", role, "joinedAt", "createdAt", "updatedAt", "isDeleted")
 79:         VALUES (gen_random_uuid(), ${w.id}, ${ownerId}, 'OWNER', now(), now(), now(), false)
 80:       `;
 81:       await prisma.$executeRaw`
 82:         INSERT INTO "ActivityLog" (id, "userId", "workspaceId", entity, "entityId", action, "createdAt", "updatedAt", "isDeleted")
 83:         VALUES (gen_random_uuid(), ${ownerId}, ${w.id}, 'Workspace', ${w.id}, 'CREATE', now(), now(), false)
 84:       `;
 85:       return w;
 86:     } catch (e) {
 87:       throw new ApiError(500, "Failed to create workspace");
 88:     }
 89:   }
 90:   static async getWorkspace(userId: string, id: string) {
 91:     const rows = await prisma.$queryRaw<any[]>`
 92:       SELECT
 93:         w.*,
 94:         (w."ownerId" = ${userId})::boolean AS "isOwner",
 95:         COALESCE(member_counts.member_count, 0)::int AS "memberCount",
 96:         COALESCE(collection_counts.collection_count, 0)::int AS "collectionCount",
 97:         COALESCE(paper_counts.paper_count, 0)::int AS "paperCount"
 98:       FROM "Workspace" w
 99:       JOIN "WorkspaceMember" m ON m."workspaceId" = w.id AND m."isDeleted" = false
100:       LEFT JOIN (
101:         SELECT "workspaceId", COUNT(*)::int AS member_count
102:         FROM "WorkspaceMember"
103:         WHERE "isDeleted" = false
104:         GROUP BY "workspaceId"
105:       ) member_counts ON member_counts."workspaceId" = w.id
106:       LEFT JOIN (
107:         SELECT "workspaceId", COUNT(*)::int AS collection_count
108:         FROM "Collection"
109:         WHERE "isDeleted" = false
110:         GROUP BY "workspaceId"
111:       ) collection_counts ON collection_counts."workspaceId" = w.id
112:       LEFT JOIN (
113:         SELECT "workspaceId", COUNT(*)::int AS paper_count
114:         FROM "Paper"
115:         WHERE "isDeleted" = false
116:         GROUP BY "workspaceId"
117:       ) paper_counts ON paper_counts."workspaceId" = w.id
118:       WHERE w.id = ${id} AND w."isDeleted" = false AND m."userId" = ${userId}
119:       LIMIT 1
120:     `;
121:     if (!rows[0])
122:       throw new ApiError(404, "Workspace not found or access denied");
123:     return rows[0];
