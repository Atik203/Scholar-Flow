  7: import { motion, AnimatePresence } from "motion/react";
  8: import {
  9:   Lightbulb,
 10:   RefreshCw,
 11:   Sparkles,
 12:   Copy,
 13:   Check,
 14:   Zap,
 15:   BeakerIcon,
 16:   BookOpen,
 17:   Brain,
 18: } from "lucide-react";
 19: import { useState, useCallback, useEffect } from "react";
 20: interface KeyPointsCardProps {
 21:   paperId: string;
 22: }
 23: const accentIcons = [Zap, Brain, BeakerIcon, BookOpen, Sparkles, Lightbulb];
 24: const accentColors = [
 25:   "from-amber-500/20 to-orange-500/10 border-amber-500/30 text-amber-700 dark:text-amber-300",
 26:   "from-violet-500/20 to-purple-500/10 border-violet-500/30 text-violet-700 dark:text-violet-300",
 27:   "from-emerald-500/20 to-teal-500/10 border-emerald-500/30 text-emerald-700 dark:text-emerald-300",
 28:   "from-sky-500/20 to-blue-500/10 border-sky-500/30 text-sky-700 dark:text-sky-300",
 29:   "from-rose-500/20 to-pink-500/10 border-rose-500/30 text-rose-700 dark:text-rose-300",
 30:   "from-cyan-500/20 to-indigo-500/10 border-cyan-500/30 text-cyan-700 dark:text-cyan-300",
 31: ];
 32: const accentIconColors = [
 33:   "text-amber-500",
 34:   "text-violet-500",
 35:   "text-emerald-500",
 36:   "text-sky-500",
 37:   "text-rose-500",
 38:   "text-cyan-500",
 39: ];
 40: const highlightTerms = (text: string) => {
 41:   const escaped = text
 42:     .replace(/&/g, "&amp;")
 43:     .replace(/</g, "&lt;")
 44:     .replace(/>/g, "&gt;")
 45:     .replace(/"/g, "&quot;")
 46:     .replace(/'/g, "&#39;");
 47:   const patterns = [
 48:     /\b(\d+(?:\.\d+)?%)\b/g,
 49:     /\b(BLEU|CER|WER|F1|ROUGE|BLEURT)\b/gi,
 50:     /\b(YOLO\w*|BERT|GPT|CNN|RNN|LSTM|Transformer|ResNet|U-Net|GAN|VAE)\b/gi,
 51:     /\b(state-of-the-art|novel|significant|achieves|outperforms|improves|reduces|increases)\b/gi,
 52:   ];
 53:   let result = escaped;
 54:   for (const pattern of patterns) {
 55:     result = result.replace(
 56:       pattern,
 57:       '<span class="font-semibold text-primary">$1</span>'
 58:     );
 59:   }
 60:   return result;
 61: };
 62: function CopyButton({ text }: { text: string }) {
 63:   const [copied, setCopied] = useState(false);
 64:   const handleCopy = useCallback(async () => {
 65:     await navigator.clipboard.writeText(text);
 66:     setCopied(true);
 67:     setTimeout(() => setCopied(false), 2000);
 68:   }, [text]);
 69:   return (
 70:     <Button
 71:       variant="ghost"
 72:       size="icon"
 73:       className="h-6 w-6 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
 74:       onClick={handleCopy}
 75:     >
 76:       {copied ? (
 77:         <Check className="h-3 w-3 text-emerald-500" />
 78:       ) : (
 79:         <Copy className="h-3 w-3" />
 80:       )}
 81:     </Button>
 82:   );
 83: }
 84: export function KeyPointsCard({ paperId }: KeyPointsCardProps) {
 85:   const [keyPoints, setKeyPoints] = useState<string[] | null>(null);
 86:   const [persisted, setPersisted] = useState(false);
 87:   const [extract, { isLoading }] = useExtractKeyPointsMutation();
 88:   const { data: providersData } = useGetAiProvidersQuery();
 89:   const defaultModel = providersData?.defaultModel;
 90:   useEffect(() => {
 91:     const loadKeyPoints = async () => {
 92:       try {
 93:         const result = await extract({
 94:           paperId,
 95:           refresh: false,
 96:         }).unwrap();
 97:         if (result.keyPoints && result.keyPoints.length > 0) {
 98:           setKeyPoints(result.keyPoints);
 99:           setPersisted(result.persisted || false);
100:         }
101:       } catch {
102:       }
103:     };
104:     loadKeyPoints();
105:   }, [paperId]);
106:   const handleExtract = async (regenerate = false) => {
107:     const result = await extract({
108:       paperId,
109:       model: defaultModel ?? undefined,
110:       refresh: regenerate || !persisted,
111:     }).unwrap();
112:     setKeyPoints(result.keyPoints);
113:     setPersisted(true);
114:   };
115:   const hasError =
116:     keyPoints &&
117:     keyPoints.length === 1 &&
118:     (keyPoints[0].startsWith("Could not") ||
119:       keyPoints[0].startsWith("No paper content") ||
120:       keyPoints[0].startsWith("AI features are"));
121:   return (
122:     <Card className="overflow-hidden border-primary/10">
123:       <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-3">
124:         <CardTitle className="text-base font-semibold flex items-center gap-2">
125:           <div className="flex items-center justify-center w-7 h-7 rounded-lg bg-primary/10">
126:             <Sparkles className="h-4 w-4 text-primary" />
127:           </div>
128:           <span className="bg-gradient-to-r from-primary to-primary/70 bg-clip-text text-transparent">
129:             AI Key Points
130:           </span>
131:         </CardTitle>
132:         <Button
133:           variant={keyPoints && keyPoints.length > 0 ? "outline" : "default"}
134:           size="sm"
135:           onClick={() => handleExtract(true)}
136:           disabled={isLoading}
137:           className="gap-1.5"
138:         >
139:           {isLoading ? (
140:             <RefreshCw className="h-3.5 w-3.5 animate-spin" />
141:           ) : (
142:             <Sparkles className="h-3.5 w-3.5" />
143:           )}
144:           {isLoading
145:             ? "Analyzing..."
146:             : keyPoints && keyPoints.length > 0
147:               ? "Regenerate"
148:               : "Extract Key Points"}
149:         </Button>
150:       </CardHeader>
151:       <CardContent>
152:         {isLoading ? (
153:           <div className="space-y-3 px-1">
154:             {Array.from({ length: 4 }).map((_, i) => (
155:               <div key={i} className="space-y-2">
156:                 <Skeleton className="h-3 w-1/3" />
157:                 <Skeleton className="h-4 w-full" />
158:                 <Skeleton className="h-4 w-5/6" />
159:               </div>
160:             ))}
161:           </div>
162:         ) : null}
163:         <AnimatePresence mode="wait">
164:           {keyPoints && !hasError && keyPoints.length > 0 ? (
165:             <motion.div
166:               key="results"
167:               initial={{ opacity: 0 }}
168:               animate={{ opacity: 1 }}
169:               className="space-y-3"
170:             >
171:               {keyPoints.map((point, i) => {
172:                 const AccentIcon = accentIcons[i % accentIcons.length];
173:                 return (
174:                   <motion.div
175:                     key={i}
176:                     initial={{ opacity: 0, y: 12 }}
177:                     animate={{ opacity: 1, y: 0 }}
178:                     transition={{ delay: i * 0.08, duration: 0.35 }}
179:                     className="group relative"
180:                   >
181:                     <div
182:                       className={`rounded-xl border bg-gradient-to-br ${accentColors[i % accentColors.length]} p-4 transition-shadow hover:shadow-md`}
183:                     >
184:                       <div className="flex items-start gap-3">
185:                         <div
186:                           className={`shrink-0 mt-0.5 ${accentIconColors[i % accentIconColors.length]}`}
187:                         >
188:                           <AccentIcon className="h-4 w-4" />
189:                         </div>
190:                         <div className="min-w-0 flex-1">
191:                           <p
192:                             className="text-sm leading-relaxed"
193:                             dangerouslySetInnerHTML={{
194:                               __html: highlightTerms(point),
195:                             }}
196:                           />
197:                         </div>
198:                         <CopyButton text={point} />
199:                       </div>
200:                     </div>
201:                   </motion.div>
202:                 );
203:               })}
204:             </motion.div>
205:           ) : null}
206:         </AnimatePresence>
207:         {hasError && (
208:           <motion.div
209:             initial={{ opacity: 0 }}
210:             animate={{ opacity: 1 }}
211:             className="rounded-xl border border-destructive/20 bg-destructive/5 p-6 text-center"
212:           >
213:             <p className="text-sm text-muted-foreground">{keyPoints[0]}</p>
214:             <Button
215:               variant="outline"
216:               size="sm"
217:               className="mt-3"
218:               onClick={() => handleExtract(true)}
219:             >
220:               <RefreshCw className="h-3.5 w-3.5 mr-1.5" />
221:               Try Again
222:             </Button>
223:           </motion.div>
224:         )}
225:         {!keyPoints && !isLoading && (
226:           <motion.div
227:             initial={{ opacity: 0 }}
228:             animate={{ opacity: 1 }}
229:             className="rounded-xl border border-dashed bg-muted/30 p-8 text-center"
230:           >
231:             <div className="flex justify-center mb-3">
232:               <div className="flex items-center justify-center w-12 h-12 rounded-full bg-primary/10">
233:                 <Brain className="h-6 w-6 text-primary" />
234:               </div>
235:             </div>
236:             <p className="text-sm text-muted-foreground mb-1">
237:               Extract key findings from this paper using AI
238:             </p>
239:             <p className="text-xs text-muted-foreground/60">
240:               Click the button above to identify claims, findings, and
241:               contributions
242:             </p>
243:           </motion.div>
244:         )}
245:       </CardContent>
246:     </Card>
247:   );
248: }
