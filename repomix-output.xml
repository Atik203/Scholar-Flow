384:   getCollectionsWithCounts: CollectionService.getCollectionsWithCounts,
385:   getUserCollections: CollectionService.getUserCollections,
386:   searchCollections: CollectionService.searchCollections,
387:   hasEditPermission: CollectionService.hasEditPermission,
388:   getUserPermission: CollectionService.getUserPermission,
389: };
