174: export const handleImageUpload = async (
175:   file: File,
176:   onProgress?: (event: { progress: number }) => void,
177:   abortSignal?: AbortSignal
178: ): Promise<string> => {
179:   if (!file) {
180:     throw new Error("No file provided");
181:   }
182:   if (file.size > MAX_FILE_SIZE) {
183:     throw new Error(
184:       `File size exceeds maximum allowed (${MAX_FILE_SIZE / (1024 * 1024)}MB)`
185:     );
186:   }
187:   const allowedTypes = ["image/jpeg", "image/png", "image/gif", "image/webp"];
188:   if (!allowedTypes.includes(file.type)) {
189:     throw new Error(
190:       "Invalid file type. Only JPEG, PNG, GIF, and WebP images are allowed."
191:     );
192:   }
193:   try {
194:     const store = getAppStore();
195:     if (!store) {
196:       throw new Error(
197:         "Redux store not initialized. This function can only be used in client components after authentication."
198:       );
199:     }
200:     const state = store.getState();
201:     const token = state?.auth?.accessToken;
202:     if (!token) {
203:       throw new Error(
204:         "Authentication required. Please sign in to upload images."
205:       );
206:     }
207:     const formData = new FormData();
208:     formData.append("image", file);
209:     return new Promise<string>((resolve, reject) => {
210:       const xhr = new XMLHttpRequest();
211:       if (onProgress) {
212:         xhr.upload.addEventListener("progress", (event) => {
213:           if (event.lengthComputable) {
214:             const progress = Math.round((event.loaded / event.total) * 100);
215:             onProgress({ progress });
216:           }
217:         });
218:       }
219:       if (abortSignal) {
220:         abortSignal.addEventListener("abort", () => {
221:           xhr.abort();
222:           reject(new Error("Upload cancelled"));
223:         });
224:       }
225:       xhr.onload = () => {
226:         if (xhr.status >= 200 && xhr.status < 300) {
227:           try {
228:             const response = JSON.parse(xhr.responseText);
229:             if (response.success && response.data?.url) {
230:               resolve(response.data.url);
231:             } else {
232:               console.error("Upload failed - response:", response);
233:               reject(
234:                 new Error(response.message || "Upload failed: No URL returned")
235:               );
236:             }
237:           } catch (error) {
238:             console.error("Response parsing error:", error);
239:             reject(new Error("Invalid response from server"));
240:           }
241:         } else {
242:           try {
243:             const errorResponse = JSON.parse(xhr.responseText);
244:             console.error("Upload failed with error response:", errorResponse);
245:             reject(
246:               new Error(
247:                 errorResponse.message ||
248:                   `Upload failed with status ${xhr.status}`
249:               )
250:             );
251:           } catch {
252:             console.error(
253:               "Upload failed with status and raw response:",
254:               xhr.status,
255:               xhr.responseText
256:             );
257:             reject(new Error(`Upload failed with status ${xhr.status}`));
258:           }
259:         }
260:       };
261:       xhr.onerror = () => {
262:         reject(new Error("Network error during upload"));
263:       };
264:       xhr.ontimeout = () => {
265:         reject(new Error("Upload timeout"));
266:       };
267:       const apiBaseUrl =
268:         getApiBaseUrl();
269:       xhr.open("POST", `${apiBaseUrl}/editor/upload-image`);
270:       xhr.setRequestHeader("Authorization", `Bearer ${token}`);
271:       xhr.timeout = 60000;
272:       xhr.send(formData);
273:     });
274:   } catch (error) {
275:     console.error("Upload error:", error);
276:     throw new Error(
277:       `Upload failed: ${error instanceof Error ? error.message : "Unknown error"}`
278:     );
279:   }
280: };
281: type ProtocolOptions = {
282:   scheme: string;
283:   optionalSlashes?: boolean;
284: };
285: type ProtocolConfig = Array<ProtocolOptions | string>;
286: const ATTR_WHITESPACE =
287:   /[\u0000-\u0020\u00A0\u1680\u180E\u2000-\u2029\u205F\u3000]/g;
288: export function isAllowedUri(
289:   uri: string | undefined,
290:   protocols?: ProtocolConfig
291: ) {
292:   const allowedProtocols: string[] = [
293:     "http",
294:     "https",
295:     "ftp",
296:     "ftps",
297:     "mailto",
298:     "tel",
299:     "callto",
300:     "sms",
301:     "cid",
302:     "xmpp",
303:   ];
304:   if (protocols) {
305:     protocols.forEach((protocol) => {
306:       const nextProtocol =
307:         typeof protocol === "string" ? protocol : protocol.scheme;
308:       if (nextProtocol) {
309:         allowedProtocols.push(nextProtocol);
310:       }
311:     });
312:   }
313:   return (
314:     !uri ||
315:     uri
316:       .replace(ATTR_WHITESPACE, "")
317:       .match(
318:         new RegExp(
319:           `^(?:(?:${allowedProtocols.join("|")}):|[^a-z]|[a-z0-9+.\-]+(?:[^a-z+.\-:]|$))`,
320:           "i"
321:         )
322:       )
323:   );
324: }
325: export function sanitizeUrl(
326:   inputUrl: string,
327:   baseUrl: string,
328:   protocols?: ProtocolConfig
329: ): string {
330:   try {
331:     const url = new URL(inputUrl, baseUrl);
332:     if (isAllowedUri(url.href, protocols)) {
333:       return url.href;
334:     }
335:   } catch {
336:   }
337:   return "#";
338: }
</file>

