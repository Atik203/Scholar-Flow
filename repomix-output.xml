<file path="apps/frontend/src/components/analytics/GoogleAnalytics.tsx">
 1: "use client";
 2: import Script from "next/script";
 3: interface GoogleAnalyticsProps {
 4:   measurementId: string;
 5: }
 6: export const GoogleAnalytics = ({ measurementId }: GoogleAnalyticsProps) => {
 7:   if (!measurementId) {
 8:     console.warn("Google Analytics measurement ID is not provided");
 9:     return null;
10:   }
11:   return (
12:     <>
13:       <Script
14:         strategy="lazyOnload"
15:         src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
16:       />
17:       <Script
18:         id="google-analytics"
19:         strategy="lazyOnload"
20:         dangerouslySetInnerHTML={{
21:           __html: `
22:             window.dataLayer = window.dataLayer || [];
23:             function gtag(){dataLayer.push(arguments);}
24:             gtag('js', new Date());
25:             gtag('config', '${measurementId}', {
26:               page_path: window.location.pathname,
27:             });
28:           `,
29:         }}
30:       />
31:     </>
32:   );
33: };
34: export const useGoogleAnalytics = () => {
35:   const sendEvent = (eventName: string, eventParams?: Record<string, any>) => {
36:     if (typeof window !== "undefined" && (window as any).gtag) {
37:       (window as any).gtag("event", eventName, eventParams);
38:     }
39:   };
40:   const sendPageView = (url: string) => {
41:     if (typeof window !== "undefined" && (window as any).gtag) {
42:       (window as any).gtag("config", process.env.NEXT_PUBLIC_GOOGLE_ANALYTICS, {
43:         page_path: url,
44:       });
45:     }
46:   };
47:   return { sendEvent, sendPageView };
