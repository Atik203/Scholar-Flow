824:         VALUES (gen_random_uuid(), ${workspaceId}, ${uploaderId}, ${title}, ${abstract || null}, ${JSON.stringify(metadata)}::jsonb, 'ieee', ${doi}, ARRAY[]::text[], null, 0, 'UPLOADED', NOW(), NOW(), false)
