318:   private extractCitationData(
319:     paper: any,
320:     options: CitationExportRequest
321:   ): CitationData {
322:     const metadata = (paper.metadata as any) || {};
323:     return {
324:       title: paper.title,
325:       authors: this.parseAuthors(
326:         metadata.authors || paper.uploader?.name || "Unknown Author"
327:       ),
328:       journal: metadata.journal || metadata.publication,
329:       year:
330:         metadata.year ||
331:         metadata.publicationYear ||
332:         new Date(paper.createdAt).getFullYear(),
333:       volume: metadata.volume,
334:       issue: metadata.issue,
335:       pages: metadata.pages,
336:       doi: paper.doi || metadata.doi,
337:       url: metadata.url || metadata.link,
338:       publisher: metadata.publisher,
339:       abstract: options.includeAbstract ? paper.abstract : undefined,
340:       keywords: options.includeKeywords ? metadata.keywords : undefined,
341:     };
