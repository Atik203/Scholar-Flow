1376:       userId
1377:     );
1378:     if (!hasEditPermission) {
1379:       throw new ApiError(
1380:         403,
1381:         "Access denied: You don't have edit permission for this collection"
1382:       );
1383:     }
1384:     // Check if paper is in collection
1385:     const collectionPaperRows = await prisma.$queryRaw<Array<{ id: string }>>`
1386:       SELECT id
1387:       FROM "CollectionPaper"
1388:       WHERE "collectionId" = ${collectionId}
1389:         AND "paperId" = ${paperId}
1390:         AND "isDeleted" = false
1391:       LIMIT 1
1392:     `;
1393:     const collectionPaper = collectionPaperRows[0];
1394:     if (!collectionPaper) {
1395:       throw new ApiError(404, "Paper not found in this collection");
1396:     }
1397:     // Soft delete the collection-paper relationship
1398:     await prisma.$executeRaw`
1399:       UPDATE "CollectionPaper"
1400:       SET "isDeleted" = true, "updatedAt" = NOW()
1401:       WHERE id = ${collectionPaper.id}
1402:     `;
1403:     sendSuccessResponse(
1404:       res,
1405:       null,
1406:       "Paper removed from collection successfully"
1407:     );
1408:   }),
1409:   // Get papers in a collection
1410:   getCollectionPapers: catchAsync(async (req: Request, res: Response) => {
1411:     const authReq = req as AuthenticatedRequest;
1412:     const { collectionId } = req.params;
1413:     const page = parseInt(req.query.page as string) || 1;
1414:     const limit = parseInt(req.query.limit as string) || 10;
1415:     const skip = (page - 1) * limit;
1416:     // Check if collection exists and user has access
1417:     const collectionRows = await prisma.$queryRaw<
1418:       Array<{
1419:         id: string;
1420:         isPublic: boolean;
1421:         ownerId: string;
1422:         hasMembership: boolean;
1423:       }>
1424:     >`
1425:       SELECT
1426:         c.id,
1427:         c."isPublic",
1428:         c."ownerId",
1429:         CASE
1430:           WHEN cm."userId" IS NOT NULL AND cm.status = 'ACCEPTED' THEN true
1431:           ELSE false
1432:         END AS "hasMembership"
1433:       FROM "Collection" c
1434:       LEFT JOIN "CollectionMember" cm
1435:         ON cm."collectionId" = c.id
1436:         AND cm."userId" = ${authReq.user?.id ?? null}
1437:         AND cm."isDeleted" = false
1438:         AND cm.status = 'ACCEPTED'
1439:       WHERE c.id = ${collectionId}
1440:         AND c."isDeleted" = false
1441:       LIMIT 1
1442:     `;
1443:     const collection = collectionRows[0];
1444:     if (!collection) {
1445:       throw new ApiError(404, "Collection not found");
1446:     }
1447:     // Check access permissions
1448:     const isOwner = authReq.user?.id === collection.ownerId;
1449:     const isPublic = collection.isPublic;
1450:     const hasMembership = collection.hasMembership;
1451:     if (!isOwner && !isPublic && !hasMembership) {
1452:       throw new ApiError(403, "Access denied");
1453:     }
1454:     // Get papers in collection
1455:     const paperRows = await prisma.$queryRaw<
1456:       Array<{
1457:         cp_id: string;
1458:         cp_collectionId: string;
1459:         cp_paperId: string;
1460:         cp_addedById: string;
1461:         cp_addedAt: Date;
1462:         cp_createdAt: Date;
1463:         cp_updatedAt: Date;
1464:         paper_id: string;
1465:         paper_workspaceId: string;
1466:         paper_uploaderId: string;
1467:         paper_title: string;
1468:         paper_abstract: string | null;
1469:         paper_metadata: unknown;
1470:         paper_source: string | null;
1471:         paper_doi: string | null;
1472:         paper_processingStatus: string;
1473:         paper_createdAt: Date;
1474:         paper_updatedAt: Date;
1475:         file_id: string | null;
1476:         file_storageProvider: string | null;
1477:         file_objectKey: string | null;
1478:         file_contentType: string | null;
1479:         file_sizeBytes: number | null;
1480:         file_originalFilename: string | null;
1481:         uploader_id: string;
1482:         uploader_name: string | null;
1483:         uploader_email: string | null;
1484:       }>
1485:     >`
1486:       SELECT
1487:         cp.id AS cp_id,
1488:         cp."collectionId" AS cp_collectionId,
1489:         cp."paperId" AS cp_paperId,
1490:         cp."addedById" AS cp_addedById,
1491:         cp."addedAt" AS cp_addedAt,
1492:         cp."createdAt" AS cp_createdAt,
1493:         cp."updatedAt" AS cp_updatedAt,
1494:         p.id AS paper_id,
1495:         p."workspaceId" AS paper_workspaceId,
1496:         p."uploaderId" AS paper_uploaderId,
1497:         p.title AS paper_title,
1498:         p.abstract AS paper_abstract,
1499:         p.metadata AS paper_metadata,
1500:         p.source AS paper_source,
1501:         p.doi AS paper_doi,
1502:         p."processingStatus" AS paper_processingStatus,
1503:         p."createdAt" AS paper_createdAt,
1504:         p."updatedAt" AS paper_updatedAt,
1505:         pf.id AS file_id,
1506:         pf."storageProvider" AS file_storageProvider,
1507:         pf."objectKey" AS file_objectKey,
1508:         pf."contentType" AS file_contentType,
1509:         pf."sizeBytes" AS file_sizeBytes,
1510:         pf."originalFilename" AS file_originalFilename,
1511:         u.id AS uploader_id,
1512:         u.name AS uploader_name,
1513:         u.email AS uploader_email
1514:       FROM "CollectionPaper" cp
1515:       JOIN "Paper" p ON p.id = cp."paperId"
1516:       LEFT JOIN "PaperFile" pf ON pf."paperId" = p.id AND pf."isDeleted" = false
1517:       JOIN "User" u ON u.id = p."uploaderId"
1518:       WHERE cp."collectionId" = ${collectionId}
1519:         AND cp."isDeleted" = false
1520:       ORDER BY cp."addedAt" DESC
1521:       LIMIT ${limit} OFFSET ${skip}
1522:     `;
1523:     const totalRes = await prisma.$queryRaw<Array<{ count: number }>>`
1524:       SELECT COUNT(*)::int as count
1525:       FROM "CollectionPaper" cp
1526:       WHERE cp."collectionId" = ${collectionId}
1527:         AND cp."isDeleted" = false
1528:     `;
1529:     const papers = paperRows.map((row) => ({
1530:       id: row.cp_id,
1531:       collectionId: row.cp_collectionId,
1532:       paperId: row.cp_paperId,
1533:       addedById: row.cp_addedById,
1534:       addedAt: row.cp_addedAt,
1535:       createdAt: row.cp_createdAt,
1536:       updatedAt: row.cp_updatedAt,
1537:       paper: {
1538:         id: row.paper_id,
1539:         workspaceId: row.paper_workspaceId,
1540:         uploaderId: row.paper_uploaderId,
1541:         title: row.paper_title,
1542:         abstract: row.paper_abstract,
1543:         metadata: row.paper_metadata,
1544:         source: row.paper_source,
1545:         doi: row.paper_doi,
1546:         processingStatus: row.paper_processingStatus,
1547:         createdAt: row.paper_createdAt,
1548:         updatedAt: row.paper_updatedAt,
1549:         file: row.file_id
1550:           ? {
1551:               id: row.file_id,
1552:               storageProvider: row.file_storageProvider,
1553:               objectKey: row.file_objectKey,
1554:               contentType: row.file_contentType,
1555:               sizeBytes: row.file_sizeBytes,
1556:               originalFilename: row.file_originalFilename,
1557:             }
1558:           : null,
1559:         uploader: {
1560:           id: row.uploader_id,
1561:           name: row.uploader_name,
1562:           email: row.uploader_email,
1563:         },
1564:       },
1565:     }));
1566:     const total = totalRes[0]?.count || 0;
1567:     const totalPage = Math.ceil(total / limit);
1568:     sendPaginatedResponse(
1569:       res,
1570:       papers,
1571:       { page, limit, total, totalPage },
1572:       "Collection papers retrieved successfully"
1573:     );
1574:   }),
1575:   // Phase 4: Update reading status or star a paper within a collection
1576:   updateCollectionPaper: catchAsync(async (req: Request, res: Response) => {
1577:     const authReq = req as AuthenticatedRequest;
1578:     if (!authReq.user?.id) {
1579:       throw new ApiError(401, "Authentication required");
1580:     }
1581:     const { collectionId, paperId } = req.params;
1582:     const { status, isStarred } = req.body;
1583:     const userId = authReq.user.id;
1584:     // Check if the CollectionPaper relationship exists and user has access
1585:     const cpRows = await prisma.$queryRaw<Array<{ id: string; addedById: string }>>`
1586:       SELECT cp.id, cp."addedById"
1587:       FROM "CollectionPaper" cp
1588:       WHERE cp."collectionId" = ${collectionId}
1589:         AND cp."paperId" = ${paperId}
1590:         AND cp."isDeleted" = false
1591:       LIMIT 1
1592:     `;
1593:     if (!cpRows.length) {
1594:       throw new ApiError(404, "Paper not found in this collection");
1595:     }
1596:     // Check permission: must be the owner of the collection or have EDIT permission
1597:     const hasPermission = await CollectionService.hasEditPermission(
1598:       collectionId,
1599:       userId
1600:     );
1601:     if (!hasPermission) {
1602:       throw new ApiError(
1603:         403,
1604:         "Access denied: You don't have edit permission for this collection"
1605:       );
1606:     }
1607:     // Build update dynamically based on provided fields
1608:     const setClauses: string[] = [];
1609:     setClauses.push(`"updatedAt" = NOW()`);
1610:     if (status !== undefined) {
1611:       setClauses.push(`status = ${status}::"CollectionPaperStatus"`);
1612:     }
1613:     if (isStarred !== undefined) {
1614:       setClauses.push(`"isStarred" = ${isStarred}`);
1615:     }
1616:     if (setClauses.length <= 1) {
1617:       throw new ApiError(400, "No fields to update");
1618:     }
1619:     const setSql = setClauses.join(", ");
1620:     await prisma.$executeRawUnsafe(`
1621:       UPDATE "CollectionPaper"
1622:       SET ${setSql}
1623:       WHERE id = ${cpRows[0].id}
1624:     `);
1625:     sendSuccessResponse(res, null, "Collection paper updated successfully");
1626:   }),
1627: };
</file>

