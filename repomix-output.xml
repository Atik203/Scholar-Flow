 434:   // Invite a user to workspace by email
 435:   static async inviteMember(
 436:     inviterId: string,
 437:     workspaceId: string,
 438:     payload: { email: string; role?: string }
 439:   ) {
 440:     // Only workspace owners and admins can invite members
 441:     const workspace = await prisma.$queryRaw<any[]>`
 442:       SELECT w.id, w.name, w."ownerId", m.role AS "inviterRole"
 443:       FROM "Workspace" w
 444:       LEFT JOIN "WorkspaceMember" m ON m."workspaceId" = w.id AND m."userId" = ${inviterId} AND m."isDeleted" = false
 445:       WHERE w.id = ${workspaceId} AND w."isDeleted" = false
 446:     `;
 447:     const ws = workspace[0];
 448:     if (!ws) throw new ApiError(404, "Workspace not found");
 449:     const isOwner = ws.ownerId === inviterId;
 450:     const isOwnerOrManager = ["OWNER", "MANAGER"].includes(ws.inviterRole);
 451:     if (!isOwner && !isOwnerOrManager) {
 452:       throw new ApiError(
 453:         403,
 454:         "Only workspace owners and managers can invite members"
 455:       );
 456:     }
 457:     // Only the actual owner may invite OWNER roles
 458:     const requestedRole = payload.role || "EDITOR";
 459:     if (requestedRole === "OWNER" && !isOwner) {
 460:       throw new ApiError(403, "Only the workspace owner can invite members as OWNER");
 461:     }
 462:     // Find user by email
 463:     const user = await prisma.$queryRaw<any[]>`
 464:       SELECT id, email, name FROM "User" WHERE email = ${payload.email} AND "isDeleted" = false
 465:     `;
 466:     if (!user[0]) {
 467:       throw new ApiError(404, "User with this email does not exist");
 468:     }
 469:     const targetUser = user[0];
 470:     // Prevent inviting self
 471:     if (targetUser.id === inviterId) {
 472:       throw new ApiError(400, "You cannot invite yourself");
 473:     }
 474:     // Check if user is already a member
 475:     const existingMember = await prisma.$queryRaw<any[]>`
 476:       SELECT id FROM "WorkspaceMember"
 477:       WHERE "workspaceId" = ${workspaceId} AND "userId" = ${targetUser.id} AND "isDeleted" = false
 478:     `;
 479:     if (existingMember[0]) {
 480:       throw new ApiError(400, "User is already a member of this workspace");
 481:     }
 482:     // Check if invitation already exists
 483:     const existingInvite = await prisma.$queryRaw<any[]>`
 484:       SELECT id, status FROM "WorkspaceInvitation"
 485:       WHERE "workspaceId" = ${workspaceId} AND "userId" = ${targetUser.id} AND "isDeleted" = false
 486:     `;
 487:     if (existingInvite[0]?.status === "PENDING") {
 488:       throw new ApiError(400, "User already has a pending invitation");
 489:     }
 490:     // Create or update invitation
 491:     const roleValue = payload.role || "EDITOR";
 492:     const expiresAt = new Date(Date.now() + INVITE_EXPIRY_MS);
 493:     const invitationResult = await prisma.$queryRaw<any[]>`
 494:       INSERT INTO "WorkspaceInvitation" (id, "workspaceId", "userId", role, "invitedById", status, "invitedAt", "expiresAt", "createdAt", "updatedAt", "isDeleted")
 495:       VALUES (gen_random_uuid(), ${workspaceId}, ${targetUser.id}, ${roleValue}::"WorkspaceRole", ${inviterId}, 'PENDING'::"MembershipStatus", now(), ${expiresAt}, now(), now(), false)
 496:       ON CONFLICT ("workspaceId", "userId") DO UPDATE SET
 497:         role = ${roleValue}::"WorkspaceRole",
 498:         "invitedById" = EXCLUDED."invitedById",
 499:         status = 'PENDING'::"MembershipStatus",
 500:         "invitedAt" = now(),
 501:         "expiresAt" = ${expiresAt},
 502:         "acceptedAt" = null,
 503:         "declinedAt" = null,
 504:         "isDeleted" = false,
 505:         "updatedAt" = now()
 506:       RETURNING id
 507:     `;
 508:     // Notify the invitee (best-effort)
 509:     try {
 510:       await notificationService.createNotification({
 511:         userId: targetUser.id,
 512:         type: "INVITE",
 513:         category: "WORKSPACE",
 514:         title: "Workspace invitation",
 515:         message: `${ws.name || "A workspace"} invitation — accept or decline from your dashboard.`,
 516:         actionUrl: "/dashboard/workspaces/shared",
 517:         actorId: inviterId,
 518:         resourceId: workspaceId,
 519:       });
 520:     } catch {
 521:       // notification failures never break the main flow
 522:     }
 523:     // Send invitation email (similar to collection pattern)
 524:     try {
 525:       const emailService = (await import("../../shared/emailService")).default;
 526:       await emailService.sendWorkspaceInvitationEmail({
 527:         email: targetUser.email,
 528:         name: targetUser.name || targetUser.email,
 529:         workspaceName: ws.name,
 530:         inviterName:
 531:           (
 532:             await prisma.$queryRaw<any[]>`
 533:           SELECT name, email FROM "User" WHERE id = ${inviterId}
 534:         `
 535:           )[0]?.name || "A ScholarFlow user",
 536:         workspaceId: workspaceId,
 537:       });
 538:     } catch (emailError) {
 539:       console.error("Failed to send workspace invitation email:", emailError);
 540:     }
 541:     return { invitationId: invitationResult[0]?.id };
 542:   }
 543:   // Accept workspace invitation
 544:   static async acceptInvitation(userId: string, workspaceId: string) {
 545:     const invitation = await prisma.$queryRaw<any[]>`
 546:       SELECT wi.id, wi.role, wi.status, wi."expiresAt", wi."invitedById"
 547:       FROM "WorkspaceInvitation" wi
 548:       WHERE wi."workspaceId" = ${workspaceId} AND wi."userId" = ${userId} AND wi."isDeleted" = false
 549:     `;
 550:     if (!invitation[0]) {
 551:       throw new ApiError(404, "Invitation not found");
 552:     }
 553:     if (invitation[0].status !== "PENDING") {
 554:       throw new ApiError(400, "Invitation is not pending");
 555:     }
 556:     if (
 557:       invitation[0].expiresAt &&
 558:       new Date(invitation[0].expiresAt).getTime() < Date.now()
 559:     ) {
 560:       await prisma.$executeRaw`
 561:         UPDATE "WorkspaceInvitation" SET status = 'EXPIRED', "updatedAt" = now()
 562:         WHERE id = ${invitation[0].id}
 563:       `;
 564:       throw new ApiError(400, "Invitation has expired");
 565:     }
 566:     try {
 567:       // Update invitation status and create membership in transaction
 568:       await prisma.$transaction(async (tx) => {
 569:         await tx.$executeRaw`
 570:           UPDATE "WorkspaceInvitation"
 571:           SET status = 'ACCEPTED'::"MembershipStatus", "acceptedAt" = now(), "updatedAt" = now()
 572:           WHERE id = ${invitation[0].id}
 573:         `;
 574:         await tx.$executeRaw`
 575:           INSERT INTO "WorkspaceMember" (id, "workspaceId", "userId", role, "joinedAt", "createdAt", "updatedAt", "isDeleted")
 576:           VALUES (gen_random_uuid(), ${workspaceId}, ${userId}, ${invitation[0].role}::"WorkspaceRole", now(), now(), now(), false)
 577:           ON CONFLICT ("workspaceId", "userId") DO UPDATE SET
 578:             role = ${invitation[0].role}::"WorkspaceRole",
 579:             "isDeleted" = false,
 580:             "joinedAt" = now(),
 581:             "updatedAt" = now()
 582:         `;
 583:         // Add activity log
 584:         await tx.activityLogEntry.create({
 585:           data: {
 586:             userId,
 587:             workspaceId,
 588:             entity: "Workspace",
 589:             entityId: workspaceId,
 590:             action: "JOIN",
 591:             severity: "INFO",
 592:           },
 593:         });
 594:       });
 595:       // Notify the inviter (best-effort)
 596:       if (invitation[0].invitedById) {
 597:         try {
 598:           await notificationService.createNotification({
 599:             userId: invitation[0].invitedById,
 600:             type: "INVITE",
 601:             category: "WORKSPACE",
 602:             title: "Invitation accepted",
 603:             message: "A user accepted your workspace invitation.",
 604:             actionUrl: `/dashboard/workspaces/${workspaceId}`,
 605:             actorId: userId,
 606:             resourceId: workspaceId,
 607:           });
 608:         } catch {
 609:           // notification failures never break the main flow
 610:         }
 611:       }
 612:       return { success: true };
 613:     } catch (error) {
 614:       throw new ApiError(500, "Failed to accept invitation");
 615:     }
 616:   }
 617:   // Decline workspace invitation
