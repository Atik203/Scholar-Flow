1518:         workspaceId: inserted.paper_workspaceId,
1519:         uploaderId: inserted.paper_uploaderId,
1520:         title: inserted.paper_title,
1521:         abstract: inserted.paper_abstract,
1522:         metadata: inserted.paper_metadata,
1523:         source: inserted.paper_source,
1524:         doi: inserted.paper_doi,
1525:         processingStatus: inserted.paper_processingStatus,
1526:         createdAt: inserted.paper_createdAt,
1527:         updatedAt: inserted.paper_updatedAt,
1528:         previewFileKey: inserted.paper_previewFileKey,
1529:         previewMimeType: inserted.paper_previewMimeType,
1530:         originalMimeType: inserted.paper_originalMimeType,
1531:         file: inserted.file_id
1532:           ? {
1533:               id: inserted.file_id,
1534:               storageProvider: inserted.file_storageProvider,
1535:               objectKey: inserted.file_objectKey,
1536:               contentType: inserted.file_contentType,
1537:               sizeBytes: inserted.file_sizeBytes,
1538:               originalFilename: inserted.file_originalFilename,
1539:               extractedAt: inserted.file_extractedAt,
1540:             }
1541:           : null,
1542:       },
1543:     };
1544:     sendSuccessResponse(
1545:       res,
1546:       responsePayload,
