<file path="apps/backend/src/app/middleware/requireTeamAccess.ts">
 1: import { NextFunction, Request, Response } from "express";
 2: import ApiError from "../errors/ApiError";
 3: import { AuthRequest } from "./auth";
 4: import { TeamService } from "../modules/Team/team.service";
 5: export const requireTeamAccess = async (
 6:   req: Request,
 7:   _res: Response,
 8:   next: NextFunction
 9: ): Promise<void> => {
10:   const authReq = req as AuthRequest;
11:   if (!authReq.user?.id) {
12:     return next(new ApiError(401, "Authentication required"));
13:   }
14:   try {
15:     const access = await TeamService.getAccessInfo(authReq.user.id);
16:     if (!access.hasAccess) {
17:       return next(
18:         new ApiError(
19:           403,
20:           "Team access requires a team lead role or an active workspace collaboration"
21:         )
22:       );
23:     }
24:     next();
25:   } catch (error) {
26:     next(error);
27:   }
28: };
</file>

