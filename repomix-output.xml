 43: import {
 44:   useExportPaperDocxMutation,
 45:   useExportPaperPdfMutation,
 46:   useGetEditorPaperQuery,
 47:   usePublishDraftMutation,
 48:   useUpdateEditorContentMutation,
 49: } from "@/redux/api/paperApi";
 50: import { ShareModal } from "./ShareModal";
 51: import {
 52:   showErrorToast,
 53:   showSuccessToast,
 54: } from "@/components/providers/ToastProvider";
 55: interface ScholarFlowEditorProps {
 56:   paperId: string;
 57:   onBack: () => void;
 58: }
 59: export function ScholarFlowEditor({ paperId, onBack }: ScholarFlowEditorProps) {
 60:   const [hasUnsavedChanges, setHasUnsavedChanges] = useState(false);
 61:   const [lastSaved, setLastSaved] = useState<Date | null>(null);
 62:   const [title, setTitle] = useState("");
 63:   const [isShareModalOpen, setIsShareModalOpen] = useState(false);
 64:   const isMobile = useIsMobile();
 65:   // Redux hooks
 66:   const {
 67:     data: paperResponse,
 68:     isLoading,
 69:     error,
 70:   } = useGetEditorPaperQuery(paperId);
 71:   const [updateContent, { isLoading: isSaving }] =
 72:     useUpdateEditorContentMutation();
 73:   const [exportPaperPdf, { isLoading: isExportingPdf }] =
 74:     useExportPaperPdfMutation();
 75:   const [exportPaperDocx, { isLoading: isExportingDocx }] =
 76:     useExportPaperDocxMutation();
 77:   const [publishDraft, { isLoading: isPublishing }] = usePublishDraftMutation();
 78:   const paper = paperResponse?.data;
 79:   const editor = useEditor({
 80:     immediatelyRender: false,
 81:     shouldRerenderOnTransaction: false,
 82:     editorProps: {
 83:       attributes: {
 84:         autocomplete: "off",
 85:         autocorrect: "off",
 86:         autocapitalize: "off",
 87:         "aria-label": "Paper content editor",
 88:         class:
 89:           "scholar-flow-editor prose prose-sm sm:prose lg:prose-lg xl:prose-xl focus:outline-none max-w-none",
 90:       },
 91:     },
 92:     extensions: [
 93:       StarterKit.configure({
 94:         horizontalRule: false,
 95:         link: {
 96:           openOnClick: false,
 97:           enableClickSelection: true,
 98:         },
 99:       }),
100:       HorizontalRule,
101:       TextAlign.configure({ types: ["heading", "paragraph"] }),
102:       TaskList,
103:       TaskItem.configure({ nested: true }),
104:       Highlight.configure({ multicolor: true }),
105:       ResizableImageWithPopover.configure({
106:         defaultWidth: 400,
107:         defaultHeight: 300,
108:         async onUpload(file: File) {
109:           try {
110:             const url = await handleImageUpload(file);
111:             return {
112:               src: url,
113:               "data-keep-ratio": true,
114:             };
115:           } catch (error) {
116:             console.error("Upload failed:", error);
117:             showErrorToast(
118:               "Image upload failed",
119:               error instanceof Error ? error.message : "Unknown error"
120:             );
121:             throw error;
122:           }
123:         },
124:       }),
125:       Typography,
126:       Superscript,
127:       Subscript,
128:     ],
129:     content: "",
130:     onUpdate: () => {
131:       setHasUnsavedChanges(true);
132:       // Trigger debounced auto-save
133:       if (debouncedAutoSaveTimeoutId) {
134:         clearTimeout(debouncedAutoSaveTimeoutId);
135:       }
136:       const timeoutId = setTimeout(() => {
137:         // Auto-save logic will be called here
138:         if (hasUnsavedChanges && !isSaving && editor) {
139:           handleAutoSave();
140:         }
141:       }, 2000);
142:       setDebouncedAutoSaveTimeoutId(timeoutId);
143:     },
144:   });
145:   // Auto-save function
146:   const handleAutoSave = useCallback(async () => {
147:     if (!editor || !hasUnsavedChanges || isSaving) return;
148:     try {
149:       const content = editor.getHTML();
150:       await updateContent({
151:         id: paperId,
152:         content,
153:         title,
154:         isDraft: true,
155:       }).unwrap();
156:       setHasUnsavedChanges(false);
157:       setLastSaved(new Date());
158:     } catch (error: any) {
159:       console.error("Auto-save failed:", error);
160:       showErrorToast("Auto-save failed", error?.data?.message);
161:     }
162:   }, [editor, paperId, hasUnsavedChanges, isSaving, updateContent, title]);
163:   const [debouncedAutoSaveTimeoutId, setDebouncedAutoSaveTimeoutId] =
164:     useState<NodeJS.Timeout | null>(null);
165:   const handleSave = useCallback(async () => {
166:     if (!editor) return;
167:     try {
168:       const content = editor.getHTML();
169:       await updateContent({
170:         id: paperId,
171:         content,
172:         title,
173:         isDraft: true,
174:       }).unwrap();
175:       setHasUnsavedChanges(false);
176:       setLastSaved(new Date());
177:       showSuccessToast("Paper saved successfully!");
178:     } catch (error: any) {
179:       console.error("Save failed:", error);
180:       showErrorToast("Failed to save paper", error?.data?.message);
181:     }
182:   }, [editor, paperId, title, updateContent]);
183:   const hasInitializedRef = useRef(false);
184:   const rafIdRef = useRef<number | null>(null);
185:   useEffect(() => {
186:     hasInitializedRef.current = false;
187:   }, [paperId]);
188:   useEffect(() => {
189:     if (!editor || !paper) return;
190:     setTitle(paper.title);
191:     if (hasInitializedRef.current) return;
192:     const html = paper.contentHtml || "";
193:     // Defer setContent to the next animation frame to avoid flushSync warnings
194:     rafIdRef.current = window.requestAnimationFrame(() => {
195:       if (editor.isDestroyed) return;
196:       // Avoid emitting update to prevent triggering onUpdate during initial load
197:       editor.commands.setContent(html, { emitUpdate: false });
198:       hasInitializedRef.current = true;
199:       // Optional: move cursor to end to avoid unexpected selection jumps
200:       try {
201:         const endPos = editor.state.doc.content.size;
202:         editor.commands.setTextSelection(endPos);
203:       } catch {
204:         // no-op
205:       }
206:       setHasUnsavedChanges(false);
207:     });
208:     // Cleanup any pending rAF on effect re-run or unmount
209:     return () => {
210:       if (rafIdRef.current !== null) {
211:         cancelAnimationFrame(rafIdRef.current);
212:         rafIdRef.current = null;
213:       }
214:     };
215:   }, [editor, paper]);
216:   // Add Ctrl+S keyboard shortcut for saving (like Microsoft Word)
217:   useEffect(() => {
218:     const handleKeyDown = (event: KeyboardEvent) => {
219:       // Check for Ctrl+S (Windows/Linux) or Cmd+S (Mac)
220:       if ((event.ctrlKey || event.metaKey) && event.key === "s") {
221:         event.preventDefault();
222:         handleSave();
223:       }
224:     };
225:     document.addEventListener("keydown", handleKeyDown);
226:     return () => {
227:       document.removeEventListener("keydown", handleKeyDown);
228:     };
229:   }, [handleSave]);
230:   const handlePublish = async () => {
231:     if (!paper) return;
232:     try {
233:       await publishDraft({
234:         id: paperId,
235:         title,
236:       }).unwrap();
237:       showSuccessToast("Paper published successfully!");
238:     } catch (error: any) {
239:       console.error("Publish failed:", error);
240:       showErrorToast("Failed to publish paper", error?.data?.message);
241:     }
242:   };
243:   const handleExportPdf = async () => {
244:     try {
245:       const response = await exportPaperPdf(paperId);
246:       if ("data" in response && response.data) {
247:         const blob = response.data;
248:         const url = window.URL.createObjectURL(blob);
249:         const a = document.createElement("a");
250:         a.href = url;
