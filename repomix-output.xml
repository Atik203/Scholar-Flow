236: export function DashboardRouter({
237:   initialPath = "/dashboard",
238:   userRole = "researcher",
239: }: DashboardRouterProps) {
240:   const [currentPath, setCurrentPath] = useState(initialPath);
241:   const [sidebarOpen, setSidebarOpen] = useState(true);
242:   const handleNavigate = (path: string) => {
243:     setCurrentPath(path);
244:   };
245:   const getPageComponent = () => {
246:     const RouteComponent = routes[currentPath];
247:     if (RouteComponent) {
248:       return <RouteComponent onNavigate={handleNavigate} />;
249:     }
250:     const parentPath =
251:       currentPath.split("/").slice(0, -1).join("/") || "/dashboard";
252:     const ParentComponent = routes[parentPath];
253:     if (ParentComponent && currentPath !== parentPath) {
254:       return <ParentComponent onNavigate={handleNavigate} />;
255:     }
256:     const placeholderTitle = additionalRoutes[currentPath];
257:     if (placeholderTitle) {
258:       return (
259:         <PlaceholderPage title={placeholderTitle} onNavigate={handleNavigate} />
260:       );
261:     }
262:     return <DashboardHome onNavigate={handleNavigate} />;
263:   };
264:   return (
265:     <div className="flex h-screen bg-gray-50 dark:bg-gray-900">
266:       {}
267:       <div
268:         className={`${
269:           sidebarOpen ? "w-64" : "w-0"
270:         } transition-all duration-300 overflow-hidden`}
271:       >
272:         <AppSidebar
273:           userRole={userRole}
274:           currentPath={currentPath}
275:           onNavigate={handleNavigate}
276:         />
277:       </div>
278:       {}
279:       <div className="flex-1 flex flex-col overflow-hidden">
280:         {}
281:         <AppHeader
282:           onMenuClick={() => setSidebarOpen(!sidebarOpen)}
283:           onSearch={(query) => {
284:             console.log("Search:", query);
285:             handleNavigate("/papers/search");
286:           }}
287:           notifications={[
288:             {
289:               id: "1",
290:               type: "info",
291:               title: "Paper processed",
292:               message: "Your paper has been processed successfully",
293:               createdAt: new Date(),
294:               read: false,
295:             },
296:           ]}
297:           onNotificationClick={(id) => console.log("Notification:", id)}
298:         />
299:         {}
300:         <main className="flex-1 overflow-auto">
301:           <AnimatePresence mode="wait">
302:             <motion.div
303:               key={currentPath}
304:               initial={{ opacity: 0, x: 20 }}
305:               animate={{ opacity: 1, x: 0 }}
306:               exit={{ opacity: 0, x: -20 }}
307:               transition={{ duration: 0.2 }}
308:             >
309:               {getPageComponent()}
310:             </motion.div>
311:           </AnimatePresence>
312:         </main>
313:       </div>
314:     </div>
315:   );
316: }
