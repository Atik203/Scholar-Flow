 29:   ): Promise<{ content: string; format: string; count: number }> {
 30:     const userId = req.user?.id;
 31:     if (!userId) {
 32:       throw new ApiError(401, "User not authenticated");
 33:     }
 34:     try {
 35:       let papers: any[] = [];
 36:       if (data.collectionId) {
 37:         const collection = await prisma.collection.findFirst({
 38:           where: {
 39:             id: data.collectionId,
 40:             isDeleted: false,
 41:             OR: [
 42:               { ownerId: userId },
 43:               {
 44:                 members: {
 45:                   some: {
 46:                     userId: userId,
 47:                     status: "ACCEPTED",
 48:                     isDeleted: false,
 49:                   },
 50:                 },
 51:               },
 52:             ],
 53:           },
 54:           select: {
 55:             papers: {
 56:               select: {
 57:                 paper: {
 58:                   select: {
 59:                     id: true,
 60:                     title: true,
 61:                     abstract: true,
 62:                     metadata: true,
 63:                     doi: true,
 64:                     createdAt: true,
 65:                     uploader: {
 66:                       select: { name: true },
 67:                     },
 68:                   },
 69:                 },
 70:               },
 71:             },
 72:           },
 73:         });
 74:         if (!collection) {
 75:           throw new ApiError(404, "Collection not found or access denied");
 76:         }
 77:         papers = collection.papers.map((cp: any) => cp.paper);
 78:       } else if (data.paperIds && data.paperIds.length > 0) {
 79:         papers = await prisma.paper.findMany({
 80:           where: {
 81:             id: { in: data.paperIds },
 82:             isDeleted: false,
 83:             OR: [
 84:               { uploaderId: userId },
 85:               {
 86:                 workspace: {
 87:                   members: {
 88:                     some: {
 89:                       userId: userId,
 90:                       isDeleted: false,
 91:                     },
 92:                   },
 93:                 },
 94:               },
 95:             ],
 96:           },
 97:           select: {
 98:             id: true,
 99:             title: true,
100:             abstract: true,
101:             metadata: true,
102:             doi: true,
103:             createdAt: true,
104:             uploader: {
105:               select: { name: true },
106:             },
107:           },
108:         });
109:         if (papers.length !== data.paperIds.length) {
110:           throw new ApiError(404, "Some papers not found or access denied");
111:         }
112:       } else {
113:         throw new ApiError(
114:           400,
115:           "Either paperIds or collectionId must be provided"
116:         );
117:       }
118:       if (papers.length === 0) {
119:         throw new ApiError(404, "No papers found to export");
120:       }
121:       const citations = papers.map((paper) =>
122:         this.extractCitationData(paper, data)
123:       );
124:       const content = this.formatCitations(citations, data.format);
125:       await prisma.citationExport.create({
126:         data: {
127:           userId,
128:           paperId: data.paperIds?.[0] || null,
129:           collectionId: data.collectionId || null,
130:           format: data.format,
131:           content,
132:           metadata: {
133:             paperCount: papers.length,
134:             includeAbstract: data.includeAbstract,
135:             includeKeywords: data.includeKeywords,
136:             exportedAt: new Date().toISOString(),
137:           },
138:         },
139:       });
140:       return {
141:         content,
142:         format: data.format,
143:         count: papers.length,
144:       };
145:     } catch (error) {
146:       console.error("[CitationExportService] Export failed:", error);
147:       console.error("[CitationExportService] Error details:", {
148:         message: error instanceof Error ? error.message : "Unknown error",
149:         stack: error instanceof Error ? error.stack : undefined,
150:         userId,
151:         dataProvided: {
152:           hasPaperIds: !!data.paperIds,
153:           paperIdsCount: data.paperIds?.length || 0,
154:           hasCollectionId: !!data.collectionId,
155:           format: data.format,
156:         },
157:       });
158:       if (error instanceof ApiError) throw error;
159:       throw new ApiError(
160:         500,
161:         `Failed to export citations: ${error instanceof Error ? error.message : "Unknown error"}`
162:       );
163:     }
164:   }
