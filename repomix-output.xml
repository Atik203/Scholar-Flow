171:                 value={searchQuery}
172:                 onChange={(e) => handleSearch(e.target.value)}
173:                 className="pl-10 w-64"
174:               />
175:             </div>
176:           )}
177:           {selectable && selectedRows.size > 0 && (
178:             <span className="text-sm text-muted-foreground">
179:               {selectedRows.size} row(s) selected
180:             </span>
181:           )}
182:         </div>
183:         <div className="flex items-center gap-2">
184:           {}
