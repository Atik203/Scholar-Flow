108:       document.addEventListener("keydown", handleEscape);
109:     }
110:     return () => {
111:       document.removeEventListener("mousedown", handleClickOutside);
112:       document.removeEventListener("keydown", handleEscape);
113:     };
114:   }, [open, onOpenChange]);
115:   const alignClasses = {
116:     start: "left-0",
117:     center: "left-1/2 -translate-x-1/2",
118:     end: "right-0",
119:   };
120:   const sideClasses = {
121:     top: "bottom-full mb-1",
122:     bottom: "top-full mt-1",
123:     left: "right-full mr-1",
124:     right: "left-full ml-1",
125:   };
126:   const animationVariants = {
127:     top: { initial: { y: 8 }, animate: { y: 0 } },
128:     bottom: { initial: { y: -8 }, animate: { y: 0 } },
129:     left: { initial: { x: 8 }, animate: { x: 0 } },
130:     right: { initial: { x: -8 }, animate: { x: 0 } },
131:   };
