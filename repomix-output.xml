 839:   readingLevel    String?  // "beginner" | "intermediate" | "advanced"
 840:   methodology     String?
 841:   researchQuestions String[]
 842:   contributions   String[] 
 843:   limitations     String[]
 844:   futureWork      String[]
 845:   model           String?
 846:   tokensUsed      Int?
 847:   paper           Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
 848:   createdAt       DateTime @default(now())
 849:   updatedAt       DateTime @updatedAt
 850:   isDeleted       Boolean  @default(false)
 851: 
 852:   @@unique([paperId])
 853: }
