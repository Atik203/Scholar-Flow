396:   /**
397:    * Get user statistics for dashboard cards
398:    */
399:   async getUserStats() {
400:     const stats = await prisma.$queryRaw<
401:       Array<{
402:         totalUsers: bigint;
403:         activeUsers: bigint;
404:         proUsers: bigint;
405:         adminUsers: bigint;
406:         deletedUsers: bigint;
407:         verifiedUsers: bigint;
408:       }>
409:     >`
410:       SELECT
411:         COUNT(*)::bigint as "totalUsers",
412:         COUNT(*) FILTER (WHERE "isDeleted" = false)::bigint as "activeUsers",
413:         (
414:           SELECT COUNT(DISTINCT s."userId")::bigint
415:           FROM "Subscription" s
416:           WHERE s."isDeleted" = false
417:             AND s.status IN ('ACTIVE', 'PAST_DUE')
418:         ) as "proUsers",
419:         COUNT(*) FILTER (WHERE role = 'ADMIN' AND "isDeleted" = false)::bigint as "adminUsers",
420:         COUNT(*) FILTER (WHERE "isDeleted" = true)::bigint as "deletedUsers",
421:         COUNT(*) FILTER (WHERE "emailVerified" = true AND "isDeleted" = false)::bigint as "verifiedUsers"
422:       FROM "User"
423:     `;
424:     return {
425:       totalUsers: Number(stats[0]?.totalUsers || 0),
426:       activeUsers: Number(stats[0]?.activeUsers || 0),
427:       proUsers: Number(stats[0]?.proUsers || 0),
428:       adminUsers: Number(stats[0]?.adminUsers || 0),
429:       deletedUsers: Number(stats[0]?.deletedUsers || 0),
430:       verifiedUsers: Number(stats[0]?.verifiedUsers || 0),
431:     };
432:   },
433:   /**
434:    * Update user role (admin only)
435:    */
436:   async updateUserRole(userId: string, newRole: string, adminId: string) {
437:     // Validate that the user exists and is not deleted
438:     const existingUser = await prisma.$queryRaw<
439:       Array<{ id: string; role: string; isDeleted: boolean }>
440:     >`
441:       SELECT id, role::text, "isDeleted"
442:       FROM "User"
443:       WHERE id = ${userId}
444:     `;
445:     if (!existingUser.length || existingUser[0].isDeleted) {
446:       throw new ApiError(httpStatus.NOT_FOUND, "User not found");
447:     }
448:     // Prevent self role change to avoid admin lockout
449:     if (userId === adminId) {
450:       throw new ApiError(httpStatus.FORBIDDEN, "Cannot change your own role");
451:     }
452:     // Update the role
453:     const updatedUser = await prisma.$executeRaw`
454:       UPDATE "User"
455:       SET
456:         role = ${newRole}::"Role",
457:         "updatedAt" = NOW()
458:       WHERE id = ${userId}
459:         AND "isDeleted" = false
460:     `;
461:     if (updatedUser === 0) {
462:       throw new ApiError(httpStatus.BAD_REQUEST, "Failed to update user role");
463:     }
464:     // Return updated user data
465:     const updated = await prisma.$queryRaw<
466:       Array<{
467:         id: string;
468:         name: string | null;
469:         email: string;
470:         role: string;
471:         updatedAt: Date;
472:       }>
473:     >`
474:       SELECT id, name, email, role::text, "updatedAt"
475:       FROM "User"
476:       WHERE id = ${userId}
477:     `;
478:     return {
479:       id: updated[0].id,
480:       name: updated[0].name,
481:       email: updated[0].email,
482:       role: updated[0].role,
483:       updatedAt: updated[0].updatedAt,
484:     };
