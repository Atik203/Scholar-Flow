401:                           >
402:                             Delete
403:                           </DropdownMenuItem>
404:                         </DropdownMenuContent>
405:                       </DropdownMenu>
406:                     );
407:                   })}
408:                 </div>
409:               );
410:             })}
411:           </div>
412:         )}
413:       </ScrollArea>
414:       <AlertDialog
415:         open={pendingDelete !== null}
416:         onOpenChange={(open) => {
417:           if (!open) setPendingDelete(null);
418:         }}
419:       >
420:         <AlertDialogContent>
421:           <AlertDialogHeader>
422:             <AlertDialogTitle>Delete annotation?</AlertDialogTitle>
423:             <AlertDialogDescription>
424:               This removes the annotation and its replies. This action cannot be
