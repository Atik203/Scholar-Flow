 1: import { Request, Response } from "express";
 2: import ApiError from "../../errors/ApiError";
 3: import { AuthenticatedRequest } from "../../interfaces/common";
 4: import catchAsync from "../../shared/catchAsync";
 5: import { sendPaginatedResponse, sendSuccessResponse } from "../../shared/sendResponse";
 6: import { auditLogService } from "./auditLog.service";
 7: import {
 8:   createAuditEntrySchema,
 9:   exportAuditLogQuerySchema,
10:   listAuditLogQuerySchema,
11: } from "./auditLog.validation";
12: export const auditLogController = {
13:   list: catchAsync(async (req: Request, res: Response) => {
14:     const authReq = req as AuthenticatedRequest;
15:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
16:     const q = listAuditLogQuerySchema.parse(req.query);
17:     const result = await auditLogService.listEntries({
18:       userId: q.userId,
19:       workspaceId: q.workspaceId,
20:       entity: q.entity,
21:       entityId: q.entityId,
22:       action: q.action,
23:       severity: q.severity,
24:       startDate: q.startDate,
25:       endDate: q.endDate,
26:       search: q.search,
27:       page: q.page ?? 1,
28:       limit: q.limit ?? 50,
29:     });
30:     sendPaginatedResponse(
31:       res,
32:       result.items,
33:       result.meta,
34:       "Audit log entries retrieved"
35:     );
36:   }),
37:   summary: catchAsync(async (req: Request, res: Response) => {
38:     const authReq = req as AuthenticatedRequest;
39:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
40:     const parseDate = (v: unknown): Date | undefined => {
41:       if (!v) return undefined;
42:       const d = new Date(String(v));
43:       return Number.isNaN(d.getTime()) ? undefined : d;
44:     };
45:     const startDate = parseDate(req.query.startDate);
46:     const endDate = parseDate(req.query.endDate);
47:     const summary = await auditLogService.getSummary({ startDate, endDate });
48:     sendSuccessResponse(res, summary, "Audit log summary retrieved");
49:   }),
50:   export: catchAsync(async (req: Request, res: Response) => {
51:     const authReq = req as AuthenticatedRequest;
52:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
53:     const q = exportAuditLogQuerySchema.parse(req.query);
54:     const result = await auditLogService.exportEntries({
55:       userId: q.userId,
56:       workspaceId: q.workspaceId,
57:       entity: q.entity,
58:       entityId: q.entityId,
59:       action: q.action,
60:       severity: q.severity,
61:       startDate: q.startDate,
62:       endDate: q.endDate,
63:       format: q.format,
64:       limit: q.limit ?? 1000,
65:     });
66:     res.setHeader("Content-Type", result.mimeType);
67:     res.setHeader(
68:       "Content-Disposition",
69:       `attachment; filename="${result.filename}"`
70:     );
71:     res.setHeader("Content-Length", String(result.content.length));
72:     res.status(200).send(result.content);
73:   }),
74:   create: catchAsync(async (req: Request, res: Response) => {
75:     const authReq = req as AuthenticatedRequest;
