357:   private static formatBibTeX(citations: CitationData[]): string {
358:     return citations
359:       .map((citation, index) => {
360:         const key = `paper${index + 1}`;
361:         const authors = citation.authors.join(" and ");
362:         let bibtex = `@article{${key},\n`;
363:         bibtex += `  title = {${citation.title}},\n`;
364:         bibtex += `  author = {${authors}},\n`;
365:         if (citation.journal) bibtex += `  journal = {${citation.journal}},\n`;
366:         if (citation.year) bibtex += `  year = {${citation.year}},\n`;
367:         if (citation.volume) bibtex += `  volume = {${citation.volume}},\n`;
368:         if (citation.issue) bibtex += `  number = {${citation.issue}},\n`;
369:         if (citation.pages) bibtex += `  pages = {${citation.pages}},\n`;
370:         if (citation.doi) bibtex += `  doi = {${citation.doi}},\n`;
371:         if (citation.url) bibtex += `  url = {${citation.url}},\n`;
372:         if (citation.publisher)
373:           bibtex += `  publisher = {${citation.publisher}},\n`;
374:         if (citation.abstract)
375:           bibtex += `  abstract = {${citation.abstract}},\n`;
376:         bibtex += "}";
377:         return bibtex;
378:       })
379:       .join("\n\n");
380:   }
381:   private static formatEndNote(citations: CitationData[]): string {
382:     return citations
383:       .map((citation) => {
384:         let endnote = `%0 Journal Article\n`;
385:         endnote += `%T ${citation.title}\n`;
386:         endnote += `%A ${citation.authors.join("\n%A ")}\n`;
387:         if (citation.journal) endnote += `%J ${citation.journal}\n`;
388:         if (citation.year) endnote += `%D ${citation.year}\n`;
389:         if (citation.volume) endnote += `%V ${citation.volume}\n`;
390:         if (citation.issue) endnote += `%N ${citation.issue}\n`;
391:         if (citation.pages) endnote += `%P ${citation.pages}\n`;
392:         if (citation.doi) endnote += `%R ${citation.doi}\n`;
393:         if (citation.url) endnote += `%U ${citation.url}\n`;
394:         if (citation.publisher) endnote += `%I ${citation.publisher}\n`;
395:         if (citation.abstract) endnote += `%X ${citation.abstract}\n`;
396:         return endnote;
397:       })
398:       .join("\n\n");
399:   }
400:   private static formatAPA(citations: CitationData[]): string {
