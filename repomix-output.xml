234:                 variant="outline"
235:                 size="sm"
236:                 onClick={() => setShowReply(true)}
237:                 className="gap-1.5"
238:               >
239:                 <Reply className="size-4" />
240:                 Reply
241:               </Button>
242:             )}
243:             <Button
244:               variant="outline"
245:               size="sm"
246:               onClick={() => onOpenChange(false)}
247:             >
248:               Cancel
249:             </Button>
250:             <Button
251:               size="sm"
252:               onClick={handleSave}
253:               disabled={!text.trim() && !color}
254:               className="gap-1.5"
255:             >
256:               <Save className="size-4" />
257:               Save
258:             </Button>
259:           </div>
260:         </div>
261:       </DialogContent>
262:     </Dialog>
263:     <AlertDialog open={confirmDeleteOpen} onOpenChange={setConfirmDeleteOpen}>
264:       <AlertDialogContent>
265:         <AlertDialogHeader>
266:           <AlertDialogTitle>Delete annotation?</AlertDialogTitle>
267:           <AlertDialogDescription>
268:             This removes the annotation and its replies. This action cannot be
269:             undone.
270:           </AlertDialogDescription>
271:         </AlertDialogHeader>
272:         <AlertDialogFooter>
273:           <AlertDialogCancel>Cancel</AlertDialogCancel>
274:           <AlertDialogAction
275:             className="bg-destructive text-destructive-foreground hover:bg-destructive/90"
276:             onClick={handleDelete}
277:           >
278:             Delete
279:           </AlertDialogAction>
280:         </AlertDialogFooter>
281:       </AlertDialogContent>
282:     </AlertDialog>
283:     </>
284:   );
285: }
</file>

