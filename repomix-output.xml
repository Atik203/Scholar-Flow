            WHERE pc."paperId" = p.id
          ) as "chunkCount"
        FROM "Paper" p
        LEFT JOIN "User" u ON p."uploaderId" = u.id
        WHERE p."isDeleted" = false
        ORDER BY p."createdAt" DESC
        LIMIT ${limit} OFFSET ${skip}
