486:   /**
487:    * Soft delete user (deactivate)
488:    */
489:   async deactivateUser(userId: string, adminId: string) {
490:     // Validate that the user exists and is not already deleted
491:     const existingUser = await prisma.$queryRaw<
492:       Array<{ id: string; isDeleted: boolean }>
493:     >`
494:       SELECT id, "isDeleted"
495:       FROM "User"
496:       WHERE id = ${userId}
497:     `;
498:     if (!existingUser.length) {
499:       throw new ApiError(httpStatus.NOT_FOUND, "User not found");
500:     }
501:     if (existingUser[0].isDeleted) {
502:       throw new ApiError(httpStatus.BAD_REQUEST, "User is already deactivated");
503:     }
504:     // Prevent self-deletion to avoid admin lockout
505:     if (userId === adminId) {
506:       throw new ApiError(
507:         httpStatus.FORBIDDEN,
508:         "Cannot deactivate your own account"
509:       );
510:     }
511:     // Soft delete the user
512:     const deletedUser = await prisma.$executeRaw`
513:       UPDATE "User"
514:       SET
515:         "isDeleted" = true,
516:         "updatedAt" = NOW()
517:       WHERE id = ${userId}
518:         AND "isDeleted" = false
519:     `;
520:     if (deletedUser === 0) {
521:       throw new ApiError(httpStatus.BAD_REQUEST, "Failed to deactivate user");
522:     }
523:     return {
524:       message: "User deactivated successfully",
525:       userId,
526:     };
