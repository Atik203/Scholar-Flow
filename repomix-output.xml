102: async function processStripeEvent(event: Stripe.Event): Promise<void> {
103:   switch (event.type) {
104:     case STRIPE_WEBHOOK_EVENTS.CHECKOUT_SESSION_COMPLETED:
105:       await handleCheckoutSessionCompleted(
106:         event.data.object as Stripe.Checkout.Session
107:       );
108:       break;
109:     case STRIPE_WEBHOOK_EVENTS.CUSTOMER_SUBSCRIPTION_CREATED:
110:     case STRIPE_WEBHOOK_EVENTS.CUSTOMER_SUBSCRIPTION_UPDATED:
111:       await handleSubscriptionUpdated(
