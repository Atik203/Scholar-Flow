 93:   const diffMs = now.getTime() - date.getTime();
 94:   const diffMins = Math.floor(diffMs / 60000);
 95:   const diffHours = Math.floor(diffMins / 60);
 96:   const diffDays = Math.floor(diffHours / 24);
 97:   let timeAgo: string;
 98:   if (diffMins < 1) timeAgo = "Just now";
 99:   else if (diffMins < 60) timeAgo = `${diffMins}m ago`;
100:   else if (diffHours < 24) timeAgo = `${diffHours}h ago`;
101:   else if (diffDays < 7) timeAgo = `${diffDays}d ago`;
102:   else timeAgo = date.toLocaleDateString();
