 4: }
 5: const STRIPE_WEBHOOK_PATHS = ["/webhooks/stripe", "/api/billing/webhook"];
 6: export const isStripeWebhookPath = (req: Request): boolean => {
 7:   const originalUrl = req.originalUrl || req.url;
 8:   return STRIPE_WEBHOOK_PATHS.some((path) => originalUrl.startsWith(path));
 9: };
10: export const captureStripeRawBody: RequestHandler = (req, _res, next) => {
