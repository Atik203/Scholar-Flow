381:                     </DialogHeader>
382:                     <form
383:                       onSubmit={handleCreateCollection}
384:                       className="space-y-4"
385:                     >
386:                       <div>
387:                         <Label htmlFor="collectionName">Collection Name</Label>
388:                         <Input
389:                           id="collectionName"
390:                           value={newCollectionName}
391:                           onChange={(e) => setNewCollectionName(e.target.value)}
392:                           placeholder="Enter collection name"
393:                           required
394:                         />
395:                       </div>
