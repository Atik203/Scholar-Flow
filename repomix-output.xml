  1: import { setCredentials } from "@/redux/auth/authSlice";
  2: import type { AppDispatch } from "@/redux/store";
  3: import { getPersistor } from "@/redux/storeAccess";
  4: import type { TUser } from "@/types/user";
  5: const API_BASE_URL =
  6:   process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:5000/api";
  7: interface AuthResponse {
  8:   success: boolean;
  9:   message?: string;
 10:   data?: {
 11:     user: TUser;
 12:     accessToken: string;
 13:   };
 14: }
 15: export async function signInWithCredentials(
 16:   email: string,
 17:   password: string,
 18:   dispatch: AppDispatch
 19: ): Promise<{ success: boolean; error?: string }> {
 20:   try {
 21:     const response = await fetch(`${API_BASE_URL}/auth/signin`, {
 22:       method: "POST",
 23:       headers: { "Content-Type": "application/json" },
 24:       body: JSON.stringify({ email, password }),
 25:     });
 26:     const data: AuthResponse = await response.json();
 27:     if (!response.ok || !data.success) {
 28:       return {
 29:         success: false,
 30:         error: data.message || "Invalid email or password",
 31:       };
 32:     }
 33:     if (!data.data?.user || !data.data?.accessToken) {
 34:       return {
 35:         success: false,
 36:         error: "Authentication response was incomplete",
 37:       };
 38:     }
 39:     dispatch(
 40:       setCredentials({
 41:         user: data.data.user,
 42:         accessToken: data.data.accessToken,
 43:       })
 44:     );
 45:     await flushAuthState();
 46:     return { success: true };
 47:   } catch (error) {
 48:     console.error("Sign-in error:", error);
 49:     return {
 50:       success: false,
 51:       error: "An unexpected error occurred. Please try again.",
 52:     };
 53:   }
 54: }
 55: export function signInWithOAuth(
 56:   provider: "google" | "github",
 57:   callbackUrl?: string
 58: ): void {
 59:   const callback =
 60:     callbackUrl || window.location.origin + "/auth/callback/" + provider;
 61:   const oauthUrl = `${API_BASE_URL}/auth/oauth/${provider}?callbackUrl=${encodeURIComponent(callback)}`;
 62:   window.location.href = oauthUrl;
 63: }
 64: export async function completeOAuthSignIn(
 65:   provider: "google" | "github",
 66:   code: string,
 67:   dispatch: AppDispatch
 68: ): Promise<{ success: boolean; error?: string; user?: TUser }> {
 69:   try {
 70:     console.log(`🔐 Completing ${provider} OAuth with code...`);
 71:     const response = await fetch(
 72:       `${API_BASE_URL}/auth/oauth/${provider}/callback`,
 73:       {
 74:         method: "POST",
 75:         headers: { "Content-Type": "application/json" },
 76:         body: JSON.stringify({ code }),
 77:       }
 78:     );
 79:     const data: AuthResponse = await response.json();
 80:     console.log(`📥 ${provider} OAuth response:`, {
 81:       success: data.success,
 82:       hasUser: !!data.data?.user,
 83:       hasToken: !!data.data?.accessToken,
 84:     });
 85:     if (!response.ok || !data.success) {
 86:       console.error(`❌ ${provider} OAuth failed:`, data.message);
 87:       return {
 88:         success: false,
 89:         error: data.message || `${provider} authentication failed`,
 90:       };
 91:     }
 92:     if (!data.data?.user || !data.data?.accessToken) {
 93:       console.error(`❌ ${provider} OAuth incomplete response:`, data);
 94:       return {
 95:         success: false,
 96:         error: "Authentication response was incomplete",
 97:       };
 98:     }
 99:     console.log(`✅ Storing ${provider} OAuth credentials in Redux`);
100:     dispatch(
101:       setCredentials({
102:         user: data.data.user,
103:         accessToken: data.data.accessToken,
104:       })
105:     );
106:     await flushAuthState();
107:     return { success: true, user: data.data.user };
108:   } catch (error) {
109:     console.error(`${provider} OAuth error:`, error);
110:     return {
111:       success: false,
112:       error: "An unexpected error occurred during authentication",
113:     };
114:   }
115: }
116: async function flushAuthState(): Promise<void> {
117:   const persistor = getPersistor();
118:   if (!persistor) return;
119:   try {
120:     await persistor.flush();
121:   } catch (error) {
122:     if (process.env.NODE_ENV !== "production") {
123:       console.error("[authHelpers] persistor.flush failed:", error);
124:     }
125:   }
126: }
