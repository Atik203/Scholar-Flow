22: router.put("/:id/read", authMiddleware as any, NotificationController.markAsRead as any);
23: router.put("/:id/star", authMiddleware as any, NotificationController.toggleStarred as any);
24: router.delete("/bulk", authMiddleware as any, NotificationController.deleteBulk as any);
