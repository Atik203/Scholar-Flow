 61:       fontSize: stored.fontSize ?? local.fontSize,
 62:       spellCheck: stored.spellCheck ?? local.spellCheck,
 63:     });
 64:     setHydrated(true);
 65:   }, [data, isLoading, hydrated]);
 66:   const handleSave = async () => {
 67:     try {
 68:       await updatePreferences({
 69:         metadata: {
 70:           ...(data?.data?.metadata ?? {}),
 71:           editorSettings: settings,
 72:         },
 73:       }).unwrap();
 74:       writeEditorSettings(settings);
 75:       showSuccessToast("Editor settings saved");
 76:     } catch (error: any) {
 77:       showErrorToast(
