483:   async generateSummary(request: AiSummaryRequest): Promise<AiSummaryResult> {
484:     const normalizedInput = normalizeSummaryInput(request);
485:     if (!normalizedInput.text) {
486:       return {
487:         provider: "heuristic",
488:         summary:
489:           "We don't have extracted text for this paper yet. Please process the document or upload the full content to generate a summary.",
490:         highlights: undefined,
491:         followUpQuestions: [
492:           "Can you run the document processing step to extract text?",
493:           "Is there a specific section of the paper you'd like summarised once text is available?",
494:         ],
495:         rawResponse: { heuristic: true, reason: "NO_TEXT_AVAILABLE" },
496:       };
497:     }
498:     const heuristicResult = runSummaryHeuristics(normalizedInput);
499:     if (!config.ai.featuresEnabled) {
500:       return heuristicResult;
501:     }
502:     const cacheKey = normalizedInput.instructions || "default";
503:     const cacheParams = buildSummaryCacheParams(normalizedInput);
504:     const cached = await aiSummaryCache.get(
505:       normalizedInput.paperId,
506:       cacheKey,
507:       cacheParams
508:     );
509:     if (cached) {
510:       return {
511:         ...cached,
512:         cached: true,
513:       };
514:     }
515:     const providerInstances = getProviderInstances();
516:     const errors: string[] = [];
517:     for (const provider of providerInstances) {
518:       if (!provider.isEnabled()) {
519:         continue;
520:       }
521:       const startTime = Date.now();
522:       try {
523:         const result = await provider.generateSummary(normalizedInput);
524:         if (result && result.summary) {
525:           const normalizedSummary = limitTextToWords(
526:             result.summary,
527:             normalizedInput.wordLimit ?? DEFAULT_SUMMARY_WORD_LIMIT
528:           );
529:           const normalizedHighlights = result.highlights
530:             ?.map((highlight) => truncateSentence(highlight, 220))
531:             .filter((highlight) => Boolean(highlight));
532:           const normalizedFollowUps = result.followUpQuestions
533:             ?.map((question) => truncateSentence(question, 180))
534:             .filter((question) => Boolean(question));
535:           const payload: AiSummaryResult = {
536:             provider: result.provider,
537:             summary: normalizedSummary,
538:             highlights:
539:               normalizedHighlights && normalizedHighlights.length
540:                 ? normalizedHighlights
541:                 : undefined,
542:             followUpQuestions:
543:               normalizedFollowUps && normalizedFollowUps.length
544:                 ? normalizedFollowUps
545:                 : undefined,
546:             rawResponse: result.rawResponse,
547:             tokensUsed: result.tokensUsed,
548:           };
549:           await aiSummaryCache.set(
550:             normalizedInput.paperId,
551:             cacheKey,
552:             {
553:               provider: payload.provider,
554:               summary: payload.summary,
555:               highlights: payload.highlights,
556:               followUpQuestions: payload.followUpQuestions,
557:               tokensUsed: payload.tokensUsed,
558:             },
559:             cacheParams
560:           );
561:           const durationMs = Date.now() - startTime;
562:           return {
563:             ...payload,
564:             cached: false,
565:             rawResponse: {
566:               provider: result.provider,
567:               durationMs,
568:               data: payload.rawResponse,
569:               tokensUsed: payload.tokensUsed,
570:             },
571:           };
572:         }
573:       } catch (error) {
574:         const message =
575:           error instanceof Error
576:             ? error.message
577:             : String(error ?? "Unknown error");
578:         errors.push(`${provider.name}: ${message}`);
579:       }
580:     }
581:     return {
582:       ...heuristicResult,
583:       rawResponse: {
584:         data: heuristicResult.rawResponse,
585:         errors,
586:       },
587:     };
588:   },
589:   async generateInsight(request: AiInsightRequest): Promise<AiInsightResult> {
590:     const sanitizedHistory = sanitizeInsightHistory(request.history);
591:     const normalizedRequest: AiInsightRequest = {
592:       ...request,
593:       prompt: request.prompt.trim(),
594:       context: request.context || "",
595:       history: sanitizedHistory,
596:     };
597:     const hasContext = normalizedRequest.context.trim().length > 0;
598:     const hasHistory = sanitizedHistory.length > 0;
599:     if (!hasContext && !hasHistory) {
600:       return runInsightHeuristics(normalizedRequest);
601:     }
602:     if (!config.ai.featuresEnabled) {
603:       return runInsightHeuristics(normalizedRequest);
604:     }
605:     const providerInstances = getProviderInstances();
606:     const errors: string[] = [];
607:     for (const provider of providerInstances) {
608:       if (
609:         !provider.isEnabled() ||
610:         typeof provider.generateInsights !== "function"
611:       ) {
612:         continue;
613:       }
614:       try {
615:         const result = await provider.generateInsights(normalizedRequest);
616:         if (result) {
617:           return result;
618:         }
619:       } catch (error) {
620:         const errorMsg =
621:           error instanceof Error ? error.message : String(error ?? "Unknown");
622:         errors.push(errorMsg);
623:       }
624:     }
625:     const fallback = runInsightHeuristics(normalizedRequest);
626:     return {
627:       ...fallback,
628:       rawResponse: { errors },
629:     };
630:   },
631:   async invalidateSummaryCache(paperId: string) {
632:     await aiSummaryCache.invalidate(paperId);
633:   },
634:   // Phase 10 — AI Key Points extraction
635:   async generateKeyPoints(request: AiInsightRequest): Promise<string[]> {
636:     const sanitizedHistory = sanitizeInsightHistory(request.history);
637:     const normalizedRequest: AiInsightRequest = {
638:       ...request,
639:       prompt: `Identify 5-10 key claims, findings, or contributions from this paper. Return a JSON array of strings where each string is a self-contained, well-punctuated sentence describing one key point. Format: ["Point one.", "Point two.", "Point three."]. Do NOT wrap in an object, do NOT use keys like "keyClaims" or "findings" — return ONLY the array.`,
640:       context: request.context || "",
641:       history: sanitizedHistory,
642:     };
643:     const hasContext = normalizedRequest.context.trim().length > 0;
644:     if (!hasContext) {
645:       return ["No paper content available for key points extraction. Please ensure the paper has been processed."];
646:     }
647:     if (!config.ai.featuresEnabled) {
648:       return ["AI features are currently disabled. Enable them in settings to extract key points."];
649:     }
650:     const providerInstances = getProviderInstances();
651:     const errors: string[] = [];
652:     for (const provider of providerInstances) {
653:       if (
654:         !provider.isEnabled() ||
655:         typeof provider.generateInsights !== "function"
656:       ) {
657:         continue;
658:       }
659:       try {
660:         const result = await provider.generateInsights(normalizedRequest);
661:         if (result?.message?.content) {
662:           const content = String(result.message.content);
663:           const points = extractKeyPointsFromContent(content);
664:           if (points.length > 0) return points;
665:         }
666:       } catch (error) {
667:         const errorMsg =
668:           error instanceof Error ? error.message : String(error ?? "Unknown");
669:         errors.push(errorMsg);
670:       }
671:     }
672:     if (errors.length > 0) {
673:       console.error("[AI] Key points extraction errors:", errors.join("; "));
674:     }
675:     return ["Could not extract key points. Try again or ensure AI features are configured."];
676:   },
677: };
678: const shouldReplaceValue = (currentValue?: string | null) => {
679:   if (!currentValue) {
680:     return true;
681:   }
682:   const normalized = currentValue.trim().toLowerCase();
683:   return ["untitled", "unknown", ""].includes(normalized);
684: };
685: /**
686:  * Parse AI response content into an array of key point strings.
687:  * Handles multiple response formats:
688:  * - Bare JSON array: ["point1", "point2"]
689:  * - Object with array values: {"keyClaims": [...], "findings": [...]}
690:  * - Object wrapped as string: '{"keyClaims": [...]}'
691:  * - Plain text with newlines/bullets
692:  */
693: function extractKeyPointsFromContent(content: string): string[] {
694:   try {
695:     const parsed = JSON.parse(content);
696:     if (Array.isArray(parsed)) {
697:       return parsed.slice(0, 10).map((item) =>
698:         typeof item === "string" ? item : JSON.stringify(item)
699:       );
700:     }
701:     if (parsed && typeof parsed === "object") {
702:       const arrayKeys = [
703:         "keyClaims", "claims", "findings", "points",
704:         "keyPoints", "key_points", "keyFindings", "key_findings",
705:         "results", "contributions", "answer",
706:       ];
707:       for (const key of arrayKeys) {
708:         if (Array.isArray(parsed[key])) {
709:           return parsed[key].slice(0, 10).map((item: unknown) =>
710:             typeof item === "string" ? item : JSON.stringify(item)
711:           );
712:         }
713:       }
714:       for (const value of Object.values(parsed)) {
715:         if (Array.isArray(value)) {
716:           return value.slice(0, 10).map((item: unknown) =>
717:             typeof item === "string" ? item : JSON.stringify(item)
718:           );
719:         }
720:       }
721:     }
722:   } catch {
723:   }
724:   const lines = content
725:     .replace(/^[\[\]{}"'\s]+|[\[\]{}"'\s]+$/g, "")
726:     .split(/\n|•|-|\d+\.\s*|\d+\)\s*/)
727:     .map((s) => s.replace(/^[\s"'[\],]+|[\s"'[\],]+$/g, "").trim())
728:     .filter((s) => s.length > 15)
729:     .slice(0, 10);
730:   return lines;
731: }
</file>

