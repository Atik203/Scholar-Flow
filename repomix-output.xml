  1: import { Request, Response } from "express";
  2: import jwt from "jsonwebtoken";
  3: import catchAsync from "../../shared/catchAsync";
  4: import sendResponse from "../../shared/sendResponse";
  5: import { AsyncRequestHandler } from "../../types/express";
  6: import { AUTH_ERROR_MESSAGES, AUTH_SUCCESS_MESSAGES } from "./auth.constant";
  7: import {
  8:   IOAuthSignInRequest,
  9:   ISessionValidationRequest,
 10:   IValidationRequest,
 11: } from "./auth.interface";
 12: import { authService } from "./auth.service";
 13: class AuthController {
 14:   oauthSignin: AsyncRequestHandler = catchAsync(
 15:     async (req: Request, res: Response) => {
 16:       const { profile, account } = req.body as IOAuthSignInRequest;
 17:       const user = await authService.handleOAuthSignIn(profile, account);
 18:       sendResponse(res, {
 19:         statusCode: 201,
 20:         success: true,
 21:         message: AUTH_SUCCESS_MESSAGES.OAUTH_SUCCESS,
 22:         data: {
 23:           user: {
 24:             id: user.id,
 25:             email: user.email,
 26:             name: user.name,
 27:             image: user.image,
 28:             role: user.role,
 29:           },
 30:         },
 31:       });
 32:     }
 33:   );
 34:   validateSession: AsyncRequestHandler = catchAsync(
 35:     async (req: Request, res: Response) => {
 36:       const { token } = req.body as IValidationRequest;
 37:       const jwtSecret = process.env.NEXTAUTH_SECRET;
 38:       if (!jwtSecret) {
 39:         sendResponse(res, {
 40:           statusCode: 500,
 41:           success: false,
 42:           message: "JWT secret not configured",
 43:         });
 44:         return;
 45:       }
 46:       try {
 47:         const decoded = jwt.verify(token, jwtSecret) as any;
 48:         const user = await authService.validateJWTToken(decoded.sub);
 49:         sendResponse(res, {
 50:           statusCode: 200,
 51:           success: true,
 52:           message: AUTH_SUCCESS_MESSAGES.TOKEN_VALIDATED,
 53:           data: {
 54:             valid: true,
 55:             user,
 56:           },
 57:         });
 58:       } catch (error) {
 59:         sendResponse(res, {
 60:           statusCode: 401,
 61:           success: false,
 62:           message: AUTH_ERROR_MESSAGES.INVALID_TOKEN,
 63:           data: {
 64:             valid: false,
 65:           },
 66:         });
 67:       }
 68:     }
 69:   );
 70:   getSession: AsyncRequestHandler = catchAsync(
 71:     async (req: Request, res: Response) => {
 72:       const { sessionToken } = req.body as ISessionValidationRequest;
 73:       const session = await authService.getSessionByToken(sessionToken);
 74:       if (!session) {
 75:         sendResponse(res, {
 76:           statusCode: 404,
 77:           success: false,
 78:           message: AUTH_ERROR_MESSAGES.SESSION_EXPIRED,
 79:         });
 80:         return;
 81:       }
 82:       sendResponse(res, {
 83:         statusCode: 200,
 84:         success: true,
 85:         message: "Session retrieved successfully",
 86:         data: { session },
 87:       });
 88:     }
 89:   );
 90:   deleteSession: AsyncRequestHandler = catchAsync(
 91:     async (req: Request, res: Response) => {
 92:       const { sessionToken } = req.body as ISessionValidationRequest;
 93:       await authService.deleteSession(sessionToken);
 94:       sendResponse(res, {
 95:         statusCode: 200,
 96:         success: true,
 97:         message: AUTH_SUCCESS_MESSAGES.LOGOUT_SUCCESS,
 98:       });
 99:     }
100:   );
101:   getCurrentUser: AsyncRequestHandler = catchAsync(
102:     async (req: Request, res: Response) => {
103:       const authHeader = req.headers.authorization;
104:       if (!authHeader || !authHeader.startsWith("Bearer ")) {
105:         sendResponse(res, {
106:           statusCode: 401,
107:           success: false,
108:           message: AUTH_ERROR_MESSAGES.UNAUTHORIZED,
109:         });
110:         return;
111:       }
112:       const token = authHeader.substring(7);
113:       const jwtSecret = process.env.NEXTAUTH_SECRET;
114:       if (!jwtSecret) {
115:         sendResponse(res, {
116:           statusCode: 500,
117:           success: false,
118:           message: "JWT secret not configured",
119:         });
120:         return;
121:       }
122:       try {
123:         const decoded = jwt.verify(token, jwtSecret) as any;
124:         const user = await authService.validateJWTToken(decoded.sub);
125:         sendResponse(res, {
126:           statusCode: 200,
127:           success: true,
128:           message: "User profile retrieved successfully",
129:           data: { user },
130:         });
131:       } catch (error) {
132:         sendResponse(res, {
133:           statusCode: 401,
134:           success: false,
135:           message: AUTH_ERROR_MESSAGES.INVALID_TOKEN,
136:         });
137:       }
138:     }
139:   );
140: }
141: export const authController = new AuthController();
</file>

