702:       <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
703:         <CardTitle className="text-sm font-medium">{title}</CardTitle>
704:         <Icon className="h-4 w-4 text-muted-foreground" />
705:       </CardHeader>
706:       <CardContent>
707:         <div className="text-2xl font-bold">{usedLabel}</div>
708:         <p className="text-xs text-muted-foreground mb-3">{helperText}</p>
709:         <div className="space-y-2">
710:           <Progress
711:             value={Math.min(percentage, 100)}
712:             className={`h-2 ${getProgressColor(percentage)}`}
713:           />
714:           <p className="text-xs text-muted-foreground">
715:             {percentage.toFixed(1)}% of limit used
716:           </p>
717:         </div>
718:       </CardContent>
719:     </Card>
720:   );
721: }
