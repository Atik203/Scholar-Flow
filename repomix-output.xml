339:    * Extract text from PDF with enhanced format preservation
340:    */
341:   private async extractFromPDF(
342:     buffer: Buffer,
343:     options: DocumentProcessingOptions
344:   ): Promise<DocumentExtractionResult> {
345:     try {
346:       console.log(
347:         `[DocumentExtraction] Starting PDF extraction with pdf-parse`
348:       );
349:       const pdfData = await pdf(buffer, {
350:         max: 0,
351:         version: "v1.10.100",
352:       });
353:       const extractedText = pdfData.text;
354:       const pageCount = pdfData.numpages;
355:       console.log(
356:         `[DocumentExtraction] PDF extraction completed. Text length: ${extractedText.length}, pages: ${pageCount}`
357:       );
358:       if (!extractedText || extractedText.trim().length === 0) {
359:         return {
360:           success: false,
361:           error: "No text content found in PDF",
362:         };
363:       }
364:       const sanitizedText = this.sanitizeText(extractedText);
365:       const chunks = this.createStructuredChunks(
366:         sanitizedText,
367:         pageCount,
368:         options.chunkSize || 2000
369:       );
370:       return {
371:         success: true,
372:         text: sanitizedText,
373:         pageCount,
374:         chunks,
375:       };
376:     } catch (error) {
377:       console.error(`[DocumentExtraction] PDF extraction failed:`, error);
378:       return {
379:         success: false,
380:         error: error instanceof Error ? error.message : "PDF extraction failed",
381:       };
382:     }
383:   }
384:   private async extractFromDOCX(
385:     buffer: Buffer,
386:     options: DocumentProcessingOptions
387:   ): Promise<DocumentExtractionResult> {
388:     try {
389:       console.log(`[DocumentExtraction] Starting DOCX extraction with mammoth`);
390:       const mammothBuffer = {
391:         buffer: buffer,
392:       };
393:       const mammothResult = await mammoth.convertToHtml(mammothBuffer, {
394:         styleMap: [
395:           "p[style-name='Heading 1'] => h1:fresh",
