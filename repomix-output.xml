 19: const getAllFromDB = async (params: any, options: IPaginationOptions) => {
 20:   const limit = options.limit || 10;
 21:   const page = options.page || 1;
 22:   const skip = (page - 1) * limit;
 23:   try {
 24:     let users: any[];
 25:     let totalResult: [{ count: bigint }];
 26:     if (params.search) {
 27:       users = await prisma.$queryRaw<any[]>`
 28:         SELECT id, email, role, "createdAt", "updatedAt"
 29:         FROM "User"
 30:         WHERE "isDeleted" = false
 31:           AND (email ILIKE ${`%${params.search}%`} OR role ILIKE ${`%${params.search}%`})
 32:         ORDER BY "createdAt" DESC
 33:         LIMIT ${limit} OFFSET ${skip}
 34:       `;
 35:       totalResult = await prisma.$queryRaw<[{ count: bigint }]>`
 36:         SELECT COUNT(*) as count
 37:         FROM "User"
 38:         WHERE "isDeleted" = false
 39:           AND (email ILIKE ${`%${params.search}%`} OR role ILIKE ${`%${params.search}%`})
 40:       `;
 41:     } else {
 42:       users = await prisma.$queryRaw<any[]>`
 43:         SELECT id, email, role, "createdAt", "updatedAt"
 44:         FROM "User"
 45:         WHERE "isDeleted" = false
 46:         ORDER BY "createdAt" DESC
 47:         LIMIT ${limit} OFFSET ${skip}
 48:       `;
 49:       totalResult = await prisma.$queryRaw<[{ count: bigint }]>`
 50:         SELECT COUNT(*) as count
 51:         FROM "User"
 52:         WHERE "isDeleted" = false
 53:       `;
 54:     }
 55:     const total = Number(totalResult[0]?.count || 0);
 56:     const totalPage = Math.ceil(total / limit);
 57:     return {
 58:       result: users,
 59:       meta: {
 60:         page,
 61:         limit,
 62:         total,
 63:         totalPage,
 64:       },
 65:     };
 66:   } catch (error) {
 67:     console.error("Error in getAllFromDB with $queryRaw:", error);
 68:     throw new ApiError(500, "Failed to get users from database");
 69:   }
 70: };
