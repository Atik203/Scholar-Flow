 1: import { Request, Response } from "express";
 2: import ApiError from "../../errors/ApiError";
 3: import { AuthenticatedRequest } from "../../interfaces/common";
 4: import catchAsync from "../../shared/catchAsync";
 5: import prisma from "../../shared/prisma";
 6: import { sendSuccessResponse } from "../../shared/sendResponse";
 7: import { ImportService } from "./import.service";
 8: export const importController = {
 9:   importByDOI: catchAsync(async (req: Request, res: Response) => {
10:     const authReq = req as AuthenticatedRequest;
11:     const { doi, workspaceId } = req.body;
12:     if (!doi || !workspaceId) {
13:       throw new ApiError(400, "doi and workspaceId are required");
14:     }
15:     const result = await ImportService.importByDOI(doi, workspaceId, authReq.user.id);
16:     sendSuccessResponse(res, result, "Paper imported via DOI", 201);
17:   }),
18:   importByArxiv: catchAsync(async (req: Request, res: Response) => {
19:     const authReq = req as AuthenticatedRequest;
20:     const { arxivId, workspaceId } = req.body;
21:     if (!arxivId || !workspaceId) {
22:       throw new ApiError(400, "arxivId and workspaceId are required");
23:     }
24:     const result = await ImportService.importByArxiv(arxivId, workspaceId, authReq.user.id);
25:     sendSuccessResponse(res, result, "Paper imported via arXiv", 201);
26:   }),
27:   importByURL: catchAsync(async (req: Request, res: Response) => {
28:     const authReq = req as AuthenticatedRequest;
29:     const { url, workspaceId } = req.body;
30:     if (!url || !workspaceId) {
31:       throw new ApiError(400, "url and workspaceId are required");
32:     }
33:     const result = await ImportService.importByURL(url, workspaceId, authReq.user.id);
34:     sendSuccessResponse(res, { id: result.paper.id, title: result.paper.title }, "Paper imported via URL", 201);
35:   }),
36:   importByFile: catchAsync(async (req: Request, res: Response) => {
37:     const authReq = req as AuthenticatedRequest;
38:     const { content, format, workspaceId } = req.body;
39:     if (!content || !format || !workspaceId) {
40:       throw new ApiError(400, "content, format, and workspaceId are required");
41:     }
42:     let papers;
43:     if (format === "bibtex") {
44:       papers = ImportService.parseBibTeX(content);
45:     } else if (format === "ris") {
46:       papers = ImportService.parseRIS(content);
47:     } else {
48:       throw new ApiError(400, "Unsupported format. Use 'bibtex' or 'ris'.");
49:     }
50:     const imported: any[] = [];
51:     for (const p of papers) {
52:       try {
53:         const metadata = { authors: p.authors, year: p.year, source: p.source };
54:         const result = await prisma.$queryRaw<any[]>`
55:           INSERT INTO "Paper" (id, "workspaceId", "uploaderId", title, abstract, metadata, source, doi, tags, "citationCount", "processingStatus", "createdAt", "updatedAt", "isDeleted")
56:           VALUES (gen_random_uuid(), ${workspaceId}, ${authReq.user.id}, ${p.title}, ${p.abstract || null}, ${JSON.stringify(metadata)}::jsonb, ${p.source}, ${p.doi || null}, ARRAY[]::text[], 0, 'UPLOADED', NOW(), NOW(), false)
57:           RETURNING id, title, source, doi
58:         `;
59:         imported.push({ id: result[0].id, title: p.title, source: p.source, status: "success" });
60:       } catch (e) {
61:         imported.push({ title: p.title, source: p.source, status: "error", error: (e as Error).message });
62:       }
63:     }
64:     sendSuccessResponse(
65:       res,
66:       { total: papers.length, imported: imported.filter((i) => i.status === "success").length, papers: imported },
67:       `Imported ${imported.filter((i) => i.status === "success").length} of ${papers.length} papers`,
68:       201
69:     );
70:   }),
71:   importByZotero: catchAsync(async (req: Request, res: Response) => {
72:     throw new ApiError(501, "Zotero import is not yet available (coming in Phase 4C)");
73:   }),
74:   importByMendeley: catchAsync(async (req: Request, res: Response) => {
75:     throw new ApiError(501, "Mendeley import is not yet available (coming in Phase 4C)");
76:   }),
77:   importByEndnote: catchAsync(async (req: Request, res: Response) => {
78:     throw new ApiError(501, "EndNote import is not yet available (coming in Phase 4C)");
79:   }),
80:   getImportHistory: catchAsync(async (req: Request, res: Response) => {
81:     const authReq = req as AuthenticatedRequest;
82:     const papers = await prisma.$queryRaw<any[]>`
83:       SELECT id, title, source, doi, "createdAt"
84:       FROM "Paper"
85:       WHERE "uploaderId" = ${authReq.user.id}
86:         AND source IN ('doi', 'arxiv', 'url', 'bibtex', 'ris', 'zotero', 'mendeley', 'endnote')
87:         AND "isDeleted" = false
88:       ORDER BY "createdAt" DESC
89:       LIMIT 20
90:     `;
91:     sendSuccessResponse(res, papers, "Import history retrieved");
92:   }),
93: };
</file>

