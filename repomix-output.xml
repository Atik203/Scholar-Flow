 83: export function ScholarFlowEditor({ paperId, onBack }: ScholarFlowEditorProps) {
 84:   const [hasUnsavedChanges, setHasUnsavedChanges] = useState(false);
 85:   const [lastSaved, setLastSaved] = useState<Date | null>(null);
 86:   const [title, setTitle] = useState("");
 87:   const [isShareModalOpen, setIsShareModalOpen] = useState(false);
 88:   const [isVersionDialogOpen, setIsVersionDialogOpen] = useState(false);
 89:   const [isCitationDialogOpen, setIsCitationDialogOpen] = useState(false);
