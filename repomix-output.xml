<file path="apps/frontend/src/hooks/useSubscriptionSync.ts">
  1: "use client";
  2: import { apiSlice } from "@/redux/api/apiSlice";
  3: import { useGetSubscriptionQuery } from "@/redux/api/billingApi";
  4: import { useGetProfileQuery } from "@/redux/api/userApi";
  5: import { useAuth } from "@/redux/auth/useAuth";
  6: import { useAppDispatch } from "@/redux/hooks";
  7: import { useCallback, useEffect, useRef, useState } from "react";
  8: interface UseSubscriptionSyncOptions {
  9:   enabled: boolean;
 10:   maxAttempts?: number;
 11:   pollingInterval?: number;
 12:   onSyncComplete?: () => void;
 13:   onSyncTimeout?: () => void;
 14: }
 15: interface SubscriptionSnapshot {
 16:   role: string | null;
 17:   subscriptionId: string | null;
 18:   status: string | null;
 19:   planId: string | null;
 20: }
 21: export function useSubscriptionSync({
 22:   enabled = false,
 23:   maxAttempts = 10,
 24:   pollingInterval = 2000,
 25:   onSyncComplete,
 26:   onSyncTimeout,
 27: }: UseSubscriptionSyncOptions) {
 28:   const dispatch = useAppDispatch();
 29:   const { user } = useAuth();
 30:   const pollingIntervalRef = useRef<NodeJS.Timeout | null>(null);
 31:   const attemptCountRef = useRef(0);
 32:   const hasCompletedRef = useRef(false);
 33:   const initialSnapshotRef = useRef<SubscriptionSnapshot | null>(null);
 34:   const lastKnownSnapshotRef = useRef<SubscriptionSnapshot | null>(null);
 35:   const [attemptCount, setAttemptCount] = useState(0);
 36:   const [isPolling, setIsPolling] = useState(false);
 37:   const { refetch: refetchProfile } = useGetProfileQuery(undefined, {
 38:     refetchOnMountOrArgChange: false,
 39:     refetchOnFocus: false,
 40:     refetchOnReconnect: false,
 41:   });
 42:   const { data: subscription, refetch: refetchSubscription } =
 43:     useGetSubscriptionQuery(
 44:       {},
 45:       {
 46:         refetchOnMountOrArgChange: false,
 47:         refetchOnFocus: false,
 48:         refetchOnReconnect: false,
 49:       }
 50:     );
 51:   const captureSnapshot = useCallback((): SubscriptionSnapshot => {
 52:     return {
 53:       role: user?.role || null,
 54:       subscriptionId: user?.stripeSubscriptionId || null,
 55:       status: subscription?.status || null,
 56:       planId: subscription?.planId || null,
 57:     };
 58:   }, [user, subscription]);
 59:   const hasChanges = useCallback(
 60:     (
 61:       snapshot1: SubscriptionSnapshot | null,
 62:       snapshot2: SubscriptionSnapshot | null
 63:     ): boolean => {
 64:       if (!snapshot1 || !snapshot2) return false;
 65:       return (
 66:         snapshot1.role !== snapshot2.role ||
 67:         snapshot1.subscriptionId !== snapshot2.subscriptionId ||
 68:         snapshot1.status !== snapshot2.status ||
 69:         snapshot1.planId !== snapshot2.planId
 70:       );
 71:     },
 72:     []
 73:   );
 74:   const forceRefresh = useCallback(async () => {
 75:     if (!enabled) {
 76:       console.warn("[useSubscriptionSync] Skipping refresh - sync not enabled");
 77:       return false;
 78:     }
 79:     try {
 80:       dispatch(apiSlice.util.invalidateTags(["User"]));
 81:       const results = await Promise.allSettled([
 82:         refetchProfile(),
 83:         refetchSubscription(),
 84:       ]);
 85:       const allSucceeded = results.every(
 86:         (result) => result.status === "fulfilled"
 87:       );
 88:       if (!allSucceeded) {
 89:         const failures = results.filter((r) => r.status === "rejected");
 90:         console.error("[useSubscriptionSync] Some refetches failed:", failures);
 91:       }
 92:       return allSucceeded;
 93:     } catch (error) {
 94:       console.error("[useSubscriptionSync] Error during refresh:", error);
 95:       return false;
 96:     }
 97:   }, [dispatch, refetchProfile, refetchSubscription, enabled]);
 98:   const stopPolling = useCallback(() => {
 99:     if (pollingIntervalRef.current) {
100:       clearInterval(pollingIntervalRef.current);
101:       pollingIntervalRef.current = null;
102:     }
103:     setIsPolling(false);
104:     attemptCountRef.current = 0;
105:     setAttemptCount(0);
106:   }, []);
107:   const completeSync = useCallback(() => {
108:     stopPolling();
109:     hasCompletedRef.current = true;
110:     setIsPolling(false);
111:     onSyncComplete?.();
112:   }, [stopPolling, onSyncComplete]);
113:   const poll = useCallback(async () => {
114:     if (hasCompletedRef.current) {
115:       stopPolling();
116:       return;
117:     }
118:     attemptCountRef.current += 1;
119:     setAttemptCount(attemptCountRef.current);
120:     if (attemptCountRef.current > maxAttempts) {
121:       console.warn(
122:         `[useSubscriptionSync] Max polling attempts (${maxAttempts}) reached. Stopping.`
123:       );
124:       stopPolling();
125:       hasCompletedRef.current = true;
126:       onSyncTimeout?.();
127:       return;
128:     }
129:     const refreshSuccess = await forceRefresh();
130:     if (!refreshSuccess) {
131:       return;
132:     }
133:     const currentSnapshot = captureSnapshot();
134:     if (!initialSnapshotRef.current) {
135:       initialSnapshotRef.current = currentSnapshot;
136:       lastKnownSnapshotRef.current = currentSnapshot;
137:       const hasPaidAccess =
138:         currentSnapshot.status === "ACTIVE" ||
139:         (currentSnapshot.role !== "RESEARCHER" &&
140:           Boolean(currentSnapshot.subscriptionId));
141:       if (hasPaidAccess) {
142:         console.log(
143:           "[useSubscriptionSync] State already converged, completing sync"
144:         );
145:         completeSync();
146:       }
147:       return;
148:     }
149:     const changesDetected = hasChanges(
150:       lastKnownSnapshotRef.current,
151:       currentSnapshot
152:     );
153:     if (changesDetected) {
154:       console.log("[useSubscriptionSync] Subscription changes detected!", {
155:         before: lastKnownSnapshotRef.current,
156:         after: currentSnapshot,
157:       });
158:       lastKnownSnapshotRef.current = currentSnapshot;
159:       completeSync();
160:     }
161:   }, [
162:     maxAttempts,
163:     onSyncTimeout,
164:     stopPolling,
165:     completeSync,
166:     forceRefresh,
167:     captureSnapshot,
168:     hasChanges,
169:   ]);
170:   useEffect(() => {
171:     if (!enabled) {
172:       stopPolling();
173:       hasCompletedRef.current = false;
174:       initialSnapshotRef.current = null;
175:       lastKnownSnapshotRef.current = null;
176:       attemptCountRef.current = 0;
177:       setAttemptCount(0);
178:       setIsPolling(false);
179:       return;
180:     }
181:     if (hasCompletedRef.current) {
182:       return;
183:     }
184:     console.log("[useSubscriptionSync] Starting subscription sync polling");
185:     setIsPolling(true);
186:     poll();
187:     pollingIntervalRef.current = setInterval(poll, pollingInterval);
188:     return () => {
189:       stopPolling();
190:     };
191:   }, [enabled, poll, pollingInterval, stopPolling]);
192:   return {
193:     isPolling,
194:     attemptCount,
195:     maxAttempts,
196:     forceRefresh,
197:   };
198: }
</file>

