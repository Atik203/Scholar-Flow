 712:   shareViaEmail: catchAsync(async (req: Request, res: Response) => {
 713:     const authReq = req as AuthenticatedRequest;
 714:     const { paperId, recipientEmail, permission } = req.body;
 715:     // Validate input
 716:     if (!paperId || !recipientEmail || !permission) {
 717:       throw new ApiError(
 718:         400,
 719:         "Paper ID, recipient email, and permission are required"
 720:       );
 721:     }
 722:     if (!["view", "edit"].includes(permission)) {
 723:       throw new ApiError(400, "Permission must be 'view' or 'edit'");
 724:     }
 725:     // Validate email format
 726:     const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
 727:     if (!emailRegex.test(recipientEmail)) {
 728:       throw new ApiError(400, "Invalid email format");
 729:     }
 730:     try {
 731:       // Get paper details
 732:       const paper = (await prisma.$queryRaw`
 733:         SELECT p.id, p.title, p."contentHtml", u.name as author_name
 734:         FROM "Paper" p
 735:         JOIN "User" u ON p."uploaderId" = u.id
 736:         WHERE p.id = ${paperId}
 737:       `) as any[];
 738:       if (!paper.length) {
 739:         throw new ApiError(404, "Paper not found");
 740:       }
 741:       const paperData = paper[0];
 742:       // Check if user has permission to share this paper
 743:       // (uploader, workspace owner/member, or collection member with EDIT)
 744:       const hasPermission = (await prisma.$queryRaw`
 745:         SELECT 1 FROM "Paper" p
 746:         LEFT JOIN "Workspace" w
 747:           ON w.id = p."workspaceId" AND w."isDeleted" = false
 748:         LEFT JOIN "WorkspaceMember" wm
 749:           ON wm."workspaceId" = p."workspaceId"
 750:           AND wm."userId" = ${authReq.user.id}
 751:           AND wm."isDeleted" = false
 752:         WHERE p.id = ${paperId}
 753:         AND (
 754:           p."uploaderId" = ${authReq.user.id}
 755:           OR w."ownerId" = ${authReq.user.id}
 756:           OR wm.id IS NOT NULL
 757:           OR EXISTS (
 758:             SELECT 1 FROM "CollectionPaper" cp
 759:             JOIN "CollectionMember" cm ON cp."collectionId" = cm."collectionId"
 760:             WHERE cp."paperId" = ${paperId}
 761:             AND cm."userId" = ${authReq.user.id}
 762:             AND cm.permission = 'EDIT'
 763:           )
 764:         )
 765:       `) as any[];
 766:       if (!hasPermission.length) {
 767:         throw new ApiError(
 768:           403,
 769:           "You don't have permission to share this paper"
 770:         );
 771:       }
 772:       // Persist the share: one row per paper+email (upsert refreshes the
 773:       // permission and re-activates soft-deleted rows — an idempotent
 774:       // re-share). This row is what actually grants the recipient access.
 775:       await prisma.$executeRaw`
 776:         INSERT INTO "PaperShare" (id, "paperId", email, permission, "sharedById", "createdAt", "updatedAt", "isDeleted")
 777:         VALUES (gen_random_uuid(), ${paperId}, ${recipientEmail}, ${permission}, ${authReq.user.id}, NOW(), NOW(), false)
 778:         ON CONFLICT ("paperId", "email")
 779:         DO UPDATE SET permission = EXCLUDED.permission, "updatedAt" = NOW(), "isDeleted" = false
 780:       `;
 781:       // In-app notification for registered recipients (best-effort, instant
 782:       // over SSE). Emails may go to non-users, so this is a no-op then.
 783:       try {
 784:         const recipient = await prisma.user.findFirst({
 785:           where: { email: recipientEmail, isDeleted: false },
 786:           select: { id: true },
 787:         });
 788:         if (recipient && recipient.id !== authReq.user.id) {
 789:           const { notificationService } = await import(
 790:             "../Notification/notification.service"
 791:           );
 792:           await notificationService.createNotification({
 793:             userId: recipient.id,
 794:             type: "SHARE",
 795:             category: "PAPERS",
 796:             title: "Paper shared with you",
 797:             message: `${
 798:               authReq.user.name || authReq.user.email
 799:             } shared "${paperData.title}" with ${
 800:               permission === "edit" ? "edit" : "view"
 801:             } access.`,
 802:             actionUrl:
 803:               permission === "edit"
 804:                 ? `/dashboard/research/editor?paper=${paperId}`
 805:                 : `/dashboard/papers/${paperId}`,
 806:             actorId: authReq.user.id,
 807:             resourceId: paperId,
 808:           });
 809:         }
 810:       } catch {
 811:         // notification failures never break the share flow
 812:       }
 813:       // Generate paper link (permission-aware frontend route).
 814:       const baseUrl = process.env.FRONTEND_URL || "http://localhost:3000";
 815:       const paperLink =
 816:         permission === "edit"
 817:           ? `${baseUrl}/dashboard/research/editor?paper=${paperId}`
 818:           : `${baseUrl}/dashboard/papers/${paperId}`;
 819:       // Import and use email service
 820:       const { emailService } = await import("../../shared/emailService");
 821:       await emailService.sendPaperShareEmail({
 822:         recipientEmail,
 823:         senderName: authReq.user.name || authReq.user.email,
 824:         paperTitle: paperData.title,
 825:         paperLink,
 826:         permission,
 827:       });
 828:       sendSuccessResponse(res, {
 829:         message: "Paper shared successfully via email",
 830:         data: {
 831:           recipientEmail,
 832:           paperTitle: paperData.title,
 833:           permission,
 834:         },
 835:       });
 836:     } catch (error) {
 837:       console.error("[PaperController] Email share failed:", error);
 838:       if (error instanceof ApiError) {
 839:         throw error;
 840:       }
 841:       throw new ApiError(500, "Failed to share paper via email");
 842:     }
 843:   }),
