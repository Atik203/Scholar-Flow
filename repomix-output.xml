  1: import express from "express";
  2: import { authMiddleware } from "../../middleware/auth";
  3: import { aiGenerationLimiter, rateLimiter } from "../../middleware/rateLimiter";
  4: import catchAsync from "../../shared/catchAsync";
  5: import { sendSuccessResponse } from "../../shared/sendResponse";
  6: import { AuthenticatedRequest } from "../../interfaces/common";
  7: import { aiConversationService } from "./aiConversation.service";
  8: const router: express.Router = express.Router();
  9: router.get(
 10:   "/",
 11:   authMiddleware as any,
 12:   catchAsync(async (req, res) => {
 13:     const authReq = req as AuthenticatedRequest;
 14:     const convs = await aiConversationService.listConversations(authReq.user!.id);
 15:     sendSuccessResponse(res, { conversations: convs }, "Conversations retrieved");
 16:   })
 17: );
 18: router.post(
 19:   "/",
 20:   authMiddleware as any,
 21:   rateLimiter as any,
 22:   catchAsync(async (req, res) => {
 23:     const authReq = req as AuthenticatedRequest;
 24:     const { title, model, context } = req.body || {};
 25:     const conv = await aiConversationService.createConversation(
 26:       authReq.user!.id,
 27:       title,
 28:       model,
 29:       context
 30:     );
 31:     sendSuccessResponse(res, conv, "Conversation created");
 32:   })
 33: );
 34: router.get(
 35:   "/:id",
 36:   authMiddleware as any,
 37:   catchAsync(async (req, res) => {
 38:     const authReq = req as AuthenticatedRequest;
 39:     const conv = await aiConversationService.getConversation(req.params.id, authReq.user!.id);
 40:     sendSuccessResponse(res, conv, "Conversation retrieved");
 41:   })
 42: );
 43: router.post(
 44:   "/:id/messages",
 45:   authMiddleware as any,
 46:   rateLimiter as any,
 47:   catchAsync(async (req, res) => {
 48:     const authReq = req as AuthenticatedRequest;
 49:     const { content } = req.body || {};
 50:     if (!content) {
 51:       res.status(400).json({ success: false, message: "Content is required" });
 52:       return;
 53:     }
 54:     const msg = await aiConversationService.sendMessage(
 55:       req.params.id,
 56:       authReq.user!.id,
 57:       content
 58:     );
 59:     sendSuccessResponse(res, msg, "Message sent");
 60:   })
 61: );
 62: router.post(
 63:   "/:id/messages/stream",
 64:   authMiddleware as any,
 65:   aiGenerationLimiter as any,
 66:   catchAsync(async (req, res) => {
 67:     const authReq = req as AuthenticatedRequest;
 68:     const { content } = req.body || {};
 69:     if (!content) {
 70:       res.status(400).json({ success: false, message: "Content is required" });
 71:       return;
 72:     }
 73:     res.setHeader("Content-Type", "text/event-stream");
 74:     res.setHeader("Cache-Control", "no-cache");
 75:     res.setHeader("Connection", "keep-alive");
 76:     res.setHeader("X-Accel-Buffering", "no");
 77:     res.flushHeaders();
 78:     const sendSSE = (event: string, data: unknown) => {
 79:       res.write(`event: ${event}\ndata: ${JSON.stringify(data)}\n\n`);
 80:     };
 81:     let aborted = false;
 82:     req.on("close", () => { aborted = true; });
 83:     try {
 84:       await aiConversationService.streamMessage(
 85:         req.params.id,
 86:         authReq.user!.id,
 87:         content,
 88:         (token: string, done: boolean) => {
 89:           if (aborted) return;
 90:           if (done) {
 91:             sendSSE("done", { content: token });
 92:             res.end();
 93:           } else {
 94:             sendSSE("token", { token });
 95:           }
 96:         }
 97:       );
 98:     } catch (err: any) {
 99:       if (!aborted) {
100:         sendSSE("error", { message: err?.message || "Stream failed" });
101:         res.end();
102:       }
103:     }
104:   })
105: );
106: router.delete(
107:   "/:id",
108:   authMiddleware as any,
109:   catchAsync(async (req, res) => {
110:     const authReq = req as AuthenticatedRequest;
111:     await aiConversationService.deleteConversation(req.params.id, authReq.user!.id);
112:     sendSuccessResponse(res, null, "Conversation deleted");
113:   })
114: );
115: export const aiConversationRoutes = router;
</file>

