213:   const subscriptionId =
214:     typeof session.subscription === "string"
215:       ? session.subscription
216:       : session.subscription.id;
217:   const stripeSubscription = (await stripe.subscriptions.retrieve(
218:     subscriptionId
219:   )) as Stripe.Subscription;
220:   const { currentPeriodStart, currentPeriodEnd } =
221:     getSubscriptionPeriodBounds(stripeSubscription);
222:   const stripeCustomerId =
