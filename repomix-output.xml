<file path="apps/backend/prisma/sql/admin/getSystemStats.sql">
 1: SELECT
 2:   (SELECT COUNT(*)::int FROM "User" WHERE "isDeleted" = false) as "totalUsers",
 3:   (SELECT COUNT(*)::int FROM "Paper" WHERE "isDeleted" = false) as "totalPapers",
 4:   (SELECT COUNT(*)::int FROM "Session" WHERE "expires" > NOW()) as "activeSessions",
 5:   (SELECT COALESCE(SUM("sizeBytes"), 0)::int FROM "PaperFile" WHERE "isDeleted" = false) as "totalStorageBytes",
 6:   (
 7:     SELECT COUNT(*)::int FROM "User"
 8:     WHERE "createdAt" >= NOW() - INTERVAL '30 days'
 9:     AND "isDeleted" = false
10:   ) as "newUsersLast30Days",
11:   (
12:     SELECT COUNT(*)::int FROM "User"
13:     WHERE "createdAt" >= NOW() - INTERVAL '60 days'
14:     AND "createdAt" < NOW() - INTERVAL '30 days'
15:     AND "isDeleted" = false
16:   ) as "newUsersPrevious30Days",
17:   (
18:     SELECT COUNT(*)::int FROM "Paper"
19:     WHERE "createdAt" >= NOW() - INTERVAL '30 days'
20:     AND "isDeleted" = false
21:   ) as "newPapersLast30Days",
22:   (
23:     SELECT COUNT(*)::int FROM "Paper"
24:     WHERE "createdAt" >= NOW() - INTERVAL '60 days'
25:     AND "createdAt" < NOW() - INTERVAL '30 days'
26:     AND "isDeleted" = false
27:   ) as "newPapersPrevious30Days",
28:   (
29:     SELECT COALESCE(SUM(pf."sizeBytes"), 0)::int FROM "PaperFile" pf
30:     INNER JOIN "Paper" p ON pf."paperId" = p.id
31:     WHERE p."createdAt" >= NOW() - INTERVAL '30 days'
32:     AND pf."isDeleted" = false
33:     AND p."isDeleted" = false
34:   ) as "storageAddedLast30Days",
35:   (
36:     SELECT COALESCE(SUM(pf."sizeBytes"), 0)::int FROM "PaperFile" pf
37:     INNER JOIN "Paper" p ON pf."paperId" = p.id
38:     WHERE p."createdAt" >= NOW() - INTERVAL '60 days'
39:     AND p."createdAt" < NOW() - INTERVAL '30 days'
40:     AND pf."isDeleted" = false
41:     AND p."isDeleted" = false
