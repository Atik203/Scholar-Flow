 6: }
 7: export interface FloatingInputProps
 8:   extends React.InputHTMLAttributes<HTMLInputElement> {
 9:   label: string;
10:   error?: boolean;
11:   helperText?: string;
12:   required?: boolean;
13: }
14: export const FloatingInput = React.forwardRef<
15:   HTMLInputElement,
16:   FloatingInputProps
17: >(({ className, label, error, helperText, required, id, ...props }, ref) => {
18:   const inputId =
19:     id || `floating-input-${Math.random().toString(36).substr(2, 9)}`;
20:   const [isFocused, setIsFocused] = React.useState(false);
