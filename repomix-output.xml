 15: let popplerAvailable: boolean | null = null;
 16: async function checkPoppler(): Promise<boolean> {
 17:   if (popplerAvailable !== null) return popplerAvailable;
 18:   try {
 19:     await execFileAsync("pdftotext", ["-v"], { timeout: 5000 });
 20:     popplerAvailable = true;
 21:   } catch {
 22:     popplerAvailable = false;
 23:   }
 24:   return popplerAvailable;
 25: }
 26: function isScannedText(text: string): boolean {
 27:   const cleaned = text.replace(/\s/g, "");
 28:   return cleaned.length < 100;
 29: }
 30: /**
 31:  * Tier 1: poppler pdftotext — native C extraction (~50ms per page)
 32:  */
 33: export async function extractWithPoppler(
 34:   buffer: Buffer
 35: ): Promise<ExtractionResult> {
 36:   const start = Date.now();
 37:   let tmpDir: string | null = null;
 38:   try {
 39:     tmpDir = await mkdtemp(join(tmpdir(), "sf-poppler-"));
 40:     const inputPath = join(tmpDir, "input.pdf");
 41:     await writeFile(inputPath, buffer);
 42:     const { stdout } = await execFileAsync(
 43:       "pdftotext",
 44:       ["-layout", "-nopgbrk", inputPath, "-"],
 45:       { timeout: 120000, maxBuffer: 50 * 1024 * 1024 }
 46:     );
 47:     const text = stdout;
 48:     const elapsed = Date.now() - start;
 49:     console.log(
 50:       `[pdfExtraction] poppler completed in ${elapsed}ms, text length: ${text.length}`
 51:     );
 52:     if (isScannedText(text)) {
 53:       console.log(
 54:         "[pdfExtraction] poppler returned very little text — likely a scanned PDF"
 55:       );
 56:       return { success: false, method: "poppler", error: "scanned_pdf" };
 57:     }
 58:     return { success: true, text, method: "poppler" };
 59:   } catch (error) {
 60:     const elapsed = Date.now() - start;
 61:     console.error(
 62:       `[pdfExtraction] poppler failed after ${elapsed}ms:`,
 63:       error instanceof Error ? error.message : error
 64:     );
 65:     return {
 66:       success: false,
 67:       method: "poppler",
 68:       error: error instanceof Error ? error.message : "poppler failed",
 69:     };
 70:   } finally {
 71:     if (tmpDir) await rm(tmpDir, { recursive: true, force: true }).catch(() => {});
 72:   }
 73: }
 74: export async function extractWithOCR(
 75:   buffer: Buffer
 76: ): Promise<ExtractionResult> {
 77:   const start = Date.now();
 78:   let tmpDir: string | null = null;
 79:   try {
 80:     tmpDir = await mkdtemp(join(tmpdir(), "sf-ocr-"));
 81:     const inputPath = join(tmpDir, "input.pdf");
 82:     await writeFile(inputPath, buffer);
 83:     await execFileAsync(
 84:       "pdftoppm",
 85:       ["-png", "-r", "300", inputPath, join(tmpDir, "page")],
 86:       { timeout: 180000 }
 87:     );
 88:     const tesseract = await import("tesseract.js");
 89:     const { readdir } = await import("fs/promises");
 90:     const files = (await readdir(tmpDir))
 91:       .filter((f) => f.startsWith("page-") && f.endsWith(".png"))
 92:       .sort();
 93:     if (files.length === 0) {
 94:       return {
 95:         success: false,
 96:         method: "ocr",
 97:         error: "No page images generated for OCR",
 98:       };
 99:     }
100:     const pageTexts: string[] = [];
101:     let worker: any = null;
102:     try {
103:       worker = await tesseract.createWorker("eng");
104:       for (const file of files) {
105:         const { data } = await worker.recognize(join(tmpDir, file));
106:         pageTexts.push(data.text);
107:       }
108:     } finally {
109:       if (worker) await worker.terminate().catch(() => {});
110:     }
111:     const text = pageTexts.join("\n\n");
112:     const elapsed = Date.now() - start;
113:     console.log(
114:       `[pdfExtraction] OCR completed in ${elapsed}ms, pages: ${files.length}, text length: ${text.length}`
115:     );
116:     if (isScannedText(text)) {
117:       return {
118:         success: false,
119:         method: "ocr",
120:         error: "OCR could not extract readable text",
121:       };
122:     }
123:     return {
124:       success: true,
125:       text,
126:       pageCount: files.length,
127:       method: "ocr",
128:     };
129:   } catch (error) {
130:     const elapsed = Date.now() - start;
131:     console.error(
132:       `[pdfExtraction] OCR failed after ${elapsed}ms:`,
133:       error instanceof Error ? error.message : error
134:     );
135:     return {
136:       success: false,
137:       method: "ocr",
138:       error: error instanceof Error ? error.message : "OCR failed",
139:     };
140:   } finally {
141:     if (tmpDir) await rm(tmpDir, { recursive: true, force: true }).catch(() => {});
142:   }
143: }
144: export async function extractWithUnpdf(
145:   buffer: Buffer
146: ): Promise<ExtractionResult> {
147:   const start = Date.now();
148:   try {
149:     const { extractText } = await import("unpdf");
150:     const result = await extractText(new Uint8Array(buffer));
151:     const text = typeof result === "string" ? result : (result as any).text || "";
152:     const elapsed = Date.now() - start;
153:     console.log(
154:       `[pdfExtraction] unpdf completed in ${elapsed}ms, text length: ${text.length}`
155:     );
156:     if (!text || text.trim().length === 0) {
157:       return {
158:         success: false,
159:         method: "unpdf",
160:         error: "No text content found in PDF",
161:       };
162:     }
163:     return { success: true, text, method: "unpdf" };
164:   } catch (error) {
165:     const elapsed = Date.now() - start;
166:     console.error(
167:       `[pdfExtraction] unpdf failed after ${elapsed}ms:`,
168:       error instanceof Error ? error.message : error
169:     );
170:     return {
171:       success: false,
172:       method: "unpdf",
173:       error: error instanceof Error ? error.message : "unpdf failed",
174:     };
175:   }
176: }
177: export async function extractWithPdfParse(
178:   buffer: Buffer
179: ): Promise<ExtractionResult> {
180:   const start = Date.now();
181:   try {
182:     const pdf = await import("pdf-parse");
183:     const pdfData = await pdf.default(buffer, {
184:       max: 0,
185:       version: "v1.10.100",
186:     });
187:     const text = pdfData.text;
188:     const elapsed = Date.now() - start;
189:     console.log(
190:       `[pdfExtraction] pdf-parse completed in ${elapsed}ms, text length: ${text.length}`
191:     );
192:     if (!text || text.trim().length === 0) {
193:       return {
194:         success: false,
195:         method: "fallback",
196:         error: "No text content found in PDF",
197:       };
198:     }
199:     return {
200:       success: true,
201:       text,
202:       pageCount: pdfData.numpages,
203:       method: "fallback",
204:     };
205:   } catch (error) {
206:     const elapsed = Date.now() - start;
207:     console.error(
208:       `[pdfExtraction] pdf-parse failed after ${elapsed}ms:`,
209:       error instanceof Error ? error.message : error
210:     );
211:     return {
212:       success: false,
213:       method: "fallback",
214:       error: error instanceof Error ? error.message : "pdf-parse failed",
215:     };
216:   }
217: }
218: export async function extractPdfText(
219:   buffer: Buffer
220: ): Promise<ExtractionResult> {
221:   const hasPoppler = await checkPoppler();
222:   if (hasPoppler) {
223:     const popplerResult = await extractWithPoppler(buffer);
224:     if (popplerResult.success) return popplerResult;
225:     if (popplerResult.error === "scanned_pdf") {
226:       console.log("[pdfExtraction] Detected scanned PDF — attempting OCR...");
227:       const ocrResult = await extractWithOCR(buffer);
228:       if (ocrResult.success) return ocrResult;
229:       console.log("[pdfExtraction] OCR failed — falling back to unpdf...");
230:     }
231:   }
232:   const unpdfResult = await extractWithUnpdf(buffer);
233:   if (unpdfResult.success) return unpdfResult;
234:   console.log("[pdfExtraction] unpdf failed — falling back to pdf-parse...");
235:   return extractWithPdfParse(buffer);
236: }
