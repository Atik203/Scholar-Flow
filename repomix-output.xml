1390:     }
1391:     // Process images: convert external URLs to base64 for DOCX compatibility
1392:     let processedContent = paper.contentHtml || "<p>No content available.</p>";
1393:     try {
1394:       // Find all img tags and convert them to base64
1395:       const imgRegex = /<img[^>]+src="([^"]+)"[^>]*>/g;
1396:       const images: Array<{ original: string; base64: string }> = [];
1397:       let match;
1398:       while ((match = imgRegex.exec(processedContent)) !== null) {
1399:         const imgUrl = match[1];
1400:         // Skip if already processed or if it's already base64
1401:         if (
1402:           images.some((img) => img.original === imgUrl) ||
1403:           imgUrl.startsWith("data:")
1404:         ) {
1405:           continue;
1406:         }
1407:         try {
1408:           console.log(`[DOCX Export] Converting image to base64: ${imgUrl}`);
1409:           const response = await axios.get(imgUrl, {
1410:             responseType: "arraybuffer",
1411:             timeout: 10000, // 10 second timeout
1412:           });
1413:           const contentType = response.headers["content-type"] || "image/png";
1414:           const base64 = Buffer.from(response.data).toString("base64");
1415:           const base64Url = `data:${contentType};base64,${base64}`;
1416:           images.push({ original: imgUrl, base64: base64Url });
1417:         } catch (imgError) {
1418:           const errorMessage =
1419:             imgError instanceof Error ? imgError.message : String(imgError);
1420:           console.warn(
1421:             `[DOCX Export] Failed to convert image ${imgUrl}:`,
1422:             errorMessage
1423:           );
1424:           // Keep the original URL as fallback (might not work in DOCX but won't break)
1425:         }
1426:       }
1427:       // Replace all original URLs with base64 versions
1428:       for (const img of images) {
1429:         processedContent = processedContent.replaceAll(
1430:           img.original,
1431:           img.base64
1432:         );
1433:       }
1434:       console.log(`[DOCX Export] Converted ${images.length} images to base64`);
1435:     } catch (error) {
1436:       console.warn("[DOCX Export] Error processing images:", error);
1437:     }
1438:     const htmlContent = `
1439:       <!DOCTYPE html>
1440:       <html>
1441:       <head>
1442:         <meta charset="UTF-8">
1443:         <title>${paper.title}</title>
