  1: import prisma from "../../shared/prisma";
  2: import { aiService } from "../AI/ai.service";
  3: export interface SuggestedCollection {
  4:   name: string;
  5:   description: string;
  6:   paperCount: number;
  7:   topics: string[];
  8:   relevanceScore: number;
  9: }
 10: export interface SuggestedPaper {
 11:   id: string;
 12:   title: string;
 13:   authors: string[];
 14:   year: number;
 15:   abstract: string;
 16:   reason: string;
 17:   similarity: number;
 18:   tags: string[];
 19: }
 20: export interface RecommendedPaper {
 21:   id: string;
 22:   title: string;
 23:   authors: string[];
 24:   year: number;
 25:   topic: string;
 26:   citationCount: number;
 27: }
 28: export class RecommendationService {
 29:   static async getSuggestedCollections(userId: string, limit = 5): Promise<SuggestedCollection[]> {
 30:     const userPapers = await prisma.$queryRaw<Array<{ title: string; tags: string[]; abstract: string | null }>>`
 31:       SELECT p.title, p.tags, p.abstract
 32:       FROM "Paper" p
 33:       WHERE p."uploaderId" = ${userId} AND p."isDeleted" = false
 34:       ORDER BY p."createdAt" DESC
 35:       LIMIT 50
 36:     `;
 37:     if (!userPapers.length) {
 38:       return [];
 39:     }
 40:     try {
 41:       const titles = userPapers.map((p) => p.title).filter(Boolean);
 42:       const tags = [...new Set(userPapers.flatMap((p) => p.tags || []))].slice(0, 20);
 43:       const prompt = [
 44:         "You are a research librarian. Given these paper titles and tags, suggest",
 45:         `${limit} logical collection groupings. Return ONLY a JSON array of objects`,
 46:         'with keys: name, description, topics (array of strings), relevanceScore (0-100).',
 47:         "",
 48:         "Paper titles:",
 49:         ...titles.map((t, i) => `${i + 1}. ${t}`),
 50:         "",
 51:         tags.length ? `Existing tags: ${tags.join(", ")}` : "",
 52:       ].join("\n");
 53:       const result = await aiService.generateSummary({
 54:         paperId: userId,
 55:         text: prompt,
 56:         instructions: "Group these papers into logical collections",
 57:         wordLimit: 300,
 58:         workspaceId: null as any,
 59:         uploaderId: userId,
 60:       });
 61:       const jsonMatch = result.summary.match(/\[[\s\S]*\]/);
 62:       if (jsonMatch) {
 63:         const parsed = JSON.parse(jsonMatch[0]) as SuggestedCollection[];
 64:         return parsed.slice(0, limit);
 65:       }
 66:     } catch (e) {
 67:     }
 68:     return tagBasedClustering(userPapers, limit);
 69:   }
 70:   static async getCollectionSuggestions(
 71:     collectionId: string,
 72:     userId: string,
 73:     limit = 5
 74:   ): Promise<SuggestedPaper[]> {
 75:     const collectionPapers = await prisma.$queryRaw<
 76:       Array<{ id: string; title: string; tags: string[]; abstract: string | null }>
 77:     >`
 78:       SELECT p.id, p.title, p.tags, p.abstract
 79:       FROM "CollectionPaper" cp
 80:       JOIN "Paper" p ON p.id = cp."paperId"
 81:       WHERE cp."collectionId" = ${collectionId}
 82:         AND cp."isDeleted" = false AND p."isDeleted" = false
 83:       LIMIT 30
 84:     `;
 85:     if (!collectionPapers.length) {
 86:       return [];
 87:     }
 88:     const collectionTags = [...new Set(collectionPapers.flatMap((p) => p.tags || []))];
 89:     const userPapers = await prisma.$queryRaw<
 90:       Array<{ id: string; title: string; tags: string[]; abstract: string | null; year: number }>
 91:     >`
 92:       SELECT p.id, p.title, p.tags, p.abstract,
 93:              COALESCE((p.metadata->>'year')::int, 2024) as year
 94:       FROM "Paper" p
 95:       WHERE p."uploaderId" = ${userId}
 96:         AND p."isDeleted" = false
 97:         AND p.id NOT IN (
 98:           SELECT "paperId" FROM "CollectionPaper"
 99:           WHERE "collectionId" = ${collectionId} AND "isDeleted" = false
100:         )
101:       ORDER BY p."createdAt" DESC
102:       LIMIT 50
103:     `;
104:     if (!userPapers.length) {
105:       return [];
106:     }
107:     return userPapers
108:       .map((paper) => {
109:         const paperTags = (paper.tags || []).map((t) => t.toLowerCase());
110:         const overlap = collectionTags.filter((ct) =>
111:           paperTags.includes(ct.toLowerCase())
112:         );
113:         return {
114:           id: paper.id,
115:           title: paper.title,
116:           authors: [],
117:           year: paper.year || 2024,
118:           abstract: paper.abstract || "",
119:           reason: overlap.length > 0
120:             ? `Shares tags: ${overlap.slice(0, 3).join(", ")}`
121:             : "In your library",
122:           similarity: Math.min(100, overlap.length * 25 + 5),
123:           tags: paper.tags || [],
124:         };
125:       })
126:       .sort((a, b) => b.similarity - a.similarity)
127:       .slice(0, limit);
128:   }
129:   static async getRecommendedPapers(userId: string, topics?: string[], limit = 10): Promise<RecommendedPaper[]> {
130:     const userPapers = await prisma.$queryRaw<
131:       Array<{ id: string; title: string; tags: string[]; year: number; citationCount: number }>
132:     >`
133:       SELECT p.id, p.title, p.tags,
134:              COALESCE((p.metadata->>'year')::int, 2024) as year,
135:              p."citationCount"
136:       FROM "Paper" p
137:       WHERE p."uploaderId" = ${userId} AND p."isDeleted" = false
138:       ORDER BY p."createdAt" DESC
139:       LIMIT 100
140:     `;
141:     if (!topics || !topics.length) {
142:       return userPapers.slice(0, limit).map((p) => ({
143:         id: p.id,
144:         title: p.title,
145:         authors: [],
146:         year: p.year,
147:         topic: (p.tags || [])[0] || "General",
148:         citationCount: p.citationCount || 0,
149:       }));
150:     }
151:     const scored = userPapers
152:       .map((paper) => {
153:         const paperTags = (paper.tags || []).map((t) => t.toLowerCase());
154:         const topicLower = topics.map((t) => t.toLowerCase());
155:         const matchCount = topicLower.filter((t) =>
156:           paperTags.some((pt) => pt.includes(t) || t.includes(pt))
157:         ).length;
158:         const bestTopic = topics.find(
159:           (t) =>
160:             paperTags.includes(t.toLowerCase()) ||
161:             paper.title.toLowerCase().includes(t.toLowerCase())
162:         ) || topics[0];
163:         return {
164:           id: paper.id,
165:           title: paper.title,
166:           authors: [],
167:           year: paper.year,
168:           topic: bestTopic,
169:           citationCount: paper.citationCount || 0,
170:           _score: matchCount,
171:         };
172:       })
173:       .sort((a, b) => b._score - a._score);
174:     return scored.slice(0, limit);
175:   }
176: }
177: function tagBasedClustering(
178:   papers: Array<{ title: string; tags: string[]; abstract: string | null }>,
179:   limit: number
180: ): SuggestedCollection[] {
181:   const tagFreq = new Map<string, number>();
182:   for (const p of papers) {
183:     for (const t of p.tags || []) {
184:       tagFreq.set(t, (tagFreq.get(t) || 0) + 1);
185:     }
186:   }
187:   const topTags = [...tagFreq.entries()]
188:     .sort((a, b) => b[1] - a[1])
189:     .slice(0, limit * 2);
190:   const groups = new Map<string, { titles: string[]; count: number }>();
191:   for (const p of papers) {
192:     const pTags = (p.tags || []).map((t) => t.toLowerCase());
193:     for (const [tag] of topTags) {
194:       if (pTags.includes(tag.toLowerCase())) {
195:         const g = groups.get(tag) || { titles: [], count: 0 };
196:         g.titles.push(p.title);
197:         g.count++;
198:         groups.set(tag, g);
199:       }
200:     }
201:   }
202:   return topTags.slice(0, limit).map(([tag, freq]) => {
203:     const g = groups.get(tag);
204:     return {
205:       name: `${tag} Papers`,
206:       description: `Curated collection of papers related to ${tag}`,
207:       paperCount: g?.count || 0,
208:       topics: [tag],
209:       relevanceScore: Math.min(100, freq * 10),
210:     };
211:   });
212: }
213: export const recommendationService = {
214:   getSuggestedCollections: RecommendationService.getSuggestedCollections,
215:   getCollectionSuggestions: RecommendationService.getCollectionSuggestions,
216:   getRecommendedPapers: RecommendationService.getRecommendedPapers,
217: };
</file>

