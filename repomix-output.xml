 74:         setIsProcessing(true);
 75:         localStorage.setItem(processedCodeKey, Date.now().toString());
 76:         const fiveMinutesAgo = Date.now() - 5 * 60 * 1000;
 77:         Object.keys(localStorage).forEach((key) => {
 78:           if (key.startsWith("oauth_processed_")) {
 79:             const timestamp = parseInt(localStorage.getItem(key) || "0");
 80:             if (timestamp < fiveMinutesAgo) {
 81:               localStorage.removeItem(key);
 82:             }
 83:           }
 84:         });
 85:         showLoadingToast("Completing GitHub sign-in...");
 86:         const result = await completeOAuthSignIn("github", code, dispatch);
 87:         if (!result.success) {
 88:           setError(result.error || "GitHub authentication failed");
 89:           showAuthErrorToast(result.error || "Authentication failed");
 90:           timeoutRef.current = setTimeout(() => router.push("/login"), 2000);
 91:           return;
 92:         }
 93:         showAuthSuccessToast("Successfully signed in with GitHub!");
 94:         await new Promise((resolve) => setTimeout(resolve, 300));
 95:         const callbackUrl = state ? decodeURIComponent(state) : "/dashboard";
 96:         const redirectTo = result.user?.onboardingCompleted
 97:           ? callbackUrl
 98:           : "/onboarding";
 99:         window.location.href = redirectTo;
100:       } finally {
101:         if (lockAcquired) {
102:           releaseGlobalLock();
103:         }
104:       }
105:     };
106:     handleCallback();
107:     return () => {
108:       if (timeoutRef.current) {
109:         clearTimeout(timeoutRef.current);
110:       }
111:       if (lockAcquired) {
112:         releaseGlobalLock();
113:       }
114:     };
115:   }, [router, dispatch, searchParams, redirectToLogin]);
116:   if (error) {
117:     return (
118:       <div className="min-h-screen flex items-center justify-center">
119:         <div className="text-center">
