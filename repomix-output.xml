342:       FROM "Workspace" w
343:       LEFT JOIN "WorkspaceMember" m ON m."workspaceId" = w.id AND m."userId" = ${inviterId} AND m."isDeleted" = false
344:       WHERE w.id = ${workspaceId} AND w."isDeleted" = false
345:     `;
346:     const ws = workspace[0];
347:     if (!ws) throw new ApiError(404, "Workspace not found");
348:     const isOwner = ws.ownerId === inviterId;
349:     const isOwnerOrManager = ["OWNER", "MANAGER"].includes(ws.inviterRole);
350:     if (!isOwner && !isOwnerOrManager) {
351:       throw new ApiError(
352:         403,
353:         "Only workspace owners and managers can invite members"
354:       );
355:     }
356:     // Find user by email
357:     const user = await prisma.$queryRaw<any[]>`
358:       SELECT id, email, name FROM "User" WHERE email = ${payload.email} AND "isDeleted" = false
359:     `;
360:     if (!user[0]) {
361:       throw new ApiError(404, "User with this email does not exist");
362:     }
363:     const targetUser = user[0];
364:     // Prevent inviting self
365:     if (targetUser.id === inviterId) {
366:       throw new ApiError(400, "You cannot invite yourself");
367:     }
368:     // Check if user is already a member
369:     const existingMember = await prisma.$queryRaw<any[]>`
370:       SELECT id FROM "WorkspaceMember"
371:       WHERE "workspaceId" = ${workspaceId} AND "userId" = ${targetUser.id} AND "isDeleted" = false
372:     `;
373:     if (existingMember[0]) {
