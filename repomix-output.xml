1125:   async getUserInsightThreads(
1126:     paperId: string,
1127:     userId: string
1128:   ): Promise<
1129:     Array<{
1130:       id: string;
1131:       paperId: string;
1132:       userId: string;
1133:       createdAt: Date;
1134:       updatedAt: Date;
1135:       _count?: { messages: number };
1136:       messages?: InsightMessageRecord[];
1137:     }>
1138:   > {
1139:     const rows = await prisma.$queryRaw<
1140:       Array<{
1141:         id: string;
1142:         paperId: string;
1143:         userId: string;
1144:         createdAt: Date;
1145:         updatedAt: Date;
1146:         messageCount: bigint;
1147:       }>
1148:     >`
1149:       SELECT
1150:         t.id,
1151:         t."paperId",
1152:         t."userId",
1153:         t."createdAt",
1154:         t."updatedAt",
1155:         COUNT(m.id) as "messageCount"
1156:       FROM "AIInsightThread" t
1157:       LEFT JOIN "AIInsightMessage" m ON t.id = m."threadId" AND m."isDeleted" = false
1158:       WHERE t."paperId" = ${paperId}
1159:         AND t."userId" = ${userId}
1160:         AND t."isDeleted" = false
1161:       GROUP BY t.id, t."paperId", t."userId", t."createdAt", t."updatedAt"
1162:       ORDER BY t."updatedAt" DESC
1163:     `;
1164:     const threadIds = rows.map((row) => row.id);
1165:     // Single query for the latest messages of ALL threads (avoids N+1)
1166:     const recentRows = threadIds.length
1167:       ? await prisma.$queryRaw<
1168:           Array<{
1169:             id: string;
1170:             threadId: string;
1171:             paperId: string;
1172:             role: string;
1173:             content: string;
1174:             metadata: unknown;
1175:             createdAt: Date;
1176:             createdById: string | null;
1177:           }>
1178:         >`
1179:           SELECT m.id, m."threadId", m."paperId", m.role, m.content, m.metadata, m."createdAt", m."createdById"
1180:           FROM (
1181:             SELECT m2.*,
1182:               ROW_NUMBER() OVER (PARTITION BY m2."threadId" ORDER BY m2."createdAt" DESC) AS rn
1183:             FROM "AIInsightMessage" m2
1184:             WHERE m2."isDeleted" = false
1185:               AND m2."threadId" = ANY(${threadIds})
1186:           ) m
1187:           WHERE m.rn <= 10
1188:           ORDER BY m."threadId" ASC, m."createdAt" ASC
1189:         `
1190:       : [];
1191:     const messagesByThreadId = new Map<string, InsightMessageRecord[]>();
1192:     for (const row of recentRows) {
1193:       const list = messagesByThreadId.get(row.threadId) ?? [];
1194:       list.push({
1195:         id: row.id,
1196:         threadId: row.threadId,
1197:         paperId: row.paperId,
1198:         role: row.role,
1199:         content: row.content,
1200:         metadata: normalizeInsightMetadata(row.metadata),
1201:         createdAt: row.createdAt,
1202:         createdById: row.createdById,
1203:       });
1204:       messagesByThreadId.set(row.threadId, list);
1205:     }
1206:     return rows.map((row) => ({
1207:       id: row.id,
1208:       paperId: row.paperId,
1209:       userId: row.userId,
1210:       createdAt: row.createdAt,
1211:       updatedAt: row.updatedAt,
1212:       _count: { messages: Number(row.messageCount) },
1213:       messages: messagesByThreadId.get(row.id) ?? [],
1214:     }));
1215:   },
