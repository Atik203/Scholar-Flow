  1: import { AiError } from "../ai.errors";
  2: import { BaseAiProvider } from "../ai.provider";
  3: import {
  4:   AiInsightRequest,
  5:   AiInsightResult,
  6:   AiMetadataExtractionInput,
  7:   AiMetadataExtractionResult,
  8:   AiSummaryRequest,
  9:   AiSummaryResult,
 10: } from "../ai.types";
 11: const DEFAULT_MODEL = "gemini-2.5-flash-lite";
 12: const FREE_MODELS = [
 13:   "gemini-2.5-flash-lite",
 14:   "gemini-2.5-flash",
 15: ];
 16: const isValidGeminiModel = (model: string): boolean => {
 17:   return FREE_MODELS.includes(model);
 18: };
 19: const normalizeList = (value: unknown, maxItems = 5): string[] | undefined => {
 20:   if (Array.isArray(value)) {
 21:     const normalized = value
 22:       .map((entry) =>
 23:         typeof entry === "string" ? entry.trim() : String(entry || "").trim()
 24:       )
 25:       .filter((entry) => Boolean(entry));
 26:     return normalized.length
 27:       ? normalized.slice(0, maxItems).map((entry) => entry.slice(0, 280))
 28:       : undefined;
 29:   }
 30:   if (typeof value === "string" && value.trim()) {
 31:     const parts = value
 32:       .split(/\n|\r|,|;|\u2022/g)
 33:       .map((entry) => entry.trim())
 34:       .filter((entry) => entry.length > 0);
 35:     return parts.length
 36:       ? parts.slice(0, maxItems).map((entry) => entry.slice(0, 280))
 37:       : undefined;
 38:   }
 39:   return undefined;
 40: };
 41: const stripJsonFences = (value: string): string => {
 42:   const trimmed = value.trim();
 43:   if (trimmed.startsWith("```") && trimmed.endsWith("```")) {
 44:     return trimmed
 45:       .replace(/^```[a-zA-Z]*\s*/, "")
 46:       .replace(/```$/, "")
 47:       .trim();
 48:   }
 49:   return trimmed;
 50: };
 51: export class GeminiProvider extends BaseAiProvider {
 52:   constructor(apiKey: string | undefined, requestTimeoutMs: number) {
 53:     const normalizedKey = apiKey?.trim();
 54:     super("gemini", normalizedKey, requestTimeoutMs);
 55:   }
 56:   protected async performInsight(
 57:     input: AiInsightRequest
 58:   ): Promise<AiInsightResult> {
 59:     if (!this.apiKey) {
 60:       throw new AiError(
 61:         503,
 62:         "Gemini provider not configured",
 63:         "AI_PROVIDER_DISABLED"
 64:       );
 65:     }
 66:     try {
 67:       const model = isValidGeminiModel(input.model || DEFAULT_MODEL)
 68:         ? input.model || DEFAULT_MODEL
 69:         : DEFAULT_MODEL;
 70:       const instructions =
 71:         "You are a senior research mentor helping a scholar interpret and apply insights from a paper. Provide clear, structured answers in natural conversational style. Be helpful, insightful, and provide actionable takeaways when relevant. Respond directly and naturally - do not use JSON format.";
 72:       const historyText = Array.isArray(input.history)
 73:         ? input.history
 74:             .map(
 75:               (msg) =>
 76:                 `${msg.role === "assistant" ? "Assistant" : "User"}: ${msg.content}`
 77:             )
 78:             .join("\n")
 79:         : "";
 80:       const contextBlock = input.context.trim()
 81:         ? `Paper context:\n${input.context.trim()}`
 82:         : "";
 83:       const combinedPrompt = [
 84:         instructions,
 85:         contextBlock,
 86:         historyText ? `Conversation history:\n${historyText}` : undefined,
 87:         `Current question: ${input.prompt}`,
 88:       ]
 89:         .filter(Boolean)
 90:         .join("\n\n");
 91:       const controller = new AbortController();
 92:       const timeout = setTimeout(
 93:         () => controller.abort(),
 94:         this.requestTimeoutMs
 95:       );
 96:       let response: Awaited<ReturnType<typeof fetch>>;
 97:       try {
 98:         response = await fetch(
 99:           `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${this.apiKey}`,
100:           {
101:             method: "POST",
102:             headers: {
103:               "Content-Type": "application/json",
104:             },
105:             body: JSON.stringify({
106:               contents: [
107:                 {
108:                   role: "user",
109:                   parts: [{ text: combinedPrompt }],
110:                 },
111:               ],
112:               generationConfig: {
113:                 temperature: 0.4,
114:                 maxOutputTokens: 900,
115:                 topP: 0.8,
116:                 topK: 40,
117:               },
118:             }),
119:             signal: controller.signal,
120:           }
121:         );
122:       } finally {
123:         clearTimeout(timeout);
124:       }
125:       if (!response.ok) {
126:         const errorText = await response.text();
127:         throw new Error(`Gemini API error: ${response.status} - ${errorText}`);
128:       }
129:       const data = (await response.json()) as any;
130:       const content = data.candidates?.[0]?.content?.parts?.[0]?.text || "";
131:       // Try to parse JSON response
132:       let parsed: any;
133:       try {
134:         parsed = JSON.parse(content);
135:       } catch {
136:         // If not JSON, create a structured response
137:         parsed = {
138:           answer: content,
139:           suggestions: [],
140:           tokensUsed: data.usageMetadata?.totalTokenCount || undefined,
141:         };
142:       }
143:       return {
144:         provider: this.name,
145:         message: {
146:           role: "assistant",
147:           content: parsed.answer || content,
148:         },
149:         suggestions: Array.isArray(parsed.suggestions)
150:           ? parsed.suggestions
151:           : [],
152:         rawResponse: data,
153:         tokensUsed: parsed.tokensUsed || data.usageMetadata?.totalTokenCount,
154:       };
155:     } catch (error) {
156:       if (error instanceof Error) {
157:         throw new AiError(502, error.message, "AI_PROVIDER_ERROR", error.stack);
158:       }
159:       throw new AiError(
160:         502,
161:         "Gemini insight generation failed",
162:         "AI_PROVIDER_ERROR"
163:       );
164:     }
165:   }
166:   protected async performExtraction(
167:     _input: AiMetadataExtractionInput
168:   ): Promise<AiMetadataExtractionResult> {
169:     throw new AiError(
170:       503,
171:       "Gemini metadata extraction not yet implemented",
172:       "AI_PROVIDER_UNAVAILABLE"
173:     );
174:   }
175:   protected async performSummary(
176:     input: AiSummaryRequest
177:   ): Promise<AiSummaryResult> {
178:     if (!this.apiKey) {
179:       throw new AiError(
180:         503,
181:         "Gemini provider not configured",
182:         "AI_PROVIDER_DISABLED"
183:       );
184:     }
185:     const model = DEFAULT_MODEL;
186:     const systemPrompt = `You are an expert research summarization assistant. Strictly respond with JSON matching this TypeScript type: { "summary": string; "highlights"?: string[]; "followUpQuestions"?: string[]; "tokensUsed"?: number }. The summary must stay within ${input.wordLimit ?? 220} sentences or less and focus on methodology, findings, and implications.`;
187:     const controller = new AbortController();
188:     const timeout = setTimeout(() => controller.abort(), this.requestTimeoutMs);
189:     try {
190:       let response: Awaited<ReturnType<typeof fetch>>;
191:       try {
192:         response = await fetch(
193:           `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${this.apiKey}`,
194:           {
195:             method: "POST",
196:             headers: {
197:               "Content-Type": "application/json",
198:             },
199:             body: JSON.stringify({
200:               contents: [
201:                 {
202:                   role: "user",
203:                   parts: [
204:                     {
205:                       text: [
206:                         systemPrompt,
207:                         "Paper excerpt:",
208:                         input.text,
209:                         input.instructions
210:                           ? `Additional instructions: ${input.instructions}`
211:                           : undefined,
212:                         input.focusAreas?.length
213:                           ? `Focus areas: ${input.focusAreas.join(", ")}`
214:                           : undefined,
215:                       ]
216:                         .filter(Boolean)
217:                         .join("\n\n"),
218:                     },
219:                   ],
220:                 },
221:               ],
222:               generationConfig: {
223:                 temperature: 0.4,
224:                 maxOutputTokens: 900,
225:                 topP: 0.9,
226:                 topK: 64,
227:               },
228:             }),
229:             signal: controller.signal,
230:           }
231:         );
232:       } finally {
233:         clearTimeout(timeout);
234:       }
235:       if (!response.ok) {
236:         const errorText = await response.text();
237:         throw new Error(`Gemini API error: ${response.status} - ${errorText}`);
238:       }
239:       const data = (await response.json()) as any;
240:       const parts: string[] = Array.isArray(
241:         data.candidates?.[0]?.content?.parts
242:       )
243:         ? data.candidates[0].content.parts
244:             .map((part: any) => part?.text || "")
245:             .filter((text: string) => Boolean(text))
246:         : [];
247:       const combined = stripJsonFences(parts.join("\n")).trim();
248:       if (!combined) {
249:         throw new Error("Gemini returned an empty summary response");
250:       }
251:       let parsed: any;
252:       try {
253:         parsed = JSON.parse(combined);
254:       } catch {
255:         parsed = {
256:           summary: combined,
257:           highlights: undefined,
258:           followUpQuestions: undefined,
259:         };
260:       }
261:       const summaryText =
262:         typeof parsed.summary === "string" ? parsed.summary.trim() : combined;
263:       if (!summaryText) {
264:         throw new Error(
265:           "Gemini summary payload did not include a summary field"
266:         );
267:       }
268:       const highlights = normalizeList(parsed.highlights, 6);
269:       const followUps = normalizeList(parsed.followUpQuestions, 5);
270:       const rawTokens = Number(parsed.tokensUsed);
271:       const tokenCount = Number.isFinite(rawTokens)
272:         ? rawTokens
273:         : Number(data.usageMetadata?.totalTokenCount) || undefined;
274:       return {
275:         provider: this.name,
276:         summary: summaryText,
277:         highlights: highlights && highlights.length ? highlights : undefined,
278:         followUpQuestions:
279:           followUps && followUps.length ? followUps : undefined,
280:         tokensUsed: tokenCount,
281:         rawResponse: data,
282:       };
283:     } catch (error) {
284:       if (error instanceof AiError) {
285:         throw error;
286:       }
287:       if (error instanceof Error && error.name === "AbortError") {
288:         throw new AiError(
289:           504,
290:           "Gemini summary request timed out",
291:           "AI_PROVIDER_TIMEOUT"
292:         );
293:       }
294:       if (error instanceof Error) {
295:         throw new AiError(502, error.message, "AI_PROVIDER_ERROR", error.stack);
296:       }
297:       throw new AiError(
298:         502,
299:         "Gemini summary generation failed",
300:         "AI_PROVIDER_ERROR"
301:       );
302:     }
303:   }
304: }
