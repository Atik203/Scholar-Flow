<file path="apps/backend/src/app/modules/Workspace/workspace.service.ts">
  1: import ApiError from "../../errors/ApiError";
  2: import prisma, { Prisma } from "../../shared/prisma";
  3: export class WorkspaceService {
  4:   static async listUserWorkspaces(
  5:     userId: string,
  6:     limit: number,
  7:     cursor: string | undefined,
  8:     scope: "all" | "owned" | "shared" = "all"
  9:   ) {
 10:     const whereOwned = scope === "owned";
 11:     const whereShared = scope === "shared";
 12:     const take = limit + 1;
 13:     const cursorFilter = cursor
 14:       ? Prisma.sql`AND fw."createdAt" < (SELECT "createdAt" FROM "Workspace" WHERE id = ${cursor})`
 15:       : Prisma.empty;
 16:     const rows = await prisma.$queryRaw<any[]>`
 17:       WITH filtered_workspaces AS (
 18:         SELECT w.*
 19:         FROM "Workspace" w
 20:         JOIN "WorkspaceMember" m ON m."workspaceId" = w.id AND m."isDeleted" = false
 21:         WHERE m."userId" = ${userId}
 22:           AND w."isDeleted" = false
 23:           AND (${whereOwned} = false OR w."ownerId" = ${userId})
 24:           AND (${whereShared} = false OR w."ownerId" != ${userId})
 25:       )
 26:       SELECT
 27:         fw.*,
 28:         (fw."ownerId" = ${userId})::boolean AS "isOwner",
 29:         COALESCE(member_counts.member_count, 0)::int AS "memberCount",
 30:         COALESCE(collection_counts.collection_count, 0)::int AS "collectionCount",
 31:         COALESCE(paper_counts.paper_count, 0)::int AS "paperCount"
 32:       FROM filtered_workspaces fw
 33:       LEFT JOIN (
 34:         SELECT "workspaceId", COUNT(*)::int AS member_count
 35:         FROM "WorkspaceMember"
 36:         WHERE "isDeleted" = false
 37:         GROUP BY "workspaceId"
 38:       ) member_counts ON member_counts."workspaceId" = fw.id
 39:       LEFT JOIN (
 40:         SELECT "workspaceId", COUNT(*)::int AS collection_count
 41:         FROM "Collection"
 42:         WHERE "isDeleted" = false
 43:         GROUP BY "workspaceId"
 44:       ) collection_counts ON collection_counts."workspaceId" = fw.id
 45:       LEFT JOIN (
 46:         SELECT "workspaceId", COUNT(*)::int AS paper_count
 47:         FROM "Paper"
 48:         WHERE "isDeleted" = false
 49:         GROUP BY "workspaceId"
 50:       ) paper_counts ON paper_counts."workspaceId" = fw.id
 51:       WHERE true
 52:         ${cursorFilter}
 53:       ORDER BY fw."createdAt" DESC
 54:       LIMIT ${take}
 55:     `;
 56:     const hasMore = rows.length > limit;
 57:     const sliced = hasMore ? rows.slice(0, -1) : rows;
 58:     return {
 59:       result: sliced,
 60:       meta: {
 61:         limit,
 62:         nextCursor: hasMore ? sliced[sliced.length - 1].id : null,
 63:         hasMore,
 64:       },
 65:     };
 66:   }
 67:   static async createWorkspace(
 68:     ownerId: string,
 69:     name: string,
 70:     options?: { color?: string; visibility?: string }
 71:   ) {
 72:     // Create workspace and membership in a transaction
 73:     try {
 74:       const color = options?.color && ["blue", "purple", "green", "orange", "pink"].includes(options.color) ? options.color : "blue";
 75:       const visibility = options?.visibility === "INVITE_ONLY" || options?.visibility === "PUBLIC" ? options.visibility : "PRIVATE";
 76:       const workspace = await prisma.$queryRaw<any[]>`
 77:         INSERT INTO "Workspace" (id, name, "ownerId", color, visibility, "createdAt", "updatedAt", "isDeleted")
 78:         VALUES (gen_random_uuid(), ${name}, ${ownerId}, ${color}, ${visibility}::"WorkspaceVisibility", now(), now(), false)
 79:         RETURNING *
 80:       `;
 81:       const w = workspace[0];
 82:       await prisma.$executeRaw`
 83:         INSERT INTO "WorkspaceMember" (id, "workspaceId", "userId", role, "joinedAt", "createdAt", "updatedAt", "isDeleted")
 84:         VALUES (gen_random_uuid(), ${w.id}, ${ownerId}, 'OWNER', now(), now(), now(), false)
 85:       `;
 86:       // Create default WorkspaceSettings row
 87:       await prisma.$executeRaw`
 88:         INSERT INTO "WorkspaceSettings" (id, "workspaceId", color, "createdAt", "updatedAt", "isDeleted")
 89:         VALUES (gen_random_uuid(), ${w.id}, ${color}, now(), now(), false)
 90:         ON CONFLICT ("workspaceId") DO NOTHING
 91:       `;
 92:       await prisma.$executeRaw`
 93:         INSERT INTO "ActivityLog" (id, "userId", "workspaceId", entity, "entityId", action, "createdAt", "updatedAt", "isDeleted")
 94:         VALUES (gen_random_uuid(), ${ownerId}, ${w.id}, 'Workspace', ${w.id}, 'CREATE', now(), now(), false)
 95:       `;
 96:       return w;
 97:     } catch (e) {
 98:       throw new ApiError(500, "Failed to create workspace");
 99:     }
100:   }
101:   static async getWorkspace(userId: string, id: string) {
102:     const rows = await prisma.$queryRaw<any[]>`
103:       SELECT
104:         w.*,
105:         (w."ownerId" = ${userId})::boolean AS "isOwner",
106:         COALESCE(member_counts.member_count, 0)::int AS "memberCount",
107:         COALESCE(collection_counts.collection_count, 0)::int AS "collectionCount",
108:         COALESCE(paper_counts.paper_count, 0)::int AS "paperCount"
109:       FROM "Workspace" w
110:       JOIN "WorkspaceMember" m ON m."workspaceId" = w.id AND m."isDeleted" = false
111:       LEFT JOIN (
112:         SELECT "workspaceId", COUNT(*)::int AS member_count
113:         FROM "WorkspaceMember"
114:         WHERE "isDeleted" = false
115:         GROUP BY "workspaceId"
116:       ) member_counts ON member_counts."workspaceId" = w.id
117:       LEFT JOIN (
118:         SELECT "workspaceId", COUNT(*)::int AS collection_count
119:         FROM "Collection"
120:         WHERE "isDeleted" = false
121:         GROUP BY "workspaceId"
122:       ) collection_counts ON collection_counts."workspaceId" = w.id
123:       LEFT JOIN (
124:         SELECT "workspaceId", COUNT(*)::int AS paper_count
125:         FROM "Paper"
126:         WHERE "isDeleted" = false
127:         GROUP BY "workspaceId"
128:       ) paper_counts ON paper_counts."workspaceId" = w.id
129:       WHERE w.id = ${id} AND w."isDeleted" = false AND m."userId" = ${userId}
130:       LIMIT 1
131:     `;
132:     if (!rows[0])
133:       throw new ApiError(404, "Workspace not found or access denied");
134:     return rows[0];
135:   }
136:   static async updateWorkspace(
137:     userId: string,
138:     id: string,
139:     data: { name?: string; description?: string }
140:   ) {
141:     // Ensure user is Admin/TeamLead or owner
142:     const perm = await prisma.$queryRaw<any[]>`
143:       SELECT m.role, w."ownerId"
144:       FROM "WorkspaceMember" m JOIN "Workspace" w ON w.id = m."workspaceId"
145:       WHERE m."userId" = ${userId} AND m."workspaceId" = ${id} AND m."isDeleted" = false AND w."isDeleted" = false
146:     `;
147:     const member = perm[0];
