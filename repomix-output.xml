 21:   async extractTextFromPDF(paperId: string): Promise<PDFExtractionResult> {
 22:     try {
 23:       console.log(`[PDFExtraction] Starting extraction for paper: ${paperId}`);
 24:       const paper = await prisma.paper.findUnique({
 25:         where: { id: paperId },
 26:         include: { file: true },
 27:       });
