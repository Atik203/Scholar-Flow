 7:   u.email as "uploaderEmail",
 8:   (
 9:     CASE
10:       WHEN p.title ILIKE '%' || $1 || '%' THEN 10
11:       ELSE 0
12:     END +
13:     CASE
14:       WHEN p.authors ILIKE '%' || $1 || '%' THEN 8
15:       ELSE 0
16:     END +
17:     CASE
18:       WHEN p."extractedText" ILIKE '%' || $1 || '%' THEN 5
19:       ELSE 0
20:     END
21:   ) as relevance_score
22: FROM "Paper" p
23: LEFT JOIN "User" u ON p."uploaderId" = u.id
24: WHERE
25:   p."isDeleted" = false
26:   AND (
27:     p.title ILIKE '%' || $1 || '%'
28:     OR p.authors ILIKE '%' || $1 || '%'
29:     OR p."extractedText" ILIKE '%' || $1 || '%'
30:   )
31: ORDER BY relevance_score DESC, p."createdAt" DESC;
