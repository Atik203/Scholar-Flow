 664:   /**
 665:    * Cancel (revoke) a pending workspace invitation. Only the inviter or the
 666:    * workspace owner may revoke.
 667:    */
 668:   static async cancelInvitation(requestorId: string, invitationId: string) {
 669:     const inv = await prisma.workspaceInvitation.findUnique({
 670:       where: { id: invitationId },
 671:       select: { id: true, invitedById: true, status: true, workspaceId: true },
 672:     });
 673:     if (!inv || inv.status !== "PENDING") {
 674:       throw new ApiError(404, "Pending invitation not found");
 675:     }
 676:     const ws = await prisma.workspace.findFirst({
 677:       where: { id: inv.workspaceId, isDeleted: false },
 678:       select: { ownerId: true },
 679:     });
 680:     if (inv.invitedById !== requestorId && ws?.ownerId !== requestorId) {
 681:       throw new ApiError(403, "You can only revoke invitations you sent");
 682:     }
 683:     await prisma.workspaceInvitation.update({
 684:       where: { id: invitationId },
 685:       data: { isDeleted: true, status: "DECLINED" },
 686:     });
 687:     return { success: true };
 688:   }
 689:   /**
 690:    * Resend a pending workspace invitation: bumps invitedAt + expiresAt and
 691:    * re-sends the email. Only the inviter or the workspace owner may resend.
 692:    */
 693:   static async resendInvitation(requestorId: string, invitationId: string) {
 694:     const inv = await prisma.workspaceInvitation.findUnique({
 695:       where: { id: invitationId },
 696:       select: {
 697:         id: true,
 698:         invitedById: true,
 699:         status: true,
 700:         workspaceId: true,
 701:         userId: true,
 702:         role: true,
 703:       },
 704:     });
 705:     if (!inv || inv.status !== "PENDING") {
 706:       throw new ApiError(404, "Pending invitation not found");
 707:     }
 708:     const ws = await prisma.workspace.findFirst({
 709:       where: { id: inv.workspaceId, isDeleted: false },
 710:       select: { ownerId: true, name: true },
 711:     });
 712:     if (inv.invitedById !== requestorId && ws?.ownerId !== requestorId) {
 713:       throw new ApiError(403, "You can only resend invitations you sent");
 714:     }
 715:     const expiresAt = new Date(Date.now() + INVITE_EXPIRY_MS);
 716:     await prisma.workspaceInvitation.update({
 717:       where: { id: invitationId },
 718:       data: { invitedAt: new Date(), expiresAt },
 719:     });
 720:     // Re-send email (best-effort)
 721:     try {
 722:       const emailService = (await import("../../shared/emailService")).default;
 723:       const [invitee, inviter] = await Promise.all([
 724:         prisma.user.findUnique({
 725:           where: { id: inv.userId },
 726:           select: { email: true, name: true, firstName: true, lastName: true },
 727:         }),
 728:         prisma.user.findUnique({
 729:           where: { id: requestorId },
 730:           select: { name: true, email: true },
 731:         }),
 732:       ]);
 733:       if (invitee && inviter) {
 734:         await emailService.sendWorkspaceInvitationEmail({
 735:           email: invitee.email,
 736:           name: invitee.name || invitee.email,
 737:           workspaceName: ws?.name || "Workspace",
 738:           inviterName: inviter.name || inviter.email || "A ScholarFlow user",
 739:           workspaceId: inv.workspaceId,
 740:         });
 741:       }
 742:     } catch (emailError) {
 743:       if (process.env.NODE_ENV !== "production") {
 744:         console.error("Failed to resend workspace invitation email:", emailError);
 745:       }
 746:     }
 747:     return { success: true };
 748:   }
 749:   // Get invitations sent by user
