 635:   /**
 636:    * Access gate for paper resources: uploader OR workspace owner OR active
 637:    * workspace member OR an active PaperShare row for the user's email.
 638:    * Papers without a workspace are uploader-only.
 639:    * Throws 404 (missing) / 403 (no access) — mirrors the summary-access rule
 640:    * but tolerates null/deleted workspaces (LEFT JOIN).
 641:    */
 642:   async assertPaperAccess(
 643:     paperId: string,
 644:     userId: string,
 645:     email?: string
 646:   ): Promise<void> {
 647:     const rows = await prisma.$queryRaw<
 648:       Array<{
 649:         id: string;
 650:         uploaderId: string;
 651:         workspaceId: string | null;
 652:         workspaceOwnerId: string | null;
 653:       }>
 654:     >`
 655:       SELECT
 656:         p.id,
 657:         p."uploaderId",
 658:         p."workspaceId",
 659:         w."ownerId" AS "workspaceOwnerId"
 660:       FROM "Paper" p
 661:       LEFT JOIN "Workspace" w
 662:         ON w.id = p."workspaceId" AND w."isDeleted" = false
 663:       WHERE p.id = ${paperId} AND p."isDeleted" = false
 664:       LIMIT 1
 665:     `;
 666:     const row = rows[0];
 667:     if (!row) {
 668:       throw new ApiError(404, "Paper not found");
 669:     }
 670:     if (row.uploaderId === userId || row.workspaceOwnerId === userId) {
 671:       return;
 672:     }
 673:     if (row.workspaceId) {
 674:       const membership = await prisma.$queryRaw<Array<{ exists: number }>>`
 675:         SELECT 1 as exists
 676:         FROM "WorkspaceMember"
 677:         WHERE "workspaceId" = ${row.workspaceId}
 678:           AND "userId" = ${userId}
 679:           AND "isDeleted" = false
 680:         LIMIT 1
 681:       `;
 682:       if (membership.length > 0) {
 683:         return;
 684:       }
 685:     }
 686:     if (email) {
 687:       const share = await prisma.$queryRaw<Array<{ exists: number }>>`
 688:         SELECT 1 as exists
 689:         FROM "PaperShare"
 690:         WHERE "paperId" = ${paperId}
 691:           AND email = ${email}
 692:           AND "isDeleted" = false
 693:         LIMIT 1
 694:       `;
 695:       if (share.length > 0) {
 696:         return;
 697:       }
 698:     }
 699:     throw new ApiError(403, "You do not have access to this paper");
