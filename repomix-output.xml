                  <motion.button
                    key={search.id}
                    whileHover={{ x: 4 }}
                    onClick={() => {
                      setQuery(search.query);
                      handleSearch();
                    }}
                    className="w-full flex items-center justify-between p-3 rounded-xl hover:bg-muted transition-colors text-left"
