 81:       return (
 82:         <div
 83:           key={annotation.id}
 84:           className="absolute group cursor-pointer pointer-events-auto"
 85:           style={{ left: x, top: y, width: w, height: h }}
 86:           onClick={clickHandler}
 87:         >
