 22:   open?: boolean;
 23:   onOpenChange?: (open: boolean) => void;
 24:   defaultOpen?: boolean;
 25:   children: React.ReactNode;
 26: }
 27: function Popover({
 28:   open: controlledOpen,
 29:   onOpenChange,
 30:   defaultOpen = false,
 31:   children,
 32: }: PopoverProps) {
 33:   const [uncontrolledOpen, setUncontrolledOpen] = React.useState(defaultOpen);
 34:   const isControlled = controlledOpen !== undefined;
 35:   const open = isControlled ? controlledOpen : uncontrolledOpen;
 36:   const handleOpenChange = React.useCallback(
 37:     (newOpen: boolean) => {
 38:       if (!isControlled) {
 39:         setUncontrolledOpen(newOpen);
 40:       }
 41:       onOpenChange?.(newOpen);
 42:     },
 43:     [isControlled, onOpenChange]
 44:   );
 45:   return (
 46:     <PopoverContext.Provider value={{ open, onOpenChange: handleOpenChange }}>
 47:       <div className="relative inline-block">{children}</div>
 48:     </PopoverContext.Provider>
 49:   );
 50: }
 51: interface PopoverTriggerProps {
 52:   children: React.ReactNode;
 53:   asChild?: boolean;
 54: }
 55: function PopoverTrigger({ children, asChild }: PopoverTriggerProps) {
 56:   const { open, onOpenChange } = usePopover();
 57:   const handleClick = () => onOpenChange(!open);
 58:   if (asChild && React.isValidElement(children)) {
 59:     return React.cloneElement(children as React.ReactElement<any>, {
 60:       onClick: (e: React.MouseEvent) => {
 61:         (children as React.ReactElement<any>).props?.onClick?.(e);
 62:         handleClick();
 63:       },
 64:       "aria-expanded": open,
 65:     });
 66:   }
 67:   return (
 68:     <button type="button" onClick={handleClick} aria-expanded={open}>
 69:       {children}
 70:     </button>
 71:   );
 72: }
 73: interface PopoverContentProps extends React.HTMLAttributes<HTMLDivElement> {
 74:   children: React.ReactNode;
 75:   align?: "start" | "center" | "end";
 76:   side?: "top" | "bottom" | "left" | "right";
 77:   sideOffset?: number;
 78: }
 79: function PopoverContent({
 80:   children,
 81:   className,
 82:   align = "center",
 83:   side = "bottom",
 84:   sideOffset = 4,
