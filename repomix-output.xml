 69: export function focusNextNode(editor: Editor) {
 70:   const { state, view } = editor;
 71:   const { doc, selection } = state;
 72:   const nextSel = Selection.findFrom(selection.$to, 1, true);
 73:   if (nextSel) {
 74:     view.dispatch(state.tr.setSelection(nextSel).scrollIntoView());
 75:     return true;
 76:   }
 77:   const paragraphType = state.schema.nodes.paragraph;
 78:   if (!paragraphType) {
 79:     console.warn("No paragraph node type found in schema.");
 80:     return false;
 81:   }
 82:   const end = doc.content.size;
 83:   const para = paragraphType.create();
 84:   let tr = state.tr.insert(end, para);
 85:   const $inside = tr.doc.resolve(end + 1);
 86:   tr = tr.setSelection(TextSelection.near($inside)).scrollIntoView();
 87:   view.dispatch(tr);
 88:   return true;
