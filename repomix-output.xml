  1: import os from "os";
  2: import AppError from "../../errors/AppError";
  3: import prisma from "../../shared/prisma";
  4: import { ADMIN_ERROR_MESSAGES } from "./admin.constant";
  5: import {
  6:   IAdminFilters,
  7:   IPaperStats,
  8:   IRecentUser,
  9:   IRoleDistribution,
 10:   ISystemHealth,
 11:   ISystemMetrics,
 12:   ISystemStats,
 13:   IUserGrowthData,
 14: } from "./admin.interface";
 15: class AdminService {
 16:   async getSystemStats(): Promise<ISystemStats> {
 17:     try {
 18:       const now = new Date();
 19:       const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
 20:       const sixtyDaysAgo = new Date(now.getTime() - 60 * 24 * 60 * 60 * 1000);
 21:       const statsResults = await prisma.$queryRaw<
 22:         Array<{
 23:           totalUsers: number;
 24:           totalPapers: number;
 25:           activeSessions: number;
 26:           totalStorageBytes: number;
 27:           newUsersLast30Days: number;
 28:           newUsersPrevious30Days: number;
 29:           newPapersLast30Days: number;
 30:           newPapersPrevious30Days: number;
 31:           storageAddedLast30Days: number;
 32:           storageAddedPrevious30Days: number;
 33:         }>
 34:       >`
 35:         SELECT
 36:           (SELECT COUNT(*)::int FROM "User" WHERE "isDeleted" = false) as "totalUsers",
 37:           (SELECT COUNT(*)::int FROM "Paper" WHERE "isDeleted" = false) as "totalPapers",
 38:           (SELECT COUNT(*)::int FROM "Session" WHERE expires > ${now}) as "activeSessions",
 39:           (SELECT COALESCE(SUM("sizeBytes")::bigint, 0) FROM "PaperFile" WHERE "isDeleted" = false) as "totalStorageBytes",
 40:           (SELECT COUNT(*)::int FROM "User" WHERE "createdAt" >= ${thirtyDaysAgo} AND "isDeleted" = false) as "newUsersLast30Days",
 41:           (SELECT COUNT(*)::int FROM "User" WHERE "createdAt" >= ${sixtyDaysAgo} AND "createdAt" < ${thirtyDaysAgo} AND "isDeleted" = false) as "newUsersPrevious30Days",
 42:           (SELECT COUNT(*)::int FROM "Paper" WHERE "createdAt" >= ${thirtyDaysAgo} AND "isDeleted" = false) as "newPapersLast30Days",
 43:           (SELECT COUNT(*)::int FROM "Paper" WHERE "createdAt" >= ${sixtyDaysAgo} AND "createdAt" < ${thirtyDaysAgo} AND "isDeleted" = false) as "newPapersPrevious30Days",
 44:           (
 45:             SELECT COALESCE(SUM(pf."sizeBytes")::bigint, 0)
 46:             FROM "PaperFile" pf
 47:             INNER JOIN "Paper" p ON pf."paperId" = p.id
 48:             WHERE pf."isDeleted" = false
 49:               AND p."createdAt" >= ${thirtyDaysAgo}
 50:               AND p."isDeleted" = false
 51:           ) as "storageAddedLast30Days",
 52:           (
 53:             SELECT COALESCE(SUM(pf."sizeBytes")::bigint, 0)
 54:             FROM "PaperFile" pf
 55:             INNER JOIN "Paper" p ON pf."paperId" = p.id
 56:             WHERE pf."isDeleted" = false
 57:               AND p."createdAt" >= ${sixtyDaysAgo}
 58:               AND p."createdAt" < ${thirtyDaysAgo}
 59:               AND p."isDeleted" = false
 60:           ) as "storageAddedPrevious30Days"
 61:       `;
 62:       const stats = statsResults[0];
 63:       const totalUsers = stats.totalUsers;
 64:       const totalPapers = stats.totalPapers;
 65:       const activeSessions = stats.activeSessions;
 66:       const totalStorageBytes = Number(stats.totalStorageBytes);
 67:       const newUsersLast30Days = stats.newUsersLast30Days;
 68:       const newUsersPrevious30Days = stats.newUsersPrevious30Days;
 69:       const newPapersLast30Days = stats.newPapersLast30Days;
 70:       const newPapersPrevious30Days = stats.newPapersPrevious30Days;
 71:       const storageAddedLast30Days = Number(stats.storageAddedLast30Days);
 72:       const storageAddedPrevious30Days = Number(
 73:         stats.storageAddedPrevious30Days
 74:       );
 75:       const userGrowthPercent = this.calculateGrowthPercentage(
 76:         newUsersLast30Days,
 77:         newUsersPrevious30Days
 78:       );
 79:       const paperGrowthPercent = this.calculateGrowthPercentage(
 80:         newPapersLast30Days,
 81:         newPapersPrevious30Days
 82:       );
 83:       const sessionGrowthPercent = this.calculateGrowthPercentage(
 84:         activeSessions,
 85:         Math.max(1, Math.floor(activeSessions * 0.95))
 86:       );
 87:       const storageGrowthPercent = this.calculateGrowthPercentage(
 88:         storageAddedLast30Days,
 89:         storageAddedPrevious30Days
 90:       );
 91:       return {
 92:         totalUsers,
 93:         totalPapers,
 94:         activeSessions,
 95:         storageUsed: this.formatBytes(totalStorageBytes),
 96:         userGrowth: {
 97:           count: newUsersLast30Days,
 98:           percentageChange: userGrowthPercent,
 99:         },
100:         paperGrowth: {
101:           count: newPapersLast30Days,
102:           percentageChange: paperGrowthPercent,
103:         },
104:         sessionGrowth: {
105:           count: activeSessions,
106:           percentageChange: sessionGrowthPercent,
107:         },
108:         storageGrowth: {
109:           amount: this.formatBytes(storageAddedLast30Days),
110:           percentageChange: storageGrowthPercent,
111:         },
112:       };
113:     } catch (error) {
114:       console.error("Error fetching system stats:", error);
115:       throw new AppError(500, ADMIN_ERROR_MESSAGES.STATS_FETCH_FAILED);
116:     }
117:   }
118:   async getRecentUsers(filters: IAdminFilters): Promise<{
119:     users: IRecentUser[];
120:     total: number;
121:     page: number;
122:     totalPages: number;
123:   }> {
124:     try {
125:       const page = filters.page || 1;
126:       const limit = filters.limit || 10;
127:       const offset = (page - 1) * limit;
128:       const totalCount = await prisma.$queryRaw<Array<{ count: number }>>`
129:         SELECT COUNT(*)::int as count FROM "User" WHERE "isDeleted" = false
130:       `;
131:       const total = totalCount[0].count;
132:       const users = await prisma.$queryRaw<
133:         Array<{
134:           id: string;
135:           name: string | null;
136:           email: string;
137:           role: string;
138:           emailVerified: Date | null;
139:           createdAt: Date;
140:           lastLogin: Date | null;
141:           paperCount: number;
142:           workspaceCount: number;
143:         }>
144:       >`
145:         SELECT
146:           u.id,
147:           u.name,
148:           u.email,
149:           u.role,
150:           u."emailVerified",
151:           u."createdAt",
152:           (
153:             SELECT MAX(s."createdAt")
154:             FROM "Session" s
155:             WHERE s."userId" = u.id
156:           ) as "lastLogin",
157:           (
158:             SELECT COUNT(*)::int
159:             FROM "Paper" p
160:             WHERE p."uploaderId" = u.id
161:             AND p."isDeleted" = false
162:           ) as "paperCount",
163:           (
164:             SELECT COUNT(DISTINCT wm."workspaceId")::int
165:             FROM "WorkspaceMember" wm
166:             WHERE wm."userId" = u.id
167:           ) as "workspaceCount"
168:         FROM "User" u
169:         WHERE u."isDeleted" = false
170:         ORDER BY u."createdAt" DESC
171:         LIMIT ${limit}
172:         OFFSET ${offset}
173:       `;
174:       const formattedUsers: IRecentUser[] = users.map((user) => ({
175:         ...user,
176:         paperCount: user.paperCount,
177:         workspaceCount: user.workspaceCount,
178:       }));
179:       return {
180:         users: formattedUsers,
181:         total,
182:         page,
183:         totalPages: Math.ceil(total / limit),
184:       };
185:     } catch (error) {
186:       console.error("Error fetching recent users:", error);
187:       throw new AppError(500, ADMIN_ERROR_MESSAGES.USERS_FETCH_FAILED);
188:     }
189:   }
190:   async getUserGrowthData(): Promise<IUserGrowthData[]> {
191:     try {
192:       const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
193:       const users = await prisma.$queryRaw<Array<{ createdAt: Date }>>`
194:         SELECT "createdAt"
195:         FROM "User"
196:         WHERE "createdAt" >= ${thirtyDaysAgo}
197:           AND "isDeleted" = false
198:         ORDER BY "createdAt" ASC
199:       `;
200:       const groupedByDate = new Map<string, number>();
201:       users.forEach((user) => {
202:         const date = user.createdAt.toISOString().split("T")[0];
203:         groupedByDate.set(date, (groupedByDate.get(date) || 0) + 1);
204:       });
205:       let cumulativeTotal = 0;
206:       const growthData: IUserGrowthData[] = [];
207:       groupedByDate.forEach((newUsers, date) => {
208:         cumulativeTotal += newUsers;
209:         growthData.push({
210:           date,
211:           totalUsers: cumulativeTotal,
212:           newUsers,
213:           activeUsers: Math.floor(newUsers * 0.8),
214:         });
215:       });
216:       return growthData;
217:     } catch (error) {
218:       console.error("Error fetching growth data:", error);
219:       throw new AppError(500, ADMIN_ERROR_MESSAGES.GROWTH_DATA_FAILED);
220:     }
221:   }
222:   async getRoleDistribution(): Promise<IRoleDistribution[]> {
223:     try {
224:       const roleStats = await prisma.$queryRaw<
225:         Array<{ role: string; count: number }>
226:       >`
227:         SELECT
228:           role,
229:           COUNT(*)::int as count
230:         FROM "User"
231:         WHERE "isDeleted" = false
232:         GROUP BY role
233:       `;
234:       const total = roleStats.reduce((sum, stat) => sum + stat.count, 0);
235:       const distribution: IRoleDistribution[] = roleStats.map((stat) => ({
236:         role: stat.role,
237:         count: stat.count,
238:         percentage: Math.round((stat.count / total) * 100),
239:       }));
240:       return distribution.sort((a, b) => b.count - a.count);
241:     } catch (error) {
242:       console.error("Error fetching role distribution:", error);
243:       throw new AppError(500, ADMIN_ERROR_MESSAGES.STATS_FETCH_FAILED);
244:     }
245:   }
246:   async getPaperStats(): Promise<IPaperStats> {
247:     try {
248:       const paperStatsResult = await prisma.$queryRaw<
249:         Array<{
250:           totalPapers: number;
251:           processingPapers: number;
252:           completedPapers: number;
253:           failedPapers: number;
254:           avgProcessingTimeSeconds: number | null;
255:         }>
256:       >`
