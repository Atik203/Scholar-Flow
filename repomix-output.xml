417:     }
418:     return { invitationId: invitationResult[0]?.id };
419:   }
420:   // Accept workspace invitation
421:   static async acceptInvitation(userId: string, workspaceId: string) {
422:     const invitation = await prisma.$queryRaw<any[]>`
423:       SELECT wi.id, wi.role, wi.status
424:       FROM "WorkspaceInvitation" wi
425:       WHERE wi."workspaceId" = ${workspaceId} AND wi."userId" = ${userId} AND wi."isDeleted" = false
426:     `;
427:     if (!invitation[0]) {
428:       throw new ApiError(404, "Invitation not found");
429:     }
