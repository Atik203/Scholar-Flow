 1: "use client";
 2: import { createPersistor, makeStore, type AppStore } from "@/redux/store";
 3: import { setAppPersistor, setAppStore } from "@/redux/storeAccess";
 4: import { ReactNode, useRef } from "react";
 5: import { Provider } from "react-redux";
 6: import type { Persistor } from "redux-persist";
 7: import { PersistGate } from "redux-persist/integration/react";
 8: interface ReduxProviderProps {
 9:   children: ReactNode;
10: }
11: export function ReduxProvider({ children }: ReduxProviderProps) {
12:   const storeRef = useRef<AppStore | undefined>(undefined);
13:   const persistorRef = useRef<Persistor | undefined>(undefined);
14:   if (!storeRef.current) {
15:     storeRef.current = makeStore();
16:     persistorRef.current = createPersistor(storeRef.current);
17:     setAppStore(storeRef.current);
18:     setAppPersistor(persistorRef.current);
19:   }
20:   return (
21:     <Provider store={storeRef.current}>
22:       <PersistGate loading={null} persistor={persistorRef.current!}>
23:         {children}
24:       </PersistGate>
25:     </Provider>
26:   );
27: }
