"use client";

/**
 * HelpCenterPage - User Support and Documentation
 *
 * Enhanced with:
 * - AI chatbot integration with floating widget
 * - Interactive tutorials with step-by-step guides
 * - Video walkthroughs with playback controls
 * - Community forum links
 */

import {
  BookOpen,
  Bot,
  ChevronDown,
  ChevronRight,
  Clock,
  CreditCard,
  ExternalLink,
  FileText,
