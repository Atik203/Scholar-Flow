637:       if (payload.compactMode !== undefined) {
638:         sets.push(`"compactMode" = $${idx++}`);
639:         params.push(payload.compactMode);
640:       }
641:       if (payload.metadata !== undefined) {
642:         sets.push(`metadata = $${idx++}::jsonb`);
643:         params.push(JSON.stringify(payload.metadata));
644:       }
645:       if (sets.length > 0) {
