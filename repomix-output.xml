 86:       case "INK":
 87:         return "Add a description of your drawing (optional)...";
 88:       default:
 89:         return "Add your annotation...";
 90:     }
 91:   };
 92:   const getTitle = (type: AnnotationType) => {
 93:     switch (type) {
 94:       case "HIGHLIGHT":
 95:         return "Highlight";
 96:       case "UNDERLINE":
 97:         return "Underline";
 98:       case "STRIKETHROUGH":
 99:         return "Strikethrough";
100:       case "AREA":
101:         return "Area Selection";
102:       case "COMMENT":
103:         return "Comment";
104:       case "NOTE":
105:         return "Note";
106:       case "INK":
107:         return "Ink Drawing";
108:       default:
109:         return "Annotation";
