  1: import { NextFunction, Request, Response } from "express";
  2: import jwt from "jsonwebtoken";
  3: import ApiError from "../errors/ApiError";
  4: import { IAuthUser } from "../interfaces/common";
  5: import {
  6:   AUTH_ERROR_MESSAGES,
  7:   ROLE_HIERARCHY,
  8:   USER_ROLES,
  9: } from "../modules/Auth/auth.constant";
 10: import prisma from "../shared/prisma";
 11: export interface AuthRequest extends Request {
 12:   user?: IAuthUser;
 13: }
 14: export const authMiddleware = async (
 15:   req: AuthRequest,
 16:   res: Response,
 17:   next: NextFunction
 18: ): Promise<void> => {
 19:   const DEBUG_AUTH = process.env.NODE_ENV === "development";
 20:   try {
 21:     const authHeader = req.headers.authorization;
 22:     if (DEBUG_AUTH) {
 23:       console.log("Auth Middleware - Authorization header:", authHeader);
 24:     }
 25:     if (!authHeader || !authHeader.startsWith("Bearer ")) {
 26:       throw new ApiError(401, AUTH_ERROR_MESSAGES.UNAUTHORIZED);
 27:     }
 28:     const token = authHeader.substring(7);
 29:     const jwtSecret = process.env.NEXTAUTH_SECRET;
 30:     if (!jwtSecret) {
 31:       throw new ApiError(500, "JWT secret not configured");
 32:     }
 33:     const decoded = jwt.verify(token, jwtSecret) as any;
 34:     if (DEBUG_AUTH) {
 35:       console.log("Auth Middleware - Token sub:", decoded.sub);
 36:       console.log("Auth Middleware - Token email:", decoded.email);
 37:     }
 38:     const userId = decoded.sub || decoded.id;
 39:     const userEmail = decoded.email;
 40:     if (!userId && !userEmail) {
 41:       throw new ApiError(401, "Invalid token: missing user identifier");
 42:     }
 43:     let user: Record<string, unknown> | null = null;
 44:     if (userId) {
 45:       user = await prisma.user.findFirst({
 46:         where: { id: userId, isDeleted: false },
 47:         select: { id: true, email: true, role: true, isDeleted: true },
 48:       });
 49:       if (DEBUG_AUTH) {
 50:         console.log(
 51:           "Auth Middleware - Lookup by id result:",
 52:           user ? "found" : "not found"
 53:         );
 54:       }
 55:       if (!user && userEmail) {
 56:         if (DEBUG_AUTH) {
 57:           console.log("Auth Middleware - Fallback to email lookup:", userEmail);
 58:         }
 59:         user = await prisma.user.findFirst({
 60:           where: { email: userEmail, isDeleted: false },
 61:           select: { id: true, email: true, role: true, isDeleted: true },
 62:         });
 63:         if (DEBUG_AUTH) {
 64:           console.log(
 65:             "Auth Middleware - Lookup by email result:",
 66:             user ? "found" : "not found"
 67:           );
 68:         }
 69:       }
 70:     } else if (userEmail) {
 71:       console.log("Auth Middleware - Primary email lookup:", userEmail);
 72:       user = await prisma.user.findFirst({
 73:         where: { email: userEmail, isDeleted: false },
 74:         select: { id: true, email: true, role: true, isDeleted: true },
 75:       });
 76:       console.log(
 77:         "Auth Middleware - Lookup by email result:",
 78:         user ? "found" : "not found"
 79:       );
 80:     }
 81:     if (!user) {
 82:       throw new ApiError(401, AUTH_ERROR_MESSAGES.USER_NOT_FOUND);
 83:     }
 84:     req.user = {
 85:       userId: user.id as string,
 86:       id: user.id as string,
 87:       email: user.email as string,
 88:       role: user.role as string,
 89:     };
 90:     next();
 91:   } catch (error) {
 92:     if (error instanceof jwt.JsonWebTokenError) {
 93:       next(new ApiError(401, AUTH_ERROR_MESSAGES.INVALID_TOKEN));
 94:     } else if (error instanceof jwt.TokenExpiredError) {
 95:       next(new ApiError(401, AUTH_ERROR_MESSAGES.TOKEN_EXPIRED));
 96:     } else if (error instanceof ApiError) {
 97:       next(error);
 98:     } else {
 99:       console.error("Auth middleware error:", error);
100:       next(new ApiError(401, AUTH_ERROR_MESSAGES.INVALID_TOKEN));
101:     }
102:   }
103: };
104: export const requireRole = (allowedRoles: string[]) => {
105:   return (req: AuthRequest, res: Response, next: NextFunction): void => {
106:     if (!req.user) {
107:       return next(new ApiError(401, AUTH_ERROR_MESSAGES.UNAUTHORIZED));
108:     }
109:     if (!allowedRoles.includes(req.user.role)) {
110:       return next(new ApiError(403, AUTH_ERROR_MESSAGES.FORBIDDEN));
111:     }
112:     next();
113:   };
114: };
115: export const requireMinRole = (minRole: string) => {
116:   return (req: AuthRequest, res: Response, next: NextFunction): void => {
117:     if (!req.user) {
118:       return next(new ApiError(401, AUTH_ERROR_MESSAGES.UNAUTHORIZED));
119:     }
120:     const userLevel =
121:       ROLE_HIERARCHY[req.user.role as keyof typeof ROLE_HIERARCHY] || 0;
122:     const requiredLevel =
123:       ROLE_HIERARCHY[minRole as keyof typeof ROLE_HIERARCHY] || 0;
124:     if (userLevel < requiredLevel) {
125:       return next(new ApiError(403, AUTH_ERROR_MESSAGES.FORBIDDEN));
126:     }
127:     next();
128:   };
129: };
130: export const requireAdmin = requireMinRole(USER_ROLES.ADMIN);
131: export const requireTeamLead = requireMinRole(USER_ROLES.TEAM_LEAD);
132: export const requireProResearcher = requireMinRole(USER_ROLES.PRO_RESEARCHER);
133: export const requireOnboarding = async (
134:   req: AuthRequest,
135:   res: Response,
136:   next: NextFunction
137: ): Promise<void> => {
138:   try {
139:     if (!req.user) {
140:       return next(new ApiError(401, AUTH_ERROR_MESSAGES.UNAUTHORIZED));
141:     }
142:     const users = await prisma.$queryRaw<any[]>`
143:       SELECT "onboardingCompleted"
144:       FROM "User"
145:       WHERE id = ${req.user.id} AND "isDeleted" = false
146:       LIMIT 1
147:     `;
148:     const user = users[0];
149:     if (!user) {
150:       return next(new ApiError(401, AUTH_ERROR_MESSAGES.USER_NOT_FOUND));
151:     }
152:     if (!user.onboardingCompleted) {
153:       return next(
154:         new ApiError(403, "Onboarding required", "ONBOARDING_REQUIRED")
155:       );
156:     }
157:     next();
158:   } catch (error) {
159:     if (error instanceof ApiError) {
160:       return next(error);
161:     }
162:     console.error("Onboarding middleware error:", error);
163:     next(new ApiError(500, "Failed to check onboarding status"));
164:   }
165: };
166: export const optionalAuth = async (
167:   req: AuthRequest,
168:   res: Response,
169:   next: NextFunction
170: ): Promise<void> => {
171:   try {
172:     const authHeader = req.headers.authorization;
173:     if (!authHeader || !authHeader.startsWith("Bearer ")) {
174:       return next();
175:     }
176:     const token = authHeader.substring(7);
177:     const jwtSecret = process.env.NEXTAUTH_SECRET;
178:     if (!jwtSecret) {
179:       return next();
180:     }
181:     const decoded = jwt.verify(token, jwtSecret) as any;
182:     const users = await prisma.$queryRaw<any[]>`
183:       SELECT id, email, role, "isDeleted"
184:       FROM "User"
185:       WHERE id = ${decoded.sub} AND "isDeleted" = false
186:       LIMIT 1
187:     `;
188:     const user = users[0];
189:     if (user && !user.isDeleted) {
190:       req.user = {
191:         userId: user.id,
192:         id: user.id,
193:         email: user.email,
194:         role: user.role,
195:       };
196:     }
197:     next();
198:   } catch (error) {
199:     next();
200:   }
201: };
