139:             scale: 0.96,
140:             ...animationVariants[side].initial,
141:           }}
142:           animate={{ opacity: 1, scale: 1, ...animationVariants[side].animate }}
143:           exit={{ opacity: 0, scale: 0.96, ...animationVariants[side].initial }}
144:           transition={{ duration: 0.15, ease: "easeOut" }}
145:           className={cn(
146:             "absolute z-50 w-72 rounded-md border bg-popover p-4 text-popover-foreground shadow-lg outline-none",
147:             sideClasses[side],
148:             side === "top" || side === "bottom" ? alignClasses[align] : "",
149:             className
150:           )}
151:           style={
152:             side === "top" || side === "bottom"
153:               ? {
154:                   marginTop: side === "bottom" ? sideOffset : undefined,
155:                   marginBottom: side === "top" ? sideOffset : undefined,
156:                 }
157:               : {
158:                   marginLeft: side === "right" ? sideOffset : undefined,
159:                   marginRight: side === "left" ? sideOffset : undefined,
160:                 }
161:           }
162:           {...props}
163:         >
164:           {children}
165:         </motion.div>
166:       )}
167:     </AnimatePresence>
168:   );
169: }
