<file path="apps/backend/src/app/middleware/cacheMiddleware.ts">
  1: import crypto from "crypto";
  2: import { NextFunction, Request, Response } from "express";
  3: interface CacheOptions {
  4:   maxAge?: number;
  5:   sMaxAge?: number;
  6:   staleWhileRevalidate?: number;
  7:   staleIfError?: number;
  8:   public?: boolean;
  9:   private?: boolean;
 10:   noCache?: boolean;
 11:   noStore?: boolean;
 12:   mustRevalidate?: boolean;
 13: }
 14: function generateETag(body: string | Buffer): string {
 15:   return `"${crypto.createHash("md5").update(body).digest("hex")}"`;
 16: }
 17: function buildCacheControl(options: CacheOptions): string {
 18:   const directives: string[] = [];
 19:   if (options.noStore) {
 20:     directives.push("no-store");
 21:     return directives.join(", ");
 22:   }
 23:   if (options.noCache) {
 24:     directives.push("no-cache");
 25:   }
 26:   if (options.public) {
 27:     directives.push("public");
 28:   } else if (options.private) {
 29:     directives.push("private");
 30:   }
 31:   if (options.maxAge !== undefined) {
 32:     directives.push(`max-age=${options.maxAge}`);
 33:   }
 34:   if (options.sMaxAge !== undefined) {
 35:     directives.push(`s-maxage=${options.sMaxAge}`);
 36:   }
 37:   if (options.staleWhileRevalidate !== undefined) {
 38:     directives.push(`stale-while-revalidate=${options.staleWhileRevalidate}`);
 39:   }
 40:   if (options.staleIfError !== undefined) {
 41:     directives.push(`stale-if-error=${options.staleIfError}`);
 42:   }
 43:   if (options.mustRevalidate) {
 44:     directives.push("must-revalidate");
 45:   }
 46:   return directives.join(", ");
 47: }
 48: export function cacheMiddleware(options: CacheOptions) {
 49:   return (req: Request, res: Response, next: NextFunction) => {
 50:     if (req.method !== "GET") {
 51:       return next();
 52:     }
 53:     const originalJson = res.json.bind(res);
 54:     res.json = function (body: any) {
 55:       if (!res.getHeader("ETag")) {
 56:         const bodyString =
 57:           typeof body === "string" ? body : JSON.stringify(body);
 58:         const etag = generateETag(bodyString);
 59:         res.setHeader("ETag", etag);
 60:         const clientETag = req.headers["if-none-match"];
 61:         if (clientETag === etag) {
 62:           res.status(304);
 63:           return res.end();
 64:         }
 65:       }
 66:       const cacheControl = buildCacheControl(options);
 67:       if (cacheControl) {
 68:         res.setHeader("Cache-Control", cacheControl);
