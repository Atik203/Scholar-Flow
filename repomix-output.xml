391:       };
392:     } catch (error) {
393:       console.error(`[DocumentExtraction] PDF extraction failed:`, error);
394:       return {
395:         success: false,
396:         error:
397:           error instanceof Error ? error.message : "PDF extraction failed",
398:       };
399:     }
400:   }
401:   private async extractFromDOCX(
