 1: "use client";
 2: import {
 3:   showErrorToast,
 4:   showSuccessToast,
 5: } from "@/components/providers/ToastProvider";
 6: import { ImagePlusIcon } from "@/components/tiptap-icons/image-plus-icon";
 7: import { Button } from "@/components/tiptap-ui-primitive/button";
 8: import { useTiptapEditor } from "@/hooks/use-tiptap-editor";
 9: import { handleImageUpload } from "@/lib/tiptap-utils";
10: import * as React from "react";
11: export interface ResizableImageUploadButtonProps {
12:   editor?: any;
13:   text?: string;
14:   onUpload?: (file: File) => Promise<string>;
15: }
16: export const ResizableImageUploadButton = React.forwardRef<
17:   HTMLButtonElement,
18:   ResizableImageUploadButtonProps
19: >(({ editor: providedEditor, text, onUpload, ...buttonProps }, ref) => {
20:   const { editor } = useTiptapEditor(providedEditor);
21:   const fileInputRef = React.useRef<HTMLInputElement>(null);
22:   const handleClick = React.useCallback(() => {
23:     fileInputRef.current?.click();
24:   }, []);
25:   const handleFileSelect = React.useCallback(
26:     async (event: React.ChangeEvent<HTMLInputElement>) => {
27:       const file = event.target.files?.[0];
28:       if (!file || !editor) return;
29:       event.target.value = "";
30:       try {
31:         const url = onUpload ? await onUpload(file) : await handleImageUpload(file);
32:         // Insert the image using insertContent with ResizableImage node
33:         const success = editor
34:           .chain()
35:           .focus()
36:           .insertContent({
37:             type: "image",
38:             attrs: {
39:               src: url,
40:               alt: file.name,
41:               title: file.name,
42:               width: 400,
43:               height: 300,
44:               "data-keep-ratio": true,
45:             },
46:           })
47:           .run();
48:         if (success) {
49:           showSuccessToast("Image uploaded successfully!");
50:         } else {
51:           showErrorToast(
52:             "Failed to insert image",
53:             "Could not insert image into editor"
54:           );
55:         }
56:       } catch (error) {
57:         console.error("Upload failed:", error);
58:         showErrorToast(
59:           "Image upload failed",
60:           error instanceof Error ? error.message : "Unknown error"
61:         );
62:       }
63:     },
64:     [editor, onUpload]
65:   );
66:   const canInsert = editor?.can?.().insertContent?.({ type: "image" }) ?? false;
67:   if (!editor?.isEditable) {
68:     return null;
69:   }
70:   return (
71:     <>
72:       <Button
73:         type="button"
74:         data-style="ghost"
75:         role="button"
76:         tabIndex={-1}
77:         disabled={!canInsert}
78:         data-disabled={!canInsert}
79:         aria-label="Upload image"
80:         tooltip="Upload image"
81:         onClick={handleClick}
82:         {...buttonProps}
83:         ref={ref}
84:       >
85:         <ImagePlusIcon className="tiptap-button-icon" />
86:         {text && <span className="tiptap-button-text">{text}</span>}
87:       </Button>
88:       <input
89:         ref={fileInputRef}
90:         type="file"
91:         accept="image/*"
92:         style={{ display: "none" }}
93:         onChange={handleFileSelect}
94:       />
95:     </>
96:   );
97: });
98: ResizableImageUploadButton.displayName = "ResizableImageUploadButton";
</file>

