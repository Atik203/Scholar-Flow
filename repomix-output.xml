<file path="apps/backend/src/app/modules/Search/search.service.ts">
  1: import { Prisma } from "@prisma/client";
  2: import prisma from "../../shared/prisma";
  3: export class SearchService {
  4:   static async globalSearch(
  5:     userId: string,
  6:     query: string,
  7:     type: "all" | "papers" | "collections" | "workspaces" = "all",
  8:     limit: number,
  9:     skip: number,
 10:     workspaceId?: string
 11:   ) {
 12:     const results: Record<string, any> = {};
 13:     const q = query.toLowerCase();
 14:     if (type === "all" || type === "papers") {
 15:       const andConditions: Prisma.PaperWhereInput[] = [
 16:         { isDeleted: false },
 17:         {
 18:           OR: [
 19:             { title: { contains: q, mode: "insensitive" } },
 20:             { abstract: { contains: q, mode: "insensitive" } },
 21:             { source: { contains: q, mode: "insensitive" } },
 22:             { doi: { contains: q, mode: "insensitive" } }
 23:           ]
 24:         }
 25:       ];
 26:       if (workspaceId) {
 27:         andConditions.push({ workspaceId });
 28:       }
 29:       const safePaperWhere: Prisma.PaperWhereInput = { AND: andConditions };
 30:       const [totalCount, items] = await Promise.all([
 31:         prisma.paper.count({ where: safePaperWhere }),
 32:         prisma.paper.findMany({
 33:           where: safePaperWhere,
 34:           take: limit,
 35:           skip,
 36:           orderBy: { createdAt: "desc" },
 37:           select: {
 38:             id: true,
 39:             title: true,
 40:             metadata: true,
 41:             source: true,
 42:             workspaceId: true,
 43:             createdAt: true,
 44:           }
 45:         }),
 46:       ]);
 47:       results.papers = { total: totalCount, items };
 48:     }
 49:     if (type === "all" || type === "collections") {
 50:       const collAndConditions: Prisma.CollectionWhereInput[] = [
 51:         { isDeleted: false },
 52:         {
 53:           OR: [
 54:             { name: { contains: q, mode: "insensitive" } },
 55:             { description: { contains: q, mode: "insensitive" } },
 56:           ]
 57:         },
 58:         {
 59:           OR: [
 60:             { ownerId: userId },
 61:             { members: { some: { userId, isDeleted: false } } },
 62:             { isPublic: true }
 63:           ]
 64:         }
 65:       ];
 66:       if (workspaceId) {
 67:         collAndConditions.push({ workspaceId });
 68:       }
 69:       const finalCollectionWhere: Prisma.CollectionWhereInput = {
 70:          AND: collAndConditions
 71:       };
 72:       const [totalCount, items] = await Promise.all([
 73:         prisma.collection.count({ where: finalCollectionWhere }),
 74:         prisma.collection.findMany({
 75:           where: finalCollectionWhere,
 76:           take: limit,
 77:           skip,
 78:           orderBy: { createdAt: "desc" },
 79:           select: {
 80:             id: true,
 81:             name: true,
 82:             description: true,
 83:             isPublic: true,
 84:             workspaceId: true,
 85:           }
 86:         }),
 87:       ]);
 88:       results.collections = { total: totalCount, items };
 89:     }
 90:     if (type === "all" || type === "workspaces") {
 91:       const workspaceWhere: Prisma.WorkspaceWhereInput = {
 92:         AND: [
 93:           { isDeleted: false },
 94:           {
 95:             OR: [
 96:               { name: { contains: q, mode: "insensitive" } },
 97:               { description: { contains: q, mode: "insensitive" } },
 98:             ]
 99:           },
100:           {
101:             OR: [
102:               { ownerId: userId },
103:               { members: { some: { userId, isDeleted: false } } }
104:             ]
105:           }
106:         ]
107:       };
108:       const [totalCount, items] = await Promise.all([
109:         prisma.workspace.count({ where: workspaceWhere }),
110:         prisma.workspace.findMany({
111:           where: workspaceWhere,
112:           take: limit,
113:           skip,
114:           orderBy: { createdAt: "desc" },
115:           select: {
116:             id: true,
117:             name: true,
118:             description: true,
119:           }
120:         }),
121:       ]);
122:       results.workspaces = { total: totalCount, items };
123:     }
124:     let aggregateTotal = 0;
125:     if (results.papers) aggregateTotal += results.papers.total;
126:     if (results.collections) aggregateTotal += results.collections.total;
127:     if (results.workspaces) aggregateTotal += results.workspaces.total;
128:     return {
129:       results,
130:       meta: { limit, skip, total: aggregateTotal }
131:     };
132:   }
133:   static async saveSearchQuery(
134:     userId: string,
135:     query: string,
136:     filters?: any,
137:     searchResultsSummary?: any
138:   ) {
139:     if (!query || query.trim().length === 0) return null;
140:     return prisma.searchHistory.create({
141:       data: {
142:         userId,
143:         query: query.trim(),
144:         filters: filters || null,
145:         results: searchResultsSummary || null,
146:       }
147:     });
148:   }
149:   static async getSearchHistory(
150:     userId: string,
151:     limit: number,
152:     skip: number
153:   ) {
154:     const where: Prisma.SearchHistoryWhereInput = {
155:       userId,
156:       isDeleted: false
157:     };
158:     const [total, data] = await Promise.all([
159:       prisma.searchHistory.count({ where }),
160:       prisma.searchHistory.findMany({
161:         where,
162:         take: limit,
163:         skip,
164:         orderBy: { createdAt: "desc" },
165:       }),
166:     ]);
167:     return {
168:       meta: { total, skip, limit },
169:       result: data,
170:     };
171:   }
172:   static async getTrendingPapers(limit: number) {
173:     return prisma.paper.findMany({
174:       where: { isDeleted: false },
175:       take: limit,
176:       orderBy: { createdAt: "desc" },
177:     });
178:   }
179:   static async getRecommendations(userId: string, limit: number) {
180:     return prisma.paper.findMany({
181:       where: {
182:         isDeleted: false,
183:         workspace: {
184:           members: {
185:             some: {
186:               userId,
187:               isDeleted: false
188:             }
189:           }
190:         }
191:       },
192:       take: limit,
193:       orderBy: { createdAt: "desc" }
194:     });
195:   }
196: }
197: export default SearchService;
</file>

