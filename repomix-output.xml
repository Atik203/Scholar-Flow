203:   @@index([ownerId, isDeleted, createdAt]) // For user's active workspaces
204: }
205: 
206: model WorkspaceMember {
207:   id          String        @id @default(uuid())
208:   workspaceId String
209:   userId      String
210:   role        WorkspaceRole @default(EDITOR)
211:   joinedAt    DateTime      @default(now())
212: 
213:   workspace Workspace @relation(fields: [workspaceId], references: [id])
214:   user      User      @relation(fields: [userId], references: [id])
215: 
216:   createdAt DateTime @default(now())
217:   updatedAt DateTime @updatedAt
218:   isDeleted Boolean  @default(false)
219: 
220:   @@unique([workspaceId, userId])
221:   @@index([userId, isDeleted]) // For user's workspace lookups
222:   @@index([workspaceId, isDeleted, role]) // For workspace member filtering by role
223: }
224: 
225: model WorkspaceInvitation {
226:   id          String           @id @default(uuid())
227:   workspaceId String
228:   userId      String
229:   role        WorkspaceRole    @default(EDITOR)
230:   invitedAt   DateTime         @default(now())
231:   // Invitation workflow fields
232:   status      MembershipStatus @default(PENDING)
233:   invitedById String?
234:   acceptedAt  DateTime?
235:   declinedAt  DateTime?
236: 
237:   workspace Workspace @relation(fields: [workspaceId], references: [id])
238:   user      User      @relation("WorkspaceInvitationUser", fields: [userId], references: [id])
239:   invitedBy User?     @relation("WorkspaceInvitationInvitedBy", fields: [invitedById], references: [id])
240: 
241:   createdAt DateTime @default(now())
242:   updatedAt DateTime @updatedAt
243:   isDeleted Boolean  @default(false)
244: 
245:   @@unique([workspaceId, userId])
246:   @@index([workspaceId, status, isDeleted]) // For pending invitation lookups
247:   @@index([userId, status, isDeleted]) // For user's pending invitations
248: }
