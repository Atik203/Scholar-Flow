  7:     let dbStatus = "disconnected";
  8:     let dbResponseTime = 0;
  9:     try {
 10:       const dbStart = Date.now();
 11:       await prisma.$queryRaw`SELECT 1`;
 12:       dbResponseTime = Date.now() - dbStart;
 13:       dbStatus = "connected";
 14:     } catch (error) {
 15:       console.error("Database health check failed:", error);
 16:     }
 17:     const aiProvidersConfigured = config.ai.providerFallbackOrder.map(
 18:       (provider) => ({
 19:         provider,
 20:         configured:
 21:           (provider === "openai" && !!config.openai.apiKey) ||
 22:           (provider === "gemini" && !!config.gemini.apiKey),
 23:       })
 24:     );
 25:     const features = {
 26:       pgvectorEnabled: process.env.USE_PGVECTOR === "true",
 27:       aiSearchEnabled:
 28:         config.ai.featuresEnabled &&
 29:         aiProvidersConfigured.some((item) => item.configured),
 30:       aiProviderFallbackOrder: config.ai.providerFallbackOrder,
 31:       aiProvidersConfigured,
 32:       fileUploadEnabled:
 33:         config.featureFlags.uploads &&
 34:         (!!config.aws.access_key_id || !!process.env.AWS_S3_BUCKET),
 35:       oauthEnabled: !!process.env.GOOGLE_CLIENT_ID,
 36:     };
 37:     const status = {
 38:       api: {
 39:         status: "healthy",
 40:         version: process.env.npm_package_version || "1.0.0",
 41:         environment: process.env.NODE_ENV || "development",
 42:         uptime: process.uptime(),
