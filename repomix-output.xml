1576:       throw new ApiError(
1577:         403,
1578:         "Access denied: You don't have edit permission for this collection"
1579:       );
1580:     }
1581:     // Check if paper is in collection
1582:     const collectionPaperRows = await prisma.$queryRaw<Array<{ id: string }>>`
1583:       SELECT id
1584:       FROM "CollectionPaper"
1585:       WHERE "collectionId" = ${collectionId}
1586:         AND "paperId" = ${paperId}
1587:         AND "isDeleted" = false
1588:       LIMIT 1
1589:     `;
1590:     const collectionPaper = collectionPaperRows[0];
