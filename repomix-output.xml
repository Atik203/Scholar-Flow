271:                 </p>
272:                 <p className="text-sm text-muted-foreground mt-1">
273:                   {processingData?.data?.processingError ||
274:                     "Unknown error occurred"}
275:                 </p>
276:               </div>
277:               <Button
278:                 onClick={handleRetryExtraction}
279:                 variant="outline"
280:                 size="sm"
281:               >
282:                 <RefreshCw className="h-4 w-4 mr-2" />
283:                 Retry Processing
284:               </Button>
285:             </div>
286:           </div>
287:         ) : isProcessed && previewData?.data?.url ? (
288:           <div className="bg-muted/10 rounded-lg border">
289:             <div className="p-4 border-b bg-muted/20">
290:               <div className="flex items-center justify-between">
291:                 <div className="flex items-center gap-2">
292:                   <FileText className="h-4 w-4" />
293:                   <span className="text-sm font-medium">
