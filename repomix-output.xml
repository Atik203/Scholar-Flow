10: export function Switch({
11:   checked,
12:   defaultChecked = false,
13:   onCheckedChange,
14:   disabled = false,
15:   className = "",
16:   id,
17: }: SwitchProps) {
18:   // Use internal state if no controlled value is provided
19:   const [internalChecked, setInternalChecked] = useState(defaultChecked);
