<file path="apps/frontend/src/components/tiptap-ui/text-align-button/use-text-align.ts">
  1: "use client"
  2: import * as React from "react"
  3: import { type Editor } from "@tiptap/react"
  4: import { useTiptapEditor } from "@/hooks/use-tiptap-editor"
  5: import {
  6:   isExtensionAvailable,
  7:   isNodeTypeSelected,
  8: } from "@/lib/tiptap-utils"
  9: import { AlignCenterIcon } from "@/components/tiptap-icons/align-center-icon"
 10: import { AlignJustifyIcon } from "@/components/tiptap-icons/align-justify-icon"
 11: import { AlignLeftIcon } from "@/components/tiptap-icons/align-left-icon"
 12: import { AlignRightIcon } from "@/components/tiptap-icons/align-right-icon"
 13: export type TextAlign = "left" | "center" | "right" | "justify"
 14: export interface UseTextAlignConfig {
 15:   editor?: Editor | null
 16:   align: TextAlign
 17:   hideWhenUnavailable?: boolean
 18:   onAligned?: () => void
 19: }
 20: export const TEXT_ALIGN_SHORTCUT_KEYS: Record<TextAlign, string> = {
 21:   left: "mod+shift+l",
 22:   center: "mod+shift+e",
 23:   right: "mod+shift+r",
 24:   justify: "mod+shift+j",
 25: }
 26: export const textAlignIcons = {
 27:   left: AlignLeftIcon,
 28:   center: AlignCenterIcon,
 29:   right: AlignRightIcon,
 30:   justify: AlignJustifyIcon,
 31: }
 32: export const textAlignLabels: Record<TextAlign, string> = {
 33:   left: "Align left",
 34:   center: "Align center",
 35:   right: "Align right",
 36:   justify: "Align justify",
 37: }
 38: function getTextAlignConfigTypes(
 39:   editor: Editor | null
 40: ): string[] | null {
 41:   if (!editor) return null;
 42:   const ext = editor.extensionManager.extensions.find(
 43:     (e) => e.name === "textAlign"
 44:   );
 45:   if (!ext) return null;
 46:   const types = (ext as { options?: { types?: string[] } }).options?.types;
 47:   return Array.isArray(types) && types.length > 0 ? types : null;
 48: }
 49: function getSelectedAlignableTypes(editor: Editor): string[] {
 50:   const supported = getTextAlignConfigTypes(editor);
 51:   if (!supported) return [];
 52:   const { $from, $to } = editor.state.selection;
 53:   const found = new Set<string>();
 54:   editor.state.doc.nodesBetween($from.pos, $to.pos, (node) => {
 55:     if (node.isBlock && supported.includes(node.type.name)) {
 56:       found.add(node.type.name);
 57:     }
 58:   });
 59:   return [...found];
 60: }
 61: export function canSetTextAlign(
 62:   editor: Editor | null,
 63:   align: TextAlign
 64: ): boolean {
 65:   if (!editor || !editor.isEditable) return false;
 66:   if (
 67:     !isExtensionAvailable(editor, "textAlign") ||
 68:     isNodeTypeSelected(editor, ["image"])
 69:   )
 70:     return false;
 71:   return getSelectedAlignableTypes(editor).length > 0;
 72: }
 73: export function isTextAlignActive(
 74:   editor: Editor | null,
 75:   align: TextAlign
 76: ): boolean {
 77:   if (!editor || !editor.isEditable) return false
 78:   return editor.isActive({ textAlign: align })
 79: }
 80: export function setTextAlign(editor: Editor | null, align: TextAlign): boolean {
 81:   if (!editor || !editor.isEditable) return false;
 82:   if (!canSetTextAlign(editor, align)) return false;
 83:   const presentTypes = getSelectedAlignableTypes(editor);
 84:   if (presentTypes.length === 0) return false;
 85:   return editor
 86:     .chain()
 87:     .focus()
 88:     .command(({ commands }) =>
 89:       presentTypes.every((type) =>
 90:         commands.updateAttributes(type, { textAlign: align })
 91:       )
 92:     )
 93:     .run();
 94: }
 95: export function shouldShowButton(props: {
 96:   editor: Editor | null
 97:   hideWhenUnavailable: boolean
 98:   align: TextAlign
 99: }): boolean {
100:   const { editor, hideWhenUnavailable, align } = props
101:   if (!editor || !editor.isEditable) return false
102:   if (!isExtensionAvailable(editor, "textAlign")) return false
103:   if (hideWhenUnavailable && !editor.isActive("code")) {
104:     return canSetTextAlign(editor, align)
105:   }
106:   return true
107: }
108: export function useTextAlign(config: UseTextAlignConfig) {
109:   const {
110:     editor: providedEditor,
111:     align,
112:     hideWhenUnavailable = false,
113:     onAligned,
114:   } = config
115:   const { editor } = useTiptapEditor(providedEditor)
116:   const [isVisible, setIsVisible] = React.useState<boolean>(true)
117:   const canAlign = canSetTextAlign(editor, align)
118:   const isActive = isTextAlignActive(editor, align)
119:   React.useEffect(() => {
120:     if (!editor) return
121:     const handleSelectionUpdate = () => {
122:       setIsVisible(shouldShowButton({ editor, align, hideWhenUnavailable }))
123:     }
124:     handleSelectionUpdate()
125:     editor.on("selectionUpdate", handleSelectionUpdate)
126:     return () => {
127:       editor.off("selectionUpdate", handleSelectionUpdate)
128:     }
129:   }, [editor, hideWhenUnavailable, align])
130:   const handleTextAlign = React.useCallback(() => {
131:     if (!editor) return false
132:     const success = setTextAlign(editor, align)
133:     if (success) {
134:       onAligned?.()
135:     }
136:     return success
137:   }, [editor, align, onAligned])
138:   return {
139:     isVisible,
140:     isActive,
141:     handleTextAlign,
142:     canAlign,
143:     label: textAlignLabels[align],
144:     shortcutKeys: TEXT_ALIGN_SHORTCUT_KEYS[align],
145:     Icon: textAlignIcons[align],
146:   }
147: }
</file>

