<file path="apps/backend/src/app/middleware/cacheMiddleware.ts">
  1: import crypto from "crypto";
  2: import { NextFunction, Request, Response } from "express";
  3: interface CacheOptions {
  4:   maxAge?: number;
  5:   sMaxAge?: number;
  6:   staleWhileRevalidate?: number;
  7:   staleIfError?: number;
  8:   public?: boolean;
  9:   private?: boolean;
 10:   noCache?: boolean;
 11:   noStore?: boolean;
 12:   mustRevalidate?: boolean;
 13: }
 14: function generateETag(body: string | Buffer): string {
 15:   return `"${crypto.createHash("md5").update(body).digest("hex")}"`;
 16: }
 17: function buildCacheControl(options: CacheOptions): string {
 18:   const directives: string[] = [];
 19:   if (options.noStore) {
 20:     directives.push("no-store");
 21:     return directives.join(", ");
 22:   }
 23:   if (options.noCache) {
 24:     directives.push("no-cache");
 25:   }
 26:   if (options.public) {
 27:     directives.push("public");
 28:   } else if (options.private) {
 29:     directives.push("private");
 30:   }
 31:   if (options.maxAge !== undefined) {
 32:     directives.push(`max-age=${options.maxAge}`);
 33:   }
 34:   if (options.sMaxAge !== undefined) {
 35:     directives.push(`s-maxage=${options.sMaxAge}`);
 36:   }
 37:   if (options.staleWhileRevalidate !== undefined) {
 38:     directives.push(`stale-while-revalidate=${options.staleWhileRevalidate}`);
 39:   }
 40:   if (options.staleIfError !== undefined) {
 41:     directives.push(`stale-if-error=${options.staleIfError}`);
 42:   }
 43:   if (options.mustRevalidate) {
 44:     directives.push("must-revalidate");
 45:   }
 46:   return directives.join(", ");
 47: }
 48: export function cacheMiddleware(options: CacheOptions) {
 49:   return (req: Request, res: Response, next: NextFunction) => {
 50:     if (req.method !== "GET") {
 51:       return next();
 52:     }
 53:     const originalJson = res.json.bind(res);
 54:     res.json = function (body: any) {
 55:       if (!res.getHeader("ETag")) {
 56:         const bodyString =
 57:           typeof body === "string" ? body : JSON.stringify(body);
 58:         const etag = generateETag(bodyString);
 59:         res.setHeader("ETag", etag);
 60:         const clientETag = req.headers["if-none-match"];
 61:         if (clientETag === etag) {
 62:           res.status(304);
 63:           return res.end();
 64:         }
 65:       }
 66:       const cacheControl = buildCacheControl(options);
 67:       if (cacheControl) {
 68:         res.setHeader("Cache-Control", cacheControl);
 69:       }
 70:       res.setHeader("Vary", "Accept-Encoding, Accept");
 71:       return originalJson(body);
 72:     };
 73:     next();
 74:   };
 75: }
 76: export const CachePresets = {
 77:   noCache: (): ReturnType<typeof cacheMiddleware> =>
 78:     cacheMiddleware({
 79:       noCache: true,
 80:       mustRevalidate: true,
 81:     }),
 82:   short: (): ReturnType<typeof cacheMiddleware> =>
 83:     cacheMiddleware({
 84:       public: true,
 85:       maxAge: 30,
 86:       sMaxAge: 60,
 87:       staleWhileRevalidate: 30,
 88:     }),
 89:   medium: (): ReturnType<typeof cacheMiddleware> =>
 90:     cacheMiddleware({
 91:       public: true,
 92:       maxAge: 300,
 93:       sMaxAge: 600,
 94:       staleWhileRevalidate: 300,
 95:     }),
 96:   long: (): ReturnType<typeof cacheMiddleware> =>
 97:     cacheMiddleware({
 98:       public: true,
 99:       maxAge: 3600,
100:       sMaxAge: 7200,
101:       staleWhileRevalidate: 3600,
102:     }),
103:   private: (): ReturnType<typeof cacheMiddleware> =>
104:     cacheMiddleware({
105:       private: true,
106:       maxAge: 300,
107:       mustRevalidate: true,
108:     }),
109: };
</file>

<file path="apps/backend/src/app/middleware/errorHandler.ts">
 1: import { Request, Response, NextFunction } from 'express';
 2: export interface AppError extends Error {
 3:   statusCode?: number;
 4:   isOperational?: boolean;
 5: }
 6: export const errorHandler = (
 7:   err: AppError,
 8:   req: Request,
 9:   res: Response,
10:   _next: NextFunction
11: ) => {
12:   let { statusCode = 500, message } = err;
13:   if (err.name === 'ValidationError') {
14:     statusCode = 400;
15:     message = 'Validation error';
16:   } else if (err.name === 'CastError') {
17:     statusCode = 400;
18:     message = 'Invalid data format';
19:   } else if (err.name === 'JsonWebTokenError') {
20:     statusCode = 401;
21:     message = 'Invalid token';
22:   } else if (err.name === 'TokenExpiredError') {
23:     statusCode = 401;
24:     message = 'Token expired';
25:   }
26:   console.error(`Error ${statusCode}: ${message}`, {
27:     error: err,
28:     url: req.url,
29:     method: req.method,
30:     ip: req.ip,
31:     userAgent: req.get('User-Agent'),
32:   });
33:   res.status(statusCode).json({
34:     error: message,
35:     ...(process.env.NODE_ENV === 'development' && { stack: err.stack }),
36:   });
37: };
38: export const createError = (message: string, statusCode: number = 500): AppError => {
39:   const error = new Error(message) as AppError;
40:   error.statusCode = statusCode;
41:   error.isOperational = true;
42:   return error;
43: };
</file>

<file path="apps/backend/src/app/middleware/globalErrorHandler.ts">
  1: import { Prisma } from "@prisma/client";
  2: import { NextFunction, Request, Response } from "express";
  3: import { ZodError } from "zod";
  4: import config from "../config";
  5: import {
  6:   ApiError,
  7:   handleDuplicateError,
  8:   handleJWTError,
  9:   handlePostgresError,
 10:   handlePrismaError,
 11:   handleTokenExpiredError,
 12:   handleZodError,
 13: } from "../errors";
 14: import { TErrorSources } from "../interfaces/error";
 15: const globalErrorHandler = (
 16:   err: unknown,
 17:   req: Request,
 18:   res: Response,
 19:   _next: NextFunction
 20: ) => {
 21:   console.error("❌ GLOBAL ERROR HANDLER CAUGHT:", {
 22:     errorType: err?.constructor?.name,
 23:     message: (err as Error)?.message,
 24:     code: (err as any)?.code,
 25:     stack: config.env === "development" ? (err as Error)?.stack : undefined,
 26:     details: (err as any)?.detail,
 27:     column: (err as any)?.column,
 28:     constraint: (err as any)?.constraint,
 29:     table: (err as any)?.table,
 30:   });
 31:   let statusCode = 500;
 32:   let message = "Something went wrong!";
 33:   let errorSources: TErrorSources = [
 34:     {
 35:       path: "",
 36:       message: "Something went wrong!",
 37:     },
 38:   ];
 39:   // Handle Zod validation errors
 40:   if (err instanceof ZodError) {
 41:     const simplifiedError = handleZodError(err);
 42:     statusCode = simplifiedError?.statusCode;
 43:     message = simplifiedError?.message;
 44:     errorSources = simplifiedError?.errorSources;
 45:   }
 46:   // Handle Prisma known request errors
 47:   else if (err instanceof Prisma.PrismaClientKnownRequestError) {
 48:     const simplifiedError = handlePrismaError(err);
 49:     statusCode = simplifiedError?.statusCode;
 50:     message = simplifiedError?.message;
 51:     errorSources = simplifiedError?.errorSources;
 52:   }
 53:   // Handle Prisma validation errors
 54:   else if (err instanceof Prisma.PrismaClientValidationError) {
 55:     statusCode = 400;
 56:     message = "Validation Error";
 57:     errorSources = [
 58:       {
 59:         path: "validation",
 60:         message: err.message,
 61:       },
 62:     ];
 63:   }
 64:   else if ((err as any)?.code && typeof (err as any).code === "string") {
 65:     const simplifiedError = handlePostgresError(err);
 66:     statusCode = simplifiedError?.statusCode;
 67:     message = simplifiedError?.message;
 68:     errorSources = simplifiedError?.errorSources;
 69:   }
 70:   else if ((err as Error)?.name === "JsonWebTokenError") {
 71:     const simplifiedError = handleJWTError();
 72:     statusCode = simplifiedError?.statusCode;
 73:     message = simplifiedError?.message;
 74:     errorSources = simplifiedError?.errorSources;
 75:   }
 76:   else if ((err as Error)?.name === "TokenExpiredError") {
 77:     const simplifiedError = handleTokenExpiredError();
 78:     statusCode = simplifiedError?.statusCode;
 79:     message = simplifiedError?.message;
 80:     errorSources = simplifiedError?.errorSources;
 81:   }
 82:   else if ((err as any)?.code === 11000) {
 83:     const simplifiedError = handleDuplicateError(err);
 84:     statusCode = simplifiedError?.statusCode;
 85:     message = simplifiedError?.message;
 86:     errorSources = simplifiedError?.errorSources;
 87:   }
 88:   else if (err instanceof ApiError) {
 89:     statusCode = err?.statusCode;
 90:     message = err?.message;
 91:     errorSources = [
 92:       {
 93:         path: "",
 94:         message: err?.message,
 95:       },
 96:     ];
 97:   }
 98:   // Handle generic Error instances
 99:   else if (err instanceof Error) {
100:     message = err?.message;
101:     errorSources = [
102:       {
103:         path: "",
104:         message: err?.message,
105:       },
106:     ];
107:   }
108:   return res.status(statusCode).json({
109:     success: false,
110:     message,
111:     errorSources,
112:     stack: config.env === "development" ? (err as Error)?.stack : null,
113:   });
114: };
115: export default globalErrorHandler;
</file>

<file path="apps/backend/src/app/middleware/performanceMonitor.ts">
  1: import { NextFunction, Request, Response } from "express";
  2: export const performanceMonitor = (
  3:   req: Request,
  4:   res: Response,
  5:   next: NextFunction
  6: ) => {
  7:   const start = Date.now();
  8:   const startTime = process.hrtime.bigint();
  9:   res.on("finish", () => {
 10:     const duration = Date.now() - start;
 11:     const hrDuration = process.hrtime.bigint() - startTime;
 12:     const hrMs = Number(hrDuration) / 1000000;
 13:     if (!res.headersSent) {
 14:       res.setHeader("X-Response-Time", `${duration}ms`);
 15:       res.setHeader("X-Response-Time-HR", `${hrMs.toFixed(3)}ms`);
 16:     }
 17:     logRequestPerformance(req, res, duration, hrMs);
 18:   });
 19:   next();
 20: };
 21: function logRequestPerformance(
 22:   req: Request,
 23:   res: Response,
 24:   duration: number,
 25:   hrDuration: number
 26: ) {
 27:   const method = req.method;
 28:   const url = req.originalUrl || req.url;
 29:   const statusCode = res.statusCode;
 30:   const userAgent = req.get("User-Agent") || "unknown";
 31:   const ip = req.ip || req.connection.remoteAddress;
 32:   const logData = {
 33:     method,
 34:     url,
 35:     statusCode,
 36:     duration: `${duration}ms`,
 37:     hrDuration: `${hrDuration.toFixed(3)}ms`,
 38:     ip: ip?.replace(/^.*:/, ""), // Clean IPv6-mapped IPv4 addresses
 39:     timestamp: new Date().toISOString(),
 40:   };
 41:   // Categorize and log based on performance
 42:   if (duration >= 5000) {
 43:     // Very slow requests (5+ seconds)
 44:     console.error("🚨 VERY SLOW REQUEST:", {
 45:       ...logData,
 46:       level: "CRITICAL",
 47:       userAgent: userAgent.substring(0, 100),
 48:     });
 49:   } else if (duration >= 2000) {
 50:     console.warn("⚠️  SLOW REQUEST:", {
 51:       ...logData,
 52:       level: "WARNING",
 53:     });
 54:   } else if (duration >= 1000) {
 55:     console.info("📊 MODERATE REQUEST:", {
 56:       ...logData,
 57:       level: "INFO",
 58:     });
 59:   } else if (process.env.NODE_ENV === "development" && duration >= 500) {
 60:     console.log("⏱️  REQUEST:", {
 61:       ...logData,
 62:       level: "DEBUG",
 63:     });
 64:   }
 65:   if (statusCode >= 500) {
 66:     console.error("💥 SERVER ERROR:", {
 67:       ...logData,
 68:       level: "ERROR",
 69:     });
 70:   } else if (statusCode >= 400) {
 71:     console.warn("⚠️  CLIENT ERROR:", {
 72:       ...logData,
 73:       level: "WARNING",
 74:     });
 75:   }
 76:   if (url.includes("/papers") && duration > 1000) {
 77:     console.warn("📄 SLOW PAPER OPERATION:", {
 78:       ...logData,
 79:       endpoint: "papers",
 80:       level: "PAPER_PERFORMANCE",
 81:     });
 82:   }
 83:   if (url.includes("/auth") && duration > 500) {
 84:     console.warn("🔐 SLOW AUTH OPERATION:", {
 85:       ...logData,
 86:       endpoint: "auth",
 87:       level: "AUTH_PERFORMANCE",
 88:     });
 89:   }
 90: }
 91: export const routePerformanceMonitor = (routeName: string) => {
 92:   return (req: Request, res: Response, next: NextFunction) => {
 93:     const start = Date.now();
 94:     res.on("finish", () => {
 95:       const duration = Date.now() - start;
 96:       if (duration > 1000) {
 97:         console.warn(`🎯 SLOW ROUTE [${routeName}]:`, {
 98:           method: req.method,
 99:           url: req.originalUrl,
100:           duration: `${duration}ms`,
101:           statusCode: res.statusCode,
102:           route: routeName,
103:           timestamp: new Date().toISOString(),
