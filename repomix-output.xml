<file path="apps/frontend/src/components/ui/data-table/DataTable.tsx">
  1: import { cn } from "@/lib/utils";
  2: import { Download, Filter, MoreHorizontal, Search } from "lucide-react";
  3: import * as React from "react";
  4: import { Button } from "../button";
  5: import { Checkbox } from "../checkbox";
  6: import {
  7:   DropdownMenu,
  8:   DropdownMenuContent,
  9:   DropdownMenuItem,
 10:   DropdownMenuLabel,
 11:   DropdownMenuSeparator,
 12:   DropdownMenuTrigger,
 13: } from "../dropdown-menu";
 14: import { Input } from "../input";
 15: export interface Column<T = any> {
 16:   key: string;
 17:   label: string;
 18:   sortable?: boolean;
 19:   width?: number;
 20:   render?: (value: any, row: T) => React.ReactNode;
 21:   filterable?: boolean;
 22:   hidden?: boolean;
 23: }
 24: export interface DataTableProps<T = any> {
 25:   data: T[];
 26:   columns: Column<T>[];
 27:   searchable?: boolean;
 28:   sortable?: boolean;
 29:   selectable?: boolean;
 30:   exportable?: boolean;
 31:   className?: string;
 32:   onRowSelect?: (selectedRows: T[]) => void;
 33:   onSort?: (key: string, direction: "asc" | "desc") => void;
 34:   onSearch?: (query: string) => void;
 35:   loading?: boolean;
 36:   emptyState?: React.ReactNode;
 37: }
 38: export function DataTable<T = any>({
 39:   data,
 40:   columns,
 41:   searchable = true,
 42:   sortable = true,
 43:   selectable = true,
 44:   exportable = true,
 45:   className,
 46:   onRowSelect,
 47:   onSort,
 48:   onSearch,
 49:   loading = false,
 50:   emptyState,
 51: }: DataTableProps<T>) {
 52:   const [searchQuery, setSearchQuery] = React.useState("");
 53:   const [sortConfig, setSortConfig] = React.useState<{
 54:     key: string;
 55:     direction: "asc" | "desc";
 56:   } | null>(null);
 57:   const [selectedRows, setSelectedRows] = React.useState<Set<number>>(
 58:     new Set()
 59:   );
 60:   const [visibleColumns, setVisibleColumns] = React.useState<Set<string>>(
 61:     new Set(columns.map((col) => col.key))
 62:   );
 63:   const visibleColumnsList = columns.filter((col) =>
 64:     visibleColumns.has(col.key)
 65:   );
 66:   const handleSort = (key: string) => {
 67:     if (!sortable) return;
 68:     const newDirection =
 69:       sortConfig?.key === key && sortConfig.direction === "asc"
 70:         ? "desc"
 71:         : "asc";
 72:     setSortConfig({ key, direction: newDirection });
 73:     onSort?.(key, newDirection);
 74:   };
 75:   const handleSearch = (query: string) => {
 76:     setSearchQuery(query);
 77:     onSearch?.(query);
 78:   };
 79:   const handleRowSelect = (rowIndex: number, checked: boolean) => {
 80:     const newSelected = new Set(selectedRows);
 81:     if (checked) {
 82:       newSelected.add(rowIndex);
 83:     } else {
 84:       newSelected.delete(rowIndex);
 85:     }
 86:     setSelectedRows(newSelected);
 87:     onRowSelect?.(Array.from(newSelected).map((i) => data[i]));
 88:   };
 89:   const handleSelectAll = (checked: boolean) => {
 90:     if (checked) {
 91:       setSelectedRows(new Set(data.map((_, i) => i)));
 92:       onRowSelect?.(data);
 93:     } else {
 94:       setSelectedRows(new Set());
 95:       onRowSelect?.([]);
 96:     }
 97:   };
 98:   const exportData = () => {
 99:     const csvContent = [
100:       visibleColumnsList.map((col) => col.label).join(","),
101:       ...data.map((row) =>
102:         visibleColumnsList
103:           .map((col) => {
104:             const value = row[col.key as keyof T];
105:             return typeof value === "string" ? `"${value}"` : value;
106:           })
107:           .join(",")
108:       ),
109:     ].join("\n");
110:     const blob = new Blob([csvContent], { type: "text/csv" });
111:     const url = window.URL.createObjectURL(blob);
112:     const a = document.createElement("a");
113:     a.href = url;
114:     a.download = "data-export.csv";
115:     a.click();
116:     window.URL.revokeObjectURL(url);
117:   };
118:   const filteredData = React.useMemo(() => {
119:     let result = [...data];
120:     if (searchQuery) {
121:       result = result.filter((row) =>
122:         visibleColumnsList.some((col) => {
123:           const value = row[col.key as keyof T];
124:           return String(value)
125:             .toLowerCase()
126:             .includes(searchQuery.toLowerCase());
127:         })
128:       );
129:     }
130:     if (sortConfig) {
131:       result.sort((a, b) => {
132:         const aVal = a[sortConfig.key as keyof T];
133:         const bVal = b[sortConfig.key as keyof T];
134:         if (aVal < bVal) return sortConfig.direction === "asc" ? -1 : 1;
135:         if (aVal > bVal) return sortConfig.direction === "asc" ? 1 : -1;
136:         return 0;
137:       });
138:     }
139:     return result;
140:   }, [data, searchQuery, sortConfig, visibleColumnsList]);
141:   if (loading) {
142:     return (
143:       <div className="flex items-center justify-center p-8">
144:         <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
145:       </div>
146:     );
147:   }
148:   if (data.length === 0) {
149:     return (
150:       <div className="flex items-center justify-center p-8 text-center">
151:         {emptyState || (
152:           <>
153:             <div className="text-muted-foreground">
154:               <p>No data available</p>
155:             </div>
156:           </>
157:         )}
158:       </div>
159:     );
160:   }
161:   return (
162:     <div className={cn("space-y-4", className)}>
163:       {}
164:       <div className="flex items-center justify-between">
165:         <div className="flex items-center gap-4">
