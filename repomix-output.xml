155:                 <p
156:                   className={cn(
157:                     "font-bold text-foreground",
158:                     textSizes[size].value
159:                   )}
160:                 >
161:                   {displayValue}
162:                 </p>
163:                 {description && (
164:                   <p
165:                     className={cn(
