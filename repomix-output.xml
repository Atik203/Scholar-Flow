209:         timeout: 300000,
210:       }
211:     );
212:     const queueTime = Date.now() - queueStart;
213:     console.log(
214:       `[DocumentQueue] Successfully queued document extraction for paper: ${paperId} in ${queueTime}ms`
215:     );
216:   } catch (error) {
217:     const queueTime = Date.now() - queueStart;
218:     console.error(
