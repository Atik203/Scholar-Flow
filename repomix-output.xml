 52: const useTypewriter = (
 53:   words: string[],
 54:   typingSpeed = 100,
 55:   deletingSpeed = 50,
 56:   pauseDuration = 2000,
 57: ) => {
 58:   const [currentWordIndex, setCurrentWordIndex] = useState(0);
 59:   const [currentText, setCurrentText] = useState("");
 60:   const [isDeleting, setIsDeleting] = useState(false);
 61:   useEffect(() => {
 62:     const word = words[currentWordIndex];
 63:     const timeout = setTimeout(
 64:       () => {
 65:         if (!isDeleting) {
 66:           if (currentText.length < word.length) {
 67:             setCurrentText(word.slice(0, currentText.length + 1));
 68:           } else {
 69:             setTimeout(() => setIsDeleting(true), pauseDuration);
 70:           }
 71:         } else {
 72:           if (currentText.length > 0) {
 73:             setCurrentText(word.slice(0, currentText.length - 1));
 74:           } else {
 75:             setIsDeleting(false);
 76:             setCurrentWordIndex((prev) => (prev + 1) % words.length);
 77:           }
 78:         }
 79:       },
 80:       isDeleting ? deletingSpeed : typingSpeed,
 81:     );
 82:     return () => clearTimeout(timeout);
 83:   }, [currentText, isDeleting, currentWordIndex, words, typingSpeed, deletingSpeed, pauseDuration]);
 84:   return currentText;
 85: };
 86: // Animated counter component
 87: const AnimatedCounter = ({
 88:   target,
 89:   suffix = "",
 90:   duration = 2,
 91:   decimals = 0,
 92: }: {
 93:   target: number;
 94:   suffix?: string;
 95:   duration?: number;
 96:   decimals?: number;
 97: }) => {
 98:   const [count, setCount] = useState(0);
 99:   const [isVisible, setIsVisible] = useState(false);
100:   const ref = useRef<HTMLSpanElement>(null);
101:   useEffect(() => {
102:     const observer = new IntersectionObserver(
103:       ([entry]) => {
104:         if (entry.isIntersecting && !isVisible) {
105:           setIsVisible(true);
106:         }
107:       },
108:       { threshold: 0.5 },
109:     );
110:     if (ref.current) observer.observe(ref.current);
111:     return () => observer.disconnect();
112:   }, [isVisible]);
113:   useEffect(() => {
114:     if (!isVisible) return;
115:     const steps = 60;
116:     const increment = target / steps;
117:     let current = 0;
118:     const timer = setInterval(() => {
119:       current += increment;
120:       if (current >= target) {
121:         setCount(target);
122:         clearInterval(timer);
123:       } else {
124:         setCount(decimals > 0 ? parseFloat(current.toFixed(decimals)) : Math.floor(current));
125:       }
126:     }, (duration * 1000) / steps);
127:     return () => clearInterval(timer);
128:   }, [isVisible, target, duration, decimals]);
129:   return (
130:     <span ref={ref}>
131:       {decimals > 0 ? count.toFixed(decimals) : count.toLocaleString()}
132:       {suffix}
133:     </span>
134:   );
135: };
