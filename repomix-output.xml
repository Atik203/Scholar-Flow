 865:   tokenCount  Int?
 866:   model       String?
 867:   expiresAt   DateTime?
 868:   paper       Paper?   @relation(fields: [paperId], references: [id], onDelete: Cascade)
 869:   workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
 870:   createdAt   DateTime @default(now())
 871:   updatedAt   DateTime @updatedAt
 872: 
 873:   @@index([paperId, contentType])
 874:   @@index([workspaceId, contentType])
 875:   @@index([expiresAt])
 876: }
