import { NextFunction, Request, Response } from "express";

/**
 * Type for Express route handlers wrapped with catchAsync
 * This fixes TS2742 errors when declaration: true is set
 */
export type AsyncRequestHandler = (
  req: Request,
  res: Response,
  next: NextFunction
