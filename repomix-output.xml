345:   // Invite a user to workspace by email
346:   static async inviteMember(
347:     inviterId: string,
348:     workspaceId: string,
349:     payload: { email: string; role?: string }
350:   ) {
351:     // Only workspace owners and admins can invite members
352:     const workspace = await prisma.$queryRaw<any[]>`
353:       SELECT w.id, w.name, w."ownerId", m.role AS "inviterRole"
354:       FROM "Workspace" w
355:       LEFT JOIN "WorkspaceMember" m ON m."workspaceId" = w.id AND m."userId" = ${inviterId} AND m."isDeleted" = false
356:       WHERE w.id = ${workspaceId} AND w."isDeleted" = false
357:     `;
358:     const ws = workspace[0];
359:     if (!ws) throw new ApiError(404, "Workspace not found");
360:     const isOwner = ws.ownerId === inviterId;
361:     const isOwnerOrManager = ["OWNER", "MANAGER"].includes(ws.inviterRole);
362:     if (!isOwner && !isOwnerOrManager) {
363:       throw new ApiError(
364:         403,
365:         "Only workspace owners and managers can invite members"
366:       );
367:     }
368:     // Find user by email
369:     const user = await prisma.$queryRaw<any[]>`
370:       SELECT id, email, name FROM "User" WHERE email = ${payload.email} AND "isDeleted" = false
371:     `;
372:     if (!user[0]) {
373:       throw new ApiError(404, "User with this email does not exist");
374:     }
375:     const targetUser = user[0];
376:     // Prevent inviting self
377:     if (targetUser.id === inviterId) {
378:       throw new ApiError(400, "You cannot invite yourself");
379:     }
380:     // Check if user is already a member
381:     const existingMember = await prisma.$queryRaw<any[]>`
382:       SELECT id FROM "WorkspaceMember"
383:       WHERE "workspaceId" = ${workspaceId} AND "userId" = ${targetUser.id} AND "isDeleted" = false
384:     `;
385:     if (existingMember[0]) {
386:       throw new ApiError(400, "User is already a member of this workspace");
387:     }
388:     // Check if invitation already exists
389:     const existingInvite = await prisma.$queryRaw<any[]>`
390:       SELECT id, status FROM "WorkspaceInvitation"
391:       WHERE "workspaceId" = ${workspaceId} AND "userId" = ${targetUser.id} AND "isDeleted" = false
392:     `;
393:     if (existingInvite[0]?.status === "PENDING") {
394:       throw new ApiError(400, "User already has a pending invitation");
395:     }
396:     // Create or update invitation
397:     const roleValue = payload.role || "EDITOR";
398:     const invitationResult = await prisma.$queryRaw<any[]>`
399:       INSERT INTO "WorkspaceInvitation" (id, "workspaceId", "userId", role, "invitedById", status, "invitedAt", "createdAt", "updatedAt", "isDeleted")
400:       VALUES (gen_random_uuid(), ${workspaceId}, ${targetUser.id}, ${roleValue}::"WorkspaceRole", ${inviterId}, 'PENDING'::"MembershipStatus", now(), now(), now(), false)
401:       ON CONFLICT ("workspaceId", "userId") DO UPDATE SET
402:         role = ${roleValue}::"WorkspaceRole",
403:         "invitedById" = EXCLUDED."invitedById",
404:         status = 'PENDING'::"MembershipStatus",
405:         "invitedAt" = now(),
406:         "acceptedAt" = null,
407:         "declinedAt" = null,
408:         "isDeleted" = false,
409:         "updatedAt" = now()
410:       RETURNING id
411:     `;
412:     // Send invitation email (similar to collection pattern)
413:     try {
414:       const emailService = (await import("../../shared/emailService")).default;
415:       await emailService.sendWorkspaceInvitationEmail({
416:         email: targetUser.email,
417:         name: targetUser.name || targetUser.email,
418:         workspaceName: ws.name,
419:         inviterName:
420:           (
421:             await prisma.$queryRaw<any[]>`
422:           SELECT name, email FROM "User" WHERE id = ${inviterId}
423:         `
424:           )[0]?.name || "A ScholarFlow user",
425:         workspaceId: workspaceId,
426:       });
427:     } catch (emailError) {
428:       console.error("Failed to send workspace invitation email:", emailError);
429:     }
430:     return { invitationId: invitationResult[0]?.id };
431:   }
432:   // Accept workspace invitation
433:   static async acceptInvitation(userId: string, workspaceId: string) {
434:     const invitation = await prisma.$queryRaw<any[]>`
435:       SELECT wi.id, wi.role, wi.status
436:       FROM "WorkspaceInvitation" wi
437:       WHERE wi."workspaceId" = ${workspaceId} AND wi."userId" = ${userId} AND wi."isDeleted" = false
438:     `;
439:     if (!invitation[0]) {
440:       throw new ApiError(404, "Invitation not found");
441:     }
442:     if (invitation[0].status !== "PENDING") {
443:       throw new ApiError(400, "Invitation is not pending");
444:     }
445:     try {
446:       // Update invitation status and create membership in transaction
447:       await prisma.$transaction(async (tx) => {
448:         await tx.$executeRaw`
449:           UPDATE "WorkspaceInvitation"
450:           SET status = 'ACCEPTED'::"MembershipStatus", "acceptedAt" = now(), "updatedAt" = now()
451:           WHERE id = ${invitation[0].id}
452:         `;
453:         await tx.$executeRaw`
454:           INSERT INTO "WorkspaceMember" (id, "workspaceId", "userId", role, "joinedAt", "createdAt", "updatedAt", "isDeleted")
455:           VALUES (gen_random_uuid(), ${workspaceId}, ${userId}, ${invitation[0].role}::"WorkspaceRole", now(), now(), now(), false)
456:           ON CONFLICT ("workspaceId", "userId") DO UPDATE SET
457:             role = ${invitation[0].role}::"WorkspaceRole",
458:             "isDeleted" = false,
459:             "joinedAt" = now(),
460:             "updatedAt" = now()
461:         `;
462:         // Add activity log
463:         await tx.$executeRaw`
464:           INSERT INTO "ActivityLog" (id, "userId", "workspaceId", entity, "entityId", action, "createdAt", "updatedAt", "isDeleted")
465:           VALUES (gen_random_uuid(), ${userId}, ${workspaceId}, 'Workspace', ${workspaceId}, 'JOIN', now(), now(), false)
466:         `;
467:       });
468:       return { success: true };
469:     } catch (error) {
470:       throw new ApiError(500, "Failed to accept invitation");
471:     }
472:   }
