174: interface Toast {
175:   id: number;
176:   message: string;
177:   type: "error" | "success" | "info";
178: }
179: function ToastContainer({
180:   toasts,
181:   onDismiss,
182: }: {
183:   toasts: Toast[];
184:   onDismiss: (id: number) => void;
185: }) {
186:   if (toasts.length === 0) return null;
187:   return (
188:     <div className="fixed bottom-4 right-4 z-[100] flex flex-col gap-2 max-w-sm">
189:       <AnimatePresence>
190:         {toasts.map((toast) => (
191:           <motion.div
192:             key={toast.id}
193:             initial={{ opacity: 0, y: 50, scale: 0.9 }}
194:             animate={{ opacity: 1, y: 0, scale: 1 }}
195:             exit={{ opacity: 0, y: 20, scale: 0.9 }}
196:             transition={{ duration: 0.2 }}
197:             className={`flex items-center gap-3 p-4 rounded-lg shadow-lg border ${
198:               toast.type === "error"
199:                 ? "bg-red-50 dark:bg-red-950 border-red-200 dark:border-red-800 text-red-800 dark:text-red-200"
200:                 : toast.type === "success"
201:                   ? "bg-green-50 dark:bg-green-950 border-green-200 dark:border-green-800 text-green-800 dark:text-green-200"
202:                   : "bg-blue-50 dark:bg-blue-950 border-blue-200 dark:border-blue-800 text-blue-800 dark:text-blue-200"
203:             }`}
204:           >
205:             {toast.type === "error" && (
206:               <AlertCircle className="h-5 w-5 flex-shrink-0" />
207:             )}
208:             {toast.type === "success" && (
209:               <CheckCircle className="h-5 w-5 flex-shrink-0" />
210:             )}
211:             {toast.type === "info" && (
212:               <Info className="h-5 w-5 flex-shrink-0" />
213:             )}
214:             <p className="text-sm font-medium flex-1">{toast.message}</p>
215:             <button
216:               onClick={() => onDismiss(toast.id)}
217:               className="p-1 rounded hover:bg-black/10 dark:hover:bg-white/10 transition-colors"
218:             >
219:               <X className="h-4 w-4" />
220:             </button>
221:           </motion.div>
222:         ))}
223:       </AnimatePresence>
224:     </div>
225:   );
226: }
