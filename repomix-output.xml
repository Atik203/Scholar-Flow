864:   static async getSettings(userId: string): Promise<TeamSettingsPayload> {
865:     const pref = await prisma.userPreference.findUnique({
866:       where: { userId },
867:       select: { metadata: true },
868:     });
869:     const meta = (pref?.metadata as Record<string, any>) || {};
