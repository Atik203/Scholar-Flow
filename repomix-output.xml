39:         error?.data?.message ||
40:           "Failed to open subscription portal. Please try again."
41:       );
42:     }
43:   };
44:   useEffect(() => {
45:     const handleVisibilityChange = () => {
46:       if (hasOpenedPortalRef.current && !document.hidden) {
47:         console.log(
48:           "[ManageSubscriptionButton] User returned from portal, refreshing data"
49:         );
50:         dispatch(apiSlice.util.invalidateTags(["User"]));
51:         setTimeout(() => {
52:           hasOpenedPortalRef.current = false;
53:         }, 1000);
54:       }
55:     };
56:     const handleFocus = () => {
