246:             <span className="font-medium text-foreground">{crumb.label}</span>
247:           ) : (
248:             <Link href={crumb.href}>
249:                 <span className="text-muted-foreground hover:text-foreground transition-colors">
250:                   {crumb.label}
251:                 </span>
252:             </Link>
253:           )}
254:         </span>
255:       ))}
256:     </nav>
257:   );
258: }
