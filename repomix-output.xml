 28:   replies: any[];
 29:   paperId: string;
 30:   className?: string;
 31: }
 32: export function CommentItem({
 33:   comment,
 34:   replies,
 35:   paperId,
 36:   className = ""
 37: }: CommentItemProps) {
 38:   const [isEditing, setIsEditing] = useState(false);
 39:   const [isReplying, setIsReplying] = useState(false);
 40:   const [editText, setEditText] = useState(comment.text);
 41:   const [updateAnnotation] = useUpdateAnnotationMutation();
 42:   const [deleteAnnotation] = useDeleteAnnotationMutation();
 43:   const handleEdit = () => {
 44:     setIsEditing(true);
 45:     setEditText(comment.text);
 46:   };
 47:   const handleSaveEdit = async () => {
 48:     try {
 49:       await updateAnnotation({
 50:         id: comment.id,
 51:         data: { text: editText.trim() }
 52:       }).unwrap();
 53:       showSuccessToast("Comment updated successfully");
 54:       setIsEditing(false);
 55:     } catch (error: any) {
 56:       showErrorToast(error.data?.message || "Failed to update comment");
 57:     }
 58:   };
 59:   const handleCancelEdit = () => {
 60:     setIsEditing(false);
 61:     setEditText(comment.text);
 62:   };
 63:   const handleDelete = async () => {
 64:     if (window.confirm("Are you sure you want to delete this comment?")) {
 65:       try {
 66:         await deleteAnnotation(comment.id).unwrap();
 67:         showSuccessToast("Comment deleted successfully");
 68:       } catch (error: any) {
 69:         showErrorToast(error.data?.message || "Failed to delete comment");
 70:       }
 71:     }
 72:   };
 73:   const handleReplySuccess = () => {
 74:     setIsReplying(false);
 75:   };
 76:   const isOwner = comment.user.id === comment.userId;
 77:   return (
 78:     <div className={`space-y-3 ${className}`}>
 79:       {}
 80:       <Card>
 81:         <CardContent className="p-4">
 82:           <div className="flex items-start gap-3">
 83:             <Avatar className="h-8 w-8">
 84:               <AvatarImage src={comment.user.image} />
 85:               <AvatarFallback>
 86:                 {comment.user.name?.charAt(0) || "U"}
 87:               </AvatarFallback>
 88:             </Avatar>
 89:             <div className="flex-1 min-w-0">
 90:               <div className="flex items-center gap-2 mb-2">
 91:                 <span className="font-medium text-sm">{comment.user.name}</span>
 92:                 <span className="text-xs text-muted-foreground">
 93:                   {formatDistanceToNow(new Date(comment.createdAt), { addSuffix: true })}
 94:                 </span>
 95:                 {comment.version > 1 && (
 96:                   <Badge variant="outline" className="text-xs">
 97:                     edited
 98:                   </Badge>
 99:                 )}
100:               </div>
101:               {isEditing ? (
102:                 <div className="space-y-2">
103:                   <textarea
104:                     value={editText}
105:                     onChange={(e) => setEditText(e.target.value)}
106:                     className="w-full p-2 border rounded-md resize-none min-h-[60px]"
107:                     autoFocus
108:                   />
109:                   <div className="flex items-center gap-2">
110:                     <Button size="sm" onClick={handleSaveEdit}>
111:                       <Check className="h-3 w-3 mr-1" />
112:                       Save
113:                     </Button>
114:                     <Button size="sm" variant="outline" onClick={handleCancelEdit}>
115:                       <X className="h-3 w-3 mr-1" />
116:                       Cancel
117:                     </Button>
118:                   </div>
119:                 </div>
120:               ) : (
121:                 <div className="space-y-2">
122:                   <p className="text-sm text-foreground whitespace-pre-wrap">
123:                     {comment.text}
124:                   </p>
125:                   <div className="flex items-center gap-2">
126:                     <Button
127:                       variant="ghost"
128:                       size="sm"
129:                       onClick={() => setIsReplying(!isReplying)}
130:                       className="h-7 px-2 text-xs"
131:                     >
132:                       <Reply className="h-3 w-3 mr-1" />
133:                       Reply
134:                     </Button>
135:                     {isOwner && (
136:                       <DropdownMenu>
137:                         <DropdownMenuTrigger asChild>
138:                           <Button variant="ghost" size="sm" className="h-7 w-7 p-0">
139:                             <MoreVertical className="h-3 w-3" />
140:                           </Button>
141:                         </DropdownMenuTrigger>
142:                         <DropdownMenuContent align="end">
143:                           <DropdownMenuItem onClick={handleEdit}>
144:                             <Edit className="h-3 w-3 mr-2" />
145:                             Edit
146:                           </DropdownMenuItem>
147:                           <DropdownMenuItem
148:                             onClick={handleDelete}
149:                             className="text-destructive"
150:                           >
151:                             <Trash2 className="h-3 w-3 mr-2" />
152:                             Delete
153:                           </DropdownMenuItem>
154:                         </DropdownMenuContent>
155:                       </DropdownMenu>
156:                     )}
157:                   </div>
158:                 </div>
159:               )}
160:             </div>
161:           </div>
162:         </CardContent>
163:       </Card>
164:       {}
165:       {isReplying && (
166:         <div className="ml-8">
167:           <CommentForm
168:             paperId={paperId}
169:             parentId={comment.id}
170:             onSuccess={handleReplySuccess}
171:             onCancel={() => setIsReplying(false)}
172:             placeholder={`Reply to ${comment.user.name}...`}
173:           />
174:         </div>
175:       )}
176:       {}
177:       {replies.length > 0 && (
178:         <div className="ml-8 space-y-3">
179:           {replies.map((reply) => (
180:             <CommentItem
181:               key={reply.id}
182:               comment={reply}
183:               replies={[]}
184:               paperId={paperId}
185:             />
186:           ))}
187:         </div>
188:       )}
189:     </div>
