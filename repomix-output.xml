295:   private static extractCitationData(
296:     paper: any,
297:     options: CitationExportRequest
298:   ): CitationData {
299:     const metadata = (paper.metadata as any) || {};
300:     return {
301:       title: paper.title,
302:       authors: this.parseAuthors(
303:         metadata.authors || paper.uploader?.name || "Unknown Author"
304:       ),
305:       journal: metadata.journal || metadata.publication,
306:       year:
307:         metadata.year ||
308:         metadata.publicationYear ||
309:         new Date(paper.createdAt).getFullYear(),
310:       volume: metadata.volume,
311:       issue: metadata.issue,
312:       pages: metadata.pages,
313:       doi: paper.doi || metadata.doi,
314:       url: metadata.url || metadata.link,
315:       publisher: metadata.publisher,
316:       abstract: options.includeAbstract ? paper.abstract : undefined,
317:       keywords: options.includeKeywords ? metadata.keywords : undefined,
318:     };
