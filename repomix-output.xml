13:   className = "",
14: }: AnnotationLayerProps) {
15:   const getAnnotationStyle = (annotation: Annotation) => {
16:     const { coordinates } = annotation.anchor;
17:     const baseStyle = {
18:       position: "absolute" as const,
19:       left: `${coordinates.x}px`,
20:       top: `${coordinates.y}px`,
21:       width: `${coordinates.width}px`,
22:       height: `${coordinates.height}px`,
23:       pointerEvents: "auto" as const,
24:       cursor: "pointer" as const,
25:       zIndex: 10,
26:     };
27:     switch (annotation.type) {
28:       case "HIGHLIGHT":
29:         return {
30:           ...baseStyle,
31:           backgroundColor: "rgba(255, 255, 0, 0.3)",
32:           border: "1px solid rgba(255, 255, 0, 0.6)",
33:         };
34:       case "COMMENT":
35:         return {
36:           ...baseStyle,
37:           backgroundColor: "rgba(59, 130, 246, 0.2)",
38:           border: "1px solid rgba(59, 130, 246, 0.5)",
39:         };
40:       case "NOTE":
41:         return {
42:           ...baseStyle,
43:           backgroundColor: "rgba(34, 197, 94, 0.2)",
44:           border: "1px solid rgba(34, 197, 94, 0.5)",
45:         };
46:       default:
47:         return {
48:           ...baseStyle,
49:           backgroundColor: "rgba(156, 163, 175, 0.2)",
50:           border: "1px solid rgba(156, 163, 175, 0.5)",
51:         };
52:     }
53:   };
54:   const getAnnotationIcon = (type: string) => {
