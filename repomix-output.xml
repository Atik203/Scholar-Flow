343:   private parseAuthors(authors: any): string[] {
344:     if (typeof authors === "string") {
345:       return authors
346:         .split(/[,;]/)
347:         .map((a) => a.trim())
348:         .filter((a) => a);
349:     }
350:     if (Array.isArray(authors)) {
351:       return authors
352:         .map((a) => (typeof a === "string" ? a : a.name || a))
353:         .filter((a) => a);
354:     }
355:     return ["Unknown Author"];
