<file path="apps/frontend/src/app/dashboard/page.tsx">
 1: "use client";
 2: import { getRoleDashboardBasePath } from "@/lib/auth/roles";
 3: import { useAuth } from "@/redux/auth/useAuth";
 4: import { usePathname, useRouter } from "next/navigation";
 5: import { useEffect } from "react";
 6: export default function DashboardIndex() {
 7:   const router = useRouter();
 8:   const pathname = usePathname();
 9:   const { session, status } = useAuth();
10:   useEffect(() => {
11:     if (status !== "unauthenticated") {
12:       return;
13:     }
14:     router.replace("/login?callbackUrl=/dashboard");
15:   }, [router, status]);
16:   useEffect(() => {
17:     if (status !== "authenticated" || !session?.user?.role) {
18:       return;
19:     }
20:     const target = getRoleDashboardBasePath(session.user.role);
21:     if (router && pathname !== target) {
22:       router.replace(target);
23:     }
24:   }, [pathname, router, session?.user?.role, status]);
25:   return (
26:     <div className="min-h-screen flex items-center justify-center">
27:       <div className="h-8 w-8 border-4 border-muted-foreground/30 border-t-primary rounded-full animate-spin" />
28:     </div>
29:   );
30: }
