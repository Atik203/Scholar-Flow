110: export const resourceMonitor = (
111:   req: Request,
112:   res: Response,
113:   next: NextFunction
114: ) => {
115:   const startMemory = process.memoryUsage();
116:   const startCpu = process.cpuUsage();
117:   res.on("finish", () => {
118:     const endMemory = process.memoryUsage();
119:     const endCpu = process.cpuUsage(startCpu);
120:     const memoryDelta = {
121:       rss: endMemory.rss - startMemory.rss,
122:       heapUsed: endMemory.heapUsed - startMemory.heapUsed,
123:       heapTotal: endMemory.heapTotal - startMemory.heapTotal,
124:     };
125:     if (
126:       Math.abs(memoryDelta.heapUsed) > 10 * 1024 * 1024 ||
127:       endCpu.user + endCpu.system > 100000
128:     ) {
129:       console.info("📊 RESOURCE USAGE:", {
130:         method: req.method,
131:         url: req.originalUrl,
132:         memoryDelta: {
133:           rss: `${(memoryDelta.rss / 1024 / 1024).toFixed(2)}MB`,
134:           heapUsed: `${(memoryDelta.heapUsed / 1024 / 1024).toFixed(2)}MB`,
135:           heapTotal: `${(memoryDelta.heapTotal / 1024 / 1024).toFixed(2)}MB`,
136:         },
137:         cpu: {
138:           user: `${(endCpu.user / 1000).toFixed(2)}ms`,
139:           system: `${(endCpu.system / 1000).toFixed(2)}ms`,
140:         },
141:         timestamp: new Date().toISOString(),
142:       });
143:     }
144:   });
145:   next();
146: };
147: export default performanceMonitor;
