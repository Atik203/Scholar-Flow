  7: import { completeOAuthSignIn } from "@/lib/auth/authHelpers";
  8: import { useAppDispatch } from "@/redux/hooks";
  9: import { useRouter, useSearchParams } from "next/navigation";
 10: import { useEffect, useState } from "react";
 11: let _moduleLock = false;
 12: const tryAcquireGlobalLock = (): boolean => {
 13:   if (typeof window === "undefined") return true;
 14:   const globalWindow = window as typeof window & Record<string, boolean>;
 15:   const lockInWindow = globalWindow.__sfGoogleOAuthProcessing === true;
 16:   const lockInStorage = sessionStorage.getItem("__sf_google_oauth_processing__") === "true";
 17:   if (_moduleLock || lockInWindow || lockInStorage) {
 18:     return false;
 19:   }
 20:   _moduleLock = true;
 21:   globalWindow.__sfGoogleOAuthProcessing = true;
 22:   sessionStorage.setItem("__sf_google_oauth_processing__", "true");
 23:   return true;
 24: };
 25: const releaseGlobalLock = (): void => {
 26:   _moduleLock = false;
 27:   if (typeof window === "undefined") return;
 28:   const globalWindow = window as typeof window & Record<string, boolean>;
 29:   delete globalWindow.__sfGoogleOAuthProcessing;
 30:   sessionStorage.removeItem("__sf_google_oauth_processing__");
 31: };
 32: export default function GoogleCallbackPage() {
 33:   const router = useRouter();
 34:   const searchParams = useSearchParams();
 35:   const dispatch = useAppDispatch();
 36:   const [error, setError] = useState<string | null>(null);
 37:   const [isProcessing, setIsProcessing] = useState(false);
 38:   useEffect(() => {
 39:     if (!tryAcquireGlobalLock()) {
 40:       return;
 41:     }
 42:     const handleCallback = async () => {
 43:       try {
 44:         const code = searchParams?.get("code");
 45:         const errorParam = searchParams?.get("error");
 46:         const state = searchParams?.get("state");
 47:         if (!code) {
 48:           if (errorParam) {
 49:             setError(`Google authentication failed: ${errorParam}`);
 50:             showAuthErrorToast(`Authentication failed: ${errorParam}`);
 51:             setTimeout(() => router.push("/login"), 2000);
 52:           }
 53:           return;
 54:         }
 55:         const callbackUrl = state ? decodeURIComponent(state) : "/dashboard";
 56:         const processedCodeKey = `oauth_processed_${code.substring(0, 10)}`;
 57:         if (localStorage.getItem(processedCodeKey)) {
 58:           router.push(callbackUrl);
 59:           return;
 60:         }
 61:         setIsProcessing(true);
 62:         localStorage.setItem(processedCodeKey, Date.now().toString());
 63:         const fiveMinutesAgo = Date.now() - 5 * 60 * 1000;
 64:         Object.keys(localStorage).forEach((key) => {
 65:           if (key.startsWith("oauth_processed_") && parseInt(localStorage.getItem(key) || "0") < fiveMinutesAgo) {
 66:             localStorage.removeItem(key);
 67:           }
 68:         });
 69:         showLoadingToast("Completing Google sign-in...");
 70:         const result = await completeOAuthSignIn("google", code, dispatch);
 71:         if (!result.success) {
 72:           console.error("❌ Google OAuth failed:", result.error);
 73:           setError(result.error || "Google authentication failed");
 74:           showAuthErrorToast(result.error || "Authentication failed");
 75:           setTimeout(() => router.push("/login"), 2000);
 76:           return;
 77:         }
 78:         showAuthSuccessToast("Successfully signed in with Google!");
 79:         await new Promise((resolve) => setTimeout(resolve, 300));
 80:         router.push(callbackUrl);
 81:       } finally {
 82:         releaseGlobalLock();
 83:       }
 84:     };
 85:     handleCallback();
 86:   }, []);
 87:   if (error) {
 88:     return (
 89:       <div className="min-h-screen flex items-center justify-center">
 90:         <div className="text-center">
 91:           <div className="mb-4 text-destructive">
 92:             <svg
 93:               className="h-12 w-12 mx-auto"
 94:               fill="none"
 95:               stroke="currentColor"
 96:               viewBox="0 0 24 24"
 97:             >
 98:               <path
 99:                 strokeLinecap="round"
100:                 strokeLinejoin="round"
101:                 strokeWidth={2}
102:                 d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
103:               />
104:             </svg>
105:           </div>
106:           <h2 className="text-xl font-semibold mb-2">Authentication Failed</h2>
107:           <p className="text-muted-foreground mb-4">{error}</p>
108:           <p className="text-sm text-muted-foreground">
109:             Redirecting to login...
110:           </p>
111:         </div>
112:       </div>
113:     );
114:   }
115:   return (
116:     <div className="min-h-screen flex items-center justify-center">
117:       <div className="text-center">
118:         <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4"></div>
119:         <h2 className="text-xl font-semibold mb-2">
120:           Completing Google sign-in...
121:         </h2>
122:         <p className="text-muted-foreground">
