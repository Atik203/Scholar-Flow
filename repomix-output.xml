 35: function decodeEntities(input: string): string {
 36:   return input
 37:     .replace(/&#x([0-9a-f]+);/gi, (_, hex: string) => String.fromCodePoint(parseInt(hex, 16)))
 38:     .replace(/&#(\d+);/g, (_, dec: string) => String.fromCodePoint(parseInt(dec, 10)))
 39:     .replace(/&lt;/g, "<")
 40:     .replace(/&gt;/g, ">")
 41:     .replace(/&quot;/g, '"')
 42:     .replace(/&#39;/g, "'")
 43:     .replace(/&apos;/g, "'")
 44:     .replace(/&nbsp;/g, " ")
 45:     .replace(/&amp;/g, "&");
 46: }
