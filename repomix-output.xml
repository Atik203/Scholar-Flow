 5: import {
 6:   useDeleteNotificationMutation,
 7:   useGetNotificationsQuery,
 8:   useToggleStarredMutation,
 9: } from "@/redux/api/notificationApi";
10: import { NotificationList } from "@/components/notifications/NotificationList";
11: export default function NotificationHistoryPage() {
12:   const [cursorStack, setCursorStack] = useState<string[]>([]);
13:   const limit = 25;
14:   const currentCursor = cursorStack[cursorStack.length - 1] ?? "";
15:   const { data, isLoading, refetch, isFetching } = useGetNotificationsQuery({
16:     cursor: currentCursor || undefined,
17:     limit,
18:   });
19:   const notifications = data?.data ?? [];
20:   const meta = data?.meta;
21:   const hasMore = Boolean(meta?.hasMore);
22:   const nextCursor = meta?.nextCursor;
23:   const [toggleStarred] = useToggleStarredMutation();
24:   const [deleteNotification] = useDeleteNotificationMutation();
25:   const goNext = () => {
26:     if (nextCursor) {
27:       setCursorStack((prev) => [...prev, nextCursor]);
28:     }
29:   };
30:   const goPrev = () => {
31:     setCursorStack((prev) => prev.slice(0, -1));
32:   };
33:   return (
34:     <div className="space-y-6 pb-12 min-h-screen">
35:       <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
36:         <div className="flex items-center gap-3">
37:           <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-md">
38:             <Bell className="w-6 h-6 text-white" />
39:           </div>
40:           <div>
41:             <h1 className="text-3xl font-bold tracking-tight">History</h1>
42:             <p className="text-muted-foreground">
43:               {meta?.total ?? 0} total notifications
44:             </p>
45:           </div>
46:         </div>
47:         <Button
48:           variant="outline"
49:           size="icon"
50:           onClick={refetch}
51:           disabled={isFetching}
52:           title="Refresh"
53:         >
54:           <RefreshCw
55:             className={`w-4 h-4 ${isFetching ? "animate-spin" : ""}`}
56:           />
57:         </Button>
58:       </div>
59:       <NotificationList
60:         notifications={notifications}
61:         isLoading={isLoading}
62:         onToggleStarred={(id) => toggleStarred(id)}
63:         onDelete={(id) => deleteNotification(id)}
64:         showFilters={false}
65:         emptyStateTitle="No history yet"
66:         emptyStateMessage="Notifications you receive will be archived here."
67:       />
68:       {(cursorStack.length > 0 || hasMore) && (
69:         <div className="flex items-center justify-between pt-4">
70:           <Button
71:             variant="outline"
72:             size="sm"
73:             onClick={goPrev}
74:             disabled={cursorStack.length === 0}
75:           >
76:             <ChevronLeft className="w-4 h-4 mr-2" />
77:             Previous
78:           </Button>
79:           <span className="text-sm text-muted-foreground">
80:             Page {cursorStack.length + 1}
81:           </span>
82:           <Button
83:             variant="outline"
84:             size="sm"
85:             onClick={goNext}
86:             disabled={!hasMore}
87:           >
88:             Next
89:             <ChevronRight className="w-4 h-4 ml-2" />
90:           </Button>
91:         </div>
92:       )}
93:     </div>
94:   );
95: }
</file>

