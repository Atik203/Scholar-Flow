  1: import { Prisma, NotificationType } from "@prisma/client";
  2: import prisma from "../../shared/prisma";
  3: import ApiError from "../../errors/ApiError";
  4: const NotificationService = {
  5:   async listNotifications(
  6:     userId: string,
  7:     limit: number,
  8:     skip: number,
  9:     query: {
 10:       type?: string;
 11:       read?: string;
 12:       starred?: string;
 13:     }
 14:   ) {
 15:     const where: Prisma.NotificationWhereInput = { userId };
 16:     if (query.type && query.type !== "all") {
 17:       where.type = query.type as NotificationType;
 18:     }
 19:     if (query.read === "unread") {
 20:       where.read = false;
 21:     } else if (query.read === "read") {
 22:       where.read = true;
 23:     }
 24:     if (query.starred === "true") {
 25:       where.starred = true;
 26:     } else if (query.starred === "false") {
 27:       where.starred = false;
 28:     }
 29:     const [total, data] = await Promise.all([
 30:       prisma.notification.count({ where }),
 31:       prisma.notification.findMany({
 32:         where,
 33:         take: limit,
 34:         skip,
 35:         orderBy: { createdAt: "desc" },
 36:         include: {
 37:           actor: {
 38:             select: { name: true, image: true, firstName: true, lastName: true },
 39:           },
 40:         },
 41:       }),
 42:     ]);
 43:     const formattedData = data.map((n) => ({
 44:       ...n,
 45:       actor: n.actor
 46:         ? {
 47:             name:
 48:               n.actor.name ||
 49:               `${n.actor.firstName || ""} ${n.actor.lastName || ""}`.trim() ||
 50:               "Unknown",
 51:             image: n.actor.image,
 52:           }
 53:         : undefined,
 54:     }));
 55:     return {
 56:       meta: { total, skip, limit },
 57:       result: formattedData,
 58:     };
 59:   },
 60:   async getUnreadCount(userId: string) {
 61:     const count = await prisma.notification.count({
 62:       where: { userId, read: false },
 63:     });
 64:     return { count };
 65:   },
 66:   async markAsRead(userId: string, notificationId: string) {
 67:     const notification = await prisma.notification.findUnique({
 68:       where: { id: notificationId },
 69:     });
 70:     if (!notification || notification.userId !== userId) {
 71:       throw new ApiError(404, "Notification not found");
 72:     }
 73:     return prisma.notification.update({
 74:       where: { id: notificationId },
