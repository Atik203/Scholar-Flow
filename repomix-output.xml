469:   const subscriptionField = getSubscriptionFromInvoice(invoice);
470:   if (!subscriptionField) {
471:     return;
472:   }
473:   const subscriptionId =
474:     typeof subscriptionField === "string"
475:       ? subscriptionField
476:       : subscriptionField.id;
477:   // Find subscription
478:   const subscription = await prismaClient.$queryRaw<
