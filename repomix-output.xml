 16:   email: string,
 17:   password: string,
 18:   dispatch: AppDispatch,
 19:   twoFactorCode?: string
 20: ): Promise<{ success: boolean; error?: string; needsTwoFactor?: boolean }> {
 21:   try {
 22:     const response = await fetch(`${API_BASE_URL}/auth/signin`, {
 23:       method: "POST",
 24:       headers: { "Content-Type": "application/json" },
 25:       body: JSON.stringify({ email, password, twoFactorCode }),
 26:     });
 27:     const data: AuthResponse = await response.json();
 28:     if (!response.ok || !data.success) {
 29:       const message = data.message || "Invalid email or password";
 30:       return {
 31:         success: false,
 32:         error: message,
 33:         needsTwoFactor: message === "TWO_FACTOR_REQUIRED",
 34:       };
 35:     }
 36:     if (!data.data?.user || !data.data?.accessToken) {
 37:       return {
 38:         success: false,
 39:         error: "Authentication response was incomplete",
 40:       };
 41:     }
 42:     dispatch(
 43:       setCredentials({
 44:         user: data.data.user,
 45:         accessToken: data.data.accessToken,
 46:         sessionToken: data.data.sessionToken,
 47:       })
 48:     );
 49:     document.cookie = `sf_last_auth=credentials; path=/; max-age=604800; samesite=lax`;
 50:     await flushAuthState();
 51:     return { success: true };
 52:   } catch (error) {
 53:     console.error("Sign-in error:", error);
 54:     return {
 55:       success: false,
 56:       error: "An unexpected error occurred. Please try again.",
 57:     };
 58:   }
 59: }
