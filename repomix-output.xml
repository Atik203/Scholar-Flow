1412:         cp."collectionId" AS cp_collectionId,
1413:         cp."paperId" AS cp_paperId,
1414:         cp."addedById" AS cp_addedById,
1415:         cp."addedAt" AS cp_addedAt,
1416:         cp."createdAt" AS cp_createdAt,
1417:         cp."updatedAt" AS cp_updatedAt,
1418:         p.id AS paper_id,
1419:         p."workspaceId" AS paper_workspaceId,
1420:         p."uploaderId" AS paper_uploaderId,
1421:         p.title AS paper_title,
1422:         p.abstract AS paper_abstract,
1423:         p.metadata AS paper_metadata,
1424:         p.source AS paper_source,
1425:         p.doi AS paper_doi,
1426:         p."processingStatus" AS paper_processingStatus,
1427:         p."createdAt" AS paper_createdAt,
1428:         p."updatedAt" AS paper_updatedAt,
1429:         pf.id AS file_id,
1430:         pf."storageProvider" AS file_storageProvider,
1431:         pf."objectKey" AS file_objectKey,
1432:         pf."contentType" AS file_contentType,
1433:         pf."sizeBytes" AS file_sizeBytes,
1434:         pf."originalFilename" AS file_originalFilename,
1435:         u.id AS uploader_id,
1436:         u.name AS uploader_name,
1437:         u.email AS uploader_email
1438:       FROM "CollectionPaper" cp
1439:       JOIN "Paper" p ON p.id = cp."paperId"
1440:       LEFT JOIN "PaperFile" pf ON pf."paperId" = p.id AND pf."isDeleted" = false
1441:       JOIN "User" u ON u.id = p."uploaderId"
