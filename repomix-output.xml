  1: import {
  2:   createCipheriv,
  3:   createDecipheriv,
  4:   createHmac,
  5:   randomBytes,
  6: } from "crypto";
  7: const SECRET_LENGTH = 20;
  8: const TIME_STEP = 30;
  9: const DIGITS = 6;
 10: const key = (): Buffer => {
 11:   const secret = process.env.NEXTAUTH_SECRET;
 12:   if (!secret) {
 13:     throw new Error("NEXTAUTH_SECRET is not configured");
 14:   }
 15:   return createHmac("sha256", "scholarflow-2fa-key-v1").update(secret).digest();
 16: };
 17: const base32Encode = (buf: Buffer): string => {
 18:   const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
 19:   let bits = 0;
 20:   let value = 0;
 21:   let out = "";
 22:   for (const byte of buf) {
 23:     value = (value << 8) | byte;
 24:     bits += 8;
 25:     while (bits >= 5) {
 26:       out += alphabet[(value >>> (bits - 5)) & 31];
 27:       bits -= 5;
 28:     }
 29:   }
 30:   if (bits > 0) {
 31:     out += alphabet[(value << (5 - bits)) & 31];
 32:   }
 33:   return out;
 34: };
 35: const base32Decode = (b32: string): Buffer => {
 36:   const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
 37:   let bits = 0;
 38:   let value = 0;
 39:   const output: number[] = [];
 40:   for (const char of b32.toUpperCase().replace(/=+$/, "")) {
 41:     const idx = alphabet.indexOf(char);
 42:     if (idx === -1) continue;
 43:     value = (value << 5) | idx;
 44:     bits += 5;
 45:     if (bits >= 8) {
 46:       output.push((value >>> (bits - 8)) & 0xff);
 47:       bits -= 8;
 48:     }
 49:   }
 50:   return Buffer.from(output);
 51: };
 52: export const generateTotpSecret = (): string => {
 53:   // Base32 (RFC 4648 alphabet) — the format authenticator apps expect.
 54:   return base32Encode(randomBytes(SECRET_LENGTH));
 55: };
 56: const totpCounter = (now = Date.now()): number => {
 57:   return Math.floor(now / 1000 / TIME_STEP);
 58: };
 59: const hotp = (secret: string, counter: number): string => {
 60:   const msg = Buffer.alloc(8);
 61:   let c = counter;
 62:   for (let i = 7; i >= 0; i--) {
 63:     msg[i] = c & 0xff;
 64:     c = Math.floor(c / 256);
 65:   }
 66:   const h = createHmac("sha1", base32Decode(secret)).update(msg).digest();
 67:   const offset = h[h.length - 1] & 0x0f;
 68:   const bin =
 69:     ((h[offset] & 0x7f) << 24) |
 70:     ((h[offset + 1] & 0xff) << 16) |
 71:     ((h[offset + 2] & 0xff) << 8) |
 72:     (h[offset + 3] & 0xff);
 73:   return String(bin % 10 ** DIGITS).padStart(DIGITS, "0");
 74: };
 75: export const verifyTotp = (
 76:   token: string,
 77:   secret: string,
 78:   window = 1
 79: ): boolean => {
 80:   if (!/^\d{6}$/.test(token)) return false;
 81:   const counter = totpCounter();
 82:   for (let w = -window; w <= window; w++) {
 83:     if (hotp(secret, counter + w) === token) return true;
 84:   }
 85:   return false;
 86: };
 87: export const buildOtpAuthUrl = (email: string, secret: string): string => {
 88:   return `otpauth://totp/ScholarFlow:${encodeURIComponent(email)}?secret=${secret}&issuer=ScholarFlow`;
 89: };
 90: export const encryptTotpSecret = (plain: string): string => {
 91:   const iv = randomBytes(12);
 92:   const cipher = createCipheriv("aes-256-gcm", key(), iv);
 93:   const encrypted = Buffer.concat([cipher.update(plain, "utf8"), cipher.final()]);
 94:   const tag = cipher.getAuthTag();
 95:   return `${iv.toString("hex")}:${tag.toString("hex")}:${encrypted.toString("hex")}`;
 96: };
 97: export const decryptTotpSecret = (payload: string): string | null => {
 98:   try {
 99:     const [ivHex, tagHex, dataHex] = payload.split(":");
100:     if (!ivHex || !tagHex || !dataHex) return null;
101:     const decipher = createDecipheriv(
102:       "aes-256-gcm",
103:       key(),
104:       Buffer.from(ivHex, "hex")
105:     );
106:     decipher.setAuthTag(Buffer.from(tagHex, "hex"));
107:     const out = Buffer.concat([
108:       decipher.update(Buffer.from(dataHex, "hex")),
109:       decipher.final(),
110:     ]);
111:     return out.toString("utf8");
112:   } catch {
113:     return null;
114:   }
115: };
