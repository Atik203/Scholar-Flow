188:       FROM "WorkspaceMember" m JOIN "Workspace" w ON w.id = m."workspaceId"
189:       WHERE m."userId" = ${userId} AND m."workspaceId" = ${id} AND m."isDeleted" = false AND w."isDeleted" = false
190:     `;
