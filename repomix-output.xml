<file path="apps/backend/src/app/services/activityLog.service.ts">
  1: import prisma from "../shared/prisma";
  2: import ApiError from "../errors/ApiError";
  3: import { AuthRequest } from "../middleware/auth";
  4: export interface ActivityLogFilters {
  5:   userId?: string;
  6:   workspaceId?: string;
  7:   entity?: string;
  8:   entityId?: string;
  9:   action?: string;
 10:   severity?: 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL';
 11:   startDate?: Date;
 12:   endDate?: Date;
 13:   limit?: number;
 14:   offset?: number;
 15: }
 16: export interface ActivityLogEntry {
 17:   id: string;
 18:   userId?: string | null;
 19:   workspaceId?: string | null;
 20:   entity: string;
 21:   entityId: string;
 22:   action: string;
 23:   details?: any;
 24:   metadata?: any;
 25:   severity: 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL';
 26:   createdAt: Date;
 27:   user?: {
 28:     id: string;
 29:     name?: string | null;
 30:     firstName?: string | null;
 31:     lastName?: string | null;
 32:     image?: string | null;
 33:   } | null;
 34:   workspace?: {
 35:     id: string;
 36:     name: string;
 37:   } | null;
 38: }
 39: export class ActivityLogService {
 40:   static async logActivity(
 41:     userId: string | null,
 42:     workspaceId: string | null,
 43:     entity: string,
 44:     entityId: string,
 45:     action: string,
 46:     details?: any,
 47:     metadata?: any,
 48:     severity: 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL' = 'INFO'
 49:   ): Promise<void> {
 50:     try {
 51:       await prisma.activityLogEntry.create({
 52:         data: {
 53:           userId,
 54:           workspaceId,
 55:           entity,
 56:           entityId,
 57:           action,
 58:           details,
 59:           metadata,
 60:           severity
 61:         }
 62:       });
 63:     } catch (error) {
 64:       console.error('Failed to log activity:', error);
 65:     }
 66:   }
 67:   static async getActivityLog(
 68:     req: AuthRequest,
 69:     filters: ActivityLogFilters
 70:   ): Promise<{ entries: ActivityLogEntry[]; total: number }> {
 71:     const currentUserId = req.user?.id;
 72:     if (!currentUserId) {
 73:       throw new ApiError(401, 'User not authenticated');
 74:     }
 75:     try {
 76:       const where: any = {
 77:         isDeleted: false
 78:       };
 79:       if (filters.userId) {
 80:         where.userId = filters.userId;
 81:       }
 82:       if (filters.workspaceId) {
 83:         where.workspaceId = filters.workspaceId;
 84:         const workspace = await prisma.workspace.findFirst({
 85:           where: {
 86:             id: filters.workspaceId,
 87:             isDeleted: false,
 88:             OR: [
 89:               { ownerId: currentUserId },
 90:               {
 91:                 members: {
 92:                   some: {
 93:                     userId: currentUserId,
 94:                     isDeleted: false
 95:                   }
 96:                 }
 97:               }
 98:             ]
 99:           }
100:         });
101:         if (!workspace) {
102:           throw new ApiError(404, 'Workspace not found or access denied');
103:         }
104:       }
105:       if (filters.entity) {
106:         where.entity = filters.entity;
107:       }
108:       if (filters.entityId) {
109:         where.entityId = filters.entityId;
110:       }
111:       if (filters.action) {
112:         where.action = filters.action;
113:       }
114:       if (filters.severity) {
115:         where.severity = filters.severity;
116:       }
117:       if (filters.startDate || filters.endDate) {
118:         where.createdAt = {};
119:         if (filters.startDate) {
120:           where.createdAt.gte = filters.startDate;
121:         }
122:         if (filters.endDate) {
123:           where.createdAt.lte = filters.endDate;
124:         }
125:       }
126:       if (!filters.workspaceId && !filters.userId) {
127:         const userWorkspaces = await prisma.workspace.findMany({
128:           where: {
129:             isDeleted: false,
130:             OR: [
131:               { ownerId: currentUserId },
132:               {
133:                 members: {
134:                   some: {
135:                     userId: currentUserId,
136:                     isDeleted: false
137:                   }
138:                 }
139:               }
140:             ]
141:           },
142:           select: { id: true }
143:         });
144:         const workspaceIds = userWorkspaces.map((w: any) => w.id);
145:         where.OR = [
146:           { workspaceId: { in: workspaceIds } },
147:           { userId: currentUserId }
148:         ];
149:       }
150:       const [entries, total] = await Promise.all([
151:         prisma.activityLogEntry.findMany({
152:           where,
153:           include: {
154:             user: {
155:               select: {
156:                 id: true,
157:                 name: true,
158:                 firstName: true,
159:                 lastName: true,
160:                 image: true
161:               }
162:             },
163:             workspace: {
164:               select: {
165:                 id: true,
166:                 name: true
167:               }
168:             }
169:           },
170:           orderBy: {
171:             createdAt: 'desc'
172:           },
173:           take: filters.limit || 50,
174:           skip: filters.offset || 0
175:         }),
176:         prisma.activityLogEntry.count({ where })
177:       ]);
178:       return { entries, total };
179:     } catch (error) {
180:       if (error instanceof ApiError) throw error;
181:       throw new ApiError(500, 'Failed to fetch activity log');
182:     }
183:   }
184:   static async getActivitySummary(
185:     req: AuthRequest,
186:     workspaceId?: string,
187:     days: number = 7
188:   ): Promise<{
189:     totalActivities: number;
190:     activitiesByType: { [key: string]: number };
191:     activitiesBySeverity: { [key: string]: number };
192:     recentActivities: ActivityLogEntry[];
193:     trends: { [key: string]: number };
194:   }> {
195:     const userId = req.user?.id;
196:     if (!userId) {
197:       throw new ApiError(401, 'User not authenticated');
198:     }
199:     const startDate = new Date();
200:     startDate.setDate(startDate.getDate() - days);
201:     try {
202:       const where: any = {
203:         isDeleted: false,
204:         createdAt: {
205:           gte: startDate
206:         }
207:       };
208:       if (workspaceId) {
209:         where.workspaceId = workspaceId;
210:         const workspace = await prisma.workspace.findFirst({
211:           where: {
212:             id: workspaceId,
213:             isDeleted: false,
214:             OR: [
215:               { ownerId: userId },
216:               {
217:                 members: {
218:                   some: {
219:                     userId: userId,
220:                     isDeleted: false
221:                   }
222:                 }
223:               }
224:             ]
225:           }
226:         });
227:         if (!workspace) {
228:           throw new ApiError(404, 'Workspace not found or access denied');
229:         }
230:       } else {
231:         const userWorkspaces = await prisma.workspace.findMany({
232:           where: {
233:             isDeleted: false,
234:             OR: [
235:               { ownerId: userId },
236:               {
237:                 members: {
238:                   some: {
239:                     userId: userId,
240:                     isDeleted: false
241:                   }
242:                 }
243:               }
244:             ]
245:           },
246:           select: { id: true }
247:         });
248:         const workspaceIds = userWorkspaces.map((w: any) => w.id);
249:         where.OR = [
250:           { workspaceId: { in: workspaceIds } },
251:           { userId: userId }
252:         ];
253:       }
254:       const [totalActivities, activitiesByType, activitiesBySeverity, recentActivities] = await Promise.all([
255:         prisma.activityLogEntry.count({ where }),
256:         prisma.activityLogEntry.groupBy({
257:           by: ['entity'],
258:           where,
259:           _count: {
260:             entity: true
261:           }
262:         }),
263:         prisma.activityLogEntry.groupBy({
264:           by: ['severity'],
265:           where,
266:           _count: {
267:             severity: true
268:           }
269:         }),
270:         prisma.activityLogEntry.findMany({
271:           where,
272:           include: {
273:             user: {
274:               select: {
275:                 id: true,
276:                 name: true,
277:                 firstName: true,
278:                 lastName: true,
279:                 image: true
280:               }
281:             },
282:             workspace: {
283:               select: {
284:                 id: true,
285:                 name: true
286:               }
287:             }
288:           },
289:           orderBy: {
290:             createdAt: 'desc'
291:           },
292:           take: 10
293:         })
294:       ]);
295:       const trends: { [key: string]: number } = {};
296:       for (let i = 0; i < days; i++) {
297:         const date = new Date();
298:         date.setDate(date.getDate() - i);
299:         const dayStart = new Date(date);
300:         dayStart.setHours(0, 0, 0, 0);
301:         const dayEnd = new Date(date);
302:         dayEnd.setHours(23, 59, 59, 999);
303:         const dayActivities = await prisma.activityLogEntry.count({
304:           where: {
305:             ...where,
306:             createdAt: {
307:               gte: dayStart,
308:               lte: dayEnd
309:             }
310:           }
311:         });
312:         trends[date.toISOString().split('T')[0]] = dayActivities;
313:       }
314:       return {
315:         totalActivities,
316:         activitiesByType: activitiesByType.reduce((acc: any, item: any) => {
317:           acc[item.entity] = item._count.entity;
318:           return acc;
319:         }, {} as { [key: string]: number }),
320:         activitiesBySeverity: activitiesBySeverity.reduce((acc: any, item: any) => {
321:           acc[item.severity] = item._count.severity;
322:           return acc;
323:         }, {} as { [key: string]: number }),
324:         recentActivities,
325:         trends
326:       };
327:     } catch (error) {
328:       if (error instanceof ApiError) throw error;
329:       throw new ApiError(500, 'Failed to fetch activity summary');
330:     }
331:   }
332:   static async getEntityActivity(
333:     req: AuthRequest,
334:     entity: string,
335:     entityId: string
336:   ): Promise<ActivityLogEntry[]> {
337:     const userId = req.user?.id;
338:     if (!userId) {
339:       throw new ApiError(401, 'User not authenticated');
340:     }
341:     try {
342:       let hasAccess = false;
343:       switch (entity) {
344:         case 'paper':
345:           const paper = await prisma.paper.findFirst({
346:             where: {
347:               id: entityId,
348:               isDeleted: false,
349:               OR: [
350:                 { uploaderId: userId },
351:                 {
352:                   workspace: {
353:                     members: {
354:                       some: {
355:                         userId: userId,
356:                         isDeleted: false
357:                       }
358:                     }
359:                   }
360:                 }
361:               ]
362:             }
363:           });
364:           hasAccess = !!paper;
365:           break;
366:         case 'collection':
367:           const collection = await prisma.collection.findFirst({
368:             where: {
369:               id: entityId,
370:               isDeleted: false,
371:               OR: [
372:                 { ownerId: userId },
373:                 {
374:                   members: {
375:                     some: {
376:                       userId: userId,
377:                       status: 'ACCEPTED',
378:                       isDeleted: false
379:                     }
380:                   }
381:                 }
382:               ]
383:             }
384:           });
385:           hasAccess = !!collection;
386:           break;
387:         case 'workspace':
388:           const workspace = await prisma.workspace.findFirst({
389:             where: {
390:               id: entityId,
391:               isDeleted: false,
392:               OR: [
393:                 { ownerId: userId },
394:                 {
395:                   members: {
396:                     some: {
397:                       userId: userId,
398:                       isDeleted: false
399:                     }
400:                   }
401:                 }
402:               ]
403:             }
404:           });
405:           hasAccess = !!workspace;
406:           break;
407:         case 'discussion':
408:           const discussion = await prisma.discussionThread.findFirst({
409:             where: {
410:               id: entityId,
411:               isDeleted: false,
412:               OR: [
413:                 { userId },
414:                 { paperId: { not: null } },
415:                 { collectionId: { not: null } },
416:                 { workspaceId: { not: null } }
417:               ]
