<file path="apps/frontend/src/components/billing/ManageSubscriptionButton.tsx">
 1: "use client";
 2: import { Button } from "@/components/ui/button";
 3: import { apiSlice } from "@/redux/api/apiSlice";
 4: import { useCreatePortalSessionMutation } from "@/redux/api/billingApi";
 5: import { useAppDispatch } from "@/redux/hooks";
 6: import { Loader2 } from "lucide-react";
 7: import { useEffect, useRef } from "react";
 8: import { toast } from "sonner";
 9: interface ManageSubscriptionButtonProps {
10:   className?: string;
11:   variant?:
12:     | "default"
13:     | "outline"
14:     | "ghost"
15:     | "link"
16:     | "destructive"
17:     | "secondary";
18: }
19: export function ManageSubscriptionButton({
20:   className,
21:   variant = "default",
22: }: ManageSubscriptionButtonProps) {
23:   const [createPortal, { isLoading }] = useCreatePortalSessionMutation();
24:   const dispatch = useAppDispatch();
25:   const hasOpenedPortalRef = useRef(false);
26:   const returnCheckIntervalRef = useRef<NodeJS.Timeout | null>(null);
27:   const handleManageSubscription = async () => {
28:     try {
29:       const response = (await createPortal({}).unwrap()) as any;
30:       if (response?.data?.url) {
31:         hasOpenedPortalRef.current = true;
32:         window.location.href = response.data.url;
33:       } else {
34:         throw new Error("No portal URL received");
35:       }
36:     } catch (error: any) {
37:       console.error("Error creating portal session:", error);
38:       toast.error(
39:         error?.data?.message ||
40:           "Failed to open subscription portal. Please try again."
41:       );
42:     }
43:   };
44:   useEffect(() => {
45:     const handleVisibilityChange = () => {
46:       if (hasOpenedPortalRef.current && !document.hidden) {
47:         console.log(
48:           "[ManageSubscriptionButton] User returned from portal, refreshing data"
49:         );
50:         dispatch(apiSlice.util.invalidateTags(["User"]));
51:         setTimeout(() => {
52:           hasOpenedPortalRef.current = false;
53:         }, 1000);
54:       }
55:     };
56:     const handleFocus = () => {
57:       if (hasOpenedPortalRef.current) {
58:         console.log(
59:           "[ManageSubscriptionButton] Window focused after portal, refreshing data"
60:         );
61:         dispatch(apiSlice.util.invalidateTags(["User"]));
62:         setTimeout(() => {
63:           hasOpenedPortalRef.current = false;
64:         }, 1000);
65:       }
66:     };
67:     document.addEventListener("visibilitychange", handleVisibilityChange);
68:     window.addEventListener("focus", handleFocus);
69:     const intervalRef = returnCheckIntervalRef.current;
70:     return () => {
71:       document.removeEventListener("visibilitychange", handleVisibilityChange);
72:       window.removeEventListener("focus", handleFocus);
73:       if (intervalRef) {
74:         clearInterval(intervalRef);
75:       }
76:     };
77:   }, [dispatch]);
78:   return (
79:     <Button
80:       onClick={handleManageSubscription}
81:       disabled={isLoading}
82:       className={className}
83:       variant={variant}
84:     >
85:       {isLoading ? (
86:         <>
87:           <Loader2 className="mr-2 h-4 w-4 animate-spin" />
88:           Loading...
89:         </>
90:       ) : (
91:         "Manage Subscription"
92:       )}
93:     </Button>
94:   );
95: }
</file>

