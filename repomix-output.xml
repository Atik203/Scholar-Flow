310:           GROUP BY "collectionId"
311:         ) paper_counts ON paper_counts."collectionId" = c.id
312:         LEFT JOIN (
313:           SELECT "collectionId", COUNT(*)::int AS member_count
314:           FROM "CollectionMember"
315:           WHERE "isDeleted" = false AND status = 'ACCEPTED'
316:           GROUP BY "collectionId"
317:         ) member_counts ON member_counts."collectionId" = c.id
318:         WHERE c."isDeleted" = false
319:           AND (
320:             c.name ILIKE ${`%${searchTerm}%`}
321:             OR c.description ILIKE ${`%${searchTerm}%`}
322:           )
323:         ORDER BY relevance_score DESC, c."createdAt" DESC
324:         LIMIT ${limit} OFFSET ${skip}
325:       `;
326:       const transformedCollections = collections.map((collection) => ({
327:         ...collection,
328:         owner: {
