 40:           coordinates: { x: 0, y: 0, width: 0, height: 0 },
 41:         },
 42:       }).unwrap();
 43:       showSuccessToast("Comment added successfully");
 44:       setText("");
 45:       onSuccess();
 46:     } catch (error: any) {
 47:       showErrorToast(error.data?.message || "Failed to add comment");
 48:     } finally {
 49:       setIsSubmitting(false);
 50:     }
 51:   };
 52:   const handleKeyDown = (e: React.KeyboardEvent) => {
 53:     if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
 54:       handleSubmit(e);
 55:     } else if (e.key === "Escape") {
 56:       onCancel();
 57:     }
 58:   };
 59:   return (
 60:     <form onSubmit={handleSubmit} className={`space-y-3 ${className}`}>
 61:       <div className="space-y-2">
 62:         <Label htmlFor="comment-text">
 63:           {parentId ? "Reply to comment" : "Add a comment"}
 64:         </Label>
 65:         <Textarea
 66:           id="comment-text"
 67:           value={text}
 68:           onChange={(e) => setText(e.target.value)}
 69:           onKeyDown={handleKeyDown}
 70:           placeholder={placeholder}
 71:           className="min-h-[100px] resize-none"
 72:           disabled={isSubmitting}
 73:           autoFocus
 74:         />
 75:         <div className="text-xs text-muted-foreground">
