 69:           `${trimmedName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`,
 70:           `${trimmedName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; secure;`,
 71:           `${trimmedName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${window.location.hostname};`,
 72:         ];
