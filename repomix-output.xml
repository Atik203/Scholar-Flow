<file path="apps/backend/src/app/errors/handlePostgresError.ts">
  1: import { TErrorSources, TGenericErrorResponse } from "../interfaces/error";
  2: const handlePostgresError = (err: any): TGenericErrorResponse => {
  3:   let message = "Database Error";
  4:   let statusCode = 500;
  5:   let errorSources: TErrorSources = [];
  6:   switch (err.code) {
  7:     case "23505": {
  8:       statusCode = 409;
  9:       message = "Duplicate entry";
 10:       const field = err.detail?.match(/Key \(([^)]+)\)=/)?.[1] || "field";
 11:       errorSources = [
 12:         {
 13:           path: field,
 14:           message: `${field} already exists`,
 15:         },
 16:       ];
 17:       break;
 18:     }
 19:     case "23503":
 20:       statusCode = 400;
 21:       message = "Foreign key constraint violation";
 22:       errorSources = [
 23:         {
 24:           path: "reference",
 25:           message: "Referenced record does not exist",
 26:         },
 27:       ];
 28:       break;
 29:     case "23502": {
 30:       statusCode = 400;
 31:       message = "Required field missing";
 32:       const column = err.column || "column";
 33:       errorSources = [
 34:         {
 35:           path: column,
 36:           message: `${column} is required`,
 37:         },
 38:       ];
 39:       break;
 40:     }
 41:     case "23514":
 42:       statusCode = 400;
 43:       message = "Data validation failed";
 44:       errorSources = [
 45:         {
 46:           path: err.constraint || "unknown",
 47:           message: err.detail || "Check constraint violation",
 48:         },
 49:       ];
 50:       break;
 51:     case "42P01":
 52:       statusCode = 500;
 53:       message = "Table does not exist";
 54:       errorSources = [
 55:         {
 56:           path: "database",
 57:           message: "The requested table does not exist",
 58:         },
 59:       ];
 60:       break;
 61:     case "42703":
 62:       statusCode = 500;
 63:       message = "Column does not exist";
 64:       errorSources = [
 65:         {
 66:           path: "database",
 67:           message: "The requested column does not exist",
 68:         },
 69:       ];
 70:       break;
 71:     case "08003":
 72:       statusCode = 500;
 73:       message = "Database connection error";
 74:       errorSources = [
 75:         {
 76:           path: "database",
 77:           message: "Failed to connect to the database",
 78:         },
 79:       ];
 80:       break;
 81:     case "08006":
 82:       statusCode = 500;
 83:       message = "Database connection failed";
 84:       errorSources = [
 85:         {
 86:           path: "database",
 87:           message: "Database connection was lost",
 88:         },
 89:       ];
 90:       break;
 91:     case "53300":
 92:       statusCode = 503;
 93:       message = "Service temporarily unavailable";
 94:       errorSources = [
 95:         {
 96:           path: "database",
 97:           message: "Database is currently overloaded",
 98:         },
 99:       ];
100:       break;
101:     default:
102:       statusCode = 500;
103:       message = "Database error occurred";
104:       errorSources = [
105:         {
106:           path: "database",
107:           message: err.message || "An unexpected database error occurred",
108:         },
109:       ];
110:   }
111:   return {
112:     statusCode,
113:     message,
114:     errorSources,
115:   };
116: };
117: export default handlePostgresError;
</file>

