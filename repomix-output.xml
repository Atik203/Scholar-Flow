<file path="figma-make/components/context/RoleContext.tsx">
  1: "use client";
  2: import {
  3:   createContext,
  4:   ReactNode,
  5:   useContext,
  6:   useEffect,
  7:   useState,
  8: } from "react";
  9: export type UserRole = "researcher" | "pro_researcher" | "team_lead" | "admin";
 10: export const roleDisplayNames: Record<UserRole, string> = {
 11:   researcher: "Researcher",
 12:   pro_researcher: "Pro Researcher",
 13:   team_lead: "Team Lead",
 14:   admin: "Administrator",
 15: };
 16: interface RoleContextType {
 17:   role: UserRole;
 18:   setRole: (role: UserRole) => void;
 19:   isAdmin: boolean;
 20:   isTeamLead: boolean;
 21:   isPro: boolean;
 22:   canManageTeam: boolean;
 23:   canAccessAdmin: boolean;
 24:   displayName: string;
 25: }
 26: const RoleContext = createContext<RoleContextType | undefined>(undefined);
 27: export function RoleProvider({
 28:   children,
 29:   role: controlledRole,
 30:   initialRole = "researcher",
 31:   onRoleChange,
 32: }: {
 33:   children: ReactNode;
 34:   role?: UserRole;
 35:   initialRole?: UserRole;
 36:   onRoleChange?: (role: UserRole) => void;
 37: }) {
 38:   const [internalRole, setInternalRole] = useState<UserRole>(initialRole);
 39:   const role = controlledRole ?? internalRole;
 40:   useEffect(() => {
 41:     if (controlledRole !== undefined) {
 42:       setInternalRole(controlledRole);
 43:     }
 44:   }, [controlledRole]);
 45:   const setRole = (newRole: UserRole) => {
 46:     setInternalRole(newRole);
 47:     onRoleChange?.(newRole);
 48:   };
 49:   const isAdmin = role === "admin";
 50:   const isTeamLead = role === "team_lead";
 51:   const isPro = role === "pro_researcher" || isTeamLead || isAdmin;
 52:   const canManageTeam = isTeamLead || isAdmin;
 53:   const canAccessAdmin = isAdmin;
 54:   const displayName = roleDisplayNames[role];
 55:   return (
 56:     <RoleContext.Provider
 57:       value={{
 58:         role,
 59:         setRole,
 60:         isAdmin,
 61:         isTeamLead,
 62:         isPro,
 63:         canManageTeam,
 64:         canAccessAdmin,
 65:         displayName,
 66:       }}
 67:     >
 68:       {children}
 69:     </RoleContext.Provider>
 70:   );
 71: }
 72: export function useRole(): RoleContextType {
 73:   const context = useContext(RoleContext);
 74:   if (context === undefined) {
 75:     return {
 76:       role: "researcher",
 77:       setRole: () => {},
 78:       isAdmin: false,
 79:       isTeamLead: false,
 80:       isPro: false,
 81:       canManageTeam: false,
 82:       canAccessAdmin: false,
 83:       displayName: "Researcher",
 84:     };
 85:   }
 86:   return context;
 87: }
 88: export function useUserWithRole(
 89:   defaultUser: {
 90:     name: string;
 91:     email: string;
 92:     image?: string;
 93:     role: UserRole;
 94:   },
 95:   overrideRole?: UserRole
 96: ) {
 97:   const { role: contextRole } = useRole();
 98:   const effectiveRole = overrideRole ?? contextRole;
 99:   return {
100:     ...defaultUser,
101:     role: effectiveRole,
102:   };
103: }
104: export { RoleContext };
</file>

