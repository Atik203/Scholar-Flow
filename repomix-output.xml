222:   schema: z.ZodSchema<T>,
223:   value: unknown
224: ): { success: true; data: T } | { success: false; error: string } => {
225:   try {
226:     const result = schema.parse(value);
227:     return { success: true, data: result };
228:   } catch (error) {
229:     if (error instanceof z.ZodError) {
230:       return {
231:         success: false,
