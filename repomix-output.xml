  56: async function cachedExternalJson<T>(
  57:   cacheKey: string,
  58:   url: string,
  59:   ttlMs = EXTERNAL_CACHE_TTL_MS
  60: ): Promise<T | null> {
  61:   const hit = externalCache.get(cacheKey);
  62:   if (hit && Date.now() - hit.at < ttlMs) return hit.data as T;
  63:   const res = await fetchWithTimeout(url);
  64:   if (!res || !res.ok) return null;
  65:   let data: T;
  66:   try {
  67:     data = (await res.json()) as T;
  68:   } catch {
  69:     return null;
  70:   }
  71:   externalCache.set(cacheKey, { at: Date.now(), data });
  72:   return data;
  73: }
