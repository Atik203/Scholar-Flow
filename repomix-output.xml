 33:   );
 34:   validateSession: AsyncRequestHandler = catchAsync(
 35:     async (req: Request, res: Response) => {
 36:       const { token } = req.body as IValidationRequest;
 37:       const jwtSecret = process.env.NEXTAUTH_SECRET;
 38:       if (!jwtSecret) {
 39:         sendResponse(res, {
 40:           statusCode: 500,
 41:           success: false,
 42:           message: "JWT secret not configured",
 43:         });
 44:         return;
 45:       }
 46:       try {
 47:         const decoded = jwt.verify(token, jwtSecret) as any;
 48:         const user = await authService.validateJWTToken(decoded.sub);
 49:         sendResponse(res, {
 50:           statusCode: 200,
 51:           success: true,
 52:           message: AUTH_SUCCESS_MESSAGES.TOKEN_VALIDATED,
 53:           data: {
 54:             valid: true,
 55:             user,
 56:           },
 57:         });
 58:       } catch (error) {
 59:         sendResponse(res, {
 60:           statusCode: 401,
 61:           success: false,
 62:           message: AUTH_ERROR_MESSAGES.INVALID_TOKEN,
 63:           data: {
 64:             valid: false,
 65:           },
 66:         });
 67:       }
