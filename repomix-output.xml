381:     try {
382:       // Get current annotation using $queryRaw
383:       const currentAnnotations = await prisma.$queryRaw<any[]>`
384:         SELECT id, "userId", text, version, anchor
385:         FROM "Annotation"
386:         WHERE id = ${annotationId} AND "isDeleted" = false
387:         LIMIT 1
388:       `;
389:       if (currentAnnotations.length === 0) {
390:         throw new ApiError(404, "Annotation not found");
391:       }
392:       const currentAnnotation = currentAnnotations[0];
393:       if (currentAnnotation.userId !== userId) {
394:         throw new ApiError(403, "Unauthorized to update this annotation");
395:       }
396:       // Create version record if text is being updated
397:       if (data.text) {
398:         const versionId = randomUUID();
399:         const now = new Date();
400:         await prisma.$executeRaw`
401:           INSERT INTO "AnnotationVersion" (
402:             id, "annotationId", version, text, "changedById", timestamp,
403:             "createdAt", "updatedAt", "isDeleted"
404:           )
405:           VALUES (
406:             ${versionId}, ${annotationId}, ${currentAnnotation.version},
407:             ${currentAnnotation.text}, ${userId}, ${now}, ${now}, ${now}, false
408:           )
409:         `;
410:       }
411:       // Update annotation using $executeRaw
412:       const now = new Date();
413:       const newVersion = data.text
414:         ? currentAnnotation.version + 1
415:         : currentAnnotation.version;
416:       const newText = data.text || currentAnnotation.text;
417:       const newAnchor = data.anchor
418:         ? JSON.stringify(data.anchor)
419:         : JSON.stringify(currentAnnotation.anchor);
420:       await prisma.$executeRaw`
421:         UPDATE "Annotation"
422:         SET text = ${newText},
423:             version = ${newVersion},
424:             anchor = ${newAnchor}::jsonb,
425:             "updatedAt" = ${now}
426:         WHERE id = ${annotationId}
427:       `;
428:       // Fetch updated annotation with relations
429:       const updatedAnnotations = await prisma.$queryRaw<any[]>`
