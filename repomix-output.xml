  1: "use client"
  2: import * as React from "react"
  3: import type { ChainedCommands } from "@tiptap/react"
  4: import { type Editor } from "@tiptap/react"
  5: import { useTiptapEditor } from "@/hooks/use-tiptap-editor"
  6: import {
  7:   isExtensionAvailable,
  8:   isNodeTypeSelected,
  9: } from "@/lib/tiptap-utils"
 10: import { AlignCenterIcon } from "@/components/tiptap-icons/align-center-icon"
 11: import { AlignJustifyIcon } from "@/components/tiptap-icons/align-justify-icon"
 12: import { AlignLeftIcon } from "@/components/tiptap-icons/align-left-icon"
 13: import { AlignRightIcon } from "@/components/tiptap-icons/align-right-icon"
 14: export type TextAlign = "left" | "center" | "right" | "justify"
 15: export interface UseTextAlignConfig {
 16:   editor?: Editor | null
 17:   align: TextAlign
 18:   hideWhenUnavailable?: boolean
 19:   onAligned?: () => void
 20: }
 21: export const TEXT_ALIGN_SHORTCUT_KEYS: Record<TextAlign, string> = {
 22:   left: "mod+shift+l",
 23:   center: "mod+shift+e",
 24:   right: "mod+shift+r",
 25:   justify: "mod+shift+j",
 26: }
 27: export const textAlignIcons = {
 28:   left: AlignLeftIcon,
 29:   center: AlignCenterIcon,
 30:   right: AlignRightIcon,
 31:   justify: AlignJustifyIcon,
 32: }
 33: export const textAlignLabels: Record<TextAlign, string> = {
 34:   left: "Align left",
 35:   center: "Align center",
 36:   right: "Align right",
 37:   justify: "Align justify",
 38: }
 39: export function canSetTextAlign(
 40:   editor: Editor | null,
 41:   align: TextAlign
 42: ): boolean {
 43:   if (!editor || !editor.isEditable) return false
 44:   if (
 45:     !isExtensionAvailable(editor, "textAlign") ||
 46:     isNodeTypeSelected(editor, ["image"])
 47:   )
 48:     return false
 49:   return editor.can().setTextAlign(align)
 50: }
 51: export function hasSetTextAlign(
 52:   commands: ChainedCommands
 53: ): commands is ChainedCommands & {
 54:   setTextAlign: (align: TextAlign) => ChainedCommands
 55: } {
 56:   return "setTextAlign" in commands
 57: }
 58: export function isTextAlignActive(
 59:   editor: Editor | null,
 60:   align: TextAlign
 61: ): boolean {
 62:   if (!editor || !editor.isEditable) return false
 63:   return editor.isActive({ textAlign: align })
 64: }
 65: export function setTextAlign(editor: Editor | null, align: TextAlign): boolean {
 66:   if (!editor || !editor.isEditable) return false
 67:   if (!canSetTextAlign(editor, align)) return false
 68:   const chain = editor.chain().focus()
 69:   if (hasSetTextAlign(chain)) {
 70:     return chain.setTextAlign(align).run()
 71:   }
 72:   return false
 73: }
 74: export function shouldShowButton(props: {
 75:   editor: Editor | null
 76:   hideWhenUnavailable: boolean
 77:   align: TextAlign
 78: }): boolean {
 79:   const { editor, hideWhenUnavailable, align } = props
 80:   if (!editor || !editor.isEditable) return false
 81:   if (!isExtensionAvailable(editor, "textAlign")) return false
 82:   if (hideWhenUnavailable && !editor.isActive("code")) {
 83:     return canSetTextAlign(editor, align)
 84:   }
 85:   return true
 86: }
 87: export function useTextAlign(config: UseTextAlignConfig) {
 88:   const {
 89:     editor: providedEditor,
 90:     align,
 91:     hideWhenUnavailable = false,
 92:     onAligned,
 93:   } = config
 94:   const { editor } = useTiptapEditor(providedEditor)
 95:   const [isVisible, setIsVisible] = React.useState<boolean>(true)
 96:   const canAlign = canSetTextAlign(editor, align)
 97:   const isActive = isTextAlignActive(editor, align)
 98:   React.useEffect(() => {
 99:     if (!editor) return
100:     const handleSelectionUpdate = () => {
101:       setIsVisible(shouldShowButton({ editor, align, hideWhenUnavailable }))
102:     }
103:     handleSelectionUpdate()
104:     editor.on("selectionUpdate", handleSelectionUpdate)
105:     return () => {
106:       editor.off("selectionUpdate", handleSelectionUpdate)
107:     }
108:   }, [editor, hideWhenUnavailable, align])
109:   const handleTextAlign = React.useCallback(() => {
110:     if (!editor) return false
111:     const success = setTextAlign(editor, align)
112:     if (success) {
113:       onAligned?.()
114:     }
115:     return success
116:   }, [editor, align, onAligned])
117:   return {
118:     isVisible,
119:     isActive,
120:     handleTextAlign,
121:     canAlign,
122:     label: textAlignLabels[align],
123:     shortcutKeys: TEXT_ALIGN_SHORTCUT_KEYS[align],
124:     Icon: textAlignIcons[align],
125:   }
126: }
</file>

