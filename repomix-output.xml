 70:   static async getCollectionsWithCounts(
 71:     limit: number = 10,
 72:     skip: number = 0,
 73:     isPublic?: boolean
 74:   ) {
 75:     try {
 76:       const visibilityFilter =
 77:         isPublic !== undefined
 78:           ? Prisma.sql`AND (c."isPublic" = ${isPublic} OR c.visibility = 'PUBLIC')`
 79:           : Prisma.empty;
 80:       const collections = await prisma.$queryRaw<CollectionAggregateRow[]>`
 81:         SELECT
 82:           c.id,
 83:           c.name,
 84:           c.description,
 85:           c."isPublic",
 86:           c."visibility"::text,
 87:           c.tags,
 88:           c."coverImage",
 89:           c.color,
 90:           c."createdAt",
 91:           c."updatedAt",
 92:           c."ownerId",
 93:           c."workspaceId",
 94:           u.email as "ownerEmail",
 95:           u.name as "ownerName",
 96:           COALESCE(paper_counts.paper_count, 0)::int as "paperCount",
 97:           COALESCE(member_counts.member_count, 0)::int as "memberCount"
 98:         FROM "Collection" c
 99:         LEFT JOIN "User" u ON c."ownerId" = u.id
100:         LEFT JOIN (
101:           SELECT "collectionId", COUNT(*)::int AS paper_count
102:           FROM "CollectionPaper"
103:           WHERE "isDeleted" = false
104:           GROUP BY "collectionId"
105:         ) paper_counts ON paper_counts."collectionId" = c.id
106:         LEFT JOIN (
107:           SELECT "collectionId", COUNT(*)::int AS member_count
108:           FROM "CollectionMember"
109:           WHERE "isDeleted" = false AND status = 'ACCEPTED'
110:           GROUP BY "collectionId"
111:         ) member_counts ON member_counts."collectionId" = c.id
112:         WHERE c."isDeleted" = false
113:         ${visibilityFilter}
114:         ORDER BY c."createdAt" DESC
115:         LIMIT ${limit} OFFSET ${skip}
116:       `;
117:       const totalCount = await prisma.$queryRaw<Array<{ count: number }>>`
118:         SELECT COUNT(*)::int as count
119:         FROM "Collection" c
120:         WHERE c."isDeleted" = false
121:         ${visibilityFilter}
122:       `;
123:       const total = totalCount[0]?.count || 0;
124:       const page = Math.floor(skip / limit) + 1;
125:       const totalPage = Math.ceil(total / limit);
126:       const transformedCollections = collections.map((collection) => ({
127:         ...collection,
128:         owner: {
129:           id: collection.ownerId,
130:           name: collection.ownerName || "Unknown",
131:           email: collection.ownerEmail || "unknown@example.com",
132:         },
133:         _count: {
134:           papers: collection.paperCount,
135:           members: collection.memberCount ?? 0,
136:         },
137:       }));
138:       return {
139:         result: transformedCollections,
140:         meta: {
141:           page,
142:           limit,
143:           total,
144:           totalPage,
145:         },
146:       };
