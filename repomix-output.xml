  1: const CACHE_VERSION = "v1.0.0";
  2: const STATIC_CACHE = `scholarflow-static-${CACHE_VERSION}`;
  3: const DYNAMIC_CACHE = `scholarflow-dynamic-${CACHE_VERSION}`;
  4: const API_CACHE = `scholarflow-api-${CACHE_VERSION}`;
  5: const STATIC_ASSETS = [
  6:   "/",
  7:   "/dashboard",
  8:   "/manifest.json",
  9:   "/favicon.ico",
 10: ];
 11: self.addEventListener("install", (event) => {
 12:   console.log("[Service Worker] Installing...");
 13:   event.waitUntil(
 14:     caches.open(STATIC_CACHE).then((cache) => {
 15:       console.log("[Service Worker] Caching static assets");
 16:       return cache.addAll(STATIC_ASSETS);
 17:     })
 18:   );
 19:   self.skipWaiting();
 20: });
 21: self.addEventListener("activate", (event) => {
 22:   console.log("[Service Worker] Activating...");
 23:   event.waitUntil(
 24:     caches.keys().then((cacheNames) => {
 25:       return Promise.all(
 26:         cacheNames
 27:           .filter((name) => {
 28:             return (
 29:               name.startsWith("scholarflow-") &&
 30:               name !== STATIC_CACHE &&
 31:               name !== DYNAMIC_CACHE &&
 32:               name !== API_CACHE
 33:             );
 34:           })
 35:           .map((name) => {
 36:             console.log("[Service Worker] Deleting old cache:", name);
 37:             return caches.delete(name);
 38:           })
 39:       );
 40:     })
 41:   );
 42:   return self.clients.claim();
 43: });
 44: self.addEventListener("fetch", (event) => {
 45:   const { request } = event;
 46:   const url = new URL(request.url);
 47:   if (request.method !== "GET") {
 48:     console.log("[Service Worker] Skipping non-GET request:", request.method, url.pathname);
 49:     return;
 50:   }
 51:   if (!url.protocol.startsWith("http")) {
 52:     return;
 53:   }
 54:   if (
 55:     url.pathname.includes("/auth/oauth/") ||
 56:     url.pathname.includes("/auth/callback/") ||
 57:     url.pathname.includes("/auth/signin") ||
 58:     url.pathname.includes("/auth/register")
 59:   ) {
 60:     console.log("[Service Worker] Skipping auth endpoint:", url.pathname);
 61:     return;
 62:   }
 63:   if (url.pathname.startsWith("/api/")) {
 64:     event.respondWith(networkFirstStrategy(request, API_CACHE));
 65:     return;
 66:   }
 67:   if (
 68:     url.pathname.startsWith("/_next/") ||
 69:     url.pathname.startsWith("/static/") ||
 70:     url.pathname.match(/\.(js|css|png|jpg|jpeg|svg|gif|webp|ico|woff|woff2)$/)
 71:   ) {
 72:     event.respondWith(cacheFirstStrategy(request, STATIC_CACHE));
 73:     return;
 74:   }
 75:   event.respondWith(networkFirstStrategy(request, DYNAMIC_CACHE));
 76: });
 77: async function cacheFirstStrategy(request, cacheName) {
 78:   const cachedResponse = await caches.match(request);
 79:   if (cachedResponse) {
 80:     return cachedResponse;
 81:   }
 82:   try {
 83:     const networkResponse = await fetch(request);
 84:     if (networkResponse.ok) {
 85:       const cache = await caches.open(cacheName);
 86:       cache.put(request, networkResponse.clone());
 87:     }
 88:     return networkResponse;
 89:   } catch (error) {
 90:     console.error("[Service Worker] Fetch failed:", error);
 91:     return new Response("Offline", {
 92:       status: 503,
 93:       statusText: "Service Unavailable",
 94:     });
 95:   }
 96: }
 97: async function networkFirstStrategy(request, cacheName) {
 98:   try {
 99:     const networkResponse = await fetch(request);
100:     if (networkResponse.ok) {
101:       const cache = await caches.open(cacheName);
102:       cache.put(request, networkResponse.clone());
103:     }
104:     return networkResponse;
105:   } catch (error) {
106:     console.error("[Service Worker] Network failed, trying cache:", error);
107:     const cachedResponse = await caches.match(request);
108:     if (cachedResponse) {
109:       return cachedResponse;
110:     }
111:     return new Response(
112:       JSON.stringify({
113:         error: "Network unavailable and no cached response",
114:       }),
115:       {
116:         status: 503,
117:         statusText: "Service Unavailable",
118:         headers: { "Content-Type": "application/json" },
119:       }
120:     );
121:   }
122: }
123: self.addEventListener("sync", (event) => {
