1706:     return;
1707:   }
1708:   await new Promise<void>((resolve) => {
1709:     pdfExportWaiters.push(resolve);
1710:   });
1711:   activePdfExports += 1;
1712: }
1713: function releasePdfSlot(): void {
1714:   activePdfExports = Math.max(0, activePdfExports - 1);
1715:   pdfExportWaiters.shift()?.();
1716: }
