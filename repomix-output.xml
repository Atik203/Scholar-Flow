  1: import { Prisma } from "@prisma/client";
  2: import prisma from "../../shared/prisma";
  3: interface FaqRow {
  4:   id: string;
  5:   question: string;
  6:   answer: string;
  7:   category: string;
  8:   order: number;
  9:   isPublished: boolean;
 10:   createdAt: Date;
 11: }
 12: interface TestimonialRow {
 13:   id: string;
 14:   name: string;
 15:   title: string;
 16:   company: string | null;
 17:   avatar: string | null;
 18:   content: string;
 19:   rating: number;
 20:   order: number;
 21:   createdAt: Date;
 22: }
 23: interface NewsletterRow {
 24:   id: string;
 25:   email: string;
 26: }
 27: interface PageContentRow {
 28:   id: string;
 29:   slug: string;
 30:   title: string;
 31:   content: string;
 32:   metadata: unknown;
 33:   createdAt: Date;
 34: }
 35: interface CountRow {
 36:   total: number;
 37: }
 38: export class PublicService {
 39:   static async getFaqs(category?: string, page = 1, limit = 50) {
 40:     const skip = (page - 1) * limit;
 41:     const categoryFilter = category
 42:       ? Prisma.sql`AND f."category" = ${category}`
 43:       : Prisma.empty;
 44:     const faqs = await prisma.$queryRaw<FaqRow[]>`
 45:       SELECT f.id, f.question, f.answer, f.category, f."order", f."isPublished", f."createdAt"
 46:       FROM "Faq" f
 47:       WHERE f."isPublished" = true AND f."isDeleted" = false
 48:       ${categoryFilter}
 49:       ORDER BY f."category" ASC, f."order" ASC
 50:       LIMIT ${limit} OFFSET ${skip}
 51:     `;
 52:     const countResult = await prisma.$queryRaw<CountRow[]>`
 53:       SELECT COUNT(*)::int as total
 54:       FROM "Faq" f
 55:       WHERE f."isPublished" = true AND f."isDeleted" = false
 56:       ${categoryFilter}
 57:     `;
 58:     const total = countResult[0]?.total ?? 0;
 59:     return {
 60:       result: faqs,
 61:       meta: { page, limit, total, totalPage: Math.ceil(total / limit) },
 62:     };
 63:   }
 64:   static async getFaqCategories() {
 65:     const categories = await prisma.$queryRaw<Array<{ category: string }>>`
 66:       SELECT DISTINCT f."category"
 67:       FROM "Faq" f
 68:       WHERE f."isPublished" = true AND f."isDeleted" = false
 69:       ORDER BY f."category" ASC
 70:     `;
 71:     return categories.map((c) => c.category);
 72:   }
 73:   static async getTestimonials(page = 1, limit = 50) {
 74:     const skip = (page - 1) * limit;
 75:     const testimonials = await prisma.$queryRaw<TestimonialRow[]>`
 76:       SELECT t.id, t.name, t.title, t.company, t.avatar, t.content, t.rating, t."order", t."createdAt"
 77:       FROM "Testimonial" t
 78:       WHERE t."isPublished" = true AND t."isDeleted" = false
 79:       ORDER BY t."order" ASC
 80:       LIMIT ${limit} OFFSET ${skip}
 81:     `;
 82:     const countResult = await prisma.$queryRaw<CountRow[]>`
 83:       SELECT COUNT(*)::int as total
 84:       FROM "Testimonial" t
 85:       WHERE t."isPublished" = true AND t."isDeleted" = false
 86:     `;
 87:     const total = countResult[0]?.total ?? 0;
 88:     return {
 89:       result: testimonials,
 90:       meta: { page, limit, total, totalPage: Math.ceil(total / limit) },
 91:     };
 92:   }
 93:   static async subscribeToNewsletter(email: string) {
 94:     const existing = await prisma.$queryRaw<NewsletterRow[]>`
 95:       SELECT ns.id, ns.email
 96:       FROM "NewsletterSubscriber" ns
 97:       WHERE ns.email = ${email} AND ns."isDeleted" = false
 98:       LIMIT 1
 99:     `;
100:     if (existing.length > 0) {
101:       await prisma.$executeRaw`
102:         UPDATE "NewsletterSubscriber"
103:         SET "isActive" = true, "updatedAt" = NOW()
104:         WHERE email = ${email}
105:       `;
106:       return existing[0];
107:     }
108:     const result = await prisma.$queryRaw<NewsletterRow[]>`
109:       INSERT INTO "NewsletterSubscriber" (id, email, "subscribedAt", "isActive", "createdAt", "updatedAt")
110:       VALUES (gen_random_uuid(), ${email}, NOW(), true, NOW(), NOW())
111:       RETURNING id, email
112:     `;
113:     return result[0];
114:   }
115:   static async createContactSubmission(data: {
116:     name: string;
117:     email: string;
118:     subject: string;
119:     message: string;
120:   }) {
121:     const result = await prisma.$queryRaw<Array<{ id: string }>>`
122:       INSERT INTO "ContactSubmission" (id, name, email, subject, message, status, "createdAt", "updatedAt")
123:       VALUES (gen_random_uuid(), ${data.name}, ${data.email}, ${data.subject}, ${data.message}, 'NEW'::"ContactSubmissionStatus", NOW(), NOW())
124:       RETURNING id
125:     `;
126:     return result[0];
127:   }
128:   static async getPageContent(slug: string) {
129:     const result = await prisma.$queryRaw<PageContentRow[]>`
130:       SELECT pc.id, pc.slug, pc.title, pc.content, pc.metadata, pc."createdAt"
131:       FROM "PageContent" pc
132:       WHERE pc.slug = ${slug} AND pc."isPublished" = true AND pc."isDeleted" = false
133:       LIMIT 1
134:     `;
135:     return result[0] ?? null;
136:   }
137: }
138: export const publicService = {
139:   getFaqs: PublicService.getFaqs,
140:   getFaqCategories: PublicService.getFaqCategories,
141:   getTestimonials: PublicService.getTestimonials,
142:   subscribeToNewsletter: PublicService.subscribeToNewsletter,
143:   createContactSubmission: PublicService.createContactSubmission,
144:   getPageContent: PublicService.getPageContent,
145: };
</file>

