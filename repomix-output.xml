<file path="apps/frontend/src/components/tiptap-node/latex-inline/latex-inline-component.tsx">
 1: "use client";
 2: import { NodeViewContent, NodeViewWrapper, type ReactNodeViewProps } from "@tiptap/react";
 3: import katex from "katex";
 4: import { useEffect, useRef, useState } from "react";
 5: export function LatexInlineComponent({
 6:   node,
 7:   updateAttributes,
 8:   selected,
 9: }: ReactNodeViewProps) {
10:   const [editing, setEditing] = useState(!node.attrs.latex);
11:   const [inputValue, setInputValue] = useState(node.attrs.latex as string || "");
12:   const [error, setError] = useState<string | null>(null);
13:   const containerRef = useRef<HTMLSpanElement>(null);
14:   useEffect(() => {
15:     if (!editing && inputValue) {
16:       try {
17:         katex.render(inputValue, containerRef.current!, {
18:           throwOnError: false,
19:           displayMode: false,
20:         });
21:         setError(null);
22:       } catch {
23:         setError("Invalid LaTeX");
24:         if (containerRef.current) {
25:           containerRef.current.textContent = inputValue;
26:         }
27:       }
28:     }
29:   }, [editing, inputValue]);
30:   const handleSubmit = () => {
31:     const trimmed = inputValue.trim();
32:     if (trimmed) {
33:       updateAttributes({ latex: trimmed });
34:       setEditing(false);
35:     }
36:   };
37:   const handleKeyDown = (e: React.KeyboardEvent) => {
38:     if (e.key === "Enter") {
39:       e.preventDefault();
40:       handleSubmit();
41:     }
42:     if (e.key === "Escape") {
43:       setEditing(false);
44:       setInputValue((node.attrs.latex as string) || "");
45:     }
46:   };
47:   if (editing) {
48:     return (
49:       <NodeViewWrapper
50:         as="span"
51:         className="latex-inline-editing inline-flex items-center gap-1"
52:       >
53:         <span className="text-xs text-muted-foreground font-mono mr-1">$</span>
54:         <input
55:           type="text"
56:           value={inputValue}
57:           onChange={(e) => setInputValue(e.target.value)}
58:           onKeyDown={handleKeyDown}
59:           onBlur={handleSubmit}
60:           placeholder="x^2 + y^2 = r^2"
61:           className="border rounded px-2 py-0.5 text-sm w-32 bg-background focus:outline-none focus:ring-1 focus:ring-primary"
62:           autoFocus
63:         />
64:         <span className="text-xs text-muted-foreground font-mono ml-1">$</span>
65:       </NodeViewWrapper>
66:     );
67:   }
68:   return (
69:     <NodeViewWrapper
70:       as="span"
71:       className={`latex-inline inline-block align-middle ${
72:         selected ? "ring-2 ring-primary/30 rounded" : ""
73:       }`}
74:       onClick={() => setEditing(true)}
75:     >
76:       <span
77:         ref={containerRef}
78:         className="latex-rendered cursor-pointer px-0.5 hover:bg-muted/50 rounded"
79:         title={error ? `Error: ${error}` : "Click to edit"}
80:       />
81:       {error && (
82:         <span className="text-xs text-destructive ml-1" title={error}>
83:           {"\u26A0"}
84:         </span>
85:       )}
86:       <NodeViewContent />
87:     </NodeViewWrapper>
88:   );
89: }
</file>

