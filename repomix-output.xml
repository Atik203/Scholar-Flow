  1: import { Prisma } from "../../shared/prisma";
  2: import prisma from "../../shared/prisma";
  3: import ApiError from "../../errors/ApiError";
  4: import {
  5:   generateWebhookSecret,
  6:   hashWebhookSecret,
  7:   signWebhookPayload,
  8: } from "./secrets";
  9: export const webhookService = {
 10:   async listEndpoints() {
 11:     const items = await prisma.webhookEndpoint.findMany({
 12:       where: { isDeleted: false },
 13:       orderBy: { createdAt: "desc" },
 14:     });
 15:     return items;
 16:   },
 17:   async getEndpoint(id: string) {
 18:     const ep = await prisma.webhookEndpoint.findFirst({
 19:       where: { id, isDeleted: false },
 20:     });
 21:     if (!ep) throw new ApiError(404, "Webhook endpoint not found");
 22:     return ep;
 23:   },
 24:   async createEndpoint(data: {
 25:     name: string;
 26:     url: string;
 27:     description?: string;
 28:     events: string[];
 29:     status: "ACTIVE" | "INACTIVE";
 30:   }) {
 31:     const { raw, prefix, hash } = generateWebhookSecret();
 32:     const ep = await prisma.webhookEndpoint.create({
 33:       data: {
 34:         name: data.name,
 35:         url: data.url,
 36:         description: data.description,
 37:         events: data.events,
 38:         status: data.status,
 39:         secretHash: hash,
 40:         secretPrefix: prefix,
 41:       },
 42:     });
 43:     return { ...ep, _secret: raw };
 44:   },
 45:   async updateEndpoint(
 46:     id: string,
 47:     patch: {
 48:       name?: string;
 49:       url?: string;
 50:       description?: string;
 51:       events?: string[];
 52:       status?: "ACTIVE" | "INACTIVE" | "ERROR";
 53:     }
 54:   ) {
 55:     const existing = await prisma.webhookEndpoint.findFirst({
 56:       where: { id, isDeleted: false },
 57:     });
 58:     if (!existing) throw new ApiError(404, "Webhook endpoint not found");
 59:     const data: Prisma.WebhookEndpointUpdateInput = {};
 60:     if (patch.name !== undefined) data.name = patch.name;
 61:     if (patch.url !== undefined) data.url = patch.url;
 62:     if (patch.description !== undefined) data.description = patch.description;
 63:     if (patch.events !== undefined) data.events = patch.events;
 64:     if (patch.status !== undefined) data.status = patch.status;
 65:     return prisma.webhookEndpoint.update({ where: { id }, data });
 66:   },
 67:   async rotateSecret(id: string) {
 68:     const existing = await prisma.webhookEndpoint.findFirst({
 69:       where: { id, isDeleted: false },
 70:     });
 71:     if (!existing) throw new ApiError(404, "Webhook endpoint not found");
 72:     const { raw, prefix, hash } = generateWebhookSecret();
 73:     await prisma.webhookEndpoint.update({
 74:       where: { id },
 75:       data: { secretHash: hash, secretPrefix: prefix },
 76:     });
 77:     return { id, _secret: raw };
 78:   },
 79:   async deleteEndpoint(id: string) {
 80:     const existing = await prisma.webhookEndpoint.findFirst({
 81:       where: { id, isDeleted: false },
 82:     });
 83:     if (!existing) throw new ApiError(404, "Webhook endpoint not found");
 84:     await prisma.webhookEndpoint.update({
 85:       where: { id },
 86:       data: { isDeleted: true, status: "INACTIVE" },
 87:     });
 88:     return { success: true, id };
 89:   },
 90:   async testEndpoint(id: string) {
 91:     const ep = await this.getEndpoint(id);
 92:     const payload = {
 93:       event: "webhook.test",
 94:       sentAt: new Date().toISOString(),
 95:       endpointId: id,
 96:     };
 97:     const body = JSON.stringify(payload);
 98:     const signature = signWebhookSecretForStorage(ep.secretHash, body);
 99:     const delivery = await prisma.webhookDelivery.create({
100:       data: {
101:         endpointId: id,
102:         event: "webhook.test",
103:         payload: payload as Prisma.InputJsonValue,
104:         status: "PENDING",
105:         attempts: 0,
106:         durationMs: 0,
107:       },
108:     });
109:     return { delivery, signature, payload };
110:   },
111:   async listDeliveries(
112:     endpointId: string,
113:     params: {
114:       page: number;
115:       limit: number;
116:       status?: "SUCCESS" | "FAILED" | "PENDING";
117:     }
118:   ) {
119:     const where: Prisma.WebhookDeliveryWhereInput = { endpointId };
120:     if (params.status) where.status = params.status;
121:     const [total, items] = await Promise.all([
122:       prisma.webhookDelivery.count({ where }),
123:       prisma.webhookDelivery.findMany({
124:         where,
125:         orderBy: { createdAt: "desc" },
126:         skip: (params.page - 1) * params.limit,
127:         take: params.limit,
128:       }),
129:     ]);
130:     return {
131:       items,
132:       meta: {
133:         page: params.page,
134:         limit: params.limit,
135:         total,
136:         totalPage: Math.max(1, Math.ceil(total / params.limit)),
137:       },
138:     };
139:   },
140:   async retryDelivery(deliveryId: string) {
141:     const d = await prisma.webhookDelivery.findUnique({
142:       where: { id: deliveryId },
143:     });
144:     if (!d) throw new ApiError(404, "Delivery not found");
145:     return prisma.webhookDelivery.update({
146:       where: { id: deliveryId },
147:       data: { status: "PENDING", attempts: d.attempts + 1 },
148:     });
149:   },
150: };
151: export { webhookService as webhookServiceExport };
152: function signWebhookSecretForStorage(
153:   secretHash: string,
154:   body: string
155: ): string {
156:   return signWebhookPayload(secretHash, body);
157: }
158: export { hashWebhookSecret };
