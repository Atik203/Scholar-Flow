 49: function generateCitation(paper: CitationPaper, format: CitationFormatName): string {
 50:   const authors = paper.authors || [];
 51:   const authorsShort = authors.length > 3 ? `${authors[0]} et al.` : authors.join(", ");
 52:   const year = paper.year || "n.d.";
 53:   const journal = paper.journal || "Journal";
 54:   switch (format) {
 55:     case "BIBTEX":
 56:       return `@article{${paper.id.slice(0, 8)},\n  title     = {${paper.title}},\n  author    = {${authors.join(" and ")}},\n  journal   = {${journal}},\n  year      = {${year}},\n  doi       = {${paper.doi || ""}}\n}`;
 57:     case "APA":
 58:       return `${authorsShort} (${year}). ${paper.title}. ${journal}. https://doi.org/${paper.doi || ""}`;
 59:     case "MLA":
 60:       return `${authorsShort}. "${paper.title}." ${journal}, ${year}.`;
 61:     case "IEEE":
 62:       return `${authorsShort}, "${paper.title}," ${journal}, ${year}.`;
 63:     case "CHICAGO":
 64:       return `${authorsShort}. "${paper.title}." ${journal} (${year}).`;
 65:     case "HARVARD":
 66:       return `${authorsShort} (${year}) '${paper.title}', ${journal}.`;
 67:     case "VANCOUVER":
 68:       return `${authors.join(", ")}. ${paper.title}. ${journal} ${year}. doi:${paper.doi || ""}.`;
 69:     case "ACS":
 70:       return `${authors.join("; ")}. ${paper.title}. ${journal} ${year}. DOI: ${paper.doi || ""}.`;
 71:     case "ENDNOTE":
 72:       return `%0 Journal Article\n%T ${paper.title}\n%A ${authors.join("\n%A ")}\n%J ${journal}\n%D ${year}\n%R doi:${paper.doi || ""}`;
 73:     default:
 74:       return paper.title;
 75:   }
 76: }
