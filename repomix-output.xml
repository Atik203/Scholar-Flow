<file path="apps/frontend/src/components/comments/CommentForm.tsx">
  1: "use client";
  2: import { useState } from "react";
  3: import { Button } from "@/components/ui/button";
  4: import { Textarea } from "@/components/ui/textarea";
  5: import { Label } from "@/components/ui/label";
  6: import { useCreateAnnotationMutation } from "@/redux/api/annotationApi";
  7: import { showErrorToast, showSuccessToast } from "@/components/providers/ToastProvider";
  8: import { Loader2, Send, X } from "lucide-react";
  9: interface CommentFormProps {
 10:   paperId: string;
 11:   parentId?: string;
 12:   onSuccess: () => void;
 13:   onCancel: () => void;
 14:   placeholder?: string;
 15:   className?: string;
 16: }
 17: export function CommentForm({
 18:   paperId,
 19:   parentId,
 20:   onSuccess,
 21:   onCancel,
 22:   placeholder = "Write your comment...",
 23:   className = "",
 24: }: CommentFormProps) {
 25:   const [text, setText] = useState("");
 26:   const [isSubmitting, setIsSubmitting] = useState(false);
 27:   const [createAnnotation] = useCreateAnnotationMutation();
 28:   const handleSubmit = async (e: React.FormEvent) => {
 29:     e.preventDefault();
 30:     if (!text.trim()) return;
 31:     setIsSubmitting(true);
 32:     try {
 33:       await createAnnotation({
 34:         paperId,
 35:         type: "COMMENT",
 36:         text: text.trim(),
 37:         parentId,
 38:         anchor: {
 39:           page: 1,
 40:           coordinates: { x: 0, y: 0, width: 0, height: 0 },
 41:         },
 42:       }).unwrap();
 43:       showSuccessToast("Comment added successfully");
 44:       setText("");
 45:       onSuccess();
 46:     } catch (error: any) {
 47:       showErrorToast(error.data?.message || "Failed to add comment");
 48:     } finally {
 49:       setIsSubmitting(false);
 50:     }
 51:   };
 52:   const handleKeyDown = (e: React.KeyboardEvent) => {
 53:     if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
 54:       handleSubmit(e);
 55:     } else if (e.key === "Escape") {
 56:       onCancel();
 57:     }
 58:   };
 59:   return (
 60:     <form onSubmit={handleSubmit} className={`space-y-3 ${className}`}>
 61:       <div className="space-y-2">
 62:         <Label htmlFor="comment-text">
 63:           {parentId ? "Reply to comment" : "Add a comment"}
 64:         </Label>
 65:         <Textarea
 66:           id="comment-text"
 67:           value={text}
 68:           onChange={(e) => setText(e.target.value)}
 69:           onKeyDown={handleKeyDown}
 70:           placeholder={placeholder}
 71:           className="min-h-[100px] resize-none"
 72:           disabled={isSubmitting}
 73:           autoFocus
 74:         />
 75:         <div className="text-xs text-muted-foreground">
 76:           Press Ctrl+Enter to submit, Esc to cancel
 77:         </div>
 78:       </div>
 79:       <div className="flex items-center justify-end gap-2">
 80:         <Button
 81:           type="button"
 82:           variant="outline"
 83:           onClick={onCancel}
 84:           disabled={isSubmitting}
 85:         >
 86:           <X className="h-4 w-4 mr-1" />
 87:           Cancel
 88:         </Button>
 89:         <Button
 90:           type="submit"
 91:           disabled={!text.trim() || isSubmitting}
 92:         >
 93:           {isSubmitting ? (
 94:             <Loader2 className="h-4 w-4 mr-1 animate-spin" />
 95:           ) : (
 96:             <Send className="h-4 w-4 mr-1" />
 97:           )}
 98:           {parentId ? "Reply" : "Comment"}
 99:         </Button>
100:       </div>
101:     </form>
102:   );
103: }
</file>

