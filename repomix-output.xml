 64:   const usedMemMB = memUsage.heapUsed / 1024 / 1024;
 65:   const memoryUsagePercent = (usedMemMB / totalMemMB) * 100;
 66:   let status: "healthy" | "degraded" | "unhealthy" = "healthy";
 67:   if (memoryUsagePercent > 90) {
 68:     status = "unhealthy";
 69:   } else if (memoryUsagePercent > 75) {
 70:     status = "degraded";
 71:   }
 72:   return {
 73:     service: "memory",
 74:     status,
 75:     details: {
 76:       heapUsed: `${usedMemMB.toFixed(2)} MB`,
 77:       heapTotal: `${totalMemMB.toFixed(2)} MB`,
 78:       usagePercent: `${memoryUsagePercent.toFixed(2)}%`,
 79:       rss: `${(memUsage.rss / 1024 / 1024).toFixed(2)} MB`,
 80:       external: `${(memUsage.external / 1024 / 1024).toFixed(2)} MB`,
 81:     },
