 487:   async updateMetadata(id: string, data: UpdatePaperMetadataInput) {
 488:     // First get existing paper
 489:     const existing = await prisma.$queryRaw<any[]>`
 490:       SELECT metadata, title, abstract
 491:       FROM "Paper"
 492:       WHERE id = ${id} AND "isDeleted" = false
 493:       LIMIT 1
 494:     `;
 495:     if (!existing.length) return null;
 496:     const existingMeta = existing[0].metadata || {};
 497:     const mergedMeta = {
 498:       ...existingMeta,
 499:       authors:
 500:         data.authors !== undefined ? data.authors : existingMeta.authors || [],
 501:       year: data.year !== undefined ? data.year : existingMeta.year,
 502:     };
 503:     // Update with merged metadata
 504:     await prisma.$executeRaw`
 505:       UPDATE "Paper"
 506:       SET title = ${data.title ?? existing[0].title},
 507:           abstract = ${data.abstract ?? existing[0].abstract},
 508:           metadata = ${JSON.stringify(mergedMeta)}::jsonb,
