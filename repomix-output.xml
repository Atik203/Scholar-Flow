236:   static async getActivity(
237:     userId: string,
238:     limit: number,
239:     cursor: string | undefined,
240:     filters: {
241:       entity?: string;
242:       memberId?: string;
243:       startDate?: Date;
244:       endDate?: Date;
245:     }
246:   ) {
247:     const take = limit + 1;
248:     const where: Prisma.ActivityLogEntryWhereInput = { isDeleted: false };
249:     if (filters.entity) where.entity = filters.entity;
250:     if (filters.memberId) where.userId = filters.memberId;
251:     if (filters.startDate || filters.endDate) {
252:       where.createdAt = {};
253:       if (filters.startDate) where.createdAt.gte = filters.startDate;
254:       if (filters.endDate) where.createdAt.lte = filters.endDate;
255:     }
256:     const userWorkspaces = await prisma.workspace.findMany({
257:       where: {
258:         isDeleted: false,
259:         OR: [
260:           { ownerId: userId },
261:           { members: { some: { userId, isDeleted: false } } },
262:         ],
263:       },
264:       select: { id: true },
265:     });
266:     const workspaceIds = userWorkspaces.map((w) => w.id);
267:     where.OR = [
268:       { workspaceId: { in: workspaceIds } },
269:       { userId },
270:     ];
271:     if (cursor) {
272:       const cursorEntry = await prisma.activityLogEntry.findUnique({
273:         where: { id: cursor },
274:         select: { createdAt: true },
275:       });
276:       if (cursorEntry) {
277:         where.createdAt = { ...(where.createdAt as object), lt: cursorEntry.createdAt };
278:       }
279:     }
280:     const entries = await prisma.activityLogEntry.findMany({
281:       where,
282:       take,
283:       orderBy: [{ createdAt: "desc" }, { id: "desc" }],
284:       include: {
285:         user: {
286:           select: {
287:             id: true,
288:             name: true,
289:             firstName: true,
290:             lastName: true,
291:             image: true,
292:             role: true,
293:           },
294:         },
295:         workspace: { select: { id: true, name: true } },
296:       },
297:     });
298:     const hasMore = entries.length > limit;
299:     const sliced = hasMore ? entries.slice(0, -1) : entries;
300:     return {
301:       result: sliced,
302:       meta: {
303:         limit,
304:         hasMore,
305:         nextCursor: hasMore ? sliced[sliced.length - 1].id : null,
306:       },
307:     };
308:   }
309:   static async getActivitySummary(userId: string, days: number = 7) {
310:     const startDate = new Date();
311:     startDate.setDate(startDate.getDate() - days);
312:     const userWorkspaces = await prisma.workspace.findMany({
313:       where: {
314:         isDeleted: false,
315:         OR: [
316:           { ownerId: userId },
317:           { members: { some: { userId, isDeleted: false } } },
318:         ],
319:       },
320:       select: { id: true },
321:     });
322:     const workspaceIds = userWorkspaces.map((w) => w.id);
323:     const baseWhere: Prisma.ActivityLogEntryWhereInput = {
324:       isDeleted: false,
325:       createdAt: { gte: startDate },
326:       OR: [{ workspaceId: { in: workspaceIds } }, { userId }],
327:     };
328:     const [
329:       totalActivities,
330:       byTypeGroups,
331:       bySeverityGroups,
332:       recentActivities,
333:     ] = await Promise.all([
334:       prisma.activityLogEntry.count({ where: baseWhere }),
335:       prisma.activityLogEntry.groupBy({
336:         by: ["entity"],
337:         where: baseWhere,
338:         _count: { entity: true },
339:       }),
340:       prisma.activityLogEntry.groupBy({
341:         by: ["severity"],
342:         where: baseWhere,
343:         _count: { severity: true },
344:       }),
345:       prisma.activityLogEntry.findMany({
346:         where: baseWhere,
347:         take: 10,
348:         orderBy: { createdAt: "desc" },
349:         include: {
350:           user: {
351:             select: {
352:               id: true,
353:               name: true,
354:               firstName: true,
355:               lastName: true,
356:               image: true,
357:               role: true,
358:             },
359:           },
360:           workspace: { select: { id: true, name: true } },
361:         },
362:       }),
363:     ]);
364:     return {
365:       totalActivities,
366:       activitiesByType: byTypeGroups.reduce<Record<string, number>>((acc, g) => {
367:         acc[g.entity] = g._count.entity;
368:         return acc;
369:       }, {}),
370:       activitiesBySeverity: bySeverityGroups.reduce<Record<string, number>>(
371:         (acc, g) => {
372:           acc[g.severity] = g._count.severity;
373:           return acc;
374:         },
375:         {}
376:       ),
377:       recentActivities,
378:       days,
379:     };
380:   }
381:   static async getStats(userId: string) {
382:     const sevenDaysAgo = new Date();
383:     sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
384:     const [
385:       totalMembers,
386:       pendingInvitations,
387:       totalPapers,
388:       totalCollections,
389:       recentActivity,
390:     ] = await Promise.all([
391:       prisma.user.count({ where: { isDeleted: false } }),
392:       prisma.workspaceInvitation.count({
393:         where: { isDeleted: false, status: "PENDING" },
394:       }),
395:       prisma.paper.count({ where: { isDeleted: false } }),
396:       prisma.collection.count({ where: { isDeleted: false } }),
397:       prisma.activityLogEntry.count({
398:         where: { isDeleted: false, createdAt: { gte: sevenDaysAgo } },
399:       }),
400:     ]);
401:     const usersWithActivity = await prisma.user.findMany({
402:       where: { isDeleted: false },
403:       select: { id: true, createdAt: true },
404:     });
405:     const activeUserIds = new Set(
406:       (
407:         await prisma.activityLogEntry.findMany({
408:           where: { isDeleted: false, createdAt: { gte: sevenDaysAgo } },
409:           select: { userId: true },
410:           distinct: ["userId"],
411:         })
412:       )
413:         .map((r) => r.userId)
414:         .filter((id): id is string => !!id)
415:     );
416:     let activeMembers = 0;
417:     let inactiveMembers = 0;
418:     for (const u of usersWithActivity) {
419:       if (activeUserIds.has(u.id)) activeMembers++;
420:       else if (u.createdAt < sevenDaysAgo) inactiveMembers++;
421:     }
422:     const activityScore = Math.min(100, Math.round(50 + Math.log10(recentActivity + 1) * 12));
423:     return {
424:       totalMembers,
425:       activeMembers,
426:       inactiveMembers,
427:       pendingInvitations,
428:       totalPapers,
429:       totalCollections,
430:       activityScore,
431:       recentActivityCount: recentActivity,
432:     };
433:   }
434:   static async inviteMember(
435:     inviterId: string,
436:     payload: { email: string; role?: string; message?: string }
437:   ) {
438:     const user = await prisma.user.findFirst({
439:       where: { email: payload.email, isDeleted: false },
440:       select: { id: true, email: true, name: true, firstName: true, lastName: true },
441:     });
442:     if (!user) {
443:       throw new ApiError(404, "No registered user with this email");
444:     }
445:     if (user.id === inviterId) {
446:       throw new ApiError(400, "You cannot invite yourself");
447:     }
448:     const inviterWorkspaces = await prisma.workspace.findMany({
449:       where: { isDeleted: false, ownerId: inviterId },
450:       select: { id: true },
451:     });
452:     if (inviterWorkspaces.length === 0) {
453:       throw new ApiError(
454:         400,
455:         "You must own at least one workspace before inviting team members"
456:       );
457:     }
458:     const existingMembership = await prisma.workspaceMember.findFirst({
459:       where: {
460:         userId: user.id,
461:         workspaceId: { in: inviterWorkspaces.map((w) => w.id) },
462:         isDeleted: false,
463:       },
464:     });
465:     if (existingMembership) {
466:       throw new ApiError(400, "User is already a member of one of your workspaces");
467:     }
468:     const targetWorkspaceId = inviterWorkspaces[0].id;
469:     const invitation = await prisma.workspaceInvitation.upsert({
470:       where: { workspaceId_userId: { workspaceId: targetWorkspaceId, userId: user.id } },
471:       create: {
472:         workspaceId: targetWorkspaceId,
473:         userId: user.id,
474:         role: (payload.role as any) || "RESEARCHER",
475:         invitedById: inviterId,
476:         status: "PENDING",
477:         invitedAt: new Date(),
478:       },
479:       update: {
480:         role: (payload.role as any) || "RESEARCHER",
481:         invitedById: inviterId,
482:         status: "PENDING",
483:         invitedAt: new Date(),
484:         acceptedAt: null,
485:         declinedAt: null,
486:         isDeleted: false,
487:       },
488:     });
489:     try {
490:       const { default: emailService } = await import("../../shared/emailService");
491:       const inviter = await prisma.user.findUnique({
492:         where: { id: inviterId },
493:         select: { name: true, firstName: true, lastName: true, email: true },
494:       });
495:       await emailService.sendTeamInvitationEmail({
496:         email: user.email,
497:         name: user.name || `${user.firstName || ""} ${user.lastName || ""}`.trim() || user.email,
498:         teamName: inviter?.name || "ScholarFlow Team",
499:         inviterName:
500:           inviter?.name ||
501:           `${inviter?.firstName || ""} ${inviter?.lastName || ""}`.trim() ||
502:           inviter?.email ||
503:           "A team lead",
504:         role: invitation.role,
505:         message: payload.message,
506:         invitationId: invitation.id,
507:       });
508:     } catch (err) {
509:       if (process.env.NODE_ENV !== "production") {
510:         console.error("Team invitation email failed:", (err as any)?.message || err);
511:       }
512:     }
513:     return { invitationId: invitation.id };
514:   }
515:   static async cancelInvitation(inviterId: string, invitationId: string) {
516:     const invite = await prisma.workspaceInvitation.findUnique({
517:       where: { id: invitationId },
518:     });
