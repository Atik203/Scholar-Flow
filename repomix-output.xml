<file path="apps/backend/src/app/modules/Import/import.service.ts">
  1: import axios from "axios";
  2: import prisma from "../../shared/prisma";
  3: import { StorageService } from "../papers/StorageService";
  4: const storage = new StorageService();
  5: export interface ImportedPaper {
  6:   title: string;
  7:   authors: string[];
  8:   year: number;
  9:   abstract: string;
 10:   doi?: string;
 11:   source: string;
 12:   keywords?: string[];
 13:   downloadUrl?: string;
 14: }
 15: export interface ImportResult {
 16:   paper: any;
 17:   source: string;
 18:   externalId?: string;
 19: }
 20: export class ImportService {
 21:   static async importByDOI(doi: string, workspaceId: string, uploaderId: string): Promise<ImportResult> {
 22:     const cleanDoi = doi.replace(/^https?:\/\/(dx\.)?doi\.org\//, "").trim();
 23:     const res = await axios.get(`https://api.crossref.org/works/${encodeURIComponent(cleanDoi)}`, {
 24:       headers: { "User-Agent": "ScholarFlow/1.0 (mailto:dev@scholarflow.com)" },
 25:       timeout: 10000,
 26:     });
 27:     const msg = res.data.message;
 28:     const title = msg.title?.[0] || "Untitled";
 29:     const authors = (msg.author || []).map(
 30:       (a: any) => `${a.given || ""} ${a.family || ""}`.trim()
 31:     );
 32:     const year = msg.created?.["date-parts"]?.[0]?.[0] || msg.issued?.["date-parts"]?.[0]?.[0] || 2024;
 33:     const abstract = msg.abstract || "";
 34:     const keywords = msg.subject || [];
 35:     const metadata = { authors, year, source: "doi", doi: cleanDoi, keywords };
 36:     const paper = await prisma.$queryRaw<any[]>`
 37:       INSERT INTO "Paper" (id, "workspaceId", "uploaderId", title, abstract, metadata, source, doi, tags, language, "citationCount", "processingStatus", "createdAt", "updatedAt", "isDeleted")
 38:       VALUES (gen_random_uuid(), ${workspaceId}, ${uploaderId}, ${title}, ${abstract || null}, ${JSON.stringify(metadata)}::jsonb, 'doi', ${cleanDoi}, ${keywords}::text[], null, ${msg["is-referenced-by-count"] || 0}, 'UPLOADED', NOW(), NOW(), false)
 39:       RETURNING id, title, source, doi
 40:     `;
 41:     return { paper: paper[0], source: "doi", externalId: cleanDoi };
 42:   }
 43:   static async importByArxiv(arxivId: string, workspaceId: string, uploaderId: string): Promise<ImportResult> {
 44:     const cleanId = arxivId.replace(/^https?:\/\/arxiv\.org\/abs\//, "").replace(/v\d+$/, "").trim();
 45:     const res = await axios.get(`http://export.arxiv.org/api/query?id_list=${encodeURIComponent(cleanId)}`, {
 46:       timeout: 15000,
 47:     });
 48:     const text = res.data as string;
 49:     const titleMatch = text.match(/<title>(.*?)<\/title>/);
 50:     const title = titleMatch?.[1]?.replace(/\s+/g, " ").trim() || "Untitled";
 51:     const summaryMatch = text.match(/<summary>(.*?)<\/summary>/);
 52:     const abstract = summaryMatch?.[1]?.replace(/\s+/g, " ").trim() || "";
 53:     const authorMatches = text.matchAll(/<author>[\s\S]*?<name>(.*?)<\/name>[\s\S]*?<\/author>/g);
 54:     const authors = [...authorMatches].map((m) => m[1].trim());
 55:     const yearMatch = text.match(/<published>(\d{4})/);
 56:     const year = yearMatch ? parseInt(yearMatch[1], 10) : 2024;
 57:     const metadata = { authors, year, source: "arxiv", arxivId: cleanId };
 58:     const paper = await prisma.$queryRaw<any[]>`
 59:       INSERT INTO "Paper" (id, "workspaceId", "uploaderId", title, abstract, metadata, source, doi, tags, language, "citationCount", "processingStatus", "createdAt", "updatedAt", "isDeleted")
 60:       VALUES (gen_random_uuid(), ${workspaceId}, ${uploaderId}, ${title}, ${abstract || null}, ${JSON.stringify(metadata)}::jsonb, 'arxiv', ${`10.48550/arXiv.${cleanId}`}, ARRAY[]::text[], null, 0, 'UPLOADED', NOW(), NOW(), false)
 61:       RETURNING id, title, source, doi
 62:     `;
 63:     return { paper: paper[0], source: "arxiv", externalId: cleanId };
 64:   }
 65:   static async importByURL(url: string, workspaceId: string, uploaderId: string): Promise<ImportResult> {
 66:     const res = await axios.get(url, { responseType: "arraybuffer", timeout: 30000 });
 67:     const buffer = Buffer.from(res.data);
 68:     const filename = url.split("/").pop() || "imported.pdf";
 69:     const objectKey = `papers/${workspaceId}/${Date.now()}-${filename}`;
 70:     await storage.putObject({ key: objectKey, body: buffer, contentType: "application/pdf" });
 71:     const metadata = { authors: [], year: new Date().getFullYear(), source: "url" };
 72:     const title = filename.replace(/\.pdf$/i, "");
 73:     const paper = await prisma.$queryRaw<any[]>`
 74:       INSERT INTO "Paper" (id, "workspaceId", "uploaderId", title, abstract, metadata, source, tags, language, "citationCount", "processingStatus", "createdAt", "updatedAt", "isDeleted")
 75:       VALUES (gen_random_uuid(), ${workspaceId}, ${uploaderId}, ${title}, null, ${JSON.stringify(metadata)}::jsonb, 'url', null, ARRAY[]::text[], null, 0, 'UPLOADED', NOW(), NOW(), false)
 76:       RETURNING id, title, source, doi
 77:     `;
 78:     await prisma.$executeRaw`
 79:       INSERT INTO "PaperFile" (id, "paperId", "storageProvider", "objectKey", "contentType", "sizeBytes", "originalFilename", "createdAt", "updatedAt", "isDeleted")
 80:       VALUES (gen_random_uuid(), ${paper[0].id}, 's3', ${objectKey}, 'application/pdf', ${buffer.length}, ${filename}, NOW(), NOW(), false)
 81:     `;
 82:     return { paper: paper[0], source: "url" };
 83:   }
 84:   static parseBibTeX(content: string): ImportedPaper[] {
 85:     const entries = content.split(/@\w+\{/g).filter(Boolean).map((e) => {
 86:       const titleMatch = e.match(/title\s*=\s*\{([^}]*)\}/);
 87:       const authorMatch = e.match(/author\s*=\s*\{([^}]*)\}/);
 88:       const yearMatch = e.match(/year\s*=\s*\{(\d+)\}/);
 89:       const doiMatch = e.match(/doi\s*=\s*\{([^}]*)\}/);
 90:       const abstractMatch = e.match(/abstract\s*=\s*\{([^}]*)\}/);
 91:       return {
 92:         title: titleMatch?.[1] || "Untitled",
 93:         authors: authorMatch?.[1]
 94:           ?.split(" and ")
 95:           .map((a) => a.split(",").reverse().join(" ").trim()) || [],
 96:         year: yearMatch ? parseInt(yearMatch[1], 10) : 2024,
 97:         abstract: abstractMatch?.[1] || "",
 98:         doi: doiMatch?.[1],
 99:         source: "bibtex",
100:       };
101:     });
102:     return entries;
103:   }
104:   static parseRIS(content: string): ImportedPaper[] {
105:     const lines = content.split(/\r?\n/);
106:     const papers: ImportedPaper[] = [];
107:     let current: Partial<ImportedPaper> = {};
108:     for (const line of lines) {
109:       if (line.match(/^TY\s+-\s/)) {
110:         current = { source: "ris" };
111:       }
112:       if (line.match(/^ER\s+-\s/) && current.title) {
113:         papers.push({
114:           title: current.title || "Untitled",
115:           authors: current.authors || [],
116:           year: current.year || 2024,
117:           abstract: current.abstract || "",
118:           doi: current.doi,
119:           source: "ris",
120:         });
121:         current = {};
122:       }
123:       const tag = line.substring(0, 2);
124:       const value = line.substring(6).trim();
125:       if (tag === "T1") current.title = value;
126:       if (tag === "AU") current.authors = [...(current.authors || []), value];
127:       if (tag === "PY") current.year = parseInt(value, 10) || 2024;
128:       if (tag === "AB") current.abstract = value;
129:       if (tag === "DO") current.doi = value;
130:     }
131:     return papers;
132:   }
133: }
134: export const importService = {
135:   importByDOI: ImportService.importByDOI,
136:   importByArxiv: ImportService.importByArxiv,
137:   importByURL: ImportService.importByURL,
138:   parseBibTeX: ImportService.parseBibTeX,
139:   parseRIS: ImportService.parseRIS,
140: };
</file>

