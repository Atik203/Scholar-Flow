  1: import prisma from "../../shared/prisma";
  2: import config from "../../config";
  3: import { aiService } from "../AI/ai.service";
  4: import { aiContextService } from "../AIContext/aiContext.service";
  5: import { aiProviderService } from "../AIProvider/aiProvider.service";
  6: import { AiError } from "../AI/ai.errors";
  7: import type { AiSummaryRequest } from "../AI/ai.types";
  8: const STREAMING_PROVIDER_ORDER = ["openai", "deepseek", "gemini", "claude"] as const;
  9: interface ProviderRow {
 10:   provider: string;
 11:   model: string;
 12:   inputCostPer1k?: number | null;
 13:   outputCostPer1k?: number | null;
 14: }
 15: async function resolveProviderForModel(model: string): Promise<ProviderRow> {
 16:   if (!model) {
 17:     return { provider: "openai", model: "gpt-4o-mini", inputCostPer1k: 0.15, outputCostPer1k: 0.6 };
 18:   }
 19:   const row = await prisma.aIProvider.findFirst({
 20:     where: { model, isDeleted: false, enabled: true },
 21:     select: { provider: true, model: true, inputCostPer1k: true, outputCostPer1k: true },
 22:   });
 23:   if (row) {
 24:     return row;
 25:   }
 26:   if (model.startsWith("claude")) {
 27:     return { provider: "claude", model };
 28:   }
 29:   if (model.startsWith("gemini")) {
 30:     return { provider: "gemini", model };
 31:   }
 32:   if (model.startsWith("deepseek")) {
 33:     return { provider: "deepseek", model };
 34:   }
 35:   return { provider: "openai", model };
 36: }
 37: function estimateCost(
 38:   inputTokens: number,
 39:   outputTokens: number,
 40:   resolved: ProviderRow,
 41: ): number {
 42:   const inputRate = resolved.inputCostPer1k ?? 0;
 43:   const outputRate = resolved.outputCostPer1k ?? 0;
 44:   return (inputTokens / 1000) * inputRate + (outputTokens / 1000) * outputRate;
 45: }
 46: async function buildContextMessages(
 47:   context: { type?: string; id?: string } | null | undefined,
 48:   userId: string
 49: ): Promise<Array<{ role: "system"; content: string }>> {
 50:   if (!context?.type || !context?.id) return [];
 51:   try {
 52:     const resolved = await aiContextService.resolve({
 53:       type: context.type as "paper" | "workspace" | "dashboard",
 54:       id: context.id,
 55:       userId,
 56:     });
 57:     const { systemPrompt } = aiContextService.injectContextIntoSystemPrompt(
 58:       resolved,
 59:       "You are a knowledgeable research assistant. Use the context below to answer naturally."
 60:     );
 61:     return [{ role: "system", content: systemPrompt }];
 62:   } catch {
 63:     return [];
 64:   }
 65: }
 66: async function generateAiResponse(
 67:   messages: Array<{ role: string; content: string }>,
 68:   model?: string
 69: ): Promise<{ content: string; model: string; tokensUsed?: number; costCents?: number }> {
 70:   const userMessages = messages
 71:     .filter((m) => m.role === "user" || m.role === "assistant")
 72:     .slice(-10);
 73:   const lastUserMsg = userMessages.filter((m) => m.role === "user").pop();
 74:   const context = messages
 75:     .map((m) => `${m.role}: ${m.content}`)
 76:     .join("\n")
 77:     .slice(0, 8000);
 78:   try {
 79:     const result = await aiService.generateInsight({
 80:       paperId: "global-assistant",
 81:       prompt: lastUserMsg?.content || "Help me with my research",
 82:       context,
 83:       history: userMessages.map((m) => ({
 84:         role: m.role as "user" | "assistant",
 85:         content: m.content,
 86:       })),
 87:       model,
 88:     });
 89:     return {
 90:       content: result.message.content,
 91:       model: result.provider,
 92:       tokensUsed: result.tokensUsed,
 93:     };
 94:   } catch {
 95:     return {
 96:       content: "I'm having trouble processing that right now. Please try again.",
 97:       model: "fallback",
 98:     };
 99:   }
100: }
101: async function streamFromProvider(
102:   messages: Array<{ role: "user" | "assistant" | "system"; content: string }>,
103:   model?: string,
104:   onToken?: (token: string) => void
105: ): Promise<{ content: string; model: string; inputTokens: number; outputTokens: number }> {
106:   const resolved = await resolveProviderForModel(model ?? "");
107:   let inputTokens = 0;
108:   let outputTokens = 0;
109:   if (resolved.provider === "openai") {
110:     const openaiApiKey = config.openai.apiKey;
111:     if (openaiApiKey) {
112:       try {
113:         const { OpenAI } = await import("openai");
114:         const openai = new OpenAI({ apiKey: openaiApiKey, timeout: 30000 });
115:         const stream = await openai.chat.completions.create({
116:           model: resolved.model,
117:           messages: messages as any,
118:           stream: true,
119:           max_tokens: 2000,
120:           temperature: 0.7,
121:         });
122:         let fullContent = "";
123:         for await (const chunk of stream) {
124:           const delta = chunk.choices?.[0]?.delta?.content;
125:           if (delta) {
126:             fullContent += delta;
127:             onToken?.(delta);
128:           }
129:           if (chunk.usage) {
130:             inputTokens = chunk.usage.prompt_tokens;
131:             outputTokens = chunk.usage.completion_tokens;
132:           }
133:         }
134:         if (!inputTokens && !outputTokens) {
135:           inputTokens = Math.ceil(messages.reduce((s, m) => s + m.content.length / 4, 0));
136:           outputTokens = Math.ceil(fullContent.length / 4);
137:         }
138:         return { content: fullContent, model: resolved.model, inputTokens, outputTokens };
139:       } catch {
140:         // fall through
141:       }
142:     }
143:   }
144:   const result = await generateAiResponse(messages, resolved.model);
145:   inputTokens = Math.ceil(messages.reduce((s, m) => s + m.content.length / 4, 0));
146:   outputTokens = Math.ceil((result.content?.length ?? 0) / 4);
147:   onToken?.(result.content);
148:   return { content: result.content, model: result.model, inputTokens, outputTokens };
