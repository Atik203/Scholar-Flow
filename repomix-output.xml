 92:   const [editorSettings, setEditorSettings] = useState<EditorSettings>(() =>
 93:     readEditorSettings()
 94:   );
 95:   // Redux hooks
 96:   const {
 97:     data: paperResponse,
 98:     isLoading,
 99:     error,
100:     refetch,
101:   } = useGetEditorPaperQuery(paperId);
102:   const [updateContent, { isLoading: isSaving }] =
103:     useUpdateEditorContentMutation();
104:   const [autoSaveEditorContent] = useAutoSaveEditorContentMutation();
105:   const [uploadImage] = useUploadImageForEditorMutation();
106:   const [exportPaperPdf, { isLoading: isExportingPdf }] =
107:     useExportPaperPdfMutation();
108:   const [exportPaperDocx, { isLoading: isExportingDocx }] =
109:     useExportPaperDocxMutation();
110:   const [publishDraft, { isLoading: isPublishing }] = usePublishDraftMutation();
111:   // RTK-based image uploader shared by the image node and the toolbar
112:   // button (replaces the raw XHR path in tiptap-utils).
113:   const uploadEditorImage = useCallback(
114:     async (file: File): Promise<string> => {
115:       const formData = new FormData();
116:       formData.append("image", file);
117:       const result = await uploadImage(formData).unwrap();
118:       return result.url;
119:     },
120:     [uploadImage]
121:   );
122:   const paper = paperResponse?.data;
123:   const editor = useEditor({
124:     immediatelyRender: false,
125:     shouldRerenderOnTransaction: false,
126:     editorProps: {
127:       attributes: {
128:         autocomplete: "off",
129:         autocorrect: "off",
130:         autocapitalize: "off",
131:         "aria-label": "Paper content editor",
132:         class:
133:           "scholar-flow-editor prose prose-sm sm:prose lg:prose-lg xl:prose-xl focus:outline-none max-w-none",
134:       },
135:     },
136:     extensions: [
137:       StarterKit.configure({
138:         horizontalRule: false,
139:         link: {
140:           openOnClick: false,
141:           enableClickSelection: true,
142:         },
143:       }),
144:       HorizontalRule,
145:       TextAlign.configure({
146:         types: ["heading", "paragraph", "listItem", "blockquote"],
147:       }),
148:       TaskList,
149:       TaskItem.configure({ nested: true }),
150:       Highlight.configure({ multicolor: true }),
151:       ResizableImageWithPopover.configure({
152:         defaultWidth: 400,
153:         defaultHeight: 300,
154:         async onUpload(file: File) {
155:           try {
156:             const url = await uploadEditorImage(file);
157:             return {
158:               src: url,
159:               "data-keep-ratio": true,
160:             };
161:           } catch (error) {
162:             console.error("Upload failed:", error);
163:             showErrorToast(
164:               "Image upload failed",
165:               error instanceof Error ? error.message : "Unknown error"
166:             );
167:             throw error;
168:           }
169:         },
170:       }),
171:       Typography,
172:       Superscript,
173:       Subscript,
174:       LatexInline,
175:       LatexBlock,
176:       CitationNode,
177:       CharacterCount,
178:     ],
179:     content: "",
180:     onUpdate: () => {
181:       // Dirty tracking lives in refs so the debounced callback never
182:       // reads a stale `hasUnsavedChanges` closure (the old code could
183:       // skip the first autosave entirely).
184:       dirtyRef.current = true;
185:       setHasUnsavedChanges(true);
186:       if (debounceRef.current) clearTimeout(debounceRef.current);
187:       debounceRef.current = setTimeout(() => {
188:         void handleAutoSave();
189:       }, autosaveMsRef.current);
190:     },
191:   });
192:   // --- Autosave plumbing (ref-based, no stale closures) ---
193:   const dirtyRef = useRef(false);
194:   const debounceRef = useRef<NodeJS.Timeout | null>(null);
195:   const savingRef = useRef(false);
196:   const mountedRef = useRef(true);
197:   const editorRef = useRef(editor);
198:   const autosaveMsRef = useRef(editorSettings.autosaveIntervalMs);
199:   // Apply editor preferences (autosave interval, font size, spellcheck)
200:   useEffect(() => {
201:     autosaveMsRef.current = editorSettings.autosaveIntervalMs;
202:   }, [editorSettings]);
203:   useEffect(() => {
204:     const handler = (event: Event) => {
205:       const detail = (event as CustomEvent<EditorSettings>).detail;
206:       if (detail) setEditorSettings(detail);
207:     };
208:     window.addEventListener(EDITOR_SETTINGS_EVENT, handler);
209:     return () => window.removeEventListener(EDITOR_SETTINGS_EVENT, handler);
210:   }, []);
211:   useEffect(() => {
212:     mountedRef.current = true;
213:     editorRef.current = editor;
214:     return () => {
215:       mountedRef.current = false;
216:       if (debounceRef.current) clearTimeout(debounceRef.current);
217:       // Flush any pending edits on unmount so navigation never loses up to
218:       // 2s of typing (state updates are skipped — component is gone).
219:       if (dirtyRef.current && editorRef.current) {
220:         void autoSaveEditorContent({
221:           id: paperId,
222:           content: editorRef.current.getHTML(),
223:         }).catch(() => {
224:           // Best-effort flush; failure is silent on teardown.
225:         });
226:       }
227:     };
228:   }, [editor, paperId, autoSaveEditorContent]);
229:   // Warn before leaving with unsaved changes
230:   useEffect(() => {
231:     const handler = (e: BeforeUnloadEvent) => {
232:       if (!dirtyRef.current) return;
233:       e.preventDefault();
234:       e.returnValue = "";
235:     };
236:     window.addEventListener("beforeunload", handler);
237:     return () => window.removeEventListener("beforeunload", handler);
238:   }, []);
239:   const handleAutoSave = useCallback(async () => {
240:     if (!editor || !dirtyRef.current || savingRef.current) return;
241:     savingRef.current = true;
242:     try {
243:       const content = editor.getHTML();
244:       await autoSaveEditorContent({ id: paperId, content }).unwrap();
245:       dirtyRef.current = false;
246:       if (mountedRef.current) {
247:         setHasUnsavedChanges(false);
248:         setLastSaved(new Date());
249:       }
250:     } catch (error: any) {
251:       if (mountedRef.current) {
252:         showErrorToast(
253:           "Auto-save failed",
254:           error?.data?.message ?? "Please try again"
255:         );
256:       }
257:     } finally {
258:       savingRef.current = false;
259:     }
260:   }, [editor, paperId, autoSaveEditorContent]);
261:   const handleSave = useCallback(async () => {
262:     if (!editor) return;
263:     savingRef.current = true;
264:     try {
265:       const content = editor.getHTML();
266:       await updateContent({
267:         id: paperId,
268:         content,
269:         title,
270:         isDraft: paper?.isDraft ?? true,
271:       }).unwrap();
272:       dirtyRef.current = false;
273:       setHasUnsavedChanges(false);
274:       setLastSaved(new Date());
275:       showSuccessToast("Paper saved successfully!");
276:     } catch (error: any) {
277:       console.error("Save failed:", error);
278:       showErrorToast("Failed to save paper", error?.data?.message);
279:     } finally {
280:       savingRef.current = false;
281:     }
282:   }, [editor, paperId, title, updateContent, paper?.isDraft]);
283:   const hasInitializedRef = useRef(false);
284:   const rafIdRef = useRef<number | null>(null);
285:   const [restoreEpoch, setRestoreEpoch] = useState(0);
286:   useEffect(() => {
287:     hasInitializedRef.current = false;
288:   }, [paperId]);
289:   useEffect(() => {
290:     if (!editor || !paper) return;
291:     setTitle(paper.title);
292:     if (hasInitializedRef.current) return;
293:     const html = paper.contentHtml || "";
294:     // Defer setContent to the next animation frame to avoid flushSync warnings
295:     rafIdRef.current = window.requestAnimationFrame(() => {
296:       if (editor.isDestroyed) return;
297:       // Avoid emitting update to prevent triggering onUpdate during initial load
298:       editor.commands.setContent(html, { emitUpdate: false });
299:       hasInitializedRef.current = true;
300:       // Optional: move cursor to end to avoid unexpected selection jumps
301:       try {
302:         const endPos = editor.state.doc.content.size;
303:         editor.commands.setTextSelection(endPos);
304:       } catch {
305:         // no-op
306:       }
307:       setHasUnsavedChanges(false);
308:       dirtyRef.current = false;
309:     });
