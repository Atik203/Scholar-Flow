143: export function AnnotationLayerEnhanced({
144:   page,
145:   annotations,
146:   scale,
147:   rotation,
148:   pageWidth,
149:   pageHeight,
150:   activeTool,
151:   selectedColor,
152:   showAnnotations,
153:   onAnnotationClick,
154:   onCreateAnnotation,
155:   isDrawingMode,
156:   drawingPoints,
157:   onDrawingPointsChange,
158:   onDrawingComplete,
159: }: AnnotationLayerEnhancedProps) {
160:   const containerRef = useRef<HTMLDivElement>(null);
161:   const canvasRef = useRef<HTMLCanvasElement>(null);
162:   const isDrawing = useRef(false);
163:   const drawingPointsRef = useRef(drawingPoints);
164:   drawingPointsRef.current = drawingPoints;
165:   useEffect(() => {
166:     const canvas = canvasRef.current;
167:     if (!canvas) return;
168:     const ctx = canvas.getContext("2d");
169:     if (!ctx) return;
170:     ctx.clearRect(0, 0, canvas.width, canvas.height);
171:     for (const ann of annotations) {
172:       if (ann.type !== "INK" || !ann.anchor.points || ann.anchor.points.length < 2) continue;
173:       const pts = ann.anchor.points;
174:       ctx.beginPath();
175:       ctx.strokeStyle = ann.color;
176:       ctx.lineWidth = 2;
177:       ctx.lineCap = "round";
178:       ctx.lineJoin = "round";
179:       ctx.moveTo(pts[0].x * pageWidth, pts[0].y * pageHeight);
180:       for (let i = 1; i < pts.length - 1; i++) {
181:         ctx.quadraticCurveTo(
182:           pts[i].x * pageWidth,
183:           pts[i].y * pageHeight,
184:           ((pts[i].x + pts[i + 1].x) / 2) * pageWidth,
185:           ((pts[i].y + pts[i + 1].y) / 2) * pageHeight,
186:         );
187:       }
188:       ctx.lineTo(pts[pts.length - 1].x * pageWidth, pts[pts.length - 1].y * pageHeight);
189:       ctx.stroke();
190:     }
191:     if (isDrawingMode && activeTool === "INK" && drawingPoints.length > 1) {
192:       const pts = drawingPoints;
193:       ctx.beginPath();
194:       ctx.strokeStyle = selectedColor;
195:       ctx.lineWidth = 2;
196:       ctx.lineCap = "round";
197:       ctx.lineJoin = "round";
198:       ctx.moveTo(pts[0].x, pts[0].y);
199:       for (let i = 1; i < pts.length - 1; i++) {
200:         ctx.quadraticCurveTo(
201:           pts[i].x,
202:           pts[i].y,
203:           (pts[i].x + pts[i + 1].x) / 2,
204:           (pts[i].y + pts[i + 1].y) / 2,
205:         );
206:       }
207:       ctx.lineTo(pts[pts.length - 1].x, pts[pts.length - 1].y);
208:       ctx.stroke();
209:     }
210:   }, [annotations, drawingPoints, isDrawingMode, activeTool, selectedColor, pageWidth, pageHeight]);
211:   const getCanvasPoint = useCallback(
212:     (e: React.PointerEvent<HTMLCanvasElement> | PointerEvent) => {
213:       const rect = canvasRef.current?.getBoundingClientRect();
214:       if (!rect) return { x: 0, y: 0 };
215:       return { x: e.clientX - rect.left, y: e.clientY - rect.top };
216:     },
217:     [],
218:   );
219:   const handlePointerDown = useCallback(
220:     (e: React.PointerEvent<HTMLCanvasElement>) => {
221:       if (!isDrawingMode || activeTool !== "INK") return;
222:       isDrawing.current = true;
223:       onDrawingPointsChange([getCanvasPoint(e)]);
224:     },
225:     [isDrawingMode, activeTool, getCanvasPoint, onDrawingPointsChange],
226:   );
227:   const handlePointerMove = useCallback(
228:     (e: React.PointerEvent<HTMLCanvasElement>) => {
229:       if (!isDrawing.current) return;
230:       onDrawingPointsChange([...drawingPointsRef.current, getCanvasPoint(e)]);
231:     },
232:     [getCanvasPoint, onDrawingPointsChange],
233:   );
234:   const handlePointerUp = useCallback(() => {
235:     if (!isDrawing.current) return;
236:     isDrawing.current = false;
237:     const pts = drawingPointsRef.current;
238:     onDrawingPointsChange([]);
239:     if (pts.length >= 2) {
240:       onDrawingComplete(pts);
241:     }
242:   }, [onDrawingPointsChange, onDrawingComplete]);
243:   useEffect(() => {
244:     const selectableTools: AnnotationType[] = [
245:       "HIGHLIGHT",
246:       "UNDERLINE",
247:       "STRIKETHROUGH",
248:       "COMMENT",
249:       "AREA",
250:     ];
251:     if (!activeTool || !selectableTools.includes(activeTool)) return;
252:     const handleSelection = () => {
253:       const container = containerRef.current;
254:       if (!container || pageWidth <= 0 || pageHeight <= 0) return;
255:       const sel = window.getSelection();
256:       if (!sel || sel.isCollapsed || !sel.toString().trim()) return;
257:       const range = sel.getRangeAt(0);
258:       const rect = range.getBoundingClientRect();
259:       const containerRect = container.getBoundingClientRect();
260:       if (
261:         rect.left < containerRect.left ||
262:         rect.top < containerRect.top ||
263:         rect.right > containerRect.right ||
264:         rect.bottom > containerRect.bottom
265:       ) return;
266:       const anchor: AnnotationAnchor = {
267:         page,
268:         coordinates: {
269:           x: (rect.left - containerRect.left) / pageWidth,
270:           y: (rect.top - containerRect.top) / pageHeight,
271:           width: rect.width / pageWidth,
272:           height: rect.height / pageHeight,
273:         },
274:         selectedText: sel.toString().trim(),
275:         viewport: { scale, rotation },
276:       };
277:       onCreateAnnotation(anchor);
278:       sel.removeAllRanges();
279:     };
280:     const opts = { passive: true };
281:     document.addEventListener("mouseup", handleSelection, opts);
282:     document.addEventListener("touchend", handleSelection, opts);
283:     return () => {
284:       document.removeEventListener("mouseup", handleSelection);
285:       document.removeEventListener("touchend", handleSelection);
286:     };
287:   }, [activeTool, page, pageWidth, pageHeight, scale, rotation, onCreateAnnotation]);
288:   if (!showAnnotations && !isDrawingMode) return null;
289:   return (
290:     <div
291:       ref={containerRef}
292:       className="absolute inset-0 pointer-events-none overflow-hidden"
293:       style={{ width: pageWidth, height: pageHeight }}
294:     >
295:       {showAnnotations && annotations.map((ann) => renderAnnotation(ann, pageWidth, pageHeight, onAnnotationClick))}
296:       <canvas
297:         ref={canvasRef}
298:         width={pageWidth}
299:         height={pageHeight}
300:         className="absolute inset-0"
301:         style={{
302:           pointerEvents: isDrawingMode && activeTool === "INK" ? "auto" : "none",
303:           cursor: isDrawingMode && activeTool === "INK" ? "crosshair" : "default",
304:           touchAction: isDrawingMode && activeTool === "INK" ? "none" : "auto",
305:         }}
306:         onPointerDown={handlePointerDown}
307:         onPointerMove={handlePointerMove}
308:         onPointerUp={handlePointerUp}
309:         onPointerLeave={handlePointerUp}
310:       />
311:     </div>
312:   );
313: }
</file>

