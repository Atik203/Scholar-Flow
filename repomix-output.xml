<file path="apps/frontend/src/app/auth/callback/google/page.tsx">
  1: "use client";
  2: import {
  3:   dismissToast,
  4:   showAuthErrorToast,
  5:   showAuthSuccessToast,
  6:   showLoadingToast,
  7: } from "@/components/providers/ToastProvider";
  8: import { completeOAuthSignIn } from "@/lib/auth/authHelpers";
  9: import { useAppDispatch } from "@/redux/hooks";
 10: import { useRouter, useSearchParams } from "next/navigation";
 11: import { useCallback, useEffect, useRef, useState } from "react";
 12: const LOCK_KEY = "__sf_google_oauth_processing__";
 13: const tryAcquireGlobalLock = (): boolean => {
 14:   if (typeof window === "undefined") return false;
 15:   if (sessionStorage.getItem(LOCK_KEY) === "true") {
 16:     return false;
 17:   }
 18:   const globalWindow = window as typeof window & Record<string, boolean>;
 19:   if (globalWindow.__sfGoogleOAuthProcessing === true) {
 20:     return false;
 21:   }
 22:   globalWindow.__sfGoogleOAuthProcessing = true;
 23:   sessionStorage.setItem(LOCK_KEY, "true");
 24:   return true;
 25: };
 26: const releaseGlobalLock = (): void => {
 27:   if (typeof window === "undefined") return;
 28:   const globalWindow = window as typeof window & Record<string, boolean>;
 29:   delete globalWindow.__sfGoogleOAuthProcessing;
 30:   sessionStorage.removeItem(LOCK_KEY);
 31: };
 32: export default function GoogleCallbackPage() {
 33:   const router = useRouter();
 34:   const searchParams = useSearchParams();
 35:   const dispatch = useAppDispatch();
 36:   const [error, setError] = useState<string | null>(null);
 37:   const [isProcessing, setIsProcessing] = useState(false);
 38:   const hasProcessedRef = useRef(false);
 39:   const timeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
 40:   const redirectToLogin = useCallback(() => {
 41:     router.push("/login?error=oauth_failed");
 42:   }, [router]);
 43:   useEffect(() => {
 44:     let lockAcquired = false;
 45:     if (hasProcessedRef.current) return;
 46:     if (!tryAcquireGlobalLock()) {
 47:       redirectToLogin();
 48:       return;
 49:     }
 50:     lockAcquired = true;
 51:     hasProcessedRef.current = true;
 52:     const handleCallback = async () => {
 53:       try {
 54:         const code = searchParams?.get("code");
 55:         const errorParam = searchParams?.get("error");
 56:         const state = searchParams?.get("state");
 57:         if (errorParam) {
 58:           setError(`Google authentication failed: ${errorParam}`);
 59:           showAuthErrorToast(`Authentication failed: ${errorParam}`);
 60:           timeoutRef.current = setTimeout(() => router.push("/login"), 2000);
 61:           return;
 62:         }
 63:         if (!code) {
 64:           setError("No authorization code received from Google");
 65:           timeoutRef.current = setTimeout(() => router.push("/login"), 3000);
 66:           return;
 67:         }
 68:         const processedCodeKey = `oauth_processed_${code.substring(0, 10)}`;
 69:         const alreadyProcessed = localStorage.getItem(processedCodeKey);
 70:         if (alreadyProcessed) {
 71:           const callbackUrl = state ? decodeURIComponent(state) : "/dashboard";
 72:           router.push(callbackUrl);
 73:           return;
 74:         }
 75:         setIsProcessing(true);
 76:         localStorage.setItem(processedCodeKey, Date.now().toString());
 77:         const fiveMinutesAgo = Date.now() - 5 * 60 * 1000;
 78:         Object.keys(localStorage).forEach((key) => {
 79:           if (key.startsWith("oauth_processed_")) {
 80:             const timestamp = parseInt(localStorage.getItem(key) || "0");
 81:             if (timestamp < fiveMinutesAgo) {
 82:               localStorage.removeItem(key);
 83:             }
 84:           }
 85:         });
 86:         const loadingToastId = showLoadingToast("Completing Google sign-in...");
 87:         const result = await completeOAuthSignIn("google", code, dispatch);
 88:         dismissToast(loadingToastId);
 89:         if (!result.success) {
 90:           setError(result.error || "Google authentication failed");
 91:           showAuthErrorToast(result.error || "Authentication failed");
 92:           timeoutRef.current = setTimeout(() => router.push("/login"), 2000);
 93:           return;
 94:         }
 95:         showAuthSuccessToast("Successfully signed in with Google!");
 96:         await new Promise((resolve) => setTimeout(resolve, 300));
 97:         const callbackUrl = state ? decodeURIComponent(state) : "/dashboard";
 98:         const redirectTo = result.user?.onboardingCompleted
 99:           ? callbackUrl
100:           : "/onboarding";
101:         window.location.href = redirectTo;
102:       } finally {
103:         if (lockAcquired) {
104:           releaseGlobalLock();
105:         }
106:       }
107:     };
108:     handleCallback();
109:     return () => {
110:       if (timeoutRef.current) {
111:         clearTimeout(timeoutRef.current);
112:       }
113:       if (lockAcquired) {
114:         releaseGlobalLock();
115:       }
116:     };
117:   }, [router, dispatch, searchParams, redirectToLogin]);
118:   if (error) {
119:     return (
120:       <div className="min-h-screen flex items-center justify-center">
121:         <div className="text-center">
122:           <div className="mb-4 text-destructive">
123:             <svg
124:               className="h-12 w-12 mx-auto"
125:               fill="none"
126:               stroke="currentColor"
127:               viewBox="0 0 24 24"
128:             >
129:               <path
130:                 strokeLinecap="round"
131:                 strokeLinejoin="round"
132:                 strokeWidth={2}
133:                 d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
134:               />
135:             </svg>
136:           </div>
137:           <h2 className="text-xl font-semibold mb-2">Authentication Failed</h2>
138:           <p className="text-muted-foreground mb-4">{error}</p>
139:           <p className="text-sm text-muted-foreground">
140:             Redirecting to login...
141:           </p>
142:         </div>
143:       </div>
144:     );
145:   }
146:   return (
147:     <div className="min-h-screen flex items-center justify-center">
148:       <div className="text-center">
149:         <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4"></div>
150:         <h2 className="text-xl font-semibold mb-2">
151:           Completing Google sign-in...
152:         </h2>
153:         <p className="text-muted-foreground">
154:           Please wait while we authenticate you.
155:         </p>
156:       </div>
157:     </div>
158:   );
159: }
</file>

