121:           page,
122:           limit,
123:           total,
124:           totalPage,
125:         },
126:       };
127:     } catch (error) {
128:       console.error("Error getting collections with counts:", error);
129:       throw error;
130:     }
131:   }
132:   /**
133:    * Get user's collections using $queryRaw for optimized filtering
134:    * Source: optimized user collection retrieval with paper counts
