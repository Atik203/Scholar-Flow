 27: function generateCitation(paper: CitationPaper, format: CitationFormatName): string {
 28:   const authors = paper.authors || [];
 29:   const authorsShort = authors.length > 3 ? `${authors[0]} et al.` : authors.join(", ");
 30:   const year = paper.year || "n.d.";
 31:   const journal = paper.journal || "Journal";
 32:   switch (format) {
 33:     case "BIBTEX":
 34:       return `@article{${paper.id.slice(0, 8)},\n  title     = {${paper.title}},\n  author    = {${authors.join(" and ")}},\n  journal   = {${journal}},\n  year      = {${year}},\n  doi       = {${paper.doi || ""}}\n}`;
 35:     case "APA":
 36:       return `${authorsShort} (${year}). ${paper.title}. ${journal}. https://doi.org/${paper.doi || ""}`;
 37:     case "MLA":
 38:       return `${authorsShort}. "${paper.title}." ${journal}, ${year}.`;
 39:     case "IEEE":
 40:       return `${authorsShort}, "${paper.title}," ${journal}, ${year}.`;
 41:     case "CHICAGO":
 42:       return `${authorsShort}. "${paper.title}." ${journal} (${year}).`;
 43:     case "HARVARD":
 44:       return `${authorsShort} (${year}) '${paper.title}', ${journal}.`;
 45:     case "VANCOUVER":
 46:       return `${authors.join(", ")}. ${paper.title}. ${journal} ${year}. doi:${paper.doi || ""}.`;
 47:     case "ACS":
 48:       return `${authors.join("; ")}. ${paper.title}. ${journal} ${year}. DOI: ${paper.doi || ""}.`;
 49:     case "ENDNOTE":
 50:       return `%0 Journal Article\n%T ${paper.title}\n%A ${authors.join("\n%A ")}\n%J ${journal}\n%D ${year}\n%R doi:${paper.doi || ""}`;
 51:     default:
 52:       return paper.title;
 53:   }
 54: }
