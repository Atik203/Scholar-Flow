<file path="apps/backend/src/app/modules/AI/ai.cache.ts">
  1: import crypto from "crypto";
  2: import { getRedisClient, isRedisConfigured } from "../../shared/redis";
  3: import type { AiSummaryResult } from "./ai.types";
  4: const DEFAULT_TTL_SECONDS = 60 * 60;
  5: interface CacheEntry<T> {
  6:   value: T;
  7:   expiresAt: number;
  8: }
  9: const inMemoryCache = new Map<string, CacheEntry<AiSummaryResult>>();
 10: const generateCacheKey = (
 11:   paperId: string,
 12:   prompt: string,
 13:   extraParams?: Record<string, unknown>
 14: ) => {
 15:   const hash = crypto
 16:     .createHash("sha256")
 17:     .update(JSON.stringify({ paperId, prompt, extraParams }))
 18:     .digest("hex");
 19:   return `ai:summary:${paperId}:${hash}`;
 20: };
 21: const getFromMemory = (key: string) => {
 22:   const entry = inMemoryCache.get(key);
 23:   if (!entry) return null;
 24:   if (Date.now() > entry.expiresAt) {
 25:     inMemoryCache.delete(key);
 26:     return null;
 27:   }
 28:   return entry.value;
 29: };
 30: const setInMemory = (
 31:   key: string,
 32:   value: AiSummaryResult,
 33:   ttlSeconds: number
 34: ) => {
 35:   inMemoryCache.set(key, {
 36:     value,
 37:     expiresAt: Date.now() + ttlSeconds * 1000,
 38:   });
 39: };
 40: export const aiSummaryCache = {
 41:   buildKey: generateCacheKey,
 42:   async get(
 43:     paperId: string,
 44:     prompt: string,
 45:     extraParams?: Record<string, unknown>
 46:   ): Promise<AiSummaryResult | null> {
 47:     const cacheKey = generateCacheKey(paperId, prompt, extraParams);
 48:     if (isRedisConfigured()) {
 49:       const client = await getRedisClient();
 50:       if (client) {
 51:         try {
 52:           const cached = await client.get(cacheKey);
 53:           if (cached) {
 54:             return JSON.parse(cached) as AiSummaryResult;
 55:           }
 56:         } catch (error) {
 57:           if (process.env.NODE_ENV === "development") {
 58:             console.warn("[AI Summary Cache] Redis get failed:", error);
 59:           }
 60:         }
 61:       }
 62:     }
 63:     return getFromMemory(cacheKey);
 64:   },
 65:   async set(
 66:     paperId: string,
 67:     prompt: string,
 68:     value: AiSummaryResult,
 69:     extraParams?: Record<string, unknown>,
 70:     options?: {
 71:       ttlSeconds?: number;
 72:       cacheKey?: string;
 73:     }
 74:   ) {
 75:     const ttlSeconds = options?.ttlSeconds ?? DEFAULT_TTL_SECONDS;
 76:     const cacheKey =
 77:       options?.cacheKey || generateCacheKey(paperId, prompt, extraParams);
 78:     if (isRedisConfigured()) {
 79:       const client = await getRedisClient();
 80:       if (client) {
 81:         try {
 82:           await client.set(cacheKey, JSON.stringify(value), {
 83:             EX: ttlSeconds,
 84:           });
 85:         } catch (error) {
 86:           if (process.env.NODE_ENV === "development") {
 87:             console.warn("[AI Summary Cache] Redis set failed:", error);
 88:           }
 89:         }
 90:       }
 91:     }
 92:     setInMemory(cacheKey, value, ttlSeconds);
 93:   },
 94:   async invalidate(paperId: string) {
 95:     const prefix = `ai:summary:${paperId}`;
 96:     for (const key of inMemoryCache.keys()) {
 97:       if (key.startsWith(prefix)) {
 98:         inMemoryCache.delete(key);
 99:       }
100:     }
101:     if (isRedisConfigured()) {
102:       const client = await getRedisClient();
103:       if (client) {
104:         try {
105:           const keys = await client.keys(`${prefix}:*`);
106:           if (keys.length) {
107:             await client.del(keys);
108:           }
109:         } catch (error) {
110:           if (process.env.NODE_ENV === "development") {
111:             console.warn("[AI Summary Cache] Redis invalidate failed:", error);
112:           }
113:         }
114:       }
115:     }
116:   },
117: };
</file>

