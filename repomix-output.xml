        color: "text-purple-600",
        bgColor: "bg-purple-100 dark:bg-purple-900/30",
      },
      {
        title: "System Health",
        value: "99.9%",
        change: "Stable",
        icon: TrendingUp,
        color: "text-orange-600",
        bgColor: "bg-orange-100 dark:bg-orange-900/30",
      },
    ];
  }

  if (role === "team_lead") {
    return [
      {
        title: "Team Members",
        value: "12",
        change: "+2",
        icon: Users,
        color: "text-blue-600",
