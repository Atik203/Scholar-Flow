<file path="apps/frontend/src/components/ui/optimized-image.tsx">
  1: import { cn } from "@/lib/utils";
  2: import Image from "next/image";
  3: import * as React from "react";
  4: export interface OptimizedImageProps
  5:   extends Omit<
  6:     React.ComponentProps<typeof Image>,
  7:     "placeholder" | "blurDataURL"
  8:   > {
  9:   fallback?: string;
 10:   showPlaceholder?: boolean;
 11:   aspectRatio?: "square" | "video" | "wide" | "ultrawide";
 12:   priority?: boolean;
 13: }
 14: export const OptimizedImage = React.forwardRef<
 15:   React.ElementRef<typeof Image>,
 16:   OptimizedImageProps
 17: >(
 18:   (
 19:     {
 20:       src,
 21:       alt,
 22:       className,
 23:       fallback = "/placeholder-image.jpg",
 24:       showPlaceholder = true,
 25:       aspectRatio = "square",
 26:       priority = false,
 27:       ...props
 28:     },
 29:     ref
 30:   ) => {
 31:     const [imageSrc, setImageSrc] = React.useState(src);
 32:     const [isLoading, setIsLoading] = React.useState(true);
 33:     const [hasError, setHasError] = React.useState(false);
 34:     const aspectRatioClasses = {
 35:       square: "aspect-square",
 36:       video: "aspect-video",
 37:       wide: "aspect-[16/10]",
 38:       ultrawide: "aspect-[21/9]",
 39:     };
 40:     const generateBlurDataURL = (width: number, height: number) => {
 41:       const canvas = document.createElement("canvas");
 42:       canvas.width = width;
 43:       canvas.height = height;
 44:       const ctx = canvas.getContext("2d");
 45:       if (ctx) {
 46:         ctx.fillStyle = "#f3f4f6";
 47:         ctx.fillRect(0, 0, width, height);
 48:         for (let i = 0; i < width; i += 20) {
 49:           for (let j = 0; j < height; j += 20) {
 50:             ctx.fillStyle = "#e5e7eb";
 51:             ctx.fillRect(i, j, 10, 10);
 52:           }
 53:         }
 54:       }
 55:       return canvas.toDataURL();
 56:     };
 57:     const handleError = () => {
 58:       if (fallback && imageSrc !== fallback) {
 59:         setImageSrc(fallback);
 60:         setHasError(true);
 61:       }
 62:     };
 63:     const handleLoad = () => {
 64:       setIsLoading(false);
 65:     };
 66:     return (
 67:       <div
 68:         className={cn(
 69:           "relative overflow-hidden",
 70:           aspectRatioClasses[aspectRatio]
 71:         )}
 72:       >
 73:         <Image
 74:           ref={ref}
 75:           src={imageSrc}
 76:           alt={alt}
 77:           fill
 78:           className={cn(
 79:             "object-cover transition-opacity duration-300",
 80:             isLoading ? "opacity-0" : "opacity-100",
 81:             className
 82:           )}
 83:           placeholder={showPlaceholder ? "blur" : "empty"}
 84:           blurDataURL={
 85:             showPlaceholder ? generateBlurDataURL(400, 400) : undefined
 86:           }
 87:           loading={priority ? "eager" : "lazy"}
 88:           priority={priority}
 89:           onError={handleError}
 90:           onLoad={handleLoad}
 91:           {...props}
 92:         />
 93:         {}
 94:         {isLoading && showPlaceholder && (
 95:           <div className="absolute inset-0 bg-gradient-to-br from-gray-200 to-gray-300 animate-pulse" />
 96:         )}
 97:         {}
 98:         {hasError && (
