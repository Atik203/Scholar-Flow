<file path="apps/backend/src/app/middleware/requireRole.ts">
 1: import { NextFunction, Request, Response } from "express";
 2: import ApiError from "../errors/ApiError";
 3: import { AuthRequest } from "./auth";
 4: import { ROLE_HIERARCHY, USER_ROLES } from "../modules/Auth/auth.constant";
 5: export const requireRole = (requiredRole: keyof typeof USER_ROLES) => {
 6:   return (req: Request, res: Response, next: NextFunction): void => {
 7:     const authReq = req as AuthRequest;
 8:     const userRole = authReq.user?.role;
 9:     if (!userRole) {
10:       return next(new ApiError(401, "Authentication required"));
11:     }
12:     const userLevel = ROLE_HIERARCHY[userRole as keyof typeof ROLE_HIERARCHY] || 0;
13:     const requiredLevel = ROLE_HIERARCHY[requiredRole] || 0;
14:     if (userLevel < requiredLevel) {
15:       return next(
16:         new ApiError(
17:           403,
18:           `Insufficient permissions. Required: ${requiredRole}, got: ${userRole}`
19:         )
20:       );
21:     }
22:     next();
23:   };
24: };
25: export const requireTeamLead = requireRole("TEAM_LEAD");
26: export const requireAdmin = requireRole("ADMIN");
</file>

