};

const cardPaddingStyles: Record<CardPadding, string> = {
  none: "p-0",
  sm: "p-4",
  md: "p-6",
  lg: "p-8",
};

interface CardWithVariantsProps extends React.HTMLAttributes<HTMLDivElement> {
  variant?: CardVariant;
  hover?: CardHover;
  padding?: CardPadding;
  children: React.ReactNode;
}

export function CardWithVariants({
