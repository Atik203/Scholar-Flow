  4:   return getDashboardBasePath(role);
  5: }
  6: export function getLandingDashboardUrl(): string {
  7:   return "/dashboard";
  8: }
  9: export function getCallbackUrl(
 10:   searchParams?: URLSearchParams,
 11:   defaultUrl: string = "/dashboard"
 12: ): string {
 13:   if (typeof window === "undefined") return defaultUrl;
 14:   if (searchParams) {
 15:     const callbackUrl = searchParams.get("callbackUrl");
 16:     if (callbackUrl) {
 17:       return validateCallbackUrl(callbackUrl, defaultUrl);
 18:     }
 19:   }
 20:   const urlParams = new URLSearchParams(window.location.search);
 21:   const callbackUrl = urlParams.get("callbackUrl");
 22:   if (callbackUrl) {
 23:     return validateCallbackUrl(callbackUrl, defaultUrl);
 24:   }
 25:   return defaultUrl;
 26: }
 27: export function validateCallbackUrl(
 28:   url: string,
 29:   fallback: string = "/dashboard"
 30: ): string {
 31:   try {
 32:     if (url.startsWith("/")) {
 33:       const allowedPaths = [
 34:         "/dashboard",
 35:         "/dashboard/researcher",
 36:         "/dashboard/pro-researcher",
 37:         "/dashboard/team-lead",
 38:         "/dashboard/admin",
 39:         "/papers",
 40:         "/collections",
 41:         "/collaborate",
 42:       ];
 43:       const isAllowed = allowedPaths.some(
 44:         (path) => url === path || url.startsWith(path + "/")
 45:       );
 46:       return isAllowed ? url : fallback;
 47:     }
 48:     const parsedUrl = new URL(url);
 49:     const currentOrigin = window.location.origin;
 50:     if (parsedUrl.origin === currentOrigin) {
 51:       return validateCallbackUrl(parsedUrl.pathname, fallback);
 52:     }
 53:     return fallback;
 54:   } catch {
 55:     return fallback;
 56:   }
 57: }
 58: export function buildLoginUrl(callbackUrl?: string): string {
 59:   const loginUrl = new URL("/login", window.location.origin);
 60:   if (callbackUrl) {
 61:     const validatedCallback = validateCallbackUrl(callbackUrl);
 62:     if (validatedCallback !== "/dashboard") {
 63:       loginUrl.searchParams.set("callbackUrl", validatedCallback);
 64:     }
 65:   }
 66:   return loginUrl.toString();
 67: }
 68: export function buildRegisterUrl(callbackUrl?: string): string {
 69:   const registerUrl = new URL("/register", window.location.origin);
 70:   if (callbackUrl) {
 71:     const validatedCallback = validateCallbackUrl(callbackUrl);
 72:     if (validatedCallback !== "/dashboard") {
 73:       registerUrl.searchParams.set("callbackUrl", validatedCallback);
 74:     }
 75:   }
 76:   return registerUrl.toString();
 77: }
 78: export function handleAuthRedirect(
 79:   isSuccess: boolean,
 80:   searchParams?: URLSearchParams,
 81:   errorUrl: string = "/login",
 82:   _userRole?: string
 83: ): string {
 84:   if (isSuccess) {
 85:     const callbackUrl = getCallbackUrl(searchParams);
 86:     if (callbackUrl === "/dashboard") {
 87:       return getLandingDashboardUrl();
 88:     }
 89:     return callbackUrl;
 90:   }
 91:   return errorUrl;
 92: }
 93: export function getSmartRedirectUrl(
 94:   isAuthenticated: boolean,
 95:   currentPath: string,
 96:   _userRole?: string
 97: ): string | null {
 98:   if (
 99:     isAuthenticated &&
100:     ["/login", "/register", "/auth/signin"].includes(currentPath)
101:   ) {
102:     return getLandingDashboardUrl();
103:   }
104:   const protectedRoutes = [
105:     "/dashboard",
106:     "/dashboard/researcher",
107:     "/dashboard/pro-researcher",
108:     "/dashboard/team-lead",
109:     "/dashboard/admin",
110:     "/papers",
111:     "/collections",
112:     "/collaborate",
113:   ];
114:   const isProtectedRoute = protectedRoutes.some(
115:     (route) => currentPath === route || currentPath.startsWith(route + "/")
116:   );
117:   if (!isAuthenticated && isProtectedRoute) {
118:     return buildLoginUrl(currentPath);
119:   }
120:   return null;
121: }
122: export function getGetStartedUrl(
123:   isAuthenticated: boolean,
124:   currentPath: string = "/",
125:   _userRole?: string
126: ): string {
127:   if (isAuthenticated) {
128:     return getLandingDashboardUrl();
129:   }
130:   if (
131:     currentPath !== "/" &&
132:     currentPath !== "/login" &&
133:     currentPath !== "/register"
134:   ) {
135:     return buildLoginUrl(currentPath);
136:   }
137:   return "/login";
138: }
</file>

