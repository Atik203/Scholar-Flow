 9:     .refine((v) => v.startsWith("https://") || v.startsWith("http://"), {
10:       message: "Webhook URL must use http:// or https://",
11:     }),
12:   description: z.string().max(1000).optional(),
13:   events: z.array(z.string()).min(1),
14:   status: z.enum(["ACTIVE", "INACTIVE"]).default("ACTIVE"),
15: });
16: export const updateEndpointSchema = z.object({
17:   name: z.string().min(1).max(200).optional(),
18:   url: z
19:     .string()
20:     .url()
21:     .max(2000)
22:     .refine((v) => v.startsWith("https://") || v.startsWith("http://"), {
23:       message: "Webhook URL must use http:// or https://",
24:     })
25:     .optional(),
26:   description: z.string().max(1000).optional(),
27:   events: z.array(z.string()).min(1).optional(),
28:   status: z.enum(["ACTIVE", "INACTIVE", "ERROR"]).optional(),
29: });
30: export const endpointIdSchema = z.object({
31:   id: z.string().uuid("Invalid endpoint ID"),
32: });
33: export const listDeliveriesQuerySchema = z.object({
34:   page: z.string().optional().transform((v) => toPositiveInt(v, 1)),
35:   limit: z.string().optional().transform((v) => toBoundedInt(v, 20, 100)),
