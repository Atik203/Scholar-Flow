 1: import {
 2:   createApi,
 3:   fetchBaseQuery,
 4:   FetchBaseQueryError,
 5: } from "@reduxjs/toolkit/query/react";
 6: import type { RootState } from "../store";
 7: export interface ApiErrorResponse {
 8:   success: false;
 9:   message: string;
10:   statusCode: number;
11:   errorCode?: string;
12:   details?: Record<string, any>;
13:   timestamp?: string;
14: }
15: const transformErrorResponse = (
16:   response: FetchBaseQueryError
17: ): ApiErrorResponse => {
18:   if ("data" in response && response.data) {
19:     const apiError = response.data as ApiErrorResponse;
20:     return {
21:       success: false,
22:       message: apiError.message || "An error occurred",
23:       statusCode: response.status as number,
24:       errorCode: apiError.errorCode,
25:       details: apiError.details,
26:       timestamp: apiError.timestamp || new Date().toISOString(),
27:     };
28:   }
29:   if ("error" in response) {
30:     return {
31:       success: false,
32:       message: response.error,
33:       statusCode: 0,
34:       errorCode: "NETWORK_ERROR",
35:       timestamp: new Date().toISOString(),
36:     };
37:   }
38:   return {
39:     success: false,
40:     message: `Request failed with status ${response.status}`,
41:     statusCode: response.status as number,
42:     errorCode: "UNKNOWN_ERROR",
43:     timestamp: new Date().toISOString(),
44:   };
45: };
46: const baseQuery = fetchBaseQuery({
47:   baseUrl: process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:5000/api",
48:   prepareHeaders: (headers, { getState, endpoint }) => {
49:     const token = (getState() as RootState).auth.accessToken;
50:     if (token) {
51:       headers.set("authorization", `Bearer ${token}`);
52:     } else if (process.env.NODE_ENV !== "production") {
53:       console.warn(
54:         `[apiSlice] No accessToken for endpoint: ${String(endpoint)}`
55:       );
56:     }
57:     return headers;
58:   },
59: });
60: export const apiSlice = createApi({
61:   reducerPath: "api",
62:   baseQuery,
63:   tagTypes: [
64:     "Paper",
65:     "Collection",
66:     "CollectionPaper",
67:     "CollectionMember",
68:     "CollectionInvite",
69:     "Workspace",
70:     "Team",
71:     "User",
72:     "UserPreferences",
73:     "UserActivity",
74:     "Annotation",
75:     "ProcessingStatus",
76:     "AIInsight",
77:     "Admin",
