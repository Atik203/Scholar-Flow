221:     });
222:     if (!updatedConv) throw new Error("Conversation not found");
223:     const contextMessages = await buildContextMessages(conv.context as any, userId);
224:     const allMessages = [
225:       ...contextMessages,
226:       ...((updatedConv.messages || []).map((m) => ({ role: m.role, content: m.content }))),
227:     ];
228:     const aiResp = await generateAiResponse(
229:       allMessages.map((m) => ({ role: m.role, content: m.content })),
230:       updatedConv.model ?? undefined
231:     );
232:     const resolved = await resolveProviderForModel(updatedConv.model ?? "");
233:     const inputTokens = Math.ceil(content.length / 4);
234:     const outputTokens = Math.ceil((aiResp.content?.length ?? 0) / 4);
235:     const costCents = estimateCost(inputTokens, outputTokens, resolved);
236:     const aiMessage = await prisma.aIConversationMessage.create({
237:       data: {
238:         conversationId,
239:         role: "assistant",
240:         content: aiResp.content,
241:         model: aiResp.model,
242:         tokensUsed: aiResp.tokensUsed,
243:         costCents,
244:       },
245:     });
246:     if (!updatedConv.title || updatedConv.title === "New Chat") {
247:       const firstMsg = updatedConv.messages?.[0];
248:       if (firstMsg) {
249:         await prisma.aIConversation.update({
250:           where: { id: conversationId },
