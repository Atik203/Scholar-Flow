<file path="apps/frontend/src/components/ai-assistant/AiContextProvider.tsx">
 1: "use client";
 2: import type { ReactNode } from "react";
 3: import { createContext, useCallback, useContext, useRef } from "react";
 4: export interface PageAiContext {
 5:   type: "paper" | "workspace" | "dashboard";
 6:   id?: string;
 7:   title?: string;
 8: }
 9: interface AiContextValue {
10:   currentContext: PageAiContext | null;
11:   setContext: (ctx: PageAiContext | null) => void;
12: }
13: const AiCtx = createContext<AiContextValue>({
14:   currentContext: null,
15:   setContext: () => {},
16: });
17: export function AiContextProvider({ children }: { children: ReactNode }) {
18:   const ctxRef = useRef<PageAiContext | null>(null);
19:   const listenersRef = useRef<Set<(ctx: PageAiContext | null) => void>>(
20:     new Set()
21:   );
22:   const setContext = useCallback((ctx: PageAiContext | null) => {
23:     ctxRef.current = ctx;
24:     for (const listener of listenersRef.current) {
25:       listener(ctx);
26:     }
27:   }, []);
28:   const subscribe = useCallback(
29:     (listener: (ctx: PageAiContext | null) => void) => {
30:       listenersRef.current.add(listener);
31:       return () => { listenersRef.current.delete(listener); };
32:     },
33:     []
34:   );
35:   const getValue = useCallback(() => {
36:     return {
37:       currentContext: ctxRef.current,
38:       setContext,
39:       subscribe,
40:     } as AiContextValue & { subscribe: typeof subscribe };
41:   }, [setContext, subscribe]);
42:   const value: AiContextValue = {
43:     get currentContext() { return ctxRef.current; },
44:     setContext,
45:   };
46:   return <AiCtx.Provider value={value}>{children}</AiCtx.Provider>;
47: }
48: export function useAiContext() {
49:   return useContext(AiCtx);
50: }
</file>

