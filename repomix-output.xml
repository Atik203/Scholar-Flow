 29: }
 30: function DropdownMenu({
 31:   open: controlledOpen,
 32:   onOpenChange,
 33:   defaultOpen = false,
 34:   children,
 35: }: DropdownMenuProps) {
 36:   const [uncontrolledOpen, setUncontrolledOpen] = React.useState(defaultOpen);
 37:   const isControlled = controlledOpen !== undefined;
 38:   const open = isControlled ? controlledOpen : uncontrolledOpen;
 39:   const handleOpenChange = React.useCallback(
 40:     (newOpen: boolean) => {
 41:       if (!isControlled) {
 42:         setUncontrolledOpen(newOpen);
 43:       }
 44:       onOpenChange?.(newOpen);
 45:     },
 46:     [isControlled, onOpenChange]
 47:   );
 48:   return (
 49:     <DropdownMenuContext.Provider
 50:       value={{ open, onOpenChange: handleOpenChange }}
 51:     >
 52:       <div className="relative inline-block">{children}</div>
 53:     </DropdownMenuContext.Provider>
 54:   );
 55: }
