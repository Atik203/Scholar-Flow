                <div>
                  <h3 className="font-semibold text-white">ScholarFlow AI</h3>
                  <p className="text-violet-100 text-xs flex items-center gap-1">
                    <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
