 74:   ERROR: 'bg-red-100 text-red-800',
 75:   CRITICAL: 'bg-red-100 text-red-800',
 76: };
 77: const entityIcons = {
 78:   paper: FileText,
 79:   collection: BookOpen,
 80:   workspace: Layers,
 81:   discussion: MessageSquare,
 82:   user: User,
 83: };
 84: const actionLabels = {
 85:   created: 'Created',
 86:   updated: 'Updated',
 87:   deleted: 'Deleted',
 88:   shared: 'Shared',
 89:   exported: 'Exported',
 90:   message_added: 'Message Added',
 91:   message_updated: 'Message Updated',
 92:   message_deleted: 'Message Deleted',
 93: };
 94: export function ActivityLog({ workspaceId, entity, entityId, limit = 50 }: ActivityLogProps) {
 95:   const [activities, setActivities] = useState<ActivityLogEntry[]>([]);
 96:   const [loading, setLoading] = useState(true);
 97:   const [filters, setFilters] = useState({
 98:     entity: entity || '',
 99:     action: '',
100:     severity: '',
101:     startDate: undefined as Date | undefined,
102:     endDate: undefined as Date | undefined,
103:   });
104:   const fetchActivities = useCallback(async () => {
105:     setLoading(true);
106:     try {
107:       const params = new URLSearchParams();
108:       if (workspaceId) params.append('workspaceId', workspaceId);
109:       if (entity) params.append('entity', entity);
110:       if (entityId) params.append('entityId', entityId);
111:       if (filters.entity) params.append('entity', filters.entity);
112:       if (filters.action) params.append('action', filters.action);
113:       if (filters.severity) params.append('severity', filters.severity);
114:       if (filters.startDate) params.append('startDate', filters.startDate.toISOString());
115:       if (filters.endDate) params.append('endDate', filters.endDate.toISOString());
116:       params.append('limit', limit.toString());
117:       const response = await fetch(`/api/activity-log?${params.toString()}`);
118:       if (!response.ok) {
119:         throw new Error('Failed to fetch activity log');
120:       }
121:       const result = await response.json();
122:       setActivities(result.data.entries);
123:     } catch (error) {
124:       console.error('Activity log error:', error);
125:       showErrorToast('Failed to load activity log');
126:     } finally {
127:       setLoading(false);
128:     }
129:   }, [workspaceId, entity, entityId, filters, limit]);
130:   useEffect(() => {
131:     fetchActivities();
132:   }, [fetchActivities]);
133:   const getUserDisplayName = (user?: ActivityLogEntry['user']) => {
134:     if (!user) return 'System';
135:     if (user.firstName && user.lastName) {
136:       return `${user.firstName} ${user.lastName}`;
137:     }
138:     return user.name || 'Unknown User';
139:   };
140:   const getUserInitials = (user?: ActivityLogEntry['user']) => {
141:     if (!user) return 'S';
142:     if (user.firstName && user.lastName) {
143:       return `${user.firstName[0]}${user.lastName[0]}`.toUpperCase();
144:     }
145:     if (user.name) {
