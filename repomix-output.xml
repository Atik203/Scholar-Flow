 90: export function isValidPosition(pos: number | null | undefined): pos is number {
 91:   return typeof pos === "number" && pos >= 0;
 92: }
 93: export function isExtensionAvailable(
 94:   editor: Editor | null,
 95:   extensionNames: string | string[]
 96: ): boolean {
 97:   if (!editor) return false;
 98:   const names = Array.isArray(extensionNames)
 99:     ? extensionNames
100:     : [extensionNames];
101:   const found = names.some((name) =>
102:     editor.extensionManager.extensions.some((ext) => ext.name === name)
103:   );
104:   if (!found) {
105:     console.warn(
106:       `None of the extensions [${names.join(", ")}] were found in the editor schema. Ensure they are included in the editor configuration.`
107:     );
108:   }
109:   return found;
110: }
111: export function findNodeAtPosition(editor: Editor, position: number) {
112:   try {
113:     const node = editor.state.doc.nodeAt(position);
114:     if (!node) {
115:       console.warn(`No node found at position ${position}`);
116:       return null;
117:     }
118:     return node;
119:   } catch (error) {
120:     console.error(`Error getting node at position ${position}:`, error);
121:     return null;
122:   }
123: }
124: export function findNodePosition(props: {
125:   editor: Editor | null;
126:   node?: TiptapNode | null;
127:   nodePos?: number | null;
128: }): { pos: number; node: TiptapNode } | null {
129:   const { editor, node, nodePos } = props;
130:   if (!editor || !editor.state?.doc) return null;
131:   const hasValidNode = node !== undefined && node !== null;
132:   const hasValidPos = isValidPosition(nodePos);
133:   if (!hasValidNode && !hasValidPos) {
134:     return null;
135:   }
136:   if (hasValidNode) {
137:     let foundPos = -1;
138:     let foundNode: TiptapNode | null = null;
139:     editor.state.doc.descendants((currentNode, pos) => {
140:       if (currentNode === node) {
141:         foundPos = pos;
142:         foundNode = currentNode;
143:         return false;
144:       }
145:       return true;
146:     });
147:     if (foundPos !== -1 && foundNode !== null) {
148:       return { pos: foundPos, node: foundNode };
149:     }
150:   }
151:   if (hasValidPos) {
152:     const nodeAtPos = findNodeAtPosition(editor, nodePos!);
153:     if (nodeAtPos) {
154:       return { pos: nodePos!, node: nodeAtPos };
155:     }
156:   }
157:   return null;
158: }
159: export function isNodeTypeSelected(
160:   editor: Editor | null,
161:   types: string[] = []
162: ): boolean {
163:   if (!editor || !editor.state.selection) return false;
164:   const { state } = editor;
165:   const { selection } = state;
166:   if (selection.empty) return false;
167:   if (selection instanceof NodeSelection) {
168:     const node = selection.node;
169:     return node ? types.includes(node.type.name) : false;
170:   }
171:   return false;
172: }
173: export const handleImageUpload = async (
174:   file: File,
175:   onProgress?: (event: { progress: number }) => void,
176:   abortSignal?: AbortSignal
177: ): Promise<string> => {
178:   if (!file) {
179:     throw new Error("No file provided");
180:   }
181:   if (file.size > MAX_FILE_SIZE) {
182:     throw new Error(
183:       `File size exceeds maximum allowed (${MAX_FILE_SIZE / (1024 * 1024)}MB)`
184:     );
185:   }
186:   const allowedTypes = ["image/jpeg", "image/png", "image/gif", "image/webp"];
187:   if (!allowedTypes.includes(file.type)) {
188:     throw new Error(
189:       "Invalid file type. Only JPEG, PNG, GIF, and WebP images are allowed."
190:     );
191:   }
192:   try {
193:     const store = getAppStore();
194:     if (!store) {
195:       throw new Error(
196:         "Redux store not initialized. This function can only be used in client components after authentication."
197:       );
198:     }
199:     const state = store.getState();
200:     const token = state?.auth?.accessToken;
201:     if (!token) {
202:       throw new Error(
203:         "Authentication required. Please sign in to upload images."
204:       );
205:     }
206:     const formData = new FormData();
207:     formData.append("image", file);
208:     return new Promise<string>((resolve, reject) => {
209:       const xhr = new XMLHttpRequest();
210:       if (onProgress) {
211:         xhr.upload.addEventListener("progress", (event) => {
212:           if (event.lengthComputable) {
213:             const progress = Math.round((event.loaded / event.total) * 100);
214:             onProgress({ progress });
215:           }
216:         });
217:       }
218:       if (abortSignal) {
219:         abortSignal.addEventListener("abort", () => {
220:           xhr.abort();
221:           reject(new Error("Upload cancelled"));
222:         });
223:       }
224:       xhr.onload = () => {
225:         if (xhr.status >= 200 && xhr.status < 300) {
226:           try {
227:             const response = JSON.parse(xhr.responseText);
228:             console.log("Upload response received:", response);
229:             if (response.success && response.data?.url) {
230:               console.log("Upload successful, URL:", response.data.url);
231:               resolve(response.data.url);
232:             } else {
233:               console.error("Upload failed - response:", response);
234:               reject(
235:                 new Error(response.message || "Upload failed: No URL returned")
236:               );
237:             }
238:           } catch (error) {
239:             console.error("Response parsing error:", error);
240:             console.error("Raw response text:", xhr.responseText);
241:             reject(new Error("Invalid response from server"));
242:           }
243:         } else {
244:           try {
245:             const errorResponse = JSON.parse(xhr.responseText);
246:             console.error("Upload failed with error response:", errorResponse);
247:             reject(
248:               new Error(
249:                 errorResponse.message ||
250:                   `Upload failed with status ${xhr.status}`
251:               )
252:             );
253:           } catch {
254:             console.error(
255:               "Upload failed with status and raw response:",
256:               xhr.status,
257:               xhr.responseText
258:             );
259:             reject(new Error(`Upload failed with status ${xhr.status}`));
260:           }
261:         }
262:       };
263:       xhr.onerror = () => {
264:         reject(new Error("Network error during upload"));
265:       };
266:       xhr.ontimeout = () => {
267:         reject(new Error("Upload timeout"));
268:       };
269:       const apiBaseUrl =
270:         process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:5000/api";
271:       xhr.open("POST", `${apiBaseUrl}/editor/upload-image`);
272:       xhr.setRequestHeader("Authorization", `Bearer ${token}`);
273:       xhr.timeout = 60000;
274:       xhr.send(formData);
275:     });
276:   } catch (error) {
277:     console.error("Upload error:", error);
278:     throw new Error(
279:       `Upload failed: ${error instanceof Error ? error.message : "Unknown error"}`
280:     );
281:   }
282: };
283: type ProtocolOptions = {
284:   scheme: string;
285:   optionalSlashes?: boolean;
286: };
287: type ProtocolConfig = Array<ProtocolOptions | string>;
288: const ATTR_WHITESPACE =
289:   /[\u0000-\u0020\u00A0\u1680\u180E\u2000-\u2029\u205F\u3000]/g;
290: export function isAllowedUri(
291:   uri: string | undefined,
292:   protocols?: ProtocolConfig
293: ) {
294:   const allowedProtocols: string[] = [
295:     "http",
296:     "https",
297:     "ftp",
298:     "ftps",
299:     "mailto",
300:     "tel",
301:     "callto",
302:     "sms",
303:     "cid",
304:     "xmpp",
305:   ];
306:   if (protocols) {
307:     protocols.forEach((protocol) => {
308:       const nextProtocol =
309:         typeof protocol === "string" ? protocol : protocol.scheme;
310:       if (nextProtocol) {
311:         allowedProtocols.push(nextProtocol);
312:       }
313:     });
314:   }
315:   return (
316:     !uri ||
317:     uri
318:       .replace(ATTR_WHITESPACE, "")
319:       .match(
320:         new RegExp(
321:           `^(?:(?:${allowedProtocols.join("|")}):|[^a-z]|[a-z0-9+.\-]+(?:[^a-z+.\-:]|$))`,
322:           "i"
323:         )
324:       )
325:   );
326: }
327: export function sanitizeUrl(
328:   inputUrl: string,
329:   baseUrl: string,
330:   protocols?: ProtocolConfig
331: ): string {
332:   try {
333:     const url = new URL(inputUrl, baseUrl);
334:     if (isAllowedUri(url.href, protocols)) {
335:       return url.href;
336:     }
337:   } catch {
338:   }
339:   return "#";
340: }
</file>

