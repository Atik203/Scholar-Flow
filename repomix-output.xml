156:       <div className="max-w-md mx-auto py-20">
157:         <Card>
158:           <CardHeader>
159:             <CardTitle className="flex items-center gap-2">
160:               <Lock className="h-5 w-5 text-muted-foreground" />
161:               Citation Graph
162:             </CardTitle>
163:           </CardHeader>
164:           <CardContent className="space-y-4">
165:             <p className="text-sm text-muted-foreground">
166:               Visualizing real citation relationships between your papers is
167:               available to Pro Researchers and above.
168:             </p>
169:             <Button asChild className="w-full">
170:               <Link href="/dashboard/billing">Upgrade to Pro</Link>
171:             </Button>
172:           </CardContent>
173:         </Card>
174:       </div>
175:     );
176:   }
177:   return (
178:     <div className="flex h-[calc(100vh-4rem)] gap-0">
179:       <div className="w-96 shrink-0 border-r bg-card flex flex-col">
180:         <div className="p-4 border-b space-y-3">
181:           <h1 className="text-lg font-semibold flex items-center gap-2">
182:             <GitGraph className="h-5 w-5 text-primary" />
183:             Citation Graph
184:           </h1>
185:           <div className="relative">
186:             <Search className="absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground" />
187:             <Input
188:               placeholder="Search papers..."
189:               className="pl-9"
190:               value={search}
191:               onChange={(e) => setSearch(e.target.value)}
192:             />
193:           </div>
194:         </div>
195:         <div className="flex-1 overflow-auto p-3 space-y-2">
196:           {isLoading ? (
197:             <div className="flex items-center justify-center py-12">
198:               <div className="animate-spin rounded-full h-6 w-6 border-2 border-primary border-t-transparent" />
199:             </div>
200:           ) : (
201:             filteredPapers.map((paper) => {
202:               const isSelected = selectedIds.has(paper.id);
203:               return (
204:                 <motion.div
205:                   key={paper.id}
206:                   layout
207:                   className={`p-3 rounded-lg border cursor-pointer transition-colors ${
208:                     isSelected
209:                       ? "border-primary bg-primary/5"
210:                       : "hover:bg-muted/50"
211:                   }`}
212:                   onClick={() => toggleSelect(paper.id)}
213:                 >
214:                   <div className="flex items-start justify-between gap-2">
215:                     <p className="text-sm font-medium line-clamp-2 leading-snug">
216:                       {paper.title}
217:                     </p>
218:                     <Button
219:                       variant={isSelected ? "default" : "outline"}
220:                       size="sm"
221:                       className="h-7 shrink-0"
222:                       onClick={(e) => {
223:                         e.stopPropagation();
224:                         toggleSelect(paper.id);
225:                       }}
226:                     >
227:                       {isSelected ? (
228:                         <X className="h-3 w-3" />
229:                       ) : (
230:                         <Plus className="h-3 w-3" />
231:                       )}
232:                       {isSelected ? "Remove" : "Select"}
233:                     </Button>
234:                   </div>
235:                   <p className="text-xs text-muted-foreground mt-1">
236:                     {paper.authors}
237:                     {paper.year ? ` (${paper.year})` : ""}
238:                   </p>
239:                 </motion.div>
240:               );
241:             })
242:           )}
243:         </div>
244:       </div>
245:       <div className="flex-1 relative bg-muted/20 overflow-hidden">
246:         {selectedIds.size === 0 ? (
247:           <div className="absolute inset-0 flex items-center justify-center">
248:             <div className="text-center space-y-3">
249:               <GitGraph className="h-12 w-12 text-muted-foreground/30 mx-auto" />
250:               <p className="text-muted-foreground">
251:                 Select papers to build a citation graph
252:               </p>
253:               <p className="text-xs text-muted-foreground/70 max-w-sm mx-auto">
254:                 Arrows show real citation relationships between your selected
255:                 papers.
256:               </p>
257:             </div>
258:           </div>
259:         ) : (
260:           <>
261:             <svg className="absolute inset-0 w-full h-full pointer-events-none">
262:               <defs>
263:                 <marker
