<file path="apps/backend/src/app/modules/annotations/annotation.service.ts">
  1: import { randomUUID } from "crypto";
  2: import ApiError from "../../errors/ApiError";
  3: import prisma from "../../shared/prisma";
  4: import {
  5:   CreateAnnotationInput,
  6:   CreateAnnotationReplyInput,
  7:   GetAnnotationsQuery,
  8:   UpdateAnnotationInput,
  9: } from "./annotation.types";
 10: export class AnnotationService {
 11:   static async createAnnotation(userId: string, data: CreateAnnotationInput) {
 12:     const annotationId = randomUUID();
 13:     const now = new Date();
 14:     try {
 15:       await prisma.$executeRaw`
 16:         INSERT INTO "Annotation" (
 17:           id, "paperId", "userId", type, anchor, text, "parentId", version,
 18:           "createdAt", "updatedAt", "isDeleted"
 19:         )
 20:         VALUES (
 21:           ${annotationId}, ${data.paperId}, ${userId}, ${data.type}::"AnnotationType",
 22:           ${JSON.stringify(data.anchor)}::jsonb, ${data.text}, ${data.parentId || null},
 23:           1, ${now}, ${now}, false
 24:         )
 25:       `;
 26:       // Fetch the created annotation with all related data using $queryRaw
 27:       const annotations = await prisma.$queryRaw<any[]>`
 28:         SELECT
 29:           a.id, a."paperId", a."userId", a.type, a.anchor, a.text, a.version,
 30:           a."parentId", a."createdAt", a."updatedAt",
 31:           json_build_object(
 32:             'id', u.id,
 33:             'name', u.name,
 34:             'email', u.email,
 35:             'image', u.image
 36:           ) as user,
 37:           json_build_object(
 38:             'id', p.id,
 39:             'title', p.title
 40:           ) as paper,
 41:           CASE WHEN a."parentId" IS NOT NULL THEN
 42:             json_build_object(
 43:               'id', parent_a.id,
 44:               'text', parent_a.text,
 45:               'user', json_build_object(
 46:                 'id', parent_u.id,
 47:                 'name', parent_u.name,
 48:                 'email', parent_u.email,
 49:                 'image', parent_u.image
 50:               )
 51:             )
 52:           ELSE NULL END as parent,
 53:           COALESCE(
 54:             (
 55:               SELECT json_agg(
 56:                 json_build_object(
 57:                   'id', child_a.id,
 58:                   'text', child_a.text,
 59:                   'createdAt', child_a."createdAt",
 60:                   'user', json_build_object(
 61:                     'id', child_u.id,
 62:                     'name', child_u.name,
 63:                     'email', child_u.email,
 64:                     'image', child_u.image
 65:                   )
 66:                 ) ORDER BY child_a."createdAt" ASC
 67:               )
 68:               FROM "Annotation" child_a
 69:               LEFT JOIN "User" child_u ON child_a."userId" = child_u.id
 70:               WHERE child_a."parentId" = a.id AND child_a."isDeleted" = false
 71:             ),
 72:             '[]'::json
 73:           ) as children
 74:         FROM "Annotation" a
 75:         LEFT JOIN "User" u ON a."userId" = u.id
 76:         LEFT JOIN "Paper" p ON a."paperId" = p.id
 77:         LEFT JOIN "Annotation" parent_a ON a."parentId" = parent_a.id
 78:         LEFT JOIN "User" parent_u ON parent_a."userId" = parent_u.id
 79:         WHERE a.id = ${annotationId}
 80:         LIMIT 1
 81:       `;
 82:       if (annotations.length === 0) {
 83:         throw new ApiError(500, "Failed to create annotation");
 84:       }
 85:       return annotations[0];
 86:     } catch (error) {
 87:       console.error("Error creating annotation:", error);
 88:       throw new ApiError(500, "Failed to create annotation");
 89:     }
 90:   }
 91:   /**
 92:    * Get annotations for a paper using standard Prisma client with pagination
 93:    */
 94:   static async getPaperAnnotations(query: GetAnnotationsQuery) {
 95:     try {
 96:       const { paperId, page: pageFilter, type, limit = 50, pageNum = 1 } = query;
 97:       const skip = (pageNum - 1) * limit;
 98:       const where: Record<string, unknown> = {
 99:         paperId,
100:         isDeleted: false,
101:       };
102:       // Filter by PDF page number stored in JSONB anchor
103:       if (pageFilter !== undefined) {
104:         where.anchor = { path: ['page'], equals: pageFilter };
105:       }
106:       if (type) {
107:         where.type = type;
108:       }
109:       const [annotations, total] = await Promise.all([
110:         prisma.annotation.findMany({
111:           where,
112:           select: {
113:             id: true,
114:             paperId: true,
115:             userId: true,
116:             type: true,
117:             anchor: true,
118:             text: true,
119:             version: true,
120:             parentId: true,
121:             createdAt: true,
122:             updatedAt: true,
123:             user: {
124:               select: { id: true, name: true, email: true, image: true },
125:             },
126:             children: {
127:               where: { isDeleted: false },
128:               orderBy: { createdAt: 'asc' },
129:               select: {
130:                 id: true,
131:                 text: true,
132:                 createdAt: true,
133:                 updatedAt: true,
134:                 user: {
135:                   select: { id: true, name: true, email: true, image: true },
136:                 },
137:               },
138:             },
139:             versions: {
140:               orderBy: { timestamp: 'desc' },
141:               take: 5,
142:               select: {
143:                 id: true,
144:                 version: true,
145:                 text: true,
146:                 timestamp: true,
147:                 changedBy: {
148:                   select: { id: true, name: true, email: true },
149:                 },
150:               },
151:             },
152:           },
153:           orderBy: { createdAt: 'asc' },
154:           take: Math.min(limit, 100),
155:           skip,
156:         }),
157:         prisma.annotation.count({ where }),
158:       ]);
159:       return {
160:         annotations,
161:         pagination: {
162:           page: pageNum,
163:           limit,
164:           total,
165:           totalPage: Math.ceil(total / limit),
166:         },
167:       };
168:     } catch (error) {
169:       console.error("Error fetching paper annotations:", error);
170:       throw new ApiError(500, "Failed to fetch annotations");
171:     }
172:   }
173:   /**
174:    * Update an annotation using raw SQL
175:    * Source: Optimized annotation update with version history
176:    */
177:   static async updateAnnotation(
178:     annotationId: string,
179:     userId: string,
180:     data: UpdateAnnotationInput
181:   ) {
182:     try {
183:       // Get current annotation using $queryRaw
184:       const currentAnnotations = await prisma.$queryRaw<any[]>`
185:         SELECT id, "userId", text, version, anchor
186:         FROM "Annotation"
187:         WHERE id = ${annotationId} AND "isDeleted" = false
188:         LIMIT 1
189:       `;
190:       if (currentAnnotations.length === 0) {
191:         throw new ApiError(404, "Annotation not found");
192:       }
193:       const currentAnnotation = currentAnnotations[0];
194:       if (currentAnnotation.userId !== userId) {
195:         throw new ApiError(403, "Unauthorized to update this annotation");
196:       }
197:       // Create version record if text is being updated
198:       if (data.text) {
199:         const versionId = randomUUID();
200:         const now = new Date();
201:         await prisma.$executeRaw`
202:           INSERT INTO "AnnotationVersion" (
203:             id, "annotationId", version, text, "changedById", timestamp,
204:             "createdAt", "updatedAt", "isDeleted"
205:           )
206:           VALUES (
207:             ${versionId}, ${annotationId}, ${currentAnnotation.version},
208:             ${currentAnnotation.text}, ${userId}, ${now}, ${now}, ${now}, false
209:           )
210:         `;
211:       }
212:       // Update annotation using $executeRaw
213:       const now = new Date();
214:       const newVersion = data.text
215:         ? currentAnnotation.version + 1
216:         : currentAnnotation.version;
217:       const newText = data.text || currentAnnotation.text;
218:       const newAnchor = data.anchor
219:         ? JSON.stringify(data.anchor)
220:         : JSON.stringify(currentAnnotation.anchor);
221:       await prisma.$executeRaw`
222:         UPDATE "Annotation"
223:         SET text = ${newText},
224:             version = ${newVersion},
225:             anchor = ${newAnchor}::jsonb,
226:             "updatedAt" = ${now}
227:         WHERE id = ${annotationId}
228:       `;
229:       // Fetch updated annotation with relations
230:       const updatedAnnotations = await prisma.$queryRaw<any[]>`
231:         SELECT
232:           a.id, a."paperId", a."userId", a.type, a.anchor, a.text, a.version,
233:           a."parentId", a."createdAt", a."updatedAt",
234:           json_build_object(
235:             'id', u.id,
236:             'name', u.name,
237:             'email', u.email,
238:             'image', u.image
239:           ) as user,
240:           COALESCE(
241:             (
242:               SELECT json_agg(
243:                 json_build_object(
244:                   'id', child_a.id,
245:                   'text', child_a.text,
246:                   'createdAt', child_a."createdAt",
247:                   'updatedAt', child_a."updatedAt",
248:                   'user', json_build_object(
249:                     'id', child_u.id,
250:                     'name', child_u.name,
251:                     'email', child_u.email,
252:                     'image', child_u.image
253:                   )
254:                 ) ORDER BY child_a."createdAt" ASC
255:               )
256:               FROM "Annotation" child_a
257:               LEFT JOIN "User" child_u ON child_a."userId" = child_u.id
258:               WHERE child_a."parentId" = a.id AND child_a."isDeleted" = false
259:             ),
260:             '[]'::json
261:           ) as children
262:         FROM "Annotation" a
263:         LEFT JOIN "User" u ON a."userId" = u.id
264:         WHERE a.id = ${annotationId}
265:         LIMIT 1
266:       `;
267:       return updatedAnnotations[0];
268:     } catch (error) {
269:       if (error instanceof ApiError) {
270:         throw error;
271:       }
272:       console.error("Error updating annotation:", error);
273:       throw new ApiError(500, "Failed to update annotation");
274:     }
275:   }
276:   /**
277:    * Delete an annotation using raw SQL (soft delete)
278:    * Source: Optimized soft delete for annotations
279:    */
280:   static async deleteAnnotation(annotationId: string, userId: string) {
281:     try {
282:       // Check annotation exists and belongs to user
283:       const annotations = await prisma.$queryRaw<any[]>`
284:         SELECT id, "userId"
285:         FROM "Annotation"
286:         WHERE id = ${annotationId} AND "isDeleted" = false
287:         LIMIT 1
288:       `;
289:       if (annotations.length === 0) {
290:         throw new ApiError(404, "Annotation not found");
291:       }
292:       if (annotations[0].userId !== userId) {
293:         throw new ApiError(403, "Unauthorized to delete this annotation");
294:       }
295:       // Soft delete
296:       const now = new Date();
297:       await prisma.$executeRaw`
298:         UPDATE "Annotation"
299:         SET "isDeleted" = true, "updatedAt" = ${now}
300:         WHERE id = ${annotationId}
301:       `;
302:       return { success: true };
303:     } catch (error) {
304:       if (error instanceof ApiError) {
305:         throw error;
306:       }
307:       console.error("Error deleting annotation:", error);
308:       throw new ApiError(500, "Failed to delete annotation");
309:     }
310:   }
311:   /**
312:    * Create a reply to an annotation using raw SQL
313:    * Source: Optimized annotation reply creation
314:    */
315:   static async createAnnotationReply(
316:     annotationId: string,
317:     userId: string,
318:     data: CreateAnnotationReplyInput
319:   ) {
320:     try {
321:       // Verify parent annotation exists
322:       const parentAnnotations = await prisma.$queryRaw<any[]>`
323:         SELECT id, "paperId", anchor
324:         FROM "Annotation"
325:         WHERE id = ${annotationId} AND "isDeleted" = false
326:         LIMIT 1
327:       `;
328:       if (parentAnnotations.length === 0) {
329:         throw new ApiError(404, "Parent annotation not found");
330:       }
331:       const parentAnnotation = parentAnnotations[0];
332:       const replyId = randomUUID();
333:       const now = new Date();
334:       // Create reply annotation
335:       await prisma.$executeRaw`
336:         INSERT INTO "Annotation" (
337:           id, "paperId", "userId", type, anchor, text, "parentId", version,
338:           "createdAt", "updatedAt", "isDeleted"
339:         )
340:         VALUES (
341:           ${replyId}, ${parentAnnotation.paperId}, ${userId},
342:           'COMMENT'::"AnnotationType", ${JSON.stringify(parentAnnotation.anchor)}::jsonb,
343:           ${data.text}, ${annotationId}, 1, ${now}, ${now}, false
344:         )
345:       `;
346:       // Fetch created reply with relations
347:       const replies = await prisma.$queryRaw<any[]>`
348:         SELECT
349:           a.id, a."paperId", a."userId", a.type, a.anchor, a.text, a.version,
350:           a."parentId", a."createdAt", a."updatedAt",
351:           json_build_object(
352:             'id', u.id,
353:             'name', u.name,
354:             'email', u.email,
355:             'image', u.image
356:           ) as user,
357:           json_build_object(
358:             'id', parent_a.id,
359:             'text', parent_a.text,
360:             'user', json_build_object(
361:               'id', parent_u.id,
362:               'name', parent_u.name,
363:               'email', parent_u.email,
364:               'image', parent_u.image
365:             )
366:           ) as parent
367:         FROM "Annotation" a
368:         LEFT JOIN "User" u ON a."userId" = u.id
369:         LEFT JOIN "Annotation" parent_a ON a."parentId" = parent_a.id
370:         LEFT JOIN "User" parent_u ON parent_a."userId" = parent_u.id
371:         WHERE a.id = ${replyId}
372:         LIMIT 1
373:       `;
374:       return replies[0];
375:     } catch (error) {
376:       if (error instanceof ApiError) {
377:         throw error;
378:       }
379:       console.error("Error creating annotation reply:", error);
380:       throw new ApiError(500, "Failed to create annotation reply");
381:     }
382:   }
383:   /**
384:    * Get annotation versions/history using raw SQL
385:    * Source: Optimized version history retrieval
386:    */
387:   static async getAnnotationVersions(annotationId: string) {
388:     try {
389:       const versions = await prisma.$queryRaw<any[]>`
390:         SELECT
391:           av.id, av."annotationId", av.version, av.text, av.timestamp,
392:           json_build_object(
393:             'id', u.id,
394:             'name', u.name,
395:             'email', u.email
396:           ) as "changedBy"
397:         FROM "AnnotationVersion" av
398:         LEFT JOIN "User" u ON av."changedById" = u.id
399:         WHERE av."annotationId" = ${annotationId} AND av."isDeleted" = false
400:         ORDER BY av.timestamp DESC
401:       `;
402:       return versions;
403:     } catch (error) {
404:       console.error("Error fetching annotation versions:", error);
405:       throw new ApiError(500, "Failed to fetch annotation versions");
406:     }
407:   }
408:   /**
409:    * Get user's annotations across all papers using raw SQL
410:    * Source: Optimized user annotations retrieval with pagination
411:    */
412:   static async getUserAnnotations(userId: string, page = 1, limit = 20) {
413:     const skip = (page - 1) * limit;
414:     try {
415:       const annotations = await prisma.$queryRaw<any[]>`
416:         SELECT
417:           a.id, a."paperId", a."userId", a.type, a.anchor, a.text, a.version,
418:           a."parentId", a."createdAt", a."updatedAt",
419:           json_build_object(
420:             'id', p.id,
421:             'title', p.title
422:           ) as paper,
423:           COALESCE(
424:             (
425:               SELECT json_agg(
426:                 json_build_object(
427:                   'id', child_a.id,
428:                   'text', child_a.text,
429:                   'createdAt', child_a."createdAt",
430:                   'user', json_build_object(
431:                     'id', child_u.id,
432:                     'name', child_u.name,
433:                     'email', child_u.email,
434:                     'image', child_u.image
435:                   )
436:                 ) ORDER BY child_a."createdAt" ASC
437:               )
438:               FROM "Annotation" child_a
439:               LEFT JOIN "User" child_u ON child_a."userId" = child_u.id
440:               WHERE child_a."parentId" = a.id AND child_a."isDeleted" = false
441:             ),
442:             '[]'::json
443:           ) as children
444:         FROM "Annotation" a
445:         LEFT JOIN "Paper" p ON a."paperId" = p.id
446:         WHERE a."userId" = ${userId} AND a."isDeleted" = false
447:         ORDER BY a."createdAt" DESC
448:         LIMIT ${limit} OFFSET ${skip}
449:       `;
450:       const totalResult = await prisma.$queryRaw<[{ count: bigint }]>`
451:         SELECT COUNT(*) as count
452:         FROM "Annotation"
453:         WHERE "userId" = ${userId} AND "isDeleted" = false
454:       `;
455:       const total = Number(totalResult[0]?.count || 0);
456:       return {
457:         annotations,
458:         pagination: {
459:           page,
460:           limit,
461:           total,
462:           totalPage: Math.ceil(total / limit),
463:         },
464:       };
465:     } catch (error) {
466:       console.error("Error fetching user annotations:", error);
467:       throw new ApiError(500, "Failed to fetch user annotations");
468:     }
469:   }
470: }
</file>

