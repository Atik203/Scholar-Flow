13: import { phase2Api } from "./api/phase2Api";
14: import authReducer from "./auth/authSlice";
15: const createNoopStorage = () => {
16:   return {
17:     getItem(_key: string) {
18:       return Promise.resolve(null);
19:     },
20:     setItem(_key: string, value: any) {
21:       return Promise.resolve(value);
22:     },
23:     removeItem(_key: string) {
24:       return Promise.resolve();
25:     },
26:   };
27: };
28: const createLocalStorage = () => {
29:   return {
30:     getItem(key: string) {
31:       return Promise.resolve(window.localStorage.getItem(key));
32:     },
33:     setItem(key: string, value: string) {
34:       return Promise.resolve(window.localStorage.setItem(key, value));
35:     },
36:     removeItem(key: string) {
37:       return Promise.resolve(window.localStorage.removeItem(key));
38:     },
39:   };
40: };
41: const storage =
42:   typeof window !== "undefined" ? createLocalStorage() : createNoopStorage();
