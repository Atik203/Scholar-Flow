 10: type RawBodyRequest = Request & { rawBody?: Buffer | string };
 11: type MutableRawBodyRequest = RawBodyRequest & { body?: unknown };
 12: type StripeWebhookEventType =
 13:   (typeof STRIPE_WEBHOOK_EVENTS)[keyof typeof STRIPE_WEBHOOK_EVENTS];
 14: const logDebug = (...args: unknown[]) => {
 15:   if (process.env.NODE_ENV !== "production") {
 16:     console.log(...args);
 17:   }
 18: };
 19: export const handleStripeWebhook = catchAsync(
 20:   async (req: Request, res: Response): Promise<void> => {
 21:     const sig = req.headers["stripe-signature"];
 22:     if (!sig) {
 23:       throw BillingError.webhookSignatureVerificationFailed();
 24:     }
 25:     if (!config.stripe.webhook_secret) {
 26:       throw new Error("STRIPE_WEBHOOK_SECRET not configured");
 27:     }
 28:     const rawBody = await getRawBodyBuffer(req as RawBodyRequest);
 29:     let event: Stripe.Event;
 30:     try {
 31:       event = stripe.webhooks.constructEvent(
 32:         rawBody,
 33:         sig,
 34:         config.stripe.webhook_secret
 35:       );
 36:     } catch (error) {
 37:       const errorMessage =
 38:         error instanceof Error ? error.message : "Unknown verification error";
 39:       console.error("Webhook signature verification failed", {
 40:         message: errorMessage,
 41:       });
 42:       throw BillingError.webhookSignatureVerificationFailed();
 43:     }
 44:     if (process.env.NODE_ENV === "development") {
 45:       console.log(`Received webhook event: ${event.type}`);
 46:     }
 47:     const existingEvent = await prismaClient.$queryRaw<Array<{ id: string }>>`
 48:       SELECT id
 49:       FROM "WebhookEvent"
 50:       WHERE provider = 'STRIPE'
 51:         AND "eventId" = ${event.id}
 52:       LIMIT 1
 53:     `;
 54:     if (existingEvent.length > 0) {
 55:       if (process.env.NODE_ENV !== "production") {
 56:         console.log(`Duplicate webhook event: ${event.id}, skipping`);
 57:       }
 58:       res.status(200).json({ received: true, duplicate: true });
 59:       return;
 60:     }
 61:     await prismaClient.$executeRaw`
 62:       INSERT INTO "WebhookEvent" (id, provider, "eventId", type, payload, status, "receivedAt", "createdAt", "updatedAt", "isDeleted")
 63:       VALUES (
 64:         gen_random_uuid(),
 65:         'STRIPE',
 66:         ${event.id},
 67:         ${event.type},
 68:         ${JSON.stringify(event)}::jsonb,
 69:         'pending',
 70:         NOW(),
 71:         NOW(),
 72:         NOW(),
 73:         false
 74:       )
 75:     `;
 76:     // Process event
 77:     try {
 78:       await processStripeEvent(event);
 79:       // Mark event as processed
 80:       await prismaClient.$executeRaw`
 81:         UPDATE "WebhookEvent"
 82:         SET status = 'processed', "processedAt" = NOW(), "updatedAt" = NOW()
 83:         WHERE "eventId" = ${event.id} AND provider = 'STRIPE'
 84:       `;
 85:     } catch (error) {
 86:       // Mark event as failed
 87:       const errorMessage =
 88:         error instanceof Error ? error.message : "Unknown error";
 89:       await prismaClient.$executeRaw`
 90:         UPDATE "WebhookEvent"
 91:         SET status = 'failed', error = ${errorMessage}, attempts = attempts + 1, "updatedAt" = NOW()
 92:         WHERE "eventId" = ${event.id} AND provider = 'STRIPE'
 93:       `;
 94:       console.error(`Failed to process webhook event ${event.id}:`, error);
 95:     }
 96:     res.status(200).json({ received: true });
 97:   }
 98: );
 99: /**
100:  * Process Stripe webhook events
101:  */
102: async function processStripeEvent(event: Stripe.Event): Promise<void> {
103:   switch (event.type) {
104:     case STRIPE_WEBHOOK_EVENTS.CHECKOUT_SESSION_COMPLETED:
105:     case STRIPE_WEBHOOK_EVENTS.CHECKOUT_SESSION_ASYNC_PAYMENT_SUCCEEDED:
106:       await handleCheckoutSessionCompleted(
107:         event.data.object as Stripe.Checkout.Session
108:       );
109:       break;
110:     case STRIPE_WEBHOOK_EVENTS.CHECKOUT_SESSION_ASYNC_PAYMENT_FAILED:
111:       // Asynchronous payment methods only; checkout is card-only today,
112:       // so this is a graceful no-op when it arrives.
113:       logDebug(
114:         `Async checkout payment failed: ${(event.data.object as Stripe.Checkout.Session).id}`
115:       );
116:       break;
117:     case STRIPE_WEBHOOK_EVENTS.INVOICE_PAYMENT_ACTION_REQUIRED:
118:       // Customer must complete an additional authentication step. The
119:       // subscription stays as-is until the outcome event arrives.
120:       logDebug(
121:         `Payment action required on invoice ${(event.data.object as Stripe.Invoice).id}`
122:       );
123:       break;
124:     case STRIPE_WEBHOOK_EVENTS.CUSTOMER_SUBSCRIPTION_CREATED:
125:     case STRIPE_WEBHOOK_EVENTS.CUSTOMER_SUBSCRIPTION_UPDATED:
126:       await handleSubscriptionUpdated(
127:         event.data.object as Stripe.Subscription,
128:         event.type as StripeWebhookEventType
129:       );
130:       break;
131:     case STRIPE_WEBHOOK_EVENTS.CUSTOMER_SUBSCRIPTION_DELETED:
132:       await handleSubscriptionDeleted(event.data.object as Stripe.Subscription);
133:       break;
134:     case STRIPE_WEBHOOK_EVENTS.INVOICE_PAID:
135:       await handleInvoicePaid(event.data.object as Stripe.Invoice);
136:       break;
137:     case STRIPE_WEBHOOK_EVENTS.INVOICE_PAYMENT_FAILED:
138:       await handleInvoicePaymentFailed(event.data.object as Stripe.Invoice);
139:       break;
140:     case STRIPE_WEBHOOK_EVENTS.CHARGE_REFUNDED:
141:       await handleChargeRefunded(event.data.object as Stripe.Charge);
142:       break;
143:     default:
144:       logDebug(`Unhandled event type: ${event.type}`);
145:   }
146: }
147: /**
148:  * Extract raw body buffer from request for Stripe signature verification
149:  * Handles both local (express.raw) and Vercel serverless (direct Buffer) cases
150:  */
151: async function getRawBodyBuffer(req: RawBodyRequest): Promise<Buffer> {
152:   // Case 1: Check rawBody property (custom middleware)
153:   const possibleRawBody = req.rawBody;
154:   if (Buffer.isBuffer(possibleRawBody)) {
155:     logDebug("[Webhook] Raw body extracted from req.rawBody (Buffer)");
156:     (req as RawBodyRequest).rawBody = possibleRawBody;
157:     return possibleRawBody;
158:   }
159:   if (typeof possibleRawBody === "string") {
160:     logDebug("[Webhook] Raw body extracted from req.rawBody (string)");
161:     const buffer = Buffer.from(possibleRawBody, "utf8");
162:     (req as RawBodyRequest).rawBody = buffer;
163:     (req as MutableRawBodyRequest).body = buffer;
164:     return buffer;
165:   }
166:   // Case 2: Check req.body (Vercel serverless or express.raw)
167:   if (Buffer.isBuffer(req.body)) {
168:     logDebug(
169:       "[Webhook] Raw body extracted from req.body (Buffer) - Vercel mode"
170:     );
171:     (req as RawBodyRequest).rawBody = req.body;
172:     return req.body;
173:   }
174:   if (typeof req.body === "string") {
175:     logDebug("[Webhook] Raw body extracted from req.body (string)");
176:     const buffer = Buffer.from(req.body, "utf8");
177:     (req as RawBodyRequest).rawBody = buffer;
178:     (req as MutableRawBodyRequest).body = buffer;
179:     return buffer;
180:   }
181:   // Case 3: Check if body is already parsed JSON (should not happen, but handle gracefully)
182:   if (req.body && typeof req.body === "object") {
183:     console.error(
184:       "[Webhook] Body already parsed as JSON - cannot verify signature"
185:     );
186:     console.error(
187:       "[Webhook] This indicates body parsing middleware is running before webhook route"
188:     );
189:     throw BillingError.webhookRawBodyMissing();
190:   }
191:   // Case 4: Attempt to read from request stream if not yet consumed (e.g., serverless environments)
192:   if (!req.readableEnded && req.readable !== false) {
193:     const chunks: Buffer[] = [];
194:     for await (const chunk of req) {
195:       if (typeof chunk === "string") {
196:         chunks.push(Buffer.from(chunk));
197:       } else {
198:         chunks.push(Buffer.from(chunk));
199:       }
200:     }
201:     if (chunks.length > 0) {
202:       const buffer = Buffer.concat(chunks);
203:       (req as RawBodyRequest).rawBody = buffer;
204:       (req as MutableRawBodyRequest).body = buffer;
205:       logDebug("[Webhook] Raw body captured by manual stream read");
206:       return buffer;
207:     }
208:   }
209:   console.error(
210:     "[Webhook] No raw body found in req stream after fallback attempts"
211:   );
212:   throw BillingError.webhookRawBodyMissing();
213: }
214: /**
215:  * Map a plan tier/code to the app role. Plan codes are `pro_*` / `team_*`
216:  * (Stripe price IDs are repointed when plans are edited, so matching on the
217:  * price ID would go stale — the code is stable).
218:  */
219: function getRoleFromPlanTier(
220:   tier: string
221: ): "RESEARCHER" | "PRO_RESEARCHER" | "TEAM_LEAD" {
222:   if (tier === "pro") return "PRO_RESEARCHER";
223:   if (tier === "team") return "TEAM_LEAD";
224:   return "RESEARCHER";
225: }
226: /**
227:  * Resolve the user role for a Stripe price ID by looking up the Plan code.
228:  * Falls back to RESEARCHER when no plan row exists.
229:  */
230: async function getRoleFromStripePriceId(
231:   priceId: string
232: ): Promise<"RESEARCHER" | "PRO_RESEARCHER" | "TEAM_LEAD"> {
233:   const plan = await prismaClient.$queryRaw<Array<{ code: string }>>`
234:     SELECT code
235:     FROM "Plan"
236:     WHERE "stripePriceId" = ${priceId}
237:       AND "isDeleted" = false
238:     LIMIT 1
239:   `;
240:   return getRoleFromPlanTier(plan[0]?.code?.split("_")[0] ?? "");
241: }
242: /**
243:  * Handle checkout session completed event
244:  */
245: async function handleCheckoutSessionCompleted(
246:   session: Stripe.Checkout.Session
247: ): Promise<void> {
248:   const userId = session.metadata?.userId;
249:   const workspaceId = session.metadata?.workspaceId || null;
250:   const stripePriceId = session.metadata?.priceId;
251:   const planTier = session.metadata?.planTier ?? null;
252:   if (!userId || !stripePriceId) {
253:     throw new Error("Missing required metadata in checkout session");
254:   }
255:   // Only grant access when payment actually settled. Checkout with
256:   // asynchronous payment methods completes before payment succeeds.
257:   if (session.payment_status !== "paid") {
258:     logDebug(
259:       `Checkout session ${session.id} not paid (${session.payment_status}), skipping subscription grant`
260:     );
261:     return;
262:   }
263:   if (!session.subscription) {
264:     throw new Error("No subscription in checkout session");
265:   }
266:   const subscriptionId =
267:     typeof session.subscription === "string"
268:       ? session.subscription
269:       : session.subscription.id;
270:   const stripeSubscription = (await stripe.subscriptions.retrieve(
271:     subscriptionId
272:   )) as Stripe.Subscription;
273:   const { currentPeriodStart, currentPeriodEnd } =
274:     getSubscriptionPeriodBounds(stripeSubscription);
275:   const stripeCustomerId =
276:     typeof stripeSubscription.customer === "string"
277:       ? stripeSubscription.customer
278:       : (stripeSubscription.customer?.id ?? null);
279:   if (currentPeriodEnd === null) {
280:     throw BillingError.webhookProcessingFailed(
281:       STRIPE_WEBHOOK_EVENTS.CHECKOUT_SESSION_COMPLETED,
282:       "Stripe subscription missing current period end"
283:     );
284:   }
285:   const subscriptionInterval =
286:     stripeSubscription.items.data[0]?.plan?.interval ?? "month";
287:   const normalizedInterval =
288:     subscriptionInterval === "year" ? "annual" : "monthly";
289:   const planByPrice = await prismaClient.$queryRaw<
290:     Array<{ id: string; code: string }>
291:   >`
292:     SELECT id, code
293:     FROM "Plan"
294:     WHERE "stripePriceId" = ${stripePriceId}
295:       AND "isDeleted" = false
296:     LIMIT 1
297:   `;
298:   let planId = planByPrice[0]?.id ?? null;
299:   if (!planId && planTier) {
300:     const fallbackCode = `${planTier}_${normalizedInterval}`;
301:     const fallbackPlan = await prismaClient.$queryRaw<Array<{ id: string }>>`
302:       SELECT id
303:       FROM "Plan"
304:       WHERE code = ${fallbackCode}
305:         AND "isDeleted" = false
306:       LIMIT 1
307:     `;
308:     planId = fallbackPlan[0]?.id ?? null;
309:   }
310:   if (!planId) {
311:     throw new Error(`Plan not found for Stripe price ID: ${stripePriceId}`);
312:   }
313:   const status = mapStripeStatus(stripeSubscription.status);
314:   const existingSubscription = await prismaClient.$queryRaw<
315:     Array<{ id: string }>
316:   >`
317:     SELECT id
318:     FROM "Subscription"
319:     WHERE "providerSubscriptionId" = ${stripeSubscription.id}
320:       AND "isDeleted" = false
321:     LIMIT 1
322:   `;
323:   const canceledAtSql =
324:     stripeSubscription.canceled_at != null
325:       ? Prisma.sql`to_timestamp(${Number(stripeSubscription.canceled_at)})`
326:       : Prisma.sql`NULL`;
327:   if (existingSubscription.length > 0) {
328:     await prismaClient.$executeRaw`
329:       UPDATE "Subscription"
330:       SET
331:         "planId" = ${planId},
332:         "workspaceId" = ${workspaceId},
333:         status = ${status}::"SubscriptionStatus",
334:         provider = 'STRIPE',
335:         "providerCustomerId" = ${stripeCustomerId},
336:         "providerSubscriptionId" = ${stripeSubscription.id},
337:         "cancelAtPeriodEnd" = ${stripeSubscription.cancel_at_period_end},
338:         "currentPeriodStart" = ${toTimestampSql(currentPeriodStart)},
339:         "currentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
340:         "trialStart" = ${toTimestampSql(stripeSubscription.trial_start ?? null)},
341:         "trialEnd" = ${toTimestampSql(stripeSubscription.trial_end ?? null)},
342:         "canceledAt" = ${canceledAtSql},
343:         "expiresAt" = ${toTimestampSql(currentPeriodEnd)},
344:         "updatedAt" = NOW()
345:       WHERE id = ${existingSubscription[0].id}
346:     `;
347:   } else {
348:     await prismaClient.$executeRaw`
349:       INSERT INTO "Subscription" (
350:         id,
351:         "userId",
352:         "workspaceId",
353:         "planId",
354:         status,
355:         provider,
356:         "providerCustomerId",
357:         "providerSubscriptionId",
358:         "cancelAtPeriodEnd",
359:         "currentPeriodStart",
360:         "currentPeriodEnd",
361:         "trialStart",
362:         "trialEnd",
363:         "startedAt",
364:         "expiresAt",
365:         "createdAt",
366:         "updatedAt",
367:         "isDeleted"
368:       ) VALUES (
369:         gen_random_uuid(),
370:         ${userId},
371:         ${workspaceId},
372:         ${planId},
373:         ${status}::"SubscriptionStatus",
374:         'STRIPE',
375:         ${stripeCustomerId},
376:         ${stripeSubscription.id},
377:         ${stripeSubscription.cancel_at_period_end},
378:         ${toTimestampSql(currentPeriodStart)},
379:         ${toTimestampSql(currentPeriodEnd)},
380:         ${toTimestampSql(stripeSubscription.trial_start ?? null)},
381:         ${toTimestampSql(stripeSubscription.trial_end ?? null)},
382:         NOW(),
383:         ${toTimestampSql(currentPeriodEnd)},
384:         NOW(),
385:         NOW(),
386:         false
387:       )
388:     `;
389:   }
390:   // Update user role and Stripe subscription fields based on the plan tier
391:   // (metadata.planTier is set at checkout creation and stays stable)
392:   const userRole = getRoleFromPlanTier(planTier ?? "");
393:   await prismaClient.$executeRaw`
394:     UPDATE "User"
395:     SET
396:       role = ${userRole}::"Role",
397:       "stripeSubscriptionId" = ${stripeSubscription.id},
398:       "stripePriceId" = ${stripePriceId},
399:       "stripeCurrentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
400:       "updatedAt" = NOW()
401:     WHERE id = ${userId}
402:   `;
403:   logDebug(
404:     `User ${userId} role updated to ${userRole} with subscription ${stripeSubscription.id}`
405:   );
406:   logDebug(
407:     `Subscription created/updated for user ${userId}: ${stripeSubscription.id}`
408:   );
409: }
410: /**
411:  * Handle subscription updated event
412:  */
413: async function handleSubscriptionUpdated(
414:   subscription: Stripe.Subscription,
415:   eventType: StripeWebhookEventType
416: ): Promise<void> {
417:   const status = mapStripeStatus(subscription.status);
418:   const { currentPeriodStart, currentPeriodEnd } =
419:     getSubscriptionPeriodBounds(subscription);
420:   if (currentPeriodEnd === null) {
421:     throw BillingError.webhookProcessingFailed(
422:       eventType,
423:       "Stripe subscription missing current period end"
424:     );
425:   }
426:   await prismaClient.$executeRaw`
427:     UPDATE "Subscription"
428:     SET
429:       status = ${status}::"SubscriptionStatus",
430:       "currentPeriodStart" = ${toTimestampSql(currentPeriodStart)},
431:       "currentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
432:       "cancelAtPeriodEnd" = ${subscription.cancel_at_period_end},
433:       "canceledAt" = ${subscription.canceled_at ? Prisma.sql`to_timestamp(${Number(subscription.canceled_at)})` : null},
434:       "expiresAt" = ${toTimestampSql(currentPeriodEnd)},
435:       "updatedAt" = NOW()
436:     WHERE "providerSubscriptionId" = ${subscription.id}
437:   `;
438:   const stripePriceId = subscription.items.data[0]?.price?.id || null;
439:   if (stripePriceId) {
440:     const customerId = getCustomerIdFromSubscription(subscription);
441:     if (!customerId) {
442:       logDebug(
443:         `Subscription ${subscription.id} has no customer reference, skipping user update`
444:       );
445:       return;
446:     }
447:     const user = await prismaClient.$queryRaw<Array<{ id: string }>>`
448:       SELECT id
449:       FROM "User"
450:       WHERE "stripeCustomerId" = ${customerId}
451:       LIMIT 1
452:     `;
453:     if (user.length > 0) {
454:       const userId = user[0].id;
455:       const userRole = await getRoleFromStripePriceId(stripePriceId);
456:       if (status === SUBSCRIPTION_STATUS.ACTIVE) {
457:         await prismaClient.$executeRaw`
458:           UPDATE "User"
459:           SET
460:             role = ${userRole}::"Role",
461:             "stripeSubscriptionId" = ${subscription.id},
462:             "stripePriceId" = ${stripePriceId},
463:             "stripeCurrentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
464:             "updatedAt" = NOW()
465:           WHERE id = ${userId}
466:         `;
467:         logDebug(`User ${userId} role updated to ${userRole}`);
468:       } else {
469:         // Just update subscription fields without changing role
470:         await prismaClient.$executeRaw`
471:           UPDATE "User"
472:           SET
473:             "stripeSubscriptionId" = ${subscription.id},
474:             "stripePriceId" = ${stripePriceId},
475:             "stripeCurrentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
476:             "updatedAt" = NOW()
477:           WHERE id = ${userId}
478:         `;
479:       }
480:     }
481:   }
482:   logDebug(`Subscription updated: ${subscription.id}`);
483: }
484: /**
485:  * Handle subscription deleted event
486:  */
487: async function handleSubscriptionDeleted(
488:   subscription: Stripe.Subscription
489: ): Promise<void> {
490:   await prismaClient.$executeRaw`
491:     UPDATE "Subscription"
492:     SET
493:       status = 'CANCELED'::"SubscriptionStatus",
494:       "canceledAt" = NOW(),
495:       "updatedAt" = NOW()
496:     WHERE "providerSubscriptionId" = ${subscription.id}
497:   `;
498:   // Find user by Stripe customer ID and revert to free tier
499:   const customerId = getCustomerIdFromSubscription(subscription);
500:   if (!customerId) {
501:     logDebug(
502:       `Subscription ${subscription.id} has no customer reference, skipping role revert`
503:     );
504:     return;
505:   }
506:   const user = await prismaClient.$queryRaw<Array<{ id: string }>>`
507:     SELECT id
508:     FROM "User"
509:     WHERE "stripeCustomerId" = ${customerId}
510:     LIMIT 1
511:   `;
512:   if (user.length > 0) {
513:     const userId = user[0].id;
514:     await prismaClient.$executeRaw`
515:       UPDATE "User"
516:       SET
517:         role = 'RESEARCHER',
518:         "stripeSubscriptionId" = NULL,
519:         "stripePriceId" = NULL,
520:         "stripeCurrentPeriodEnd" = NULL,
521:         "updatedAt" = NOW()
522:       WHERE id = ${userId}
523:     `;
524:     logDebug(`User ${userId} role reverted to RESEARCHER (free tier)`);
525:   }
526:   logDebug(`Subscription canceled: ${subscription.id}`);
527: }
528: /**
529:  * Handle invoice paid event
530:  */
531: async function handleInvoicePaid(invoice: Stripe.Invoice): Promise<void> {
532:   const subscriptionField = getSubscriptionFromInvoice(invoice);
533:   if (!subscriptionField) {
534:     return;
535:   }
536:   const subscriptionId =
537:     typeof subscriptionField === "string"
538:       ? subscriptionField
539:       : subscriptionField.id;
540:   // Find subscription
541:   const subscription = await prismaClient.$queryRaw<
542:     Array<{ id: string; userId: string }>
543:   >`
544:     SELECT id, "userId"
545:     FROM "Subscription"
546:     WHERE "providerSubscriptionId" = ${subscriptionId}
547:       AND "isDeleted" = false
548:     LIMIT 1
549:   `;
550:   if (subscription.length === 0) {
551:     console.warn(`Subscription not found for invoice: ${invoice.id}`);
552:     return;
553:   }
554:   // Record payment
555:   await prismaClient.$executeRaw`
556:     INSERT INTO "Payment" (
557:       id,
558:       "userId",
559:       "subscriptionId",
560:       provider,
561:       "amountCents",
562:       currency,
563:       "transactionId",
564:       status,
565:       raw,
566:       "createdAt",
567:       "updatedAt",
568:       "isDeleted"
569:     ) VALUES (
570:       gen_random_uuid(),
571:       ${subscription[0].userId},
572:       ${subscription[0].id},
573:       'STRIPE',
574:       ${invoice.amount_paid},
575:       ${invoice.currency.toUpperCase()},
576:       ${invoice.id},
577:       'SUCCEEDED',
578:       ${JSON.stringify(invoice)}::jsonb,
579:       NOW(),
580:       NOW(),
581:       false
582:     )
583:     ON CONFLICT ("transactionId")
584:     DO UPDATE SET
585:       status = 'SUCCEEDED',
586:       "updatedAt" = NOW()
587:   `;
588:   logDebug(`Invoice paid recorded: ${invoice.id}`);
589: }
590: /**
591:  * Handle invoice payment failed event
592:  */
593: async function handleInvoicePaymentFailed(
594:   invoice: Stripe.Invoice
595: ): Promise<void> {
596:   const subscriptionField = getSubscriptionFromInvoice(invoice);
597:   if (!subscriptionField) {
598:     return;
599:   }
600:   const subscriptionId =
601:     typeof subscriptionField === "string"
602:       ? subscriptionField
603:       : subscriptionField.id;
604:   // Find subscription (needed for the payment record + notification)
605:   const subscription = await prismaClient.$queryRaw<
606:     Array<{ id: string; userId: string }>
607:   >`
608:     SELECT id, "userId"
609:     FROM "Subscription"
610:     WHERE "providerSubscriptionId" = ${subscriptionId}
611:       AND "isDeleted" = false
612:     LIMIT 1
613:   `;
614:   if (subscription.length === 0) {
615:     console.warn(
616:       `Subscription not found for failed invoice: ${invoice.id}`
617:     );
618:     return;
619:   }
620:   // Update subscription status
621:   await prismaClient.$executeRaw`
622:     UPDATE "Subscription"
623:     SET
624:       status = 'PAST_DUE'::"SubscriptionStatus",
625:       "updatedAt" = NOW()
626:     WHERE "providerSubscriptionId" = ${subscriptionId}
627:   `;
628:   // Record the failed payment attempt (feeds the failed-payment metric
629:   // and gives the admin a visible failure trail). Idempotent per invoice.
630:   await prismaClient.$executeRaw`
631:     INSERT INTO "Payment" (
632:       id,
633:       "userId",
634:       "subscriptionId",
635:       provider,
636:       "amountCents",
637:       currency,
638:       "transactionId",
639:       status,
640:       raw,
641:       "createdAt",
642:       "updatedAt",
643:       "isDeleted"
644:     ) VALUES (
645:       gen_random_uuid(),
646:       ${subscription[0].userId},
647:       ${subscription[0].id},
648:       'STRIPE',
649:       ${invoice.amount_due},
650:       ${invoice.currency.toUpperCase()},
651:       ${invoice.id},
652:       'FAILED',
653:       ${JSON.stringify(invoice)}::jsonb,
654:       NOW(),
655:       NOW(),
656:       false
657:     )
658:     ON CONFLICT ("transactionId")
659:     DO UPDATE SET
660:       status = 'FAILED',
661:       "updatedAt" = NOW()
662:   `;
663:   // Notify the user about the failed payment (grace period is running)
664:   try {
665:     const { notificationService } = await import(
666:       "../Notification/notification.service"
667:     );
668:     await notificationService.createNotification({
669:       userId: subscription[0].userId,
670:       type: "SYSTEM",
671:       category: "BILLING",
672:       title: "Payment failed",
673:       message:
674:         "We couldn't charge your card for your subscription. Your paid plan continues during the grace period — update your payment method to avoid losing access.",
675:       actionUrl: "/dashboard/billing",
676:       resourceId: subscriptionId,
677:     });
678:   } catch (error) {
679:     // Notification failures must never fail the webhook itself
680:     if (process.env.NODE_ENV !== "production") {
681:       console.warn(
682:         "[Webhook] Failed to notify user about payment failure:",
683:         error
684:       );
685:     }
686:   }
687:   logDebug(`Invoice payment failed: ${invoice.id}`);
688: }
689: /**
690:  * Handle charge.refunded event — sync refunds issued from the Stripe
691:  * dashboard back to the local Payment row. Only full refunds flip the row;
692:  * partial refunds leave the payment SUCCEEDED.
693:  */
694: async function handleChargeRefunded(charge: Stripe.Charge): Promise<void> {
695:   // charge.invoice was removed from the SDK types on recent API versions —
696:   // probe the raw payload defensively.
697:   const invoiceId = (charge as unknown as { invoice?: string | null }).invoice;
698:   if (!invoiceId) {
699:     logDebug(`Charge ${charge.id} has no invoice reference, skipping`);
700:     return;
701:   }
702:   const isFullyRefunded = charge.amount_refunded >= charge.amount;
703:   const payment = await prismaClient.$queryRaw<
704:     Array<{ id: string; status: string }>
705:   >`
706:     SELECT id, status::text
707:     FROM "Payment"
708:     WHERE "transactionId" = ${invoiceId}
709:       AND "isDeleted" = false
710:     LIMIT 1
711:   `;
712:   if (payment.length === 0) {
713:     logDebug(`No local payment for refunded charge ${charge.id}`);
714:     return;
715:   }
716:   if (payment[0].status !== "SUCCEEDED" || !isFullyRefunded) {
717:     logDebug(
718:       `Charge ${charge.id}: status ${payment[0].status}, fully refunded ${isFullyRefunded} — skipping`
719:     );
720:     return;
721:   }
722:   await prismaClient.$executeRaw`
723:     UPDATE "Payment"
724:     SET
725:       status = 'REFUNDED',
726:       raw = raw || ${JSON.stringify({ refundedAt: new Date().toISOString(), refundedBy: "stripe_dashboard" })}::jsonb,
727:       "updatedAt" = NOW()
728:     WHERE id = ${payment[0].id}
729:   `;
730:   logDebug(`Payment ${payment[0].id} marked REFUNDED (charge.refunded)`);
731: }
732: /**
733:  * Map Stripe subscription status to our enum
734:  */
735: function mapStripeStatus(stripeStatus: Stripe.Subscription.Status): string {
736:   switch (stripeStatus) {
737:     case "active":
738:     case "trialing":
739:       return SUBSCRIPTION_STATUS.ACTIVE;
740:     case "past_due":
741:       return SUBSCRIPTION_STATUS.PAST_DUE;
742:     case "canceled":
743:     case "unpaid":
744:       return SUBSCRIPTION_STATUS.CANCELED;
745:     case "incomplete":
746:     case "incomplete_expired":
747:       return SUBSCRIPTION_STATUS.EXPIRED;
748:     default:
749:       return SUBSCRIPTION_STATUS.EXPIRED;
750:   }
751: }
752: type SubscriptionPeriodBounds = {
753:   currentPeriodStart: number | null;
754:   currentPeriodEnd: number | null;
755: };
756: /**
757:  * Extract Stripe customer ID from a subscription, tolerating both the
758:  * string form and the expanded customer object.
759:  */
760: function getCustomerIdFromSubscription(
761:   subscription: Stripe.Subscription
762: ): string | null {
763:   return typeof subscription.customer === "string"
764:     ? subscription.customer
765:     : (subscription.customer?.id ?? null);
766: }
767: function toTimestampSql(seconds: number | null | undefined): Prisma.Sql {
768:   return seconds != null
769:     ? Prisma.sql`to_timestamp(${seconds})`
770:     : Prisma.sql`NULL`;
771: }
772: function getSubscriptionPeriodBounds(
773:   subscription: Stripe.Subscription
774: ): SubscriptionPeriodBounds {  const items = subscription.items?.data ?? [];
775:   const referenceItem = items.reduce<Stripe.SubscriptionItem | undefined>(
776:     (latest, item) => {
777:       if (!latest) {
778:         return item;
779:       }
780:       return item.current_period_end > latest.current_period_end
781:         ? item
782:         : latest;
783:     },
784:     undefined
785:   );
786:   if (!referenceItem) {
787:     return {
788:       currentPeriodStart: null,
789:       currentPeriodEnd: null,
790:     };
791:   }
792:   return {
793:     currentPeriodStart: referenceItem.current_period_start ?? null,
794:     currentPeriodEnd: referenceItem.current_period_end ?? null,
795:   };
796: }
797: function getSubscriptionFromInvoice(
798:   invoice: Stripe.Invoice
799: ): string | Stripe.Subscription | null {
800:   const subscriptionDetails = invoice.parent?.subscription_details;
801:   if (subscriptionDetails?.subscription) {
802:     return subscriptionDetails.subscription;
803:   }
804:   const parentSubscription =
805:     (invoice.parent as { subscription?: string | Stripe.Subscription } | null)
806:       ?.subscription ?? null;
807:   if (parentSubscription) {
808:     return parentSubscription;
809:   }
810:   return ((invoice as unknown as { subscription?: string | null })
811:     .subscription ?? null);
812: }
813: export const webhookController = {
814:   handleStripeWebhook,
815: };
</file>

