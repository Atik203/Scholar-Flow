 1: export interface EditorSettings {
 2:   autosaveIntervalMs: number;
 3:   fontSize: number;
 4:   spellCheck: boolean;
 5: }
 6: export const DEFAULT_EDITOR_SETTINGS: EditorSettings = {
 7:   autosaveIntervalMs: 2000,
 8:   fontSize: 16,
 9:   spellCheck: true,
10: };
11: export const EDITOR_SETTINGS_STORAGE_KEY = "scholarflow:editor-settings";
12: export const EDITOR_SETTINGS_EVENT = "scholarflow:editor-settings-changed";
13: export function readEditorSettings(): EditorSettings {
14:   if (typeof window === "undefined") return DEFAULT_EDITOR_SETTINGS;
15:   try {
16:     const raw = window.localStorage.getItem(EDITOR_SETTINGS_STORAGE_KEY);
17:     if (!raw) return DEFAULT_EDITOR_SETTINGS;
18:     const parsed = JSON.parse(raw) as Partial<EditorSettings>;
19:     return {
20:       autosaveIntervalMs:
21:         typeof parsed.autosaveIntervalMs === "number"
22:           ? parsed.autosaveIntervalMs
23:           : DEFAULT_EDITOR_SETTINGS.autosaveIntervalMs,
24:       fontSize:
25:         typeof parsed.fontSize === "number"
26:           ? parsed.fontSize
27:           : DEFAULT_EDITOR_SETTINGS.fontSize,
28:       spellCheck:
29:         typeof parsed.spellCheck === "boolean"
30:           ? parsed.spellCheck
31:           : DEFAULT_EDITOR_SETTINGS.spellCheck,
32:     };
33:   } catch {
34:     return DEFAULT_EDITOR_SETTINGS;
35:   }
36: }
37: export function writeEditorSettings(settings: EditorSettings): void {
38:   if (typeof window === "undefined") return;
39:   window.localStorage.setItem(
40:     EDITOR_SETTINGS_STORAGE_KEY,
41:     JSON.stringify(settings)
42:   );
43:   window.dispatchEvent(
44:     new CustomEvent<EditorSettings>(EDITOR_SETTINGS_EVENT, {
45:       detail: settings,
46:     })
47:   );
48: }
</file>

