            >
              <div className="h-6 w-6 rounded bg-blue-500/20 flex items-center justify-center">
                <Users className="h-3 w-3 text-blue-500" />
              </div>
              Team Research Lab
            </button>
            <div className="border-t border-gray-200 dark:border-gray-700 my-2" />
