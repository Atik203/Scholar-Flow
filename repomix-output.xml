 11:   static async createNote(userId: string, data: CreateNoteInput) {
 12:     const noteId = randomUUID();
 13:     const now = new Date();
 14:     try {
 15:       await prisma.$executeRaw`
 16:         INSERT INTO "ResearchNote" (
 17:           id, "userId", "paperId", title, content, tags, "isPrivate",
 18:           "createdAt", "updatedAt", "isDeleted"
 19:         )
 20:         VALUES (
 21:           ${noteId}, ${userId}, ${data.paperId || null}, ${data.title},
 22:           ${data.content}, ${data.tags || []}::text[], ${data.isPrivate ?? true},
 23:           ${now}, ${now}, false
 24:         )
 25:       `;
 26:       // Fetch created note with relations using $queryRaw
 27:       const notes = await prisma.$queryRaw<any[]>`
 28:         SELECT
 29:           rn.id, rn."userId", rn."paperId", rn.title, rn.content, rn.tags,
 30:           rn."isPrivate", rn."createdAt", rn."updatedAt",
 31:           json_build_object(
 32:             'id', u.id,
 33:             'name', u.name,
 34:             'email', u.email,
 35:             'image', u.image
 36:           ) as user,
 37:           CASE WHEN rn."paperId" IS NOT NULL THEN
 38:             json_build_object(
 39:               'id', p.id,
 40:               'title', p.title
 41:             )
 42:           ELSE NULL END as paper
 43:         FROM "ResearchNote" rn
 44:         LEFT JOIN "User" u ON rn."userId" = u.id
 45:         LEFT JOIN "Paper" p ON rn."paperId" = p.id
 46:         WHERE rn.id = ${noteId}
 47:         LIMIT 1
 48:       `;
 49:       if (notes.length === 0) {
 50:         throw new ApiError(500, "Failed to create note");
 51:       }
 52:       return notes[0];
 53:     } catch (error) {
 54:       console.error("Error creating note:", error);
 55:       throw new ApiError(500, "Failed to create note");
 56:     }
 57:   }
