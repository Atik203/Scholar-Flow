203:   const [importComplete, setImportComplete] = useState(false);
204:   const [importResults, setImportResults] = useState<{
205:     success: number;
206:     failed: number;
207:     duplicates: number;
208:   } | null>(null);
209:   const [selectedWorkspaceId, setSelectedWorkspaceId] = useState<string>("");
210:   const [importOptions, setImportOptions] = useState<ImportOptions>({
211:     downloadPdfs: true,
212:     extractMetadata: true,
213:     addToCollection: false,
214:     skipDuplicates: true,
215:   });
216:   const fileInputRef = useRef<HTMLInputElement>(null);
217:   const [uploadPaper] = useUploadPaperMutation();
218:   const { data: workspacesData } = useListWorkspacesQuery({
219:     page: 1,
220:     limit: 50,
221:     scope: "all",
222:   });
223:   useEffect(() => {
224:     const workspaces = workspacesData?.data || [];
225:     if (workspaces.length === 1 && !selectedWorkspaceId) {
226:       setSelectedWorkspaceId(workspaces[0].id);
227:     }
228:   }, [workspacesData, selectedWorkspaceId]);
229:   const scopedPath = useCallback(
230:     (segment: string) => buildRoleScopedPath(user?.role, segment),
231:     [user?.role]
232:   );
233:   if (!isAuthenticated) return null;
234:   const handleFileRead = (file: globalThis.File) => {
235:     const reader = new FileReader();
236:     reader.onload = (e) => {
237:       const content = e.target?.result as string;
238:       let papers: ImportedPaper[] = [];
239:       if (file.name.endsWith(".bib") || file.name.endsWith(".bibtex")) {
240:         papers = parseBibTeX(content);
241:       } else if (file.name.endsWith(".ris")) {
242:         papers = parseRIS(content);
243:       }
244:       if (papers.length > 0) {
245:         setPreviewPapers(papers);
246:         setShowPreview(true);
247:       }
248:     };
249:     reader.readAsText(file);
250:   };
