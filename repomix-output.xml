248:               <Badge key={index} variant="outline" className="text-xs">
249:                 {tag}
250:               </Badge>
251:             ))}
252:           </div>
253:         )}
254:       </CardHeader>
255:       <CardContent className="pt-0">
256:         <div className="flex items-center justify-between text-sm text-muted-foreground">
257:           <div className="flex items-center gap-4">
