1464:         uploaderId: row.paper_uploaderId,
1465:         title: row.paper_title,
1466:         abstract: row.paper_abstract,
1467:         metadata: row.paper_metadata,
1468:         source: row.paper_source,
1469:         doi: row.paper_doi,
1470:         processingStatus: row.paper_processingStatus,
1471:         createdAt: row.paper_createdAt,
1472:         updatedAt: row.paper_updatedAt,
1473:         file: row.file_id
1474:           ? {
