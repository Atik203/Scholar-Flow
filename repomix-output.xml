473:         const authors = this.formatAuthorsAPA(citation.authors);
474:         const year = citation.year || "n.d.";
475:         const title = citation.title;
476:         let apa = `${authors} (${year}). ${title}.`;
477:         if (citation.journal) {
478:           apa += ` ${citation.journal}`;
479:           if (citation.volume) {
