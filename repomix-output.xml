 513:   async updateMetadata(id: string, data: UpdatePaperMetadataInput) {
 514:     // First get existing paper
 515:     const existing = await prisma.$queryRaw<any[]>`
 516:       SELECT metadata, title, abstract
 517:       FROM "Paper"
 518:       WHERE id = ${id} AND "isDeleted" = false
 519:       LIMIT 1
 520:     `;
 521:     if (!existing.length) return null;
 522:     const existingMeta = existing[0].metadata || {};
 523:     const mergedMeta = {
 524:       ...existingMeta,
 525:       authors:
 526:         data.authors !== undefined ? data.authors : existingMeta.authors || [],
 527:       year: data.year !== undefined ? data.year : existingMeta.year,
 528:     };
 529:     // Update with merged metadata and new phase 4 fields
 530:     await prisma.$executeRaw`
 531:       UPDATE "Paper"
 532:       SET title = ${data.title ?? existing[0].title},
 533:           abstract = ${data.abstract ?? existing[0].abstract},
 534:           metadata = ${JSON.stringify(mergedMeta)}::jsonb,
 535:           tags = ${data.tags ?? existing[0].tags ?? []}::text[],
 536:           language = ${data.language ?? existing[0].language ?? null},
 537:           "citationCount" = ${data.citationCount ?? existing[0].citationCount ?? 0},
 538:           "updatedAt" = NOW()
 539:       WHERE id = ${id}
 540:     `;
 541:     // Return updated paper
 542:     return this.getById(id);
