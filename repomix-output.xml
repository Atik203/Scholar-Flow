320:   private static parseAuthors(authors: any): string[] {
321:     if (typeof authors === "string") {
322:       return authors
323:         .split(/[,;]/)
324:         .map((a) => a.trim())
325:         .filter((a) => a);
326:     }
327:     if (Array.isArray(authors)) {
328:       return authors
329:         .map((a) => (typeof a === "string" ? a : a.name || a))
330:         .filter((a) => a);
331:     }
332:     return ["Unknown Author"];
333:   }
334:   private static formatCitations(
335:     citations: CitationData[],
336:     format: string
337:   ): string {
338:     switch (format) {
339:       case "BIBTEX":
340:         return this.formatBibTeX(citations);
341:       case "ENDNOTE":
342:         return this.formatEndNote(citations);
343:       case "APA":
344:         return this.formatAPA(citations);
345:       case "MLA":
346:         return this.formatMLA(citations);
347:       case "IEEE":
348:         return this.formatIEEE(citations);
349:       case "CHICAGO":
350:         return this.formatChicago(citations);
351:       case "HARVARD":
