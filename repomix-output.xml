 91: export function DiscussionThreadCard({
 92:   thread,
 93:   currentUserId,
 94:   onThreadUpdate,
 95:   onThreadDelete,
 96:   onReply
 97: }: DiscussionThreadCardProps) {
 98:   const [isUpdating, setIsUpdating] = useState(false);
 99:   const getUserDisplayName = (user: DiscussionThread['author']) => {
100:     if (user.firstName && user.lastName) {
101:       return `${user.firstName} ${user.lastName}`;
102:     }
103:     return user.name || 'Unknown User';
104:   };
105:   const getUserInitials = (user: DiscussionThread['author']) => {
106:     if (user.firstName && user.lastName) {
107:       return `${user.firstName[0]}${user.lastName[0]}`.toUpperCase();
108:     }
109:     if (user.name) {
110:       return user.name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
111:     }
112:     return 'U';
113:   };
114:   const handleToggleResolved = async () => {
115:     setIsUpdating(true);
116:     try {
117:       const response = await fetch(`/api/discussions/${thread.id}`, {
118:         method: 'PUT',
119:         headers: {
120:           'Content-Type': 'application/json',
121:         },
122:         body: JSON.stringify({
123:           isResolved: !thread.isResolved
124:         }),
125:       });
126:       if (!response.ok) {
127:         throw new Error('Failed to update discussion');
128:       }
129:       showSuccessToast(
130:         thread.isResolved ? 'Discussion marked as unresolved' : 'Discussion marked as resolved'
131:       );
132:       onThreadUpdate?.();
133:     } catch (error) {
134:       console.error('Update discussion error:', error);
135:       showErrorToast('Failed to update discussion. Please try again.');
136:     } finally {
137:       setIsUpdating(false);
138:     }
139:   };
140:   const handleTogglePinned = async () => {
141:     setIsUpdating(true);
142:     try {
143:       const response = await fetch(`/api/discussions/${thread.id}`, {
144:         method: 'PUT',
145:         headers: {
146:           'Content-Type': 'application/json',
147:         },
148:         body: JSON.stringify({
149:           isPinned: !thread.isPinned
150:         }),
151:       });
152:       if (!response.ok) {
153:         throw new Error('Failed to update discussion');
154:       }
155:       showSuccessToast(
156:         thread.isPinned ? 'Discussion unpinned' : 'Discussion pinned'
157:       );
158:       onThreadUpdate?.();
159:     } catch (error) {
160:       console.error('Update discussion error:', error);
161:       showErrorToast('Failed to update discussion. Please try again.');
162:     } finally {
163:       setIsUpdating(false);
164:     }
165:   };
166:   const handleDelete = async () => {
167:     if (!confirm('Are you sure you want to delete this discussion? This action cannot be undone.')) {
168:       return;
169:     }
170:     setIsUpdating(true);
171:     try {
172:       const response = await fetch(`/api/discussions/${thread.id}`, {
173:         method: 'DELETE',
174:       });
175:       if (!response.ok) {
176:         throw new Error('Failed to delete discussion');
177:       }
178:       showSuccessToast('Discussion deleted successfully');
179:       onThreadDelete?.();
180:     } catch (error) {
181:       console.error('Delete discussion error:', error);
182:       showErrorToast('Failed to delete discussion. Please try again.');
183:     } finally {
184:       setIsUpdating(false);
185:     }
186:   };
187:   const isOwner = currentUserId === thread.author.id;
188:   return (
189:     <Card className={`transition-all hover:shadow-md ${thread.isPinned ? 'border-primary' : ''}`}>
190:       <CardHeader className="pb-3">
191:         <div className="flex items-start justify-between">
192:           <div className="flex-1 min-w-0">
193:             <div className="flex items-center gap-2 mb-2">
194:               {thread.isPinned && (
195:                 <Pin className="h-4 w-4 text-primary" />
196:               )}
197:               <CardTitle className="text-lg leading-tight">
198:                 {thread.title}
199:               </CardTitle>
200:               {thread.isResolved && (
201:                 <Badge variant="secondary" className="ml-2">
202:                   <CheckCircle className="h-3 w-3 mr-1" />
203:                   Resolved
204:                 </Badge>
205:               )}
206:             </div>
207:             <CardDescription className="line-clamp-2">
208:               {thread.content}
209:             </CardDescription>
210:           </div>
211:           {isOwner && (
212:             <DropdownMenu>
213:               <DropdownMenuTrigger asChild>
214:                 <Button variant="ghost" size="sm" className="h-8 w-8 p-0">
215:                   <MoreVertical className="h-4 w-4" />
216:                 </Button>
217:               </DropdownMenuTrigger>
218:               <DropdownMenuContent align="end">
