156:     return <Icon className="h-3 w-3" />;
157:   };
158:   const handleExport = async () => {
159:     try {
160:       const params = new URLSearchParams();
161:       if (workspaceId) params.append('workspaceId', workspaceId);
162:       if (entity) params.append('entity', entity);
163:       if (entityId) params.append('entityId', entityId);
164:       if (filters.entity) params.append('entity', filters.entity);
165:       if (filters.action) params.append('action', filters.action);
166:       if (filters.severity) params.append('severity', filters.severity);
167:       if (filters.startDate) params.append('startDate', filters.startDate.toISOString());
168:       if (filters.endDate) params.append('endDate', filters.endDate.toISOString());
169:       params.append('format', 'csv');
170:       const response = await fetch(`/api/activity-log/export?${params.toString()}`);
171:       if (!response.ok) {
172:         throw new Error('Failed to export activity log');
173:       }
174:       const result = await response.json();
175:       const blob = new Blob([result.data.content], { type: 'text/csv' });
176:       const url = URL.createObjectURL(blob);
177:       const link = document.createElement('a');
178:       link.href = url;
179:       link.download = result.data.filename;
180:       document.body.appendChild(link);
181:       link.click();
182:       document.body.removeChild(link);
183:       URL.revokeObjectURL(url);
184:     } catch (error) {
185:       console.error('Export error:', error);
186:       showErrorToast('Failed to export activity log');
187:     }
188:   };
189:   if (loading) {
