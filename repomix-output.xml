216:             {annotations.length}
217:           </span>
218:         </div>
219:         {hasActiveFilters && (
220:           <Button
221:             variant="ghost"
222:             size="sm"
223:             className="h-6 w-6 p-0"
224:             onClick={clearFilters}
225:           >
226:             <X className="h-3.5 w-3.5" />
227:           </Button>
228:         )}
229:       </div>
230:       {}
231:       <div className="px-3 pt-3 pb-1.5 shrink-0">
232:         <div className="relative">
233:           <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-muted-foreground pointer-events-none" />
234:           <Input
