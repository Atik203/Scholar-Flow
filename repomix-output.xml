253:   ) {
254:     // Only Admin/TeamLead/Owner can add
255:     const perm = await prisma.$queryRaw<any[]>`
256:       SELECT m.role, w."ownerId"
257:       FROM "WorkspaceMember" m JOIN "Workspace" w ON w.id = m."workspaceId"
258:       WHERE m."userId" = ${requestorId} AND m."workspaceId" = ${id} AND m."isDeleted" = false AND w."isDeleted" = false
259:     `;
260:     const member = perm[0];
261:     if (!member) throw new ApiError(403, "Not a member of this workspace");
262:     const isManager =
263:       ["OWNER", "MANAGER"].includes(member.role) ||
264:       member.ownerId === requestorId;
265:     if (!isManager) throw new ApiError(403, "Insufficient permissions");
266:     let targetUserId = payload.userId as string | undefined;
