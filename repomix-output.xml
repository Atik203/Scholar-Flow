102:     githubAuthUrl.searchParams.append("client_id", githubClientId);
103:     githubAuthUrl.searchParams.append("redirect_uri", redirectUri);
104:     githubAuthUrl.searchParams.append("scope", "read:user user:email");
105:     githubAuthUrl.searchParams.append("state", state);
