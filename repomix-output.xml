 15:   if (!role) return DEFAULT_ROLE_SLUG;
 16:   return ROLE_SLUGS[role as keyof typeof ROLE_SLUGS] ?? DEFAULT_ROLE_SLUG;
 17: };
 18: export const getRoleDashboardBasePath = (role?: string) =>
 19:   `/dashboard/${getRoleSlug(role)}`;
 20: export const buildRoleScopedPath = (role: string | undefined, segment = "") => {
 21:   const basePath = getRoleDashboardBasePath(role);
 22:   if (!segment) return basePath;
 23:   return segment.startsWith("/")
 24:     ? `${basePath}${segment}`
 25:     : `${basePath}/${segment}`;
 26: };
 27: export const resolveRoleScopedHref = (
 28:   role: string | undefined,
 29:   href: string
 30: ) => {
 31:   const [pathPart, search = ""] = href.split("?");
 32:   const stripped = pathPart.startsWith("/dashboard")
 33:     ? pathPart.slice("/dashboard".length)
 34:     : pathPart;
 35:   const segment = stripped.startsWith("/")
 36:     ? stripped
 37:     : stripped
 38:       ? `/${stripped}`
 39:       : "";
 40:   const resolved = buildRoleScopedPath(role, segment);
 41:   return search ? `${resolved}?${search}` : resolved;
 42: };
