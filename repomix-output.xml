103:     : typeof value === "number"
104:       ? value.toLocaleString()
105:       : value;
106:   const displayChange =
107:     change !== undefined
108:       ? changeType === "percentage"
109:         ? `${change > 0 ? "+" : ""}${change}%`
110:         : `${change > 0 ? "+" : ""}${change}`
111:       : null;
112:   if (loading) {
113:     return (
