 1: import { Request, Response } from "express";
 2: import ApiError from "../../errors/ApiError";
 3: import { AuthenticatedRequest } from "../../interfaces/common";
 4: import catchAsync from "../../shared/catchAsync";
 5: import { sendPaginatedResponse, sendSuccessResponse } from "../../shared/sendResponse";
 6: import NotificationService from "./notification.service";
 7: import { listQuerySchema, notificationIdSchema } from "./notification.validation";
 8: export const NotificationController = {
 9:   list: catchAsync(async (req: Request, res: Response) => {
10:     const authReq = req as AuthenticatedRequest;
11:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
12:     const q = listQuerySchema.parse(req.query);
13:     const page = parseInt((q.page as string) || "1", 10);
14:     const limit = Math.min(50, parseInt((q.limit as string) || "20", 10));
15:     const skip = (page - 1) * limit;
16:     const queryParams = {
17:       type: q.type as string | undefined,
18:       read: q.read as string | undefined,
19:       starred: q.starred as string | undefined,
20:     };
21:     const result = await NotificationService.listNotifications(
22:       authReq.user.id,
23:       limit,
24:       skip,
25:       queryParams
26:     );
27:     sendPaginatedResponse(
28:       res,
29:       result.result,
30:       {
31:         ...result.meta,
32:         page,
33:         limit,
34:         totalPage: Math.ceil(result.meta.total / limit)
35:       },
36:       "Notifications retrieved successfully"
37:     );
38:   }),
39:   getUnreadCount: catchAsync(async (req: Request, res: Response) => {
40:     const authReq = req as AuthenticatedRequest;
41:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
42:     const result = await NotificationService.getUnreadCount(authReq.user.id);
43:     sendSuccessResponse(res, result, "Unread count retrieved");
44:   }),
45:   markAsRead: catchAsync(async (req: Request, res: Response) => {
46:     const authReq = req as AuthenticatedRequest;
47:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
48:     const { id } = notificationIdSchema.parse(req.params);
49:     const result = await NotificationService.markAsRead(authReq.user.id, id);
50:     sendSuccessResponse(res, result, "Notification marked as read");
51:   }),
52:   toggleStarred: catchAsync(async (req: Request, res: Response) => {
53:     const authReq = req as AuthenticatedRequest;
54:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
55:     const { id } = notificationIdSchema.parse(req.params);
56:     const result = await NotificationService.toggleStarred(authReq.user.id, id);
57:     sendSuccessResponse(res, result, "Notification star toggled");
