65:   delete: catchAsync(async (req: Request, res: Response) => {
66:     const authReq = req as AuthenticatedRequest;
67:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
68:     const { id } = notificationIdSchema.parse(req.params);
