657:             WHERE "userId" = ${user.id}
658:           `;
659:         }
660:         if (payload.timezone !== undefined) {
661:           await prisma.$executeRaw`
662:             UPDATE "UserPreference"
663:             SET timezone = ${payload.timezone}, "updatedAt" = NOW()
664:             WHERE "userId" = ${user.id}
665:           `;
666:         }
667:         if (payload.emailDigest !== undefined) {
668:           await prisma.$executeRaw`
669:             UPDATE "UserPreference"
670:             SET "emailDigest" = ${payload.emailDigest}, "updatedAt" = NOW()
