 846:       external = [];
 847:     }
 848:     if (external.length === 0) {
 849:       try {
 850:         external = await fetchArxivFeed(null, 0, externalCount);
 851:       } catch {
 852:         external = [];
 853:       }
 854:     }
 855:     const platform = (
 856:       await prisma.paper.findMany({
 857:         where: {
