<file path="apps/backend/src/app/modules/Analytics/usage.service.ts">
 1: import prisma from "../../shared/prisma";
 2: type TimeRange = "week" | "month" | "quarter" | "year";
 3: const rangeToDays: Record<TimeRange, number> = {
 4:   week: 7,
 5:   month: 30,
 6:   quarter: 90,
 7:   year: 365,
 8: };
 9: export const usageReportsService = {
10:   async getReport(userId: string, timeRange: TimeRange = "month") {
11:     const days = rangeToDays[timeRange];
12:     const since = new Date(Date.now() - days * 24 * 60 * 60 * 1000);
13:     const events = await prisma.usageEvent.findMany({
14:       where: { userId, createdAt: { gte: since }, isDeleted: false },
15:       select: { kind: true, units: true, createdAt: true },
16:     });
17:     const byKind = new Map<string, { count: number; units: number }>();
18:     for (const e of events) {
19:       const entry = byKind.get(e.kind) ?? { count: 0, units: 0 };
20:       entry.count += 1;
21:       entry.units += e.units;
22:       byKind.set(e.kind, entry);
23:     }
24:     const totalApiCalls = events.length;
25:     const aiCreditsUsed = byKind.get("ai_summarize")?.units ?? 0;
26:     const dayKey = (d: Date) => d.toISOString().split("T")[0];
27:     const perDay = new Map<string, { apiCalls: number; papers: number; aiCredits: number }>();
28:     for (const e of events) {
29:       const k = dayKey(e.createdAt);
30:       const cur = perDay.get(k) ?? { apiCalls: 0, papers: 0, aiCredits: 0 };
31:       cur.apiCalls += 1;
32:       if (e.kind === "paper_view" || e.kind === "paper_upload") cur.papers += 1;
33:       if (e.kind === "ai_summarize") cur.aiCredits += e.units;
34:       perDay.set(k, cur);
35:     }
36:     const dailyUsage = Array.from(perDay.entries())
37:       .sort(([a], [b]) => a.localeCompare(b))
38:       .map(([date, v]) => ({ date, ...v }));
39:     const featureUsage = Array.from(byKind.entries())
40:       .map(([feature, v]) => ({
41:         feature,
42:         count: v.count,
43:         percentage: 0,
44:         trend: 0,
45:       }))
46:       .sort((a, b) => b.count - a.count);
47:     const totalCount = featureUsage.reduce((s, f) => s + f.count, 0) || 1;
48:     for (const f of featureUsage) {
49:       f.percentage = Math.round((f.count / totalCount) * 100);
50:     }
51:     return {
52:       timeRange,
53:       overview: {
54:         totalApiCalls,
55:         apiCallsChange: 0,
56:         storageUsed: 0,
57:         storageLimit: 10,
58:         storageChange: 0,
59:         papersProcessed: byKind.get("paper_upload")?.count ?? 0,
60:         papersChange: 0,
61:         aiCreditsUsed,
62:         aiCreditsLimit: 1000,
63:         aiCreditsChange: 0,
64:       },
65:       dailyUsage,
66:       featureUsage,
67:     };
68:   },
69:   async exportReport(userId: string, format: "csv" | "json" = "csv") {
70:     const report = await this.getReport(userId, "month");
71:     if (format === "json") {
72:       return {
73:         mimeType: "application/json",
74:         filename: `usage-report-${new Date().toISOString().split("T")[0]}.json`,
75:         content: JSON.stringify(report, null, 2),
76:       };
77:     }
78:     const headers = [
79:       "date",
80:       "apiCalls",
81:       "papers",
82:       "aiCredits",
83:     ];
84:     const lines: string[] = [headers.join(",")];
85:     for (const d of report.dailyUsage) {
86:       lines.push(`${d.date},${d.apiCalls},${d.papers},${d.aiCredits}`);
87:     }
88:     return {
89:       mimeType: "text/csv",
90:       filename: `usage-report-${new Date().toISOString().split("T")[0]}.csv`,
91:       content: lines.join("\n"),
92:     };
93:   },
94: };
</file>

<file path="apps/backend/src/app/modules/Analytics/workspace.service.ts">
 1: import prisma from "../../shared/prisma";
 2: import ApiError from "../../errors/ApiError";
 3: type TimeRange = "week" | "month" | "quarter" | "year";
 4: const rangeToDays: Record<TimeRange, number> = {
 5:   week: 7,
 6:   month: 30,
 7:   quarter: 90,
 8:   year: 365,
 9: };
10: export const workspaceAnalyticsService = {
11:   async getSummary(workspaceId: string, timeRange: TimeRange = "month") {
12:     const days = rangeToDays[timeRange];
13:     const since = new Date(Date.now() - days * 24 * 60 * 60 * 1000);
14:     const workspace = await prisma.workspace.findFirst({
15:       where: { id: workspaceId, isDeleted: false },
16:       include: { _count: { select: { members: true, papers: true, collections: true } } },
17:     });
18:     if (!workspace) throw new ApiError(404, "Workspace not found");
19:     const [papers, collections, memberActivity, paperViews, annotations] =
20:       await Promise.all([
21:         prisma.paper.findMany({
22:           where: { workspaceId, isDeleted: false },
23:           select: { id: true, title: true, uploaderId: true, createdAt: true },
24:         }),
25:         prisma.collection.findMany({
26:           where: { workspaceId, isDeleted: false },
27:           select: { id: true, name: true, ownerId: true },
28:         }),
29:         prisma.workspaceMember.findMany({
30:           where: { workspaceId, isDeleted: false },
31:           include: {
32:             user: { select: { id: true, name: true, email: true, image: true } },
33:           },
34:         }),
35:         prisma.usageEvent.findMany({
36:           where: {
37:             workspaceId,
38:             kind: "paper_view",
39:             createdAt: { gte: since },
40:             isDeleted: false,
41:           },
42:           select: { userId: true, paperId: true },
43:         }),
44:         prisma.annotation.count({
45:           where: {
46:             paper: { workspaceId },
47:             isDeleted: false,
48:             createdAt: { gte: since },
49:           },
50:         }),
51:       ]);
52:     const score = new Map<string, number>();
53:     for (const v of paperViews) {
54:       if (!v.userId) continue;
55:       score.set(v.userId, (score.get(v.userId) ?? 0) + 1);
56:     }
57:     const memberStats = memberActivity
58:       .map((m) => ({
59:         userId: m.userId,
60:         name: m.user.name,
61:         email: m.user.email,
62:         image: m.user.image,
63:         role: m.role,
64:         joinedAt: m.joinedAt,
65:         activityScore: score.get(m.userId) ?? 0,
66:       }))
67:       .sort((a, b) => b.activityScore - a.activityScore);
68:     return {
69:       workspace: {
70:         id: workspace.id,
71:         name: workspace.name,
72:         description: workspace.description,
73:         memberCount: workspace._count.members,
74:         paperCount: workspace._count.papers,
75:         collectionCount: workspace._count.collections,
76:         createdAt: workspace.createdAt,
77:       },
78:       timeRange,
79:       stats: {
80:         totalPapers: papers.length,
81:         totalCollections: collections.length,
82:         totalMembers: memberActivity.length,
83:         totalViews: paperViews.length,
84:         totalAnnotations: annotations,
85:         activeMembers: memberStats.filter((m) => m.activityScore > 0).length,
86:       },
87:       topMembers: memberStats.slice(0, 5),
88:       topPapers: papers.slice(0, 5).map((p) => ({
89:         id: p.id,
90:         title: p.title,
91:         uploaderId: p.uploaderId,
92:         createdAt: p.createdAt,
93:       })),
94:     };
95:   },
96: };
