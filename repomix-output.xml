 773: // Phase 10 — Admin-managed AI provider catalog.
 774: // Lets admins enable / disable individual models, set the default for
 775: // the floating AI assistant, and reorder display via displayOrder.
 776: // Add-only migration; no destructive changes to existing tables.
 777: model AIProvider {
 778:   id            String   @id @default(uuid())
 779:   // Logical provider key: openai | anthropic | google | deepseek | minimax
 780:   provider      String
 781:   // Model identifier passed to the SDK (e.g. "gpt-4o-mini", "claude-3-5-sonnet-latest")
 782:   model         String
 783:   // Human-readable label shown in UI dropdowns (e.g. "GPT-4o Mini (OpenAI - Fast)")
 784:   displayName   String
 785:   enabled       Boolean  @default(true)
 786:   isDefault     Boolean  @default(false)
 787:   description   String?
 788:   // Env-var name to look up the API key (e.g. "OPENAI_API_KEY").
 789:   // Optional so a provider can be configured without a key (e.g. for catalog-only display).
 790:   apiKeyEnvName String?
 791:   // Cost per 1K tokens (in USD cents) for cost tracking in analytics.
 792:   inputCostPer1k  Float?
 793:   outputCostPer1k Float?
 794:   // Lower values appear first in admin lists and user dropdowns.
 795:   displayOrder  Int      @default(0)
 796: 
 797:   createdAt     DateTime @default(now())
 798:   updatedAt     DateTime @updatedAt
 799:   isDeleted     Boolean  @default(false)
 800: 
 801:   @@unique([provider, model])
 802:   @@index([enabled, displayOrder])
 803:   @@index([isDefault])
 804: }
