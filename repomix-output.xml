809:         .replace(/on\w+="[^"]*"/gi, "") // Remove event handlers
810:         .replace(/javascript:/gi, "") // Remove javascript: protocol
811:         .replace(/data:/gi, "") // Remove data: protocol for security
812:         .replace(/<iframe\b[^>]*>/gi, "") // Remove iframes
813:         .replace(/<embed\b[^>]*>/gi, "") // Remove embeds
814:         .replace(/<object\b[^>]*>.*?<\/object>/gi, ""); // Remove objects
815:       // Limit the size to prevent abuse (100KB limit)
