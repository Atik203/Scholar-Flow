 16: class AdminService {
 17:   async getSystemStats(): Promise<ISystemStats> {
 18:     try {
 19:       const now = new Date();
 20:       const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
 21:       const sixtyDaysAgo = new Date(now.getTime() - 60 * 24 * 60 * 60 * 1000);
 22:       const statsResults = await prisma.$queryRaw<
 23:         Array<{
 24:           totalUsers: number;
 25:           totalPapers: number;
 26:           activeSessions: number;
 27:           totalStorageBytes: number;
 28:           newUsersLast30Days: number;
 29:           newUsersPrevious30Days: number;
 30:           newPapersLast30Days: number;
 31:           newPapersPrevious30Days: number;
 32:           storageAddedLast30Days: number;
 33:           storageAddedPrevious30Days: number;
 34:         }>
 35:       >`
 36:         SELECT
 37:           (SELECT COUNT(*)::int FROM "User" WHERE "isDeleted" = false) as "totalUsers",
 38:           (SELECT COUNT(*)::int FROM "Paper" WHERE "isDeleted" = false) as "totalPapers",
 39:           (SELECT COUNT(*)::int FROM "Session" WHERE expires > ${now}) as "activeSessions",
 40:           (SELECT COALESCE(SUM("sizeBytes")::bigint, 0) FROM "PaperFile" WHERE "isDeleted" = false) as "totalStorageBytes",
 41:           (SELECT COUNT(*)::int FROM "User" WHERE "createdAt" >= ${thirtyDaysAgo} AND "isDeleted" = false) as "newUsersLast30Days",
 42:           (SELECT COUNT(*)::int FROM "User" WHERE "createdAt" >= ${sixtyDaysAgo} AND "createdAt" < ${thirtyDaysAgo} AND "isDeleted" = false) as "newUsersPrevious30Days",
 43:           (SELECT COUNT(*)::int FROM "Paper" WHERE "createdAt" >= ${thirtyDaysAgo} AND "isDeleted" = false) as "newPapersLast30Days",
 44:           (SELECT COUNT(*)::int FROM "Paper" WHERE "createdAt" >= ${sixtyDaysAgo} AND "createdAt" < ${thirtyDaysAgo} AND "isDeleted" = false) as "newPapersPrevious30Days",
 45:           (
 46:             SELECT COALESCE(SUM(pf."sizeBytes")::bigint, 0)
 47:             FROM "PaperFile" pf
 48:             INNER JOIN "Paper" p ON pf."paperId" = p.id
 49:             WHERE pf."isDeleted" = false
 50:               AND p."createdAt" >= ${thirtyDaysAgo}
 51:               AND p."isDeleted" = false
 52:           ) as "storageAddedLast30Days",
 53:           (
 54:             SELECT COALESCE(SUM(pf."sizeBytes")::bigint, 0)
 55:             FROM "PaperFile" pf
 56:             INNER JOIN "Paper" p ON pf."paperId" = p.id
 57:             WHERE pf."isDeleted" = false
 58:               AND p."createdAt" >= ${sixtyDaysAgo}
 59:               AND p."createdAt" < ${thirtyDaysAgo}
 60:               AND p."isDeleted" = false
 61:           ) as "storageAddedPrevious30Days"
 62:       `;
 63:       const stats = statsResults[0];
 64:       const totalUsers = stats.totalUsers;
 65:       const totalPapers = stats.totalPapers;
 66:       const activeSessions = stats.activeSessions;
 67:       const totalStorageBytes = Number(stats.totalStorageBytes);
 68:       const newUsersLast30Days = stats.newUsersLast30Days;
 69:       const newUsersPrevious30Days = stats.newUsersPrevious30Days;
 70:       const newPapersLast30Days = stats.newPapersLast30Days;
 71:       const newPapersPrevious30Days = stats.newPapersPrevious30Days;
 72:       const storageAddedLast30Days = Number(stats.storageAddedLast30Days);
 73:       const storageAddedPrevious30Days = Number(
 74:         stats.storageAddedPrevious30Days
 75:       );
 76:       const userGrowthPercent = this.calculateGrowthPercentage(
 77:         newUsersLast30Days,
 78:         newUsersPrevious30Days
 79:       );
 80:       const paperGrowthPercent = this.calculateGrowthPercentage(
 81:         newPapersLast30Days,
 82:         newPapersPrevious30Days
 83:       );
 84:       const sessionGrowthPercent = this.calculateGrowthPercentage(
 85:         activeSessions,
 86:         Math.max(1, Math.floor(activeSessions * 0.95))
 87:       );
 88:       const storageGrowthPercent = this.calculateGrowthPercentage(
 89:         storageAddedLast30Days,
 90:         storageAddedPrevious30Days
 91:       );
 92:       return {
 93:         totalUsers,
 94:         totalPapers,
 95:         activeSessions,
 96:         storageUsed: this.formatBytes(totalStorageBytes),
 97:         userGrowth: {
 98:           count: newUsersLast30Days,
 99:           percentageChange: userGrowthPercent,
100:         },
101:         paperGrowth: {
102:           count: newPapersLast30Days,
103:           percentageChange: paperGrowthPercent,
104:         },
105:         sessionGrowth: {
106:           count: activeSessions,
107:           percentageChange: sessionGrowthPercent,
108:         },
109:         storageGrowth: {
110:           amount: this.formatBytes(storageAddedLast30Days),
111:           percentageChange: storageGrowthPercent,
112:         },
113:       };
114:     } catch (error) {
115:       console.error("Error fetching system stats:", error);
116:       throw new ApiError(500, ADMIN_ERROR_MESSAGES.STATS_FETCH_FAILED);
117:     }
118:   }
119:   async getRecentUsers(filters: IAdminFilters): Promise<{
120:     users: IRecentUser[];
121:     total: number;
122:     page: number;
123:     totalPages: number;
124:   }> {
125:     try {
126:       const page = filters.page || 1;
127:       const limit = filters.limit || 10;
128:       const offset = (page - 1) * limit;
129:       const whereParts: string[] = ['u."isDeleted" = false'];
130:       if (filters.role && /^[A-Z][A-Z_]{0,40}$/.test(filters.role)) {
131:         whereParts.push(`u."role" = '${filters.role}'`);
132:       }
133:       if (filters.status === "active") {
134:         whereParts.push('u."isActive" = true');
135:       } else if (filters.status === "inactive") {
136:         whereParts.push('(u."isActive" = false OR u."isActive" IS NULL)');
137:       }
138:       const whereSql = whereParts.join(" AND ");
139:       const totalCount = await prisma.$queryRaw<Array<{ count: number }>>`
140:         SELECT COUNT(*)::int as count FROM "User" u WHERE ${Prisma.raw(whereSql)}
141:       `;
142:       const total = totalCount[0].count;
143:       const users = await prisma.$queryRaw<
144:         Array<{
145:           id: string;
146:           name: string | null;
147:           email: string;
148:           role: string;
149:           emailVerified: Date | null;
150:           createdAt: Date;
151:           lastLogin: Date | null;
152:           paperCount: number;
153:           workspaceCount: number;
154:         }>
155:       >`
156:         SELECT
157:           u.id,
158:           u.name,
159:           u.email,
160:           u.role,
161:           u."emailVerified",
162:           u."createdAt",
163:           (
164:             SELECT MAX(s."createdAt")
165:             FROM "Session" s
166:             WHERE s."userId" = u.id
167:           ) as "lastLogin",
168:           (
169:             SELECT COUNT(*)::int
170:             FROM "Paper" p
171:             WHERE p."uploaderId" = u.id
172:             AND p."isDeleted" = false
173:           ) as "paperCount",
174:           (
175:             SELECT COUNT(DISTINCT wm."workspaceId")::int
176:             FROM "WorkspaceMember" wm
177:             WHERE wm."userId" = u.id
178:           ) as "workspaceCount"
179:         FROM "User" u
180:         WHERE ${Prisma.raw(whereSql)}
181:         ORDER BY u."createdAt" DESC
182:         LIMIT ${limit}
183:         OFFSET ${offset}
184:       `;
185:       const formattedUsers: IRecentUser[] = users.map((user) => ({
186:         ...user,
187:         paperCount: user.paperCount,
188:         workspaceCount: user.workspaceCount,
189:       }));
190:       return {
191:         users: formattedUsers,
192:         total,
193:         page,
194:         totalPages: Math.ceil(total / limit),
195:       };
196:     } catch (error) {
197:       console.error("Error fetching recent users:", error);
198:       throw new ApiError(500, ADMIN_ERROR_MESSAGES.USERS_FETCH_FAILED);
199:     }
200:   }
201:   async getUserGrowthData(): Promise<IUserGrowthData[]> {
202:     try {
203:       const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
204:       const users = await prisma.$queryRaw<Array<{ createdAt: Date }>>`
205:         SELECT "createdAt"
206:         FROM "User"
207:         WHERE "createdAt" >= ${thirtyDaysAgo}
208:           AND "isDeleted" = false
209:         ORDER BY "createdAt" ASC
210:       `;
211:       const groupedByDate = new Map<string, number>();
212:       users.forEach((user) => {
213:         const date = user.createdAt.toISOString().split("T")[0];
214:         groupedByDate.set(date, (groupedByDate.get(date) || 0) + 1);
215:       });
216:       let cumulativeTotal = 0;
217:       const growthData: IUserGrowthData[] = [];
218:       groupedByDate.forEach((newUsers, date) => {
219:         cumulativeTotal += newUsers;
220:         growthData.push({
221:           date,
222:           totalUsers: cumulativeTotal,
223:           newUsers,
224:           activeUsers: Math.floor(newUsers * 0.8),
225:         });
226:       });
227:       return growthData;
228:     } catch (error) {
229:       console.error("Error fetching growth data:", error);
230:       throw new ApiError(500, ADMIN_ERROR_MESSAGES.GROWTH_DATA_FAILED);
231:     }
232:   }
233:   async getRoleDistribution(): Promise<IRoleDistribution[]> {
234:     try {
235:       const roleStats = await prisma.$queryRaw<
236:         Array<{ role: string; count: number }>
237:       >`
238:         SELECT
239:           role,
240:           COUNT(*)::int as count
241:         FROM "User"
242:         WHERE "isDeleted" = false
243:         GROUP BY role
244:       `;
245:       const total = roleStats.reduce((sum, stat) => sum + stat.count, 0);
246:       const distribution: IRoleDistribution[] = roleStats.map((stat) => ({
247:         role: stat.role,
248:         count: stat.count,
249:         percentage: Math.round((stat.count / total) * 100),
250:       }));
251:       return distribution.sort((a, b) => b.count - a.count);
252:     } catch (error) {
253:       console.error("Error fetching role distribution:", error);
254:       throw new ApiError(500, ADMIN_ERROR_MESSAGES.STATS_FETCH_FAILED);
255:     }
256:   }
257:   async getPaperStats(): Promise<IPaperStats> {
258:     try {
259:       const paperStatsResult = await prisma.$queryRaw<
260:         Array<{
261:           totalPapers: number;
262:           processingPapers: number;
263:           completedPapers: number;
264:           failedPapers: number;
265:           avgProcessingTimeSeconds: number | null;
266:         }>
267:       >`
268:         SELECT
269:           COUNT(*)::int as "totalPapers",
270:           COUNT(*) FILTER (WHERE "processingStatus" = 'PROCESSING')::int as "processingPapers",
271:           COUNT(*) FILTER (WHERE "processingStatus" = 'PROCESSED')::int as "completedPapers",
272:           COUNT(*) FILTER (WHERE "processingStatus" = 'FAILED')::int as "failedPapers",
273:           AVG(
274:             CASE
275:               WHEN "processingStatus" = 'PROCESSED' AND "processedAt" IS NOT NULL
276:               THEN EXTRACT(EPOCH FROM ("processedAt" - "createdAt"))
277:               ELSE NULL
278:             END
279:           )::int as "avgProcessingTimeSeconds"
280:         FROM "Paper"
281:         WHERE "isDeleted" = false
282:       `;
283:       const stats = paperStatsResult[0];
284:       const averageProcessingTime = stats.avgProcessingTimeSeconds || 0;
285:       return {
286:         totalPapers: stats.totalPapers,
287:         processingPapers: stats.processingPapers,
288:         completedPapers: stats.completedPapers,
289:         failedPapers: stats.failedPapers,
290:         averageProcessingTime,
291:       };
292:     } catch (error) {
293:       console.error("Error fetching paper stats:", error);
294:       throw new ApiError(500, ADMIN_ERROR_MESSAGES.STATS_FETCH_FAILED);
295:     }
296:   }
297:   private async sampleCpuUsage(): Promise<number> {
298:     const read = () => {
299:       let idle = 0;
300:       let total = 0;
301:       for (const cpu of os.cpus()) {
302:         idle += cpu.times.idle;
303:         total +=
304:           cpu.times.user +
305:           cpu.times.nice +
306:           cpu.times.sys +
307:           cpu.times.idle +
308:           cpu.times.irq;
309:       }
310:       return { idle, total };
311:     };
312:     const a = read();
313:     await new Promise((resolve) => setTimeout(resolve, 150));
314:     const b = read();
315:     const idleDelta = b.idle - a.idle;
316:     const totalDelta = b.total - a.total;
317:     if (totalDelta <= 0) return 0;
318:     return 100 - (100 * idleDelta) / totalDelta;
319:   }
320:   async getSystemHealth(): Promise<ISystemHealth> {
321:     try {
322:       const startTime = Date.now();
323:       await prisma.$queryRaw`SELECT 1`;
324:       const dbResponseTime = Date.now() - startTime;
325:       const connections = await prisma.$queryRaw<
326:         Array<{ count: number }>
327:       >`SELECT COUNT(*)::int as count FROM pg_stat_activity WHERE datname = current_database()`;
328:       const storageResult = await prisma.$queryRaw<
329:         Array<{ totalStorageBytes: number }>
330:       >`
331:         SELECT COALESCE(SUM("sizeBytes")::bigint, 0) as "totalStorageBytes"
332:         FROM "PaperFile"
333:         WHERE "isDeleted" = false
334:       `;
335:       const totalStorageBytes = Number(storageResult[0].totalStorageBytes);
336:       const storageUsed = this.formatBytes(totalStorageBytes);
337:       const minTotalStorage = 100 * 1024 * 1024 * 1024;
338:       const estimatedTotalStorage = Math.max(
339:         totalStorageBytes * 10,
340:         minTotalStorage
341:       );
342:       const percentageUsed = Math.round(
343:         (totalStorageBytes / estimatedTotalStorage) * 1000
344:       ) / 10;
345:       const uptime = process.uptime();
346:       return {
347:         database: {
348:           status:
349:             dbResponseTime < 100
350:               ? "healthy"
351:               : dbResponseTime < 500
352:                 ? "degraded"
353:                 : "unhealthy",
354:           responseTime: dbResponseTime,
355:           activeConnections: connections[0].count,
356:         },
357:         storage: {
358:           total: this.formatBytes(estimatedTotalStorage),
359:           used: storageUsed,
360:           available: this.formatBytes(estimatedTotalStorage - totalStorageBytes),
361:           percentageUsed,
362:         },
363:         cache: {
364:           status: "healthy",
365:           hitRate: 0.85,
366:         },
367:         uptime,
368:         lastChecked: new Date(),
369:       };
370:     } catch (error) {
371:       console.error("Error checking system health:", error);
372:       throw new ApiError(500, ADMIN_ERROR_MESSAGES.HEALTH_CHECK_FAILED);
373:     }
374:   }
375:   private calculateGrowthPercentage(current: number, previous: number): number {
376:     if (previous === 0) return current > 0 ? 100 : 0;
377:     return Math.round(((current - previous) / previous) * 100);
378:   }
379:   private formatBytes(bytes: number): string {
380:     if (bytes === 0) return "0 Bytes";
381:     const k = 1024;
382:     const sizes = ["Bytes", "KB", "MB", "GB", "TB"];
383:     const i = Math.floor(Math.log(bytes) / Math.log(k));
384:     return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + " " + sizes[i];
385:   }
386:   async getSystemMetrics(): Promise<ISystemMetrics> {
387:     try {
388:       const startTime = Date.now();
389:       await prisma.$queryRaw`SELECT 1`;
390:       const dbResponseTime = Date.now() - startTime;
391:       const dbConnections = await prisma.$queryRaw<
392:         Array<{ active: number; max: number }>
393:       >`
394:         SELECT
395:           COUNT(*)::int as active,
396:           (SELECT setting::int FROM pg_settings WHERE name = 'max_connections') as max
397:         FROM pg_stat_activity
398:         WHERE datname = current_database()
399:       `;
400:       const activeConnections = dbConnections[0]?.active || 0;
401:       const maxConnections = dbConnections[0]?.max || 100;
402:       const connectionPoolUsage = (activeConnections / maxConnections) * 100;
403:       const cpus = os.cpus();
404:       const cpuCount = cpus.length;
405:       const loadAverage = os.loadavg();
406:       const cpuUsage = await this.sampleCpuUsage();
407:       const totalMemory = os.totalmem();
408:       const freeMemory = os.freemem();
409:       const usedMemory = totalMemory - freeMemory;
410:       const memoryUsagePercentage = (usedMemory / totalMemory) * 100;
411:       const storageResult = await prisma.$queryRaw<
412:         Array<{ totalStorageBytes: number }>
413:       >`
414:         SELECT COALESCE(SUM("sizeBytes")::bigint, 0) as "totalStorageBytes"
415:         FROM "PaperFile"
416:         WHERE "isDeleted" = false
417:       `;
418:       const usedStorage = Number(storageResult[0].totalStorageBytes);
419:       const minTotalStorage = 100 * 1024 * 1024 * 1024;
420:       const estimatedTotalStorage = Math.max(usedStorage * 10, minTotalStorage);
421:       const diskUsagePercentage = (usedStorage / estimatedTotalStorage) * 100;
422:       const dbStatus: "healthy" | "degraded" | "unhealthy" =
423:         dbResponseTime < 100
424:           ? "healthy"
425:           : dbResponseTime < 500
426:             ? "degraded"
427:             : "unhealthy";
428:       const tier = (usage: number): "healthy" | "degraded" | "warning" | "critical" => {
429:         if (usage < 50) return "healthy";
430:         if (usage < 70) return "degraded";
431:         if (usage < 85) return "warning";
432:         return "critical";
433:       };
434:       const cpuStatus = tier(cpuUsage);
435:       const storageStatus = tier(diskUsagePercentage);
436:       return {
437:         health: {
438:           database: dbStatus,
439:           server: "healthy",
440:           storage: storageStatus,
441:           cpu: cpuStatus,
442:         },
443:         performance: {
444:           cpu: {
445:             usage: Math.round(cpuUsage * 100) / 100,
446:             cores: cpuCount,
447:             loadAverage: loadAverage.map(
448:               (l: number) => Math.round(l * 100) / 100
449:             ),
450:           },
451:           memory: {
452:             total: totalMemory,
453:             used: usedMemory,
454:             free: freeMemory,
455:             usagePercentage: Math.round(memoryUsagePercentage * 100) / 100,
456:           },
457:           disk: {
458:             total: estimatedTotalStorage,
459:             used: usedStorage,
460:             free: estimatedTotalStorage - usedStorage,
461:             usagePercentage: Math.round(diskUsagePercentage * 100) / 100,
462:           },
463:           network: {
464:             bytesReceived: 0,
465:             bytesSent: 0,
466:             activeConnections,
467:           },
468:         },
469:         systemInfo: {
470:           platform: `${os.platform()} ${os.arch()}`,
471:           nodeVersion: process.version,
472:           databaseVersion: "PostgreSQL 15.x",
473:           totalMemory: this.formatBytes(totalMemory),
474:           storageCapacity: this.formatBytes(estimatedTotalStorage),
475:           uptime: Math.floor(process.uptime()),
476:           lastChecked: new Date(),
477:         },
478:         database: {
479:           status: dbStatus,
480:           responseTime: dbResponseTime,
481:           activeConnections,
482:           maxConnections,
483:           connectionPoolUsage: Math.round(connectionPoolUsage * 100) / 100,
484:         },
485:       };
486:     } catch (error) {
487:       console.error("Error fetching system metrics:", error);
488:       throw new ApiError(500, ADMIN_ERROR_MESSAGES.STATS_FETCH_FAILED);
489:     }
490:   }
491: }
