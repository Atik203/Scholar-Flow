<file path="apps/backend/src/app/modules/Billing/billing.service.ts">
  1: import { Prisma } from "../../shared/prisma";
  2: import Stripe from "stripe";
  3: import config from "../../config";
  4: import prismaClient from "../../shared/prisma";
  5: import stripe, {
  6:   getPlanNameFromPriceId,
  7:   isStripeError,
  8:   isValidPriceId,
  9:   logStripeError,
 10:   STRIPE_PRICE_IDS,
 11: } from "../../shared/stripe";
 12: import {
 13:   BILLING_INTERVALS,
 14:   PLAN_FEATURES,
 15:   PLAN_TIERS,
 16:   TRIAL_PERIOD_DAYS,
 17: } from "./billing.constant";
 18: import { BillingError } from "./billing.error";
 19: import type {
 20:   CreateCheckoutSessionInput,
 21:   CreatePortalSessionInput,
 22: } from "./billing.validation";
 23: const getPriceId = (planTier: string, interval: string): string | undefined => {
 24:   const prices = config.stripe.prices;
 25:   if (planTier === PLAN_TIERS.PRO) {
 26:     return interval === BILLING_INTERVALS.MONTHLY
 27:       ? prices.pro.monthly
 28:       : prices.pro.annual;
 29:   }
 30:   if (planTier === PLAN_TIERS.TEAM) {
 31:     return interval === BILLING_INTERVALS.MONTHLY
 32:       ? prices.team.monthly
 33:       : prices.team.annual;
 34:   }
 35:   if (planTier === PLAN_TIERS.ENTERPRISE) {
 36:     return interval === BILLING_INTERVALS.MONTHLY
 37:       ? prices.enterprise?.monthly
 38:       : prices.enterprise?.annual;
 39:   }
 40:   return undefined;
 41: };
 42: const getPlanTierFromPriceId = (priceId: string): string => {
 43:   const prices = config.stripe.prices;
 44:   if (priceId === prices.pro.monthly || priceId === prices.pro.annual) {
 45:     return PLAN_TIERS.PRO;
 46:   }
 47:   if (priceId === prices.team.monthly || priceId === prices.team.annual) {
 48:     return PLAN_TIERS.TEAM;
 49:   }
 50:   if (
 51:     priceId === prices.enterprise?.monthly ||
 52:     priceId === prices.enterprise?.annual
 53:   ) {
 54:     return PLAN_TIERS.ENTERPRISE;
 55:   }
 56:   throw BillingError.checkoutSessionCreationFailed(
 57:     `Invalid or unconfigured price ID: ${priceId}`
 58:   );
 59: };
 60: const getOrCreateStripeCustomer = async (
 61:   userId: string,
 62:   email: string,
 63:   name?: string
 64: ): Promise<string> => {
 65:   const user = await prismaClient.$queryRaw<
 66:     Array<{ stripeCustomerId: string | null }>
 67:   >`
 68:     SELECT "stripeCustomerId"
 69:     FROM "User"
 70:     WHERE id = ${userId}
 71:     LIMIT 1
 72:   `;
 73:   if (user[0]?.stripeCustomerId) {
 74:     return user[0].stripeCustomerId;
 75:   }
 76:   try {
 77:     const customer = await stripe.customers.create({
 78:       email,
 79:       name: name || undefined,
 80:       metadata: {
 81:         userId,
 82:       },
 83:     });
 84:     await prismaClient.$executeRaw`
 85:       UPDATE "User"
 86:       SET "stripeCustomerId" = ${customer.id}, "updatedAt" = NOW()
 87:       WHERE id = ${userId}
 88:     `;
 89:     return customer.id;
 90:   } catch (error) {
 91:     if (isStripeError(error)) {
 92:       logStripeError(error, "getOrCreateStripeCustomer");
 93:     }
 94:     throw BillingError.checkoutSessionCreationFailed(
 95:       "Failed to create Stripe customer"
 96:     );
 97:   }
 98: };
 99: /**
100:  * Create a Stripe Checkout session for plan upgrade
101:  * Simplified to accept priceId directly (matches example project pattern)
102:  */
103: export const createCheckoutSession = async (
104:   userId: string,
105:   email: string,
106:   name: string | undefined,
107:   input: CreateCheckoutSessionInput
108: ): Promise<{ sessionId: string; url: string }> => {
109:   const { priceId, workspaceId, successUrl, cancelUrl } = input;
110:   // Validate price ID
111:   if (!isValidPriceId(priceId)) {
112:     throw BillingError.checkoutSessionCreationFailed(
113:       `Invalid or unconfigured Stripe price ID: ${priceId}. Update STRIPE_PRICE_* env variables.`
114:     );
115:   }
116:   // Derive plan tier from price ID
117:   const planTier = getPlanTierFromPriceId(priceId);
118:   // Get or create Stripe customer
119:   const customerId = await getOrCreateStripeCustomer(userId, email, name);
120:   // Check if user already has an active subscription
121:   const existingSubscription = await prismaClient.$queryRaw<
122:     Array<{ id: string; status: string }>
123:   >`
124:     SELECT id, status
125:     FROM "Subscription"
126:     WHERE "userId" = ${userId}
127:       AND status = 'ACTIVE'
128:       AND "isDeleted" = false
129:     LIMIT 1
130:   `;
131:   const mode: Stripe.Checkout.SessionCreateParams.Mode =
132:     existingSubscription.length > 0 ? "subscription" : "subscription";
133:   // Determine trial eligibility
134:   const hasUsedTrial = await prismaClient.$queryRaw<Array<{ count: bigint }>>`
135:     SELECT COUNT(*)::int as count
136:     FROM "Subscription"
137:     WHERE "userId" = ${userId}
138:       AND "trialEnd" IS NOT NULL
139:       AND "isDeleted" = false
140:   `;
141:   const allowTrial =
142:     Number(hasUsedTrial[0]?.count || 0) === 0 &&
143:     existingSubscription.length === 0;
144:   try {
145:     // Create Checkout session with idempotency key
146:     const idempotencyKey = `checkout_${userId}_${priceId}_${Date.now()}`;
147:     const session = await stripe.checkout.sessions.create(
148:       {
149:         customer: customerId,
150:         mode,
151:         payment_method_types: ["card"],
152:         line_items: [
153:           {
154:             price: priceId,
155:             quantity: 1,
156:           },
157:         ],
158:         success_url:
159:           successUrl ||
160:           `${(config.reset_pass_link || config.frontend_url || "http://localhost:3000").replace("/reset-password", "")}/dashboard/billing?session_id={CHECKOUT_SESSION_ID}`,
161:         cancel_url:
162:           cancelUrl ||
163:           `${(config.reset_pass_link || config.frontend_url || "http:
164:         subscription_data: allowTrial
165:           ? {
166:               trial_period_days: TRIAL_PERIOD_DAYS,
167:               metadata: {
168:                 userId,
169:                 workspaceId: workspaceId || "",
170:                 planTier,
171:               },
172:             }
173:           : {
174:               metadata: {
175:                 userId,
176:                 workspaceId: workspaceId || "",
177:                 planTier,
178:               },
179:             },
180:         metadata: {
181:           userId,
182:           workspaceId: workspaceId || "",
183:           planTier,
184:           priceId,
185:         },
186:         allow_promotion_codes: true,
187:         billing_address_collection: "auto",
188:       },
189:       {
190:         idempotencyKey,
191:       }
192:     );
193:     if (!session.url) {
194:       throw BillingError.checkoutSessionCreationFailed(
195:         "No session URL returned"
196:       );
197:     }
198:     return {
199:       sessionId: session.id,
200:       url: session.url,
201:     };
202:   } catch (error) {
203:     if (isStripeError(error)) {
204:       logStripeError(error, "createCheckoutSession");
205:     }
206:     throw BillingError.checkoutSessionCreationFailed(
207:       error instanceof Error ? error.message : "Unknown error"
208:     );
209:   }
210: };
211: export const createPortalSession = async (
212:   userId: string,
213:   input: CreatePortalSessionInput
214: ): Promise<{ url: string }> => {
215:   const { returnUrl } = input;
216:   const user = await prismaClient.$queryRaw<
217:     Array<{ stripeCustomerId: string | null }>
218:   >`
219:     SELECT "stripeCustomerId"
220:     FROM "User"
221:     WHERE id = ${userId}
222:     LIMIT 1
223:   `;
224:   if (!user[0]?.stripeCustomerId) {
225:     throw BillingError.stripeCustomerNotFound(userId);
226:   }
227:   try {
228:     const session = await stripe.billingPortal.sessions.create({
229:       customer: user[0].stripeCustomerId,
230:       return_url: returnUrl || config.stripe.billingPortalReturnUrl,
231:     });
232:     return {
233:       url: session.url,
234:     };
235:   } catch (error) {
236:     if (isStripeError(error)) {
237:       logStripeError(error, "createPortalSession");
238:     }
239:     throw BillingError.portalSessionCreationFailed(
240:       error instanceof Error ? error.message : "Unknown error"
241:     );
242:   }
243: };
244: export const getUserSubscription = async (
245:   userId: string,
246:   workspaceId?: string
247: ) => {
248:   const subscription = await prismaClient.$queryRaw<
249:     Array<{
250:       id: string;
251:       status: string;
252:       planId: string;
253:       currentPeriodEnd: Date | null;
254:       cancelAtPeriodEnd: boolean;
255:       trialEnd: Date | null;
256:       seats: number;
257:       providerSubscriptionId: string | null;
258:     }>
259:   >`
260:     SELECT
261:       s.id,
262:       s.status,
263:       s."planId",
264:       s."currentPeriodEnd",
265:       s."cancelAtPeriodEnd",
266:       s."trialEnd",
267:       s.seats,
268:       s."providerSubscriptionId"
269:     FROM "Subscription" s
270:     WHERE s."userId" = ${userId}
271:       ${workspaceId ? Prisma.sql`AND s."workspaceId" = ${workspaceId}` : Prisma.empty}
272:       AND s."isDeleted" = false
273:     ORDER BY s."createdAt" DESC
274:     LIMIT 1
275:   `;
276:   if (subscription.length === 0) {
277:     return null;
278:   }
279:   const plan = await prismaClient.$queryRaw<
280:     Array<{
281:       code: string;
282:       name: string;
283:       features: any;
284:     }>
285:   >`
286:     SELECT code, name, features
287:     FROM "Plan"
288:     WHERE id = ${subscription[0].planId}
289:       AND "isDeleted" = false
290:     LIMIT 1
291:   `;
292:   return {
293:     ...subscription[0],
294:     plan: plan[0] || null,
295:     features:
296:       PLAN_FEATURES[subscription[0].planId as keyof typeof PLAN_FEATURES] || {},
297:   };
298: };
299: export const cancelSubscription = async (
300:   userId: string,
301:   workspaceId?: string
302: ): Promise<void> => {
303:   const subscription = await getUserSubscription(userId, workspaceId);
304:   if (!subscription) {
305:     throw BillingError.subscriptionNotFound(userId);
306:   }
307:   if (!subscription.providerSubscriptionId) {
308:     throw new Error("Subscription missing Stripe subscription ID");
309:   }
310:   try {
311:     await stripe.subscriptions.update(subscription.providerSubscriptionId, {
312:       cancel_at_period_end: true,
313:     });
314:     await prismaClient.$executeRaw`
315:       UPDATE "Subscription"
316:       SET "cancelAtPeriodEnd" = true, "updatedAt" = NOW()
317:       WHERE id = ${subscription.id}
318:     `;
319:   } catch (error) {
320:     if (isStripeError(error)) {
321:       logStripeError(error, "cancelSubscription");
322:     }
323:     throw new Error(
324:       `Failed to cancel subscription: ${error instanceof Error ? error.message : "Unknown error"}`
325:     );
326:   }
327: };
328: /**
329:  * Reactivate a canceled subscription
330:  */
331: export const reactivateSubscription = async (
332:   userId: string,
333:   workspaceId?: string
334: ): Promise<void> => {
335:   const subscription = await getUserSubscription(userId, workspaceId);
336:   if (!subscription) {
337:     throw BillingError.subscriptionNotFound(userId);
338:   }
339:   if (!subscription.providerSubscriptionId) {
340:     throw new Error("Subscription missing Stripe subscription ID");
341:   }
342:   try {
343:     // Reactivate via Stripe
344:     await stripe.subscriptions.update(subscription.providerSubscriptionId, {
345:       cancel_at_period_end: false,
346:     });
347:     // Update local record
348:     await prismaClient.$executeRaw`
349:       UPDATE "Subscription"
350:       SET "cancelAtPeriodEnd" = false, "updatedAt" = NOW()
351:       WHERE id = ${subscription.id}
352:     `;
353:   } catch (error) {
354:     if (isStripeError(error)) {
355:       logStripeError(error, "reactivateSubscription");
356:     }
357:     throw new Error(
358:       `Failed to reactivate subscription: ${error instanceof Error ? error.message : "Unknown error"}`
359:     );
360:   }
361: };
362: export const billingService = {
363:   createCheckoutSession,
364:   createPortalSession,
365:   getUserSubscription,
366:   cancelSubscription,
367:   reactivateSubscription,
368:   getPriceId,
369:   getOrCreateStripeCustomer,
370: };
</file>

<file path="apps/backend/src/app/modules/Billing/webhook.controller.ts">
  1: import { Prisma } from "../../shared/prisma";
  2: import { Request, Response } from "express";
  3: import Stripe from "stripe";
  4: import config from "../../config";
  5: import catchAsync from "../../shared/catchAsync";
  6: import prismaClient from "../../shared/prisma";
  7: import stripe, { getRoleFromPriceId } from "../../shared/stripe";
  8: import { STRIPE_WEBHOOK_EVENTS, SUBSCRIPTION_STATUS } from "./billing.constant";
  9: import { BillingError } from "./billing.error";
 10: type RawBodyRequest = Request & { rawBody?: Buffer | string };
 11: type MutableRawBodyRequest = RawBodyRequest & { body?: unknown };
 12: type StripeWebhookEventType =
 13:   (typeof STRIPE_WEBHOOK_EVENTS)[keyof typeof STRIPE_WEBHOOK_EVENTS];
 14: const logDebug = (...args: unknown[]) => {
 15:   if (process.env.NODE_ENV !== "production") {
 16:     console.log(...args);
 17:   }
 18: };
 19: export const handleStripeWebhook = catchAsync(
 20:   async (req: Request, res: Response): Promise<void> => {
 21:     const sig = req.headers["stripe-signature"];
 22:     if (!sig) {
 23:       throw BillingError.webhookSignatureVerificationFailed();
 24:     }
 25:     if (!config.stripe.webhook_secret) {
 26:       throw new Error("STRIPE_WEBHOOK_SECRET not configured");
 27:     }
 28:     const rawBody = await getRawBodyBuffer(req as RawBodyRequest);
 29:     let event: Stripe.Event;
 30:     try {
 31:       event = stripe.webhooks.constructEvent(
 32:         rawBody,
 33:         sig,
 34:         config.stripe.webhook_secret
 35:       );
 36:     } catch (error) {
 37:       const errorMessage =
 38:         error instanceof Error ? error.message : "Unknown verification error";
 39:       console.error("Webhook signature verification failed", {
 40:         message: errorMessage,
 41:       });
 42:       throw BillingError.webhookSignatureVerificationFailed();
 43:     }
 44:     if (process.env.NODE_ENV === "development") {
 45:       console.log(`Received webhook event: ${event.type}`);
 46:     }
 47:     const existingEvent = await prismaClient.$queryRaw<Array<{ id: string }>>`
 48:       SELECT id
 49:       FROM "WebhookEvent"
 50:       WHERE provider = 'STRIPE'
 51:         AND "eventId" = ${event.id}
 52:       LIMIT 1
 53:     `;
 54:     if (existingEvent.length > 0) {
 55:       if (process.env.NODE_ENV !== "production") {
 56:         console.log(`Duplicate webhook event: ${event.id}, skipping`);
 57:       }
 58:       res.status(200).json({ received: true, duplicate: true });
 59:       return;
 60:     }
 61:     await prismaClient.$executeRaw`
 62:       INSERT INTO "WebhookEvent" (id, provider, "eventId", type, payload, status, "receivedAt", "createdAt", "updatedAt", "isDeleted")
 63:       VALUES (
 64:         gen_random_uuid(),
 65:         'STRIPE',
 66:         ${event.id},
 67:         ${event.type},
 68:         ${JSON.stringify(event)}::jsonb,
 69:         'pending',
 70:         NOW(),
 71:         NOW(),
 72:         NOW(),
 73:         false
 74:       )
 75:     `;
 76:     // Process event
 77:     try {
 78:       await processStripeEvent(event);
 79:       // Mark event as processed
 80:       await prismaClient.$executeRaw`
 81:         UPDATE "WebhookEvent"
 82:         SET status = 'processed', "processedAt" = NOW(), "updatedAt" = NOW()
 83:         WHERE "eventId" = ${event.id} AND provider = 'STRIPE'
 84:       `;
 85:     } catch (error) {
