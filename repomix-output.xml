<file path="apps/frontend/src/components/billing/ManageSubscriptionButton.tsx">
 1: "use client";
 2: import { Button } from "@/components/ui/button";
 3: import { showErrorToast } from "@/components/providers/ToastProvider";
 4: import { apiSlice } from "@/redux/api/apiSlice";
 5: import { useCreatePortalSessionMutation } from "@/redux/api/billingApi";
 6: import { useAppDispatch } from "@/redux/hooks";
 7: import { Loader2 } from "lucide-react";
 8: import { useEffect, useRef } from "react";
 9: interface ManageSubscriptionButtonProps {
10:   className?: string;
11:   variant?:
12:     | "default"
13:     | "outline"
14:     | "ghost"
15:     | "link"
16:     | "destructive"
17:     | "secondary";
18: }
19: export function ManageSubscriptionButton({
20:   className,
21:   variant = "default",
22: }: ManageSubscriptionButtonProps) {
23:   const [createPortal, { isLoading }] = useCreatePortalSessionMutation();
24:   const dispatch = useAppDispatch();
25:   const hasOpenedPortalRef = useRef(false);
26:   const returnCheckIntervalRef = useRef<NodeJS.Timeout | null>(null);
27:   const handleManageSubscription = async () => {
28:     try {
29:       const response = await createPortal({}).unwrap();
30:       if (response?.data?.url) {
31:         hasOpenedPortalRef.current = true;
32:         window.location.href = response.data.url;
33:       } else {
34:         throw new Error("No portal URL received");
35:       }
36:     } catch (error) {
37:       const message =
38:         (error as { data?: { message?: string } })?.data?.message ||
39:         "Failed to open subscription portal. Please try again.";
40:       showErrorToast(message);
41:     }
42:   };
43:   useEffect(() => {
44:     const handleVisibilityChange = () => {
45:       if (hasOpenedPortalRef.current && !document.hidden) {
46:         console.log(
47:           "[ManageSubscriptionButton] User returned from portal, refreshing data"
48:         );
49:         dispatch(apiSlice.util.invalidateTags(["User"]));
50:         setTimeout(() => {
51:           hasOpenedPortalRef.current = false;
52:         }, 1000);
53:       }
54:     };
55:     const handleFocus = () => {
56:       if (hasOpenedPortalRef.current) {
57:         console.log(
58:           "[ManageSubscriptionButton] Window focused after portal, refreshing data"
59:         );
60:         dispatch(apiSlice.util.invalidateTags(["User"]));
61:         setTimeout(() => {
62:           hasOpenedPortalRef.current = false;
63:         }, 1000);
64:       }
65:     };
66:     document.addEventListener("visibilitychange", handleVisibilityChange);
67:     window.addEventListener("focus", handleFocus);
68:     const intervalRef = returnCheckIntervalRef.current;
69:     return () => {
70:       document.removeEventListener("visibilitychange", handleVisibilityChange);
71:       window.removeEventListener("focus", handleFocus);
72:       if (intervalRef) {
73:         clearInterval(intervalRef);
74:       }
75:     };
76:   }, [dispatch]);
77:   return (
78:     <Button
79:       onClick={handleManageSubscription}
80:       disabled={isLoading}
81:       className={className}
82:       variant={variant}
83:     >
84:       {isLoading ? (
85:         <>
86:           <Loader2 className="mr-2 h-4 w-4 animate-spin" />
87:           Loading...
88:         </>
89:       ) : (
90:         "Manage Subscription"
91:       )}
92:     </Button>
93:   );
94: }
</file>

