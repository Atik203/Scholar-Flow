<file path="apps/backend/src/app/services/activityLog.service.ts">
  1: import prisma from "../shared/prisma";
  2: import ApiError from "../errors/ApiError";
  3: import { AuthRequest } from "../middleware/auth";
  4: export interface ActivityLogFilters {
  5:   userId?: string;
  6:   workspaceId?: string;
  7:   entity?: string;
  8:   entityId?: string;
  9:   action?: string;
 10:   severity?: 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL';
 11:   startDate?: Date;
 12:   endDate?: Date;
 13:   limit?: number;
 14:   cursor?: string;
 15: }
 16: export interface ActivityLogEntry {
 17:   id: string;
 18:   userId?: string | null;
 19:   workspaceId?: string | null;
 20:   entity: string;
 21:   entityId: string;
 22:   action: string;
 23:   details?: any;
 24:   metadata?: any;
 25:   severity: 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL';
 26:   createdAt: Date;
 27:   user?: {
 28:     id: string;
 29:     name?: string | null;
 30:     firstName?: string | null;
 31:     lastName?: string | null;
 32:     image?: string | null;
 33:   } | null;
 34:   workspace?: {
 35:     id: string;
 36:     name: string;
 37:   } | null;
 38: }
 39: export class ActivityLogService {
 40:   static async logActivity(
 41:     userId: string | null,
 42:     workspaceId: string | null,
 43:     entity: string,
 44:     entityId: string,
 45:     action: string,
 46:     details?: any,
 47:     metadata?: any,
 48:     severity: 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL' = 'INFO'
 49:   ): Promise<void> {
 50:     try {
 51:       await prisma.activityLogEntry.create({
 52:         data: {
 53:           userId,
 54:           workspaceId,
 55:           entity,
 56:           entityId,
 57:           action,
 58:           details,
 59:           metadata,
 60:           severity
 61:         }
 62:       });
 63:     } catch (error) {
 64:       console.error('Failed to log activity:', error);
 65:     }
 66:   }
 67:   static async getActivityLog(
 68:     req: AuthRequest,
 69:     filters: ActivityLogFilters
 70:   ): Promise<{ entries: ActivityLogEntry[]; total: number }> {
 71:     const currentUserId = req.user?.id;
 72:     if (!currentUserId) {
 73:       throw new ApiError(401, 'User not authenticated');
 74:     }
 75:     try {
 76:       const where: any = {
 77:         isDeleted: false
 78:       };
 79:       if (filters.userId) {
 80:         where.userId = filters.userId;
 81:       }
 82:       if (filters.workspaceId) {
 83:         where.workspaceId = filters.workspaceId;
 84:         const workspace = await prisma.workspace.findFirst({
 85:           where: {
 86:             id: filters.workspaceId,
 87:             isDeleted: false,
 88:             OR: [
 89:               { ownerId: currentUserId },
 90:               {
 91:                 members: {
 92:                   some: {
 93:                     userId: currentUserId,
 94:                     isDeleted: false
 95:                   }
 96:                 }
 97:               }
 98:             ]
 99:           }
100:         });
101:         if (!workspace) {
102:           throw new ApiError(404, 'Workspace not found or access denied');
103:         }
104:       }
105:       if (filters.entity) {
106:         where.entity = filters.entity;
107:       }
108:       if (filters.entityId) {
109:         where.entityId = filters.entityId;
110:       }
111:       if (filters.action) {
112:         where.action = filters.action;
113:       }
114:       if (filters.severity) {
115:         where.severity = filters.severity;
116:       }
117:       if (filters.startDate || filters.endDate) {
118:         where.createdAt = {};
119:         if (filters.startDate) {
120:           where.createdAt.gte = filters.startDate;
121:         }
122:         if (filters.endDate) {
123:           where.createdAt.lte = filters.endDate;
124:         }
125:       }
126:       if (!filters.workspaceId && !filters.userId) {
127:         const userWorkspaces = await prisma.workspace.findMany({
128:           where: {
129:             isDeleted: false,
130:             OR: [
131:               { ownerId: currentUserId },
132:               {
133:                 members: {
134:                   some: {
135:                     userId: currentUserId,
136:                     isDeleted: false
137:                   }
138:                 }
139:               }
140:             ]
141:           },
142:           select: { id: true }
143:         });
144:         const workspaceIds = userWorkspaces.map((w: any) => w.id);
145:         where.OR = [
146:           { workspaceId: { in: workspaceIds } },
147:           { userId: currentUserId }
148:         ];
149:       }
150:       const [entries, total] = await Promise.all([
151:         prisma.activityLogEntry.findMany({
152:           where,
153:           include: {
154:             user: {
155:               select: {
156:                 id: true,
157:                 name: true,
158:                 firstName: true,
159:                 lastName: true,
160:                 image: true
161:               }
162:             },
163:             workspace: {
164:               select: {
165:                 id: true,
166:                 name: true
167:               }
168:             }
169:           },
170:           orderBy: [
171:             { createdAt: 'desc' },
172:             { id: 'desc' },
173:           ],
174:           take: filters.limit || 50,
175:           ...(filters.cursor ? {
176:             cursor: { id: filters.cursor },
177:             skip: 1,
178:           } : {}),
179:         }),
180:         prisma.activityLogEntry.count({ where })
181:       ]);
182:       return { entries, total };
183:     } catch (error) {
184:       if (error instanceof ApiError) throw error;
185:       throw new ApiError(500, 'Failed to fetch activity log');
186:     }
187:   }
188:   static async getActivitySummary(
189:     req: AuthRequest,
190:     workspaceId?: string,
191:     days: number = 7
192:   ): Promise<{
193:     totalActivities: number;
194:     activitiesByType: { [key: string]: number };
195:     activitiesBySeverity: { [key: string]: number };
196:     recentActivities: ActivityLogEntry[];
197:     trends: { [key: string]: number };
198:   }> {
199:     const userId = req.user?.id;
200:     if (!userId) {
201:       throw new ApiError(401, 'User not authenticated');
202:     }
203:     const startDate = new Date();
204:     startDate.setDate(startDate.getDate() - days);
205:     try {
206:       const where: any = {
207:         isDeleted: false,
208:         createdAt: {
209:           gte: startDate
210:         }
211:       };
212:       if (workspaceId) {
213:         where.workspaceId = workspaceId;
214:         const workspace = await prisma.workspace.findFirst({
215:           where: {
216:             id: workspaceId,
