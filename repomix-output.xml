126:             >
127:               <path
128:                 strokeLinecap="round"
129:                 strokeLinejoin="round"
130:                 strokeWidth={2}
131:                 d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
132:               />
133:             </svg>
134:           </div>
135:           <h2 className="text-xl font-semibold mb-2">Authentication Failed</h2>
136:           <p className="text-muted-foreground mb-4">{error}</p>
137:           <p className="text-sm text-muted-foreground">
138:             Redirecting to login...
139:           </p>
140:         </div>
141:       </div>
142:     );
143:   }
144:   return (
