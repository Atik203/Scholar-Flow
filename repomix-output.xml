                <p className="text-sm text-muted-foreground mt-1">
                  {cardPaper.authors.slice(0, 2).join(", ")}
                  {cardPaper.authors.length > 2 &&
                    ` +${cardPaper.authors.length - 2} more`}
                </p>
              </div>
              <Badge
                variant={
                  relevance >= 90
                    ? "default"
                    : relevance >= 80
                      ? "secondary"
