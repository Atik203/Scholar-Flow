<file path="apps/frontend/src/components/customUI/form/MultiSelect.tsx">
  1: import { cn } from "@/lib/utils";
  2: import { Check, ChevronDown, X } from "lucide-react";
  3: import * as React from "react";
  4: import { Badge } from "../../ui/badge";
  5: import { Button } from "../../ui/button";
  6: import {
  7:   DropdownMenu,
  8:   DropdownMenuContent,
  9:   DropdownMenuItem,
 10:   DropdownMenuTrigger,
 11: } from "../../ui/dropdown-menu";
 12: export interface MultiSelectOption {
 13:   value: string;
 14:   label: string;
 15:   disabled?: boolean;
 16: }
 17: export interface MultiSelectProps {
 18:   options: MultiSelectOption[];
 19:   value: string[];
 20:   onChange: (value: string[]) => void;
 21:   placeholder?: string;
 22:   label?: string;
 23:   helperText?: string;
 24:   error?: string;
 25:   disabled?: boolean;
 26:   searchable?: boolean;
 27:   maxItems?: number;
 28:   className?: string;
 29: }
 30: export const MultiSelect: React.FC<MultiSelectProps> = ({
 31:   options,
 32:   value,
 33:   onChange,
 34:   placeholder = "Select options...",
 35:   label,
 36:   helperText,
 37:   error,
 38:   disabled = false,
 39:   searchable = true,
 40:   maxItems,
 41:   className,
 42: }) => {
 43:   const [isOpen, setIsOpen] = React.useState(false);
 44:   const [searchQuery, setSearchQuery] = React.useState("");
 45:   const [focusedIndex, setFocusedIndex] = React.useState(-1);
 46:   const filteredOptions = React.useMemo(() => {
 47:     if (!searchable || !searchQuery) return options;
 48:     return options.filter((option) =>
 49:       option.label.toLowerCase().includes(searchQuery.toLowerCase())
 50:     );
 51:   }, [options, searchQuery, searchable]);
 52:   const selectedOptions = React.useMemo(() => {
 53:     return options.filter((option) => value.includes(option.value));
 54:   }, [options, value]);
 55:   const handleSelect = (optionValue: string) => {
 56:     if (disabled) return;
 57:     const newValue = value.includes(optionValue)
 58:       ? value.filter((v) => v !== optionValue)
 59:       : [...value, optionValue];
 60:     onChange(newValue);
 61:   };
 62:   const handleRemove = (optionValue: string) => {
 63:     if (disabled) return;
 64:     onChange(value.filter((v) => v !== optionValue));
 65:   };
 66:   const handleKeyDown = (e: React.KeyboardEvent) => {
 67:     if (disabled) return;
 68:     switch (e.key) {
 69:       case "ArrowDown":
 70:         e.preventDefault();
 71:         setFocusedIndex((prev) =>
 72:           prev < filteredOptions.length - 1 ? prev + 1 : 0
 73:         );
 74:         break;
 75:       case "ArrowUp":
 76:         e.preventDefault();
 77:         setFocusedIndex((prev) =>
 78:           prev > 0 ? prev - 1 : filteredOptions.length - 1
 79:         );
 80:         break;
 81:       case "Enter":
 82:         e.preventDefault();
 83:         if (focusedIndex >= 0 && focusedIndex < filteredOptions.length) {
 84:           handleSelect(filteredOptions[focusedIndex].value);
 85:         }
 86:         break;
 87:       case "Escape":
 88:         setIsOpen(false);
 89:         setFocusedIndex(-1);
 90:         break;
 91:     }
 92:   };
 93:   const isAtMaxItems = maxItems && value.length >= maxItems;
 94:   return (
 95:     <div className={cn("space-y-2", className)}>
 96:       {label && (
 97:         <label className="text-sm font-medium text-foreground">{label}</label>
 98:       )}
 99:       <div className="relative">
100:         <DropdownMenu open={isOpen} onOpenChange={setIsOpen}>
101:           <DropdownMenuTrigger asChild>
102:             <Button
103:               variant="outline"
104:               role="combobox"
105:               aria-expanded={isOpen}
106:               disabled={disabled}
107:               className={cn(
108:                 "w-full justify-between",
109:                 error && "border-destructive",
110:                 disabled && "opacity-50 cursor-not-allowed"
111:               )}
112:               onKeyDown={handleKeyDown}
113:             >
114:               <div className="flex flex-wrap gap-1 flex-1 min-w-0">
115:                 {selectedOptions.length > 0 ? (
116:                   selectedOptions.map((option) => (
117:                     <Badge
118:                       key={option.value}
119:                       variant="secondary"
120:                       className="text-xs"
121:                     >
122:                       {option.label}
123:                       <button
124:                         type="button"
125:                         onClick={(e) => {
126:                           e.stopPropagation();
127:                           handleRemove(option.value);
128:                         }}
129:                         className="ml-1 hover:bg-destructive hover:text-destructive-foreground rounded-full p-0.5"
130:                         disabled={disabled}
131:                       >
132:                         <X className="h-3 w-3" />
133:                       </button>
134:                     </Badge>
135:                   ))
136:                 ) : (
137:                   <span className="text-muted-foreground">{placeholder}</span>
138:                 )}
139:               </div>
140:               <ChevronDown className="h-4 w-4 shrink-0 opacity-50" />
141:             </Button>
142:           </DropdownMenuTrigger>
143:           <DropdownMenuContent
144:             className="w-full min-w-[200px] p-0"
145:             align="start"
146:           >
147:             {searchable && (
148:               <div className="p-2 border-b">
149:                 <input
150:                   type="text"
151:                   placeholder="Search options..."
152:                   value={searchQuery}
153:                   onChange={(e) => setSearchQuery(e.target.value)}
154:                   className="w-full px-2 py-1 text-sm border rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
155:                   onKeyDown={(e) => e.stopPropagation()}
156:                 />
157:               </div>
158:             )}
159:             <div className="max-h-60 overflow-auto">
160:               {filteredOptions.length === 0 ? (
161:                 <div className="px-2 py-4 text-center text-sm text-muted-foreground">
162:                   No options found
163:                 </div>
164:               ) : (
165:                 filteredOptions.map((option, index) => {
166:                   const isSelected = value.includes(option.value);
167:                   const isFocused = index === focusedIndex;
168:                   const isDisabled =
169:                     !!option.disabled || !!(isAtMaxItems && !isSelected);
170:                   return (
171:                     <DropdownMenuItem
172:                       key={option.value}
173:                       className={cn(
174:                         "flex items-center gap-2 cursor-pointer",
175:                         isSelected && "bg-accent",
176:                         isFocused && "bg-accent/50",
177:                         isDisabled && "opacity-50 cursor-not-allowed"
178:                       )}
179:                       onSelect={() => !isDisabled && handleSelect(option.value)}
180:                       disabled={isDisabled}
181:                     >
182:                       <div className="flex items-center gap-2 flex-1">
183:                         {isSelected && (
184:                           <Check className="h-4 w-4 text-primary" />
185:                         )}
186:                         <span className={cn(isSelected && "font-medium")}>
187:                           {option.label}
188:                         </span>
189:                       </div>
190:                     </DropdownMenuItem>
191:                   );
192:                 })
193:               )}
194:             </div>
195:             {maxItems && (
196:               <div className="px-2 py-2 text-xs text-muted-foreground border-t">
197:                 {value.length}/{maxItems} items selected
198:               </div>
199:             )}
200:           </DropdownMenuContent>
201:         </DropdownMenu>
202:       </div>
203:       {helperText && !error && (
204:         <p className="text-sm text-muted-foreground">{helperText}</p>
205:       )}
206:       {error && <p className="text-sm text-destructive">{error}</p>}
207:     </div>
208:   );
209: };
</file>

