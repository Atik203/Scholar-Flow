1597:       SET "isDeleted" = true, "updatedAt" = NOW()
1598:       WHERE id = ${collectionPaper.id}
1599:     `;
1600:     sendSuccessResponse(
1601:       res,
1602:       null,
1603:       "Paper removed from collection successfully"
1604:     );
1605:   }),
1606:   // Get papers in a collection
1607:   getCollectionPapers: catchAsync(async (req: Request, res: Response) => {
1608:     const authReq = req as AuthenticatedRequest;
1609:     const { collectionId } = req.params;
1610:     const page = parseInt(req.query.page as string) || 1;
1611:     const limit = parseInt(req.query.limit as string) || 10;
1612:     const skip = (page - 1) * limit;
1613:     // Check if collection exists and user has access
1614:     const collectionRows = await prisma.$queryRaw<
1615:       Array<{
1616:         id: string;
1617:         isPublic: boolean;
1618:         ownerId: string;
1619:         hasMembership: boolean;
1620:       }>
1621:     >`
1622:       SELECT
1623:         c.id,
1624:         c."isPublic",
1625:         c."ownerId",
1626:         CASE
1627:           WHEN cm."userId" IS NOT NULL AND cm.status = 'ACCEPTED' THEN true
1628:           ELSE false
1629:         END AS "hasMembership"
1630:       FROM "Collection" c
1631:       LEFT JOIN "CollectionMember" cm
1632:         ON cm."collectionId" = c.id
1633:         AND cm."userId" = ${authReq.user?.id ?? null}
1634:         AND cm."isDeleted" = false
1635:         AND cm.status = 'ACCEPTED'
1636:       WHERE c.id = ${collectionId}
1637:         AND c."isDeleted" = false
1638:       LIMIT 1
1639:     `;
1640:     const collection = collectionRows[0];
1641:     if (!collection) {
1642:       throw new ApiError(404, "Collection not found");
1643:     }
1644:     // Check access permissions
1645:     const isOwner = authReq.user?.id === collection.ownerId;
1646:     const isPublic = collection.isPublic;
1647:     const hasMembership = collection.hasMembership;
1648:     if (!isOwner && !isPublic && !hasMembership) {
1649:       throw new ApiError(403, "Access denied");
1650:     }
1651:     // Get papers in collection
1652:     const paperRows = await prisma.$queryRaw<
1653:       Array<{
1654:         cp_id: string;
1655:         cp_collectionId: string;
1656:         cp_paperId: string;
1657:         cp_addedById: string;
1658:         cp_addedAt: Date;
1659:         cp_createdAt: Date;
1660:         cp_updatedAt: Date;
1661:         paper_id: string;
1662:         paper_workspaceId: string;
1663:         paper_uploaderId: string;
1664:         paper_title: string;
1665:         paper_abstract: string | null;
1666:         paper_metadata: unknown;
1667:         paper_source: string | null;
1668:         paper_doi: string | null;
1669:         paper_processingStatus: string;
1670:         paper_createdAt: Date;
1671:         paper_updatedAt: Date;
1672:         file_id: string | null;
1673:         file_storageProvider: string | null;
1674:         file_objectKey: string | null;
1675:         file_contentType: string | null;
1676:         file_sizeBytes: number | null;
1677:         file_originalFilename: string | null;
1678:         uploader_id: string;
1679:         uploader_name: string | null;
1680:         uploader_email: string | null;
1681:       }>
1682:     >`
1683:       SELECT
1684:         cp.id AS cp_id,
1685:         cp."collectionId" AS "cp_collectionId",
1686:         cp."paperId" AS "cp_paperId",
1687:         cp."addedById" AS "cp_addedById",
1688:         cp."addedAt" AS "cp_addedAt",
1689:         cp."createdAt" AS "cp_createdAt",
1690:         cp."updatedAt" AS "cp_updatedAt",
1691:         p.id AS paper_id,
1692:         p."workspaceId" AS "paper_workspaceId",
1693:         p."uploaderId" AS "paper_uploaderId",
1694:         p.title AS paper_title,
1695:         p.abstract AS paper_abstract,
1696:         p.metadata AS paper_metadata,
1697:         p.source AS paper_source,
1698:         p.doi AS paper_doi,
1699:         p."processingStatus" AS "paper_processingStatus",
1700:         p."createdAt" AS "paper_createdAt",
1701:         p."updatedAt" AS "paper_updatedAt",
1702:         pf.id AS file_id,
1703:         pf."storageProvider" AS "file_storageProvider",
1704:         pf."objectKey" AS file_objectKey,
1705:         pf."contentType" AS "file_contentType",
1706:         pf."sizeBytes" AS "file_sizeBytes",
1707:         pf."originalFilename" AS "file_originalFilename",
1708:         u.id AS uploader_id,
1709:         u.name AS uploader_name,
1710:         u.email AS uploader_email
1711:       FROM "CollectionPaper" cp
1712:       JOIN "Paper" p ON p.id = cp."paperId"
1713:       LEFT JOIN "PaperFile" pf ON pf."paperId" = p.id AND pf."isDeleted" = false
1714:       JOIN "User" u ON u.id = p."uploaderId"
1715:       WHERE cp."collectionId" = ${collectionId}
1716:         AND cp."isDeleted" = false
1717:       ORDER BY cp."addedAt" DESC
1718:       LIMIT ${limit} OFFSET ${skip}
1719:     `;
1720:     const totalRes = await prisma.$queryRaw<Array<{ count: number }>>`
1721:       SELECT COUNT(*)::int as count
1722:       FROM "CollectionPaper" cp
1723:       WHERE cp."collectionId" = ${collectionId}
1724:         AND cp."isDeleted" = false
1725:     `;
1726:     const papers = paperRows.map((row) => ({
1727:       id: row.cp_id,
1728:       collectionId: row.cp_collectionId,
1729:       paperId: row.cp_paperId,
1730:       addedById: row.cp_addedById,
1731:       addedAt: row.cp_addedAt,
1732:       createdAt: row.cp_createdAt,
1733:       updatedAt: row.cp_updatedAt,
1734:       paper: {
1735:         id: row.paper_id,
1736:         workspaceId: row.paper_workspaceId,
1737:         uploaderId: row.paper_uploaderId,
1738:         title: row.paper_title,
1739:         abstract: row.paper_abstract,
1740:         metadata: row.paper_metadata,
1741:         source: row.paper_source,
1742:         doi: row.paper_doi,
1743:         processingStatus: row.paper_processingStatus,
1744:         createdAt: row.paper_createdAt,
1745:         updatedAt: row.paper_updatedAt,
1746:         file: row.file_id
1747:           ? {
1748:               id: row.file_id,
1749:               storageProvider: row.file_storageProvider,
1750:               objectKey: row.file_objectKey,
1751:               contentType: row.file_contentType,
1752:               sizeBytes: row.file_sizeBytes,
1753:               originalFilename: row.file_originalFilename,
1754:             }
1755:           : null,
1756:         uploader: {
1757:           id: row.uploader_id,
1758:           name: row.uploader_name,
1759:           email: row.uploader_email,
1760:         },
1761:       },
1762:     }));
1763:     const total = totalRes[0]?.count || 0;
1764:     const totalPage = Math.ceil(total / limit);
1765:     sendPaginatedResponse(
1766:       res,
1767:       papers,
1768:       { page, limit, total, totalPage },
1769:       "Collection papers retrieved successfully"
1770:     );
1771:   }),
1772:   // Phase 4: Update reading status or star a paper within a collection
1773:   updateCollectionPaper: catchAsync(async (req: Request, res: Response) => {
1774:     const authReq = req as AuthenticatedRequest;
1775:     if (!authReq.user?.id) {
1776:       throw new ApiError(401, "Authentication required");
1777:     }
1778:     const { collectionId, paperId } = req.params;
1779:     const { status, isStarred } = req.body;
1780:     const userId = authReq.user.id;
1781:     // Check if the CollectionPaper relationship exists and user has access
1782:     const cpRows = await prisma.$queryRaw<Array<{ id: string; addedById: string }>>`
1783:       SELECT cp.id, cp."addedById"
1784:       FROM "CollectionPaper" cp
1785:       WHERE cp."collectionId" = ${collectionId}
1786:         AND cp."paperId" = ${paperId}
1787:         AND cp."isDeleted" = false
1788:       LIMIT 1
1789:     `;
1790:     if (!cpRows.length) {
1791:       throw new ApiError(404, "Paper not found in this collection");
1792:     }
1793:     const hasPermission = await CollectionService.hasEditPermission(
1794:       collectionId,
1795:       userId
1796:     );
1797:     if (!hasPermission) {
1798:       throw new ApiError(
1799:         403,
1800:         "Access denied: You don't have edit permission for this collection"
1801:       );
1802:     }
1803:     const updateData: Prisma.CollectionPaperUpdateInput = {};
1804:     if (status !== undefined) {
1805:       updateData.status = status;
1806:     }
1807:     if (isStarred !== undefined) {
1808:       updateData.isStarred = isStarred;
1809:     }
1810:     if (Object.keys(updateData).length === 0) {
1811:       throw new ApiError(400, "No fields to update");
1812:     }
1813:     await prisma.collectionPaper.update({
1814:       where: { id: cpRows[0].id },
1815:       data: updateData,
1816:     });
1817:     sendSuccessResponse(res, null, "Collection paper updated successfully");
1818:   }),
1819: };
