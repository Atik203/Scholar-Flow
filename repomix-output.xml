 10: import { useRouter, useSearchParams } from "next/navigation";
 11: import { useCallback, useEffect, useRef, useState } from "react";
 12: const LOCK_KEY = "__sf_google_oauth_processing__";
 13: const tryAcquireGlobalLock = (): boolean => {
 14:   if (typeof window === "undefined") return false;
 15:   if (sessionStorage.getItem(LOCK_KEY) === "true") {
 16:     return false;
 17:   }
 18:   const globalWindow = window as typeof window & Record<string, boolean>;
 19:   if (globalWindow.__sfGoogleOAuthProcessing === true) {
 20:     return false;
 21:   }
 22:   globalWindow.__sfGoogleOAuthProcessing = true;
 23:   sessionStorage.setItem(LOCK_KEY, "true");
 24:   return true;
 25: };
 26: const releaseGlobalLock = (): void => {
 27:   if (typeof window === "undefined") return;
 28:   const globalWindow = window as typeof window & Record<string, boolean>;
 29:   delete globalWindow.__sfGoogleOAuthProcessing;
 30:   sessionStorage.removeItem(LOCK_KEY);
 31: };
