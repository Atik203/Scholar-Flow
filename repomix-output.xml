 48:       },
 49:       features,
 50:       endpoints: {
 51:         documentation: "/docs",
 52:         health: "/health",
 53:         apiBase: "/api",
 54:       },
 55:     };
 56:     res.status(200).json({
 57:       success: true,
 58:       message: "API status retrieved successfully",
