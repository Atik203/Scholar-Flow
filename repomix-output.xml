250:   }
251:   remove(key: string): void {
252:     this.cache.delete(key);
253:   }
254:   clear(): void {
255:     this.cache.clear();
256:   }
257:   cleanup(): void {
258:     const now = Date.now();
259:     for (const [key, item] of this.cache.entries()) {
260:       if (now > item.expiry) {
261:         this.cache.delete(key);
262:       }
263:     }
264:   }
265: }
266: export function useCache<T>(
267:   key: string,
268:   ttlSeconds: number = 300
269: ): [T | null, (value: T) => void, () => void] {
270:   const [cache] = useState(() => CacheStorage.getInstance());
271:   const [value, setValue] = useState<T | null>(() => cache.get<T>(key));
272:   const setCachedValue = useCallback(
273:     (newValue: T) => {
274:       cache.set(key, newValue, ttlSeconds);
275:       setValue(newValue);
276:     },
277:     [key, ttlSeconds, cache]
278:   );
279:   const removeCachedValue = useCallback(() => {
280:     cache.remove(key);
281:     setValue(null);
282:   }, [key, cache]);
283:   return [value, setCachedValue, removeCachedValue];
284: }
</file>

