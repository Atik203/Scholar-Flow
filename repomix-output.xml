 1: "use client";
 2: import { useAppSelector } from "../hooks";
 3: import {
 4:   selectAccessToken,
 5:   selectAuthLoading,
 6:   selectCurrentUser,
 7:   selectIsAuthenticated,
 8:   selectSessionToken,
 9: } from "./authSlice";
10: export function useAuth() {
11:   const user = useAppSelector(selectCurrentUser);
12:   const accessToken = useAppSelector(selectAccessToken);
13:   const sessionToken = useAppSelector(selectSessionToken);
14:   const isAuthenticated = useAppSelector(selectIsAuthenticated);
15:   const isLoading = useAppSelector(selectAuthLoading);
16:   return {
17:     user,
18:     accessToken,
19:     sessionToken,
20:     status: isLoading
21:       ? ("loading" as const)
22:       : isAuthenticated
23:         ? ("authenticated" as const)
24:         : ("unauthenticated" as const),
25:     isAuthenticated,
26:     isLoading,
27:     session: isAuthenticated && user ? { user, accessToken } : null,
28:     error: null,
29:   };
30: }
</file>

