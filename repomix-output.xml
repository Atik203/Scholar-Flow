166: function formatDate(dateString: string): string {
167:   const date = new Date(dateString);
168:   return date.toLocaleDateString("en-US", {
169:     month: "short",
170:     day: "numeric",
171:     year: "numeric",
172:   });
173: }
174: function formatRelativeTime(dateString: string): string {
175:   const date = new Date(dateString);
176:   const now = new Date();
177:   const diffMs = now.getTime() - date.getTime();
178:   const diffMins = Math.floor(diffMs / 60000);
179:   const diffHours = Math.floor(diffMs / 3600000);
180:   const diffDays = Math.floor(diffMs / 86400000);
181:   if (diffMins < 60) return `${diffMins}m ago`;
182:   if (diffHours < 24) return `${diffHours}h ago`;
183:   if (diffDays < 7) return `${diffDays}d ago`;
184:   return formatDate(dateString);
185: }
