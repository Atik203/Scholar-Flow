384:   private formatVancouver(citations: CitationData[]): string {
385:     return citations
386:       .map((citation, idx) => {
387:         const authors = citation.authors.join(", ");
388:         const title = citation.title;
389:         const journal = citation.journal || "";
390:         const year = citation.year || "n.d.";
391:         const parts: string[] = [];
392:         parts.push(`${idx + 1}. ${authors}.`);
393:         parts.push(`${title}.`);
394:         if (journal) {
395:           let j = `${journal}. ${year}`;
396:           if (citation.volume) {
397:             j += `;${citation.volume}`;
398:             if (citation.issue) j += `(${citation.issue})`;
399:           }
400:           if (citation.pages) j += `:${citation.pages}`;
401:           j += ".";
402:           parts.push(j);
403:         } else {
404:           parts.push(`${year}.`);
405:         }
406:         if (citation.doi) parts.push(`doi:${citation.doi}.`);
407:         return parts.join(" ");
408:       })
409:       .join("\n\n");
410:   }
411:   private formatACS(citations: CitationData[]): string {
412:     return citations
413:       .map((citation) => {
414:         const authors = citation.authors.join("; ");
415:         const title = citation.title;
416:         const journal = citation.journal || "";
417:         const year = citation.year || "n.d.";
418:         let acs = `${authors}. ${title}. `;
419:         if (journal) {
420:           acs += `${journal} `;
421:           if (citation.year) acs += `${year}`;
422:           if (citation.volume) acs += `, ${citation.volume}`;
423:           if (citation.issue) acs += ` (${citation.issue})`;
424:           if (citation.pages) acs += `, ${citation.pages}`;
425:           acs += ".";
426:         } else {
427:           acs += `${year}.`;
428:         }
429:         if (citation.doi) acs += ` DOI: ${citation.doi}.`;
430:         return acs;
