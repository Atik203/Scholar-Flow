<file path=".github/workflows/auto-create-pr-dev-to-main.yml">
  1: name: Auto Create Pull Request from Dev to Main
  2: on:
  3:   push:
  4:     branches:
  5:       - dev
  6: permissions:
  7:   contents: write
  8:   pull-requests: write
  9:   issues: write
 10:   actions: read
 11:   checks: read
 12:   repository-projects: write
 13: jobs:
 14:   create-pull-request:
 15:     runs-on: ubuntu-latest
 16:     steps:
 17:       - name: Checkout code
 18:         uses: actions/checkout@v4
 19:         with:
 20:           fetch-depth: 0
 21:       - name: Get commit details
 22:         id: get-commit
 23:         run: |
 24:           echo "COMMIT_MESSAGE=$(git log -1 --pretty=format:'%s')" >> $GITHUB_ENV
 25:           echo "COMMIT_AUTHOR=$(git log -1 --pretty=format:'%an')" >> $GITHUB_ENV
 26:           echo "COMMIT_URL=https://github.com/${{ github.repository }}/commit/$(git log -1 --pretty=format:'%H')" >> $GITHUB_ENV
 27:           echo "COMMIT_HASH=$(git log -1 --pretty=format:'%H')" >> $GITHUB_ENV
 28:       - name: Check if PR already exists
 29:         id: check-pr
 30:         run: |
 31:           pr_data=$(gh pr list --head dev --base main --state open --limit 1 --json number 2>/dev/null || echo "[]")
 32:           pr_number=$(echo "$pr_data" | jq -r '.[0].number // empty')
 33:           if [ -n "$pr_number" ] && [ "$pr_number" != "null" ]; then
 34:             echo "Found existing PR #$pr_number"
 35:             echo "pr_exists=true" >> $GITHUB_OUTPUT
 36:             echo "pr_number=$pr_number" >> $GITHUB_OUTPUT
 37:           else
 38:             echo "No existing PR found"
 39:             echo "pr_exists=false" >> $GITHUB_OUTPUT
 40:           fi
 41:         env:
 42:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
 43:       - name: Check for commits between branches
 44:         id: check-commits
 45:         run: |
 46:           git fetch origin main
 47:           git fetch origin dev
 48:           commits_ahead=$(git rev-list --count origin/main..origin/dev)
 49:           commits_behind=$(git rev-list --count origin/dev..origin/main)
 50:           echo "Commits ahead (dev ahead of main): $commits_ahead"
 51:           echo "Commits behind (main ahead of dev): $commits_behind"
 52:           if [ "$commits_ahead" -gt 0 ]; then
 53:             echo "has_changes=true" >> $GITHUB_OUTPUT
 54:             echo "✅ Found $commits_ahead new commits in dev branch"
 55:             echo "### New commits to be merged:" >> commit_summary.txt
 56:             git log --oneline origin/main..origin/dev >> commit_summary.txt
 57:           else
 58:             echo "has_changes=false" >> $GITHUB_OUTPUT
 59:             echo "ℹ️ No new commits found - branches are in sync"
 60:           fi
 61:       - name: Create Pull Request
 62:         if: steps.check-pr.outputs.pr_exists == 'false' && steps.check-commits.outputs.has_changes == 'true'
 63:         id: create-pr
 64:         run: |
 65:           if [ -f commit_summary.txt ]; then
 66:             commit_list=$(cat commit_summary.txt)
 67:           else
 68:             commit_list="No specific commit details available"
 69:           fi
 70:           pr_body="### Pull Request Details
 71:           **Description:** ${COMMIT_MESSAGE}
 72:           **Author:** ${COMMIT_AUTHOR}
 73:           **Source Branch:** dev
 74:           **Target Branch:** main
 75:           **Latest Commit:** [${COMMIT_HASH:0:7}](${COMMIT_URL})
 76:           ### Changes Made
 77:           ${COMMIT_MESSAGE}
 78:           ### Commits in this PR
 79:           \`\`\`
 80:           $commit_list
 81:           \`\`\`
 82:           ### Auto-Merge Status
 83:           This pull request will be automatically merged after successful checks.
 84:           ---
 85:           *Auto-generated on $(date)*"
 86:           gh pr create \
 87:             --title "Auto PR: ${COMMIT_MESSAGE}" \
 88:             --body "$pr_body" \
 89:             --head dev \
 90:             --base main \
 91:             --label "auto-generated" \
 92:             --assignee "Atik203"
 93:           echo "✅ Created new pull request"
 94:         env:
 95:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
 96:       - name: Update existing PR
 97:         if: steps.check-pr.outputs.pr_exists == 'true'
 98:         run: |
 99:           pr_body="### Pull Request Details
100:           **Description:** ${COMMIT_MESSAGE}
101:           **Author:** ${COMMIT_AUTHOR}
102:           **Source Branch:** dev
103:           **Target Branch:** main
104:           **Latest Commit:** [${COMMIT_HASH:0:7}](${COMMIT_URL})
105:           ### Changes Made
106:           ${COMMIT_MESSAGE}
107:           ### Auto-Merge Status
108:           This pull request will be automatically merged after successful checks.
109:           ---
110:           *Last updated on $(date)*"
111:           gh pr edit ${{ steps.check-pr.outputs.pr_number }} \
112:             --title "Auto PR: ${COMMIT_MESSAGE}" \
113:             --body "$pr_body"
114:           gh pr comment ${{ steps.check-pr.outputs.pr_number }} \
115:             --body "🔄 **Updated with latest changes**
116:           **New commit:** [${COMMIT_HASH:0:7}](${COMMIT_URL})
117:           **Message:** ${COMMIT_MESSAGE}
118:           **Author:** ${COMMIT_AUTHOR}"
119:           echo "✅ Updated existing pull request #${{ steps.check-pr.outputs.pr_number }}"
120:         env:
121:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
122:       - name: No changes to merge
123:         if: steps.check-commits.outputs.has_changes == 'false'
124:         run: |
125:           echo "ℹ️ **No Pull Request needed**"
126:           echo ""
127:           echo "The dev and main branches are currently in sync."
128:           echo "No new commits found in dev branch that aren't already in main."
129:           echo ""
130:           echo "This is normal after a successful merge and indicates that:"
131:           echo "- Previous PR was successfully merged"
132:           echo "- No new changes have been made to dev branch yet"
133:           echo "- Branches are properly synchronized"
134:           echo ""
135:           echo "A new PR will be created automatically when new commits are pushed to dev."
