1378:     // Get papers in collection
1379:     const paperRows = await prisma.$queryRaw<
1380:       Array<{
1381:         cp_id: string;
1382:         cp_collectionId: string;
1383:         cp_paperId: string;
1384:         cp_addedById: string;
1385:         cp_addedAt: Date;
1386:         cp_createdAt: Date;
1387:         cp_updatedAt: Date;
1388:         paper_id: string;
