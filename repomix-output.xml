      const result = await signInWithCredentials(
        data.email,
        data.password,
        dispatch
      );

      if (!result.success) {
        dismissToast(loadingToast);
        console.error("❌ Sign-in error:", result.error);
        showAuthErrorToast(result.error || "Invalid email or password");
