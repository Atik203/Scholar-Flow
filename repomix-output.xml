389:                   </div>
390:                 ) : (
391:                   <div className="space-y-3 max-h-96 overflow-y-auto">
392:                     {[...chunks]
393:                       .sort((a: PaperChunk, b: PaperChunk) => a.idx - b.idx)
394:                       .map((chunk: PaperChunk) => (
395:                         <Card key={chunk.id} className="p-4">
