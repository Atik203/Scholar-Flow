 33: import type { AppNotification, NotificationType } from "@/redux/api/notificationApi";
 34: const TYPE_ICON: Record<NotificationType, typeof Bell> = {
 35:   MENTION: AtSign,
 36:   COMMENT: MessageCircle,
 37:   SHARE: Share2,
 38:   INVITE: UserPlus,
 39:   PAPER: FileText,
 40:   COLLECTION: Archive,
 41:   ACHIEVEMENT: Star,
 42:   SYSTEM: AlertCircle,
 43: };
 44: const TYPE_COLOR: Record<NotificationType, string> = {
 45:   MENTION:
 46:     "bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400",
 47:   COMMENT:
 48:     "bg-green-100 text-green-600 dark:bg-green-900/30 dark:text-green-400",
 49:   SHARE:
 50:     "bg-purple-100 text-purple-600 dark:bg-purple-900/30 dark:text-purple-400",
 51:   INVITE:
 52:     "bg-amber-100 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400",
 53:   PAPER:
 54:     "bg-cyan-100 text-cyan-600 dark:bg-cyan-900/30 dark:text-cyan-400",
 55:   COLLECTION:
 56:     "bg-pink-100 text-pink-600 dark:bg-pink-900/30 dark:text-pink-400",
 57:   ACHIEVEMENT:
 58:     "bg-yellow-100 text-yellow-600 dark:bg-yellow-900/30 dark:text-yellow-400",
 59:   SYSTEM:
 60:     "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400",
 61: };
 62: export type ReadFilter = "ALL" | "UNREAD" | "READ";
 63: export function groupByDate(notifications: AppNotification[]) {
 64:   const groups: Record<string, AppNotification[]> = {};
 65:   for (const n of notifications) {
 66:     const date = new Date(n.createdAt);
 67:     const now = new Date();
 68:     const diffDays = Math.floor(
 69:       (now.getTime() - date.getTime()) / (1000 * 60 * 60 * 24)
 70:     );
 71:     let groupKey: string;
 72:     if (diffDays === 0) groupKey = "Today";
 73:     else if (diffDays === 1) groupKey = "Yesterday";
 74:     else if (diffDays < 7) groupKey = "This Week";
 75:     else if (diffDays < 30) groupKey = "This Month";
 76:     else groupKey = "Older";
 77:     if (!groups[groupKey]) groups[groupKey] = [];
 78:     groups[groupKey].push(n);
 79:   }
 80:   return groups;
 81: }
 82: export interface NotificationListProps {
 83:   notifications: AppNotification[];
 84:   isLoading?: boolean;
 85:   onMarkAsRead?: (id: string) => void;
 86:   onToggleStarred?: (id: string) => void;
 87:   onDelete?: (id: string) => void;
 88:   onBulkMarkAsRead?: (ids: string[]) => void;
 89:   onBulkDelete?: (ids: string[]) => void;
 90:   showFilters?: boolean;
 91:   emptyStateTitle?: string;
 92:   emptyStateMessage?: string;
 93: }
 94: export function NotificationList({
 95:   notifications,
 96:   isLoading,
 97:   onMarkAsRead,
 98:   onToggleStarred,
 99:   onDelete,
100:   onBulkMarkAsRead,
101:   onBulkDelete,
102:   showFilters = true,
103:   emptyStateTitle = "No notifications",
104:   emptyStateMessage = "You're all caught up! When you receive notifications, they will appear here.",
105: }: NotificationListProps) {
106:   const [search, setSearch] = useState("");
107:   const [typeFilter, setTypeFilter] = useState<NotificationType | "ALL">(
108:     "ALL"
109:   );
110:   const [readFilter, setReadFilter] = useState<ReadFilter>("ALL");
111:   const [selectedIds, setSelectedIds] = useState<string[]>([]);
112:   const filtered = notifications.filter((n) => {
113:     if (search) {
114:       const q = search.toLowerCase();
115:       if (
116:         !n.title.toLowerCase().includes(q) &&
117:         !n.message.toLowerCase().includes(q)
118:       ) {
119:         return false;
120:       }
121:     }
122:     if (typeFilter !== "ALL" && n.type !== typeFilter) return false;
123:     if (readFilter === "UNREAD" && n.read) return false;
124:     if (readFilter === "READ" && !n.read) return false;
125:     return true;
126:   });
127:   const grouped = groupByDate(filtered);
128:   const handleSelect = (id: string) =>
129:     setSelectedIds((prev) =>
130:       prev.includes(id) ? prev.filter((i) => i !== id) : [...prev, id]
131:     );
132:   const handleSelectAll = () => {
133:     if (selectedIds.length === filtered.length) setSelectedIds([]);
134:     else setSelectedIds(filtered.map((n) => n.id));
135:   };
136:   if (isLoading) {
137:     return (
138:       <div className="space-y-4">
