<file path="apps/backend/scripts/apply_pgvector.js">
 1: require("dotenv/config");
 2: const prisma = require("../dist/app/shared/prisma").default;
 3: async function main() {
 4:   console.log("Enabling pgvector extension...");
 5:   try {
 6:     await prisma.$executeRawUnsafe("CREATE EXTENSION IF NOT EXISTS vector");
 7:     console.log("✅ vector extension enabled");
 8:   } catch (e) {
 9:     console.error("CREATE EXTENSION vector failed:", e.message);
10:   }
11:   console.log("Adding embedding column...");
12:   try {
13:     await prisma.$executeRawUnsafe('ALTER TABLE "PaperChunk" ADD COLUMN IF NOT EXISTS embedding vector(1536)');
14:     console.log("✅ embedding column added");
15:   } catch (e) {
16:     console.error("ALTER TABLE failed:", e.message);
17:   }
18:   console.log("Creating HNSW index...");
19:   try {
20:     await prisma.$executeRawUnsafe('CREATE INDEX IF NOT EXISTS idx_paperchunk_embedding_hnsw ON "PaperChunk" USING hnsw(embedding vector_cosine_ops) WITH (m = 16, ef_construction = 64)');
21:     console.log("✅ HNSW index created");
22:   } catch (e) {
23:     console.error("CREATE INDEX failed:", e.message);
24:   }
25:   console.log("Done.");
26: }
27: main()
28:   .catch((e) => { console.error(e); process.exit(1); })
29:   .finally(() => prisma.$disconnect());
</file>

