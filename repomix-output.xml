 1: "use client";
 2: import {
 3:   showErrorToast,
 4:   showSuccessToast,
 5: } from "@/components/providers/ToastProvider";
 6: import { ImagePlusIcon } from "@/components/tiptap-icons/image-plus-icon";
 7: import { Button } from "@/components/tiptap-ui-primitive/button";
 8: import { useTiptapEditor } from "@/hooks/use-tiptap-editor";
 9: import { handleImageUpload } from "@/lib/tiptap-utils";
10: import * as React from "react";
11: export interface ResizableImageUploadButtonProps {
12:   editor?: any;
13:   text?: string;
14: }
15: export const ResizableImageUploadButton = React.forwardRef<
16:   HTMLButtonElement,
17:   ResizableImageUploadButtonProps
18: >(({ editor: providedEditor, text, ...buttonProps }, ref) => {
19:   const { editor } = useTiptapEditor(providedEditor);
20:   const fileInputRef = React.useRef<HTMLInputElement>(null);
21:   const handleClick = React.useCallback(() => {
22:     fileInputRef.current?.click();
23:   }, []);
24:   const handleFileSelect = React.useCallback(
25:     async (event: React.ChangeEvent<HTMLInputElement>) => {
26:       const file = event.target.files?.[0];
27:       if (!file || !editor) return;
28:       event.target.value = "";
29:       try {
30:         const url = await handleImageUpload(file);
31:         // Insert the image using insertContent with ResizableImage node
32:         const success = editor
33:           .chain()
34:           .focus()
35:           .insertContent({
36:             type: "image",
37:             attrs: {
38:               src: url,
39:               alt: file.name,
40:               title: file.name,
41:               width: 400,
42:               height: 300,
43:               "data-keep-ratio": true,
44:             },
45:           })
46:           .run();
47:         if (success) {
48:           showSuccessToast("Image uploaded successfully!");
49:         } else {
50:           showErrorToast(
51:             "Failed to insert image",
52:             "Could not insert image into editor"
53:           );
54:         }
55:       } catch (error) {
56:         console.error("Upload failed:", error);
57:         showErrorToast(
58:           "Image upload failed",
59:           error instanceof Error ? error.message : "Unknown error"
60:         );
61:       }
62:     },
63:     [editor]
64:   );
65:   const canInsert = editor?.can?.().insertContent?.({ type: "image" }) ?? false;
66:   if (!editor?.isEditable) {
67:     return null;
68:   }
69:   return (
70:     <>
71:       <Button
72:         type="button"
73:         data-style="ghost"
74:         role="button"
75:         tabIndex={-1}
76:         disabled={!canInsert}
77:         data-disabled={!canInsert}
78:         aria-label="Upload image"
79:         tooltip="Upload image"
80:         onClick={handleClick}
81:         {...buttonProps}
82:         ref={ref}
83:       >
84:         <ImagePlusIcon className="tiptap-button-icon" />
85:         {text && <span className="tiptap-button-text">{text}</span>}
86:       </Button>
87:       <input
88:         ref={fileInputRef}
89:         type="file"
90:         accept="image/*"
91:         style={{ display: "none" }}
92:         onChange={handleFileSelect}
93:       />
94:     </>
95:   );
96: });
97: ResizableImageUploadButton.displayName = "ResizableImageUploadButton";
</file>

