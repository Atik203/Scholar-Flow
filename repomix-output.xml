 78:   paperTitle?: string;
 79: }
 80: export const AiSummaryPanel = ({
 81:   paperId,
 82:   paperTitle,
 83: }: AiSummaryPanelProps) => {
 84:   const aiEnabled = useMemo(
 85:     () => process.env.NEXT_PUBLIC_AI_ASSISTANT_ENABLED !== "false",
 86:     []
 87:   );
 88:   const [summary, setSummary] = useState<PaperSummaryResponse | null>(null);
 89:   const [lastRequest, setLastRequest] =
 90:     useState<PaperSummaryRequest>(DEFAULT_OPTIONS);
 91:   const [isSettingsOpen, setIsSettingsOpen] = useState(false);
 92:   const [hasAttemptedInitialLoad, setHasAttemptedInitialLoad] = useState(false);
 93:   const [focusDraft, setFocusDraft] = useState("");
 94:   const [generateSummary, generateState] = useGeneratePaperSummaryMutation();
 95:   useMutationErrorHandler(generateState, undefined, { showToast: true });
 96:   const form = useForm<GenerateSummaryFormInput>({
 97:     resolver: zodResolver(aiSchemas.generateSummary),
 98:     defaultValues: {
 99:       instructions: "",
100:       focusAreas: [],
101:       tone: DEFAULT_OPTIONS.tone,
102:       audience: DEFAULT_OPTIONS.audience,
103:       language: "",
104:       wordLimit: DEFAULT_OPTIONS.wordLimit,
105:       refresh: false,
106:     },
107:   });
108:   const focusAreas = form.watch("focusAreas") || [];
109:   const applyFocusArea = () => {
110:     const trimmed = focusDraft.trim();
111:     if (!trimmed) {
112:       return;
113:     }
114:     if (focusAreas.includes(trimmed)) {
115:       showErrorToast("Focus area already added");
116:       setFocusDraft("");
117:       return;
118:     }
119:     if (focusAreas.length >= MAX_FOCUS_AREAS) {
120:       showErrorToast(`You can only add up to ${MAX_FOCUS_AREAS} focus areas`);
121:       return;
122:     }
123:     const nextFocusAreas = [...focusAreas, trimmed];
124:     form.setValue("focusAreas", nextFocusAreas, {
125:       shouldDirty: true,
126:       shouldValidate: true,
127:       shouldTouch: true,
128:     });
129:     setFocusDraft("");
130:   };
131:   const removeFocusArea = (value: string) => {
132:     const nextFocusAreas = focusAreas.filter((item) => item !== value);
133:     form.setValue("focusAreas", nextFocusAreas, {
134:       shouldDirty: true,
135:       shouldValidate: true,
136:       shouldTouch: true,
137:     });
138:   };
139:   const runSummary = async (input: PaperSummaryRequest) => {
140:     try {
141:       const result = await generateSummary({ paperId, input }).unwrap();
142:       setSummary(result);
