386:         JOIN "User" u ON s."userId" = u.id
387:         JOIN "Plan" p ON s."planId" = p.id
388:         WHERE s."isDeleted" = false
389:           AND u."isDeleted" = false
390:           AND s."planId" = ${planId}
391:         ORDER BY s."createdAt" DESC
392:         LIMIT ${limit}
393:         OFFSET ${offset}
394:       `;
