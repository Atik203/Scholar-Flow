525:   private static convertToCSV(entries: ActivityLogEntry[]): string {
526:     const headers = [
527:       'Timestamp',
528:       'User',
529:       'Workspace',
530:       'Entity',
531:       'Entity ID',
532:       'Action',
533:       'Severity',
534:       'Details'
535:     ];
536:     const rows = entries.map(entry => [
537:       entry.createdAt.toISOString(),
538:       entry.user ? `${entry.user.firstName || ''} ${entry.user.lastName || ''}`.trim() || entry.user.name || 'Unknown' : 'System',
539:       entry.workspace?.name || 'N/A',
540:       entry.entity,
541:       entry.entityId,
542:       entry.action,
543:       entry.severity,
544:       entry.details ? JSON.stringify(entry.details) : ''
545:     ]);
546:     const csvContent = [headers, ...rows]
547:       .map(row => row.map(cell => `"${cell}"`).join(','))
548:       .join('\n');
549:     return csvContent;
550:   }
