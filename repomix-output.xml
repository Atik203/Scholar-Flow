763:   static async resendInvitation(inviterId: string, invitationId: string) {
764:     const invite = await prisma.workspaceInvitation.findUnique({
765:       where: { id: invitationId },
766:     });
767:     if (!invite) throw new ApiError(404, "Invitation not found");
768:     if (invite.invitedById !== inviterId) {
769:       throw new ApiError(403, "You can only resend invitations you sent");
770:     }
771:     if (invite.status !== "PENDING") {
772:       throw new ApiError(400, "Only pending invitations can be resent");
773:     }
774:     await prisma.workspaceInvitation.update({
775:       where: { id: invitationId },
776:       data: { invitedAt: new Date() },
777:     });
778:     try {
779:       const { default: emailService } = await import("../../shared/emailService");
780:       const [inviter, invitee, workspace] = await Promise.all([
781:         prisma.user.findUnique({ where: { id: inviterId }, select: { name: true, email: true } }),
782:         prisma.user.findUnique({ where: { id: invite.userId }, select: { email: true, name: true, firstName: true, lastName: true } }),
783:         prisma.workspace.findUnique({ where: { id: invite.workspaceId }, select: { name: true } }),
784:       ]);
785:       if (invitee && inviter && workspace) {
786:         await emailService.sendTeamInvitationEmail({
787:           email: invitee.email,
788:           name: invitee.name || `${invitee.firstName || ""} ${invitee.lastName || ""}`.trim() || invitee.email,
789:           teamName: workspace.name,
790:           inviterName: inviter.name || inviter.email,
791:           role: invite.role,
792:           invitationId: invite.id,
793:         });
794:       }
795:     } catch (err) {
796:       if (process.env.NODE_ENV !== "production") {
797:         console.error("Resend team invitation email failed:", (err as any)?.message || err);
798:       }
799:     }
800:     try {
801:       await notificationService.createNotification({
802:         userId: invite.userId,
803:         type: "INVITE",
804:         category: "TEAM",
805:         title: "Invitation reminder",
806:         message:
807:           "Your team invitation is still pending. Accept or decline it from your invitations.",
808:         actionUrl: "/dashboard/team/invitations",
809:         actorId: inviterId,
810:         resourceId: invite.id,
811:       });
812:     } catch {
813:     }
814:     return { success: true };
815:   }
