 14: import { useCreateCitationMutation, useGetManagerViewQuery } from "@/redux/api/citationApi";
 15: import type { CitationPaper } from "@/redux/api/citationApi";
 16: import type { Editor } from "@tiptap/core";
 17: import { Bookmark, Plus, Search } from "lucide-react";
 18: import { useEffect, useMemo, useState } from "react";
 19: import { cn } from "@/lib/utils";
 20: interface CitationSearchDialogProps {
 21:   open: boolean;
 22:   onOpenChange: (open: boolean) => void;
 23:   editor: Editor | null;
 24:   sourcePaperId: string;
 25:   existingPaperIds: string[];
 26: }
 27: function formatAuthorShort(paper: CitationPaper): string {
 28:   const authors = paper.authors ?? [];
 29:   if (!authors.length) return "Unknown";
 30:   if (authors.length === 1) return authors[0].split(" ").pop() || authors[0];
 31:   return `${authors[0].split(" ").pop() || authors[0]} et al.`;
 32: }
 33: export function CitationSearchDialog({
 34:   open,
 35:   onOpenChange,
 36:   editor,
 37:   sourcePaperId,
 38:   existingPaperIds,
 39: }: CitationSearchDialogProps) {
 40:   const [search, setSearch] = useState("");
 41:   const [debounced, setDebounced] = useState("");
 42:   const [inserting, setInserting] = useState(false);
 43:   const [createCitation] = useCreateCitationMutation();
 44:   useEffect(() => {
 45:     const t = setTimeout(() => setDebounced(search), 300);
 46:     return () => clearTimeout(t);
 47:   }, [search]);
 48:   const { data, isLoading } = useGetManagerViewQuery({
 49:     search: debounced || undefined,
 50:     limit: 20,
 51:   });
 52:   const papers = useMemo(() => data?.data?.papers ?? [], [data]);
 53:   const handleInsert = async (paper: CitationPaper) => {
 54:     if (!editor) return;
 55:     setInserting(true);
 56:     // Persist the citation edge first so the citation graph and export stay in
 57:     // sync with what the editor renders.
 58:     try {
 59:       await createCitation({
 60:         sourcePaperId,
 61:         targetPaperId: paper.id,
 62:         location: "editor",
 63:       }).unwrap();
 64:     } catch (err: any) {
 65:       showErrorToast(err?.data?.message || "Failed to save citation");
 66:       setInserting(false);
 67:       return;
 68:     }
 69:     const authorsStr = (paper.authors ?? []).join("; ");
 70:     const yearStr = paper.year?.toString() ?? "";
 71:     const citationNumber = existingPaperIds.length + 1;
 72:     editor
 73:       .chain()
 74:       .focus()
 75:       .insertContent({
 76:         type: "citation",
 77:         attrs: {
 78:           paperId: paper.id,
 79:           title: paper.title,
 80:           authors: authorsStr,
 81:           year: yearStr,
 82:           citationNumber,
 83:         },
 84:       })
 85:       .run();
 86:     setInserting(false);
 87:     onOpenChange(false);
 88:   };
 89:   return (
 90:     <Dialog open={open} onOpenChange={onOpenChange}>
 91:       <DialogContent className="max-w-md max-h-[80vh] overflow-y-auto">
 92:         <DialogHeader>
 93:           <DialogTitle>Insert Citation</DialogTitle>
 94:           <DialogDescription>
 95:             Search your papers to insert a citation at the cursor position.
 96:           </DialogDescription>
 97:         </DialogHeader>
 98:         <div className="relative">
 99:           <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
100:           <Input
101:             placeholder="Search by title, author, or year..."
102:             value={search}
103:             onChange={(e) => setSearch(e.target.value)}
104:             className="pl-9"
105:             autoFocus
106:           />
107:         </div>
108:         <ScrollArea className="max-h-[50vh]">
109:           {isLoading ? (
110:             <div className="space-y-2 p-1">
111:               {Array.from({ length: 5 }).map((_, i) => (
112:                 <Skeleton key={i} className="h-16 w-full" />
113:               ))}
114:             </div>
115:           ) : papers.length === 0 ? (
116:             <p className="text-sm text-muted-foreground text-center py-8">
117:               No papers found. Try a different search.
118:             </p>
119:           ) : (
120:             <div className="space-y-1">
121:               {papers.map((paper: CitationPaper) => {
122:                 const alreadyCited = existingPaperIds.includes(paper.id);
123:                 return (
124:                   <button
125:                     key={paper.id}
126:                     onClick={() => void handleInsert(paper)}
127:                     disabled={alreadyCited || inserting}
128:                     className={cn(
129:                       "w-full text-left p-3 rounded-lg border hover:bg-accent transition-colors",
130:                       alreadyCited
131:                         ? "border-primary/30 bg-primary/5 opacity-60 cursor-not-allowed"
132:                         : "hover:border-primary/30"
133:                     )}
134:                   >
135:                     <div className="flex items-start justify-between gap-2">
136:                       <div className="min-w-0 flex-1">
137:                         <p className="text-sm font-medium truncate">{paper.title}</p>
138:                         <p className="text-xs text-muted-foreground mt-0.5">
139:                           {formatAuthorShort(paper)}
140:                           {paper.year && ` (${paper.year})`}
141:                           {paper.journal && ` — ${paper.journal}`}
142:                         </p>
143:                       </div>
144:                       {alreadyCited ? (
145:                         <Bookmark className="h-4 w-4 text-primary flex-shrink-0 mt-0.5" />
146:                       ) : (
147:                         <Plus className="h-4 w-4 text-muted-foreground flex-shrink-0 mt-0.5" />
148:                       )}
149:                     </div>
150:                   </button>
151:                 );
152:               })}
153:             </div>
154:           )}
155:         </ScrollArea>
156:       </DialogContent>
157:     </Dialog>
158:   );
159: }
</file>

