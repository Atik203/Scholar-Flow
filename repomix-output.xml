 21: export class CollectionService {
 22:   static async getCollectionStats(userId: string) {
 23:     try {
 24:       const stats = await prisma.$queryRaw<
 25:         Array<{
 26:           totalCollections: number;
 27:           publicCollections: number;
 28:           privateCollections: number;
 29:           avgPapersPerCollection: number;
 30:         }>
 31:       >`
 32:         WITH accessible AS (
 33:           SELECT c.id, c."isPublic", c.visibility
 34:           FROM "Collection" c
 35:           LEFT JOIN "CollectionMember" cm
 36:             ON c.id = cm."collectionId" AND cm."isDeleted" = false
 37:           WHERE c."isDeleted" = false
 38:             AND (
 39:               c."ownerId" = ${userId}
 40:               OR (cm."userId" = ${userId} AND cm.status = 'ACCEPTED')
 41:             )
 42:           GROUP BY c.id
 43:         )
 44:         SELECT
 45:           COUNT(*)::int as "totalCollections",
 46:           COUNT(CASE WHEN a."isPublic" = true OR a.visibility = 'PUBLIC' THEN 1 END)::int as "publicCollections",
 47:           COUNT(CASE WHEN a."isPublic" = false AND a.visibility <> 'PUBLIC' THEN 1 END)::int as "privateCollections",
 48:           COALESCE(AVG(paper_counts.paper_count), 0)::float as "avgPapersPerCollection"
 49:         FROM accessible a
 50:         LEFT JOIN (
 51:           SELECT "collectionId", COUNT(*) as paper_count
 52:           FROM "CollectionPaper"
 53:           WHERE "isDeleted" = false
 54:           GROUP BY "collectionId"
 55:         ) paper_counts ON a.id = paper_counts."collectionId"
 56:       `;
 57:       return (
 58:         stats[0] || {
 59:           totalCollections: 0,
 60:           publicCollections: 0,
 61:           privateCollections: 0,
 62:           avgPapersPerCollection: 0,
 63:         }
 64:       );
 65:     } catch (error) {
 66:       console.error("Error getting collection stats:", error);
 67:       throw error;
 68:     }
