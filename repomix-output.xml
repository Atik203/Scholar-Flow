191: function formatRelativeTime(dateString: string): string {
192:   const date = new Date(dateString);
193:   const now = new Date();
194:   const diffMs = now.getTime() - date.getTime();
195:   const diffMins = Math.floor(diffMs / 60000);
196:   const diffHours = Math.floor(diffMs / 3600000);
197:   const diffDays = Math.floor(diffMs / 86400000);
198:   if (diffMins < 60) return `${diffMins}m ago`;
199:   if (diffHours < 24) return `${diffHours}h ago`;
200:   if (diffDays < 7) return `${diffDays}d ago`;
201:   return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
202: }
