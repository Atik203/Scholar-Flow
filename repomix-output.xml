<file path="apps/backend/prisma/schema.prisma">
   1: generator client {
   2:   provider        = "prisma-client"
   3:   output          = "../src/generated/prisma"
   4:   previewFeatures = ["typedSql"]
   5: }
   6: 
   7: datasource db {
   8:   provider = "postgresql"
   9: }
  10: 
  11: enum Role {
  12:   RESEARCHER
  13:   PRO_RESEARCHER
  14:   TEAM_LEAD
  15:   ADMIN
  16: }
  17: 
  18: // Workspace-level roles (separate from global application Role)
  19: // These describe what a user can do WITHIN a specific workspace.
  20: enum WorkspaceRole {
  21:   VIEWER // Read-only access to workspace content
  22:   EDITOR // Can create/edit papers and collections in workspace
  23:   MANAGER // Can invite/remove members, manage workspace settings
  24:   OWNER // Full control, can delete workspace and transfer ownership
  25: }
  26: 
  27: // Workspace visibility for figma-make UI (Phase 5)
  28: enum WorkspaceVisibility {
  29:   PRIVATE // Only members can see this workspace
  30:   INVITE_ONLY // Join by invitation only
  31:   PUBLIC // Anyone with a link can see this workspace
  32: }
  33: 
  34: enum CollectionPermission {
  35:   VIEW // Read-only access - can view collection and papers
  36:   EDIT // Full access - can edit, add/remove papers, delete collection
  37: }
  38: 
  39: // Collection visibility for figma-make UI (replaces boolean isPublic in Phase 4 subtask B)
  40: enum CollectionVisibility {
  41:   PRIVATE // Only the owner can see this collection
  42:   TEAM // Anyone in the workspace can see this collection
  43:   PUBLIC // Anyone with a link can see this collection
  44: }
  45: 
  46: // Reading status of a paper within a specific collection (figma-make design)
  47: enum CollectionPaperStatus {
  48:   TO_READ
  49:   READING
  50:   COMPLETED
  51:   ARCHIVED
  52: }
  53: 
  54: // Phase 6 - Note type (matches figma ResearchNotesPage type filter)
  55: enum NoteType {
  56:   QUICK
  57:   LITERATURE
  58:   METHODOLOGY
  59:   FINDINGS
  60:   IDEA
  61: }
  62: 
  63: // Phase 6 - Note visibility (matches figma visibility pills: Private / Workspace / Public)
  64: enum NoteVisibility {
  65:   PRIVATE
  66:   WORKSPACE
  67:   PUBLIC
  68: }
  69: 
  70: enum AnnotationType {
  71:   HIGHLIGHT // Yellow highlight over text
  72:   UNDERLINE // Underline text
  73:   STRIKETHROUGH // Strike through text
  74:   AREA // Rectangle/area selection
  75:   COMMENT // Blue comment bubble
  76:   NOTE // Green sticky note
  77:   INK // Freehand drawing/ink annotation
  78: }
  79: 
  80: enum PaymentProvider {
  81:   STRIPE
  82:   SSLCOMMERZ
  83: }
  84: 
  85: enum PaymentStatus {
  86:   PENDING
  87:   SUCCEEDED
  88:   FAILED
  89:   REFUNDED
  90: }
  91: 
  92: enum SubscriptionStatus {
  93:   ACTIVE
  94:   EXPIRED
  95:   CANCELED
  96:   PAST_DUE
  97: }
  98: 
  99: enum PlanTier {
 100:   FREE
 101:   PRO
 102:   INSTITUTIONAL
 103: }
 104: 
 105: enum PaperProcessingStatus {
 106:   UPLOADED // File record created, extraction not started yet
 107:   PROCESSING // Extraction & chunking in progress
 108:   PROCESSED // All chunks stored successfully
 109:   FAILED // Processing failed; see processingError
 110: }
 111: 
 112: enum NotificationType {
 113:   MENTION
 114:   COMMENT
 115:   SHARE
 116:   INVITE
 117:   PAPER
 118:   COLLECTION
 119:   SYSTEM
 120:   ACHIEVEMENT
 121: }
 122: 
 123: model Notification {
 124:   id        String           @id @default(uuid())
 125:   userId    String // The user receiving the notification
 126:   type      NotificationType
 127:   title     String
 128:   message   String
 129:   read      Boolean          @default(false)
 130:   starred   Boolean          @default(false)
 131:   actionUrl String?
 132: 
 133:   // Optional relations for context (actor and resource)
 134:   actorId    String? // User who triggered it
 135:   resourceId String? // ID of related entity (paperId, workspaceId, etc)
 136:   createdAt  DateTime @default(now())
 137: 
 138:   user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
 139:   actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
 140: 
 141:   @@index([userId, read])
 142:   @@index([createdAt])
 143: }
 144: 
 145: model User {
 146:   id                     String    @id @default(uuid())
 147:   email                  String    @unique
 148:   name                   String?
 149:   firstName              String?
 150:   lastName               String?
 151:   institution            String?
 152:   fieldOfStudy           String?
 153:   image                  String?
 154:   password               String? // Optional password for demo/test users
 155:   role                   Role      @default(RESEARCHER)
 156:   emailVerified          DateTime? // When email was verified
 157:   emailVerificationToken String? // For email verification
 158: 
 159:   // Onboarding flow fields (Phase 2)
 160:   onboardingCompleted Boolean @default(false)
 161:   onboardingStep      Int     @default(0)
 162: 
 163:   // Stripe subscription fields
 164:   stripeCustomerId       String?   @unique
 165:   stripeSubscriptionId   String?   @unique
 166:   stripePriceId          String? // The price ID of the current subscription
