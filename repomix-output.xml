<file path="apps/backend/src/app/modules/Notification/broadcast.ts">
 1: import { EventEmitter } from "events";
 2: import type { Response } from "express";
 3: export interface SseEvent<T = unknown> {
 4:   type: string;
 5:   data: T;
 6:   id?: string;
 7:   ts: number;
 8: }
 9: const CHANNEL = "scholarflow:notifications";
10: const MAX_CONNECTIONS_PER_USER = 5;
11: class NotificationBroadcaster {
12:   private readonly emitter = new EventEmitter();
13:   private readonly connectionsByUser = new Map<string, Set<Response>>();
14:   constructor() {
15:     this.emitter.setMaxListeners(0);
16:   }
17:   subscribe(userId: string, res: Response): () => void {
18:     let connections = this.connectionsByUser.get(userId);
19:     if (!connections) {
20:       connections = new Set();
21:       this.connectionsByUser.set(userId, connections);
22:     }
23:     if (connections.size >= MAX_CONNECTIONS_PER_USER) {
24:       const oldest = connections.values().next().value as Response | undefined;
25:       if (oldest) {
26:         try {
27:           oldest.end();
28:         } catch {
29:         }
30:         connections.delete(oldest);
31:       }
32:     }
33:     connections.add(res);
34:     const localListener = (event: SseEvent) => {
35:       this.writeEvent(res, event);
36:     };
37:     const userChannel = `${CHANNEL}:${userId}`;
38:     this.emitter.on(userChannel, localListener);
39:     return () => {
40:       this.emitter.off(userChannel, localListener);
41:       const set = this.connectionsByUser.get(userId);
42:       if (set) {
43:         set.delete(res);
44:         if (set.size === 0) {
45:           this.connectionsByUser.delete(userId);
46:         }
47:       }
48:     };
49:   }
50:   publish(userId: string, event: Omit<SseEvent, "ts">): void {
51:     const payload: SseEvent = { ...event, ts: Date.now() };
52:     this.emitter.emit(`${CHANNEL}:${userId}`, payload);
53:   }
54:   private writeEvent(res: Response, event: SseEvent): void {
55:     try {
56:       const lines: string[] = [];
57:       if (event.id) lines.push(`id: ${event.id}`);
58:       lines.push(`event: ${event.type}`);
59:       lines.push(`data: ${JSON.stringify(event.data)}`);
60:       lines.push("");
61:       lines.push("");
62:       res.write(lines.join("\n"));
63:     } catch {
64:     }
65:   }
66: }
67: export const notificationBroadcaster = new NotificationBroadcaster();
68: export default notificationBroadcaster;
</file>

