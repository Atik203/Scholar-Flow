  6: import type {
  7:   BaseQueryFn,
  8:   FetchArgs,
  9:   FetchBaseQueryMeta,
 10: } from "@reduxjs/toolkit/query";
 11: import type { RootState } from "../store";
 12: import { API_BASE_URL } from "@/lib/apiUrl";
 13: let sessionExpiryRedirected = false;
 14: async function handleSessionExpired(): Promise<void> {
 15:   if (sessionExpiryRedirected || typeof window === "undefined") return;
 16:   sessionExpiryRedirected = true;
 17:   try {
 18:     const { handleSignOut } = await import("@/lib/auth/signout");
 19:     await handleSignOut("/login");
 20:   } catch {
 21:     try {
 22:       const { resetAppState } = await import("@/redux/storeAccess");
 23:       resetAppState();
 24:     } catch {
 25:     }
 26:     if (typeof window !== "undefined") {
 27:       window.location.replace("/login");
 28:     }
 29:   }
 30: }
 31: type ApiBaseQuery = BaseQueryFn<
 32:   string | FetchArgs,
 33:   unknown,
 34:   FetchBaseQueryError,
 35:   object,
 36:   FetchBaseQueryMeta
 37: >;
 38: const baseQueryWithAuth: ApiBaseQuery = async (args, api, extraOptions) => {
 39:   const result = await baseQuery(args, api, extraOptions);
 40:   if (result.error && result.error.status === 401) {
 41:     const state = api.getState() as RootState;
 42:     if (state?.auth?.accessToken) {
 43:       void handleSessionExpired();
 44:     }
 45:   }
 46:   return result;
 47: };
 48: export interface ApiErrorResponse {
 49:   success: false;
 50:   message: string;
 51:   statusCode: number;
 52:   errorCode?: string;
 53:   details?: Record<string, any>;
 54:   timestamp?: string;
 55: }
 56: const transformErrorResponse = (
 57:   response: FetchBaseQueryError
 58: ): ApiErrorResponse => {
 59:   if ("data" in response && response.data) {
 60:     const apiError = response.data as ApiErrorResponse;
 61:     return {
 62:       success: false,
 63:       message: apiError.message || "An error occurred",
 64:       statusCode: response.status as number,
 65:       errorCode: apiError.errorCode,
 66:       details: apiError.details,
 67:       timestamp: apiError.timestamp || new Date().toISOString(),
 68:     };
 69:   }
 70:   if ("error" in response) {
 71:     return {
 72:       success: false,
 73:       message: response.error,
 74:       statusCode: 0,
 75:       errorCode: "NETWORK_ERROR",
 76:       timestamp: new Date().toISOString(),
 77:     };
 78:   }
 79:   return {
 80:     success: false,
 81:     message: `Request failed with status ${response.status}`,
 82:     statusCode: response.status as number,
 83:     errorCode: "UNKNOWN_ERROR",
 84:     timestamp: new Date().toISOString(),
 85:   };
 86: };
 87: const baseQuery = fetchBaseQuery({
 88:   baseUrl: API_BASE_URL,
 89:   prepareHeaders: (headers, { getState, endpoint }) => {
 90:     const token = (getState() as RootState).auth.accessToken;
 91:     if (token) {
 92:       headers.set("authorization", `Bearer ${token}`);
 93:     } else if (process.env.NODE_ENV !== "production") {
 94:       console.warn(
 95:         `[apiSlice] No accessToken for endpoint: ${String(endpoint)}`
 96:       );
 97:     }
 98:     return headers;
 99:   },
100: });
