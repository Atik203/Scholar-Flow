          ${permission ?? "EDIT"}::"CollectionPermission",
          'PENDING'::"MembershipStatus",
          ${inviterId},
          NOW(),
          NOW(),
          NOW(),
          false
        )
        RETURNING id
      `;

      memberId = insertedRows[0]?.id;
    }

    // Send invitation email (best-effort)
    try {
      const inviterRows = await prisma.$queryRaw<
        Array<{ name: string | null; email: string | null }>
      >`
        SELECT name, email
        FROM "User"
