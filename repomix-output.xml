  1: import { mergeAttributes, Node } from "@tiptap/core";
  2: export interface ResizableImageOptions {
  3:   inline: boolean;
  4:   HTMLAttributes: Record<string, any>;
  5: }
  6: declare module "@tiptap/core" {
  7:   interface Commands<ReturnType> {
  8:     resizableImage: {
  9:       setResizableImage: (options: {
 10:         src: string;
 11:         alt?: string;
 12:         title?: string;
 13:         width?: number;
 14:         height?: number;
 15:       }) => ReturnType;
 16:     };
 17:   }
 18: }
 19: export const ResizableImage = Node.create<ResizableImageOptions>({
 20:   name: "resizableImage",
 21:   addOptions() {
 22:     return {
 23:       inline: false,
 24:       HTMLAttributes: {},
 25:     };
 26:   },
 27:   inline() {
 28:     return this.options.inline;
 29:   },
 30:   group() {
 31:     return this.options.inline ? "inline" : "block";
 32:   },
 33:   draggable: true,
 34:   addAttributes() {
 35:     return {
 36:       src: {
 37:         default: null,
 38:         parseHTML: (element) => element.getAttribute("src"),
 39:         renderHTML: (attributes) => {
 40:           if (!attributes.src) {
 41:             return {};
 42:           }
 43:           return {
 44:             src: attributes.src,
 45:           };
 46:         },
 47:       },
 48:       alt: {
 49:         default: null,
 50:         parseHTML: (element) => element.getAttribute("alt"),
 51:         renderHTML: (attributes) => {
 52:           if (!attributes.alt) {
 53:             return {};
 54:           }
 55:           return {
 56:             alt: attributes.alt,
 57:           };
 58:         },
 59:       },
 60:       title: {
 61:         default: null,
 62:         parseHTML: (element) => element.getAttribute("title"),
 63:         renderHTML: (attributes) => {
 64:           if (!attributes.title) {
 65:             return {};
 66:           }
 67:           return {
 68:             title: attributes.title,
 69:           };
 70:         },
 71:       },
 72:       width: {
 73:         default: null,
 74:         parseHTML: (element) => {
 75:           const width = element.getAttribute("width") || element.style.width;
 76:           return width ? parseInt(width, 10) : null;
 77:         },
 78:         renderHTML: (attributes) => {
 79:           if (!attributes.width) {
 80:             return {};
 81:           }
 82:           return {
 83:             width: attributes.width,
 84:             style: `width: ${attributes.width}px`,
 85:           };
 86:         },
 87:       },
 88:       height: {
 89:         default: null,
 90:         parseHTML: (element) => {
 91:           const height = element.getAttribute("height") || element.style.height;
 92:           return height ? parseInt(height, 10) : null;
 93:         },
 94:         renderHTML: (attributes) => {
 95:           if (!attributes.height) {
 96:             return {};
 97:           }
 98:           return {
 99:             height: attributes.height,
100:             style: `height: ${attributes.height}px`,
101:           };
102:         },
103:       },
104:     };
105:   },
106:   parseHTML() {
107:     return [
108:       {
109:         tag: "img[src]",
110:       },
111:     ];
112:   },
113:   renderHTML({ HTMLAttributes }) {
114:     return [
115:       "img",
116:       mergeAttributes(this.options.HTMLAttributes, HTMLAttributes),
117:     ];
118:   },
119:   addCommands() {
120:     return {
121:       setResizableImage:
122:         (options) =>
123:         ({ commands }) => {
124:           return commands.insertContent({
125:             type: this.name,
126:             attrs: options,
127:           });
128:         },
129:     };
130:   },
131: });
132: export default ResizableImage;
</file>

