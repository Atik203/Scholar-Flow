  1: import prisma from "../../shared/prisma";
  2: type TimeRange = "week" | "month" | "quarter" | "year";
  3: const rangeToDays: Record<TimeRange, number> = {
  4:   week: 7,
  5:   month: 30,
  6:   quarter: 90,
  7:   year: 365,
  8: };
  9: interface AiUsageSummary {
 10:   totalTokens: number;
 11:   totalCostCents: number;
 12:   totalMessages: number;
 13:   byModel: Array<{
 14:     model: string;
 15:     tokens: number;
 16:     costCents: number;
 17:     messages: number;
 18:   }>;
 19:   dailyUsage: Array<{
 20:     date: string;
 21:     tokens: number;
 22:     costCents: number;
 23:     messages: number;
 24:   }>;
 25:   timeRange: TimeRange;
 26: }
 27: export const aiUsageService = {
 28:   async getAiUsage(userId: string, timeRange: TimeRange = "month"): Promise<AiUsageSummary> {
 29:     const days = rangeToDays[timeRange];
 30:     const since = new Date(Date.now() - days * 24 * 60 * 60 * 1000);
 31:     const messages = await prisma.aIConversationMessage.findMany({
 32:       where: {
 33:         role: "assistant",
 34:         tokensUsed: { not: null },
 35:         conversation: { userId },
 36:         createdAt: { gte: since },
 37:       },
 38:       select: {
 39:         tokensUsed: true,
 40:         costCents: true,
 41:         model: true,
 42:         createdAt: true,
 43:       },
 44:       orderBy: { createdAt: "asc" },
 45:     });
 46:     const totalTokens = messages.reduce((s, m) => s + (m.tokensUsed ?? 0), 0);
 47:     const totalCostCents = messages.reduce((s, m) => s + (m.costCents ?? 0), 0);
 48:     const byModelMap = new Map<string, { tokens: number; costCents: number; messages: number }>();
 49:     const dayMap = new Map<string, { tokens: number; costCents: number; messages: number }>();
 50:     for (const m of messages) {
 51:       const model = m.model ?? "unknown";
 52:       const entry = byModelMap.get(model) ?? { tokens: 0, costCents: 0, messages: 0 };
 53:       entry.tokens += m.tokensUsed ?? 0;
 54:       entry.costCents += m.costCents ?? 0;
 55:       entry.messages += 1;
 56:       byModelMap.set(model, entry);
 57:       const day = m.createdAt.toISOString().split("T")[0];
 58:       const dayEntry = dayMap.get(day) ?? { tokens: 0, costCents: 0, messages: 0 };
 59:       dayEntry.tokens += m.tokensUsed ?? 0;
 60:       dayEntry.costCents += m.costCents ?? 0;
 61:       dayEntry.messages += 1;
 62:       dayMap.set(day, dayEntry);
 63:     }
 64:     const byModel = Array.from(byModelMap.entries())
 65:       .map(([model, v]) => ({ model, ...v }))
 66:       .sort((a, b) => b.costCents - a.costCents);
 67:     const dailyUsage = Array.from(dayMap.entries())
 68:       .sort(([a], [b]) => a.localeCompare(b))
 69:       .map(([date, v]) => ({ date, ...v }));
 70:     return {
 71:       totalTokens,
 72:       totalCostCents,
 73:       totalMessages: messages.length,
 74:       byModel,
 75:       dailyUsage,
 76:       timeRange,
 77:     };
 78:   },
 79:   async getAdminAiUsage(timeRange: TimeRange = "month") {
 80:     const days = rangeToDays[timeRange];
 81:     const since = new Date(Date.now() - days * 24 * 60 * 60 * 1000);
 82:     const messages = await prisma.aIConversationMessage.findMany({
 83:       where: {
 84:         role: "assistant",
 85:         tokensUsed: { not: null },
 86:         createdAt: { gte: since },
 87:       },
 88:       select: {
 89:         tokensUsed: true,
 90:         costCents: true,
 91:         model: true,
 92:         conversation: { select: { userId: true } },
 93:       },
 94:     });
 95:     const totalTokens = messages.reduce((s, m) => s + (m.tokensUsed ?? 0), 0);
 96:     const totalCostCents = messages.reduce((s, m) => s + (m.costCents ?? 0), 0);
 97:     const byUserMap = new Map<string, { tokens: number; costCents: number; messages: number }>();
 98:     for (const m of messages) {
 99:       const uid = m.conversation.userId;
100:       const entry = byUserMap.get(uid) ?? { tokens: 0, costCents: 0, messages: 0 };
101:       entry.tokens += m.tokensUsed ?? 0;
102:       entry.costCents += m.costCents ?? 0;
103:       entry.messages += 1;
104:       byUserMap.set(uid, entry);
105:     }
106:     const byUser = Array.from(byUserMap.entries())
107:       .map(([userId, v]) => ({ userId, ...v }))
108:       .sort((a, b) => b.costCents - a.costCents)
109:       .slice(0, 20);
110:     return {
111:       totalTokens,
112:       totalCostCents,
113:       totalMessages: messages.length,
114:       byUser,
115:     };
116:   },
117: };
