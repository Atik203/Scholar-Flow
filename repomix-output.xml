434:         JOIN "Plan" p ON s."planId" = p.id
435:         WHERE s."isDeleted" = false
436:           AND u."isDeleted" = false
437:         ORDER BY s."createdAt" DESC
438:         LIMIT ${limit}
439:         OFFSET ${offset}
440:       `;
441:     }
442:     const total = Number(countResult[0]?.count || 0);
443:     const totalPages = Math.ceil(total / limit);
444:     return {
