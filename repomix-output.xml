108:     return new Promise((resolve, reject) => {
109:       const request = window.indexedDB.open(this.dbName, this.version);
110:       request.onerror = () => reject(request.error);
111:       request.onsuccess = () => {
112:         this.db = request.result;
113:         resolve();
114:       };
115:       request.onupgradeneeded = (event) => {
