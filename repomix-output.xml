 62:         title: "Example Paper",
 63:         authors: ["Example Author"],
 64:         year: 2024,
 65:         source: "Example Source",
 66:       }).unwrap();
 67:     },
 68:     {
 69:       showToast: true,
 70:       onError: (error) => {
 71:         console.log("Upload failed:", error);
 72:       },
 73:     }
 74:   );
 75:   const someGenericError: undefined = undefined;
 76:   useErrorHandler(someGenericError, {
 77:     showToast: false,
 78:     logError: true,
 79:     onError: (error) => {
 80:       console.log("Generic error occurred:", error);
 81:     },
 82:   });
 83:   const handleUpload = async () => {
 84:     try {
 85:       const file = new File([""], "example.pdf", { type: "application/pdf" });
 86:       await uploadPaper({
 87:         file,
 88:         title: "Example Paper",
