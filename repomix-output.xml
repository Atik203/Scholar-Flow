  1: import { exec } from "child_process";
  2: import { promisify } from "util";
  3: import config from "../config";
  4: const execAsync = promisify(exec);
  5: export type DocxToPdfQuality = "draft" | "screen" | "print" | "prepress";
  6: export interface DocxToPdfResult {
  7:   success: boolean;
  8:   pdfBuffer?: Buffer;
  9:   error?: string;
 10:   conversionTimeMs?: number;
 11:   passthrough?: boolean;
 12:   compressionRatio?: number;
 13: }
 14: export interface DocxToPdfOptions {
 15:   timeoutMs?: number;
 16:   quality?: DocxToPdfQuality;
 17:   pageRange?: string;
 18: }
 19: const PDF_MAGIC = Buffer.from([0x25, 0x50, 0x44, 0x46]);
 20: const QUALITY_FLAGS: Record<DocxToPdfQuality, string> = {
 21:   draft:
 22:     "--convert-to pdf:writer_pdf_Export:SelectPdfVersion=1:Quality=50:MaxImageResolution=150",
 23:   screen:
 24:     "--convert-to pdf:writer_pdf_Export:SelectPdfVersion=1:Quality=75:MaxImageResolution=200",
 25:   print:
 26:     "--convert-to pdf:writer_pdf_Export:SelectPdfVersion=1:Quality=90:MaxImageResolution=300",
 27:   prepress:
 28:     "--convert-to pdf:writer_pdf_Export:SelectPdfVersion=2:Quality=100:MaxImageResolution=600:UseLosslessCompression=true:PDFUACompliance=true",
 29: };
 30: export class DocxToPdfService {
 31:   private readonly gotenbergUrl: string;
 32:   private readonly engine: string;
 33:   private readonly defaultQuality: DocxToPdfQuality;
 34:   private readonly defaultTimeoutMs: number;
 35:   constructor() {
 36:     this.engine = config.docxToPdf?.engine || "soffice";
 37:     this.gotenbergUrl = config.docxToPdf?.gotenbergUrl || "";
 38:     this.defaultQuality = config.docxToPdf?.quality || "print";
 39:     this.defaultTimeoutMs = config.docxToPdf?.requestTimeoutMs || 120000;
 40:   }
 41:   async convertDocxToPdf(
 42:     docxBuffer: Buffer,
 43:     options: DocxToPdfOptions = {}
 44:   ): Promise<DocxToPdfResult> {
 45:     const startTime = Date.now();
 46:     const timeoutMs = options.timeoutMs || this.defaultTimeoutMs;
 47:     if (this.isPdfBuffer(docxBuffer)) {
 48:       const elapsed = Date.now() - startTime;
 49:       console.log(
 50:         `[DocxToPdf] PDF passthrough — input already a PDF (${docxBuffer.length} bytes, ${elapsed}ms)`
 51:       );
 52:       return {
 53:         success: true,
 54:         pdfBuffer: docxBuffer,
 55:         conversionTimeMs: elapsed,
 56:         passthrough: true,
 57:         compressionRatio: 1,
 58:       };
 59:     }
 60:     console.log(
 61:       `[DocxToPdf] Starting conversion: engine=${this.engine}, timeout=${timeoutMs}ms, quality=${options.quality ?? this.defaultQuality}`
 62:     );
 63:     try {
 64:       let result: DocxToPdfResult;
 65:       if (this.engine === "gotenberg" && this.gotenbergUrl) {
 66:         result = await this.convertWithGotenberg(
 67:           docxBuffer,
 68:           timeoutMs,
 69:           options
 70:         );
 71:       } else {
 72:         result = await this.convertWithLibreOffice(
 73:           docxBuffer,
 74:           timeoutMs,
 75:           options
 76:         );
 77:       }
 78:       if (result.success && result.pdfBuffer) {
 79:         result.compressionRatio = parseFloat(
 80:           (result.pdfBuffer.length / docxBuffer.length).toFixed(3)
 81:         );
 82:       }
 83:       return result;
 84:     } catch (error) {
 85:       const elapsed = Date.now() - startTime;
 86:       console.error(
 87:         `[DocxToPdf] Conversion failed after ${elapsed}ms:`,
 88:         error
 89:       );
 90:       return {
 91:         success: false,
 92:         error:
 93:           error instanceof Error ? error.message : "Unknown conversion error",
 94:         conversionTimeMs: elapsed,
 95:       };
 96:     }
 97:   }
 98:   private isPdfBuffer(buffer: Buffer): boolean {
 99:     if (buffer.length < 4) return false;
100:     return (
101:       buffer[0] === PDF_MAGIC[0] &&
102:       buffer[1] === PDF_MAGIC[1] &&
103:       buffer[2] === PDF_MAGIC[2] &&
104:       buffer[3] === PDF_MAGIC[3]
105:     );
106:   }
107:   private async convertWithGotenberg(
108:     docxBuffer: Buffer,
109:     timeoutMs: number,
110:     options: DocxToPdfOptions
111:   ): Promise<DocxToPdfResult> {
112:     const startTime = Date.now();
113:     if (!this.gotenbergUrl) {
114:       throw new Error("GOTENBERG_URL is not configured");
115:     }
116:     try {
117:       const formData = new FormData();
118:       const docxBlob = new Blob([docxBuffer], {
119:         type: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
120:       });
121:       formData.append("files", docxBlob, "document.docx");
122:       const quality = options.quality ?? this.defaultQuality;
123:       const pdfFormat = quality === "prepress" ? "PDF/A-2b" : "PDF/A-1b";
124:       formData.append("pdfFormat", pdfFormat);
125:       formData.append("landscape", "false");
126:       if (options.pageRange) {
127:         formData.append("nativePageRanges", options.pageRange);
128:       }
129:       const controller = new AbortController();
130:       const timeout = setTimeout(() => controller.abort(), timeoutMs);
131:       const response = await fetch(
132:         `${this.gotenbergUrl}/forms/libreoffice/convert`,
133:         {
134:           method: "POST",
135:           body: formData,
136:           signal: controller.signal,
137:         }
138:       );
139:       clearTimeout(timeout);
140:       if (!response.ok) {
141:         const errorText = await response.text().catch(() => "Unknown error");
142:         throw new Error(
143:           `Gotenberg conversion failed: ${response.status} ${errorText}`
144:         );
145:       }
146:       const pdfBuffer = Buffer.from(await response.arrayBuffer());
147:       const elapsed = Date.now() - startTime;
148:       console.log(
149:         `[DocxToPdf] Gotenberg success: ${elapsed}ms, ${docxBuffer.length}→${pdfBuffer.length} bytes`
150:       );
151:       return { success: true, pdfBuffer, conversionTimeMs: elapsed };
152:     } catch (error) {
153:       console.warn(
154:         `[DocxToPdf] Gotenberg failed, falling back to LibreOffice:`,
155:         error
156:       );
157:       return await this.convertWithLibreOffice(docxBuffer, timeoutMs, options);
158:     }
159:   }
160:   private async convertWithLibreOffice(
161:     docxBuffer: Buffer,
162:     timeoutMs: number,
163:     options: DocxToPdfOptions
164:   ): Promise<DocxToPdfResult> {
165:     const startTime = Date.now();
166:     const fs = await import("fs/promises");
167:     const path = await import("path");
168:     const os = await import("os");
169:     const tempDir = await fs.mkdtemp(
170:       path.join(os.tmpdir(), "docx2pdf-")
171:     );
172:     const inputPath = path.join(tempDir, "input.docx");
173:     const outputDir = path.join(tempDir, "output");
174:     try {
175:       await fs.mkdir(outputDir, { recursive: true });
176:       await fs.writeFile(inputPath, docxBuffer);
177:       const quality = options.quality ?? this.defaultQuality;
178:       const qualityFlag = QUALITY_FLAGS[quality];
179:       const command = `soffice --headless ${qualityFlag} --outdir "${outputDir}" "${inputPath}"`;
180:       console.log(`[DocxToPdf] LibreOffice: ${command}`);
181:       const { stderr } = await execAsync(command, { timeout: timeoutMs });
182:       if (stderr && !stderr.includes("Warning")) {
183:         console.warn(`[DocxToPdf] LibreOffice stderr:`, stderr);
184:       }
185:       const outputPath = path.join(outputDir, "input.pdf");
186:       const pdfBuffer = await fs.readFile(outputPath);
187:       const elapsed = Date.now() - startTime;
188:       console.log(
189:         `[DocxToPdf] LibreOffice success: ${elapsed}ms, ${docxBuffer.length}→${pdfBuffer.length} bytes`
190:       );
191:       return { success: true, pdfBuffer, conversionTimeMs: elapsed };
192:     } finally {
193:       await fs.rm(tempDir, { recursive: true, force: true }).catch(() => {});
194:     }
195:   }
196:   async isAvailable(): Promise<boolean> {
197:     try {
198:       if (this.engine === "gotenberg" && this.gotenbergUrl) {
199:         const controller = new AbortController();
200:         const timeout = setTimeout(() => controller.abort(), 5000);
201:         const response = await fetch(`${this.gotenbergUrl}/health`, {
202:           signal: controller.signal,
203:         }).catch(() => null);
204:         clearTimeout(timeout);
205:         return response?.ok ?? false;
206:       }
207:       const { stdout } = await execAsync("soffice --version", {
208:         timeout: 5000,
209:       });
210:       return stdout.includes("LibreOffice");
211:     } catch {
212:       return false;
213:     }
214:   }
215: }
216: export const docxToPdfService = new DocxToPdfService();
</file>

<file path="apps/backend/src/app/services/embeddingBackfill.ts">
 1: import cron from "node-cron";
 2: import prisma from "../shared/prisma";
 3: import { documentExtractionService } from "./documentExtractionService";
 4: const logDebug = (...args: unknown[]) => {
 5:   if (process.env.NODE_ENV !== "production") {
 6:     console.log("[EmbeddingBackfill]", ...args);
 7:   }
 8: };
 9: const findPapersNeedingEmbeddings = async (
10:   limit: number
11: ): Promise<Array<{ id: string }>> => {
12:   return prisma.$queryRaw<Array<{ id: string }>>`
13:     SELECT DISTINCT c."paperId" AS id
14:     FROM "PaperChunk" c
15:     JOIN "Paper" p ON p.id = c."paperId"
16:     WHERE p."processingStatus" = 'PROCESSED'
17:       AND p."isDeleted" = false
18:       AND c."isDeleted" = false
19:       AND c.embedding IS NULL
20:     LIMIT ${limit}
21:   `;
22: };
23: export const runEmbeddingBackfill = async (limit = 10): Promise<number> => {
24:   if (!process.env.OPENAI_API_KEY || process.env.USE_PGVECTOR !== "true") {
25:     return 0;
26:   }
27:   const papers = await findPapersNeedingEmbeddings(limit);
28:   for (const paper of papers) {
29:     try {
30:       await documentExtractionService.generateEmbeddingsForPaper(paper.id);
31:       logDebug(`Backfilled embeddings for paper ${paper.id}`);
32:     } catch (error) {
33:       console.error(
34:         `[EmbeddingBackfill] Failed for paper ${paper.id}:`,
35:         error instanceof Error ? error.message : error
36:       );
37:     }
38:   }
39:   if (papers.length > 0) {
40:     logDebug(`Backfill pass complete: ${papers.length} paper(s) processed`);
41:   }
42:   return papers.length;
43: };
44: let backfillStarted = false;
45: export const startEmbeddingBackfill = (): void => {
46:   if (backfillStarted || process.env.VERCEL === "1") {
47:     return;
48:   }
49:   cron.schedule("15 * * * *", () => {
50:     runEmbeddingBackfill().catch((error) => {
51:       console.error("[EmbeddingBackfill] Backfill run failed:", error);
52:     });
53:   });
54:   backfillStarted = true;
55:   logDebug("Embedding backfill sweeper started (hourly)");
56: };
</file>

