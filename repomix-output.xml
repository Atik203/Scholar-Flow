181: model Workspace {
182:   id          String                @id @default(uuid())
183:   name        String
184:   description String?
185:   ownerId     String
186:   owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
187:   members     WorkspaceMember[]
