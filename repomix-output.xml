190: export const detailedHealthCheck = catchAsync(
191:   async (req: Request, res: Response) => {
192:     const startTime = Date.now();
193:     const [databaseResult, memoryResult, environmentResult, gotenbergResult] =
194:       await Promise.allSettled([
195:         checkDatabase(),
196:         Promise.resolve(checkMemory()),
197:         Promise.resolve(checkEnvironment()),
198:         checkGotenberg(),
199:       ]);
200:     const services: HealthCheckResult[] = [];
201:     if (databaseResult.status === "fulfilled") {
202:       services.push(databaseResult.value);
203:     } else {
204:       services.push({
205:         service: "database",
206:         status: "unhealthy",
207:         error: "Health check failed to execute",
208:       });
209:     }
210:     if (memoryResult.status === "fulfilled") {
211:       services.push(memoryResult.value);
212:     }
213:     if (environmentResult.status === "fulfilled") {
214:       services.push(environmentResult.value);
215:     }
216:     if (gotenbergResult.status === "fulfilled") {
217:       services.push(gotenbergResult.value);
218:     }
219:     const healthyCounts = services.reduce(
220:       (acc, service) => {
221:         acc[service.status]++;
222:         acc.total++;
223:         return acc;
224:       },
225:       { healthy: 0, unhealthy: 0, degraded: 0, total: 0 }
226:     );
227:     let overallStatus: "healthy" | "unhealthy" | "degraded" = "healthy";
228:     if (healthyCounts.unhealthy > 0) {
229:       overallStatus = "unhealthy";
230:     } else if (healthyCounts.degraded > 0) {
231:       overallStatus = "degraded";
232:     }
233:     const responseTime = Date.now() - startTime;
234:     const response: HealthCheckResponse = {
235:       status: overallStatus,
236:       timestamp: new Date().toISOString(),
237:       uptime: process.uptime(),
238:       environment: process.env.NODE_ENV || "development",
239:       version: process.env.npm_package_version || "1.0.0",
240:       services,
241:       overall: healthyCounts,
242:     };
243:     let statusCode = 200;
244:     if (overallStatus === "degraded") {
245:       statusCode = 207;
246:     } else if (overallStatus === "unhealthy") {
247:       statusCode = 503;
248:     }
249:     res.setHeader("X-Health-Check-Duration", `${responseTime}ms`);
250:     res.status(statusCode).json(response);
251:   }
