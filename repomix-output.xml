  5: import { Popover, PopoverContent, PopoverTrigger } from "../../ui/popover";
  6: export interface DatePickerProps {
  7:   value?: Date | Date[];
  8:   onChange?: (date: Date | Date[] | undefined) => void;
  9:   placeholder?: string;
 10:   label?: string;
 11:   helperText?: string;
 12:   error?: string;
 13:   disabled?: boolean;
 14:   range?: boolean;
 15:   minDate?: Date;
 16:   maxDate?: Date;
 17:   className?: string;
 18:   format?: string;
 19: }
 20: export const DatePicker: React.FC<DatePickerProps> = ({
 21:   value,
 22:   onChange,
 23:   placeholder = "Pick a date",
 24:   label,
 25:   helperText,
 26:   error,
 27:   disabled = false,
 28:   range = false,
 29:   minDate,
 30:   maxDate,
 31:   className,
 32:   format = "MMM dd, yyyy",
 33: }) => {
 34:   const [isOpen, setIsOpen] = React.useState(false);
 35:   const [currentMonth, setCurrentMonth] = React.useState(() => {
 36:     if (value) {
 37:       const date = Array.isArray(value) ? value[0] : value;
 38:       return new Date(date.getFullYear(), date.getMonth(), 1);
 39:     }
 40:     return new Date();
 41:   });
 42:   const formatDate = React.useCallback(
 43:     (date: Date): string => {
 44:       const months = [
 45:         "Jan",
 46:         "Feb",
 47:         "Mar",
 48:         "Apr",
 49:         "May",
 50:         "Jun",
 51:         "Jul",
 52:         "Aug",
 53:         "Sep",
 54:         "Oct",
 55:         "Nov",
 56:         "Dec",
 57:       ];
 58:       return format
 59:         .replace("MMM", months[date.getMonth()])
 60:         .replace("dd", date.getDate().toString().padStart(2, "0"))
 61:         .replace("yyyy", date.getFullYear().toString());
 62:     },
 63:     [format]
 64:   );
 65:   const getDaysInMonth = (year: number, month: number) => {
 66:     return new Date(year, month + 1, 0).getDate();
 67:   };
 68:   const getFirstDayOfMonth = (year: number, month: number) => {
 69:     return new Date(year, month, 1).getDay();
 70:   };
 71:   const isDateInRange = (date: Date) => {
 72:     if (minDate && date < minDate) return false;
 73:     if (maxDate && date > maxDate) return false;
 74:     return true;
 75:   };
 76:   const isDateSelected = (date: Date) => {
 77:     if (!value) return false;
 78:     if (Array.isArray(value)) {
 79:       return value.some(
 80:         (d) =>
 81:           d.getDate() === date.getDate() &&
 82:           d.getMonth() === date.getMonth() &&
 83:           d.getFullYear() === date.getFullYear()
 84:       );
 85:     }
 86:     return (
 87:       date.getDate() === value.getDate() &&
 88:       date.getMonth() === value.getMonth() &&
 89:       date.getFullYear() === value.getFullYear()
 90:     );
 91:   };
 92:   const isDateInSelectionRange = (date: Date) => {
 93:     if (!range || !Array.isArray(value) || value.length !== 2) return false;
 94:     const [start, end] = value;
 95:     return date >= start && date <= end;
 96:   };
 97:   const handleDateClick = (date: Date) => {
 98:     if (!onChange || !isDateInRange(date)) return;
 99:     if (range) {
100:       if (!Array.isArray(value) || value.length === 0) {
101:         onChange([date]);
102:       } else if (value.length === 1) {
103:         const [start] = value;
104:         if (date < start) {
105:           onChange([date, start]);
106:         } else {
107:           onChange([start, date]);
108:         }
109:         setIsOpen(false);
110:       } else {
111:         onChange([date]);
112:       }
113:     } else {
114:       onChange(date);
115:       setIsOpen(false);
116:     }
117:   };
118:   const handleClear = () => {
119:     if (onChange) {
120:       onChange(undefined);
121:     }
122:   };
123:   const renderCalendar = () => {
124:     const year = currentMonth.getFullYear();
125:     const month = currentMonth.getMonth();
126:     const daysInMonth = getDaysInMonth(year, month);
127:     const firstDay = getFirstDayOfMonth(year, month);
128:     const days = [];
129:     for (let i = 0; i < firstDay; i++) {
130:       days.push(<div key={`empty-${i}`} className="h-9" />);
131:     }
132:     for (let day = 1; day <= daysInMonth; day++) {
133:       const date = new Date(year, month, day);
134:       const isSelected = isDateSelected(date);
135:       const isInRange = isDateInSelectionRange(date);
136:       const isValid = isDateInRange(date);
137:       days.push(
138:         <button
139:           key={day}
140:           onClick={() => handleDateClick(date)}
141:           disabled={!isValid}
142:           className={cn(
143:             "h-9 w-9 rounded-md text-sm transition-colors",
144:             "hover:bg-accent hover:text-accent-foreground",
145:             isSelected && "bg-primary text-primary-foreground",
146:             isInRange && !isSelected && "bg-primary/20 text-primary-foreground",
147:             !isValid && "opacity-50 cursor-not-allowed",
148:             !isValid && "hover:bg-transparent hover:text-muted-foreground"
149:           )}
150:         >
151:           {day}
152:         </button>
153:       );
154:     }
155:     return days;
156:   };
157:   const displayValue = React.useMemo(() => {
158:     if (!value) return placeholder;
159:     if (Array.isArray(value)) {
160:       if (value.length === 0) return placeholder;
161:       if (value.length === 1) return formatDate(value[0]);
162:       if (value.length === 2) {
163:         return `${formatDate(value[0])} - ${formatDate(value[1])}`;
164:       }
165:       return `${value.length} dates selected`;
166:     }
167:     return formatDate(value);
168:   }, [value, placeholder, formatDate]);
169:   return (
170:     <div className={cn("space-y-2", className)}>
171:       {label && (
172:         <label className="text-sm font-medium text-foreground">{label}</label>
173:       )}
174:       <Popover open={isOpen} onOpenChange={setIsOpen}>
175:         <PopoverTrigger asChild>
176:           <Button
177:             variant="outline"
178:             role="combobox"
179:             aria-expanded={isOpen}
180:             disabled={disabled}
181:             className={cn(
182:               "w-full justify-between",
183:               error && "border-destructive",
184:               disabled && "opacity-50 cursor-not-allowed"
185:             )}
186:           >
187:             <span
188:               className={cn(
189:                 "flex-1 text-left",
190:                 !value && "text-muted-foreground"
191:               )}
192:             >
193:               {displayValue}
194:             </span>
195:             <div className="flex items-center gap-1">
196:               {value && (
197:                 <Button
198:                   type="button"
199:                   variant="ghost"
200:                   size="sm"
201:                   onClick={(e) => {
202:                     e.stopPropagation();
203:                     handleClear();
204:                   }}
205:                   disabled={disabled}
206:                   className="h-6 w-6 p-0 hover:bg-destructive hover:text-destructive-foreground"
207:                 >
208:                   <X className="h-3 w-3" />
209:                 </Button>
210:               )}
211:               <Calendar className="h-4 w-4 opacity-50" />
212:             </div>
213:           </Button>
214:         </PopoverTrigger>
215:         <PopoverContent className="w-auto p-0" align="start">
216:           <div className="p-3">
217:             <div className="flex items-center justify-between mb-2">
218:               <Button
219:                 variant="ghost"
220:                 size="sm"
221:                 onClick={() =>
222:                   setCurrentMonth(
223:                     new Date(
224:                       currentMonth.getFullYear(),
