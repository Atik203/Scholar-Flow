 21: type Format = "csv" | "json";
 22: const FORMATS: Array<{
 23:   id: Format;
 24:   label: string;
 25:   description: string;
 26:   icon: typeof FileSpreadsheet;
 27: }> = [
 28:   { id: "csv", label: "CSV", description: "Spreadsheet-friendly format", icon: FileSpreadsheet },
 29:   { id: "json", label: "JSON", description: "Machine-readable format", icon: FileJson },
 30: ];
 31: export default function ExportPage() {
 32:   const accessToken = useAppSelector(selectAccessToken);
 33:   const [format, setFormat] = useState<Format>("csv");
 34:   const [loading, setLoading] = useState(false);
 35:   const [downloadUrl, setDownloadUrl] = useState<string | null>(null);
 36:   const [filename, setFilename] = useState<string | null>(null);
 37:   const handleExport = async () => {
 38:     setLoading(true);
 39:     setDownloadUrl(null);
 40:     setFilename(null);
 41:     try {
 42:       const res = await fetch(
 43:         `${API_BASE_URL}/analytics/usage/export?format=${format}`,
 44:         {
 45:           method: "GET",
 46:           headers: accessToken
 47:             ? { Authorization: `Bearer ${accessToken}` }
 48:             : undefined,
 49:         }
 50:       );
 51:       if (!res.ok) {
 52:         const err = await res.json().catch(() => null);
 53:         throw new Error(err?.message || "Export failed");
 54:       }
 55:       const blob = await res.blob();
 56:       const url = URL.createObjectURL(blob);
 57:       const disposition = res.headers.get("Content-Disposition");
 58:       const fallback = `scholarflow-export-${Date.now()}.${format}`;
 59:       const name = disposition?.match(/filename="?([^"]+)"?/)?.[1] || fallback;
 60:       setDownloadUrl(url);
 61:       setFilename(name);
 62:       showSuccessToast("Export ready", `Your ${format.toUpperCase()} export is ready to download.`);
 63:       const a = document.createElement("a");
 64:       a.href = url;
 65:       a.download = name;
 66:       document.body.appendChild(a);
 67:       a.click();
 68:       a.remove();
 69:     } catch (err: unknown) {
 70:       const message = err instanceof Error ? err.message : "An unexpected error occurred";
 71:       showErrorToast("Export failed", message);
 72:     } finally {
 73:       setLoading(false);
 74:     }
 75:   };
 76:   return (
 77:     <DashboardLayout>
 78:       <div className="p-6 lg:p-8 max-w-2xl space-y-6">
 79:         <div>
 80:           <h1 className="text-3xl font-bold tracking-tight">Export Data</h1>
 81:           <p className="text-muted-foreground mt-1">
 82:             Download your research usage report (papers, collections, activity).
 83:           </p>
 84:         </div>
 85:         <motion.div initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }}>
 86:           <Card>
 87:             <CardHeader>
 88:               <CardTitle>Export format</CardTitle>
 89:               <CardDescription>
 90:                 Choose the format for your exported data.
 91:               </CardDescription>
 92:             </CardHeader>
 93:             <CardContent className="space-y-4">
 94:               <div className="grid grid-cols-2 gap-3">
 95:                 {FORMATS.map(({ id, label, description, icon: Icon }) => (
 96:                   <button
 97:                     key={id}
 98:                     type="button"
 99:                     onClick={() => setFormat(id)}
100:                     className={`flex items-start gap-3 p-4 rounded-xl border-2 text-left transition-colors ${
101:                       format === id
102:                         ? "border-indigo-500 bg-indigo-50/50 dark:bg-indigo-900/20"
103:                         : "border-muted hover:border-slate-300 dark:hover:border-slate-600"
104:                     }`}
105:                   >
106:                     <Icon className="h-5 w-5 mt-0.5 shrink-0" />
107:                     <div>
108:                       <p className="font-medium text-sm">{label}</p>
109:                       <p className="text-xs text-muted-foreground mt-0.5">
110:                         {description}
111:                       </p>
112:                     </div>
113:                   </button>
114:                 ))}
115:               </div>
116:               <Button
117:                 onClick={handleExport}
118:                 disabled={loading}
119:                 className="w-full gap-2"
120:               >
121:                 {loading ? (
122:                   <>
123:                     <Loader2 className="h-4 w-4 animate-spin" />
124:                     Exporting...
125:                   </>
126:                 ) : (
127:                   <>
128:                     <Download className="h-4 w-4" />
129:                     Export as {format.toUpperCase()}
130:                   </>
131:                 )}
132:               </Button>
133:               {filename && downloadUrl && (
134:                 <motion.div
135:                   initial={{ opacity: 0, height: 0 }}
136:                   animate={{ opacity: 1, height: "auto" }}
137:                   className="p-3 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800"
138:                 >
139:                   <p className="text-sm font-medium text-emerald-700 dark:text-emerald-400">
140:                     Downloaded:{" "}
141:                     <span className="font-mono">{filename}</span>
142:                   </p>
143:                   <a
144:                     href={downloadUrl}
145:                     download={filename}
146:                     className="text-xs text-emerald-600 dark:text-emerald-500 underline mt-1 inline-block"
147:                   >
148:                     Click here if download didn&apos;t start automatically
149:                   </a>
150:                 </motion.div>
151:               )}
152:             </CardContent>
153:           </Card>
154:         </motion.div>
155:       </div>
156:     </DashboardLayout>
157:   );
158: }
