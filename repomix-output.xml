102:             top: y,
103:             width: w,
104:             height: h,
105:             border: `2px dashed ${annotation.color}`,
106:             backgroundColor: hexToRgba(annotation.color, 0.1),
107:           }}
108:           onClick={clickHandler}
109:         >
110:           <HoverCard annotation={annotation} />
111:         </div>
112:       );
113:     case "COMMENT":
114:       return (
115:         <div
116:           key={annotation.id}
117:           className="absolute group cursor-pointer pointer-events-auto"
118:           style={{ left: x, top: y, width: 28, height: 28 }}
119:           onClick={clickHandler}
120:         >
121:           <span className="text-lg select-none leading-none">&#x1F4AC;</span>
122:           <HoverCard annotation={annotation} />
123:         </div>
124:       );
