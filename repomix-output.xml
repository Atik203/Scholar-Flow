 13: function deriveMeta(content: string): { wordCount: number; excerpt: string } {
 14:   const trimmed = content.trim();
 15:   const wordCount = trimmed.length === 0 ? 0 : trimmed.split(/\s+/).length;
 16:   const firstLine =
 17:     trimmed.split("\n").find((l) => l.trim().length > 0)?.trim() ?? "";
 18:   const excerpt = firstLine.slice(0, 200);
 19:   return { wordCount, excerpt };
 20: }
