 754:   ) {
 755:     const invitations = await prisma.$queryRaw<any[]>`
 756:       SELECT wi.id, wi."workspaceId", wi."userId", wi.role, wi.status, wi."invitedAt",
 757:              w.name as "workspaceName", u.email as "inviteeEmail", u.name as "inviteeName"
 758:       FROM "WorkspaceInvitation" wi
 759:       JOIN "Workspace" w ON w.id = wi."workspaceId"
 760:       JOIN "User" u ON u.id = wi."userId"
 761:       WHERE wi."invitedById" = ${inviterId} AND wi."isDeleted" = false
 762:       ORDER BY wi."invitedAt" DESC
 763:       LIMIT ${limit} OFFSET ${skip}
 764:     `;
 765:     const totalRes = await prisma.$queryRaw<any[]>`
 766:       SELECT COUNT(*)::int as count
 767:       FROM "WorkspaceInvitation" wi
 768:       WHERE wi."invitedById" = ${inviterId} AND wi."isDeleted" = false
 769:     `;
 770:     return {
 771:       result: invitations,
 772:       meta: {
 773:         total: totalRes[0]?.count || 0,
 774:         totalPage: Math.ceil((totalRes[0]?.count || 0) / limit),
