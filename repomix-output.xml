 799: export const allRoutes = Object.values(routes).flat();
 800: export const getRouteByPath = (path: string): RouteConfig | undefined => {
 801:   return allRoutes.find((route) => {
 802:     if (route.exact) {
 803:       return route.path === path;
 804:     }
 805:     return path.startsWith(route.path);
 806:   });
 807: };
 808: export const getRoleFromPath = (path: string): UserRole => {
 809:   if (path.includes("/admin")) return "admin";
 810:   if (path.includes("/team-lead")) return "team_lead";
 811:   if (path.includes("/pro-researcher")) return "pro_researcher";
 812:   return "researcher";
 813: };
