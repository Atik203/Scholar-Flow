  1: "use client";
  2: import {
  3:   showErrorToast,
  4:   showSuccessToast,
  5: } from "@/components/providers/ToastProvider";
  6: import { Button } from "@/components/ui/button";
  7: import { Checkbox } from "@/components/ui/checkbox";
  8: import {
  9:   Dialog,
 10:   DialogContent,
 11:   DialogDescription,
 12:   DialogHeader,
 13:   DialogTitle,
 14:   DialogTrigger,
 15: } from "@/components/ui/dialog";
 16: import { Input } from "@/components/ui/input";
 17: import { Label } from "@/components/ui/label";
 18: import {
 19:   Select,
 20:   SelectContent,
 21:   SelectItem,
 22:   SelectTrigger,
 23:   SelectValue,
 24: } from "@/components/ui/select";
 25: import { Textarea } from "@/components/ui/textarea";
 26: import {
 27:   useAddPaperToCollectionMutation,
 28:   useCreateCollectionMutation,
 29:   useGetMyCollectionsQuery,
 30: } from "@/redux/api/collectionApi";
 31: import { useCreateEditorPaperMutation } from "@/redux/api/paperApi";
 32: import { useListWorkspacesQuery } from "@/redux/api/workspaceApi";
 33: import { useAuth } from "@/redux/auth/useAuth";
 34: import { zodResolver } from "@hookform/resolvers/zod";
 35: import { BookOpen, Loader2, Plus, X } from "lucide-react";
 36: import { useEffect, useState } from "react";
 37: import { useForm } from "react-hook-form";
 38: import { z } from "zod";
 39: const createPaperSchema = z.object({
 40:   title: z.string().min(1, "Title is required").max(300, "Title is too long"),
 41:   abstract: z.string().max(5000, "Abstract is too long").optional(),
 42:   workspaceId: z
 43:     .string()
 44:     .uuid("Please select a valid workspace")
 45:     .refine(
 46:       (val) => val !== "loading" && val !== "no-workspaces",
 47:       "Please select a valid workspace"
 48:     ),
 49:   authors: z
 50:     .array(
 51:       z
 52:         .string()
 53:         .min(1, "Author name is required")
 54:         .max(120, "Author name is too long")
 55:     )
 56:     .min(1, "At least one author is required")
 57:     .max(25, "Maximum 25 authors allowed"),
 58: });
 59: type CreatePaperFormData = z.infer<typeof createPaperSchema>;
 60: interface CreatePaperDialogProps {
 61:   isOpen: boolean;
 62:   onClose: () => void;
 63:   onPaperCreated: (paperId: string) => void;
 64: }
 65: export function CreatePaperDialog({
 66:   isOpen,
 67:   onClose,
 68:   onPaperCreated,
 69: }: CreatePaperDialogProps) {
 70:   const [createPaper] = useCreateEditorPaperMutation();
 71:   const { session } = useAuth();
 72:   const [authors, setAuthors] = useState<string[]>([""]);
 73:   // Collection selection state
 74:   const [selectedCollectionIds, setSelectedCollectionIds] = useState<string[]>(
 75:     []
 76:   );
 77:   const [showCreateCollection, setShowCreateCollection] = useState(false);
 78:   const [newCollectionName, setNewCollectionName] = useState("");
 79:   const [newCollectionDescription, setNewCollectionDescription] = useState("");
 80:   // Fetch user workspaces
 81:   const { data: workspacesData, isLoading: isLoadingWorkspaces } =
 82:     useListWorkspacesQuery({
 83:       limit: 50,
 84:     });
 85:   // Collection API hooks
 86:   const [createCollection, { isLoading: creatingCollection }] =
 87:     useCreateCollectionMutation();
 88:   const [addPaperToCollection] = useAddPaperToCollectionMutation();
 89:   const {
 90:     register,
 91:     handleSubmit,
 92:     reset,
 93:     setValue,
 94:     watch,
 95:     formState: { errors, isSubmitting },
 96:   } = useForm<CreatePaperFormData>({
 97:     resolver: zodResolver(createPaperSchema),
 98:   });
 99:   const watchedWorkspaceId = watch("workspaceId");
100:   const { data: collectionsData } = useGetMyCollectionsQuery(
101:     watchedWorkspaceId
102:       ? { workspaceId: watchedWorkspaceId, page: 1, limit: 50 }
103:       : { page: 1, limit: 50 },
104:     { skip: !watchedWorkspaceId }
105:   );
106:   useEffect(() => {
107:     if (session?.user?.name && authors.length === 1 && !authors[0]) {
108:       const newAuthors = [session.user.name];
109:       setAuthors(newAuthors);
110:       setValue("authors", newAuthors);
111:     }
112:   }, [session, setValue, authors]);
113:   useEffect(() => {
114:     setValue("authors", authors);
115:   }, [authors, setValue]);
116:   const workspaces = workspacesData?.data || [];
117:   const toggleCollectionSelection = (collectionId: string) => {
118:     setSelectedCollectionIds((prev) =>
119:       prev.includes(collectionId)
120:         ? prev.filter((id) => id !== collectionId)
121:         : [...prev, collectionId]
122:     );
123:   };
124:   const handleCreateCollection = async (e: React.FormEvent) => {
125:     e.preventDefault();
126:     if (!newCollectionName.trim() || !watchedWorkspaceId) return;
127:     try {
128:       const result = await createCollection({
129:         name: newCollectionName,
130:         description: newCollectionDescription || undefined,
131:         workspaceId: watchedWorkspaceId,
132:       }).unwrap();
133:       setSelectedCollectionIds([...selectedCollectionIds, result.id]);
134:       setNewCollectionName("");
135:       setNewCollectionDescription("");
136:       setShowCreateCollection(false);
137:       showSuccessToast("Collection created successfully");
138:     } catch (error: any) {
139:       showErrorToast(error?.data?.message || "Failed to create collection");
140:     }
141:   };
142:   const onSubmit = async (data: CreatePaperFormData) => {
143:     try {
144:       if (
145:         data.workspaceId === "loading" ||
146:         data.workspaceId === "no-workspaces"
147:       ) {
148:         showErrorToast("Please select a valid workspace");
149:         return;
150:       }
151:       const response = await createPaper({
152:         workspaceId: data.workspaceId,
153:         title: data.title,
154:         content:
155:           "<h1>" +
156:           data.title +
157:           "</h1>" +
158:           (data.abstract ? "<p>" + data.abstract + "</p>" : ""),
159:         isDraft: true,
160:         authors: authors.filter((author) => author.trim() !== ""),
161:       }).unwrap();
162:       showSuccessToast(
163:         "Paper created successfully!",
164:         "You can now start editing your paper."
165:       );
166:       // Add paper to selected collections
167:       if (selectedCollectionIds.length > 0) {
168:         try {
169:           await Promise.all(
170:             selectedCollectionIds.map((collectionId) =>
171:               addPaperToCollection({
172:                 collectionId,
173:                 data: { paperId: response.data.paper.id },
174:               }).unwrap()
175:             )
176:           );
177:           showSuccessToast(
178:             `Paper added to ${selectedCollectionIds.length} collection${selectedCollectionIds.length !== 1 ? "s" : ""}`
179:           );
180:         } catch (collectionError) {
181:           console.warn(
182:             "Failed to add paper to some collections:",
183:             collectionError
184:           );
185:           showErrorToast("Paper created but failed to add to some collections");
186:         }
187:       }
188:       reset({
189:         title: "",
190:         abstract: "",
191:         workspaceId: "",
192:         authors: [""], // Reset to single empty author field
193:       });
194:       setAuthors([""]);
195:       setSelectedCollectionIds([]);
196:       onClose();
197:       // Notify parent component
198:       onPaperCreated(response.data.paper.id);
199:     } catch (error: any) {
200:       console.error("Error creating paper:", error);
201:       showErrorToast(
202:         "Failed to create paper",
203:         error?.data?.message || "Please try again later."
204:       );
205:     }
206:   };
207:   const handleClose = () => {
208:     if (!isSubmitting) {
209:       reset({
210:         title: "",
211:         abstract: "",
212:         workspaceId: "",
213:         authors: [""], // Reset to single empty author field
214:       });
215:       setAuthors([""]);
216:       setSelectedCollectionIds([]);
217:       onClose();
218:     }
219:   };
220:   return (
221:     <Dialog open={isOpen} onOpenChange={handleClose}>
222:       <DialogContent className="sm:max-w-[425px]">
223:         <DialogHeader>
224:           <DialogTitle>Create New Paper</DialogTitle>
225:           <DialogDescription>
226:             Start writing your research paper with our rich text editor.
227:           </DialogDescription>
228:         </DialogHeader>
229:         <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
230:           <div className="space-y-2">
231:             <Label htmlFor="title">Title</Label>
232:             <Input
233:               id="title"
234:               placeholder="Enter paper title..."
235:               disabled={isSubmitting}
236:               {...register("title")}
237:             />
238:             {errors.title && (
239:               <p className="text-sm text-red-600">{errors.title.message}</p>
240:             )}
241:           </div>
242:           <div className="space-y-2">
243:             <Label htmlFor="abstract">Abstract (Optional)</Label>
244:             <Textarea
245:               id="abstract"
246:               placeholder="Brief description of your paper..."
247:               rows={3}
248:               disabled={isSubmitting}
249:               {...register("abstract")}
250:             />
251:             {errors.abstract && (
252:               <p className="text-sm text-red-600">{errors.abstract.message}</p>
253:             )}
254:           </div>
255:           <div className="space-y-2">
256:             <Label htmlFor="workspaceId">Workspace</Label>
257:             <Select
258:               onValueChange={(value) => setValue("workspaceId", value)}
259:               disabled={isSubmitting || isLoadingWorkspaces}
260:             >
261:               <SelectTrigger>
262:                 <SelectValue placeholder="Select a workspace..." />
263:               </SelectTrigger>
264:               <SelectContent>
265:                 {isLoadingWorkspaces ? (
266:                   <SelectItem value="loading" disabled>
267:                     Loading workspaces...
268:                   </SelectItem>
269:                 ) : workspaces.length === 0 ? (
270:                   <SelectItem value="no-workspaces" disabled>
271:                     No workspaces available
272:                   </SelectItem>
273:                 ) : (
274:                   workspaces.map((workspace) => (
275:                     <SelectItem key={workspace.id} value={workspace.id}>
276:                       {workspace.name}
277:                     </SelectItem>
278:                   ))
279:                 )}
280:               </SelectContent>
281:             </Select>
282:             {errors.workspaceId && (
283:               <p className="text-sm text-red-600">
284:                 {errors.workspaceId.message}
285:               </p>
286:             )}
287:           </div>
288:           <div className="space-y-2">
289:             <div className="flex items-center justify-between">
290:               <Label>Authors</Label>
291:               <Button
292:                 type="button"
293:                 variant="outline"
294:                 size="sm"
295:                 onClick={() => {
296:                   const newAuthors = [...authors, ""];
297:                   setAuthors(newAuthors);
298:                 }}
299:                 disabled={isSubmitting || authors.length >= 25}
300:                 className="text-xs"
301:               >
302:                 <Plus className="h-3 w-3 mr-1" />
303:                 Add Author
304:               </Button>
305:             </div>
306:             <div className="space-y-2">
307:               {authors.map((author, index) => (
308:                 <div key={index} className="flex items-center space-x-2">
309:                   <Input
310:                     placeholder={`Author ${index + 1} name...`}
311:                     disabled={isSubmitting}
312:                     value={author}
313:                     onChange={(e) => {
314:                       const newAuthors = [...authors];
315:                       newAuthors[index] = e.target.value;
316:                       setAuthors(newAuthors);
317:                     }}
318:                   />
319:                   {authors.length > 1 && (
320:                     <Button
321:                       type="button"
322:                       variant="outline"
323:                       size="sm"
324:                       onClick={() => {
325:                         const newAuthors = authors.filter(
326:                           (_, i) => i !== index
327:                         );
328:                         setAuthors(newAuthors);
329:                       }}
330:                       disabled={isSubmitting}
331:                       className="flex-shrink-0"
332:                     >
333:                       <X className="h-3 w-3" />
334:                     </Button>
335:                   )}
336:                 </div>
337:               ))}
338:             </div>
339:             {errors.authors && (
340:               <p className="text-sm text-red-600">{errors.authors.message}</p>
341:             )}
342:             {errors.authors?.root && (
343:               <p className="text-sm text-red-600">
344:                 {errors.authors.root.message}
345:               </p>
346:             )}
347:             {errors.authors && Array.isArray(errors.authors) && (
348:               <div className="space-y-1">
349:                 {errors.authors.map(
350:                   (error, index) =>
351:                     error && (
352:                       <p key={index} className="text-sm text-red-600">
353:                         Author {index + 1}: {error.message}
354:                       </p>
355:                     )
356:                 )}
357:               </div>
358:             )}
359:           </div>
360:           {}
361:           {watchedWorkspaceId && (
362:             <div className="space-y-2">
363:               <div className="flex items-center justify-between">
364:                 <Label className="flex items-center gap-2">
365:                   <BookOpen className="h-4 w-4" />
366:                   Collections (Optional)
367:                 </Label>
368:                 <Dialog
369:                   open={showCreateCollection}
370:                   onOpenChange={setShowCreateCollection}
371:                 >
372:                   <DialogTrigger asChild>
373:                     <Button type="button" variant="outline" size="sm">
374:                       <Plus className="h-3 w-3 mr-1" />
375:                       New Collection
376:                     </Button>
377:                   </DialogTrigger>
378:                   <DialogContent>
379:                     <DialogHeader>
