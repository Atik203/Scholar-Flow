 7:   min?: number;
 8:   max?: number;
 9:   step?: number;
10:   label?: string;
11:   helperText?: string;
12:   error?: string;
13:   disabled?: boolean;
14:   showValue?: boolean;
15:   valueFormat?: (value: number) => string;
16:   className?: string;
17: }
18: export const SliderField: React.FC<SliderFieldProps> = ({
19:   value,
20:   onValueChange,
21:   min = 0,
22:   max = 100,
23:   step = 1,
24:   label,
25:   helperText,
26:   error,
27:   disabled = false,
28:   showValue = true,
29:   valueFormat,
30:   className,
31: }) => {
32:   const formatValue = (val: number) => {
33:     if (valueFormat) return valueFormat(val);
34:     return val.toString();
35:   };
36:   const displayValue = value.length === 1
37:     ? formatValue(value[0])
38:     : `${formatValue(value[0])} - ${formatValue(value[value.length - 1])}`;
39:   return (
40:     <div className={cn("space-y-3", className)}>
41:       <div className="flex items-center justify-between">
42:         {label && (
43:           <label className="text-sm font-medium text-foreground">
44:             {label}
45:           </label>
46:         )}
47:         {showValue && (
48:           <span className="text-sm text-muted-foreground font-mono">
49:             {displayValue}
50:           </span>
51:         )}
52:       </div>
53:       <Slider
54:         value={value}
55:         onValueChange={onValueChange}
56:         min={min}
57:         max={max}
58:         step={step}
59:         disabled={disabled}
60:         className={cn(
61:           "w-full",
62:           error && "border-destructive"
63:         )}
64:       />
65:       <div className="flex justify-between text-xs text-muted-foreground">
66:         <span>{formatValue(min)}</span>
67:         <span>{formatValue(max)}</span>
68:       </div>
69:       {helperText && !error && (
70:         <p className="text-sm text-muted-foreground">{helperText}</p>
71:       )}
72:       {error && (
73:         <p className="text-sm text-destructive">{error}</p>
74:       )}
75:     </div>
76:   );
77: };
</file>

