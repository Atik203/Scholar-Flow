  1: import { exec } from "child_process";
  2: import { promisify } from "util";
  3: import config from "../config";
  4: const execAsync = promisify(exec);
  5: export interface DocxToPdfResult {
  6:   success: boolean;
  7:   pdfBuffer?: Buffer;
  8:   error?: string;
  9:   conversionTimeMs?: number;
 10: }
 11: export interface DocxToPdfOptions {
 12:   timeoutMs?: number;
 13:   quality?: "low" | "medium" | "high";
 14: }
 15: export class DocxToPdfService {
 16:   private readonly gotenbergUrl: string;
 17:   private readonly engine: string;
 18:   private readonly defaultTimeoutMs: number;
 19:   constructor() {
 20:     this.engine = config.docxToPdf?.engine || "soffice";
 21:     this.gotenbergUrl = config.docxToPdf?.gotenbergUrl || "";
 22:     this.defaultTimeoutMs = config.docxToPdf?.requestTimeoutMs || 120000; // 2 minutes default
 23:   }
 24:   /**
 25:    * Convert DOCX buffer to PDF buffer
 26:    */
 27:   async convertDocxToPdf(
 28:     docxBuffer: Buffer,
 29:     options: DocxToPdfOptions = {}
 30:   ): Promise<DocxToPdfResult> {
 31:     const startTime = Date.now();
 32:     const timeoutMs = options.timeoutMs || this.defaultTimeoutMs;
 33:     console.log(
 34:       `[DocxToPdf] Starting conversion using engine: ${this.engine}, timeout: ${timeoutMs}ms`
 35:     );
 36:     try {
 37:       if (this.engine === "gotenberg" && this.gotenbergUrl) {
 38:         return await this.convertWithGotenberg(docxBuffer, timeoutMs);
 39:       } else {
 40:         return await this.convertWithLibreOffice(docxBuffer, timeoutMs);
 41:       }
 42:     } catch (error) {
 43:       const conversionTimeMs = Date.now() - startTime;
 44:       console.error(
 45:         `[DocxToPdf] Conversion failed after ${conversionTimeMs}ms:`,
 46:         error
 47:       );
 48:       return {
 49:         success: false,
 50:         error:
 51:           error instanceof Error ? error.message : "Unknown conversion error",
 52:         conversionTimeMs,
 53:       };
 54:     }
 55:   }
 56:   private async convertWithGotenberg(
 57:     docxBuffer: Buffer,
 58:     timeoutMs: number
 59:   ): Promise<DocxToPdfResult> {
 60:     const startTime = Date.now();
 61:     if (!this.gotenbergUrl) {
 62:       throw new Error("GOTENBERG_URL is not configured");
 63:     }
 64:     try {
 65:       const formData = new FormData();
 66:       const docxBlob = new Blob([docxBuffer], {
 67:         type: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
 68:       });
 69:       formData.append("files", docxBlob, "document.docx");
 70:       formData.append("pdfFormat", "PDF/A-1b");
 71:       formData.append("landscape", "false");
 72:       const controller = new AbortController();
 73:       const timeout = setTimeout(() => controller.abort(), timeoutMs);
 74:       const response = await fetch(
 75:         `${this.gotenbergUrl}/forms/libreoffice/convert`,
 76:         {
 77:           method: "POST",
 78:           body: formData,
 79:           signal: controller.signal,
 80:           headers: {
 81:           },
 82:         }
 83:       );
 84:       clearTimeout(timeout);
 85:       if (!response.ok) {
 86:         const errorText = await response.text().catch(() => "Unknown error");
 87:         throw new Error(
 88:           `Gotenberg conversion failed: ${response.status} ${errorText}`
 89:         );
 90:       }
 91:       const pdfBuffer = Buffer.from(await response.arrayBuffer());
 92:       const conversionTimeMs = Date.now() - startTime;
 93:       console.log(
 94:         `[DocxToPdf] Gotenberg conversion successful: ${conversionTimeMs}ms, output: ${pdfBuffer.length} bytes`
 95:       );
 96:       return {
 97:         success: true,
 98:         pdfBuffer,
 99:         conversionTimeMs,
100:       };
101:     } catch (error) {
102:       console.warn(
103:         `[DocxToPdf] Gotenberg failed, trying LibreOffice fallback:`,
104:         error
105:       );
106:       return await this.convertWithLibreOffice(docxBuffer, timeoutMs);
107:     }
108:   }
109:   private async convertWithLibreOffice(
110:     docxBuffer: Buffer,
111:     timeoutMs: number
112:   ): Promise<DocxToPdfResult> {
113:     const startTime = Date.now();
114:     const fs = await import("fs/promises");
115:     const path = await import("path");
116:     const os = await import("os");
117:     try {
118:       const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "docx-to-pdf-"));
119:       const inputPath = path.join(tempDir, "input.docx");
120:       const outputDir = path.join(tempDir, "output");
121:       await fs.mkdir(outputDir, { recursive: true });
122:       await fs.writeFile(inputPath, docxBuffer);
123:       const command = `soffice --headless --convert-to pdf --outdir "${outputDir}" "${inputPath}"`;
124:       console.log(`[DocxToPdf] Running LibreOffice command: ${command}`);
125:       const { stderr } = await execAsync(command, { timeout: timeoutMs });
126:       if (stderr && !stderr.includes("Warning")) {
127:         console.warn(`[DocxToPdf] LibreOffice warnings:`, stderr);
128:       }
129:       const outputPath = path.join(outputDir, "input.pdf");
130:       const pdfBuffer = await fs.readFile(outputPath);
131:       await fs.rm(tempDir, { recursive: true, force: true });
132:       const conversionTimeMs = Date.now() - startTime;
133:       console.log(
134:         `[DocxToPdf] LibreOffice conversion successful: ${conversionTimeMs}ms, output: ${pdfBuffer.length} bytes`
135:       );
136:       return {
137:         success: true,
138:         pdfBuffer,
139:         conversionTimeMs,
140:       };
141:     } catch (error) {
142:       const conversionTimeMs = Date.now() - startTime;
143:       console.error(
144:         `[DocxToPdf] LibreOffice conversion failed after ${conversionTimeMs}ms:`,
145:         error
146:       );
147:       throw new Error(
148:         `LibreOffice conversion failed: ${error instanceof Error ? error.message : "Unknown error"}`
149:       );
150:     }
151:   }
152:   async isAvailable(): Promise<boolean> {
153:     try {
154:       if (this.engine === "gotenberg" && this.gotenbergUrl) {
155:         const controller = new AbortController();
156:         const timeout = setTimeout(() => controller.abort(), 5000);
157:         const response = await fetch(`${this.gotenbergUrl}/health`, {
158:           signal: controller.signal,
159:         }).catch(() => null);
160:         clearTimeout(timeout);
161:         return response?.ok || false;
162:       } else {
163:         const { stdout } = await execAsync("soffice --version", {
164:           timeout: 5000,
165:         });
166:         return stdout.includes("LibreOffice");
167:       }
168:     } catch (error) {
169:       console.warn(`[DocxToPdf] Availability check failed:`, error);
170:       return false;
171:     }
172:   }
173: }
174: export const docxToPdfService = new DocxToPdfService();
</file>

