321:     try {
322:       let response: Awaited<ReturnType<typeof fetch>>;
323:       try {
324:         response = await fetch(
325:           `https:
326:           {
327:             method: "POST",
328:             headers: {
329:               "Content-Type": "application/json",
330:             },
331:             body: JSON.stringify({
332:               contents: [
333:                 {
334:                   role: "user",
335:                   parts: [
