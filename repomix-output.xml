284:   static async searchCollections(
285:     searchTerm: string,
286:     userId: string,
287:     limit: number = 10,
288:     skip: number = 0
289:   ) {
290:     try {
291:       const collections = await prisma.$queryRaw<CollectionAggregateRow[]>`
292:         SELECT
293:           c.id,
294:           c.name,
295:           c.description,
296:           c."isPublic",
297:           c."visibility"::text,
298:           c.tags,
299:           c."coverImage",
300:           c.color,
301:           c."createdAt",
302:           c."updatedAt",
303:           u.email as "ownerEmail",
304:           u.name as "ownerName",
305:           COALESCE(paper_counts.paper_count, 0)::int as "paperCount",
306:           COALESCE(member_counts.member_count, 0)::int as "memberCount",
307:           (
308:             CASE
309:               WHEN c.name ILIKE ${`%${searchTerm}%`} THEN 10
310:               ELSE 0
311:             END +
312:             CASE
313:               WHEN c.description ILIKE ${`%${searchTerm}%`} THEN 5
314:               ELSE 0
315:             END
316:           ) as relevance_score
317:         FROM "Collection" c
318:         LEFT JOIN "User" u ON c."ownerId" = u.id
319:         LEFT JOIN (
320:           SELECT "collectionId", COUNT(*)::int AS paper_count
321:           FROM "CollectionPaper"
322:           WHERE "isDeleted" = false
323:           GROUP BY "collectionId"
324:         ) paper_counts ON paper_counts."collectionId" = c.id
325:         LEFT JOIN (
326:           SELECT "collectionId", COUNT(*)::int AS member_count
327:           FROM "CollectionMember"
328:           WHERE "isDeleted" = false AND status = 'ACCEPTED'
329:           GROUP BY "collectionId"
330:         ) member_counts ON member_counts."collectionId" = c.id
331:         WHERE c."isDeleted" = false
332:           AND (
333:             c.name ILIKE ${`%${searchTerm}%`}
334:             OR c.description ILIKE ${`%${searchTerm}%`}
335:           )
336:           AND (
337:             c."ownerId" = ${userId}
338:             OR c.visibility IN ('TEAM', 'PUBLIC')
339:             OR EXISTS (
340:               SELECT 1 FROM "CollectionMember" m
341:               WHERE m."collectionId" = c.id
342:                 AND m."userId" = ${userId}
343:                 AND m."isDeleted" = false
344:                 AND m.status = 'ACCEPTED'
345:             )
346:           )
347:         ORDER BY relevance_score DESC, c."createdAt" DESC
348:         LIMIT ${limit} OFFSET ${skip}
349:       `;
350:       const transformedCollections = collections.map((collection) => ({
351:         ...collection,
352:         owner: {
353:           id: collection.ownerId,
354:           name: collection.ownerName || "Unknown",
355:           email: collection.ownerEmail || "unknown@example.com",
356:         },
357:         _count: {
358:           papers: collection.paperCount,
359:           members: collection.memberCount ?? 0,
360:         },
361:       }));
362:       return {
363:         result: transformedCollections,
364:         meta: {
365:           searchTerm,
366:           count: transformedCollections.length,
367:         },
368:       };
369:     } catch (error) {
370:       console.error("Error searching collections:", error);
371:       throw error;
372:     }
373:   }
374:   static async hasEditPermission(
375:     collectionId: string,
376:     userId: string
377:   ): Promise<boolean> {
378:     try {
379:       const result = await prisma.$queryRaw<
380:         Array<{ hasEditPermission: boolean }>
381:       >`
382:         SELECT
383:           CASE
384:             WHEN c."ownerId" = ${userId} THEN true
385:             WHEN cm."permission" = 'EDIT' AND cm.status = 'ACCEPTED' THEN true
386:             ELSE false
387:           END as "hasEditPermission"
388:         FROM "Collection" c
389:         LEFT JOIN "CollectionMember" cm ON c.id = cm."collectionId" AND cm."userId" = ${userId}
390:         WHERE c.id = ${collectionId} AND c."isDeleted" = false
391:         LIMIT 1
392:       `;
393:       return result[0]?.hasEditPermission === true;
394:     } catch (error) {
395:       console.error("Error checking edit permission:", error);
396:       throw error;
397:     }
398:   }
399:   static async getUserPermission(
400:     collectionId: string,
401:     userId: string
402:   ): Promise<"OWNER" | "EDIT" | "VIEW" | null> {
403:     try {
404:       const result = await prisma.$queryRaw<
405:         Array<{ permission: "OWNER" | "EDIT" | "VIEW" | null }>
406:       >`
407:         SELECT
408:           CASE
409:             WHEN c."ownerId" = ${userId} THEN 'OWNER'
410:             WHEN cm."permission" = 'EDIT' AND cm.status = 'ACCEPTED' THEN 'EDIT'
411:             WHEN cm."permission" = 'VIEW' AND cm.status = 'ACCEPTED' THEN 'VIEW'
412:             ELSE NULL
413:           END as "permission"
414:         FROM "Collection" c
415:         LEFT JOIN "CollectionMember" cm ON c.id = cm."collectionId" AND cm."userId" = ${userId}
416:         WHERE c.id = ${collectionId} AND c."isDeleted" = false
417:         LIMIT 1
418:       `;
419:       return result[0]?.permission || null;
420:     } catch (error) {
421:       console.error("Error getting user permission:", error);
422:       throw error;
423:     }
424:   }
425: }
426: export const collectionService = {
427:   getCollectionStats: CollectionService.getCollectionStats,
428:   getCollectionsWithCounts: CollectionService.getCollectionsWithCounts,
429:   getUserCollections: CollectionService.getUserCollections,
430:   searchCollections: CollectionService.searchCollections,
431:   hasEditPermission: CollectionService.hasEditPermission,
432:   getUserPermission: CollectionService.getUserPermission,
433: };
