172:                   ? "Your comment"
173:                   : annotationType === "NOTE"
174:                     ? "Your note"
175:                     : annotationType === "AREA"
176:                       ? "Area description"
177:                       : "Description"}
178:               {!isTextRequired(annotationType) && (
179:                 <span className="text-xs text-muted-foreground font-normal">
180:                   (optional)
181:                 </span>
182:               )}
183:             </label>
184:             <Textarea
185:               value={text}
186:               onChange={(e) => setText(e.target.value)}
187:               onKeyDown={handleKeyDown}
188:               placeholder={getPlaceholder(annotationType)}
189:               className="min-h-[120px] resize-none focus:ring-2 focus:ring-primary"
190:               autoFocus
191:             />
192:             <div className="flex items-center justify-between text-xs text-muted-foreground">
193:               <span>Press Ctrl+Enter to save, Esc to cancel</span>
194:               <span>{text.length} / 5000</span>
