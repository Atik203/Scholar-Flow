 16: async function assertPaperAccess(
 17:   paperId: string,
 18:   userId: string
 19: ): Promise<boolean> {
 20:   const access = await prisma.$queryRaw<Array<{ allowed: boolean }>>`
 21:     SELECT EXISTS (
 22:       SELECT 1
 23:       FROM "Paper" p
 24:       LEFT JOIN "Workspace" w
 25:         ON w.id = p."workspaceId" AND w."isDeleted" = false
 26:       LEFT JOIN "WorkspaceMember" m
 27:         ON m."workspaceId" = p."workspaceId"
 28:         AND m."userId" = ${userId}
 29:         AND m."isDeleted" = false
 30:       WHERE p.id = ${paperId}
 31:         AND p."isDeleted" = false
 32:         AND (
 33:           p."uploaderId" = ${userId}
 34:           OR w."ownerId" = ${userId}
 35:           OR m.id IS NOT NULL
 36:         )
 37:     ) AS "allowed"
 38:   `;
 39:   return access[0]?.allowed === true;
 40: }
