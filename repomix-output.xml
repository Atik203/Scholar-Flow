549:   private static formatAuthorsAPA(authors: string[]): string {
550:     if (authors.length === 1) return authors[0];
551:     if (authors.length === 2) return `${authors[0]} & ${authors[1]}`;
552:     if (authors.length <= 7)
553:       return `${authors.slice(0, -1).join(", ")}, & ${authors[authors.length - 1]}`;
