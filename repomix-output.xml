163: const formatTimeAgo = (dateString: string) => {
164:   const date = new Date(dateString);
165:   const now = new Date();
166:   const diffMs = now.getTime() - date.getTime();
167:   const diffMins = Math.floor(diffMs / 60000);
168:   const diffHours = Math.floor(diffMs / 3600000);
169:   const diffDays = Math.floor(diffMs / 86400000);
170:   if (diffMins < 1) return "Just now";
171:   if (diffMins < 60) return `${diffMins}m ago`;
172:   if (diffHours < 24) return `${diffHours}h ago`;
173:   if (diffDays < 7) return `${diffDays}d ago`;
174:   return date.toLocaleDateString();
