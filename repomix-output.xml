257:   async streamMessage(
258:     conversationId: string,
259:     userId: string,
260:     content: string,
261:     onEvent: (token: string, done: boolean) => void
262:   ) {
263:     const conv = await prisma.aIConversation.findUnique({
264:       where: { id: conversationId },
265:       select: { userId: true, model: true, context: true },
266:     });
267:     if (!conv) throw new AiError(404, "Conversation not found");
268:     if (conv.userId !== userId) throw new AiError(403, "Forbidden");
269:     await prisma.aIConversationMessage.create({
270:       data: { conversationId, role: "user", content },
271:     });
272:     const updatedConv = await prisma.aIConversation.findUnique({
273:       where: { id: conversationId },
274:       include: {
275:         messages: {
276:           orderBy: { createdAt: "asc" },
277:           select: { role: true, content: true },
278:           take: 15,
279:         },
280:       },
281:     });
282:     if (!updatedConv) throw new Error("Conversation not found");
283:     const contextMessages = await buildContextMessages(conv.context as any, userId);
284:     const allMessages = [
285:       ...contextMessages,
286:       ...((updatedConv.messages || []).map((m) => ({ role: m.role, content: m.content }))),
287:     ];
288:     const msgs = allMessages.map((m: { role: string; content: string }) => ({
289:       role: m.role as "user" | "assistant" | "system",
290:       content: m.content,
291:     }));
292:     const tokens: string[] = [];
293:     const result = await streamFromProvider(
294:       msgs,
295:       updatedConv.model ?? undefined,
296:       (token: string) => {
297:         tokens.push(token);
298:         onEvent(token, false);
299:       }
300:     );
301:     const fullContent = tokens.join("");
302:     const resolved = await resolveProviderForModel(updatedConv.model ?? "");
303:     const costCents = estimateCost(result.inputTokens, result.outputTokens, resolved);
304:     await prisma.aIConversationMessage.create({
305:       data: {
306:         conversationId,
307:         role: "assistant",
308:         content: fullContent,
309:         model: result.model,
310:         tokensUsed: result.outputTokens,
311:         costCents,
312:       },
313:     });
314:     if (!updatedConv.title || updatedConv.title === "New Chat") {
315:       const firstMsg = updatedConv.messages?.[0];
316:       if (firstMsg) {
317:         await prisma.aIConversation.update({
318:           where: { id: conversationId },
319:           data: { title: firstMsg.content.slice(0, 60) },
320:         });
321:       }
322:     }
323:     onEvent(fullContent, true);
324:   },
