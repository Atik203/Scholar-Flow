299:           : validated.tokensUsed;
300:       const tokensUsed = Number.isFinite(rawTokens ?? NaN)
301:         ? (rawTokens as number)
302:         : tokens;
303:       return {
304:         provider: this.name,
305:         summary: validated.summary.trim(),
306:         highlights,
307:         followUpQuestions: followUps,
308:         rawResponse: raw,
309:         tokensUsed: tokensUsed ?? undefined,
310:       };
311:     } catch (error) {
312:       if (error instanceof APIError) {
313:         throw new AiError(
314:           error.status ?? 500,
315:           error.message,
316:           error.code ?? undefined
317:         );
318:       }
319:       if (error instanceof Error) {
320:         throw new AiError(502, error.message, "AI_PROVIDER_ERROR", error.stack);
321:       }
322:       throw new AiError(
323:         502,
324:         "OpenAI summary generation failed",
325:         "AI_PROVIDER_ERROR"
326:       );
327:     }
328:   }
329:   protected async performInsight(
330:     input: AiInsightRequest
331:   ): Promise<AiInsightResult> {
332:     if (!this.client) {
333:       throw new AiError(
334:         503,
335:         "OpenAI provider not configured",
336:         "AI_PROVIDER_DISABLED"
337:       );
338:     }
339:     try {
340:       const requestedModel = input.model || DEFAULT_MODEL;
341:       const messages: Array<{
342:         role: "system" | "user" | "assistant";
343:         content: string;
344:       }> = [
345:         {
346:           role: "system",
347:           content:
348:             "You are a senior research mentor helping a scholar interpret and apply insights from a paper. Always return a JSON object with keys: answer (string), suggestions (array of strings), tokensUsed (number).",
349:         },
350:       ];
351:       const trimmedContext = (input.context || "").trim();
352:       if (trimmedContext) {
353:         messages.push({
354:           role: "system",
355:           content: `Paper context:\n${trimmedContext}`,
356:         });
357:       }
358:       if (Array.isArray(input.history)) {
359:         messages.push(
360:           ...input.history.map((message) => ({
361:             role: message.role,
362:             content: String(message.content ?? ""),
363:           }))
364:         );
365:       }
366:       messages.push({ role: "user", content: input.prompt });
367:       const modelToUse = this.resolveModel(requestedModel);
368:       const { payload, raw, tokens } = await this.callStructuredJson(
369:         {
370:           model: modelToUse,
371:           messages,
372:           temperature: 0.4,
373:           maxTokens: 900,
374:           responseSchema: INSIGHT_RESPONSE_SCHEMA,
375:         },
376:         insightSchema,
377:         (parsed: unknown) => {
378:           if (Array.isArray(parsed)) {
379:             return { answer: JSON.stringify(parsed) };
380:           }
381:           if (parsed && typeof parsed === "object" && !("answer" in (parsed as Record<string, unknown>))) {
382:             return { answer: JSON.stringify(parsed) };
383:           }
384:           return parsed;
385:         }
386:       );
387:       const validated = payload as RawInsight;
388:       const suggestions = normalizeStringList(validated.suggestions, 4);
389:       const rawTokens =
390:         typeof validated.tokensUsed === "string"
391:           ? Number(validated.tokensUsed)
392:           : validated.tokensUsed;
393:       const tokensUsed = Number.isFinite(rawTokens ?? NaN)
394:         ? (rawTokens as number)
395:         : tokens;
396:       return {
397:         provider: this.name,
398:         message: {
399:           role: "assistant",
400:           content: validated.answer.trim(),
401:         },
402:         suggestions: suggestions,
403:         rawResponse: raw,
404:         tokensUsed: tokensUsed ?? undefined,
405:       };
406:     } catch (error) {
407:       if (error instanceof APIError) {
408:         throw new AiError(
409:           error.status ?? 500,
410:           error.message,
411:           error.code ?? undefined
412:         );
413:       }
414:       if (error instanceof Error) {
415:         throw new AiError(502, error.message, "AI_PROVIDER_ERROR", error.stack);
416:       }
417:       throw new AiError(
418:         502,
419:         "OpenAI insight generation failed",
420:         "AI_PROVIDER_ERROR"
421:       );
422:     }
423:   }
424:   private resolveModel(model?: string): string {
425:     if (model && isValidModel(model)) {
426:       return model;
427:     }
428:     return DEFAULT_MODEL;
429:   }
430:   private useResponsesApi(model: string): boolean {
431:     return false;
432:   }
433:   private async callStructuredJson<T>(
434:     params: {
435:       model?: string;
436:       messages: Array<{
437:         role: "system" | "user" | "assistant";
438:         content: string;
439:       }>;
440:       temperature: number;
441:       maxTokens: number;
442:       responseSchema?: {
443:         name: string;
444:         schema: Record<string, unknown>;
445:         strict?: boolean;
446:       };
447:     },
448:     validator: z.ZodType<T>,
449:     normalize?: (parsed: unknown) => unknown
450:   ): Promise<{ payload: T; raw: unknown; tokens?: number }> {
451:     if (!this.client) {
452:       throw new AiError(
453:         503,
454:         "OpenAI provider not configured",
455:         "AI_PROVIDER_DISABLED"
456:       );
457:     }
458:     const modelToUse = this.resolveModel(params.model);
459:     const responseFormat: ResponsesResponseFormat | undefined =
460:       params.responseSchema
461:         ? {
462:             type: "json_schema",
463:             json_schema: params.responseSchema,
464:           }
465:         : undefined;
466:     if (this.useResponsesApi(modelToUse) && this.client.responses) {
467:       const input = params.messages.map((message) => ({
468:         role: message.role,
469:         content: [{ type: "text", text: message.content }],
470:       })) as unknown as ResponsesInput;
471:       const responsesClient = this.client.responses as unknown as {
472:         create: (body: Record<string, unknown>) => Promise<unknown>;
473:       };
474:       const requestBody: Record<string, unknown> = {
475:         model: modelToUse,
476:         temperature: params.temperature,
477:         max_output_tokens: params.maxTokens,
478:         input,
479:       };
480:       if (responseFormat) {
481:         requestBody.text = {
482:           format: responseFormat as unknown,
483:         };
484:       }
485:       const response = await responsesClient.create(requestBody);
486:       const text = this.extractResponseText(response);
487:       const parsed = this.safeParseJson(text);
488:       const normalized = normalize ? normalize(parsed) : parsed;
489:       const payload = validator.parse(normalized) as T;
490:       const tokens = this.extractTokenUsage((response as any).usage);
491:       return { payload, raw: response, tokens };
492:     }
493:     const completion = await this.client.chat.completions.create({
494:       model: modelToUse,
495:       temperature: params.temperature,
496:       max_tokens: params.maxTokens,
497:       messages: params.messages,
498:     });
499:     const messageContent = completion.choices[0]?.message?.content ?? "";
500:     const parsed = this.safeParseJson(messageContent);
501:     const normalized = normalize ? normalize(parsed) : parsed;
502:     const payload = validator.parse(normalized) as T;
503:     const tokens = this.extractTokenUsage(completion.usage);
504:     return { payload, raw: completion, tokens };
505:   }
506:   private extractResponseText(response: unknown): string {
507:     if (!response || typeof response !== "object") {
508:       return "";
509:     }
510:     const outputText = (response as { output_text?: string }).output_text;
511:     if (typeof outputText === "string" && outputText.trim()) {
512:       return outputText;
513:     }
514:     const output = (response as { output?: unknown }).output;
515:     if (Array.isArray(output)) {
516:       for (const item of output) {
517:         if (
518:           item &&
519:           typeof item === "object" &&
520:           Array.isArray((item as { content?: unknown[] }).content)
521:         ) {
522:           for (const part of (item as { content: Array<{ text?: string }> })
523:             .content) {
524:             if (part && typeof part.text === "string" && part.text.trim()) {
525:               return part.text;
526:             }
527:           }
528:         }
529:       }
530:     }
531:     const choices = (response as { choices?: unknown[] }).choices;
532:     if (Array.isArray(choices) && choices.length > 0) {
533:       const firstChoice = choices[0] as
534:         | { message?: { content?: string | Array<{ text?: string }> } }
535:         | undefined;
536:       const content = firstChoice?.message?.content;
537:       if (typeof content === "string" && content.trim()) {
538:         return content;
539:       }
540:       if (Array.isArray(content)) {
541:         return content
542:           .map((entry) =>
543:             entry && typeof entry.text === "string" ? entry.text : ""
544:           )
545:           .join("")
546:           .trim();
547:       }
548:     }
549:     return "";
550:   }
551:   private extractTokenUsage(usage: unknown): number | undefined {
552:     if (!usage || typeof usage !== "object") {
553:       return undefined;
554:     }
555:     const total = (usage as { total_tokens?: number }).total_tokens;
556:     if (typeof total === "number") {
557:       return total;
558:     }
559:     const promptTokens =
560:       (
561:         usage as {
562:           prompt_tokens?: number;
563:           input_tokens?: number;
564:         }
565:       ).prompt_tokens ?? (usage as { input_tokens?: number }).input_tokens;
566:     const completionTokens =
567:       (
568:         usage as {
569:           completion_tokens?: number;
570:           output_tokens?: number;
571:           response_tokens?: number;
572:         }
573:       ).completion_tokens ??
574:       (usage as { output_tokens?: number }).output_tokens ??
575:       (usage as { response_tokens?: number }).response_tokens;
576:     const prompt = typeof promptTokens === "number" ? promptTokens : 0;
577:     const completion =
578:       typeof completionTokens === "number" ? completionTokens : 0;
579:     if (prompt === 0 && completion === 0) {
580:       return undefined;
581:     }
582:     return prompt + completion;
583:   }
584:   private buildPrompt(input: AiMetadataExtractionInput) {
585:     return [
586:       "Extract structured metadata for an academic paper.",
587:       "Respond with JSON containing: title (string), abstract (string),",
588:       "authors (array of strings), year (number), doi (string | null),",
589:       "keywords (array of strings), source (string), confidence (0-1).",
590:       input.originalTitle
591:         ? `Original title suggestion: ${input.originalTitle}`
592:         : undefined,
593:       input.existingMetadata
594:         ? `Existing metadata (JSON): ${JSON.stringify(input.existingMetadata)}`
595:         : undefined,
596:       "---",
597:       input.text,
598:     ]
599:       .filter(Boolean)
600:       .join("\n");
601:   }
602:   private buildSummaryPrompt(input: AiSummaryRequest) {
603:     const wordLimit = input.wordLimit ?? 220;
604:     const audience = input.audience ?? "researcher";
605:     const tone = input.tone ?? "academic";
606:     const focusText =
607:       input.focusAreas && input.focusAreas.length > 0
608:         ? `Focus on: ${input.focusAreas.join(", ")}`
609:         : undefined;
610:     const instructions = [
611:       `Summarise the following academic paper for a ${audience} audience.`,
612:       `Adopt a ${tone} tone.`,
613:       `Limit the overview to approximately ${wordLimit} words.`,
614:       "Return JSON with keys: summary (string), highlights (array of strings with 3-5 bullet points), followUpQuestions (array of 2-4 thoughtful next questions).",
615:       input.language
616:         ? `Respond in ${input.language}.`
617:         : "Respond in the same language as the source material if clear, otherwise use English.",
618:       focusText,
619:       input.instructions
620:         ? `Additional instructions: ${input.instructions}`
621:         : undefined,
622:       "---",
623:       input.text,
624:     ];
625:     return instructions.filter(Boolean).join("\n");
626:   }
627:   private safeParseJson(content: string): unknown {
628:     try {
629:       return JSON.parse(content);
630:     } catch (error) {
631:       const fallback = content.replace(/```json|```/g, "").trim();
632:       try {
633:         return JSON.parse(fallback);
634:       } catch (err) {
635:         throw new AiError(
636:           500,
637:           "Unable to parse AI JSON response",
638:           "AI_RESPONSE_PARSE_ERROR"
639:         );
640:       }
641:     }
642:   }
643:   private normalizeMetadata(payload: RawMetadata): AiMetadata {
644:     const rawAuthors = payload.authors as unknown;
645:     const authors = Array.isArray(rawAuthors)
646:       ? rawAuthors
647:           .map((author) =>
648:             typeof author === "string" ? author.trim() : String(author ?? "")
649:           )
650:           .filter((author) => author.length > 0)
651:       : typeof rawAuthors === "string"
652:         ? rawAuthors
653:             .split(/,|;|\band\b/gi)
654:             .map((author: string) => author.trim())
655:             .filter((author) => author.length > 0)
656:         : [];
657:     const yearValue = Number(payload.year);
658:     const year = Number.isFinite(yearValue) ? yearValue : undefined;
659:     const confidenceValue = Number(payload.confidence);
660:     const confidence = Number.isFinite(confidenceValue)
661:       ? Math.min(Math.max(confidenceValue, 0), 1)
662:       : undefined;
663:     const rawKeywords = payload.keywords as unknown;
664:     const keywords = Array.isArray(rawKeywords)
665:       ? rawKeywords
666:           .map((keyword) =>
667:             typeof keyword === "string" ? keyword.trim() : String(keyword ?? "")
668:           )
669:           .filter((keyword) => keyword.length > 0)
670:       : typeof rawKeywords === "string"
671:         ? rawKeywords
672:             .split(/,|;|\band\b/gi)
673:             .map((keyword: string) => keyword.trim())
674:             .filter((keyword) => keyword.length > 0)
675:         : [];
676:     return {
677:       title: payload.title?.toString().trim(),
678:       abstract: payload.abstract?.toString().trim(),
679:       authors,
680:       year,
681:       doi: payload.doi?.toString().trim() || undefined,
682:       keywords,
683:       source: payload.source?.toString().trim(),
684:       confidence,
685:     };
686:   }
687: }
</file>

