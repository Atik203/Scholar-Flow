  7: import * as React from "react";
  8: import { toast } from "sonner";
  9: export interface FileItem {
 10:   id: string;
 11:   file: File;
 12:   progress: number;
 13:   status: "uploading" | "success" | "error";
 14:   url?: string;
 15:   abortController?: AbortController;
 16: }
 17: export interface UploadOptions {
 18:   maxSize: number;
 19:   limit: number;
 20:   accept: string;
 21:   upload: (
 22:     file: File,
 23:     onProgress: (event: { progress: number }) => void,
 24:     signal: AbortSignal
 25:   ) => Promise<string>;
 26:   onSuccess?: (url: string) => void;
 27:   onError?: (error: Error) => void;
 28: }
 29: function useFileUpload(options: UploadOptions) {
 30:   const [fileItems, setFileItems] = React.useState<FileItem[]>([]);
 31:   const uploadFile = async (file: File): Promise<string | null> => {
 32:     if (file.size > options.maxSize) {
 33:       const error = new Error(
 34:         `File size exceeds maximum allowed (${options.maxSize / 1024 / 1024}MB)`
 35:       );
 36:       options.onError?.(error);
 37:       return null;
 38:     }
 39:     const abortController = new AbortController();
 40:     const fileId = crypto.randomUUID();
 41:     const newFileItem: FileItem = {
 42:       id: fileId,
 43:       file,
 44:       progress: 0,
 45:       status: "uploading",
 46:       abortController,
 47:     };
 48:     setFileItems((prev) => [...prev, newFileItem]);
 49:     try {
 50:       const url = await options.upload(
 51:         file,
 52:         (event) => {
 53:           if (!abortController.signal.aborted) {
 54:             setFileItems((prev) =>
 55:               prev.map((item) =>
 56:                 item.id === fileId
 57:                   ? { ...item, progress: event.progress }
 58:                   : item
 59:               )
 60:             );
 61:           }
 62:         },
 63:         abortController.signal
 64:       );
 65:       if (!abortController.signal.aborted) {
 66:         setFileItems((prev) =>
 67:           prev.map((item) =>
 68:             item.id === fileId
 69:               ? { ...item, status: "success", url, progress: 100 }
 70:               : item
 71:           )
 72:         );
 73:         options.onSuccess?.(url);
 74:         return url;
 75:       }
 76:       return null;
 77:     } catch (error) {
 78:       if (!abortController.signal.aborted) {
 79:         setFileItems((prev) =>
 80:           prev.map((item) =>
 81:             item.id === fileId
 82:               ? { ...item, status: "error", progress: 0 }
 83:               : item
 84:           )
 85:         );
 86:         toast.error(
 87:           `Failed to upload ${file.name}: ${error instanceof Error ? error.message : "Unknown error"}`
 88:         );
 89:         options.onError?.(
 90:           error instanceof Error ? error : new Error("Upload failed")
 91:         );
 92:       }
 93:       return null;
 94:     }
 95:   };
 96:   const uploadFiles = async (files: File[]): Promise<string[]> => {
 97:     if (!files || files.length === 0) {
 98:       options.onError?.(new Error("No files to upload"));
 99:       return [];
100:     }
101:     if (options.limit && files.length > options.limit) {
102:       options.onError?.(
103:         new Error(
104:           `Maximum ${options.limit} file${options.limit === 1 ? "" : "s"} allowed`
105:         )
106:       );
107:       return [];
108:     }
109:     const uploadPromises = files.map((file) => uploadFile(file));
110:     const results = await Promise.all(uploadPromises);
111:     return results.filter((url): url is string => url !== null);
112:   };
113:   const removeFileItem = (fileId: string) => {
114:     setFileItems((prev) => {
115:       const fileToRemove = prev.find((item) => item.id === fileId);
116:       if (fileToRemove?.abortController) {
117:         fileToRemove.abortController.abort();
118:       }
119:       if (fileToRemove?.url) {
120:         URL.revokeObjectURL(fileToRemove.url);
121:       }
122:       return prev.filter((item) => item.id !== fileId);
123:     });
124:   };
125:   const clearAllFiles = () => {
126:     fileItems.forEach((item) => {
127:       if (item.abortController) {
128:         item.abortController.abort();
129:       }
130:       if (item.url) {
131:         URL.revokeObjectURL(item.url);
132:       }
133:     });
134:     setFileItems([]);
135:   };
136:   return {
137:     fileItems,
138:     uploadFiles,
139:     removeFileItem,
140:     clearAllFiles,
141:   };
142: }
