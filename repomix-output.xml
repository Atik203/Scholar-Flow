 17: export class CollectionService {
 18:   static async getCollectionStats() {
 19:     try {
 20:       const stats = await prisma.$queryRaw<
 21:         Array<{
 22:           totalCollections: number;
 23:           publicCollections: number;
 24:           privateCollections: number;
 25:           avgPapersPerCollection: number;
 26:         }>
 27:       >`
 28:         SELECT
 29:           COUNT(*)::int as "totalCollections",
 30:           COUNT(CASE WHEN "isPublic" = true THEN 1 END)::int as "publicCollections",
 31:           COUNT(CASE WHEN "isPublic" = false THEN 1 END)::int as "privateCollections",
 32:           COALESCE(AVG(paper_counts.paper_count), 0)::float as "avgPapersPerCollection"
 33:         FROM "Collection" c
 34:         LEFT JOIN (
 35:           SELECT "collectionId", COUNT(*) as paper_count
 36:           FROM "CollectionPaper"
 37:           GROUP BY "collectionId"
 38:         ) paper_counts ON c.id = paper_counts."collectionId"
 39:         WHERE c."isDeleted" = false
 40:       `;
 41:       return (
 42:         stats[0] || {
 43:           totalCollections: 0,
 44:           publicCollections: 0,
 45:           privateCollections: 0,
 46:           avgPapersPerCollection: 0,
 47:         }
 48:       );
 49:     } catch (error) {
 50:       console.error("Error getting collection stats:", error);
 51:       throw error;
 52:     }
 53:   }
 54:   static async getCollectionsWithCounts(
 55:     limit: number = 10,
 56:     skip: number = 0,
 57:     isPublic?: boolean
 58:   ) {
 59:     try {
 60:       const visibilityFilter =
 61:         isPublic !== undefined
 62:           ? Prisma.sql`AND c."isPublic" = ${isPublic}`
 63:           : Prisma.empty;
 64:       const collections = await prisma.$queryRaw<CollectionAggregateRow[]>`
 65:         SELECT
 66:           c.id,
 67:           c.name,
 68:           c.description,
 69:           c."isPublic",
 70:           c."createdAt",
 71:           c."updatedAt",
 72:           c."ownerId",
 73:           c."workspaceId",
 74:           u.email as "ownerEmail",
 75:           u.name as "ownerName",
 76:           COALESCE(paper_counts.paper_count, 0)::int as "paperCount",
 77:           COALESCE(member_counts.member_count, 0)::int as "memberCount"
 78:         FROM "Collection" c
 79:         LEFT JOIN "User" u ON c."ownerId" = u.id
 80:         LEFT JOIN (
 81:           SELECT "collectionId", COUNT(*)::int AS paper_count
 82:           FROM "CollectionPaper"
 83:           WHERE "isDeleted" = false
 84:           GROUP BY "collectionId"
 85:         ) paper_counts ON paper_counts."collectionId" = c.id
 86:         LEFT JOIN (
 87:           SELECT "collectionId", COUNT(*)::int AS member_count
 88:           FROM "CollectionMember"
 89:           WHERE "isDeleted" = false AND status = 'ACCEPTED'
 90:           GROUP BY "collectionId"
 91:         ) member_counts ON member_counts."collectionId" = c.id
 92:         WHERE c."isDeleted" = false
 93:         ${visibilityFilter}
 94:         ORDER BY c."createdAt" DESC
 95:         LIMIT ${limit} OFFSET ${skip}
 96:       `;
 97:       const totalCount = await prisma.$queryRaw<Array<{ count: number }>>`
 98:         SELECT COUNT(*)::int as count
 99:         FROM "Collection" c
100:         WHERE c."isDeleted" = false
101:         ${visibilityFilter}
102:       `;
103:       const total = totalCount[0]?.count || 0;
104:       const page = Math.floor(skip / limit) + 1;
105:       const totalPage = Math.ceil(total / limit);
106:       const transformedCollections = collections.map((collection) => ({
107:         ...collection,
108:         owner: {
109:           id: collection.ownerId,
110:           name: collection.ownerName || "Unknown",
111:           email: collection.ownerEmail || "unknown@example.com",
112:         },
113:         _count: {
114:           papers: collection.paperCount,
115:           members: collection.memberCount ?? 0,
116:         },
117:       }));
118:       return {
119:         result: transformedCollections,
