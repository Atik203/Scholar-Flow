 17: };
 18: const formatAmount = (cents: number, currency: string) =>
 19:   `${currency === "USD" ? "$" : ""}${(cents / 100).toFixed(2)}${currency !== "USD" ? ` ${currency}` : ""}`;
 20: export default function AdminPaymentsPage() {
 21:   const [searchInput, setSearchInput] = useState("");
 22:   const [search, setSearch] = useState("");
 23:   const [page, setPage] = useState(1);
 24:   const [refundingId, setRefundingId] = useState<string | null>(null);
 25:   const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);
 26:   // 300ms debounce — a request per keystroke is wasteful on a paginated list
 27:   useEffect(() => {
 28:     if (debounceRef.current) clearTimeout(debounceRef.current);
 29:     debounceRef.current = setTimeout(() => {
 30:       setSearch(searchInput.trim());
 31:       setPage(1);
 32:     }, 300);
 33:     return () => {
 34:       if (debounceRef.current) clearTimeout(debounceRef.current);
 35:     };
 36:   }, [searchInput]);
 37:   const { data, isLoading, refetch } = useListPaymentsQuery({
 38:     page,
 39:     limit: 25,
 40:     search: search || undefined,
 41:   });
 42:   const [refund] = useRefundPaymentMutation();
 43:   const payments = data?.data ?? [];
 44:   const total = data?.meta?.total ?? 0;
 45:   const totalPages = data?.meta?.totalPage ?? 1;
