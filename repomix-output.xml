1458:       <body>
1459:         <h1>${paper.title}</h1>
1460:         <p><em>Created: ${paper.createdAt.toLocaleDateString()}</em></p>
1461:         <p><em>Last Updated: ${paper.updatedAt.toLocaleDateString()}</em></p>
