694:   const getProgressColor = (percent: number) => {
695:     if (percent >= 90) return "[&>div]:bg-red-500 dark:[&>div]:bg-red-400";
696:     if (percent >= 75) return "[&>div]:bg-amber-500 dark:[&>div]:bg-amber-400";
697:     if (percent >= 50) return "[&>div]:bg-blue-500 dark:[&>div]:bg-blue-400";
698:     return "[&>div]:bg-green-500 dark:[&>div]:bg-green-400";
699:   };
700:   return (
