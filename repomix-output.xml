 66:     expect(result.followUpQuestions).toEqual(["Next step?"]);
 67:     expect(result.tokensUsed).toBe(321);
 68:     expect(fetchMock).toHaveBeenCalledTimes(1);
 69:     const [, fetchOptions] = fetchMock.mock.calls[0] as [string, RequestInit];
 70:     const payload = JSON.parse((fetchOptions?.body as string) ?? "{}");
 71:     expect(payload.contents[0].parts[0].text).toContain(
 72:       "Section 1 discusses methodology"
 73:     );
 74:   });
 75:   it("strips code fences and parses JSON content", async () => {
 76:     fetchMock.mockResolvedValueOnce(
 77:       new Response(
 78:         JSON.stringify({
 79:           candidates: [
 80:             {
 81:               content: {
 82:                 parts: [
 83:                   {
 84:                     text: '```json\n{"summary":"Fenced summary","highlights":["Key insight"],"followUpQuestions":["What else?"]}\n```',
 85:                   },
 86:                 ],
 87:               },
 88:             },
 89:           ],
 90:           usageMetadata: { totalTokenCount: 88 },
 91:         }),
 92:         {
 93:           status: 200,
 94:           headers: { "Content-Type": "application/json" },
 95:         }
 96:       )
 97:     );
 98:     const result = await provider.generate(buildRequest());
 99:     expect(result.summary).toBe("Fenced summary");
100:     expect(result.highlights).toEqual(["Key insight"]);
101:     expect(result.followUpQuestions).toEqual(["What else?"]);
102:     expect(result.tokensUsed).toBe(88);
103:   });
104:   it("falls back to plain text when JSON parsing fails", async () => {
