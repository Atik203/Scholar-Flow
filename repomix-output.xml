418:   async extractAndPersistMetadata(options: MetadataPersistOptions) {
419:     const {
420:       paperId,
421:       text,
422:       originalTitle,
423:       existingMetadata,
424:       currentTitle,
425:       currentAbstract,
426:     } = options;
427:     if (!config.ai.featuresEnabled) {
428:       return { applied: false, provider: "heuristic" };
429:     }
430:     const extractionResult = await this.extractMetadata({
431:       text,
432:       originalTitle,
433:       existingMetadata,
434:       workspaceId: options.workspaceId,
435:       uploaderId: options.uploaderId,
436:       timeoutMs: config.ai.requestTimeoutMs,
437:     });
438:     const metadata = extractionResult.metadata;
439:     if (!metadata) {
440:       return { applied: false, provider: extractionResult.provider };
441:     }
442:     const combinedMetadata = {
443:       ...(existingMetadata || {}),
444:       ...metadata,
445:       aiProvider: extractionResult.provider,
446:       aiUpdatedAt: new Date().toISOString(),
447:     };
448:     const shouldUpdateTitle =
449:       Boolean(metadata.title) && shouldReplaceValue(currentTitle);
450:     const shouldUpdateAbstract =
451:       Boolean(metadata.abstract) && shouldReplaceValue(currentAbstract);
452:     const nextTitle = shouldUpdateTitle ? metadata.title : currentTitle;
453:     const nextAbstract = shouldUpdateAbstract
454:       ? metadata.abstract
455:       : currentAbstract;
456:     const combinedMetadataJson = JSON.stringify(combinedMetadata);
457:     const existingMetadataJson = JSON.stringify(existingMetadata || {});
458:     if (
459:       nextTitle === currentTitle &&
460:       nextAbstract === currentAbstract &&
461:       combinedMetadataJson === existingMetadataJson
462:     ) {
463:       return {
464:         applied: false,
465:         provider: extractionResult.provider,
466:         metadata,
467:       };
468:     }
469:     await prisma.$executeRaw`
470:       UPDATE "Paper"
471:       SET title = ${nextTitle},
472:           abstract = ${nextAbstract},
473:           metadata = ${combinedMetadataJson}::jsonb,
474:           "updatedAt" = NOW()
475:       WHERE id = ${paperId}
476:     `;
477:     return {
478:       applied: true,
479:       provider: extractionResult.provider,
480:       metadata,
481:     };
