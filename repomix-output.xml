22:   collections?: { total: number; items: SearchResultItem[] };
23:   workspaces?: { total: number; items: SearchResultItem[] };
24: }
25: export interface GlobalSearchResponse {
26:   success: boolean;
27:   message: string;
28:   meta: {
29:     page: number;
30:     limit: number;
31:     total: number;
32:   };
33:   data: SearchResults;
34: }
35: export interface SearchHistory {
36:   id: string;
37:   query: string;
38:   filters: any;
39:   createdAt: string;
40: }
41: export interface SearchHistoryResponse {
42:   success: boolean;
43:   meta: any;
44:   data: SearchHistory[];
45: }
46: export interface DiscoveryResponse {
47:   success: boolean;
48:   data: SearchResultItem[];
49: }
50: export const searchApi = apiSlice.injectEndpoints({
51:   endpoints: (builder) => ({
52:     globalSearch: builder.query<GlobalSearchResponse, GlobalSearchQuery>({
53:       query: (params) => {
54:         const queryParams = new URLSearchParams();
55:         if (params.q) queryParams.append('q', params.q);
56:         if (params.type) queryParams.append('type', params.type);
57:         if (params.page) queryParams.append('page', params.page.toString());
58:         if (params.limit) queryParams.append('limit', params.limit.toString());
59:         if (params.workspaceId) queryParams.append('workspaceId', params.workspaceId);
60:         return `/search?${queryParams.toString()}`;
61:       },
62:       keepUnusedDataFor: 60,
63:     }),
64:     getSearchHistory: builder.query<SearchHistoryResponse, { page?: number; limit?: number }>({
65:       query: (params) => {
66:         const queryParams = new URLSearchParams();
67:         if (params.page) queryParams.append('page', params.page.toString());
68:         if (params.limit) queryParams.append('limit', params.limit.toString());
69:         return `/search/history?${queryParams.toString()}`;
70:       },
71:       providesTags: ['SearchHistory']
72:     }),
73:     saveSearchQuery: builder.mutation<any, { query: string; filters?: any; results?: any }>({
