 50:       CheckoutSessionResponse,
 51:       CheckoutSessionRequest
 52:     >({
 53:       query: (body) => ({
 54:         url: "/billing/checkout-session",
 55:         method: "POST",
 56:         body,
 57:       }),
 58:       invalidatesTags: ["User"],
 59:       extraOptions: { maxRetries: 0 },
 60:     }),
 61:     createPortalSession: builder.mutation<
 62:       PortalSessionResponse,
 63:       PortalSessionRequest
 64:     >({
 65:       query: (body) => ({
 66:         url: "/billing/customer-portal",
 67:         method: "POST",
 68:         body,
 69:       }),
 70:     }),
 71:     getSubscription: builder.query<
 72:       Subscription | null,
 73:       { workspaceId?: string }
 74:     >({
 75:       query: ({ workspaceId }) => ({
 76:         url: "/billing/subscription",
 77:         params: workspaceId ? { workspaceId } : undefined,
 78:       }),
 79:       transformResponse: (response: {
 80:         success: boolean;
 81:         data: Subscription | null;
 82:       }) => response.data,
 83:       providesTags: ["User"],
 84:       keepUnusedDataFor: 60,
 85:     }),
 86:     managePlan: builder.mutation<{ message: string }, ManagePlanRequest>({
 87:       query: (body) => ({
 88:         url: "/billing/manage-plan",
 89:         method: "POST",
 90:         body,
 91:       }),
 92:       async onQueryStarted(arg, { dispatch, queryFulfilled }) {
 93:         const patchResult = dispatch(
 94:           billingApi.util.updateQueryData(
 95:             "getSubscription",
 96:             { workspaceId: arg.workspaceId },
