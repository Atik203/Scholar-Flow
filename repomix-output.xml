720:       const values = prepared.map(
721:         (chunk) =>
722:           Prisma.sql`(gen_random_uuid(), ${paperId}, ${chunk.idx}, ${chunk.page ?? null}, ${chunk.content}, ${chunk.tokenCount ?? null}, NOW(), NOW(), false)`
723:       );
724:       await prisma.$executeRaw(
725:         Prisma.sql`
726:           INSERT INTO "PaperChunk" (id, "paperId", "idx", "page", "content", "tokenCount", "createdAt", "updatedAt", "isDeleted")
727:           VALUES ${Prisma.join(values)}
728:         `
729:       );
730:     }
731:   }
