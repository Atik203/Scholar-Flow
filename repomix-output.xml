65:               type="button"
66:               onClick={handleClear}
67:               className="absolute right-3 top-1/2 -translate-y-1/2 p-1 hover:bg-muted rounded-sm transition-colors"
68:               aria-label="Clear search"
69:             >
70:               <X className="h-4 w-4 text-muted-foreground hover:text-foreground" />
71:             </button>
72:           )}
