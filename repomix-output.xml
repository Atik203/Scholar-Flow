<file path="apps/backend/src/app/modules/Billing/subscriptionSweeper.ts">
 1: import cron from "node-cron";
 2: import prismaClient from "../../shared/prisma";
 3: import { SUBSCRIPTION_STATUS } from "./billing.constant";
 4: const GRACE_DAYS = Number(process.env.SUB_GRACE_DAYS || 7);
 5: const logDebug = (...args: unknown[]) => {
 6:   if (process.env.NODE_ENV !== "production") {
 7:     console.log("[SubscriptionSweeper]", ...args);
 8:   }
 9: };
10: type ExpiredSubscriptionRow = {
11:   id: string;
12:   userId: string;
13:   status: string;
14: };
15: const findExpiredSubscriptions = async (): Promise<ExpiredSubscriptionRow[]> => {
16:   return prismaClient.$queryRaw<ExpiredSubscriptionRow[]>`
17:     SELECT s.id, s."userId", s.status
18:     FROM "Subscription" s
19:     WHERE (
20:         s.status = 'PAST_DUE'
21:         OR (s.status = 'ACTIVE' AND s."cancelAtPeriodEnd" = true)
22:       )
23:       AND s."expiresAt" < NOW() - make_interval(days => ${GRACE_DAYS})
24:       AND s."isDeleted" = false
25:       AND EXISTS (
26:         SELECT 1
27:         FROM "User" u
28:         WHERE u.id = s."userId"
29:           AND u.role != 'RESEARCHER'
30:       )
31:     LIMIT 100
32:   `;
33: };
34: const downgradeUserToFree = async (userId: string): Promise<void> => {
35:   await prismaClient.$executeRaw`
36:     UPDATE "User"
37:     SET
38:       role = 'RESEARCHER',
39:       "stripeSubscriptionId" = NULL,
40:       "stripePriceId" = NULL,
41:       "stripeCurrentPeriodEnd" = NULL,
42:       "updatedAt" = NOW()
43:     WHERE id = ${userId}
44:   `;
45: };
46: export const runSubscriptionSweep = async (): Promise<number> => {
47:   const expired = await findExpiredSubscriptions();
48:   for (const subscription of expired) {
49:     try {
50:       await downgradeUserToFree(subscription.userId);
51:       await prismaClient.$executeRaw`
52:         UPDATE "Subscription"
53:         SET
54:           status = ${SUBSCRIPTION_STATUS.EXPIRED}::"SubscriptionStatus",
55:           "canceledAt" = NOW(),
56:           "updatedAt" = NOW()
57:         WHERE id = ${subscription.id}
58:       `;
59:       logDebug(
60:         `Downgraded user ${subscription.userId} to RESEARCHER (subscription ${subscription.id}, status ${subscription.status})`
61:       );
62:     } catch (error) {
63:       console.error(
64:         `[SubscriptionSweeper] Failed to process subscription ${subscription.id}:`,
65:         error
66:       );
67:     }
68:   }
69:   if (expired.length > 0) {
70:     logDebug(`Sweep complete: ${expired.length} subscription(s) expired`);
71:   }
72:   return expired.length;
73: };
74: let sweeperStarted = false;
75: export const startSubscriptionSweeper = (): void => {
76:   if (sweeperStarted || process.env.VERCEL === "1") {
77:     return;
78:   }
79:   cron.schedule("5 * * * *", () => {
80:     runSubscriptionSweep().catch((error) => {
81:       console.error("[SubscriptionSweeper] Sweep run failed:", error);
82:     });
83:   });
84:   sweeperStarted = true;
85:   logDebug(`Subscription sweeper started (grace period: ${GRACE_DAYS} days)`);
86: };
</file>

