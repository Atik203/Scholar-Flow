 619:     const invitation = await prisma.$queryRaw<any[]>`
 620:       SELECT wi.id, wi.status, wi."expiresAt", wi."invitedById"
 621:       FROM "WorkspaceInvitation" wi
 622:       WHERE wi."workspaceId" = ${workspaceId} AND wi."userId" = ${userId} AND wi."isDeleted" = false
 623:     `;
 624:     if (!invitation[0]) {
 625:       throw new ApiError(404, "Invitation not found");
 626:     }
 627:     if (invitation[0].status !== "PENDING") {
 628:       throw new ApiError(400, "Invitation is not pending");
 629:     }
 630:     if (
 631:       invitation[0].expiresAt &&
 632:       new Date(invitation[0].expiresAt).getTime() < Date.now()
 633:     ) {
 634:       await prisma.$executeRaw`
 635:         UPDATE "WorkspaceInvitation" SET status = 'EXPIRED', "updatedAt" = now()
 636:         WHERE id = ${invitation[0].id}
 637:       `;
 638:       throw new ApiError(400, "Invitation has expired");
 639:     }
 640:     await prisma.$executeRaw`
 641:       UPDATE "WorkspaceInvitation"
 642:       SET status = 'DECLINED'::"MembershipStatus", "declinedAt" = now(), "updatedAt" = now()
 643:       WHERE id = ${invitation[0].id}
 644:     `;
 645:     // Notify the inviter (best-effort)
 646:     if (invitation[0].invitedById) {
