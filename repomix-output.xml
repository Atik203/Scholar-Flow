 50: async function extractPdfFirstPageText(buffer: Buffer): Promise<string | null> {
 51:   const execFileAsync = promisify(execFile);
 52:   let tmpDir: string | null = null;
 53:   try {
 54:     tmpDir = await mkdtemp(join(tmpdir(), "sf-import-"));
 55:     const inputPath = join(tmpDir, "input.pdf");
 56:     await writeFile(inputPath, buffer);
 57:     const { stdout } = await execFileAsync(
 58:       "pdftotext",
 59:       ["-f", "1", "-l", "1", "-layout", "-nopgbrk", inputPath, "-"],
 60:       { timeout: 15000, maxBuffer: 5 * 1024 * 1024 },
 61:     );
 62:     return stdout.trim();
 63:   } catch {
 64:     return null;
 65:   } finally {
