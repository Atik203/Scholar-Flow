142:   private chunkText(
143:     text: string,
144:     pageCount: number
145:   ): Array<{
146:     idx: number;
147:     page?: number;
148:     content: string;
149:     tokenCount?: number;
150:   }> {
151:     const chunks: Array<{
152:       idx: number;
153:       page?: number;
154:       content: string;
155:       tokenCount?: number;
156:     }> = [];
157:     if (!text) {
158:       return [];
159:     }
160:     const safePages = Math.max(1, Number.isFinite(pageCount) ? pageCount : 1);
161:     const textPerPage = Math.ceil(text.length / safePages);
162:     const pages = [];
163:     for (let i = 0; i < safePages; i++) {
164:       const start = i * textPerPage;
165:       const end = Math.min(start + textPerPage, text.length);
166:       pages.push(text.slice(start, end));
167:     }
168:     let chunkIndex = 0;
169:     pages.forEach((pageText, pageIndex) => {
170:       const maxChunkSize = 2000;
171:       const pageChunks = this.splitIntoChunks(pageText, maxChunkSize);
172:       pageChunks.forEach((chunkText) => {
173:         const sanitized = this.sanitizeText(chunkText);
174:         if (sanitized.length > 0) {
175:           chunks.push({
176:             idx: chunkIndex++,
177:             page: pageIndex + 1,
178:             content: sanitized,
179:             tokenCount: this.estimateTokenCount(sanitized),
180:           });
181:         }
182:       });
183:     });
184:     return chunks;
185:   }
186:   private splitIntoChunks(text: string, maxSize: number): string[] {
187:     const chunks: string[] = [];
188:     let currentChunk = "";
189:     const sentences = text.split(/[.!?]+/);
190:     for (const sentence of sentences) {
191:       if (
192:         currentChunk.length + sentence.length > maxSize &&
193:         currentChunk.length > 0
194:       ) {
195:         chunks.push(currentChunk.trim());
196:         currentChunk = sentence;
197:       } else {
198:         currentChunk += sentence + ".";
199:       }
200:     }
201:     if (currentChunk.trim().length > 0) {
202:       chunks.push(currentChunk.trim());
203:     }
204:     return chunks;
205:   }
206:   /**
207:    * Estimate token count (rough approximation)
208:    */
209:   private estimateTokenCount(text: string): number {
210:     // Rough estimation: 1 token ≈ 4 characters
211:     return Math.ceil(text.length / 4);
212:   }
213:   /**
214:    * Extract abstract from the beginning of the text
215:    */
216:   private extractAbstract(text: string): string {
217:     // Look for common abstract patterns
218:     const abstractPatterns = [
219:       /abstract\s*:?\s*(.+?)(?:\n\n|\n\s*\n|introduction|1\.|background)/is,
220:       /summary\s*:?\s*(.+?)(?:\n\n|\n\s*\n|introduction|1\.|background)/is,
221:       /overview\s*:?\s*(.+?)(?:\n\n|\n\s*\n|introduction|1\.|background)/is,
222:     ];
223:     for (const pattern of abstractPatterns) {
224:       const match = text.match(pattern);
225:       if (match && match[1]) {
226:         const abstract = match[1].trim();
227:         // Limit abstract length
228:         return abstract.length > 500
229:           ? abstract.substring(0, 500) + "..."
230:           : abstract;
231:       }
232:     }
233:     // Fallback: take first paragraph
234:     const firstParagraph = text.split("\n\n")[0];
235:     if (firstParagraph && firstParagraph.length > 50) {
236:       return firstParagraph.length > 500
237:         ? firstParagraph.substring(0, 500) + "..."
238:         : firstParagraph;
239:     }
240:     return "";
241:   }
242:   /**
243:    * Sanitize text content to remove null bytes and other problematic characters
244:    */
245:   private sanitizeText(text: string): string {
246:     if (!text) return "";
247:     // Fast path: replace explicit null bytes first
248:     let cleaned = text.replace(/\0/g, "");
249:     // Filter out remaining problematic code points while preserving common whitespace
250:     const builder: string[] = [];
251:     for (const ch of cleaned) {
252:       const code = ch.codePointAt(0)!;
253:       // Remove C0 controls except tab (9), LF (10), CR (13)
254:       if (code < 32 && code !== 9 && code !== 10 && code !== 13) continue;
255:       // Delete DEL
256:       if (code === 127) continue;
257:       // Remove surrogate halves (invalid in UTF-8/UTF-32 strings)
258:       if (code >= 0xd800 && code <= 0xdfff) continue;
259:       // Remove non-characters U+FFFE, U+FFFF
260:       if (code === 0xfffe || code === 0xffff) continue;
261:       builder.push(ch);
262:     }
263:     cleaned = builder.join("");
264:     return cleaned.trim();
265:   }
266:   /**
267:    * Store chunks in database
268:    */
269:   private async storeChunks(
270:     paperId: string,
271:     chunks: Array<{
272:       idx: number;
273:       page?: number;
274:       content: string;
275:       tokenCount?: number;
276:     }>
277:   ): Promise<void> {
278:     // Delete existing chunks first
279:     await prisma.paperChunk.deleteMany({
280:       where: { paperId },
281:     });
282:     // Insert new chunks with sanitized content
283:     const prepared = chunks
284:       .map((chunk) => ({
285:         paperId,
286:         idx: chunk.idx,
287:         page: chunk.page,
288:         content: this.sanitizeText(chunk.content),
289:         tokenCount: chunk.tokenCount,
290:       }))
291:       .filter((c) => c.content && c.content.length > 0);
292:     if (prepared.length > 0) {
293:       await prisma.paperChunk.createMany({ data: prepared });
294:     }
295:   }
296:   /**
297:    * Process all unprocessed papers
298:    */
299:   async processUnprocessedPapers(): Promise<void> {
300:     const unprocessedPapers = await prisma.paper.findMany({
301:       where: {
302:         processingStatus: "UPLOADED",
303:         isDeleted: false,
304:       },
305:       include: { file: true },
306:     });
307:     console.log(`Found ${unprocessedPapers.length} unprocessed papers`);
308:     for (const paper of unprocessedPapers) {
309:       if (paper.file) {
310:         console.log(`Processing paper: ${paper.title}`);
311:         await this.extractTextFromPDF(paper.id);
312:       }
313:     }
314:   }
315: }
316: export const pdfExtractionService = new PDFExtractionService();
