<file path="apps/frontend/src/components/tiptap-node/latex-block/latex-block-component.tsx">
 1: "use client";
 2: import { NodeViewContent, NodeViewWrapper, type ReactNodeViewProps } from "@tiptap/react";
 3: import katex from "katex";
 4: import { useEffect, useRef, useState } from "react";
 5: export function LatexBlockComponent({
 6:   node,
 7:   updateAttributes,
 8:   selected,
 9: }: ReactNodeViewProps) {
10:   const [editing, setEditing] = useState(!node.attrs.latex);
11:   const [inputValue, setInputValue] = useState(node.attrs.latex as string || "");
12:   const [error, setError] = useState<string | null>(null);
13:   const containerRef = useRef<HTMLDivElement>(null);
14:   useEffect(() => {
15:     if (!editing && inputValue) {
16:       try {
17:         katex.render(inputValue, containerRef.current!, {
18:           throwOnError: false,
19:           displayMode: true,
20:         });
21:         setError(null);
22:       } catch {
23:         setError("Invalid LaTeX");
24:         if (containerRef.current) {
25:           containerRef.current.textContent = inputValue;
26:         }
27:       }
28:     }
29:   }, [editing, inputValue]);
30:   const handleSubmit = () => {
31:     const trimmed = inputValue.trim();
32:     if (trimmed) {
33:       updateAttributes({ latex: trimmed });
34:       setEditing(false);
35:     }
36:   };
37:   const handleKeyDown = (e: React.KeyboardEvent) => {
38:     if (e.key === "Enter" && e.shiftKey) {
39:       e.preventDefault();
40:       handleSubmit();
41:     }
42:     if (e.key === "Escape") {
43:       setEditing(false);
44:       setInputValue((node.attrs.latex as string) || "");
45:     }
46:   };
47:   if (editing) {
48:     return (
49:       <NodeViewWrapper
50:         as="div"
51:         className="latex-block-editing border rounded-lg p-4 bg-muted/30 my-2"
52:       >
53:         <div className="flex items-center justify-between mb-2">
54:           <span className="text-xs text-muted-foreground font-mono">
55:             LaTeX (block) — Shift+Enter to apply
56:           </span>
57:         </div>
58:         <textarea
59:           value={inputValue}
60:           onChange={(e) => setInputValue(e.target.value)}
61:           onKeyDown={handleKeyDown}
62:           onBlur={handleSubmit}
63:           placeholder="E = mc^2"
64:           className="w-full border rounded p-3 text-sm bg-background font-mono min-h-[80px] focus:outline-none focus:ring-1 focus:ring-primary resize-y"
65:           autoFocus
66:         />
67:       </NodeViewWrapper>
68:     );
69:   }
70:   return (
71:     <NodeViewWrapper
72:       as="div"
73:       className={`latex-block my-3 p-4 rounded-lg bg-muted/20 ${
74:         selected ? "ring-2 ring-primary/30" : ""
75:       }`}
76:     >
77:       <div
78:         ref={containerRef}
79:         className="latex-rendered flex justify-center py-2 cursor-pointer overflow-x-auto"
80:         onClick={() => setEditing(true)}
81:         title="Click to edit"
82:       />
83:       {error && (
84:         <p className="text-xs text-destructive text-center mt-1">{"\u26A0"} {error}</p>
85:       )}
86:       <NodeViewContent />
87:     </NodeViewWrapper>
88:   );
89: }
