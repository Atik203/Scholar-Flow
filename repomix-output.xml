 52:   "gpt-4o-mini",
 53:   "gpt-3.5-turbo",
 54:   "gpt-4o",
 55:   "gpt-4-turbo",
 56:   "gpt-4",
 57:   "gpt-3.5-turbo-16k",
 58: ];
 59: const RESPONSES_MODELS = new Set(["gpt-4o-mini", "gpt-4o", "gpt-4-turbo"]);
