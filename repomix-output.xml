 885:   static async getRecommendations(userId: string, limit: number) {
 886:     const cap = Math.min(20, Math.max(1, limit));
 887:     const accessibleWhere = {
 888:       isDeleted: false,
 889:       OR: [
 890:         { uploaderId: userId },
 891:         {
 892:           workspace: {
 893:             isDeleted: false,
 894:             OR: [
 895:               { ownerId: userId },
 896:               { members: { some: { userId, isDeleted: false } } },
 897:             ],
 898:           },
 899:         },
 900:       ],
 901:     };
 902:     const recent = await prisma.paper.findMany({
 903:       where: accessibleWhere,
 904:       take: 50,
 905:       orderBy: { createdAt: "desc" },
 906:       select: { tags: true, metadata: true },
 907:     });
 908:     const freq = new Map<string, number>();
 909:     for (const paper of recent) {
 910:       for (const tag of paper.tags ?? []) {
 911:         const key = tag.toLowerCase().trim();
 912:         if (key.length >= 3) freq.set(key, (freq.get(key) ?? 0) + 1);
 913:       }
 914:       const keywords = (paper.metadata as { keywords?: unknown } | null)?.keywords;
 915:       if (Array.isArray(keywords)) {
 916:         for (const k of keywords.slice(0, 10)) {
 917:           if (typeof k !== "string") continue;
 918:           const key = k.toLowerCase().trim();
 919:           if (key.length >= 3) freq.set(key, (freq.get(key) ?? 0) + 1);
 920:         }
 921:       }
 922:     }
 923:     const interests = [...freq.entries()]
 924:       .sort((a, b) => b[1] - a[1])
 925:       .slice(0, 3)
 926:       .map(([keyword]) => keyword);
 927:     if (interests.length > 0) {
 928:       const perKeyword = Math.max(1, Math.ceil((cap * 0.6) / interests.length));
 929:       const out: DiscoveryItem[] = [];
 930:       const seen = new Set<string>();
 931:       for (const keyword of interests) {
 932:         const reason = `Because you work on "${keyword}"`;
 933:         let items: DiscoveryItem[] = [];
 934:         try {
 935:           items = await fetchArxivSearch(keyword, perKeyword, reason);
 936:         } catch {
 937:           items = [];
 938:         }
 939:         if (items.length === 0) {
 940:           try {
 941:             items = await fetchOpenAlexSearch(keyword, perKeyword, reason);
 942:           } catch {
 943:             items = [];
 944:           }
 945:         }
 946:         for (const item of items) {
 947:           if (seen.has(item.id)) continue;
 948:           seen.add(item.id);
 949:           out.push(item);
 950:         }
 951:       }
 952:       if (out.length > 0) return out.slice(0, cap);
 953:     }
 954:     const platform = (
 955:       await prisma.paper.findMany({
 956:         where: accessibleWhere,
 957:         take: cap,
 958:         orderBy: { createdAt: "desc" },
 959:         select: {
 960:           id: true,
 961:           title: true,
 962:           abstract: true,
 963:           source: true,
 964:           createdAt: true,
 965:         },
 966:       })
 967:     ).map(toPlatformDiscoveryItem);
 968:     return platform;
 969:   }
 970:   static async semanticSearch(
 971:     userId: string,
 972:     query: string,
 973:     limit = 10,
 974:     workspaceId?: string
 975:   ) {
 976:     const apiKey = process.env.OPENAI_API_KEY;
 977:     if (!apiKey) {
 978:       return { results: [], fallback: "OPENAI_KEY_MISSING" };
 979:     }
 980:     let queryVector: number[];
 981:     try {
 982:       const controller = new AbortController();
 983:       const timeout = setTimeout(() => controller.abort(), 15000);
 984:       const EMBEDDING_MODEL =
 985:         process.env.EMBEDDING_MODEL || "text-embedding-3-small";
 986:       const response = await fetch(
 987:         "https://api.openai.com/v1/embeddings",
 988:         {
 989:           method: "POST",
 990:           headers: {
 991:             "Content-Type": "application/json",
 992:             Authorization: `Bearer ${apiKey}`,
 993:           },
 994:           body: JSON.stringify({
 995:             model: EMBEDDING_MODEL,
 996:             input: query.trim().slice(0, 8000),
 997:           }),
 998:           signal: controller.signal,
 999:         }
1000:       );
1001:       clearTimeout(timeout);
1002:       if (!response.ok) {
1003:         return { results: [], fallback: "EMBEDDING_FAILED" };
1004:       }
1005:       const data = (await response.json()) as {
1006:         data: Array<{ embedding: number[] }>;
1007:       };
1008:       queryVector = data.data[0]?.embedding;
1009:       if (!queryVector || queryVector.length !== 1536) {
1010:         return { results: [], fallback: "EMBEDDING_FAILED" };
1011:       }
1012:     } catch {
1013:       return { results: [], fallback: "EMBEDDING_FAILED" };
1014:     }
1015:     const vectorStr = `[${queryVector.join(",")}]`;
1016:     const workspaceFilter = workspaceId
1017:       ? Prisma.sql`AND p."workspaceId" = ${workspaceId}`
1018:       : Prisma.empty;
1019:     const results = await prisma.$queryRaw<
1020:       Array<{
1021:         id: string;
1022:         paperId: string;
1023:         idx: number;
1024:         page: number | null;
1025:         content: string;
1026:         distance: number;
1027:         title: string | null;
1028:       }>
1029:     >`
1030:       SELECT
1031:         c.id,
1032:         c."paperId",
1033:         c.idx,
1034:         c.page,
1035:         c.content,
1036:         c.embedding <=> ${vectorStr}::vector AS distance,
1037:         p.title
1038:       FROM "PaperChunk" c
1039:       JOIN "Paper" p ON p.id = c."paperId"
1040:         AND p."isDeleted" = false
1041:       LEFT JOIN "Workspace" w
1042:         ON w.id = p."workspaceId" AND w."isDeleted" = false
1043:       LEFT JOIN "WorkspaceMember" m
1044:         ON m."workspaceId" = p."workspaceId"
1045:         AND m."userId" = ${userId}
1046:         AND m."isDeleted" = false
1047:       ${workspaceFilter}
1048:       WHERE c.embedding IS NOT NULL
1049:         AND c."isDeleted" = false
1050:         AND (
1051:           p."uploaderId" = ${userId}
1052:           OR w."ownerId" = ${userId}
1053:           OR m.id IS NOT NULL
1054:         )
1055:       ORDER BY c.embedding <=> ${vectorStr}::vector
1056:       LIMIT ${limit}
1057:     `;
1058:     return { results, fallback: null };
1059:   }
1060: }
