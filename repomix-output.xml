310:           <Button
311:             variant="outline"
312:             onClick={() => setPage((p) => Math.max(1, p - 1))}
313:             disabled={page === 1}
314:           >
315:             Previous
316:           </Button>
317:           <span className="text-sm text-muted-foreground">
318:             Page {page} of {totalPages}
319:           </span>
320:           <Button
321:             variant="outline"
322:             onClick={() => setPage((p) => Math.min(totalPages, p + 1))}
323:             disabled={page === totalPages}
324:           >
325:             Next
326:           </Button>
327:         </div>
328:       )}
329:       {}
330:       <Dialog
331:         open={!!changePlanTarget}
332:         onOpenChange={(open) => {
333:           if (!open) setChangePlanTarget(null);
334:         }}
335:       >
336:         <DialogContent>
337:           <DialogHeader>
338:             <DialogTitle>Change plan</DialogTitle>
339:             <DialogDescription>
340:               {changePlanTarget
341:                 ? `Move ${changePlanTarget.name}'s subscription to another plan. Role updates automatically via the webhook.`
342:                 : ""}
343:             </DialogDescription>
344:           </DialogHeader>
345:           <Select value={newPriceId} onValueChange={setNewPriceId}>
346:             <SelectTrigger>
347:               <SelectValue placeholder="Select target plan" />
348:             </SelectTrigger>
349:             <SelectContent>
350:               {changeablePlans.map((p) => (
351:                 <SelectItem key={p.id} value={p.stripePriceId ?? ""}>
352:                   {p.name} — {formatCurrency(p.priceCents / 100, "USD")}/
353:                   {p.interval}
354:                 </SelectItem>
355:               ))}
356:             </SelectContent>
