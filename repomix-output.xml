573:                               papers.find((p) => p.id === selectedPaperId)?.file
574:                                 ?.originalFilename
575:                             }
576:                             mimeType={
577:                               papers.find((p) => p.id === selectedPaperId)?.file
578:                                 ?.contentType
579:                             }
580:                             originalFilename={
581:                               papers.find((p) => p.id === selectedPaperId)?.file
582:                                 ?.originalFilename
583:                             }
584:                             className="h-full"
585:                           />
586:                         </div>
587:                       ) : (
588:                         <PdfPaneState
589:                           variant="missing"
590:                           description="The PDF file for this paper is not available for preview."
591:                         />
592:                       )}
593:                     </>
594:                   )}
595:                   {}
596:                   {activeTab === "annotations" && (
597:                     <>
598:                       {isFetchingFileUrl ? (
599:                         <PdfPaneState variant="loading" />
600:                       ) : fileUrlError ? (
601:                         <PdfPaneState
602:                           variant="error"
603:                           onRetry={() => void refetchFileUrl()}
604:                         />
605:                       ) : fileUrlData?.data?.url && selectedPaperId ? (
606:                         <div className="min-h-[75vh] border rounded-lg overflow-hidden">
607:                           <PdfAnnotationViewerEnhanced
608:                             fileUrl={fileUrlData.data.url}
609:                             paperId={selectedPaperId}
610:                           />
611:                         </div>
612:                       ) : (
613:                         <PdfPaneState
614:                           variant="missing"
615:                           description="The PDF file for this paper is not available for annotation."
616:                         />
617:                       )}
618:                     </>
619:                   )}
620:                   {}
621:                   {activeTab === "comments" && (
622:                     <div className="min-h-[70vh] border rounded-lg">
623:                       <CommentSection
624:                         paperId={selectedPaperId}
625:                         className="h-full"
626:                       />
627:                     </div>
628:                   )}
629:                   {}
630:                   {activeTab === "notes" && (
631:                     <div className="min-h-[70vh] border rounded-lg">
632:                       <NotesPanel
633:                         paperId={selectedPaperId}
634:                         className="h-full"
635:                       />
636:                     </div>
637:                   )}
638:                 </CardContent>
639:               </Card>
640:             )}
641:           </div>
642:         </div>
643:       </div>
644:   );
645: }
</file>

<file path="apps/frontend/src/components/annotations/AnnotationPopup.tsx">
  1: "use client";
  2: import { Button } from "@/components/ui/button";
  3: import { Textarea } from "@/components/ui/textarea";
  4: import {
  5:   Tooltip,
  6:   TooltipContent,
  7:   TooltipTrigger,
  8: } from "@/components/ui/tooltip";
  9: import type { AnnotationType } from "@/redux/api/annotationApi";
 10: import {
 11:   Check,
 12:   Highlighter,
 13:   MessageSquareText,
 14:   Pencil,
 15:   Square,
 16:   Strikethrough,
 17:   Underline,
 18:   X,
 19: } from "lucide-react";
 20: import { useEffect, useRef, useState } from "react";
 21: const COLORS = [
 22:   { value: "#FFEB3B", label: "Yellow" },
 23:   { value: "#4CAF50", label: "Green" },
 24:   { value: "#42A5F5", label: "Blue" },
 25:   { value: "#F48FB1", label: "Pink" },
 26:   { value: "#FF9800", label: "Orange" },
 27:   { value: "#AB47BC", label: "Purple" },
 28: ];
 29: const TYPE_LABELS: Record<AnnotationType, string> = {
 30:   HIGHLIGHT: "Highlight",
 31:   UNDERLINE: "Underline",
 32:   STRIKETHROUGH: "Strikethrough",
 33:   AREA: "Area",
 34:   COMMENT: "Comment",
 35:   INK: "Draw",
 36:   NOTE: "Note",
 37: };
 38: const TYPES: { value: AnnotationType; icon: typeof Highlighter }[] = [
 39:   { value: "HIGHLIGHT", icon: Highlighter },
 40:   { value: "UNDERLINE", icon: Underline },
 41:   { value: "STRIKETHROUGH", icon: Strikethrough },
 42:   { value: "AREA", icon: Square },
 43:   { value: "COMMENT", icon: MessageSquareText },
 44:   { value: "INK", icon: Pencil },
 45: ];
 46: interface AnnotationPopupProps {
 47:   isOpen: boolean;
 48:   onClose: () => void;
 49:   onSubmit: (data: { text: string; color: string; type: AnnotationType }) => void;
 50:   position: { x: number; y: number } | null;
 51:   selectedText?: string;
 52:   defaultColor?: string;
 53:   defaultType?: AnnotationType;
 54: }
 55: export function AnnotationPopup({
 56:   isOpen,
 57:   onClose,
 58:   onSubmit,
 59:   position,
 60:   selectedText,
 61:   defaultColor = COLORS[0].value,
 62:   defaultType = "HIGHLIGHT",
 63: }: AnnotationPopupProps) {
 64:   const [text, setText] = useState("");
 65:   const [color, setColor] = useState(defaultColor);
 66:   const [type, setType] = useState<AnnotationType>(defaultType);
 67:   const textareaRef = useRef<HTMLTextAreaElement>(null);
 68:   useEffect(() => {
 69:     if (isOpen) {
 70:       setText("");
 71:       setColor(defaultColor);
 72:       setType(defaultType);
 73:       requestAnimationFrame(() => textareaRef.current?.focus());
 74:     }
 75:   }, [isOpen, defaultColor, defaultType]);
 76:   const handleSubmit = () => {
 77:     // Notes are optional: an empty text still creates the highlight,
 78:     // underline, strikethrough, area, or drawing annotation.
 79:     onSubmit({ text: text.trim(), color, type });
 80:     onClose();
 81:   };
 82:   useEffect(() => {
 83:     const handleKeyDown = (e: KeyboardEvent) => {
 84:       if (!isOpen) return;
 85:       if (e.key === "Escape") {
 86:         e.preventDefault();
 87:         onClose();
 88:       } else if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
 89:         e.preventDefault();
 90:         handleSubmit();
 91:       }
 92:     };
 93:     document.addEventListener("keydown", handleKeyDown);
 94:     return () => document.removeEventListener("keydown", handleKeyDown);
 95:   }, [isOpen, text, color, type]);
 96:   if (!isOpen || !position) return null;
 97:   const POPUP_WIDTH = 336;
 98:   const POPUP_HEIGHT_ESTIMATE = 320;
 99:   const viewportWidth = typeof window !== "undefined" ? window.innerWidth : 1024;
100:   const viewportHeight =
101:     typeof window !== "undefined" ? window.innerHeight : 768;
102:   const popupX = Math.max(8, Math.min(position.x, viewportWidth - POPUP_WIDTH));
103:   const popupY = Math.max(
104:     8,
105:     Math.min(position.y, viewportHeight - POPUP_HEIGHT_ESTIMATE)
106:   );
107:   return (
108:     <div
109:       className="fixed inset-0 z-50"
110:       onMouseDown={(e) => {
111:         if (e.target === e.currentTarget) onClose();
112:       }}
113:     >
114:       <div
115:         className="absolute z-50 w-80 rounded-xl border bg-card/95 shadow-xl backdrop-blur-sm"
116:         style={{ left: popupX, top: popupY }}
117:         onMouseDown={(e) => e.stopPropagation()}
118:       >
119:         {}
120:         <div className="absolute -top-2 left-6 h-3 w-3 rotate-45 border-l border-t bg-card" />
121:         {}
122:         <div className="flex items-center justify-between border-b px-3 py-2">
123:           <span className="text-xs font-semibold text-muted-foreground">
124:             Add {TYPE_LABELS[type]}
125:           </span>
126:           <Button
127:             variant="ghost"
128:             size="sm"
129:             onClick={onClose}
130:             className="h-6 w-6 p-0 hover:bg-muted"
131:           >
132:             <X className="h-3.5 w-3.5" />
133:           </Button>
134:         </div>
135:         <div className="space-y-3 p-3">
136:           {}
137:           <div className="flex gap-1">
138:             {TYPES.map((t) => {
139:               const Icon = t.icon;
140:               const isActive = type === t.value;
141:               return (
142:                 <Tooltip key={t.value}>
143:                   <TooltipTrigger asChild>
144:                     <Button
145:                       type="button"
146:                       size="sm"
147:                       variant={isActive ? "default" : "outline"}
148:                       className="h-8 flex-1 px-0"
149:                       onClick={() => setType(t.value)}
150:                       aria-label={TYPE_LABELS[t.value]}
151:                       aria-pressed={isActive}
152:                     >
153:                       <Icon className="h-3.5 w-3.5" />
154:                     </Button>
155:                   </TooltipTrigger>
156:                   <TooltipContent side="top">{TYPE_LABELS[t.value]}</TooltipContent>
157:                 </Tooltip>
158:               );
159:             })}
160:           </div>
161:           {}
162:           <div className="flex gap-1.5">
163:             {COLORS.map((c) => (
164:               <button
165:                 key={c.value}
166:                 type="button"
167:                 title={c.label}
168:                 className={`h-6 w-6 rounded-full border-2 transition-all ${
169:                   color === c.value
170:                     ? "border-foreground scale-110"
171:                     : "border-transparent hover:scale-110"
172:                 }`}
173:                 style={{ backgroundColor: c.value }}
174:                 onClick={() => setColor(c.value)}
175:                 aria-label={`${c.label} color`}
176:                 aria-pressed={color === c.value}
177:               />
178:             ))}
179:           </div>
180:           {}
181:           {selectedText && (
182:             <div className="rounded-md bg-muted/60 px-2.5 py-1.5 text-xs leading-relaxed text-muted-foreground line-clamp-2">
183:               &ldquo;{selectedText}&rdquo;
184:             </div>
185:           )}
186:           {}
187:           <Textarea
188:             ref={textareaRef}
189:             value={text}
190:             onChange={(e) => setText(e.target.value)}
191:             placeholder="Add note (optional)..."
192:             className="min-h-[60px] resize-none text-sm"
193:             rows={2}
194:           />
195:           {}
196:           <div className="flex items-center justify-end gap-2">
197:             <Button variant="outline" size="sm" onClick={onClose} className="h-8 text-xs">
198:               Cancel
199:             </Button>
200:             <Button
201:               size="sm"
202:               onClick={handleSubmit}
203:               className="h-8 gap-1 text-xs"
204:             >
205:               <Check className="h-3.5 w-3.5" />
206:               {text.trim() ? "Save Note" : `Save ${TYPE_LABELS[type]}`}
207:             </Button>
208:           </div>
209:         </div>
210:       </div>
211:     </div>
212:   );
213: }
</file>

<file path="apps/frontend/src/components/annotations/PdfAnnotationViewerEnhanced.tsx">
  1: "use client";
  2: import {
  3:   showErrorToast,
  4:   showSuccessToast,
  5: } from "@/components/providers/ToastProvider";
  6: import { Button } from "@/components/ui/button";
  7: import type {
  8:   Annotation,
  9:   AnnotationAnchor,
 10:   AnnotationType,
 11: } from "@/redux/api/annotationApi";
 12: import {
 13:   useCreateAnnotationMutation,
 14:   useDeleteAnnotationMutation,
 15:   useGetPaperAnnotationsQuery,
 16:   useUpdateAnnotationMutation,
 17: } from "@/redux/api/annotationApi";
 18: import { useCallback, useEffect, useRef, useState } from "react";
 19: import { Document, Page, pdfjs } from "react-pdf";
 20: import "react-pdf/dist/Page/AnnotationLayer.css";
 21: import "react-pdf/dist/Page/TextLayer.css";
 22: import { AnnotationEditDialog } from "./AnnotationEditDialog";
 23: import { AnnotationLayerEnhanced } from "./AnnotationLayerEnhanced";
 24: import { AnnotationList } from "./AnnotationList";
 25: import { AnnotationPopup } from "./AnnotationPopup";
 26: import { AnnotationToolbar } from "./AnnotationToolbar";
 27: pdfjs.GlobalWorkerOptions.workerSrc = `https://cdn.jsdelivr.net/npm/pdfjs-dist@${pdfjs.version}/build/pdf.worker.min.mjs`;
 28: interface PdfAnnotationViewerEnhancedProps {
 29:   fileUrl: string;
 30:   paperId: string;
 31:   className?: string;
 32: }
 33: export function PdfAnnotationViewerEnhanced({
 34:   fileUrl,
 35:   paperId,
 36:   className = "",
 37: }: PdfAnnotationViewerEnhancedProps) {
 38:   const [numPages, setNumPages] = useState<number>(0);
 39:   const [currentPage, setCurrentPage] = useState<number>(1);
 40:   const [scale, setScale] = useState<number>(1.2);
 41:   const [rotation, setRotation] = useState<number>(0);
 42:   const [selectedText, setSelectedText] = useState<string>("");
 43:   const [selection, setSelection] = useState<AnnotationAnchor | null>(null);
 44:   const [isAnnotationPopupOpen, setIsAnnotationPopupOpen] = useState(false);
 45:   const [annotationType, setAnnotationType] =
 46:     useState<AnnotationType>("HIGHLIGHT");
 47:   const [annotationColor, setAnnotationColor] = useState<string>("#FFEB3B");
 48:   const [showAnnotations, setShowAnnotations] = useState(true);
 49:   const [showAnnotationList, setShowAnnotationList] = useState(false);
 50:   const [isDrawingMode, setIsDrawingMode] = useState(false);
 51:   const [drawingPoints, setDrawingPoints] = useState<
 52:     Array<{ x: number; y: number }>
 53:   >([]);
 54:   const [editingAnnotation, setEditingAnnotation] = useState<Annotation | null>(
 55:     null
 56:   );
 57:   const [pageWidth, setPageWidth] = useState(0);
 58:   const [pageHeight, setPageHeight] = useState(0);
 59:   const pageRef = useRef<HTMLDivElement>(null);
 60:   const {
 61:     data: annotationsData,
 62:     isLoading: annotationsLoading,
 63:     isError: annotationsError,
 64:     refetch: refetchAnnotations,
 65:   } = useGetPaperAnnotationsQuery({
 66:     paperId,
 67:     includeReplies: true,
 68:   });
 69:   const [createAnnotation] = useCreateAnnotationMutation();
 70:   const [updateAnnotation] = useUpdateAnnotationMutation();
 71:   const [deleteAnnotation] = useDeleteAnnotationMutation();
 72:   const annotations = annotationsData?.data || [];
 73:   const currentPageAnnotations = annotations.filter(
 74:     (annotation) => annotation.anchor.page === currentPage
 75:   );
 76:   const onDocumentLoadSuccess = useCallback(
 77:     ({ numPages }: { numPages: number }) => {
 78:       setNumPages(numPages);
 79:     },
 80:     []
 81:   );
 82:   const handleAnnotationCreate = useCallback(
 83:     async ({ text, color, type }: { text: string; color: string; type: AnnotationType }) => {
 84:       if (!selection) return;
 85:       try {
 86:         await createAnnotation({
 87:           paperId,
 88:           type,
 89:           anchor: selection,
 90:           text: text.trim(),
 91:           color,
 92:         }).unwrap();
 93:         showSuccessToast("Annotation created");
 94:         setIsAnnotationPopupOpen(false);
 95:         setSelection(null);
 96:         setSelectedText("");
 97:         setDrawingPoints([]);
 98:       } catch (error: any) {
 99:         showErrorToast(error.data?.message || "Failed to create annotation");
100:       }
101:     },
102:     [selection, paperId, createAnnotation]
103:   );
104:   const handleAnnotationSave = useCallback(
105:     async (id: string, data: { text?: string; color?: string }) => {
106:       try {
107:         await updateAnnotation({ id, data }).unwrap();
108:         showSuccessToast("Annotation updated");
109:         setEditingAnnotation(null);
110:       } catch (error: any) {
111:         showErrorToast(error.data?.message || "Failed to update annotation");
112:       }
113:     },
114:     [updateAnnotation]
115:   );
116:   const handleAnnotationDelete = useCallback(
117:     async (id: string) => {
118:       try {
119:         await deleteAnnotation(id).unwrap();
120:         showSuccessToast("Annotation deleted");
121:       } catch (error: any) {
122:         showErrorToast(error.data?.message || "Failed to delete annotation");
123:       }
124:     },
125:     [deleteAnnotation]
126:   );
127:   const handleAnnotationReply = useCallback(
128:     async (parentId: string, data: { text: string; color?: string }) => {
129:       try {
130:         await createAnnotation({
131:           paperId,
132:           type: "COMMENT",
133:           anchor: { page: currentPage, coordinates: { x: 0, y: 0, width: 0, height: 0 } },
134:           text: data.text.trim(),
135:           parentId,
136:           color: data.color || "#2196F3",
137:         }).unwrap();
138:         showSuccessToast("Reply added");
139:       } catch (error: any) {
140:         showErrorToast(error.data?.message || "Failed to add reply");
141:       }
142:     },
143:     [paperId, currentPage, createAnnotation]
144:   );
145:   const handleAnnotationCancel = useCallback(() => {
146:     setIsAnnotationPopupOpen(false);
147:     setSelection(null);
148:     setSelectedText("");
149:     setDrawingPoints([]);
150:   }, []);
151:   const goToPreviousPage = useCallback(() => {
152:     setCurrentPage((prev) => Math.max(1, prev - 1));
153:   }, []);
154:   const goToNextPage = useCallback(() => {
155:     setCurrentPage((prev) => Math.min(numPages, prev + 1));
156:   }, [numPages]);
157:   const zoomIn = useCallback(() => {
158:     setScale((prev) => Math.min(3.0, prev + 0.2));
159:   }, []);
160:   const zoomOut = useCallback(() => {
161:     setScale((prev) => Math.max(0.5, prev - 0.2));
162:   }, []);
163:   const resetZoom = useCallback(() => {
164:     setScale(1.2);
165:   }, []);
166:   const rotate = useCallback(() => {
167:     setRotation((prev) => (prev + 90) % 360);
168:   }, []);
169:   const pageJump = useCallback((page: number) => {
170:     setCurrentPage(Math.max(1, page));
171:   }, []);
172:   const handleToolChange = useCallback(
173:     (tool: AnnotationType | null) => {
174:       if (tool === "INK") {
175:         setIsDrawingMode(true);
176:       } else {
177:         setIsDrawingMode(false);
178:       }
179:       if (tool) {
180:         setAnnotationType(tool);
181:       }
182:     },
183:     []
184:   );
185:   useEffect(() => {
186:     if (window.matchMedia("(min-width: 1280px)").matches) {
187:       setShowAnnotationList(true);
188:     }
189:   }, []);
190:   useEffect(() => {
191:     const el = pageRef.current;
192:     if (!el) return;
193:     const update = () => {
194:       setPageWidth(el.offsetWidth);
195:       setPageHeight(el.offsetHeight);
196:     };
197:     update();
198:     const ro = new ResizeObserver(update);
199:     ro.observe(el);
200:     return () => ro.disconnect();
201:   }, [scale, rotation]);
202:   const popupPosition = selection?.coordinates
203:     ? {
204:         x:
205:           selection.coordinates.x * pageWidth +
206:           (pageRef.current?.getBoundingClientRect().left ?? 0),
207:         y:
208:           selection.coordinates.y * pageHeight +
209:           (pageRef.current?.getBoundingClientRect().top ?? 0),
210:       }
211:     : null;
212:   return (
213:     <div className={`flex h-full ${className}`}>
214:       <div className="flex flex-1 flex-col">
215:         <AnnotationToolbar
216:           activeTool={annotationType}
217:           onToolChange={handleToolChange}
218:           selectedColor={annotationColor}
219:           onColorChange={setAnnotationColor}
220:           scale={scale}
221:           onZoomIn={zoomIn}
222:           onZoomOut={zoomOut}
223:           onZoomReset={resetZoom}
224:           currentPage={currentPage}
225:           numPages={numPages}
226:           onPrevPage={goToPreviousPage}
227:           onNextPage={goToNextPage}
228:           onPageJump={pageJump}
229:           rotation={rotation}
230:           onRotate={rotate}
231:           showAnnotations={showAnnotations}
232:           onToggleAnnotations={() => setShowAnnotations((v) => !v)}
233:           showSidebar={showAnnotationList}
234:           onToggleSidebar={() => setShowAnnotationList((v) => !v)}
235:         />
236:         {annotationsError && (
237:           <div className="flex items-center justify-between gap-2 border-b border-destructive/20 bg-destructive/10 px-4 py-1.5 text-xs text-destructive">
238:             <span>Failed to load annotations.</span>
239:             <Button
240:               variant="ghost"
241:               size="sm"
242:               className="h-6 px-2 text-xs text-destructive hover:bg-destructive/10 hover:text-destructive"
243:               onClick={() => void refetchAnnotations()}
244:             >
245:               Retry
246:             </Button>
247:           </div>
248:         )}
249:         <div className="flex-1 overflow-auto bg-muted/30 p-6">
250:           <div className="flex justify-center">
251:             <div ref={pageRef} className="relative bg-background shadow-2xl">
252:               <Document
253:                 file={fileUrl}
254:                 onLoadSuccess={onDocumentLoadSuccess}
255:                 loading={
256:                   <div className="flex h-96 items-center justify-center">
257:                     <div className="text-center">
258:                       <div className="mx-auto mb-2 h-8 w-8 animate-spin rounded-full border-b-2 border-primary" />
259:                       <p className="text-sm text-muted-foreground">Loading PDF...</p>
260:                     </div>
261:                   </div>
262:                 }
263:                 error={
264:                   <div className="flex h-96 items-center justify-center">
265:                     <div className="text-center">
266:                       <p className="text-sm font-medium text-destructive">Failed to load PDF</p>
267:                       <p className="mt-1 text-xs text-muted-foreground">Please try refreshing the page</p>
268:                     </div>
269:                   </div>
270:                 }
271:               >
272:                 <Page
273:                   pageNumber={currentPage}
274:                   scale={scale}
275:                   rotate={rotation}
276:                   className="shadow-lg"
277:                   renderTextLayer={true}
278:                   renderAnnotationLayer={false}
279:                 />
280:               </Document>
281:               <AnnotationLayerEnhanced
282:                 page={currentPage}
283:                 annotations={currentPageAnnotations}
284:                 scale={scale}
285:                 rotation={rotation}
286:                 pageWidth={pageWidth}
287:                 pageHeight={pageHeight}
288:                 activeTool={isDrawingMode ? "INK" : annotationType}
289:                 selectedColor={annotationColor}
290:                 showAnnotations={showAnnotations}
291:                 onAnnotationClick={(annotation) => {
292:                   setEditingAnnotation(annotation);
293:                 }}
294:                 onCreateAnnotation={(anchor) => {
295:                   setSelection(anchor);
296:                   setSelectedText(anchor.selectedText || "");
297:                   setIsAnnotationPopupOpen(true);
298:                 }}
299:                 isDrawingMode={isDrawingMode}
300:                 drawingPoints={drawingPoints}
301:                 onDrawingPointsChange={setDrawingPoints}
302:                 onDrawingComplete={(points) => {
303:                   const normalized = points.map((p) => ({
304:                     x: p.x / pageWidth,
305:                     y: p.y / pageHeight,
306:                   }));
307:                   const anchor: AnnotationAnchor = {
308:                     page: currentPage,
309:                     coordinates: { x: 0, y: 0, width: 0, height: 0 },
310:                     points: normalized,
311:                     viewport: { scale, rotation },
312:                   };
313:                   setSelection(anchor);
314:                   setAnnotationType("INK");
315:                   setIsAnnotationPopupOpen(true);
316:                 }}
317:               />
318:             </div>
319:           </div>
320:         </div>
321:       </div>
322:       {showAnnotationList && (
323:         <div className="w-80 flex-shrink-0 border-l bg-card shadow-lg">
324:           <AnnotationList
325:             annotations={annotations}
326:             totalPages={numPages}
327:             onAnnotationClick={(annotation) => {
328:               setCurrentPage(annotation.anchor.page);
329:               setEditingAnnotation(annotation);
330:             }}
331:             onDelete={handleAnnotationDelete}
332:             onPageJump={(page) => setCurrentPage(page)}
333:             isLoading={annotationsLoading}
334:           />
335:         </div>
336:       )}
337:       <AnnotationPopup
338:         isOpen={isAnnotationPopupOpen}
339:         onClose={handleAnnotationCancel}
340:         onSubmit={handleAnnotationCreate}
341:         position={popupPosition}
342:         selectedText={selectedText}
343:         defaultColor={annotationColor}
344:         defaultType={annotationType}
345:       />
346:       <AnnotationEditDialog
347:         key={editingAnnotation?.id ?? "annotation-editor"}
348:         annotation={editingAnnotation}
349:         open={!!editingAnnotation}
350:         onOpenChange={(open) => {
351:           if (!open) setEditingAnnotation(null);
352:         }}
