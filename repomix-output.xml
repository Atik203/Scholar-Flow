<file path="apps/frontend/src/hooks/useSubscriptionSync.ts">
  1: "use client";
  2: import { apiSlice } from "@/redux/api/apiSlice";
  3: import { useGetSubscriptionQuery } from "@/redux/api/billingApi";
  4: import { useGetProfileQuery } from "@/redux/api/userApi";
  5: import { useAuth } from "@/redux/auth/useAuth";
  6: import { useAppDispatch } from "@/redux/hooks";
  7: import { useCallback, useEffect, useRef } from "react";
  8: interface UseSubscriptionSyncOptions {
  9:   enabled: boolean;
 10:   maxAttempts?: number;
 11:   pollingInterval?: number;
 12:   onSyncComplete?: () => void;
 13:   onSyncTimeout?: () => void;
 14: }
 15: interface SubscriptionSnapshot {
 16:   role: string | null;
 17:   subscriptionId: string | null;
 18:   status: string | null;
 19:   planId: string | null;
 20: }
 21: export function useSubscriptionSync({
 22:   enabled = false,
 23:   maxAttempts = 10,
 24:   pollingInterval = 2000,
 25:   onSyncComplete,
 26:   onSyncTimeout,
 27: }: UseSubscriptionSyncOptions) {
 28:   const dispatch = useAppDispatch();
 29:   const { user } = useAuth();
 30:   const pollingIntervalRef = useRef<NodeJS.Timeout | null>(null);
 31:   const attemptCountRef = useRef(0);
 32:   const hasCompletedRef = useRef(false);
 33:   const initialSnapshotRef = useRef<SubscriptionSnapshot | null>(null);
 34:   const lastKnownSnapshotRef = useRef<SubscriptionSnapshot | null>(null);
 35:   const { refetch: refetchProfile } = useGetProfileQuery(undefined, {
 36:     refetchOnMountOrArgChange: false,
 37:     refetchOnFocus: false,
 38:     refetchOnReconnect: false,
 39:   });
 40:   const { data: subscription, refetch: refetchSubscription } =
 41:     useGetSubscriptionQuery(
 42:       {},
 43:       {
 44:         refetchOnMountOrArgChange: false,
 45:         refetchOnFocus: false,
 46:         refetchOnReconnect: false,
 47:       }
 48:     );
 49:   const captureSnapshot = useCallback((): SubscriptionSnapshot => {
 50:     return {
 51:       role: user?.role || null,
 52:       subscriptionId: user?.stripeSubscriptionId || null,
 53:       status: subscription?.status || null,
 54:       planId: subscription?.planId || null,
 55:     };
 56:   }, [user, subscription]);
 57:   const hasChanges = useCallback(
 58:     (
 59:       snapshot1: SubscriptionSnapshot | null,
 60:       snapshot2: SubscriptionSnapshot | null
 61:     ): boolean => {
 62:       if (!snapshot1 || !snapshot2) return false;
 63:       return (
 64:         snapshot1.role !== snapshot2.role ||
 65:         snapshot1.subscriptionId !== snapshot2.subscriptionId ||
 66:         snapshot1.status !== snapshot2.status ||
 67:         snapshot1.planId !== snapshot2.planId
 68:       );
 69:     },
 70:     []
 71:   );
 72:   const forceRefresh = useCallback(async () => {
 73:     if (!enabled) {
 74:       console.warn("[useSubscriptionSync] Skipping refresh - sync not enabled");
 75:       return false;
 76:     }
 77:     try {
 78:       dispatch(apiSlice.util.invalidateTags(["User"]));
 79:       const results = await Promise.allSettled([
 80:         refetchProfile(),
 81:         refetchSubscription(),
 82:       ]);
 83:       const allSucceeded = results.every(
 84:         (result) => result.status === "fulfilled"
 85:       );
 86:       if (!allSucceeded) {
 87:         const failures = results.filter((r) => r.status === "rejected");
 88:         console.error("[useSubscriptionSync] Some refetches failed:", failures);
 89:       }
 90:       return allSucceeded;
 91:     } catch (error) {
 92:       console.error("[useSubscriptionSync] Error during refresh:", error);
 93:       return false;
 94:     }
 95:   }, [dispatch, refetchProfile, refetchSubscription, enabled]);
 96:   const stopPolling = useCallback(() => {
 97:     if (pollingIntervalRef.current) {
 98:       clearInterval(pollingIntervalRef.current);
 99:       pollingIntervalRef.current = null;
100:     }
101:     attemptCountRef.current = 0;
102:   }, []);
103:   const poll = useCallback(async () => {
104:     if (hasCompletedRef.current) {
105:       stopPolling();
106:       return;
107:     }
108:     attemptCountRef.current += 1;
109:     if (attemptCountRef.current > maxAttempts) {
110:       console.warn(
111:         `[useSubscriptionSync] Max polling attempts (${maxAttempts}) reached. Stopping.`
112:       );
113:       stopPolling();
114:       hasCompletedRef.current = true;
115:       onSyncTimeout?.();
116:       return;
117:     }
118:     console.log(
119:       `[useSubscriptionSync] Polling attempt ${attemptCountRef.current}/${maxAttempts}`
120:     );
121:     const refreshSuccess = await forceRefresh();
122:     if (!refreshSuccess) {
123:       return;
124:     }
125:     const currentSnapshot = captureSnapshot();
126:     if (!initialSnapshotRef.current) {
127:       initialSnapshotRef.current = currentSnapshot;
128:       lastKnownSnapshotRef.current = currentSnapshot;
129:       return;
130:     }
131:     const changesDetected = hasChanges(
132:       lastKnownSnapshotRef.current,
133:       currentSnapshot
134:     );
135:     if (changesDetected) {
136:       console.log("[useSubscriptionSync] Subscription changes detected!", {
137:         before: lastKnownSnapshotRef.current,
138:         after: currentSnapshot,
139:       });
140:       lastKnownSnapshotRef.current = currentSnapshot;
141:       stopPolling();
142:       hasCompletedRef.current = true;
143:       onSyncComplete?.();
144:     }
145:   }, [
146:     maxAttempts,
147:     onSyncTimeout,
148:     onSyncComplete,
149:     stopPolling,
150:     forceRefresh,
151:     captureSnapshot,
152:     hasChanges,
153:   ]);
154:   useEffect(() => {
155:     if (!enabled) {
156:       stopPolling();
157:       hasCompletedRef.current = false;
158:       initialSnapshotRef.current = null;
159:       lastKnownSnapshotRef.current = null;
160:       attemptCountRef.current = 0;
161:       return;
162:     }
163:     if (hasCompletedRef.current) {
164:       return;
165:     }
166:     console.log("[useSubscriptionSync] Starting subscription sync polling");
167:     poll();
168:     pollingIntervalRef.current = setInterval(poll, pollingInterval);
169:     return () => {
170:       stopPolling();
171:     };
172:   }, [enabled, poll, pollingInterval, stopPolling]);
173:   return {
174:     isPolling: enabled && !hasCompletedRef.current,
175:     attemptCount: attemptCountRef.current,
176:     maxAttempts,
177:     forceRefresh,
178:   };
179: }
</file>

