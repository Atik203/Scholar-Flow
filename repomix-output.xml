390:                 </div>
391:               </div>
392:             </div>
393:           ) : (
394:             <div className="space-y-3 pr-4">
395:               {filteredAndSortedChunks.map((chunk) => {
396:                 const isExpanded = expandedChunks.has(chunk.id);
397:                 const shouldTruncate =
398:                   !isExpanded && chunk.content.length > 300;
399:                 return (
400:                   <Card
401:                     key={chunk.id}
402:                     className="border-l-4 border-l-primary/20"
403:                   >
404:                     <CardHeader className="pb-2">
405:                       <div className="flex items-center justify-between">
406:                         <div className="flex items-center gap-2">
407:                           <Badge variant="secondary" className="text-xs">
408:                             Chunk {chunk.idx}
409:                           </Badge>
410:                           {chunk.page && (
411:                             <Badge variant="outline" className="text-xs">
412:                               Page {chunk.page}
413:                             </Badge>
414:                           )}
415:                           {chunk.tokenCount && (
416:                             <Badge variant="outline" className="text-xs">
417:                               {chunk.tokenCount} tokens
418:                             </Badge>
419:                           )}
420:                         </div>
421:                         <Button
422:                           variant="ghost"
423:                           size="sm"
424:                           onClick={() => toggleChunkExpansion(chunk.id)}
425:                           className="h-6 w-6 p-0"
426:                         >
427:                           {isExpanded ? (
428:                             <ChevronUp className="h-4 w-4" />
429:                           ) : (
430:                             <ChevronDown className="h-4 w-4" />
431:                           )}
432:                         </Button>
433:                       </div>
434:                     </CardHeader>
435:                     <CardContent className="pt-0">
436:                       <div className="prose prose-sm max-w-none">
437:                         <p className="text-sm leading-relaxed whitespace-pre-wrap">
438:                           {shouldTruncate
439:                             ? `${chunk.content.substring(0, 300)}...`
440:                             : chunk.content}
441:                         </p>
442:                       </div>
443:                       {shouldTruncate && (
444:                         <Button
445:                           variant="link"
446:                           size="sm"
447:                           onClick={() => toggleChunkExpansion(chunk.id)}
448:                           className="p-0 h-auto text-xs mt-2"
449:                         >
450:                           Show more
451:                         </Button>
452:                       )}
453:                     </CardContent>
454:                   </Card>
455:                 );
456:               })}
457:               {filteredAndSortedChunks.length === 0 && (
458:                 <div className="text-center py-8 text-muted-foreground">
459:                   <FileText className="h-12 w-12 mx-auto mb-4 opacity-50" />
460:                   <p>No chunks match your search criteria</p>
461:                   <Button
462:                     variant="outline"
463:                     size="sm"
464:                     onClick={() => {
465:                       setSearchQuery("");
466:                       setFilterByPage(null);
467:                     }}
468:                     className="mt-2"
469:                   >
470:                     Clear filters
471:                   </Button>
472:                 </div>
473:               )}
474:             </div>
475:           )}
476:         </ScrollArea>
477:       </CardContent>
478:     </Card>
479:   );
480: }
