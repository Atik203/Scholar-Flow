561:   /**
562:    * Upsert WorkspaceSettings for a workspace. Caller must be the owner.
563:    */
564:   static async updateWorkspaceSettings(
565:     userId: string,
566:     workspaceId: string,
567:     data: {
568:       color?: string;
569:       coverImageKey?: string | null;
570:       iconKey?: string | null;
571:       allowExternalSharing?: boolean;
572:       allowDownload?: boolean;
573:       defaultMemberRole?: string;
574:       requireApprovalForJoin?: boolean;
575:       allowMemberInvites?: boolean;
576:       allowPublicCollections?: boolean;
577:       aiFeaturesEnabled?: boolean;
578:       enforce2FAForMembers?: boolean;
579:       allowedEmailDomains?: string[];
580:     }
581:   ) {
582:     const perm = await prisma.$queryRaw<any[]>`
583:       SELECT m.role, w."ownerId"
584:       FROM "WorkspaceMember" m JOIN "Workspace" w ON w.id = m."workspaceId"
585:       WHERE m."userId" = ${userId} AND m."workspaceId" = ${workspaceId} AND m."isDeleted" = false AND w."isDeleted" = false
586:       LIMIT 1
587:     `;
588:     const ctx = perm[0];
589:     if (!ctx) throw new ApiError(403, "Not a member of this workspace");
590:     if (ctx.role !== "OWNER" && ctx.ownerId !== userId) {
591:       throw new ApiError(403, "Only workspace owner can update settings");
592:     }
593:     const updated = await prisma.workspaceSettings.upsert({
594:       where: { workspaceId },
595:       create: {
596:         workspaceId,
597:         color: data.color,
598:         coverImageKey: data.coverImageKey,
599:         iconKey: data.iconKey,
600:         allowExternalSharing: data.allowExternalSharing,
601:         allowDownload: data.allowDownload,
602:         defaultMemberRole: data.defaultMemberRole as any,
603:         requireApprovalForJoin: data.requireApprovalForJoin,
604:         allowMemberInvites: data.allowMemberInvites,
605:         allowPublicCollections: data.allowPublicCollections,
606:         aiFeaturesEnabled: data.aiFeaturesEnabled,
607:         enforce2FAForMembers: data.enforce2FAForMembers,
608:         allowedEmailDomains: data.allowedEmailDomains ?? [],
609:       },
610:       update: {
611:         ...(data.color !== undefined && { color: data.color }),
612:         ...(data.coverImageKey !== undefined && { coverImageKey: data.coverImageKey }),
613:         ...(data.iconKey !== undefined && { iconKey: data.iconKey }),
614:         ...(data.allowExternalSharing !== undefined && { allowExternalSharing: data.allowExternalSharing }),
615:         ...(data.allowDownload !== undefined && { allowDownload: data.allowDownload }),
616:         ...(data.defaultMemberRole !== undefined && { defaultMemberRole: data.defaultMemberRole as any }),
617:         ...(data.requireApprovalForJoin !== undefined && { requireApprovalForJoin: data.requireApprovalForJoin }),
618:         ...(data.allowMemberInvites !== undefined && { allowMemberInvites: data.allowMemberInvites }),
619:         ...(data.allowPublicCollections !== undefined && { allowPublicCollections: data.allowPublicCollections }),
620:         ...(data.aiFeaturesEnabled !== undefined && { aiFeaturesEnabled: data.aiFeaturesEnabled }),
621:         ...(data.enforce2FAForMembers !== undefined && { enforce2FAForMembers: data.enforce2FAForMembers }),
622:         ...(data.allowedEmailDomains !== undefined && { allowedEmailDomains: data.allowedEmailDomains }),
623:       },
624:     });
625:     // Keep denormalized color in sync
626:     if (data.color) {
627:       await prisma.workspace.update({
628:         where: { id: workspaceId },
629:         data: { color: data.color },
630:       });
631:     }
632:     // Log activity
633:     await prisma.activityLogEntry.create({
634:       data: {
635:         userId,
636:         workspaceId,
637:         entity: "WorkspaceSettings",
638:         entityId: workspaceId,
639:         action: "UPDATE",
640:         severity: "INFO",
641:       },
642:     });
643:     return updated;
644:   }
645:   /**
646:    * Get aggregated stats for a workspace (papers, collections, members, storage estimate).
647:    */
648:   static async getWorkspaceStats(userId: string, workspaceId: string) {
649:     await this.getWorkspace(userId, workspaceId);
650:     const [papers, collections, members] = await Promise.all([
651:       prisma.paper.count({ where: { workspaceId, isDeleted: false } }),
