  1: "use client"
  2: import * as React from "react"
  3: import { useHotkeys } from "react-hotkeys-hook"
  4: import { type Editor } from "@tiptap/react"
  5: import { useTiptapEditor } from "@/hooks/use-tiptap-editor"
  6: import { useIsMobile } from "@/hooks/use-mobile"
  7: import {
  8:   isExtensionAvailable,
  9:   isNodeTypeSelected,
 10: } from "@/lib/tiptap-utils"
 11: import { ImagePlusIcon } from "@/components/tiptap-icons/image-plus-icon"
 12: export const IMAGE_UPLOAD_SHORTCUT_KEY = "mod+shift+i"
 13: export interface UseImageUploadConfig {
 14:   editor?: Editor | null
 15:   hideWhenUnavailable?: boolean
 16:   onInserted?: () => void
 17: }
 18: export function canInsertImage(editor: Editor | null): boolean {
 19:   if (!editor || !editor.isEditable) return false
 20:   if (
 21:     !isExtensionAvailable(editor, "imageUpload") ||
 22:     isNodeTypeSelected(editor, ["image"])
 23:   )
 24:     return false
 25:   return editor.can().insertContent({ type: "imageUpload" })
 26: }
 27: export function isImageActive(editor: Editor | null): boolean {
 28:   if (!editor || !editor.isEditable) return false
 29:   return editor.isActive("imageUpload")
 30: }
 31: export function insertImage(editor: Editor | null): boolean {
 32:   if (!editor || !editor.isEditable) return false
 33:   if (!canInsertImage(editor)) return false
 34:   try {
 35:     return editor
 36:       .chain()
 37:       .focus()
 38:       .insertContent({
 39:         type: "imageUpload",
 40:       })
 41:       .run()
 42:   } catch {
 43:     return false
 44:   }
 45: }
 46: export function shouldShowButton(props: {
 47:   editor: Editor | null
 48:   hideWhenUnavailable: boolean
 49: }): boolean {
 50:   const { editor, hideWhenUnavailable } = props
 51:   if (!editor || !editor.isEditable) return false
 52:   if (!isExtensionAvailable(editor, "imageUpload")) return false
 53:   if (hideWhenUnavailable && !editor.isActive("code")) {
 54:     return canInsertImage(editor)
 55:   }
 56:   return true
 57: }
 58: export function useImageUpload(config?: UseImageUploadConfig) {
 59:   const {
 60:     editor: providedEditor,
 61:     hideWhenUnavailable = false,
 62:     onInserted,
 63:   } = config || {}
 64:   const { editor } = useTiptapEditor(providedEditor)
 65:   const isMobile = useIsMobile()
 66:   const [isVisible, setIsVisible] = React.useState<boolean>(true)
 67:   const canInsert = canInsertImage(editor)
 68:   const isActive = isImageActive(editor)
 69:   React.useEffect(() => {
 70:     if (!editor) return
 71:     const handleSelectionUpdate = () => {
 72:       setIsVisible(shouldShowButton({ editor, hideWhenUnavailable }))
 73:     }
 74:     handleSelectionUpdate()
 75:     editor.on("selectionUpdate", handleSelectionUpdate)
 76:     return () => {
 77:       editor.off("selectionUpdate", handleSelectionUpdate)
 78:     }
 79:   }, [editor, hideWhenUnavailable])
 80:   const handleImage = React.useCallback(() => {
 81:     if (!editor) return false
 82:     const success = insertImage(editor)
 83:     if (success) {
 84:       onInserted?.()
 85:     }
 86:     return success
 87:   }, [editor, onInserted])
 88:   useHotkeys(
 89:     IMAGE_UPLOAD_SHORTCUT_KEY,
 90:     (event) => {
 91:       event.preventDefault()
 92:       handleImage()
 93:     },
 94:     {
 95:       enabled: isVisible && canInsert,
 96:       enableOnContentEditable: !isMobile,
 97:       enableOnFormTags: true,
 98:     }
 99:   )
100:   return {
101:     isVisible,
102:     isActive,
103:     handleImage,
104:     canInsert,
105:     label: "Add image",
106:     shortcutKeys: IMAGE_UPLOAD_SHORTCUT_KEY,
107:     Icon: ImagePlusIcon,
108:   }
109: }
</file>

