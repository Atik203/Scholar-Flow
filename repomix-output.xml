108:   const focusAreas = form.watch("focusAreas") || [];
109:   const applyFocusArea = () => {
110:     const trimmed = focusDraft.trim();
111:     if (!trimmed) {
112:       return;
113:     }
114:     if (focusAreas.includes(trimmed)) {
115:       showErrorToast("Focus area already added");
116:       setFocusDraft("");
