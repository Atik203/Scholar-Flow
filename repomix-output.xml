 94:       data: { starred: !notification.starred },
 95:     });
 96:   },
 97:   async markAllAsRead(userId: string) {
 98:     return prisma.notification.updateMany({
 99:       where: { userId, read: false },
100:       data: { read: true },
101:     });
102:   },
103:   async deleteNotification(userId: string, notificationId: string) {
104:     const notification = await prisma.notification.findUnique({
105:       where: { id: notificationId },
106:     });
107:     if (!notification || notification.userId !== userId) {
108:       throw new ApiError(404, "Notification not found");
109:     }
110:     await prisma.notification.delete({
111:       where: { id: notificationId },
112:     });
113:     return { success: true };
114:   },
115:   async deleteBulk(userId: string, notificationIds: string[]) {
