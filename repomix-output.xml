  4: const NotificationService = {
  5:   async listNotifications(
  6:     userId: string,
  7:     limit: number,
  8:     cursor: string | undefined,
  9:     query: {
 10:       type?: string;
 11:       read?: string;
 12:       starred?: string;
 13:     }
 14:   ) {
 15:     const where: Prisma.NotificationWhereInput = { userId };
 16:     if (query.type && query.type !== "all") {
 17:       where.type = query.type as NotificationType;
 18:     }
 19:     if (query.read === "unread") {
 20:       where.read = false;
 21:     } else if (query.read === "read") {
 22:       where.read = true;
 23:     }
 24:     if (query.starred === "true") {
 25:       where.starred = true;
 26:     } else if (query.starred === "false") {
 27:       where.starred = false;
 28:     }
 29:     const [total, data] = await Promise.all([
 30:       prisma.notification.count({ where }),
 31:       prisma.notification.findMany({
 32:         where,
 33:         take: limit + 1,
 34:         ...(cursor ? { cursor: { id: cursor }, skip: 1 } : {}),
 35:         orderBy: [{ createdAt: "desc" }, { id: "desc" }],
 36:         include: {
 37:           actor: {
 38:             select: { name: true, image: true, firstName: true, lastName: true },
 39:           },
 40:         },
 41:       }),
 42:     ]);
 43:     const hasMore = data.length > limit;
 44:     const sliced = hasMore ? data.slice(0, -1) : data;
 45:     const formattedData = sliced.map((n) => ({
 46:       ...n,
 47:       actor: n.actor
 48:         ? {
 49:             name:
 50:               n.actor.name ||
 51:               `${n.actor.firstName || ""} ${n.actor.lastName || ""}`.trim() ||
 52:               "Unknown",
 53:             image: n.actor.image,
 54:           }
 55:         : undefined,
 56:     }));
 57:     return {
 58:       meta: {
 59:         total,
 60:         limit,
 61:         nextCursor: hasMore ? formattedData[formattedData.length - 1].id : null,
 62:         hasMore,
 63:       },
 64:       result: formattedData,
 65:     };
 66:   },
 67:   async getUnreadCount(userId: string) {
 68:     const count = await prisma.notification.count({
 69:       where: { userId, read: false },
 70:     });
 71:     return { count };
 72:   },
 73:   async markAsRead(userId: string, notificationId: string) {
 74:     const notification = await prisma.notification.findUnique({
 75:       where: { id: notificationId },
 76:     });
 77:     if (!notification || notification.userId !== userId) {
 78:       throw new ApiError(404, "Notification not found");
 79:     }
 80:     return prisma.notification.update({
 81:       where: { id: notificationId },
 82:       data: { read: true },
 83:     });
 84:   },
 85:   async toggleStarred(userId: string, notificationId: string) {
 86:     const notification = await prisma.notification.findUnique({
 87:       where: { id: notificationId },
 88:     });
 89:     if (!notification || notification.userId !== userId) {
 90:       throw new ApiError(404, "Notification not found");
 91:     }
 92:     return prisma.notification.update({
