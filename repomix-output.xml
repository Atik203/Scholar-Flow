 37:         }
 38:       }
 39:       if (
 40:         user?.role &&
 41:         (destination === "/dashboard" || destination === "/dashboard/")
 42:       ) {
 43:         destination = getRoleDashboardUrl(user.role);
 44:       }
 45:       router.replace(destination);
 46:       return;
 47:     }
 48:   }, [isAuthenticated, status, requireAuth, redirectTo, redirectAuthenticatedTo, router, user?.role]);
 49:   return {
 50:     isAuthenticated,
 51:     status,
 52:     isLoading,
 53:     session: isAuthenticated ? { user } : null,
 54:     user: isAuthenticated ? user : null,
 55:   };
 56: }
