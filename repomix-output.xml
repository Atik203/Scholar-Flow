488:     try {
489:       // Check if note exists and belongs to user
490:       const existingNotes = await prisma.$queryRaw<any[]>`
491:         SELECT id, "userId"
492:         FROM "ResearchNote"
493:         WHERE id = ${noteId}
494:           AND "userId" = ${userId}
495:           AND "isDeleted" = false
496:         LIMIT 1
497:       `;
