<file path="figma-make/pages/search/SearchHistoryPage.tsx">
"use client";

import {
  AlertCircle,
  BookOpen,
  Calendar,
  CheckCircle,
  ChevronDown,
  Clock,
  Download,
  ExternalLink,
  FileText,
  FolderOpen,
  History,
  RotateCcw,
  Search,
  Star,
