 12: export interface ButtonProps
 13:   extends React.ButtonHTMLAttributes<HTMLButtonElement> {
 14:   className?: string
 15:   showTooltip?: boolean
 16:   tooltip?: React.ReactNode
 17:   shortcutKeys?: string
 18: }
 19: export const ShortcutDisplay: React.FC<{ shortcuts: string[] }> = ({
 20:   shortcuts,
 21: }) => {
 22:   if (shortcuts.length === 0) return null
 23:   return (
 24:     <div>
 25:       {shortcuts.map((key, index) => (
 26:         <React.Fragment key={index}>
 27:           {index > 0 && <kbd>+</kbd>}
 28:           <kbd>{key}</kbd>
 29:         </React.Fragment>
 30:       ))}
 31:     </div>
 32:   )
 33: }
 34: export const Button = React.forwardRef<HTMLButtonElement, ButtonProps>(
 35:   (
 36:     {
 37:       className,
 38:       children,
 39:       tooltip,
 40:       showTooltip = true,
 41:       shortcutKeys,
 42:       "aria-label": ariaLabel,
 43:       ...props
 44:     },
 45:     ref
 46:   ) => {
 47:     const shortcuts = React.useMemo(
 48:       () => parseShortcutKeys({ shortcutKeys }),
 49:       [shortcutKeys]
 50:     )
 51:     if (!tooltip || !showTooltip) {
 52:       return (
 53:         <button
 54:           className={cn("tiptap-button", className)}
 55:           ref={ref}
 56:           aria-label={ariaLabel}
 57:           {...props}
 58:         >
 59:           {children}
 60:         </button>
 61:       )
 62:     }
 63:     return (
 64:       <Tooltip delay={200}>
 65:         <TooltipTrigger
 66:           className={cn("tiptap-button", className)}
 67:           ref={ref}
 68:           aria-label={ariaLabel}
 69:           {...props}
 70:         >
 71:           {children}
 72:         </TooltipTrigger>
 73:         <TooltipContent>
