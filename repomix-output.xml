290:             data-style="ghost"
291:             onClick={(e) => {
292:               e.stopPropagation();
293:               onRemove();
294:             }}
295:           >
296:             <CloseIcon className="tiptap-button-icon" />
297:           </Button>
298:         </div>
299:       </div>
300:     </div>
301:   );
302: };
303: const DropZoneContent: React.FC<{ maxSize: number; limit: number }> = ({
304:   maxSize,
305:   limit,
306: }) => (
307:   <>
308:     <div className="tiptap-image-upload-dropzone">
309:       <FileIcon />
310:       <FileCornerIcon />
311:       <div className="tiptap-image-upload-icon-container">
312:         <CloudUploadIcon />
313:       </div>
314:     </div>
315:     <div className="tiptap-image-upload-content">
316:       <span className="tiptap-image-upload-text">
317:         <em>Click to upload</em> or drag and drop
318:       </span>
319:       <span className="tiptap-image-upload-subtext">
320:         Maximum {limit} file{limit === 1 ? "" : "s"}, {maxSize / 1024 / 1024}MB
321:         each.
322:       </span>
323:     </div>
324:   </>
325: );
326: export const ImageUploadNode: React.FC<NodeViewProps> = (props) => {
327:   const { accept, limit, maxSize } = props.node.attrs;
328:   const inputRef = React.useRef<HTMLInputElement>(null);
329:   const extension = props.extension;
330:   const uploadOptions: UploadOptions = {
331:     maxSize,
332:     limit,
333:     accept,
334:     upload: extension.options.upload,
335:     onSuccess: extension.options.onSuccess,
336:     onError: extension.options.onError,
337:   };
338:   const { fileItems, uploadFiles, removeFileItem, clearAllFiles } =
339:     useFileUpload(uploadOptions);
340:   const handleUpload = async (files: File[]) => {
341:     const urls = await uploadFiles(files);
342:     if (urls.length > 0) {
343:       const pos = props.getPos();
344:       if (isValidPosition(pos)) {
345:         const imageNodes = urls.map((url, index) => {
346:           const filename =
347:             files[index]?.name.replace(/\.[^/.]+$/, "") || "unknown";
348:           return {
349:             type: extension.options.type,
350:             attrs: {
351:               src: url,
352:               alt: filename,
353:               title: filename,
354:               width: 400,
355:               height: 300,
356:               "data-keep-ratio": true,
357:             },
358:           };
359:         });
360:         props.editor
361:           .chain()
362:           .focus()
363:           .deleteRange({ from: pos, to: pos + props.node.nodeSize })
364:           .insertContentAt(pos, imageNodes)
365:           .run();
366:         focusNextNode(props.editor);
367:       }
368:     }
369:   };
370:   const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
371:     const files = e.target.files;
372:     if (!files || files.length === 0) {
373:       extension.options.onError?.(new Error("No file selected"));
374:       return;
375:     }
376:     handleUpload(Array.from(files));
377:   };
378:   const handleClick = () => {
379:     if (inputRef.current && fileItems.length === 0) {
380:       inputRef.current.value = "";
381:       inputRef.current.click();
382:     }
383:   };
384:   const hasFiles = fileItems.length > 0;
385:   return (
386:     <NodeViewWrapper
387:       className="tiptap-image-upload"
388:       tabIndex={0}
389:       onClick={handleClick}
390:     >
391:       {!hasFiles && (
392:         <ImageUploadDragArea onFile={handleUpload}>
393:           <DropZoneContent maxSize={maxSize} limit={limit} />
394:         </ImageUploadDragArea>
395:       )}
396:       {hasFiles && (
397:         <div className="tiptap-image-upload-previews">
398:           {fileItems.length > 1 && (
399:             <div className="tiptap-image-upload-header">
400:               <span>Uploading {fileItems.length} files</span>
401:               <Button
402:                 type="button"
403:                 data-style="ghost"
404:                 onClick={(e) => {
405:                   e.stopPropagation();
406:                   clearAllFiles();
407:                 }}
408:               >
409:                 Clear All
410:               </Button>
411:             </div>
412:           )}
413:           {fileItems.map((fileItem) => (
414:             <ImageUploadPreview
415:               key={fileItem.id}
416:               fileItem={fileItem}
417:               onRemove={() => removeFileItem(fileItem.id)}
418:             />
419:           ))}
420:         </div>
421:       )}
422:       <input
423:         ref={inputRef}
424:         name="file"
425:         accept={accept}
426:         type="file"
427:         multiple={limit > 1}
428:         onChange={handleChange}
429:         onClick={(e: React.MouseEvent<HTMLInputElement>) => e.stopPropagation()}
430:       />
431:     </NodeViewWrapper>
432:   );
433: };
</file>

