280:                   key={node.id}
281:                   paperId={node.id}
282:                   nodesById={nodesById}
283:                   onEdges={onEdges}
284:                   onError={onCitationError}
285:                 />
286:               ))}
287:             </svg>
288:             {nodes.map((node) => (
289:               <motion.div
290:                 key={node.id}
291:                 initial={{ scale: 0, opacity: 0 }}
292:                 animate={{ scale: 1, opacity: 1 }}
293:                 exit={{ scale: 0, opacity: 0 }}
294:                 transition={{ type: "spring", stiffness: 300, damping: 20 }}
295:                 className="absolute -translate-x-1/2 -translate-y-1/2 cursor-pointer group"
296:                 style={{ left: node.x, top: node.y }}
