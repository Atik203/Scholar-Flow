  7: import { Button } from "@/components/ui/button";
  8: import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
  9: import {
 10:   Dialog,
 11:   DialogContent,
 12:   DialogDescription,
 13:   DialogHeader,
 14:   DialogTitle,
 15: } from "@/components/ui/dialog";
 16: import { Input } from "@/components/ui/input";
 17: import { Label } from "@/components/ui/label";
 18: import {
 19:   Select,
 20:   SelectContent,
 21:   SelectItem,
 22:   SelectTrigger,
 23:   SelectValue,
 24: } from "@/components/ui/select";
 25: import { Textarea } from "@/components/ui/textarea";
 26: import { showApiErrorToast } from "@/lib/errorHandling";
 27: import {
 28:   useGetPaperSharesQuery,
 29:   useRevokePaperShareMutation,
 30:   useShareViaEmailMutation,
 31: } from "@/redux/api/paperApi";
 32: import { useGetTeamMembersQuery } from "@/redux/api/teamApi";
 33: import { Copy, Link, Loader2, Mail, ShieldCheck, Share2, Trash2, Users, X } from "lucide-react";
 34: import React, { useState } from "react";
 35: interface ShareModalProps {
 36:   isOpen: boolean;
 37:   onClose: () => void;
 38:   paperId: string;
 39:   paperTitle: string;
 40:   isPublished: boolean;
 41: }
 42: export function ShareModal({
 43:   isOpen,
 44:   onClose,
 45:   paperId,
 46:   paperTitle,
 47:   isPublished,
 48: }: ShareModalProps) {
 49:   const [shareUrl, setShareUrl] = useState("");
 50:   const [isGeneratingLink, setIsGeneratingLink] = useState(false);
 51:   // Email sharing states
 52:   const [recipientEmail, setRecipientEmail] = useState("");
 53:   const [permission, setPermission] = useState<"view" | "edit">("view");
 54:   const [message, setMessage] = useState("");
 55:   const [shareViaEmail, { isLoading: isEmailSharing }] =
 56:     useShareViaEmailMutation();
 57:   const { data: sharesResponse } = useGetPaperSharesQuery(paperId, {
 58:     skip: !isOpen,
 59:   });
 60:   const [revokeShare] = useRevokePaperShareMutation();
 61:   const shares = sharesResponse ?? [];
 62:   // Team sharing
 63:   const [showTeamPicker, setShowTeamPicker] = useState(false);
 64:   const [sharingMemberId, setSharingMemberId] = useState<string | null>(null);
 65:   const { data: teamData, isLoading: teamLoading } = useGetTeamMembersQuery(
 66:     { limit: 50 },
 67:     { skip: !isOpen || !showTeamPicker }
 68:   );
 69:   const teamMembers = teamData?.data ?? [];
 70:   const sharedEmails = new Set(shares.map((share) => share.email.toLowerCase()));
 71:   React.useEffect(() => {
 72:     if (isOpen && isPublished) {
 73:       const url = `${window.location.origin}/public-view/${paperId}`;
 74:       setShareUrl(url);
 75:     } else if (!isOpen) {
 76:       // Reset email form when modal closes
 77:       setRecipientEmail("");
 78:       setPermission("view");
 79:       setMessage("");
 80:       setShareUrl("");
 81:       setShowTeamPicker(false);
 82:     }
 83:   }, [isOpen, isPublished, paperId]);
 84:   const copyToClipboard = async (text: string) => {
 85:     try {
 86:       await navigator.clipboard.writeText(text);
 87:       showSuccessToast("Copied to clipboard!");
 88:     } catch {
 89:       showErrorToast("Failed to copy to clipboard");
 90:     }
 91:   };
 92:   const generateShareLink = async () => {
 93:     setIsGeneratingLink(true);
 94:     try {
 95:       const url = `${window.location.origin}/public-view/${paperId}`;
 96:       setShareUrl(url);
 97:       showSuccessToast("Share link generated!");
 98:     } finally {
 99:       setIsGeneratingLink(false);
100:     }
101:   };
102:   const handleEmailShare = async () => {
103:     if (!recipientEmail) {
104:       return;
105:     }
106:     try {
107:       await shareViaEmail({
108:         paperId,
109:         recipientEmail,
110:         permission,
111:         message,
112:       }).unwrap();
113:       showSuccessToast(
114:         `Paper "${paperTitle}" shared with ${recipientEmail} successfully!`
115:       );
116:       setRecipientEmail("");
117:       setMessage("");
118:       setPermission("view");
119:     } catch (error: any) {
120:       showApiErrorToast(error);
121:     }
122:   };
123:   const handleTeamShare = async (member: {
124:     id: string;
125:     email: string;
126:     name: string;
127:   }) => {
128:     setSharingMemberId(member.id);
129:     try {
130:       await shareViaEmail({
131:         paperId,
132:         recipientEmail: member.email,
133:         permission,
134:         message,
135:       }).unwrap();
136:       showSuccessToast(`Shared with ${member.name || member.email}`);
137:     } catch (error: any) {
138:       showApiErrorToast(error);
139:     } finally {
140:       setSharingMemberId(null);
141:     }
142:   };
143:   return (
144:     <Dialog open={isOpen} onOpenChange={onClose}>
145:       <DialogContent className="sm:max-w-[500px]">
146:         <DialogHeader>
147:           <DialogTitle className="flex items-center gap-2">
148:             <Share2 className="h-5 w-5" />
149:             Share Paper
150:           </DialogTitle>
151:           <DialogDescription>
152:             Share "{paperTitle}" with others
153:           </DialogDescription>
154:         </DialogHeader>
155:         <div className="space-y-6">
156:           {}
157:           <Card>
158:             <CardHeader className="pb-3">
159:               <CardTitle className="text-sm font-medium">
160:                 Paper Status
161:               </CardTitle>
162:             </CardHeader>
163:             <CardContent>
164:               <div className="flex items-center gap-2">
165:                 <Badge variant={isPublished ? "default" : "secondary"}>
166:                   {isPublished ? "Published" : "Draft"}
167:                 </Badge>
168:                 <span className="text-sm text-muted-foreground">
169:                   {isPublished
170:                     ? "This paper is published and can be shared publicly"
171:                     : "Publish your paper to enable public sharing"}
172:                 </span>
173:               </div>
174:             </CardContent>
175:           </Card>
176:           {}
177:           {isPublished ? (
178:             <div className="space-y-3">
179:               <Label htmlFor="share-url">Share Link</Label>
180:               <div className="flex gap-2">
181:                 <Input
182:                   id="share-url"
183:                   value={shareUrl}
184:                   readOnly
185:                   className="flex-1"
186:                 />
187:                 <Button
188:                   variant="outline"
189:                   size="icon"
190:                   onClick={() => copyToClipboard(shareUrl)}
191:                 >
192:                   <Copy className="h-4 w-4" />
193:                 </Button>
194:               </div>
195:             </div>
196:           ) : (
197:             <div className="space-y-3">
198:               <Label>Generate Share Link</Label>
199:               <div className="text-sm text-muted-foreground mb-3">
200:                 Create a temporary shareable link for this draft paper.
201:               </div>
202:               <Button
203:                 onClick={generateShareLink}
204:                 disabled={isGeneratingLink}
205:                 className="w-full"
206:               >
207:                 <Link className="mr-2 h-4 w-4" />
208:                 {isGeneratingLink ? "Generating..." : "Generate Share Link"}
209:               </Button>
210:               {shareUrl && (
211:                 <div className="flex gap-2 mt-3">
212:                   <Input value={shareUrl} readOnly className="flex-1" />
213:                   <Button
214:                     variant="outline"
215:                     size="icon"
216:                     onClick={() => copyToClipboard(shareUrl)}
217:                   >
218:                     <Copy className="h-4 w-4" />
219:                   </Button>
220:                 </div>
221:               )}
222:             </div>
223:           )}
224:           {}
225:           <div className="space-y-3">
226:             <Label>Share via Email</Label>
227:             <div className="space-y-3">
228:               <div className="flex gap-2">
229:                 <Input
230:                   type="email"
231:                   placeholder="colleague@university.edu"
232:                   value={recipientEmail}
233:                   onChange={(e) => setRecipientEmail(e.target.value)}
234:                   className="flex-1"
235:                 />
236:                 <Select
237:                   value={permission}
238:                   onValueChange={(value: "view" | "edit") =>
239:                     setPermission(value)
240:                   }
241:                 >
242:                   <SelectTrigger className="w-[120px]">
243:                     <SelectValue />
244:                   </SelectTrigger>
245:                   <SelectContent>
246:                     <SelectItem value="view">View Only</SelectItem>
247:                     <SelectItem value="edit">Can Edit</SelectItem>
248:                   </SelectContent>
249:                 </Select>
250:               </div>
251:               <Textarea
252:                 placeholder="Add a personal message (optional)..."
253:                 value={message}
254:                 onChange={(e) => setMessage(e.target.value)}
255:                 className="min-h-[60px] resize-none"
256:               />
257:               <Button
258:                 onClick={handleEmailShare}
259:                 disabled={!recipientEmail || isEmailSharing}
260:                 className="w-full"
261:               >
262:                 {isEmailSharing ? (
263:                   <>
264:                     <Loader2 className="mr-2 h-4 w-4 animate-spin" />
265:                     Sending...
266:                   </>
267:                 ) : (
268:                   <>
269:                     <Mail className="mr-2 h-4 w-4" />
270:                     Send Email Invitation
271:                   </>
272:                 )}
273:               </Button>
274:             </div>
275:           </div>
276:           {}
277:           {shares.length > 0 && (
278:             <div className="space-y-3">
279:               <Label className="flex items-center gap-2">
280:                 <ShieldCheck className="h-4 w-4" />
281:                 Shared with
282:               </Label>
283:               <ul className="space-y-2">
284:                 {shares.map((share) => (
285:                   <li
286:                     key={share.id}
287:                     className="flex items-center justify-between gap-2 rounded-md border border-muted/60 px-3 py-2 text-sm"
288:                   >
289:                     <div className="flex items-center gap-2 min-w-0">
290:                       <span className="truncate font-medium">{share.email}</span>
291:                       <Badge
292:                         variant={share.permission === "edit" ? "default" : "secondary"}
293:                       >
294:                         {share.permission === "edit" ? "Can Edit" : "View Only"}
295:                       </Badge>
296:                     </div>
297:                     <Button
298:                       variant="ghost"
299:                       size="icon"
300:                       className="h-7 w-7 text-muted-foreground hover:text-destructive"
301:                       title="Revoke access"
302:                       onClick={async () => {
303:                         try {
304:                           await revokeShare(share.id).unwrap();
305:                           showSuccessToast(`Access revoked for ${share.email}`);
306:                         } catch (error: any) {
307:                           showApiErrorToast(error);
308:                         }
309:                       }}
310:                     >
311:                       <Trash2 className="h-4 w-4" />
312:                     </Button>
313:                   </li>
314:                 ))}
315:               </ul>
316:             </div>
317:           )}
318:           {}
319:           <div className="space-y-3">
320:             <Label>Quick Share</Label>
321:             <div className="grid grid-cols-2 gap-2">
322:               <Button
323:                 variant="outline"
324:                 onClick={() => {
325:                   const subject = encodeURIComponent(
326:                     `Check out: ${paperTitle}`
327:                   );
328:                   const body = encodeURIComponent(
329:                     shareUrl
330:                       ? `I wanted to share this paper with you: ${shareUrl}`
331:                       : `I'm working on a research paper titled "${paperTitle}".`
332:                   );
333:                   window.open(`mailto:?subject=${subject}&body=${body}`);
334:                 }}
335:                 className="flex items-center gap-2"
336:               >
337:                 <Mail className="h-4 w-4" />
338:                 Email
339:               </Button>
340:               <Button
341:                 variant="outline"
342:                 onClick={() => setShowTeamPicker((prev) => !prev)}
343:                 className="flex items-center gap-2"
344:               >
345:                 <Users className="h-4 w-4" />
346:                 Team
347:               </Button>
348:             </div>
349:             {showTeamPicker && (
350:               <div className="space-y-3 rounded-lg border p-3">
351:                 <div className="flex items-center justify-between">
352:                   <p className="text-sm font-medium">
353:                     Share with team members ({permission === "edit" ? "Can Edit" : "View Only"})
354:                   </p>
355:                   <Button
356:                     variant="ghost"
357:                     size="icon"
358:                     className="h-6 w-6"
359:                     onClick={() => setShowTeamPicker(false)}
360:                     aria-label="Close team picker"
361:                   >
362:                     <X className="h-3.5 w-3.5" />
363:                   </Button>
364:                 </div>
365:                 {teamLoading ? (
366:                   <div className="space-y-2">
367:                     {Array.from({ length: 3 }).map((_, i) => (
368:                       <div
369:                         key={i}
370:                         className="h-10 animate-pulse rounded bg-muted"
371:                       />
372:                     ))}
373:                   </div>
374:                 ) : teamMembers.length === 0 ? (
375:                   <p className="py-4 text-center text-sm text-muted-foreground">
376:                     No team members yet. Invite people from the Team page.
377:                   </p>
378:                 ) : (
379:                   <div className="max-h-56 space-y-2 overflow-y-auto">
380:                     {teamMembers.map((member) => {
381:                       const alreadyShared = sharedEmails.has(
382:                         member.email.toLowerCase()
383:                       );
384:                       return (
385:                         <div
386:                           key={member.id}
387:                           className="flex items-center justify-between gap-2"
388:                         >
389:                           <div className="min-w-0">
390:                             <p className="truncate text-sm font-medium">
391:                               {member.name}
392:                             </p>
393:                             <p className="truncate text-xs text-muted-foreground">
394:                               {member.email}
395:                             </p>
396:                           </div>
397:                           <Button
398:                             size="sm"
399:                             variant={alreadyShared ? "secondary" : "outline"}
400:                             disabled={
401:                               alreadyShared || sharingMemberId === member.id
402:                             }
403:                             onClick={() => void handleTeamShare(member)}
404:                           >
405:                             {sharingMemberId === member.id ? (
406:                               <Loader2 className="h-3.5 w-3.5 animate-spin" />
407:                             ) : alreadyShared ? (
408:                               "Shared"
409:                             ) : (
410:                               "Share"
411:                             )}
412:                           </Button>
413:                         </div>
414:                       );
415:                     })}
416:                   </div>
417:                 )}
418:               </div>
419:             )}
420:           </div>
421:           {}
422:           <div className="flex justify-end space-x-2 pt-4 border-t">
423:             <Button variant="outline" onClick={onClose}>
424:               Close
425:             </Button>
426:           </div>
427:         </div>
428:       </DialogContent>
429:     </Dialog>
430:   );
431: }
</file>

