  [2, 1, 1, 1, 1, 1], // Analytics Dashboard
  [2, 2, 0, 0, 2, 2], // Subscription Billing
  [2, 2, 2, 1, 2, 2], // Enterprise Security
];

function SupportIcon({ level }: { level: number }) {
