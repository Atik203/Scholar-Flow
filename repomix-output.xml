128:     >({
129:       query: (data) => ({
130:         url: "/auth/forgot-password",
131:         method: "POST",
132:         body: data,
133:       }),
134:     }),
135:     resetPassword: builder.mutation<AuthMessageResponse, ResetPasswordRequest>({
136:       query: (data) => ({
137:         url: "/auth/reset-password",
138:         method: "POST",
139:         body: data,
140:       }),
141:     }),
142:     verifyEmail: builder.mutation<
143:       AuthMessageResponse,
144:       EmailVerificationRequest
145:     >({
146:       query: (data) => ({
147:         url: "/auth/verify-email",
148:         method: "POST",
149:         body: data,
150:       }),
151:       invalidatesTags: ["User"],
152:     }),
153:     sendEmailVerification: builder.mutation<
154:       AuthMessageResponse,
155:       SendVerificationRequest
156:     >({
157:       query: (data) => ({
158:         url: "/auth/send-verification",
159:         method: "POST",
160:         body: data,
161:       }),
162:       invalidatesTags: ["User"],
163:     }),
164:     updateOnboarding: builder.mutation<
165:       { success: boolean; message: string; data: TUser },
166:       UpdateOnboardingRequest
167:     >({
168:       query: (data) => ({
169:         url: "/user/onboarding",
170:         method: "PUT",
171:         body: data,
172:       }),
173:       invalidatesTags: ["User"],
174:       async onQueryStarted(_, { dispatch, queryFulfilled }) {
175:         try {
176:           const { data } = await queryFulfilled;
177:           if (data.success && data.data) {
178:             dispatch(
179:               updateUser({
180:                 onboardingCompleted: data.data.onboardingCompleted,
181:                 onboardingStep: data.data.onboardingStep,
182:               })
183:             );
184:           }
185:         } catch {
186:         }
187:       },
188:     }),
189:   }),
190: });
