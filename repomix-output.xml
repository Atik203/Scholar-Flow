 86:   /**
 87:    * List team members.
 88:    *
 89:    * "Team" in Phase 5 = the set of users that the requesting team_lead / admin can manage.
 90:    * Since the platform has no org model yet, this returns users that share at least one
 91:    * workspace membership with the requester (excluding soft-deleted users).
 92:    */
 93:   static async listMembers(
 94:     userId: string,
 95:     limit: number,
 96:     cursor: string | undefined,
 97:     filters: {
 98:       search?: string;
 99:       role?: string;
100:       status?: string;
101:     }
102:   ) {
103:     const take = limit + 1;
104:     const where: Prisma.UserWhereInput = { isDeleted: false };
105:     if (filters.search) {
106:       where.OR = [
107:         { name: { contains: filters.search, mode: "insensitive" } },
108:         { email: { contains: filters.search, mode: "insensitive" } },
109:       ];
110:     }
111:     if (filters.role) {
112:       where.role = filters.role as any;
113:     }
114:     if (cursor) {
115:       const cursorUser = await prisma.user.findUnique({
116:         where: { id: cursor },
117:         select: { createdAt: true },
118:       });
119:       if (cursorUser) {
120:         where.createdAt = { lt: cursorUser.createdAt };
121:       }
122:     }
123:     const [users, total] = await Promise.all([
124:       prisma.user.findMany({
125:         where,
126:         take,
127:         orderBy: { createdAt: "desc" },
128:         select: {
129:           id: true,
130:           name: true,
131:           firstName: true,
132:           lastName: true,
133:           email: true,
134:           image: true,
135:           role: true,
136:           createdAt: true,
137:           memberships: {
138:             where: { isDeleted: false },
139:             select: {
140:               role: true,
141:               workspace: {
142:                 select: { id: true, name: true, color: true },
143:               },
144:             },
145:             take: 10,
146:           },
147:           _count: {
148:             select: {
149:               memberships: { where: { isDeleted: false } },
150:             },
151:           },
152:         },
153:       }),
154:       prisma.user.count({ where }),
155:     ]);
156:     const hasMore = users.length > limit;
157:     const sliced = hasMore ? users.slice(0, -1) : users;
158:     const formatted = sliced.map((u) => ({
159:       id: u.id,
160:       name: u.name || `${u.firstName || ""} ${u.lastName || ""}`.trim() || u.email,
161:       email: u.email,
162:       image: u.image,
163:       role: u.role,
164:       joinedAt: u.createdAt,
165:       lastActive: u.createdAt,
166:       status: "active" as const,
167:       workspaces: u.memberships.map((wm) => ({
168:         id: wm.workspace.id,
169:         name: wm.workspace.name,
170:         role: wm.role,
171:       })),
172:       workspaceCount: u._count.memberships,
173:     }));
174:     return {
175:       result: formatted,
176:       meta: { total, limit, hasMore, nextCursor: hasMore ? sliced[sliced.length - 1].id : null },
177:     };
178:   }
179:   static async getMember(userId: string, targetUserId: string) {
