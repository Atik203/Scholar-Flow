379:       WHERE "workspaceId" = ${workspaceId} AND "userId" = ${targetUser.id} AND "isDeleted" = false
380:     `;
381:     if (existingInvite[0]?.status === "PENDING") {
382:       throw new ApiError(400, "User already has a pending invitation");
383:     }
384:     // Create or update invitation
385:     const roleValue = payload.role || "EDITOR";
386:     const invitationResult = await prisma.$queryRaw<any[]>`
387:       INSERT INTO "WorkspaceInvitation" (id, "workspaceId", "userId", role, "invitedById", status, "invitedAt", "createdAt", "updatedAt", "isDeleted")
388:       VALUES (gen_random_uuid(), ${workspaceId}, ${targetUser.id}, ${roleValue}::"WorkspaceRole", ${inviterId}, 'PENDING'::"MembershipStatus", now(), now(), now(), false)
389:       ON CONFLICT ("workspaceId", "userId") DO UPDATE SET
390:         role = ${roleValue}::"WorkspaceRole",
391:         "invitedById" = EXCLUDED."invitedById",
392:         status = 'PENDING'::"MembershipStatus",
393:         "invitedAt" = now(),
394:         "acceptedAt" = null,
395:         "declinedAt" = null,
396:         "isDeleted" = false,
397:         "updatedAt" = now()
398:       RETURNING id
399:     `;
400:     // Send invitation email (similar to collection pattern)
401:     try {
402:       const emailService = (await import("../../shared/emailService")).default;
403:       await emailService.sendWorkspaceInvitationEmail({
404:         email: targetUser.email,
405:         name: targetUser.name || targetUser.email,
406:         workspaceName: ws.name,
407:         inviterName:
408:           (
409:             await prisma.$queryRaw<any[]>`
410:           SELECT name, email FROM "User" WHERE id = ${inviterId}
411:         `
412:           )[0]?.name || "A ScholarFlow user",
413:         workspaceId: workspaceId,
414:       });
415:     } catch (emailError) {
