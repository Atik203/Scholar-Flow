 202:   static async deleteWorkspace(userId: string, id: string) {
 203:     // Only Admin/Owner can delete
 204:     const perm = await prisma.$queryRaw<any[]>`
 205:       SELECT m.role, w."ownerId"
 206:       FROM "WorkspaceMember" m JOIN "Workspace" w ON w.id = m."workspaceId"
 207:       WHERE m."userId" = ${userId} AND m."workspaceId" = ${id} AND m."isDeleted" = false AND w."isDeleted" = false
 208:     `;
 209:     const member = perm[0];
 210:     if (!member) throw new ApiError(403, "Not a member of this workspace");
 211:     const isOwner = member.role === "OWNER" || member.ownerId === userId;
 212:     if (!isOwner)
 213:       throw new ApiError(403, "Only Owner can delete workspace");
 214:     // Soft delete workspace and cascade to related entities — all in one
 215:     // transaction so a partial failure can't leave the workspace half-deleted.
 216:     // Papers + collections (and their members/joins) are soft-deleted too so
 217:     // nothing keeps pointing at a deleted workspace.
 218:     await prisma.$transaction(async (tx) => {
 219:       await tx.$executeRaw`
 220:         UPDATE "Workspace" SET "isDeleted" = true, "updatedAt" = now() WHERE id = ${id}
 221:       `;
 222:       // Soft delete related invitations
 223:       await tx.$executeRaw`
 224:         UPDATE "WorkspaceInvitation" SET "isDeleted" = true, "updatedAt" = now()
 225:         WHERE "workspaceId" = ${id} AND "isDeleted" = false
 226:       `;
 227:       // Soft delete workspace members
 228:       await tx.$executeRaw`
 229:         UPDATE "WorkspaceMember" SET "isDeleted" = true, "updatedAt" = now()
 230:         WHERE "workspaceId" = ${id} AND "isDeleted" = false
 231:       `;
 232:       // Soft delete papers under the workspace
 233:       await tx.$executeRaw`
 234:         UPDATE "Paper" SET "isDeleted" = true, "updatedAt" = now()
 235:         WHERE "workspaceId" = ${id} AND "isDeleted" = false
 236:       `;
 237:       // Soft delete collections under the workspace
 238:       await tx.$executeRaw`
 239:         UPDATE "Collection" SET "isDeleted" = true, "updatedAt" = now()
 240:         WHERE "workspaceId" = ${id} AND "isDeleted" = false
 241:       `;
 242:       // Soft delete collection papers + members under the workspace's collections
 243:       await tx.$executeRaw`
 244:         UPDATE "CollectionPaper" cp SET "isDeleted" = true, "updatedAt" = now()
 245:         FROM "Collection" c
 246:         WHERE c.id = cp."collectionId" AND c."workspaceId" = ${id} AND cp."isDeleted" = false
 247:       `;
 248:       await tx.$executeRaw`
 249:         UPDATE "CollectionMember" cm SET "isDeleted" = true, "updatedAt" = now()
 250:         FROM "Collection" c
 251:         WHERE c.id = cm."collectionId" AND c."workspaceId" = ${id} AND cm."isDeleted" = false
 252:       `;
 253:       // Log the deletion activity
 254:       await tx.activityLogEntry.create({
 255:         data: {
 256:           userId,
 257:           workspaceId: id,
 258:           entity: "Workspace",
 259:           entityId: id,
 260:           action: "DELETE",
 261:           severity: "INFO",
 262:         },
 263:       });
 264:     });
 265:     return { success: true };
 266:   }
