237:       if (process.env.NODE_ENV === "development") {
238:         console.log(
239:           `📊 getUserCollections - returning ${transformedCollections.length} collections, total: ${total}`
240:         );
241:       }
242:       return {
243:         result: transformedCollections,
244:         meta: {
245:           page,
246:           limit,
247:           total,
248:           totalPage,
249:         },
250:       };
251:     } catch (error) {
252:       console.error("Error getting user collections:", error);
253:       throw error;
254:     }
255:   }
256:   static async searchCollections(
257:     searchTerm: string,
258:     limit: number = 10,
259:     skip: number = 0
260:   ) {
261:     try {
262:       const collections = await prisma.$queryRaw<CollectionAggregateRow[]>`
263:         SELECT
264:           c.id,
265:           c.name,
266:           c.description,
267:           c."isPublic",
268:           c."createdAt",
269:           c."updatedAt",
270:           u.email as "ownerEmail",
271:           u.name as "ownerName",
272:           COALESCE(paper_counts.paper_count, 0)::int as "paperCount",
273:           COALESCE(member_counts.member_count, 0)::int as "memberCount",
274:           (
275:             CASE
276:               WHEN c.name ILIKE ${`%${searchTerm}%`} THEN 10
277:               ELSE 0
278:             END +
279:             CASE
280:               WHEN c.description ILIKE ${`%${searchTerm}%`} THEN 5
281:               ELSE 0
282:             END
283:           ) as relevance_score
284:         FROM "Collection" c
285:         LEFT JOIN "User" u ON c."ownerId" = u.id
286:         LEFT JOIN (
287:           SELECT "collectionId", COUNT(*)::int AS paper_count
288:           FROM "CollectionPaper"
289:           WHERE "isDeleted" = false
290:           GROUP BY "collectionId"
291:         ) paper_counts ON paper_counts."collectionId" = c.id
292:         LEFT JOIN (
293:           SELECT "collectionId", COUNT(*)::int AS member_count
294:           FROM "CollectionMember"
295:           WHERE "isDeleted" = false AND status = 'ACCEPTED'
296:           GROUP BY "collectionId"
297:         ) member_counts ON member_counts."collectionId" = c.id
298:         WHERE c."isDeleted" = false
299:           AND (
300:             c.name ILIKE ${`%${searchTerm}%`}
301:             OR c.description ILIKE ${`%${searchTerm}%`}
302:           )
303:         ORDER BY relevance_score DESC, c."createdAt" DESC
304:         LIMIT ${limit} OFFSET ${skip}
305:       `;
306:       const transformedCollections = collections.map((collection) => ({
307:         ...collection,
308:         owner: {
309:           id: collection.ownerId,
310:           name: collection.ownerName || "Unknown",
311:           email: collection.ownerEmail || "unknown@example.com",
312:         },
313:         _count: {
314:           papers: collection.paperCount,
315:           members: collection.memberCount ?? 0,
316:         },
317:       }));
318:       return {
319:         result: transformedCollections,
320:         meta: {
321:           searchTerm,
322:           count: transformedCollections.length,
323:         },
324:       };
325:     } catch (error) {
326:       console.error("Error searching collections:", error);
327:       throw error;
328:     }
329:   }
330:   static async hasEditPermission(
331:     collectionId: string,
332:     userId: string
333:   ): Promise<boolean> {
334:     try {
335:       const result = await prisma.$queryRaw<
336:         Array<{ hasEditPermission: boolean }>
337:       >`
338:         SELECT
339:           CASE
340:             WHEN c."ownerId" = ${userId} THEN true
341:             WHEN cm."permission" = 'EDIT' AND cm.status = 'ACCEPTED' THEN true
342:             ELSE false
343:           END as "hasEditPermission"
344:         FROM "Collection" c
345:         LEFT JOIN "CollectionMember" cm ON c.id = cm."collectionId" AND cm."userId" = ${userId}
346:         WHERE c.id = ${collectionId} AND c."isDeleted" = false
347:         LIMIT 1
348:       `;
349:       return result[0]?.hasEditPermission === true;
350:     } catch (error) {
351:       console.error("Error checking edit permission:", error);
352:       throw error;
353:     }
354:   }
355:   static async getUserPermission(
356:     collectionId: string,
357:     userId: string
358:   ): Promise<"OWNER" | "EDIT" | "VIEW" | null> {
359:     try {
360:       const result = await prisma.$queryRaw<
361:         Array<{ permission: "OWNER" | "EDIT" | "VIEW" | null }>
362:       >`
363:         SELECT
364:           CASE
365:             WHEN c."ownerId" = ${userId} THEN 'OWNER'
366:             WHEN cm."permission" = 'EDIT' AND cm.status = 'ACCEPTED' THEN 'EDIT'
367:             WHEN cm."permission" = 'VIEW' AND cm.status = 'ACCEPTED' THEN 'VIEW'
368:             ELSE NULL
369:           END as "permission"
370:         FROM "Collection" c
371:         LEFT JOIN "CollectionMember" cm ON c.id = cm."collectionId" AND cm."userId" = ${userId}
372:         WHERE c.id = ${collectionId} AND c."isDeleted" = false
373:         LIMIT 1
374:       `;
375:       return result[0]?.permission || null;
376:     } catch (error) {
377:       console.error("Error getting user permission:", error);
378:       throw error;
379:     }
380:   }
381: }
