940:   static parseBibTeX(content: string): ImportedPaper[] {
941:     const entries = content.split(/@\w+\{/g).filter(Boolean).map((e) => {
942:       const titleMatch = e.match(/title\s*=\s*\{([^}]*)\}/);
943:       const authorMatch = e.match(/author\s*=\s*\{([^}]*)\}/);
944:       const yearMatch = e.match(/year\s*=\s*\{(\d+)\}/);
945:       const doiMatch = e.match(/doi\s*=\s*\{([^}]*)\}/);
946:       const abstractMatch = e.match(/abstract\s*=\s*\{([^}]*)\}/);
947:       return {
948:         title: titleMatch?.[1] || "Untitled",
949:         authors: authorMatch?.[1]
950:           ?.split(" and ")
951:           .map((a) => a.split(",").reverse().join(" ").trim()) || [],
952:         year: yearMatch ? parseInt(yearMatch[1], 10) : 2024,
953:         abstract: abstractMatch?.[1] || "",
954:         doi: doiMatch?.[1],
955:         source: "bibtex",
956:       };
957:     });
958:     return entries;
959:   }
960:   static parseRIS(content: string): ImportedPaper[] {
961:     const lines = content.split(/\r?\n/);
962:     const papers: ImportedPaper[] = [];
963:     let current: Partial<ImportedPaper> = {};
964:     for (const line of lines) {
965:       if (line.match(/^TY\s+-\s/)) {
966:         current = { source: "ris" };
967:       }
968:       if (line.match(/^ER\s+-\s/) && current.title) {
969:         papers.push({
970:           title: current.title || "Untitled",
971:           authors: current.authors || [],
972:           year: current.year || 2024,
973:           abstract: current.abstract || "",
974:           doi: current.doi,
975:           source: "ris",
976:         });
977:         current = {};
978:       }
979:       const tag = line.substring(0, 2);
980:       const value = line.substring(6).trim();
981:       if (tag === "T1") current.title = value;
982:       if (tag === "AU") current.authors = [...(current.authors || []), value];
983:       if (tag === "PY") current.year = parseInt(value, 10) || 2024;
984:       if (tag === "AB") current.abstract = value;
985:       if (tag === "DO") current.doi = value;
986:     }
987:     return papers;
988:   }
989: }
990: export const importService = {
991:   importByDOI: ImportService.importByDOI,
992:   importByArxiv: ImportService.importByArxiv,
993:   importByURL: ImportService.importByURL,
994:   importBySmartURL: ImportService.importBySmartURL,
995:   parseBibTeX: ImportService.parseBibTeX,
996:   parseRIS: ImportService.parseRIS,
997: };
