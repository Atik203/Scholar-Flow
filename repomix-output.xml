<file path="apps/backend/src/app/modules/Admin/adminPlans.service.ts">
  1: import prisma from "../../shared/prisma";
  2: import ApiError from "../../errors/ApiError";
  3: import stripe, { isStripeError, logStripeError } from "../../shared/stripe";
  4: export type PlanUpsertInput = {
  5:   code: string;
  6:   name: string;
  7:   priceCents: number;
  8:   currency: string;
  9:   interval: string;
 10:   active?: boolean;
 11:   features?: Record<string, unknown>;
 12:   stripePriceId?: string;
 13: };
 14: export const adminPlansService = {
 15:   async listPlansWithStats() {
 16:     const plans = await prisma.plan.findMany({
 17:       where: { isDeleted: false },
 18:       orderBy: { priceCents: "asc" },
 19:     });
 20:     const stats = await prisma.$queryRaw<
 21:       Array<{
 22:         planId: string;
 23:         status: string;
 24:         active: bigint;
 25:         canceled: bigint;
 26:         total: bigint;
 27:       }>
 28:     >`
 29:       SELECT
 30:         s."planId",
 31:         s.status::text,
 32:         COUNT(*) FILTER (
 33:           WHERE s.status = 'ACTIVE'
 34:             AND s."cancelAtPeriodEnd" = false
 35:             AND (s."trialEnd" IS NULL OR s."trialEnd" <= NOW())
 36:         )::bigint AS active,
 37:         COUNT(*) FILTER (WHERE s.status = 'CANCELED')::bigint AS canceled,
 38:         COUNT(*)::bigint AS total
 39:       FROM "Subscription" s
 40:       WHERE s."isDeleted" = false
 41:       GROUP BY s."planId", s.status
 42:     `;
 43:     const aggregated = new Map<
 44:       string,
 45:       { active: number; canceled: number; total: number }
 46:     >();
 47:     for (const row of stats) {
 48:       const entry = aggregated.get(row.planId) ?? {
 49:         active: 0,
 50:         canceled: 0,
 51:         total: 0,
 52:       };
 53:       entry.total += Number(row.total);
 54:       entry.active += Number(row.active);
 55:       entry.canceled += Number(row.canceled);
 56:       aggregated.set(row.planId, entry);
 57:     }
 58:     return plans.map((p) => {
 59:       const s = aggregated.get(p.id) ?? { active: 0, canceled: 0, total: 0 };
 60:       const monthlyRevenueCents =
 61:         p.interval === "month"
 62:           ? p.priceCents * s.active
 63:           : Math.round((p.priceCents / 12) * s.active);
 64:       return {
 65:         ...p,
 66:         activeSubscribers: s.active,
 67:         canceledSubscribers: s.canceled,
 68:         totalSubscribers: s.total,
 69:         monthlyRevenueCents,
 70:       };
 71:     });
 72:   },
 73:   async createPlan(input: PlanUpsertInput) {
 74:     const existing = await prisma.plan.findUnique({
 75:       where: { code: input.code },
 76:     });
 77:     if (existing) {
 78:       throw new ApiError(400, `Plan code "${input.code}" already exists`);
 79:     }
 80:     return prisma.plan.create({
 81:       data: {
 82:         code: input.code,
 83:         name: input.name,
 84:         priceCents: input.priceCents,
 85:         currency: input.currency,
 86:         interval: input.interval,
 87:         active: input.active ?? true,
 88:         features: (input.features ?? {}) as object,
 89:       },
 90:     });
 91:   },
 92:   async updatePlan(id: string, patch: Partial<PlanUpsertInput>) {
 93:     const plan = await prisma.plan.findFirst({
 94:       where: { id, isDeleted: false },
 95:     });
 96:     if (!plan) throw new ApiError(404, "Plan not found");
 97:     if (patch.code && patch.code !== plan.code) {
 98:       const clash = await prisma.plan.findUnique({ where: { code: patch.code } });
 99:       if (clash && clash.id !== id) {
100:         throw new ApiError(400, `Plan code "${patch.code}" already exists`);
101:       }
102:     }
103:     const nameChanged = patch.name && patch.name !== plan.name;
104:     const priceChanged =
105:       (patch.priceCents != null && patch.priceCents !== plan.priceCents) ||
106:       (patch.currency && patch.currency !== plan.currency) ||
107:       (patch.interval && patch.interval !== plan.interval);
108:     if (priceChanged && plan.stripePriceId) {
109:       let productId: string | null = null;
110:       try {
111:         const oldPrice = await stripe.prices.retrieve(plan.stripePriceId);
112:         productId =
113:           typeof oldPrice.product === "string"
114:             ? oldPrice.product
115:             : (oldPrice.product?.id ?? null);
116:       } catch (error) {
117:         if (isStripeError(error)) logStripeError(error, "plan edit: retrieve price");
118:         throw new ApiError(
119:           400,
120:           `Stripe price lookup failed: ${error instanceof Error ? error.message : "Unknown error"}`
121:         );
122:       }
123:       if (!productId) {
124:         throw new ApiError(400, "Existing Stripe price has no product reference");
125:       }
126:       const interval =
127:         (patch.interval ?? plan.interval) === "year" ? "year" : "month";
128:       try {
129:         const newPrice = await stripe.prices.create({
130:           product: productId,
131:           unit_amount: patch.priceCents ?? plan.priceCents,
132:           currency: patch.currency ?? plan.currency,
133:           recurring: { interval },
134:           nickname: `${patch.name ?? plan.name} (${interval})`,
135:         });
136:         patch.stripePriceId = newPrice.id;
137:       } catch (error) {
138:         if (isStripeError(error)) logStripeError(error, "plan edit: create price");
139:         throw new ApiError(
140:           400,
141:           `Stripe price creation failed: ${error instanceof Error ? error.message : "Unknown error"}`
142:         );
143:       }
144:     } else if (nameChanged && plan.stripePriceId) {
145:       try {
146:         const oldPrice = await stripe.prices.retrieve(plan.stripePriceId);
147:         const productId =
148:           typeof oldPrice.product === "string"
149:             ? oldPrice.product
150:             : (oldPrice.product?.id ?? null);
151:         if (productId) {
152:           await stripe.products.update(productId, { name: patch.name! });
153:         }
154:       } catch (error) {
155:         if (isStripeError(error)) logStripeError(error, "plan edit: update product");
156:         throw new ApiError(
157:           400,
158:           `Stripe product rename failed: ${error instanceof Error ? error.message : "Unknown error"}`
159:         );
160:       }
161:     }
162:     return prisma.plan.update({
163:       where: { id },
164:       data: {
165:         ...(patch.code ? { code: patch.code } : {}),
166:         ...(patch.name ? { name: patch.name } : {}),
167:         ...(patch.priceCents != null ? { priceCents: patch.priceCents } : {}),
168:         ...(patch.currency ? { currency: patch.currency } : {}),
169:         ...(patch.interval ? { interval: patch.interval } : {}),
170:         ...(patch.active != null ? { active: patch.active } : {}),
171:         ...(patch.features ? { features: patch.features as object } : {}),
172:         ...(patch.stripePriceId ? { stripePriceId: patch.stripePriceId } : {}),
173:       },
174:     });
175:   },
176:   async deletePlan(id: string) {
177:     const plan = await prisma.plan.findFirst({
178:       where: { id, isDeleted: false },
179:     });
180:     if (!plan) throw new ApiError(404, "Plan not found");
181:     const subscribers = await prisma.$queryRaw<Array<{ count: bigint }>>`
182:       SELECT COUNT(*)::bigint as count
183:       FROM "Subscription"
184:       WHERE "planId" = ${id}
185:         AND status = 'ACTIVE'
186:         AND "isDeleted" = false
187:     `;
188:     if (Number(subscribers[0]?.count || 0) > 0) {
189:       throw new ApiError(
190:         400,
191:         "Plan has active subscribers — mark it inactive instead of deleting"
192:       );
193:     }
194:     return prisma.plan.update({
195:       where: { id },
196:       data: { isDeleted: true },
197:     });
198:   },
199:   async toggleActive(id: string) {
200:     const plan = await prisma.plan.findFirst({
201:       where: { id, isDeleted: false },
202:     });
203:     if (!plan) throw new ApiError(404, "Plan not found");
204:     return prisma.plan.update({
205:       where: { id },
206:       data: { active: !plan.active },
207:     });
208:   },
209: };
</file>

<file path="apps/backend/src/app/modules/Admin/adminSubscribers.service.ts">
  1: import prisma, { Prisma } from "../../shared/prisma";
  2: import ApiError from "../../errors/ApiError";
  3: import stripe, { isStripeError, logStripeError } from "../../shared/stripe";
  4: import { analyticsService } from "./analytics.service";
  5: type SubscriberRow = {
  6:   id: string;
  7:   userId: string;
  8:   planId: string;
  9:   status: string;
 10:   providerSubscriptionId: string | null;
 11: };
 12: const resolveSubscription = async (id: string): Promise<SubscriberRow> => {
 13:   const rows = await prisma.$queryRaw<SubscriberRow[]>`
 14:     SELECT id, "userId", "planId", status::text, "providerSubscriptionId"
 15:     FROM "Subscription"
 16:     WHERE id = ${id}
 17:       AND "isDeleted" = false
 18:     LIMIT 1
 19:   `;
 20:   if (!rows[0]) {
 21:     throw new ApiError(404, "Subscription not found");
 22:   }
 23:   return rows[0];
 24: };
 25: const getStripeSubscriptionId = (sub: SubscriberRow): string => {
 26:   if (!sub.providerSubscriptionId) {
 27:     throw new ApiError(400, "Subscription has no Stripe reference");
 28:   }
 29:   return sub.providerSubscriptionId;
 30: };
 31: const writeAudit = async (
 32:   actorId: string,
 33:   subscriptionId: string,
 34:   action: string,
 35:   details: Prisma.InputJsonValue
 36: ): Promise<void> => {
 37:   await prisma.activityLogEntry.create({
 38:     data: {
 39:       userId: actorId,
 40:       entity: "subscription",
 41:       entityId: subscriptionId,
 42:       action,
 43:       severity: "WARNING",
 44:       details,
 45:     },
 46:   });
 47: };
 48: const handleStripeError = (error: unknown, context: string): never => {
 49:   if (isStripeError(error)) {
 50:     logStripeError(error, context);
 51:   }
 52:   throw new ApiError(
 53:     400,
 54:     `Stripe operation failed: ${error instanceof Error ? error.message : "Unknown error"}`
 55:   );
 56: };
 57: export const adminSubscribersService = {
 58:   async listSubscribers(
 59:     page: number,
 60:     limit: number,
 61:     status?: string,
 62:     planId?: string
 63:   ) {
 64:     return analyticsService.getSubscriberDetails(page, limit, status, planId);
 65:   },
 66:   async cancelAtPeriodEnd(subscriptionId: string, actorId: string) {
 67:     const sub = await resolveSubscription(subscriptionId);
 68:     if (sub.status !== "ACTIVE") {
 69:       throw new ApiError(400, `Cannot cancel a ${sub.status} subscription`);
 70:     }
 71:     try {
 72:       await stripe.subscriptions.update(
 73:         getStripeSubscriptionId(sub),
 74:         { cancel_at_period_end: true }
 75:       );
 76:     } catch (error) {
 77:       handleStripeError(error, "admin cancel at period end");
 78:     }
 79:     await prisma.$executeRaw`
 80:       UPDATE "Subscription"
 81:       SET "cancelAtPeriodEnd" = true, "updatedAt" = NOW()
 82:       WHERE id = ${sub.id}
 83:     `;
 84:     await writeAudit(actorId, subscriptionId, "canceled_at_period_end", {
 85:       userId: sub.userId,
 86:     });
 87:   },
 88:   /**
 89:    * Reactivate a subscription that was canceled at period end
 90:    */
 91:   async reactivate(subscriptionId: string, actorId: string) {
 92:     const sub = await resolveSubscription(subscriptionId);
 93:     if (sub.status !== "ACTIVE") {
 94:       throw new ApiError(400, `Cannot reactivate a ${sub.status} subscription`);
 95:     }
 96:     try {
 97:       await stripe.subscriptions.update(
 98:         getStripeSubscriptionId(sub),
 99:         { cancel_at_period_end: false }
100:       );
101:     } catch (error) {
102:       handleStripeError(error, "admin reactivate");
103:     }
104:     await prisma.$executeRaw`
105:       UPDATE "Subscription"
106:       SET "cancelAtPeriodEnd" = false, "updatedAt" = NOW()
107:       WHERE id = ${sub.id}
108:     `;
109:     await writeAudit(actorId, subscriptionId, "reactivated", {
110:       userId: sub.userId,
111:     });
112:   },
113:   /**
114:    * Cancel immediately — Stripe cancels at period end with proration when
115:    * possible; the customer.subscription.deleted webhook finalizes the local
116:    * state (status CANCELED + role revert).
117:    */
118:   async cancelNow(subscriptionId: string, actorId: string) {
119:     const sub = await resolveSubscription(subscriptionId);
120:     if (sub.status !== "ACTIVE") {
121:       throw new ApiError(400, `Cannot cancel a ${sub.status} subscription`);
122:     }
123:     try {
124:       await stripe.subscriptions.cancel(getStripeSubscriptionId(sub));
125:     } catch (error) {
126:       handleStripeError(error, "admin cancel now");
127:     }
128:     await writeAudit(actorId, subscriptionId, "canceled_now", {
129:       userId: sub.userId,
130:     });
131:   },
132:   async changePlan(
133:     subscriptionId: string,
134:     priceId: string,
135:     actorId: string
136:   ) {
137:     const sub = await resolveSubscription(subscriptionId);
138:     const plan = await prisma.$queryRaw<
139:       Array<{ id: string; code: string; active: boolean }>
140:     >`
141:       SELECT id, code, active
142:       FROM "Plan"
143:       WHERE "stripePriceId" = ${priceId}
144:         AND "isDeleted" = false
145:       LIMIT 1
146:     `;
147:     if (!plan[0]) {
148:       throw new ApiError(400, "Unknown Stripe price ID — not a configured plan");
149:     }
150:     if (!plan[0].active) {
151:       throw new ApiError(400, `Plan ${plan[0].code} is inactive`);
152:     }
153:     try {
154:       const stripeSub = await stripe.subscriptions.retrieve(
155:         getStripeSubscriptionId(sub)
156:       );
157:       const itemId = stripeSub.items.data[0]?.id;
158:       if (!itemId) {
159:         throw new ApiError(400, "Subscription has no items to reprice");
160:       }
161:       await stripe.subscriptions.update(stripeSub.id, {
162:         items: [{ id: itemId, price: priceId }],
163:         proration_behavior: "create_prorations",
164:       });
165:     } catch (error) {
166:       if (error instanceof ApiError) throw error;
167:       handleStripeError(error, "admin change plan");
168:     }
169:     await prisma.$executeRaw`
170:       UPDATE "Subscription"
171:       SET "planId" = ${plan[0].id}, "updatedAt" = NOW()
172:       WHERE id = ${sub.id}
173:     `;
174:     await writeAudit(actorId, subscriptionId, "plan_changed", {
175:       userId: sub.userId,
176:       planCode: plan[0].code,
177:     });
178:   },
179: };
</file>

<file path="apps/backend/src/app/modules/Admin/analytics.service.ts">
  1: import prisma from "../../shared/prisma";
  2: export const analyticsService = {
  3:   async getRevenueAnalytics(timeRange: "7d" | "30d" | "90d" | "1y" = "30d") {
  4:     const now = new Date();
  5:     const rangeMap = {
  6:       "7d": 7,
  7:       "30d": 30,
  8:       "90d": 90,
  9:       "1y": 365,
 10:     };
 11:     const days = rangeMap[timeRange];
 12:     const startDate = new Date(now.getTime() - days * 24 * 60 * 60 * 1000);
 13:     const subscriptionStats = await prisma.$queryRaw<
 14:       Array<{ status: string; count: bigint }>
 15:     >`
 16:       SELECT
 17:         status::text,
 18:         COUNT(*)::bigint as count
 19:       FROM "Subscription"
 20:       WHERE "isDeleted" = false
 21:       GROUP BY status
 22:     `;
 23:     const subscriptionsByPlan = await prisma.$queryRaw<
 24:       Array<{ planName: string; count: bigint }>
 25:     >`
 26:       SELECT
 27:         p.name as "planName",
 28:         COUNT(s.id)::bigint as count
 29:       FROM "Subscription" s
 30:       JOIN "Plan" p ON s."planId" = p.id
 31:       WHERE s."isDeleted" = false
 32:         AND s.status = 'ACTIVE'
 33:         AND (s."trialEnd" IS NULL OR s."trialEnd" <= NOW())
 34:       GROUP BY p.name
 35:       ORDER BY count DESC
 36:     `;
 37:     const mrrData = await prisma.$queryRaw<
 38:       Array<{ totalMrr: string; currency: string }>
 39:     >`
 40:       SELECT
 41:         SUM(
 42:           CASE
 43:             WHEN p.interval = 'month' THEN p."priceCents"
 44:             WHEN p.interval = 'year' THEN ROUND(p."priceCents"::numeric / 12)
 45:             ELSE 0
 46:           END
 47:         )::numeric / 100 as "totalMrr",
 48:         p.currency
 49:       FROM "Subscription" s
 50:       JOIN "Plan" p ON s."planId" = p.id
 51:       WHERE s."isDeleted" = false
 52:         AND s.status = 'ACTIVE'
 53:         AND s."cancelAtPeriodEnd" = false
 54:         AND (s."trialEnd" IS NULL OR s."trialEnd" <= NOW())
 55:       GROUP BY p.currency
 56:     `;
 57:     const arr =
 58:       mrrData.length > 0 ? parseFloat(mrrData[0].totalMrr || "0") * 12 : 0;
 59:     const mrr = mrrData.length > 0 ? parseFloat(mrrData[0].totalMrr || "0") : 0;
 60:     const revenueData = await prisma.$queryRaw<
 61:       Array<{ totalRevenue: string; currency: string }>
 62:     >`
 63:       SELECT
 64:         SUM("amountCents")::numeric / 100 as "totalRevenue",
 65:         currency
 66:       FROM "Payment"
 67:       WHERE status = 'SUCCEEDED'
 68:         AND "isDeleted" = false
 69:         AND "createdAt" >= ${startDate}
 70:       GROUP BY currency
 71:     `;
 72:     const revenueTrend = await prisma.$queryRaw<
 73:       Array<{ date: Date; revenue: string; count: bigint }>
 74:     >`
 75:       SELECT
 76:         DATE("createdAt") as date,
 77:         SUM("amountCents")::numeric / 100 as revenue,
 78:         COUNT(*)::bigint as count
 79:       FROM "Payment"
 80:       WHERE status = 'SUCCEEDED'
 81:         AND "isDeleted" = false
 82:         AND "createdAt" >= ${startDate}
 83:       GROUP BY DATE("createdAt")
 84:       ORDER BY date ASC
 85:     `;
 86:     const failedPayments = await prisma.$queryRaw<Array<{ count: bigint }>>`
 87:       SELECT COUNT(*)::bigint as count
 88:       FROM "Payment"
 89:       WHERE status = 'FAILED'
 90:         AND "isDeleted" = false
 91:         AND "createdAt" >= ${startDate}
 92:     `;
 93:     const newSubscriptions = await prisma.$queryRaw<Array<{ count: bigint }>>`
 94:       SELECT COUNT(*)::bigint as count
 95:       FROM "Subscription"
 96:       WHERE "createdAt" >= ${startDate}
 97:         AND "isDeleted" = false
 98:     `;
 99:     const canceledSubscriptions = await prisma.$queryRaw<
100:       Array<{ count: bigint }>
101:     >`
102:       SELECT COUNT(*)::bigint as count
103:       FROM "Subscription"
104:       WHERE "canceledAt" >= ${startDate}
105:         AND "isDeleted" = false
106:     `;
107:     const activeUsersData = await prisma.$queryRaw<
108:       Array<{ activeUsers: bigint }>
109:     >`
110:       SELECT COUNT(DISTINCT s."userId")::bigint as "activeUsers"
111:       FROM "Subscription" s
112:       WHERE s."isDeleted" = false
113:         AND s.status = 'ACTIVE'
114:         AND s."cancelAtPeriodEnd" = false
115:         AND (s."trialEnd" IS NULL OR s."trialEnd" <= NOW())
116:     `;
117:     const activeUsers = Number(activeUsersData[0]?.activeUsers || 0);
118:     const churnData = await prisma.$queryRaw<
119:       Array<{ churnRate: string; canceled: bigint; totalActive: bigint }>
120:     >`
121:       WITH canceled_in_period AS (
122:         SELECT COUNT(*)::bigint as canceled
123:         FROM "Subscription"
124:         WHERE "canceledAt" >= ${startDate}
125:           AND "isDeleted" = false
126:       ),
127:       active_at_start AS (
128:         SELECT COUNT(*)::bigint as "totalActive"
129:         FROM "Subscription"
130:         WHERE "createdAt" < ${startDate}
131:           AND "isDeleted" = false
132:           AND (status = 'ACTIVE' OR "canceledAt" >= ${startDate})
133:       )
134:       SELECT
135:         CASE
136:           WHEN a."totalActive" > 0
137:           THEN (c.canceled::numeric / a."totalActive"::numeric * 100)::text
138:           ELSE '0'
139:         END as "churnRate",
140:         c.canceled,
141:         a."totalActive"
142:       FROM canceled_in_period c, active_at_start a
143:     `;
144:     return {
145:       mrr: {
146:         amount: mrr,
147:         currency: mrrData[0]?.currency || "USD",
148:       },
149:       arr: {
150:         amount: arr,
151:         currency: mrrData[0]?.currency || "USD",
152:       },
153:       totalRevenue: {
154:         amount:
155:           revenueData.length > 0 ? parseFloat(revenueData[0].totalRevenue) : 0,
156:         currency: revenueData[0]?.currency || "USD",
157:         period: timeRange,
158:       },
159:       subscriptions: {
160:         byStatus: subscriptionStats.map((s) => ({
161:           status: s.status,
162:           count: Number(s.count),
163:         })),
164:         byPlan: subscriptionsByPlan.map((p) => ({
165:           plan: p.planName,
166:           count: Number(p.count),
167:         })),
168:         new: Number(newSubscriptions[0]?.count || 0),
169:         canceled: Number(canceledSubscriptions[0]?.count || 0),
170:       },
171:       payments: {
172:         failed: Number(failedPayments[0]?.count || 0),
173:       },
174:       metrics: {
175:         arpu:
176:           mrr > 0 && activeUsers > 0 ? mrr / activeUsers : 0,
177:         activeUsers,
178:         churnRate:
179:           churnData.length > 0 && churnData[0].churnRate
180:             ? parseFloat(churnData[0].churnRate)
181:             : 0,
182:       },
183:       revenueTrend: revenueTrend.map((r) => ({
184:         date: r.date.toISOString().split("T")[0],
185:         revenue: parseFloat(r.revenue),
186:         transactionCount: Number(r.count),
187:       })),
188:       timeRange,
189:     };
190:   },
191:   async getTopCustomers(limit: number = 10) {
192:     const safeLimit = Math.min(Math.max(limit, 1), 50);
193:     const topCustomers = await prisma.$queryRaw<
194:       Array<{
195:         userId: string;
196:         userName: string;
197:         userEmail: string;
198:         totalSpent: string;
199:         subscriptionStatus: string;
200:         planName: string;
201:       }>
202:     >`
203:       SELECT
204:         u.id as "userId",
205:         u.name as "userName",
206:         u.email as "userEmail",
207:         COALESCE(SUM(pay."amountCents")::numeric / 100, 0) as "totalSpent",
208:         s.status::text as "subscriptionStatus",
209:         p.name as "planName"
210:       FROM "User" u
211:       LEFT JOIN LATERAL (
212:         SELECT s2.status, s2."planId"
213:         FROM "Subscription" s2
214:         WHERE s2."userId" = u.id
215:           AND s2."isDeleted" = false
216:         ORDER BY
217:           CASE s2.status
218:             WHEN 'ACTIVE' THEN 0
219:             WHEN 'PAST_DUE' THEN 1
220:             ELSE 2
221:           END,
222:           s2."createdAt" DESC
223:         LIMIT 1
224:       ) s ON true
225:       LEFT JOIN "Plan" p ON s."planId" = p.id
226:       LEFT JOIN "Payment" pay
227:         ON u.id = pay."userId"
228:         AND pay.status = 'SUCCEEDED'
229:         AND pay."isDeleted" = false
230:       WHERE u."isDeleted" = false
231:       GROUP BY u.id, u.name, u.email, s.status, p.name
232:       ORDER BY "totalSpent" DESC
233:       LIMIT ${safeLimit}
234:     `;
235:     return topCustomers.map((c) => ({
236:       userId: c.userId,
237:       name: c.userName,
238:       email: c.userEmail,
239:       totalSpent: parseFloat(c.totalSpent),
240:       subscriptionStatus: c.subscriptionStatus,
241:       currentPlan: c.planName,
242:     }));
243:   },
244:   async getSubscriberDetails(
245:     page: number = 1,
246:     limit: number = 20,
247:     status?: string,
248:     planId?: string
249:   ) {
250:     const offset = (page - 1) * limit;
251:     const hasStatusFilter = status && status !== "all";
252:     const hasPlanFilter = !!planId;
253:     const normalizedStatus =
254:       hasStatusFilter && status === "TRIALING" ? "ACTIVE" : status;
255:     let countResult: Array<{ count: bigint }>;
256:     let subscribers: Array<{
257:       subscriptionId: string;
258:       userId: string;
259:       userName: string;
260:       userEmail: string;
261:       planName: string;
262:       status: string;
263:       seats: number;
264:       currentPeriodStart: Date | null;
265:       currentPeriodEnd: Date | null;
266:       cancelAtPeriodEnd: boolean;
267:       createdAt: Date;
268:       totalSpent: string;
269:       lastPaymentDate: Date | null;
270:     }>;
271:     if (hasStatusFilter && hasPlanFilter) {
272:       countResult = await prisma.$queryRaw<Array<{ count: bigint }>>`
273:         SELECT COUNT(*)::bigint as count
274:         FROM "Subscription" s
275:         WHERE s."isDeleted" = false
276:           AND s.status = ${normalizedStatus}::"SubscriptionStatus"
277:           AND s."planId" = ${planId}
278:       `;
279:       subscribers = await prisma.$queryRaw`
280:         SELECT
281:           s.id as "subscriptionId",
282:           u.id as "userId",
283:           u.name as "userName",
284:           u.email as "userEmail",
285:           p.name as "planName",
286:           s.status::text,
287:           s.seats,
288:           s."currentPeriodStart",
289:           s."currentPeriodEnd",
290:           s."cancelAtPeriodEnd",
291:           s."createdAt",
292:           COALESCE(
293:             (
294:               SELECT SUM(pay."amountCents")::numeric / 100
295:               FROM "Payment" pay
296:               WHERE pay."subscriptionId" = s.id
297:                 AND pay.status = 'SUCCEEDED'
298:                 AND pay."isDeleted" = false
299:             ),
300:             0
301:           ) as "totalSpent",
302:           (
303:             SELECT MAX(pay."createdAt")
304:             FROM "Payment" pay
305:             WHERE pay."subscriptionId" = s.id
306:               AND pay.status = 'SUCCEEDED'
307:               AND pay."isDeleted" = false
308:           ) as "lastPaymentDate"
309:         FROM "Subscription" s
310:         JOIN "User" u ON s."userId" = u.id
311:         JOIN "Plan" p ON s."planId" = p.id
312:         WHERE s."isDeleted" = false
313:           AND u."isDeleted" = false
314:           AND s.status = ${normalizedStatus}::"SubscriptionStatus"
315:           AND s."planId" = ${planId}
316:         ORDER BY s."createdAt" DESC
317:         LIMIT ${limit}
