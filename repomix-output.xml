<file path="apps/backend/src/app/middleware/errorHandler.ts">
 1: import { Request, Response, NextFunction } from 'express';
 2: export interface AppError extends Error {
 3:   statusCode?: number;
 4:   isOperational?: boolean;
 5: }
 6: export const errorHandler = (
 7:   err: AppError,
 8:   req: Request,
 9:   res: Response,
10:   _next: NextFunction
11: ) => {
12:   let { statusCode = 500, message } = err;
13:   if (err.name === 'ValidationError') {
14:     statusCode = 400;
15:     message = 'Validation error';
16:   } else if (err.name === 'CastError') {
17:     statusCode = 400;
18:     message = 'Invalid data format';
19:   } else if (err.name === 'JsonWebTokenError') {
20:     statusCode = 401;
21:     message = 'Invalid token';
22:   } else if (err.name === 'TokenExpiredError') {
23:     statusCode = 401;
24:     message = 'Token expired';
25:   }
26:   console.error(`Error ${statusCode}: ${message}`, {
27:     error: err,
28:     url: req.url,
29:     method: req.method,
30:     ip: req.ip,
31:     userAgent: req.get('User-Agent'),
32:   });
33:   res.status(statusCode).json({
34:     error: message,
35:     ...(process.env.NODE_ENV === 'development' && { stack: err.stack }),
36:   });
37: };
38: export const createError = (message: string, statusCode: number = 500): AppError => {
39:   const error = new Error(message) as AppError;
40:   error.statusCode = statusCode;
41:   error.isOperational = true;
42:   return error;
43: };
</file>

<file path="apps/backend/src/app/middleware/performanceMonitor.ts">
  1: import { NextFunction, Request, Response } from "express";
  2: export const performanceMonitor = (
  3:   req: Request,
  4:   res: Response,
  5:   next: NextFunction
  6: ) => {
  7:   const start = Date.now();
  8:   const startTime = process.hrtime.bigint();
  9:   res.on("finish", () => {
 10:     const duration = Date.now() - start;
 11:     const hrDuration = process.hrtime.bigint() - startTime;
 12:     const hrMs = Number(hrDuration) / 1000000;
 13:     if (!res.headersSent) {
 14:       res.setHeader("X-Response-Time", `${duration}ms`);
 15:       res.setHeader("X-Response-Time-HR", `${hrMs.toFixed(3)}ms`);
 16:     }
 17:     logRequestPerformance(req, res, duration, hrMs);
 18:   });
 19:   next();
 20: };
 21: function logRequestPerformance(
 22:   req: Request,
 23:   res: Response,
 24:   duration: number,
 25:   hrDuration: number
 26: ) {
 27:   const method = req.method;
 28:   const url = req.originalUrl || req.url;
 29:   const statusCode = res.statusCode;
 30:   const userAgent = req.get("User-Agent") || "unknown";
 31:   const ip = req.ip || req.connection.remoteAddress;
 32:   const logData = {
 33:     method,
 34:     url,
 35:     statusCode,
 36:     duration: `${duration}ms`,
 37:     hrDuration: `${hrDuration.toFixed(3)}ms`,
 38:     ip: ip?.replace(/^.*:/, ""), // Clean IPv6-mapped IPv4 addresses
 39:     timestamp: new Date().toISOString(),
 40:   };
 41:   // Categorize and log based on performance
 42:   if (duration >= 5000) {
 43:     // Very slow requests (5+ seconds)
 44:     console.error("🚨 VERY SLOW REQUEST:", {
 45:       ...logData,
 46:       level: "CRITICAL",
 47:       userAgent: userAgent.substring(0, 100),
 48:     });
 49:   } else if (duration >= 2000) {
 50:     console.warn("⚠️  SLOW REQUEST:", {
 51:       ...logData,
 52:       level: "WARNING",
 53:     });
 54:   } else if (duration >= 1000) {
 55:     console.info("📊 MODERATE REQUEST:", {
 56:       ...logData,
 57:       level: "INFO",
 58:     });
 59:   } else if (process.env.NODE_ENV === "development" && duration >= 500) {
 60:     console.log("⏱️  REQUEST:", {
 61:       ...logData,
 62:       level: "DEBUG",
 63:     });
 64:   }
 65:   if (statusCode >= 500) {
 66:     console.error("💥 SERVER ERROR:", {
 67:       ...logData,
 68:       level: "ERROR",
 69:     });
 70:   } else if (statusCode >= 400) {
 71:     console.warn("⚠️  CLIENT ERROR:", {
 72:       ...logData,
 73:       level: "WARNING",
 74:     });
 75:   }
 76:   if (url.includes("/papers") && duration > 1000) {
 77:     console.warn("📄 SLOW PAPER OPERATION:", {
 78:       ...logData,
 79:       endpoint: "papers",
 80:       level: "PAPER_PERFORMANCE",
 81:     });
 82:   }
 83:   if (url.includes("/auth") && duration > 500) {
 84:     console.warn("🔐 SLOW AUTH OPERATION:", {
 85:       ...logData,
 86:       endpoint: "auth",
 87:       level: "AUTH_PERFORMANCE",
 88:     });
 89:   }
 90: }
 91: export const routePerformanceMonitor = (routeName: string) => {
