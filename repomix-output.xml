  1: generator client {
  2:   provider        = "prisma-client-js"
  3:   engineType      = "binary"
  4:   previewFeatures = ["postgresqlExtensions", "typedSql"]
  5: }
  6: 
  7: datasource db {
  8:   provider  = "postgresql"
  9:   url       = env("DATABASE_URL")
 10:   directUrl = env("DIRECT_DATABASE_URL") // for migrations requiring extension install (superuser)
 11:   // extensions = [pgvector] // Temporarily disabled for password migration
 12: }
 13: 
 14: enum Role {
 15:   RESEARCHER
 16:   PRO_RESEARCHER
 17:   TEAM_LEAD
 18:   ADMIN
 19: }
 20: 
 21: // Workspace-level roles (separate from global application Role)
 22: // These describe what a user can do WITHIN a specific workspace.
 23: enum WorkspaceRole {
 24:   VIEWER // Read-only access to workspace content
 25:   EDITOR // Can create/edit papers and collections in workspace
 26:   MANAGER // Can invite/remove members, manage workspace settings
 27:   OWNER // Full control, can delete workspace and transfer ownership
 28: }
 29: 
 30: enum CollectionPermission {
 31:   VIEW // Read-only access - can view collection and papers
 32:   EDIT // Full access - can edit, add/remove papers, delete collection
 33: }
 34: 
 35: enum AnnotationType {
 36:   HIGHLIGHT // Yellow highlight over text
 37:   UNDERLINE // Underline text
 38:   STRIKETHROUGH // Strike through text
 39:   AREA // Rectangle/area selection
 40:   COMMENT // Blue comment bubble
 41:   NOTE // Green sticky note
 42:   INK // Freehand drawing/ink annotation
 43: }
 44: 
 45: enum PaymentProvider {
 46:   STRIPE
 47:   SSLCOMMERZ
 48: }
 49: 
 50: enum PaymentStatus {
 51:   PENDING
 52:   SUCCEEDED
 53:   FAILED
 54:   REFUNDED
 55: }
 56: 
 57: enum SubscriptionStatus {
 58:   ACTIVE
 59:   EXPIRED
 60:   CANCELED
 61:   PAST_DUE
 62: }
 63: 
 64: enum PlanTier {
 65:   FREE
 66:   PRO
 67:   INSTITUTIONAL
 68: }
 69: 
 70: enum PaperProcessingStatus {
 71:   UPLOADED // File record created, extraction not started yet
 72:   PROCESSING // Extraction & chunking in progress
 73:   PROCESSED // All chunks stored successfully
 74:   FAILED // Processing failed; see processingError
 75: }
 76: 
 77: enum NotificationType {
 78:   MENTION
 79:   COMMENT
 80:   SHARE
 81:   INVITE
 82:   PAPER
 83:   COLLECTION
 84:   SYSTEM
 85:   ACHIEVEMENT
 86: }
 87: 
 88: model Notification {
 89:   id        String           @id @default(uuid())
 90:   userId    String // The user receiving the notification
 91:   type      NotificationType
 92:   title     String
 93:   message   String
 94:   read      Boolean          @default(false)
 95:   starred   Boolean          @default(false)
 96:   actionUrl String?
 97: 
 98:   // Optional relations for context (actor and resource)
 99:   actorId    String? // User who triggered it
100:   resourceId String? // ID of related entity (paperId, workspaceId, etc)
101:   createdAt  DateTime @default(now())
102: 
103:   user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
104:   actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
105: 
106:   @@index([userId, read])
107:   @@index([createdAt])
108: }
109: 
110: model User {
111:   id                     String    @id @default(uuid())
112:   email                  String    @unique
113:   name                   String?
114:   firstName              String?
115:   lastName               String?
116:   institution            String?
117:   fieldOfStudy           String?
118:   image                  String?
119:   password               String? // Optional password for demo/test users
120:   role                   Role      @default(RESEARCHER)
121:   emailVerified          DateTime? // When email was verified
122:   emailVerificationToken String? // For email verification
123: 
124:   // Onboarding flow fields (Phase 2)
125:   onboardingCompleted Boolean  @default(false)
126:   onboardingStep      Int      @default(0)
127: 
128:   // Stripe subscription fields
129:   stripeCustomerId       String?   @unique
130:   stripeSubscriptionId   String?   @unique
131:   stripePriceId          String? // The price ID of the current subscription
132:   stripeCurrentPeriodEnd DateTime? // When the current subscription period ends
133: 
134:   // Auth.js relations
135:   accounts Account[]
136:   sessions Session[]
137: 
138:   // App relations
139:   memberships               WorkspaceMember[]
140:   workspacesOwned           Workspace[]           @relation("WorkspaceOwner")
141:   uploadedPapers            Paper[]               @relation("PaperUploader")
142:   annotations               Annotation[]
143:   collections               Collection[]          @relation("CollectionOwner")
144:   subscriptions             Subscription[]
145:   payments                  Payment[]
146:   searchHistory             SearchHistory[]
147:   notifications             Notification[]        @relation("UserNotifications")
148:   triggeredNotifications    Notification[]        @relation("NotificationActor")
149:   usageEvents               UsageEvent[]
150:   activities                ActivityLog[]
151:   aiInsightThreads          AIInsightThread[]
152:   aiInsightMessagesAuthored AIInsightMessage[]    @relation("AIInsightMessageAuthor")
153:   // Sharing relations
154:   collectionInvitesSent     CollectionMember[]    @relation("CollectionMemberInvitedBy")
155:   workspaceInvitesReceived  WorkspaceInvitation[] @relation("WorkspaceInvitationUser")
156:   workspaceInvitesSent      WorkspaceInvitation[] @relation("WorkspaceInvitationInvitedBy")
157: 
158:   // Token relations
159:   tokens        UserToken[]
160:   researchNotes ResearchNote[]
161: 
162:   // New Phase 2 features
163:   citationExports    CitationExport[]
164:   discussionThreads  DiscussionThread[]
165:   discussionMessages DiscussionMessage[]
166:   activityLogEntries ActivityLogEntry[]
167: 
168:   createdAt         DateTime            @default(now())
169:   updatedAt         DateTime            @updatedAt
170:   isDeleted         Boolean             @default(false)
171:   AnnotationVersion AnnotationVersion[]
172:   CollectionPaper   CollectionPaper[]
173:   CollectionMember  CollectionMember[]
174: 
175:   // Optimized indexes for common query patterns
176:   @@index([isDeleted, createdAt]) // For listing active users sorted by creation
177:   @@index([role, isDeleted, createdAt]) // For role-filtered queries
178:   @@index([email, isDeleted]) // For email lookups with deletion filter
179: }
