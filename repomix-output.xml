  1: import { Request, Response } from "express";
  2: import ApiError from "../../errors/ApiError";
  3: import { AuthenticatedRequest } from "../../interfaces/common";
  4: import catchAsync from "../../shared/catchAsync";
  5: import prisma from "../../shared/prisma";
  6: import { sendSuccessResponse } from "../../shared/sendResponse";
  7: import { ImportService } from "./import.service";
  8: async function assertWorkspaceAccess(
  9:   workspaceId: string,
 10:   userId: string
 11: ): Promise<void> {
 12:   const access = await prisma.$queryRaw<Array<{ isMember: boolean }>>`
 13:     SELECT EXISTS (
 14:       SELECT 1
 15:       FROM "Workspace" w
 16:       WHERE w.id = ${workspaceId}
 17:         AND w."isDeleted" = false
 18:         AND (
 19:           w."ownerId" = ${userId}
 20:           OR EXISTS (
 21:             SELECT 1
 22:             FROM "WorkspaceMember" m
 23:             WHERE m."workspaceId" = w.id
 24:               AND m."userId" = ${userId}
 25:               AND m."isDeleted" = false
 26:           )
 27:         )
 28:     ) AS "isMember"
 29:   `;
 30:   if (!access[0]?.isMember) {
 31:     throw new ApiError(403, "You do not have access to this workspace");
 32:   }
 33: }
 34: export const importController = {
 35:   importByDOI: catchAsync(async (req: Request, res: Response) => {
 36:     const authReq = req as AuthenticatedRequest;
 37:     const { doi, workspaceId } = req.body;
 38:     if (!doi || !workspaceId) {
 39:       throw new ApiError(400, "doi and workspaceId are required");
 40:     }
 41:     await assertWorkspaceAccess(workspaceId, authReq.user.id);
 42:     const result = await ImportService.importByDOI(doi, workspaceId, authReq.user.id);
 43:     sendSuccessResponse(res, result, "Paper imported via DOI", 201);
 44:   }),
 45:   importByArxiv: catchAsync(async (req: Request, res: Response) => {
 46:     const authReq = req as AuthenticatedRequest;
 47:     const { arxivId, workspaceId } = req.body;
 48:     if (!arxivId || !workspaceId) {
 49:       throw new ApiError(400, "arxivId and workspaceId are required");
 50:     }
 51:     await assertWorkspaceAccess(workspaceId, authReq.user.id);
 52:     const result = await ImportService.importByArxiv(arxivId, workspaceId, authReq.user.id);
 53:     sendSuccessResponse(res, result, "Paper imported via arXiv", 201);
 54:   }),
 55:   importByURL: catchAsync(async (req: Request, res: Response) => {
 56:     const authReq = req as AuthenticatedRequest;
 57:     const { url, workspaceId } = req.body;
 58:     if (!url || !workspaceId) {
 59:       throw new ApiError(400, "url and workspaceId are required");
 60:     }
 61:     await assertWorkspaceAccess(workspaceId, authReq.user.id);
 62:     const result = await ImportService.importByURL(url, workspaceId, authReq.user.id);
 63:     sendSuccessResponse(
 64:       res,
 65:       {
 66:         id: result.paper.id,
 67:         title: result.paper.title,
 68:         hasPdf: Boolean(result.hasPdf),
 69:         alreadyImported: Boolean(result.alreadyImported),
 70:       },
 71:       "Paper imported via URL",
 72:       201,
 73:     );
 74:   }),
 75:   importBySmartURL: catchAsync(async (req: Request, res: Response) => {
 76:     const authReq = req as AuthenticatedRequest;
 77:     const { url, workspaceId } = req.body;
 78:     if (!url || !workspaceId) {
 79:       throw new ApiError(400, "url and workspaceId are required");
 80:     }
 81:     await assertWorkspaceAccess(workspaceId, authReq.user.id);
 82:     const result = await ImportService.importBySmartURL(url, workspaceId, authReq.user.id);
 83:     sendSuccessResponse(
 84:       res,
 85:       {
 86:         id: result.paper.id,
 87:         title: result.paper.title,
 88:         hasPdf: Boolean(result.hasPdf),
 89:         alreadyImported: Boolean(result.alreadyImported),
 90:       },
 91:       "Paper imported via Smart URL",
 92:       201,
 93:     );
 94:   }),
 95:   importByFile: catchAsync(async (req: Request, res: Response) => {
 96:     const authReq = req as AuthenticatedRequest;
 97:     const { content, format, workspaceId } = req.body;
 98:     if (!content || !format || !workspaceId) {
 99:       throw new ApiError(400, "content, format, and workspaceId are required");
100:     }
101:     await assertWorkspaceAccess(workspaceId, authReq.user.id);
102:     let papers;
103:     if (format === "bibtex") {
104:       papers = ImportService.parseBibTeX(content);
105:     } else if (format === "ris") {
106:       papers = ImportService.parseRIS(content);
107:     } else {
108:       throw new ApiError(400, "Unsupported format. Use 'bibtex' or 'ris'.");
109:     }
110:     const imported: any[] = [];
111:     for (const p of papers) {
112:       try {
113:         const metadata = { authors: p.authors, year: p.year, source: p.source };
114:         const result = await prisma.$queryRaw<any[]>`
115:           INSERT INTO "Paper" (id, "workspaceId", "uploaderId", title, abstract, metadata, source, doi, tags, "citationCount", "processingStatus", "createdAt", "updatedAt", "isDeleted")
116:           VALUES (gen_random_uuid(), ${workspaceId}, ${authReq.user.id}, ${p.title}, ${p.abstract || null}, ${JSON.stringify(metadata)}::jsonb, ${p.source}, ${p.doi || null}, ARRAY[]::text[], 0, 'UPLOADED', NOW(), NOW(), false)
117:           RETURNING id, title, source, doi
118:         `;
119:         imported.push({ id: result[0].id, title: p.title, source: p.source, status: "success" });
120:       } catch (e) {
121:         imported.push({ title: p.title, source: p.source, status: "error", error: (e as Error).message });
122:       }
123:     }
124:     sendSuccessResponse(
125:       res,
126:       { total: papers.length, imported: imported.filter((i) => i.status === "success").length, papers: imported },
127:       `Imported ${imported.filter((i) => i.status === "success").length} of ${papers.length} papers`,
128:       201
129:     );
130:   }),
131:   importByZotero: catchAsync(async (req: Request, res: Response) => {
132:     throw new ApiError(501, "Zotero import is not yet available (coming in Phase 4C)");
133:   }),
134:   importByMendeley: catchAsync(async (req: Request, res: Response) => {
135:     throw new ApiError(501, "Mendeley import is not yet available (coming in Phase 4C)");
136:   }),
137:   importByEndnote: catchAsync(async (req: Request, res: Response) => {
138:     throw new ApiError(501, "EndNote import is not yet available (coming in Phase 4C)");
139:   }),
140:   getImportHistory: catchAsync(async (req: Request, res: Response) => {
141:     const authReq = req as AuthenticatedRequest;
142:     const papers = await prisma.$queryRaw<any[]>`
143:       SELECT id, title, source, doi, "createdAt"
144:       FROM "Paper"
145:       WHERE "uploaderId" = ${authReq.user.id}
146:         AND source IN ('doi', 'arxiv', 'url', 'bibtex', 'ris', 'zotero', 'mendeley', 'endnote')
147:         AND "isDeleted" = false
148:       ORDER BY "createdAt" DESC
149:       LIMIT 20
150:     `;
151:     sendSuccessResponse(res, papers, "Import history retrieved");
152:   }),
153: };
