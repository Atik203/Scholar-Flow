1338:     const limit = parseInt(req.query.limit as string) || 10;
1339:     const skip = (page - 1) * limit;
1340:     // Check if collection exists and user has access
1341:     const collectionRows = await prisma.$queryRaw<
1342:       Array<{
1343:         id: string;
1344:         isPublic: boolean;
1345:         ownerId: string;
1346:         hasMembership: boolean;
1347:       }>
1348:     >`
1349:       SELECT
1350:         c.id,
1351:         c."isPublic",
1352:         c."ownerId",
1353:         CASE
1354:           WHEN cm."userId" IS NOT NULL AND cm.status = 'ACCEPTED' THEN true
1355:           ELSE false
