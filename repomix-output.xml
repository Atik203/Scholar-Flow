 65:   if (diff < 0) return "Expired";
 66:   const days = Math.floor(diff / (1000 * 60 * 60 * 24));
 67:   if (days > 0) return `${days} days left`;
 68:   const hours = Math.floor(diff / (1000 * 60 * 60));
 69:   return `${hours} hours left`;
