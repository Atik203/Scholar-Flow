308: /**
309:  * Get comprehensive user analytics including papers, collections, storage, and tokens
310:  */
311: const getUserAnalytics = async (user: IAuthUser) => {
312:   try {
313:     // Verify user exists
314:     const existingUsers = await prisma.$queryRaw<any[]>`
315:       SELECT id, email, role, "stripeSubscriptionId", "stripePriceId", "isDeleted"
316:       FROM "User"
317:       WHERE id = ${user.id} AND "isDeleted" = false
318:       LIMIT 1
319:     `;
320:     if (existingUsers.length === 0) {
321:       throw new ApiError(404, "User not found or account deleted");
322:     }
323:     const userData = existingUsers[0];
324:     // Determine user plan (Free or Pro based on Stripe subscription)
325:     const plan = userData.stripeSubscriptionId ? "PRO" : "FREE";
326:     // Get papers count and storage used
327:     const paperStats = await prisma.$queryRaw<any[]>`
328:       SELECT
329:         COUNT(DISTINCT p.id)::INTEGER as "totalPapers",
330:         COALESCE(SUM(pf."sizeBytes"), 0)::BIGINT as "totalStorage"
331:       FROM "Paper" p
332:       LEFT JOIN "PaperFile" pf ON p.id = pf."paperId" AND pf."isDeleted" = false
333:       WHERE p."uploaderId" = ${user.id} AND p."isDeleted" = false
334:     `;
335:     // Get collections count
336:     const collectionStats = await prisma.$queryRaw<any[]>`
337:       SELECT COUNT(*)::INTEGER as "totalCollections"
338:       FROM "Collection"
339:       WHERE "ownerId" = ${user.id} AND "isDeleted" = false
340:     `;
341:     // Get AI tokens usage (from UsageEvent)
342:     // Sum units for AI-related events (ai_summarize, semantic_search, etc.)
343:     const tokenStats = await prisma.$queryRaw<any[]>`
344:       SELECT
345:         COALESCE(SUM("units"), 0)::INTEGER as "totalTokensUsed"
346:       FROM "UsageEvent"
347:       WHERE "userId" = ${user.id}
348:         AND "isDeleted" = false
349:         AND ("kind" LIKE 'ai_%' OR "kind" = 'semantic_search')
350:     `;
351:     // Get papers uploaded over time (last 30 days for chart)
352:     const papersOverTime = await prisma.$queryRaw<any[]>`
353:       SELECT
354:         DATE("createdAt") as date,
355:         COUNT(*)::INTEGER as count
356:       FROM "Paper"
357:       WHERE "uploaderId" = ${user.id}
358:         AND "isDeleted" = false
359:         AND "createdAt" >= NOW() - INTERVAL '30 days'
360:       GROUP BY DATE("createdAt")
361:       ORDER BY date ASC
362:     `;
363:     // Get collections created over time (last 30 days)
364:     const collectionsOverTime = await prisma.$queryRaw<any[]>`
365:       SELECT
366:         DATE("createdAt") as date,
367:         COUNT(*)::INTEGER as count
368:       FROM "Collection"
369:       WHERE "ownerId" = ${user.id}
370:         AND "isDeleted" = false
371:         AND "createdAt" >= NOW() - INTERVAL '30 days'
372:       GROUP BY DATE("createdAt")
373:       ORDER BY date ASC
374:     `;
375:     // Get storage usage by month (last 6 months)
376:     const storageOverTime = await prisma.$queryRaw<any[]>`
377:       SELECT
378:         DATE_TRUNC('month', p."createdAt") as month,
379:         COALESCE(SUM(pf."sizeBytes"), 0)::BIGINT as "totalSize"
380:       FROM "Paper" p
381:       LEFT JOIN "PaperFile" pf ON p.id = pf."paperId" AND pf."isDeleted" = false
382:       WHERE p."uploaderId" = ${user.id}
383:         AND p."isDeleted" = false
384:         AND p."createdAt" >= NOW() - INTERVAL '6 months'
385:       GROUP BY DATE_TRUNC('month', p."createdAt")
386:       ORDER BY month ASC
387:     `;
388:     // Get papers by processing status
389:     const papersByStatus = await prisma.$queryRaw<any[]>`
390:       SELECT
391:         "processingStatus",
392:         COUNT(*)::INTEGER as count
393:       FROM "Paper"
394:       WHERE "uploaderId" = ${user.id} AND "isDeleted" = false
395:       GROUP BY "processingStatus"
396:     `;
397:     // Convert storage from bytes to MB for easier reading
398:     const totalStorageMB =
399:       Number(paperStats[0]?.totalStorage || 0) / (1024 * 1024);
400:     // Plan limits
401:     const planLimits = {
402:       FREE: {
403:         maxPapers: 50,
404:         maxStorage: 1024, // 1GB in MB
405:         maxTokens: 10000,
406:         maxCollections: 10,
407:       },
408:       PRO: {
409:         maxPapers: -1, // Unlimited
410:         maxStorage: 51200, // 50GB in MB
411:         maxTokens: 1000000,
412:         maxCollections: -1, // Unlimited
413:       },
414:     };
415:     const limits = planLimits[plan as keyof typeof planLimits];
416:     return {
417:       plan,
418:       limits,
419:       usage: {
420:         papers: {
421:           total: Number(paperStats[0]?.totalPapers || 0),
422:           limit: limits.maxPapers,
423:           percentage:
424:             limits.maxPapers === -1
425:               ? 0
426:               : (Number(paperStats[0]?.totalPapers || 0) / limits.maxPapers) *
427:                 100,
428:         },
429:         collections: {
430:           total: Number(collectionStats[0]?.totalCollections || 0),
431:           limit: limits.maxCollections,
432:           percentage:
433:             limits.maxCollections === -1
434:               ? 0
435:               : (Number(collectionStats[0]?.totalCollections || 0) /
436:                   limits.maxCollections) *
437:                 100,
438:         },
439:         storage: {
440:           used: totalStorageMB,
441:           limit: limits.maxStorage,
442:           percentage: (totalStorageMB / limits.maxStorage) * 100,
443:           unit: "MB",
444:         },
445:         tokens: {
446:           used: Number(tokenStats[0]?.totalTokensUsed || 0),
447:           limit: limits.maxTokens,
448:           percentage:
449:             (Number(tokenStats[0]?.totalTokensUsed || 0) / limits.maxTokens) *
450:             100,
451:         },
452:       },
453:       charts: {
454:         papersOverTime: papersOverTime.map((row) => ({
455:           date: row.date,
456:           count: Number(row.count),
457:         })),
458:         collectionsOverTime: collectionsOverTime.map((row) => ({
459:           date: row.date,
460:           count: Number(row.count),
461:         })),
462:         storageOverTime: storageOverTime.map((row) => ({
463:           month: row.month,
464:           size: Number(row.totalSize) / (1024 * 1024), // Convert to MB
465:         })),
466:         papersByStatus: papersByStatus.map((row) => ({
467:           status: row.processingStatus,
468:           count: Number(row.count),
469:         })),
470:       },
471:     };
472:   } catch (error) {
473:     console.error("Error fetching user analytics:", error);
474:     if (error instanceof ApiError) {
475:       throw error;
476:     }
477:     throw new ApiError(500, "Failed to fetch user analytics");
478:   }
