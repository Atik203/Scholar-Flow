 26: async function decodeBase64AsWasm(wasmBase64: string): Promise<WebAssembly.Module> {
 27:   const { Buffer } = await import('node:buffer')
 28:   const wasmArray = Buffer.from(wasmBase64, 'base64')
 29:   return new WebAssembly.Module(wasmArray)
 30: }
