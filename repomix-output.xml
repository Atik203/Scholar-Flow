 50: const useTypewriter = (
 51:   words: string[],
 52:   typingSpeed = 100,
 53:   deletingSpeed = 50,
 54:   pauseDuration = 2000,
 55: ) => {
 56:   const [currentWordIndex, setCurrentWordIndex] = useState(0);
 57:   const [currentText, setCurrentText] = useState("");
 58:   const [isDeleting, setIsDeleting] = useState(false);
 59:   useEffect(() => {
 60:     const word = words[currentWordIndex];
 61:     const timeout = setTimeout(
 62:       () => {
 63:         if (!isDeleting) {
 64:           if (currentText.length < word.length) {
 65:             setCurrentText(word.slice(0, currentText.length + 1));
 66:           } else {
 67:             setTimeout(() => setIsDeleting(true), pauseDuration);
 68:           }
 69:         } else {
 70:           if (currentText.length > 0) {
 71:             setCurrentText(word.slice(0, currentText.length - 1));
 72:           } else {
 73:             setIsDeleting(false);
 74:             setCurrentWordIndex((prev) => (prev + 1) % words.length);
 75:           }
 76:         }
 77:       },
 78:       isDeleting ? deletingSpeed : typingSpeed,
 79:     );
 80:     return () => clearTimeout(timeout);
 81:   }, [currentText, isDeleting, currentWordIndex, words, typingSpeed, deletingSpeed, pauseDuration]);
 82:   return currentText;
 83: };
 84: // Animated counter component
 85: const AnimatedCounter = ({
 86:   target,
 87:   suffix = "",
 88:   duration = 2,
 89:   decimals = 0,
 90: }: {
 91:   target: number;
 92:   suffix?: string;
 93:   duration?: number;
 94:   decimals?: number;
 95: }) => {
 96:   const [count, setCount] = useState(0);
 97:   const [isVisible, setIsVisible] = useState(false);
 98:   const ref = useRef<HTMLSpanElement>(null);
 99:   useEffect(() => {
100:     const observer = new IntersectionObserver(
101:       ([entry]) => {
102:         if (entry.isIntersecting && !isVisible) {
103:           setIsVisible(true);
104:         }
105:       },
106:       { threshold: 0.5 },
107:     );
108:     if (ref.current) observer.observe(ref.current);
109:     return () => observer.disconnect();
110:   }, [isVisible]);
111:   useEffect(() => {
112:     if (!isVisible) return;
113:     const steps = 60;
114:     const increment = target / steps;
115:     let current = 0;
116:     const timer = setInterval(() => {
117:       current += increment;
118:       if (current >= target) {
119:         setCount(target);
120:         clearInterval(timer);
121:       } else {
122:         setCount(decimals > 0 ? parseFloat(current.toFixed(decimals)) : Math.floor(current));
123:       }
124:     }, (duration * 1000) / steps);
125:     return () => clearInterval(timer);
126:   }, [isVisible, target, duration, decimals]);
127:   return (
128:     <span ref={ref}>
129:       {decimals > 0 ? count.toFixed(decimals) : count.toLocaleString()}
130:       {suffix}
131:     </span>
132:   );
133: };
