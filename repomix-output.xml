  1: import bcrypt from "bcryptjs";
  2: import crypto from "crypto";
  3: import prisma from "./prisma";
  4: export interface TokenPayload {
  5:   userId: string;
  6:   type: "password-reset" | "email-verification" | "magic-link";
  7:   email: string;
  8: }
  9: export interface TokenData {
 10:   token: string;
 11:   hashedToken: string;
 12:   expiresAt: Date;
 13: }
 14: class TokenService {
 15:   private readonly TOKEN_EXPIRY_MINUTES = 15;
 16:   private readonly SALT_ROUNDS = 12;
 17:   generateSecureToken(): string {
 18:     return crypto.randomBytes(32).toString("hex");
 19:   }
 20:   async hashToken(token: string): Promise<string> {
 21:     return bcrypt.hash(token, this.SALT_ROUNDS);
 22:   }
 23:   async compareToken(
 24:     plainToken: string,
 25:     hashedToken: string
 26:   ): Promise<boolean> {
 27:     return bcrypt.compare(plainToken, hashedToken);
 28:   }
 29:   createTokenData(): TokenData {
 30:     const token = this.generateSecureToken();
 31:     const expiresAt = new Date(
 32:       Date.now() + this.TOKEN_EXPIRY_MINUTES * 60 * 1000
 33:     );
 34:     return {
 35:       token,
 36:       hashedToken: "", // Will be set after hashing
 37:       expiresAt,
 38:     };
 39:   }
 40:   /**
 41:    * Create and store a token in the database
 42:    */
 43:   async createAndStoreToken(
 44:     userId: string,
 45:     type: "password-reset" | "email-verification" | "magic-link"
 46:   ): Promise<string> {
 47:     const tokenData = this.createTokenData();
 48:     const hashedToken = await this.hashToken(tokenData.token);
 49:     const tokenType =
 50:       type === "password-reset" ? "PASSWORD_RESET" : type === "magic-link" ? "MAGIC_LINK" : "EMAIL_VERIFICATION";
 51:     await this.invalidateExistingTokens(userId, type);
 52:     await prisma.$executeRaw`
 53:       INSERT INTO "UserToken" (id, "userId", "token", "type", "expiresAt", "createdAt")
 54:       VALUES (gen_random_uuid(), ${userId}, ${hashedToken}, ${tokenType}::"TokenType", ${tokenData.expiresAt}, NOW())
 55:     `;
 56:     return tokenData.token;
 57:   }
 58:   /**
 59:    * Validate a token from the database
 60:    */
 61:   async validateToken(
 62:     plainToken: string,
 63:     type: "password-reset" | "email-verification" | "magic-link"
 64:   ): Promise<{ valid: boolean; userId?: string; email?: string; tokenId?: string }> {
 65:     try {
 66:       const tokenType =
 67:         type === "password-reset" ? "PASSWORD_RESET" : type === "magic-link" ? "MAGIC_LINK" : "EMAIL_VERIFICATION";
 68:       // Find the token in the database
 69:       const tokens = await prisma.$queryRaw<
 70:         Array<{
 71:           id: string;
 72:           token: string;
 73:           userId: string;
 74:           email: string;
 75:         }>
 76:       >`
 77:         SELECT ut.id, ut.token, ut."userId", u.email
 78:         FROM "UserToken" ut
 79:         JOIN "User" u ON u.id = ut."userId"
 80:         WHERE ut.type = ${tokenType}::"TokenType"
 81:           AND ut.used = false
 82:           AND ut."expiresAt" > NOW()
 83:         ORDER BY ut."createdAt" DESC
 84:         LIMIT 1
 85:       `;
 86:       const tokenRecord = tokens[0];
 87:       if (!tokenRecord) {
 88:         return { valid: false };
 89:       }
 90:       // Compare the plain token with the hashed token
 91:       const isValid = await this.compareToken(plainToken, tokenRecord.token);
 92:       if (!isValid) {
 93:         return { valid: false };
 94:       }
 95:       return {
 96:         valid: true,
 97:         userId: tokenRecord.userId,
 98:         email: tokenRecord.email,
 99:         tokenId: tokenRecord.id,
100:       };
101:     } catch (error) {
102:       console.error("Error validating token:", error);
103:       return { valid: false };
104:     }
105:   }
106:   /**
107:    * Mark a token as used
108:    */
109:   async markTokenAsUsed(
110:     tokenId: string
111:   ): Promise<void> {
112:     await prisma.$executeRaw`
113:       UPDATE "UserToken"
114:       SET used = true
115:       WHERE id = ${tokenId}
116:     `;
117:   }
118:   /**
119:    * Invalidate all existing tokens of a specific type for a user
120:    */
121:   async invalidateExistingTokens(
122:     userId: string,
123:     type: "password-reset" | "email-verification" | "magic-link"
124:   ): Promise<void> {
125:     const tokenType =
126:       type === "password-reset" ? "PASSWORD_RESET" : type === "magic-link" ? "MAGIC_LINK" : "EMAIL_VERIFICATION";
127:     await prisma.$executeRaw`
128:       UPDATE "UserToken"
129:       SET used = true
130:       WHERE "userId" = ${userId}
131:         AND type = ${tokenType}::"TokenType"
132:         AND used = false
133:     `;
134:   }
135:   /**
136:    * Clean up expired tokens (can be called by a cron job)
137:    */
138:   async cleanupExpiredTokens(): Promise<number> {
139:     const deletedCount = await prisma.$executeRaw`
140:       DELETE FROM "UserToken"
141:       WHERE "expiresAt" < NOW()
142:     `;
143:     return Number(deletedCount) || 0;
144:   }
145:   getTokenExpiryMinutes(): number {
146:     return this.TOKEN_EXPIRY_MINUTES;
147:   }
148: }
