 181:     `https://api.openalex.org/works?filter=from_publication_date:${daysAgo(30)},type:article` +
 182:     `&sort=cited_by_count:desc&per-page=${perPage}`;
 183:   const data = await cachedExternalJson<{ results?: OpenAlexWork[] }>("openalex-recent", url);
 184:   if (!data?.results?.length) return [];
 185:   const seen = new Set<string>();
 186:   const items: DiscoveryItem[] = [];
 187:   for (const work of data.results) {
 188:     if (!work?.title) continue;
 189:     const key = work.doi ?? work.title;
 190:     if (seen.has(key)) continue;
 191:     seen.add(key);
 192:     items.push(mapOpenAlexWork(work));
 193:   }
 194:   return items.slice(0, limit);
 195: }
 196: interface ArxivEntry {
 197:   id: string;
 198:   title: string;
 199:   summary: string;
 200:   published: string;
 201:   authors: string[];
 202: }
 203: async function fetchArxivFeed(
 204:   category: string | null,
 205:   start: number,
 206:   limit: number
 207: ): Promise<DiscoveryItem[]> {
 208:   const query = category
 209:     ? `search_query=cat:${encodeURIComponent(category)}`
 210:     : "search_query=all:electron&sortBy=submittedDate&sortOrder=descending";
 211:   const url =
 212:     category
 213:       ? `https://export.arxiv.org/api/query?${query}&start=${start}&max_results=${limit}&sortBy=submittedDate&sortOrder=descending`
 214:       : `https://export.arxiv.org/api/query?${query}`;
 215:   const cacheKey = `arxiv:${category ?? "recent"}:${start}:${limit}`;
 216:   const xml = await cachedExternalText(cacheKey, url);
 217:   if (!xml) return [];
 218:   return parseArxivEntries(xml)
 219:     .map((entry: ArxivEntry): DiscoveryItem => ({
 220:       kind: "external",
 221:       id: entry.id.replace(/^https?:\/\/(?:www\.)?arxiv\.org\/(?:abs|pdf)\//i, ""),
 222:       externalUrl: entry.id,
 223:       title: entry.title,
 224:       abstract: entry.summary || null,
 225:       source: "arxiv",
 226:       citationCount: null,
 227:       publishedAt: entry.published || null,
 228:       authors: entry.authors,
 229:     }))
 230:     .slice(0, limit);
 231: }
 232: async function fetchArxivSearch(
 233:   keyword: string,
 234:   limit: number,
 235:   reason?: string
 236: ): Promise<DiscoveryItem[]> {
 237:   const url =
 238:     `https://export.arxiv.org/api/query?search_query=all:${encodeURIComponent(keyword)}` +
 239:     `&start=0&max_results=${limit}&sortBy=relevance`;
 240:   const cacheKey = `arxiv-search:${keyword.toLowerCase()}:${limit}`;
 241:   const xml = await cachedExternalText(cacheKey, url);
 242:   if (!xml) return [];
 243:   return parseArxivEntries(xml)
 244:     .map((entry: ArxivEntry): DiscoveryItem => ({
 245:       kind: "external",
 246:       id: entry.id.replace(/^https?:\/\/(?:www\.)?arxiv\.org\/(?:abs|pdf)\//i, ""),
 247:       externalUrl: entry.id,
 248:       title: entry.title,
 249:       abstract: entry.summary || null,
 250:       source: "arxiv",
 251:       citationCount: null,
 252:       publishedAt: entry.published || null,
 253:       authors: entry.authors,
 254:       reason: reason ?? undefined,
 255:     }))
 256:     .slice(0, limit);
 257: }
 258: async function fetchOpenAlexSearch(
 259:   keyword: string,
 260:   limit: number,
 261:   reason?: string
 262: ): Promise<DiscoveryItem[]> {
 263:   const url =
 264:     `https://api.openalex.org/works?search=${encodeURIComponent(keyword)}` +
 265:     `&per-page=${Math.min(limit, 25)}&sort=relevance_score:desc`;
 266:   const cacheKey = `openalex-search:${keyword.toLowerCase()}:${limit}`;
 267:   const data = await cachedExternalJson<{ results?: OpenAlexWork[] }>(cacheKey, url);
 268:   return (data?.results ?? [])
 269:     .filter((w) => w?.title)
 270:     .map((w) => mapOpenAlexWork(w, reason))
 271:     .slice(0, limit);
 272: }
 273: function daysAgo(days: number): string {
 274:   const d = new Date();
 275:   d.setDate(d.getDate() - days);
 276:   return d.toISOString().slice(0, 10);
 277: }
 278: function toPlatformDiscoveryItem(paper: {
 279:   id: string;
 280:   title: string;
 281:   abstract?: string | null;
 282:   source?: string | null;
 283:   createdAt: Date;
 284: }): DiscoveryItem {
 285:   return {
 286:     kind: "platform",
 287:     id: paper.id,
 288:     paperId: paper.id,
 289:     title: paper.title,
 290:     abstract: paper.abstract,
 291:     source: paper.source,
 292:     publishedAt: paper.createdAt.toISOString(),
 293:   };
 294: }
