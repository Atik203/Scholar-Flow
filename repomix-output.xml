 168:       (doi ? `https://doi.org/${doi}` : undefined),
 169:     title: work.title ?? "Untitled work",
 170:     abstract: reconstructOpenAlexAbstract(work.abstract_inverted_index ?? undefined),
 171:     source: "openalex",
 172:     citationCount: work.cited_by_count ?? null,
 173:     publishedAt: work.publication_date ?? null,
