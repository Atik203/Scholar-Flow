 69: function parseMetadataFromText(text: string): {
 70:   title: string;
 71:   authors: string[];
 72:   abstract: string;
 73: } {
 74:   const lines = text.split(/\n/).map((l) => l.trim()).filter(Boolean);
 75:   let title = "";
 76:   for (const line of lines) {
 77:     if (line.length < 5 || line.length > 200) continue;
 78:     if (/^(arxiv|vol\.|issue|page|journal|doi:|https?:)/i.test(line)) continue;
 79:     if (/^\d+$/.test(line)) continue; // page number
 80:     title = line.replace(/\s+/g, " ");
 81:     break;
 82:   }
 83:   // Authors: lines immediately after the title that look like names
 84:   const authors: string[] = [];
 85:   const titleIdx = lines.findIndex((l) => l.trim() === title);
 86:   if (titleIdx >= 0) {
 87:     for (let i = titleIdx + 1; i < Math.min(titleIdx + 5, lines.length); i++) {
 88:       const line = lines[i];
 89:       // Stop at abstract/institution/affiliation markers
 90:       if (/^(abstract|introduction|keywords|www\.|http|email|@|department|university|institute)/i.test(line)) break;
 91:       // Looks like author names: 2-50 chars, may contain initials, commas, ampersands
 92:       if (line.length >= 2 && line.length <= 80 && /^[A-Z\u00C0-\u024F]/.test(line)) {
 93:         // Split on common separators
 94:         const names = line.split(/[,;&]|\band\b/).map((n) => n.trim()).filter(Boolean);
 95:         for (const name of names) {
 96:           if (name.length >= 2 && name.length <= 50) authors.push(name);
 97:         }
 98:         break;
 99:       }
100:     }
101:   }
102:   // Abstract: look for "Abstract" section
103:   let abstract = "";
104:   const absMatch = text.match(/abstract[\s:\-.]*\n?([\s\S]*?)(?:(?:keywords|introduction|1\.|i\.|introduction)\s*[\n:]|$)/i);
105:   if (absMatch) {
106:     abstract = absMatch[1].replace(/\n/g, " ").replace(/\s+/g, " ").trim();
107:     if (abstract.length > 10 && abstract.length < 2000) {
108:       // Good
109:     } else {
110:       abstract = "";
111:     }
112:   }
113:   return { title, authors, abstract };
114: }
115: /**
116:  * Accept a bare arXiv ID (new 2511.11306 or old hep-th/9901001 style), a
117:  * full arxiv.org/abs|pdf URL, or the DataCite arXiv DOI
118:  * (10.48550/arXiv.2511.11306). Strips trailing version suffixes. Returns the
119:  * canonical unversioned ID, or null when the input is not an arXiv ID.
120:  */
121: function normalizeArxivId(input: string): string | null {
122:   let id = input.trim();
123:   if (!id) return null;
124:   const urlMatch = id.match(/arxiv\.org\/(?:abs|pdf)\/([^?#\s]+)/i);
125:   if (urlMatch) id = urlMatch[1];
126:   id = id
127:     .replace(/^10\.48550\/arxiv\./i, "")
128:     .replace(/^arxiv:\s*/i, "")
129:     .replace(/^doi:\s*/i, "")
130:     .replace(/^https?:\/\/(dx\.)?doi\.org\//i, "")
131:     .split(/[?#\s]/)[0]
132:     .trim()
133:     .replace(/v\d+$/i, "");
134:   if (!id || id.length > 64 || !/^[\w.-]+$/.test(id)) return null;
135:   const looksArxiv =
136:     /^\d{4}\.\d{4,5}$/.test(id) || /^[a-z-]+(?:\.[a-z-]+)*\/\d{7}$/i.test(id);
137:   return looksArxiv ? id : null;
138: }
139: /**
140:  * arXiv export API returns an Atom feed whose FIRST <title> is the feed-level
141:  * "arXiv Query: ..." string. Every field must be parsed from the <entry>
142:  * block, otherwise the paper title becomes the query string (observed bug).
143:  */
144: function parseArxivFeed(xml: string): {
145:   title: string;
146:   authors: string[];
147:   abstract: string;
148:   year: number;
149: } | null {
150:   const entry = xml.match(/<entry>[\s\S]*?<\/entry>/)?.[0];
151:   if (!entry) return null;
152:   const content = (tag: string): string => {
153:     const m = entry.match(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)<\\/${tag}>`));
154:     if (!m) return "";
155:     const text = m[1].replace(/<[^>]*>/g, " ");
156:     return decodeEntities(text).replace(/\s+/g, " ").trim();
157:   };
158:   const title = content("title");
159:   if (!title) return null;
160:   const authorMatches = entry.matchAll(
161:     /<author>[\s\S]*?<name[^>]*>(.*?)<\/name>[\s\S]*?<\/author>/g,
162:   );
163:   const authors = [...authorMatches]
164:     .map((m) =>
165:       decodeEntities(m[1].replace(/<[^>]*>/g, " ")).replace(/\s+/g, " ").trim(),
166:     )
167:     .filter(Boolean);
168:   const yearMatch = entry.match(/<published>\s*(\d{4})/);
169:   const year = yearMatch
170:     ? parseInt(yearMatch[1], 10)
171:     : new Date().getFullYear();
172:   return { title, authors, abstract: content("summary"), year };
173: }
174: async function findExistingPaper(
175:   workspaceId: string,
176:   match: {
177:     doi?: string | null;
178:     arxivId?: string | null;
179:     sourceId?: string | null;
180:     url?: string | null;
181:   },
182: ): Promise<{ id: string; title: string; source: string; doi: string | null } | null> {
183:   const { doi = null, arxivId = null, sourceId = null, url = null } = match;
184:   const rows = await prisma.$queryRaw<
185:     Array<{ id: string; title: string; source: string; doi: string | null }>
186:   >`
187:     SELECT id, title, source, doi
188:     FROM "Paper"
189:     WHERE "isDeleted" = false
190:       AND (
191:         (${doi}::text IS NOT NULL AND doi = ${doi})
192:         OR (${arxivId}::text IS NOT NULL AND "metadata"->>'arxivId' = ${arxivId})
193:         OR (
194:           (${sourceId}::text IS NOT NULL OR ${url}::text IS NOT NULL)
195:           AND "workspaceId" = ${workspaceId}
196:           AND (
197:             (${sourceId}::text IS NOT NULL AND "metadata"->>'sourceId' = ${sourceId})
198:             OR (${url}::text IS NOT NULL AND "metadata"->>'sourceUrl' = ${url})
199:           )
200:         )
201:       )
202:     LIMIT 1
203:   `;
204:   return rows[0] ?? null;
205: }
