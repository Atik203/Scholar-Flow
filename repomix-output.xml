412:           s."currentPeriodEnd",
413:           s."cancelAtPeriodEnd",
414:           s."createdAt",
415:           COALESCE(
416:             (
417:               SELECT SUM(pay."amountCents")::numeric / 100
418:               FROM "Payment" pay
419:               WHERE pay."userId" = u.id
420:                 AND pay.status = 'SUCCEEDED'
421:                 AND pay."isDeleted" = false
422:             ),
423:             0
