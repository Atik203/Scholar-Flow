1485:           name: row.uploader_name,
1486:           email: row.uploader_email,
1487:         },
1488:       },
1489:     }));
1490:     const total = totalRes[0]?.count || 0;
1491:     const totalPage = Math.ceil(total / limit);
1492:     sendPaginatedResponse(
