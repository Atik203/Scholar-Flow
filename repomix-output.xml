 84:       case "COMMENT":
 85:         return "text-blue-700 bg-blue-100 border-blue-300";
 86:       case "NOTE":
 87:         return "text-green-700 bg-green-100 border-green-300";
 88:       case "INK":
 89:         return "text-gray-700 bg-gray-100 border-gray-300";
 90:       default:
 91:         return "text-gray-700 bg-gray-100 border-gray-300";
