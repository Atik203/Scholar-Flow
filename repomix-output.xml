 732:   /**
 733:    * Revoke an email share (soft delete — immediately drops recipient access
 734:    * because every gate checks isDeleted=false). Author or original sharer.
 735:    */
 736:   async revokePaperShare(shareId: string, requesterId: string) {
 737:     const rows = await prisma.$queryRaw<
 738:       Array<{ id: string; sharedById: string; uploaderId: string }>
 739:     >`
 740:       SELECT ps.id, ps."sharedById", p."uploaderId"
 741:       FROM "PaperShare" ps
 742:       JOIN "Paper" p ON p.id = ps."paperId"
 743:       WHERE ps.id = ${shareId} AND ps."isDeleted" = false AND p."isDeleted" = false
 744:       LIMIT 1
 745:     `;
 746:     const row = rows[0];
 747:     if (!row) throw new ApiError(404, "Share not found");
 748:     if (row.sharedById !== requesterId && row.uploaderId !== requesterId) {
 749:       throw new ApiError(403, "Only the sharer or the author can revoke");
 750:     }
 751:     await prisma.$executeRaw`
 752:       UPDATE "PaperShare"
 753:       SET "isDeleted" = true, "updatedAt" = NOW()
 754:       WHERE id = ${shareId}
 755:     `;
 756:     return { id: shareId, revoked: true };
 757:   },
 758:   async getSummarySourceText(
 759:     paperId: string,
 760:     record: PaperSummaryRecord
 761:   ): Promise<{
 762:     text: string;
 763:     source: "chunks" | "content" | "abstract" | "metadata" | "empty" | "cache";
 764:     chunkCount: number;
 765:   }> {
 766:     // Check AIContextCache first (token optimization)
 767:     const cached = await prisma.aIContextCache.findFirst({
 768:       where: { paperId, contentType: "parsed_text" },
 769:       select: { content: true },
 770:     });
 771:     if (cached?.content) {
 772:       return {
 773:         text: truncateText(cached.content, MAX_SUMMARY_SOURCE_LENGTH),
 774:         source: "cache",
 775:         chunkCount: 0,
 776:       };
 777:     }
 778:     const chunks = await prisma.$queryRaw<Array<{ content: string }>>`
 779:       SELECT content
 780:       FROM "PaperChunk"
 781:       WHERE "paperId" = ${paperId} AND "isDeleted" = false
 782:       ORDER BY idx ASC
 783:       LIMIT 200
 784:     `;
 785:     const chunkText = chunks
 786:       .map((chunk) => chunk.content?.trim())
 787:       .filter((content): content is string => Boolean(content))
 788:       .join("\n\n");
 789:     if (chunkText) {
 790:       // Cache the parsed text for future use
 791:       await prisma.aIContextCache.create({
 792:         data: {
 793:           paperId,
 794:           contentType: "parsed_text",
 795:           content: truncateText(chunkText, MAX_SUMMARY_SOURCE_LENGTH),
 796:           tokenCount: Math.ceil(chunkText.length / 4),
 797:         },
 798:       }).catch(() => {}); // Silently fail if cache write fails
 799:       return {
 800:         text: truncateText(chunkText, MAX_SUMMARY_SOURCE_LENGTH),
 801:         source: "chunks",
 802:         chunkCount: chunks.length,
 803:       };
 804:     }
 805:     const contentText = htmlToPlainText(record.contentHtml);
 806:     if (contentText) {
 807:       return {
 808:         text: truncateText(contentText, MAX_SUMMARY_SOURCE_LENGTH),
 809:         source: "content",
 810:         chunkCount: chunks.length,
 811:       };
 812:     }
 813:     if (record.abstract) {
 814:       return {
 815:         text: truncateText(record.abstract, MAX_SUMMARY_SOURCE_LENGTH),
 816:         source: "abstract",
 817:         chunkCount: chunks.length,
 818:       };
 819:     }
 820:     const metadataAbstract = record.metadata?.abstract;
 821:     if (typeof metadataAbstract === "string" && metadataAbstract.trim()) {
 822:       return {
 823:         text: truncateText(metadataAbstract, MAX_SUMMARY_SOURCE_LENGTH),
 824:         source: "metadata",
 825:         chunkCount: chunks.length,
 826:       };
 827:     }
 828:     return {
 829:       text: "",
 830:       source: "empty",
 831:       chunkCount: chunks.length,
 832:     };
 833:   },
