148:   const action = (activity.action || "").toLowerCase();
149:   const entity = (activity.entity || "").toLowerCase();
150:   switch (type) {
151:     case "paper_upload":
152:       return action.includes("upload") || (entity === "paper" && action.includes("create"));
153:     case "paper_view":
154:       return action.includes("view");
155:     case "paper_edit":
156:       return action.includes("edit") || action.includes("update");
157:     case "paper_delete":
158:       return action.includes("delete");
159:     case "paper_share":
160:       return action.includes("share");
161:     case "collection_create":
162:       return entity === "collection" && action.includes("create");
163:     case "collection_edit":
164:       return entity === "collection" && (action.includes("edit") || action.includes("update"));
165:     case "collection_share":
166:       return entity === "collection" && action.includes("share");
167:     case "member_join":
168:       return action.includes("join") || (entity === "member" && action.includes("create"));
169:     case "member_leave":
170:       return action.includes("leave") || (entity === "member" && action.includes("delete"));
171:     case "member_role_change":
172:       return action.includes("role");
173:     case "comment_add":
174:       return entity === "comment" || action.includes("comment") || action.includes("message");
175:     case "annotation_add":
176:       return entity === "annotation" || action.includes("annotation");
177:     case "export":
178:       return action.includes("export");
179:     case "ai_insight":
180:       return action.includes("ai") || action.includes("insight");
181:     default:
182:       return true;
183:   }
184: };
