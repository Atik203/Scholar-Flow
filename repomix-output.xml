<file path="apps/backend/src/app/modules/Public/public.service.ts">
  1: import { Prisma } from "../../shared/prisma";
  2: import prisma from "../../shared/prisma";
  3: interface FaqRow {
  4:   id: string;
  5:   question: string;
  6:   answer: string;
  7:   category: string;
  8:   order: number;
  9:   isPublished: boolean;
 10:   createdAt: Date;
 11: }
 12: interface TestimonialRow {
 13:   id: string;
 14:   name: string;
 15:   title: string;
 16:   company: string | null;
 17:   avatar: string | null;
 18:   content: string;
 19:   rating: number;
 20:   order: number;
 21:   createdAt: Date;
 22: }
 23: interface NewsletterRow {
 24:   id: string;
 25:   email: string;
 26: }
 27: interface PageContentRow {
 28:   id: string;
 29:   slug: string;
 30:   title: string;
 31:   content: string;
 32:   metadata: unknown;
 33:   createdAt: Date;
 34: }
 35: interface CountRow {
 36:   total: number;
 37: }
 38: export class PublicService {
 39:   static async getFaqs(category?: string, page = 1, limit = 50) {
 40:     const skip = (page - 1) * limit;
 41:     const categoryFilter = category
 42:       ? Prisma.sql`AND f."category" = ${category}`
 43:       : Prisma.empty;
 44:     const faqs = await prisma.$queryRaw<FaqRow[]>`
 45:       SELECT f.id, f.question, f.answer, f.category, f."order", f."isPublished", f."createdAt"
 46:       FROM "Faq" f
 47:       WHERE f."isPublished" = true AND f."isDeleted" = false
 48:       ${categoryFilter}
 49:       ORDER BY f."category" ASC, f."order" ASC
 50:       LIMIT ${limit} OFFSET ${skip}
 51:     `;
 52:     const countResult = await prisma.$queryRaw<CountRow[]>`
 53:       SELECT COUNT(*)::int as total
 54:       FROM "Faq" f
 55:       WHERE f."isPublished" = true AND f."isDeleted" = false
 56:       ${categoryFilter}
 57:     `;
 58:     const total = countResult[0]?.total ?? 0;
 59:     return {
 60:       result: faqs,
 61:       meta: { page, limit, total, totalPage: Math.ceil(total / limit) },
 62:     };
 63:   }
 64:   static async getFaqCategories() {
 65:     const categories = await prisma.$queryRaw<Array<{ category: string }>>`
 66:       SELECT DISTINCT f."category"
 67:       FROM "Faq" f
 68:       WHERE f."isPublished" = true AND f."isDeleted" = false
 69:       ORDER BY f."category" ASC
 70:     `;
 71:     return categories.map((c) => c.category);
 72:   }
 73:   static async getTestimonials(page = 1, limit = 50) {
 74:     const skip = (page - 1) * limit;
 75:     const testimonials = await prisma.$queryRaw<TestimonialRow[]>`
 76:       SELECT t.id, t.name, t.title, t.company, t.avatar, t.content, t.rating, t."order", t."createdAt"
 77:       FROM "Testimonial" t
 78:       WHERE t."isPublished" = true AND t."isDeleted" = false
 79:       ORDER BY t."order" ASC
 80:       LIMIT ${limit} OFFSET ${skip}
 81:     `;
 82:     const countResult = await prisma.$queryRaw<CountRow[]>`
 83:       SELECT COUNT(*)::int as total
 84:       FROM "Testimonial" t
 85:       WHERE t."isPublished" = true AND t."isDeleted" = false
 86:     `;
 87:     const total = countResult[0]?.total ?? 0;
 88:     return {
 89:       result: testimonials,
 90:       meta: { page, limit, total, totalPage: Math.ceil(total / limit) },
 91:     };
 92:   }
 93:   static async subscribeToNewsletter(email: string) {
 94:     const existing = await prisma.$queryRaw<NewsletterRow[]>`
 95:       SELECT ns.id, ns.email
 96:       FROM "NewsletterSubscriber" ns
 97:       WHERE ns.email = ${email} AND ns."isDeleted" = false
 98:       LIMIT 1
 99:     `;
100:     if (existing.length > 0) {
101:       await prisma.$executeRaw`
102:         UPDATE "NewsletterSubscriber"
103:         SET "isActive" = true, "updatedAt" = NOW()
104:         WHERE email = ${email}
105:       `;
106:       return existing[0];
107:     }
108:     const result = await prisma.$queryRaw<NewsletterRow[]>`
109:       INSERT INTO "NewsletterSubscriber" (id, email, "subscribedAt", "isActive", "createdAt", "updatedAt")
110:       VALUES (gen_random_uuid(), ${email}, NOW(), true, NOW(), NOW())
111:       RETURNING id, email
112:     `;
113:     return result[0];
114:   }
115:   static async createContactSubmission(data: {
116:     name: string;
117:     email: string;
118:     subject: string;
119:     message: string;
120:   }) {
121:     const result = await prisma.$queryRaw<Array<{ id: string }>>`
122:       INSERT INTO "ContactSubmission" (id, name, email, subject, message, status, "createdAt", "updatedAt")
123:       VALUES (gen_random_uuid(), ${data.name}, ${data.email}, ${data.subject}, ${data.message}, 'NEW'::"ContactSubmissionStatus", NOW(), NOW())
124:       RETURNING id
125:     `;
126:     return result[0];
127:   }
128:   static async getPageContent(slug: string) {
129:     const result = await prisma.$queryRaw<PageContentRow[]>`
130:       SELECT pc.id, pc.slug, pc.title, pc.content, pc.metadata, pc."createdAt"
131:       FROM "PageContent" pc
132:       WHERE pc.slug = ${slug} AND pc."isPublished" = true AND pc."isDeleted" = false
133:       LIMIT 1
134:     `;
135:     return result[0] ?? null;
136:   }
137: }
138: export const publicService = {
139:   getFaqs: PublicService.getFaqs,
140:   getFaqCategories: PublicService.getFaqCategories,
141:   getTestimonials: PublicService.getTestimonials,
142:   subscribeToNewsletter: PublicService.subscribeToNewsletter,
143:   createContactSubmission: PublicService.createContactSubmission,
144:   getPageContent: PublicService.getPageContent,
145: };
</file>

<file path="apps/backend/src/app/modules/Search/search.service.ts">
  1: import { Prisma } from "../../shared/prisma";
  2: import prisma from "../../shared/prisma";
  3: export class SearchService {
  4:   static async globalSearch(
  5:     userId: string,
  6:     query: string,
  7:     type: "all" | "papers" | "collections" | "workspaces" = "all",
  8:     limit: number,
  9:     skip: number,
 10:     workspaceId?: string
 11:   ) {
 12:     const results: Record<string, any> = {};
 13:     const q = query.toLowerCase();
 14:     if (type === "all" || type === "papers") {
 15:       const workspaceFilter = workspaceId
 16:         ? Prisma.sql`AND p."workspaceId" = ${workspaceId}`
 17:         : Prisma.empty;
 18:       const items = await prisma.$queryRaw<any[]>`
 19:         SELECT
 20:           p.id,
 21:           p.title,
 22:           p.abstract,
 23:           p.metadata,
 24:           p.source,
 25:           p."workspaceId",
 26:           p."createdAt",
 27:           GREATEST(
 28:             COALESCE(similarity(p.title, ${q}), 0),
 29:             COALESCE(similarity(p.abstract, ${q}), 0)
 30:           ) AS "matchScore"
 31:         FROM "Paper" p
 32:         WHERE p."isDeleted" = false
 33:           AND (
 34:             p.title % ${q}
 35:             OR p.abstract % ${q}
 36:           )
 37:           ${workspaceFilter}
 38:         ORDER BY "matchScore" DESC, p."createdAt" DESC
 39:         LIMIT ${limit} OFFSET ${skip}
 40:       `;
 41:       const totalCount = await prisma.paper.count({
 42:         where: {
 43:           isDeleted: false,
 44:           workspaceId,
 45:           OR: [
 46:             { title: { contains: q, mode: "insensitive" } },
 47:             { abstract: { contains: q, mode: "insensitive" } },
 48:           ],
 49:         },
 50:       });
 51:       results.papers = { total: totalCount, items };
 52:     }
 53:     if (type === "all" || type === "collections") {
 54:       const collAndConditions: Prisma.CollectionWhereInput[] = [
 55:         { isDeleted: false },
 56:         {
 57:           OR: [
 58:             { name: { contains: q, mode: "insensitive" } },
 59:             { description: { contains: q, mode: "insensitive" } },
 60:           ]
 61:         },
 62:         {
 63:           OR: [
 64:             { ownerId: userId },
 65:             { members: { some: { userId, isDeleted: false } } },
 66:             { isPublic: true }
 67:           ]
 68:         }
 69:       ];
 70:       if (workspaceId) {
 71:         collAndConditions.push({ workspaceId });
 72:       }
 73:       const finalCollectionWhere: Prisma.CollectionWhereInput = {
 74:          AND: collAndConditions
 75:       };
 76:       const [totalCount, items] = await Promise.all([
 77:         prisma.collection.count({ where: finalCollectionWhere }),
 78:         prisma.collection.findMany({
 79:           where: finalCollectionWhere,
 80:           take: limit,
 81:           skip,
 82:           orderBy: { createdAt: "desc" },
 83:           select: {
 84:             id: true,
 85:             name: true,
 86:             description: true,
 87:             isPublic: true,
 88:             workspaceId: true,
 89:           }
 90:         }),
 91:       ]);
 92:       results.collections = { total: totalCount, items };
 93:     }
 94:     if (type === "all" || type === "workspaces") {
 95:       const workspaceWhere: Prisma.WorkspaceWhereInput = {
 96:         AND: [
 97:           { isDeleted: false },
 98:           {
 99:             OR: [
100:               { name: { contains: q, mode: "insensitive" } },
101:               { description: { contains: q, mode: "insensitive" } },
102:             ]
103:           },
104:           {
105:             OR: [
106:               { ownerId: userId },
107:               { members: { some: { userId, isDeleted: false } } }
108:             ]
109:           }
110:         ]
111:       };
112:       const [totalCount, items] = await Promise.all([
113:         prisma.workspace.count({ where: workspaceWhere }),
114:         prisma.workspace.findMany({
115:           where: workspaceWhere,
116:           take: limit,
117:           skip,
118:           orderBy: { createdAt: "desc" },
119:           select: {
120:             id: true,
121:             name: true,
122:             description: true,
123:           }
124:         }),
125:       ]);
126:       results.workspaces = { total: totalCount, items };
127:     }
128:     let aggregateTotal = 0;
129:     if (results.papers) aggregateTotal += results.papers.total;
130:     if (results.collections) aggregateTotal += results.collections.total;
131:     if (results.workspaces) aggregateTotal += results.workspaces.total;
132:     return {
133:       results,
134:       meta: { limit, skip, total: aggregateTotal }
135:     };
136:   }
137:   static async saveSearchQuery(
138:     userId: string,
139:     query: string,
140:     filters?: any,
141:     searchResultsSummary?: any
142:   ) {
143:     if (!query || query.trim().length === 0) return null;
144:     return prisma.searchHistory.create({
145:       data: {
146:         userId,
147:         query: query.trim(),
148:         filters: filters || null,
149:         results: searchResultsSummary || null,
150:       }
151:     });
152:   }
153:   static async getSearchHistory(
154:     userId: string,
155:     limit: number,
156:     skip: number
157:   ) {
158:     const where: Prisma.SearchHistoryWhereInput = {
159:       userId,
160:       isDeleted: false
161:     };
162:     const [total, data] = await Promise.all([
163:       prisma.searchHistory.count({ where }),
164:       prisma.searchHistory.findMany({
165:         where,
166:         take: limit,
167:         skip,
168:         orderBy: { createdAt: "desc" },
169:       }),
170:     ]);
171:     return {
172:       meta: { total, skip, limit },
173:       result: data,
174:     };
175:   }
176:   static async getTrendingPapers(limit: number) {
177:     return prisma.paper.findMany({
178:       where: { isDeleted: false },
179:       take: limit,
180:       orderBy: { createdAt: "desc" },
181:     });
182:   }
183:   static async getRecommendations(userId: string, limit: number) {
184:     return prisma.paper.findMany({
185:       where: {
186:         isDeleted: false,
187:         workspace: {
188:           members: {
189:             some: {
190:               userId,
191:               isDeleted: false
192:             }
193:           }
194:         }
195:       },
196:       take: limit,
197:       orderBy: { createdAt: "desc" }
198:     });
199:   }
200: }
201: export default SearchService;
</file>

