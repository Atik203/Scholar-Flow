289:           c."updatedAt",
290:           u.email as "ownerEmail",
291:           u.name as "ownerName",
292:           COALESCE(paper_counts.paper_count, 0)::int as "paperCount",
293:           COALESCE(member_counts.member_count, 0)::int as "memberCount",
294:           (
295:             CASE
296:               WHEN c.name ILIKE ${`%${searchTerm}%`} THEN 10
297:               ELSE 0
298:             END +
299:             CASE
300:               WHEN c.description ILIKE ${`%${searchTerm}%`} THEN 5
301:               ELSE 0
302:             END
303:           ) as relevance_score
304:         FROM "Collection" c
305:         LEFT JOIN "User" u ON c."ownerId" = u.id
306:         LEFT JOIN (
307:           SELECT "collectionId", COUNT(*)::int AS paper_count
308:           FROM "CollectionPaper"
