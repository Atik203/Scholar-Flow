125:   static async updateWorkspace(
126:     userId: string,
127:     id: string,
128:     data: { name?: string; description?: string }
129:   ) {
130:     // Ensure user is Admin/TeamLead or owner
131:     const perm = await prisma.$queryRaw<any[]>`
132:       SELECT m.role, w."ownerId"
133:       FROM "WorkspaceMember" m JOIN "Workspace" w ON w.id = m."workspaceId"
134:       WHERE m."userId" = ${userId} AND m."workspaceId" = ${id} AND m."isDeleted" = false AND w."isDeleted" = false
135:     `;
136:     const member = perm[0];
137:     if (!member) throw new ApiError(403, "Not a member of this workspace");
138:     const isManager =
139:       ["OWNER", "MANAGER"].includes(member.role) || member.ownerId === userId;
140:     if (!isManager) throw new ApiError(403, "Insufficient permissions");
141:     if (data.name !== undefined || data.description !== undefined) {
142:       let rows: any[] = [];
143:       if (data.name !== undefined && data.description !== undefined) {
144:         rows = await prisma.$queryRaw<any[]>`
145:           UPDATE "Workspace"
146:           SET name = ${data.name}, description = ${data.description}, "updatedAt" = now()
147:           WHERE id = ${id}
148:           RETURNING *
149:         `;
150:       } else if (data.name !== undefined) {
151:         rows = await prisma.$queryRaw<any[]>`
152:           UPDATE "Workspace"
153:           SET name = ${data.name}, "updatedAt" = now()
154:           WHERE id = ${id}
155:           RETURNING *
156:         `;
157:       } else if (data.description !== undefined) {
158:         rows = await prisma.$queryRaw<any[]>`
159:           UPDATE "Workspace"
160:           SET description = ${data.description}, "updatedAt" = now()
161:           WHERE id = ${id}
162:           RETURNING *
163:         `;
164:       }
165:       await prisma.$executeRaw`
166:         INSERT INTO "ActivityLog" (id, "userId", "workspaceId", entity, "entityId", action, details, "createdAt", "updatedAt", "isDeleted")
167:         VALUES (gen_random_uuid(), ${userId}, ${id}, 'Workspace', ${id}, 'UPDATE', '{}'::jsonb, now(), now(), false)
168:       `;
169:       return rows[0];
170:     }
171:     return this.getWorkspace(userId, id);
172:   }
173:   static async deleteWorkspace(userId: string, id: string) {
174:     // Only Admin/Owner can delete
175:     const perm = await prisma.$queryRaw<any[]>`
176:       SELECT m.role, w."ownerId"
177:       FROM "WorkspaceMember" m JOIN "Workspace" w ON w.id = m."workspaceId"
178:       WHERE m."userId" = ${userId} AND m."workspaceId" = ${id} AND m."isDeleted" = false AND w."isDeleted" = false
179:     `;
180:     const member = perm[0];
181:     if (!member) throw new ApiError(403, "Not a member of this workspace");
182:     const isOwner = member.role === "OWNER" || member.ownerId === userId;
183:     if (!isOwner)
184:       throw new ApiError(403, "Only Owner can delete workspace");
185:     // Soft delete workspace and cascade to related entities
