113:     const limit = Math.min(20, parseInt(q.limit, 10));
114:     const result = await SearchService.getExplore(q.category, page, limit);
115:     sendPaginatedResponse(res, result.items, result.meta, "Explore results retrieved successfully");
116:   }),
117:   aiSearch: catchAsync(async (req: Request, res: Response) => {
118:     const authReq = req as AuthenticatedRequest;
119:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
120:     const body = aiSearchBodySchema.parse(req.body);
121:     const result = await SearchService.aiSummarize(
