 82:         `[PDFExtraction] Storing chunks in database for paper: ${paperId}`
 83:       );
 84:       await this.storeChunks(paperId, chunks);
 85:       console.log(
 86:         `[PDFExtraction] Updating paper status to PROCESSED for paper: ${paperId}`
 87:       );
 88:       await Promise.all([
 89:         prisma.paper.update({
 90:           where: { id: paperId },
 91:           data: {
 92:             processingStatus: "PROCESSED",
 93:             processedAt: new Date(),
 94:           },
 95:         }),
