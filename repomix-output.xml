127:                 </p>
128:               </div>
129:               <div className="space-y-2">
130:                 <label htmlFor="editor-font-size" className="text-sm font-medium">
131:                   Editor font size
132:                 </label>
133:                 <select
134:                   id="editor-font-size"
135:                   value={settings.fontSize}
136:                   onChange={(e) =>
