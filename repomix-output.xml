217: const formatTimeAgo = (dateString: string) => {
218:   const date = new Date(dateString);
219:   const now = new Date();
220:   const diffMs = now.getTime() - date.getTime();
221:   const diffMins = Math.floor(diffMs / (1000 * 60));
222:   const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
223:   const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
224:   if (diffMins < 1) return "Just now";
225:   if (diffMins < 60) return `${diffMins}m ago`;
226:   if (diffHours < 24) return `${diffHours}h ago`;
227:   if (diffDays < 7) return `${diffDays}d ago`;
228:   return date.toLocaleDateString();
229: };
