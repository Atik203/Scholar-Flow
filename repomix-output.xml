201:                   value={permission}
202:                   onValueChange={(value: "view" | "edit") =>
203:                     setPermission(value)
204:                   }
205:                 >
206:                   <SelectTrigger className="w-[120px]">
207:                     <SelectValue />
208:                   </SelectTrigger>
209:                   <SelectContent>
210:                     <SelectItem value="view">View Only</SelectItem>
211:                     <SelectItem value="edit">Can Edit</SelectItem>
212:                   </SelectContent>
213:                 </Select>
214:               </div>
215:               <Textarea
216:                 placeholder="Add a personal message (optional)..."
217:                 value={message}
218:                 onChange={(e) => setMessage(e.target.value)}
219:                 className="min-h-[60px] resize-none"
220:               />
221:               <Button
222:                 onClick={handleEmailShare}
223:                 disabled={!recipientEmail || isEmailSharing}
224:                 className="w-full"
225:               >
226:                 {isEmailSharing ? (
227:                   <>
228:                     <Loader2 className="mr-2 h-4 w-4 animate-spin" />
229:                     Sending...
230:                   </>
231:                 ) : (
232:                   <>
233:                     <Mail className="mr-2 h-4 w-4" />
234:                     Send Email Invitation
235:                   </>
236:                 )}
237:               </Button>
238:             </div>
239:           </div>
240:           {}
241:           <div className="space-y-3">
242:             <Label>Quick Share</Label>
243:             <div className="grid grid-cols-2 gap-2">
244:               <Button
245:                 variant="outline"
246:                 onClick={() => {
247:                   const subject = encodeURIComponent(
248:                     `Check out: ${paperTitle}`
249:                   );
250:                   const body = encodeURIComponent(
251:                     shareUrl
252:                       ? `I wanted to share this paper with you: ${shareUrl}`
253:                       : `I'm working on a research paper titled "${paperTitle}".`
254:                   );
255:                   window.open(`mailto:?subject=${subject}&body=${body}`);
256:                 }}
257:                 className="flex items-center gap-2"
258:               >
259:                 <Mail className="h-4 w-4" />
260:                 Email
261:               </Button>
262:               <Button
263:                 variant="outline"
264:                 onClick={() => {
265:                   console.log("Team sharing not implemented yet");
266:                 }}
267:                 className="flex items-center gap-2"
268:                 disabled
269:               >
270:                 <Users className="h-4 w-4" />
271:                 Team
272:               </Button>
273:             </div>
274:           </div>
275:           {}
276:           <div className="flex justify-end space-x-2 pt-4 border-t">
277:             <Button variant="outline" onClick={onClose}>
278:               Close
279:             </Button>
280:           </div>
281:         </div>
282:       </DialogContent>
283:     </Dialog>
284:   );
285: }
</file>

<file path="apps/frontend/src/components/text-editor/TextEditorDashboard.tsx">
  1: "use client";
  2: import { Button } from "@/components/ui/button";
  3: import {
  4:   Card,
  5:   CardContent,
  6:   CardDescription,
  7:   CardHeader,
  8:   CardTitle,
  9: } from "@/components/ui/card";
 10: import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
 11: import { useListEditorPapersQuery } from "@/redux/api/paperApi";
 12: import { Download, FileText, Plus, Save } from "lucide-react";
 13: import dynamic from "next/dynamic";
 14: import { useState } from "react";
 15: import { CreatePaperDialog } from "./CreatePaperDialog";
 16: import { EditorSkeleton } from "./EditorSkeleton";
 17: import { PapersList } from "./PapersList";
 18: const ScholarFlowEditor = dynamic(
 19:   () =>
 20:     import("./ScholarFlowEditor").then((mod) => ({
 21:       default: mod.ScholarFlowEditor,
 22:     })),
 23:   {
 24:     loading: () => <EditorSkeleton />,
 25:     ssr: false,
 26:   }
 27: );
 28: export function TextEditorDashboard() {
 29:   const [activeTab, setActiveTab] = useState("papers");
 30:   const [currentPaper, setCurrentPaper] = useState<string | null>(null);
 31:   const [isCreateDialogOpen, setIsCreateDialogOpen] = useState(false);
 32:   const { data: allPapersResponse } = useListEditorPapersQuery({});
 33:   const allPapers = allPapersResponse?.data || [];
 34:   const totalPapers = allPapers.length;
 35:   const drafts = allPapers.filter((paper: any) => paper.isDraft).length;
 36:   const published = allPapers.filter((paper: any) => !paper.isDraft).length;
 37:   const handleCreateNew = () => {
 38:     setIsCreateDialogOpen(true);
 39:   };
 40:   const handlePaperCreated = (paperId: string) => {
 41:     setCurrentPaper(paperId);
 42:     setActiveTab("editor");
 43:     setIsCreateDialogOpen(false);
 44:   };
 45:   const handlePaperSelected = (paperId: string) => {
 46:     setCurrentPaper(paperId);
 47:     setActiveTab("editor");
 48:   };
 49:   if (activeTab === "editor" && currentPaper) {
 50:     return (
 51:       <div className="min-h-screen">
 52:         <div className="flex items-center justify-between mb-6">
 53:           <Button variant="outline" onClick={() => setActiveTab("papers")}>
 54:             ← Back to Papers
 55:           </Button>
 56:         </div>
 57:         <ScholarFlowEditor
 58:           paperId={currentPaper}
 59:           onBack={() => setActiveTab("papers")}
 60:         />
 61:       </div>
 62:     );
 63:   }
 64:   return (
 65:     <div className="space-y-6">
 66:       {}
 67:       <div className="flex items-center justify-between">
 68:         <div>
 69:           <h1 className="text-3xl font-bold tracking-tight">Text Editor</h1>
 70:           <p className="text-muted-foreground">
 71:             Create, edit, and manage your research papers with our rich text
 72:             editor.
 73:           </p>
 74:         </div>
 75:         <Button onClick={handleCreateNew} className="flex items-center gap-2">
 76:           <Plus className="h-4 w-4" />
 77:           New Paper
 78:         </Button>
 79:       </div>
 80:       {}
 81:       <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
 82:         <Card>
 83:           <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
 84:             <CardTitle className="text-sm font-medium">Total Papers</CardTitle>
 85:             <FileText className="h-4 w-4 text-muted-foreground" />
 86:           </CardHeader>
 87:           <CardContent>
 88:             <div className="text-2xl font-bold">{totalPapers}</div>
 89:             <p className="text-xs text-muted-foreground">
 90:               {totalPapers === 0 ? "No papers yet" : "All your papers"}
 91:             </p>
 92:           </CardContent>
 93:         </Card>
 94:         <Card>
 95:           <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
 96:             <CardTitle className="text-sm font-medium">Drafts</CardTitle>
 97:             <Save className="h-4 w-4 text-muted-foreground" />
 98:           </CardHeader>
 99:           <CardContent>
100:             <div className="text-2xl font-bold">{drafts}</div>
101:             <p className="text-xs text-muted-foreground">
102:               {drafts === 0 ? "No drafts" : "Ready to publish"}
103:             </p>
104:           </CardContent>
105:         </Card>
106:         <Card>
107:           <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
108:             <CardTitle className="text-sm font-medium">Published</CardTitle>
109:             <Download className="h-4 w-4 text-muted-foreground" />
110:           </CardHeader>
111:           <CardContent>
112:             <div className="text-2xl font-bold">{published}</div>
113:             <p className="text-xs text-muted-foreground">
114:               {published === 0 ? "None published" : "Available for sharing"}
115:             </p>
116:           </CardContent>
117:         </Card>
118:       </div>
119:       {}
120:       <Tabs defaultValue="papers" className="space-y-4">
121:         <TabsList>
122:           <TabsTrigger value="papers">My Papers</TabsTrigger>
123:           <TabsTrigger value="templates">Templates</TabsTrigger>
124:           <TabsTrigger value="settings">Settings</TabsTrigger>
125:         </TabsList>
126:         <TabsContent value="papers" className="space-y-4">
127:           <PapersList onPaperSelect={handlePaperSelected} />
128:         </TabsContent>
129:         <TabsContent value="templates" className="space-y-4">
130:           <Card>
131:             <CardHeader>
132:               <CardTitle>Paper Templates</CardTitle>
133:               <CardDescription>
134:                 Choose from our collection of research paper templates.
135:               </CardDescription>
136:             </CardHeader>
137:             <CardContent>
138:               <p className="text-muted-foreground">Templates coming soon...</p>
139:             </CardContent>
140:           </Card>
141:         </TabsContent>
142:         <TabsContent value="settings" className="space-y-4">
143:           <Card>
144:             <CardHeader>
145:               <CardTitle>Editor Settings</CardTitle>
146:               <CardDescription>
147:                 Customize your writing experience.
148:               </CardDescription>
149:             </CardHeader>
150:             <CardContent>
151:               <p className="text-muted-foreground">Settings coming soon...</p>
152:             </CardContent>
153:           </Card>
154:         </TabsContent>
155:       </Tabs>
156:       {}
157:       <CreatePaperDialog
158:         isOpen={isCreateDialogOpen}
159:         onClose={() => setIsCreateDialogOpen(false)}
160:         onPaperCreated={handlePaperCreated}
161:       />
162:     </div>
163:   );
164: }
</file>

