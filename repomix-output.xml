<file path="apps/frontend/src/hooks/useReadingSessionTracker.ts">
 1: "use client";
 2: import { useEffect, useRef } from "react";
 3: import {
 4:   useStartReadingSessionMutation,
 5:   useStopReadingSessionMutation,
 6: } from "@/redux/api/analyticsApi";
 7: const MAX_SESSION_MINUTES = 180;
 8: export function useReadingSessionTracker(paperId?: string | null) {
 9:   const [startSession] = useStartReadingSessionMutation();
10:   const [stopSession] = useStopReadingSessionMutation();
11:   const sessionRef = useRef<{ eventId: string; startedAt: number } | null>(null);
12:   const paperRef = useRef<string | null>(null);
13:   useEffect(() => {
14:     if (!paperId) return;
15:     const endCurrent = () => {
16:       const session = sessionRef.current;
17:       sessionRef.current = null;
18:       if (!session) return;
19:       const minutes = Math.min(
20:         MAX_SESSION_MINUTES,
21:         Math.max(1, Math.round((Date.now() - session.startedAt) / 60000))
22:       );
23:       stopSession({ eventId: session.eventId, units: minutes }).catch(() => undefined);
24:     };
25:     if (paperRef.current && paperRef.current !== paperId) endCurrent();
26:     paperRef.current = paperId;
27:     let sessionStarted = false;
28:     const maybeStart = () => {
29:       if (sessionStarted || document.visibilityState === "hidden") return;
30:       sessionStarted = true;
31:       startSession({ paperId }).unwrap().then((res) => {
32:         const eventId = (res as { data?: { id?: string } })?.data?.id;
33:         if (eventId) sessionRef.current = { eventId, startedAt: Date.now() };
34:       }).catch(() => undefined);
35:     };
36:     maybeStart();
37:     const onVisibility = () => {
38:       if (document.visibilityState === "hidden") {
39:         endCurrent();
40:         sessionStarted = false;
41:       } else {
42:         maybeStart();
43:       }
44:     };
45:     document.addEventListener("visibilitychange", onVisibility);
46:     return () => {
47:       document.removeEventListener("visibilitychange", onVisibility);
48:       if (sessionStarted) endCurrent();
49:       sessionStarted = false;
50:     };
51:   }, [paperId, startSession, stopSession]);
52: }
</file>

