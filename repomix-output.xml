<file path="apps/backend/src/app/modules/Analytics/analytics.controller.ts">
  1: import { Request, Response } from "express";
  2: import ApiError from "../../errors/ApiError";
  3: import { AuthenticatedRequest } from "../../interfaces/common";
  4: import catchAsync from "../../shared/catchAsync";
  5: import { sendSuccessResponse } from "../../shared/sendResponse";
  6: import { personalAnalyticsService } from "./personal.service";
  7: import { usageReportsService } from "./usage.service";
  8: import { workspaceAnalyticsService } from "./workspace.service";
  9: import { aiUsageService } from "./aiUsage.service";
 10: import prisma from "../../shared/prisma";
 11: type TimeRangeKey = "week" | "month" | "quarter" | "year";
 12: const TIME_RANGES: TimeRangeKey[] = ["week", "month", "quarter", "year"];
 13: const safeTimeRange = (value: unknown, fallback: TimeRangeKey = "month"): TimeRangeKey => {
 14:   const v = String(value ?? "");
 15:   return (TIME_RANGES as string[]).includes(v) ? (v as TimeRangeKey) : fallback;
 16: };
 17: export const analyticsController = {
 18:   personal: catchAsync(async (req: Request, res: Response) => {
 19:     const authReq = req as AuthenticatedRequest;
 20:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
 21:     const timeRange = safeTimeRange(req.query.timeRange);
 22:     const summary = await personalAnalyticsService.getSummary(
 23:       authReq.user.id,
 24:       timeRange
 25:     );
 26:     sendSuccessResponse(res, summary, "Personal analytics retrieved");
 27:   }),
 28:   startReadingSession: catchAsync(async (req: Request, res: Response) => {
 29:     const authReq = req as AuthenticatedRequest;
 30:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
 31:     const paperId = req.body?.paperId
 32:       ? String(req.body.paperId)
