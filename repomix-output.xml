825:   private sanitizeHtmlForEditor(html: string): string {
826:     try {
827:       let sanitized = html
828:         .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, "")
829:         .replace(/on\w+="[^"]*"/gi, "") // Remove event handlers
830:         .replace(/javascript:/gi, "") // Remove javascript: protocol
831:         .replace(/data:/gi, "") // Remove data: protocol for security
832:         .replace(/<iframe\b[^>]*>/gi, "") // Remove iframes
833:         .replace(/<embed\b[^>]*>/gi, "") // Remove embeds
834:         .replace(/<object\b[^>]*>.*?<\/object>/gi, ""); // Remove objects
835:       // Limit the size to prevent abuse (100KB limit)
836:       if (sanitized.length > 102400) {
837:         sanitized = sanitized.substring(0, 102400) + "... [content truncated]";
838:       }
839:       return sanitized;
840:     } catch (error) {
841:       console.error(`[DocumentExtraction] HTML sanitization failed:`, error);
842:       return ""; // Return empty string if sanitization fails
843:     }
844:   }
845:   /**
846:    * Generate OpenAI embeddings for paper chunks (pgvector semantic search)
847:    */
848:   async generateEmbeddingsForPaper(paperId: string): Promise<void> {
849:     const apiKey = process.env.OPENAI_API_KEY;
850:     if (!apiKey || process.env.USE_PGVECTOR !== "true") {
851:       return;
852:     }
853:     const EMBEDDING_MODEL = process.env.EMBEDDING_MODEL || "text-embedding-3-small";
854:     const EMBEDDING_DIM = 1536;
855:     const chunks = await prisma.paperChunk.findMany({
856:       where: { paperId, isDeleted: false },
857:       select: { id: true, content: true },
858:       orderBy: { idx: "asc" },
859:     });
860:     if (chunks.length === 0) return;
861:     console.log(
862:       `[DocumentExtraction] Generating embeddings for ${chunks.length} chunks of paper ${paperId}`
863:     );
864:     const BATCH_SIZE = 20;
865:     for (let i = 0; i < chunks.length; i += BATCH_SIZE) {
866:       const batch = chunks.slice(i, i + BATCH_SIZE);
867:       try {
868:         const controller = new AbortController();
869:         const timeout = setTimeout(() => controller.abort(), 60000);
870:         const response = await fetch(
871:           "https://api.openai.com/v1/embeddings",
872:           {
873:             method: "POST",
874:             headers: {
875:               "Content-Type": "application/json",
876:               Authorization: `Bearer ${apiKey}`,
877:             },
878:             body: JSON.stringify({
879:               model: EMBEDDING_MODEL,
880:               input: batch.map((c) => c.content.replace(/\s+/g, " ").trim().slice(0, 8000)),
881:             }),
882:             signal: controller.signal,
883:           }
884:         );
885:         clearTimeout(timeout);
886:         if (!response.ok) {
887:           const errText = await response.text().catch(() => "");
888:           console.error(
889:             `[DocumentExtraction] Embedding API error: ${response.status} ${errText}`
890:           );
891:           // Continue with the next batch — one failure must not orphan the
892:           // remaining chunks (the backfill sweep will retry this paper).
893:           continue;
894:         }
895:         const data = (await response.json()) as {
896:           data: Array<{ embedding: number[] }>;
897:         };
898:         for (let j = 0; j < batch.length; j++) {
899:           const embedding = data.data[j]?.embedding;
900:           if (!embedding || embedding.length !== EMBEDDING_DIM) continue;
901:           const vectorStr = `[${embedding.join(",")}]`;
902:           await prisma.$executeRaw`
903:             UPDATE "PaperChunk"
904:             SET embedding = ${vectorStr}::vector
905:             WHERE id = ${batch[j].id}
906:           `;
907:         }
908:         console.log(
909:           `[DocumentExtraction] Embedded batch ${i / BATCH_SIZE + 1}/${Math.ceil(chunks.length / BATCH_SIZE)}`
910:         );
911:       } catch (error) {
912:         console.error(
913:           `[DocumentExtraction] Embedding batch ${i / BATCH_SIZE + 1} failed:`,
914:           error instanceof Error ? error.message : error
915:         );
916:       }
917:     }
918:     console.log(
919:       `[DocumentExtraction] Embedding generation complete for paper ${paperId}`
920:     );
921:   }
922: }
923: export const documentExtractionService = new DocumentExtractionService();
