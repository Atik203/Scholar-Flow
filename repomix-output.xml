22:   const handleFocus = () => setIsFocused(true);
23:   const handleBlur = (e: React.FocusEvent<HTMLInputElement>) => {
24:     setIsFocused(false);
25:     setHasValue(!!e.target.value);
26:   };
27:   const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
28:     setHasValue(!!e.target.value);
29:     props.onChange?.(e);
30:   };
31:   const isFloating = isFocused || hasValue;
32:   return (
33:     <div className="relative">
34:       <input
35:         ref={ref}
36:         id={inputId}
37:         className={cn(
38:           "peer w-full border-0 border-b-2 border-gray-300 dark:border-gray-600",
39:           "bg-transparent px-0 py-3 text-foreground",
40:           "placeholder-transparent focus:border-primary focus:outline-none",
41:           "disabled:cursor-not-allowed disabled:opacity-50",
42:           "transition-colors duration-200",
43:           error && "border-destructive focus:border-destructive",
44:           className
45:         )}
46:         placeholder={label}
47:         onFocus={handleFocus}
48:         onBlur={handleBlur}
49:         onChange={handleChange}
50:         {...props}
51:       />
52:       <motion.label
53:         htmlFor={inputId}
54:         initial={false}
55:         animate={{
56:           y: isFloating ? -24 : 0,
57:           scale: isFloating ? 0.85 : 1,
58:           color: isFloating
59:             ? error
60:               ? "var(--destructive)"
61:               : "var(--primary)"
62:             : "var(--muted-foreground)",
63:         }}
64:         transition={{ duration: 0.2, ease: "easeOut" }}
65:         className={cn(
66:           "absolute left-0 top-3 origin-left pointer-events-none",
67:           "text-base transition-all duration-200",
68:           required && "after:content-['*'] after:ml-1 after:text-destructive"
69:         )}
70:       >
71:         {label}
72:       </motion.label>
