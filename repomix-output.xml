  1: "use client";
  2: import { DashboardLayout } from "@/components/layout/DashboardLayout";
  3: import {
  4:   showErrorToast,
  5:   showSuccessToast,
  6: } from "@/components/providers/ToastProvider";
  7: import { Button } from "@/components/ui/button";
  8: import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
  9: import { Input } from "@/components/ui/input";
 10: import { Label } from "@/components/ui/label";
 11: import { showApiErrorToast } from "@/lib/errorHandling";
 12: import { useCreateWorkspaceMutation } from "@/redux/api/workspaceApi";
 13: import { ArrowLeft, Building2 } from "lucide-react";
 14: import Link from "next/link";
 15: import { useRouter } from "next/navigation";
 16: import { useState } from "react";
 17: export default function CreateWorkspacePage() {
 18:   const [name, setName] = useState("");
 19:   const [createWorkspace, { isLoading }] = useCreateWorkspaceMutation();
 20:   const router = useRouter();
 21:   const handleSubmit = async (e: React.FormEvent) => {
 22:     e.preventDefault();
 23:     if (!name.trim()) {
 24:       showErrorToast("Workspace name is required");
 25:       return;
 26:     }
 27:     try {
 28:       const result = await createWorkspace({ name: name.trim() }).unwrap();
 29:       showSuccessToast("Workspace created successfully!");
 30:       router.push(`/dashboard/workspaces/${result.id}`);
 31:     } catch (error) {
 32:       showApiErrorToast(error as any);
 33:     }
 34:   };
 35:   return (
 36:     <DashboardLayout>
 37:       <div className="max-w-2xl mx-auto space-y-6">
 38:         {}
 39:         <div className="flex items-center justify-between">
 40:           <div className="space-y-1">
 41:             <h1 className="text-3xl font-bold tracking-tight">
 42:               Create New Workspace
 43:             </h1>
 44:             <p className="text-muted-foreground">
 45:               Set up a new workspace to organize your research and collaborate
 46:               with others
 47:             </p>
 48:           </div>
 49:         </div>
 50:         {}
 51:         <Button variant="ghost" asChild className="w-fit">
 52:           <Link href="/dashboard/workspaces">
 53:             <ArrowLeft className="h-4 w-4 mr-2" />
 54:             Back to Workspaces
 55:           </Link>
 56:         </Button>
 57:         {}
 58:         <Card>
 59:           <CardHeader>
 60:             <CardTitle className="flex items-center gap-2">
 61:               <Building2 className="h-5 w-5" />
 62:               Workspace Details
 63:             </CardTitle>
 64:           </CardHeader>
 65:           <CardContent>
 66:             <form onSubmit={handleSubmit} className="space-y-4">
 67:               <div className="space-y-2">
 68:                 <Label htmlFor="name">Workspace Name</Label>
 69:                 <Input
 70:                   id="name"
 71:                   type="text"
 72:                   placeholder="Enter workspace name..."
 73:                   value={name}
 74:                   onChange={(e) => setName(e.target.value)}
 75:                   maxLength={120}
 76:                   required
 77:                 />
 78:                 <p className="text-sm text-muted-foreground">
 79:                   Choose a descriptive name for your workspace (2-120
 80:                   characters)
 81:                 </p>
 82:               </div>
 83:               <div className="flex gap-4 pt-4">
 84:                 <Button type="submit" disabled={isLoading || !name.trim()}>
 85:                   {isLoading ? "Creating..." : "Create Workspace"}
 86:                 </Button>
 87:                 <Button type="button" variant="outline" asChild>
 88:                   <Link href="/dashboard/workspaces">Cancel</Link>
 89:                 </Button>
 90:               </div>
 91:             </form>
 92:           </CardContent>
 93:         </Card>
 94:         {}
 95:         <Card>
 96:           <CardContent className="pt-6">
 97:             <div className="space-y-4">
 98:               <h3 className="font-semibold">What is a workspace?</h3>
