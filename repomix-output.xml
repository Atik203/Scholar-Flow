 81:   const year = yearMatch ? Number(yearMatch[0]) : undefined;
 82:   return {
 83:     title: titleCandidate,
 84:     abstract: abstract ? abstract.slice(0, 1200) : undefined,
 85:     authors,
 86:     year,
 87:     keywords: [],
 88:     source: (input.existingMetadata?.source as string) || undefined,
 89:     confidence: 0.2,
 90:   };
 91: };
 92: const clampWordLimit = (wordLimit?: number) => {
 93:   const parsed = Number(wordLimit);
 94:   if (!Number.isFinite(parsed)) {
 95:     return DEFAULT_SUMMARY_WORD_LIMIT;
 96:   }
 97:   return Math.max(
 98:     MIN_SUMMARY_WORD_LIMIT,
 99:     Math.min(parsed, MAX_SUMMARY_WORD_LIMIT)
100:   );
101: };
102: const limitTextToWords = (text: string, maxWords: number) => {
103:   const words = text.split(/\s+/).filter(Boolean);
104:   if (words.length <= maxWords) {
105:     return words.join(" ");
106:   }
107:   return `${words.slice(0, maxWords).join(" ")}`.trim() + "…";
108: };
109: const truncateSentence = (text: string, maxChars: number) => {
110:   if (text.length <= maxChars) {
111:     return text;
112:   }
113:   return `${text.slice(0, maxChars - 1).trim()}…`;
114: };
115: const normalizeSummaryInput = (input: AiSummaryRequest): AiSummaryRequest => {
116:   const text = (input.text || "").replace(/\s+/g, " ").trim();
117:   const truncatedText =
118:     text.length > MAX_SUMMARY_TEXT_LENGTH
119:       ? text.slice(0, MAX_SUMMARY_TEXT_LENGTH)
120:       : text;
121:   const focusAreas = input.focusAreas
122:     ?.map((area) => area.trim())
123:     .filter((area) => area.length > 0);
124:   return {
125:     ...input,
126:     text: truncatedText,
127:     instructions: input.instructions?.trim() || undefined,
128:     focusAreas,
129:     language: input.language?.trim() || undefined,
130:     wordLimit: clampWordLimit(input.wordLimit),
131:   };
132: };
133: const hashText = (text: string) =>
134:   crypto.createHash("sha1").update(text).digest("hex");
135: const buildSummaryCacheParams = (input: AiSummaryRequest) => ({
136:   tone: input.tone,
137:   audience: input.audience,
138:   language: input.language,
139:   wordLimit: input.wordLimit,
140:   focus: input.focusAreas,
141:   textHash: hashText(input.text),
142: });
143: const runSummaryHeuristics = (input: AiSummaryRequest): AiSummaryResult => {
144:   const sentences = input.text
145:     .split(/(?<=[.!?])\s+/)
146:     .map((sentence) => sentence.trim())
147:     .filter((sentence) => sentence.length > 0);
148:   const paragraphBlocks = input.text
149:     .split(/\n\s*\n/)
150:     .map((block) => block.replace(/\s+/g, " ").trim())
151:     .filter((block) => block.length > 0);
152:   const baseSummary = sentences.length
153:     ? sentences.slice(0, 5).join(" ")
154:     : paragraphBlocks.slice(0, 2).join(" ");
155:   const summary = baseSummary
156:     ? limitTextToWords(
157:         baseSummary,
158:         input.wordLimit ?? DEFAULT_SUMMARY_WORD_LIMIT
159:       )
160:     : "We couldn't generate a summary because the paper content is empty. Please try re-processing the document.";
161:   const keywordRegex =
162:     /(result|conclusion|method|approach|finding|model|dataset|future work|limitation)/i;
163:   const highlightCandidates = sentences.filter((sentence) =>
164:     keywordRegex.test(sentence)
165:   );
166:   const highlightsSource = highlightCandidates.length
167:     ? highlightCandidates
168:     : sentences.slice(0, 4);
169:   const highlights = highlightsSource
170:     .map((sentence) => truncateSentence(sentence, 220))
171:     .filter(
172:       (sentence, index, arr) => sentence && arr.indexOf(sentence) === index
173:     )
174:     .slice(0, 4);
175:   const followUpQuestions = [
176:     "Which methodology underpins the core findings, and are there assumptions to validate?",
177:     "How could these results translate into actionable steps for your current research goals?",
178:     "What gaps or future work do the authors recommend exploring next?",
179:   ];
180:   return {
181:     provider: "heuristic",
182:     summary,
183:     highlights: highlights.length ? highlights : undefined,
184:     followUpQuestions,
185:     rawResponse: { heuristic: true },
186:   };
187: };
188: const sanitizeInsightHistory = (
189:   history: AiInsightMessagePayload[] | undefined
190: ): AiInsightMessagePayload[] => {
191:   if (!history || !history.length) {
192:     return [];
193:   }
194:   return history
195:     .slice(-6)
196:     .map((message) => ({
197:       role: message.role,
198:       content: message.content.slice(0, 1600),
199:     }))
200:     .filter((message) => message.content.trim().length > 0);
201: };
202: const runInsightHeuristics = (input: AiInsightRequest): AiInsightResult => {
203:   const question = input.prompt.trim();
204:   const snippet = limitTextToWords(input.context, 160);
205:   const hasContext = snippet.length > 0;
206:   const reasonLine = hasContext
207:     ? "I'm falling back to a heuristic summary because the AI providers couldn't return a full answer just now."
208:     : "Your paper text hasn't finished processing yet, so I'm sharing heuristic guidance while we wait for the full content.";
209:   const analysisLines = [
210:     reasonLine,
211:     hasContext ? `Key excerpt considered: ${snippet}` : undefined,
212:     question ? `What you're asking: ${question}` : undefined,
213:   ]
214:     .filter(Boolean)
215:     .join("\n\n");
216:   const suggestions = [
217:     "Highlight the specific evidence or data points supporting the claimed findings.",
218:     "Compare these insights with related work to validate novelty or limitations.",
219:     "Outline next experiments or questions that would strengthen the argument.",
220:   ];
221:   return {
222:     provider: "heuristic",
223:     message: {
224:       role: "assistant",
225:       content:
226:         analysisLines.length > 0
227:           ? `${analysisLines}\n\nConsider diving deeper into methodology, assumptions, and potential applications for more targeted insights. You can re-run this insight once the document has finished processing or try again in a moment.`
228:           : "I can help more once additional context is available from the document processing pipeline.",
229:     },
230:     suggestions,
231:   };
232: };
233: export const aiService = {
234:   getProviderStatuses(): ProviderStatus[] {
235:     return ["gemini", "openai"].map((provider) => {
236:       const instance = providers[provider as ProviderName];
237:       return {
238:         provider: provider as ProviderName,
239:         configured: Boolean(instance?.isEnabled()),
240:       };
241:     });
242:   },
243:   async extractMetadata(
244:     input: AiMetadataExtractionInput
245:   ): Promise<AiMetadataExtractionResult> {
246:     if (!config.ai.featuresEnabled) {
247:       return {
248:         provider: "heuristic",
249:         metadata: runHeuristics(input),
250:       };
251:     }
252:     const providerInstances = getProviderInstances();
253:     const errors: string[] = [];
254:     for (const provider of providerInstances) {
255:       if (!provider.isEnabled()) {
256:         continue;
257:       }
258:       try {
259:         const result = await provider.extractMetadata(input);
260:         if (result && result.metadata) {
261:           return result;
262:         }
263:       } catch (error) {
264:         errors.push(
265:           error instanceof Error ? error.message : String(error ?? "Unknown")
266:         );
267:       }
268:     }
269:     return {
270:       provider: "heuristic",
271:       metadata: runHeuristics(input),
272:       rawResponse: { errors },
273:     };
274:   },
275:   async extractAndPersistMetadata(options: MetadataPersistOptions) {
276:     const {
277:       paperId,
278:       text,
279:       originalTitle,
280:       existingMetadata,
281:       currentTitle,
282:       currentAbstract,
283:     } = options;
284:     if (!config.ai.featuresEnabled) {
285:       return { applied: false, provider: "heuristic" };
286:     }
287:     const extractionResult = await this.extractMetadata({
288:       text,
289:       originalTitle,
290:       existingMetadata,
291:       workspaceId: options.workspaceId,
292:       uploaderId: options.uploaderId,
293:       timeoutMs: config.ai.requestTimeoutMs,
294:     });
295:     const metadata = extractionResult.metadata;
296:     if (!metadata) {
297:       return { applied: false, provider: extractionResult.provider };
298:     }
299:     const combinedMetadata = {
300:       ...(existingMetadata || {}),
301:       ...metadata,
302:       aiProvider: extractionResult.provider,
303:       aiUpdatedAt: new Date().toISOString(),
304:     };
305:     const shouldUpdateTitle =
306:       Boolean(metadata.title) && shouldReplaceValue(currentTitle);
307:     const shouldUpdateAbstract =
308:       Boolean(metadata.abstract) && shouldReplaceValue(currentAbstract);
309:     const nextTitle = shouldUpdateTitle ? metadata.title : currentTitle;
310:     const nextAbstract = shouldUpdateAbstract
311:       ? metadata.abstract
312:       : currentAbstract;
313:     const combinedMetadataJson = JSON.stringify(combinedMetadata);
314:     const existingMetadataJson = JSON.stringify(existingMetadata || {});
315:     if (
316:       nextTitle === currentTitle &&
317:       nextAbstract === currentAbstract &&
318:       combinedMetadataJson === existingMetadataJson
319:     ) {
320:       return {
321:         applied: false,
322:         provider: extractionResult.provider,
323:         metadata,
324:       };
325:     }
326:     await prisma.$executeRaw`
327:       UPDATE "Paper"
328:       SET title = ${nextTitle},
329:           abstract = ${nextAbstract},
330:           metadata = ${combinedMetadataJson}::jsonb,
331:           "updatedAt" = NOW()
332:       WHERE id = ${paperId}
333:     `;
334:     return {
335:       applied: true,
336:       provider: extractionResult.provider,
337:       metadata,
338:     };
339:   },
340:   async generateSummary(request: AiSummaryRequest): Promise<AiSummaryResult> {
341:     const normalizedInput = normalizeSummaryInput(request);
342:     if (!normalizedInput.text) {
343:       return {
344:         provider: "heuristic",
345:         summary:
346:           "We don't have extracted text for this paper yet. Please process the document or upload the full content to generate a summary.",
347:         highlights: undefined,
348:         followUpQuestions: [
349:           "Can you run the document processing step to extract text?",
350:           "Is there a specific section of the paper you'd like summarised once text is available?",
351:         ],
352:         rawResponse: { heuristic: true, reason: "NO_TEXT_AVAILABLE" },
353:       };
354:     }
355:     const heuristicResult = runSummaryHeuristics(normalizedInput);
356:     if (!config.ai.featuresEnabled) {
357:       return heuristicResult;
358:     }
359:     const cacheKey = normalizedInput.instructions || "default";
360:     const cacheParams = buildSummaryCacheParams(normalizedInput);
361:     const cached = await aiSummaryCache.get(
362:       normalizedInput.paperId,
363:       cacheKey,
364:       cacheParams
365:     );
366:     if (cached) {
367:       return {
368:         ...cached,
369:         cached: true,
370:       };
371:     }
372:     const providerInstances = getProviderInstances();
373:     const errors: string[] = [];
374:     for (const provider of providerInstances) {
375:       if (!provider.isEnabled()) {
376:         continue;
377:       }
378:       const startTime = Date.now();
379:       try {
380:         const result = await provider.generateSummary(normalizedInput);
381:         if (result && result.summary) {
382:           const normalizedSummary = limitTextToWords(
383:             result.summary,
384:             normalizedInput.wordLimit ?? DEFAULT_SUMMARY_WORD_LIMIT
385:           );
386:           const normalizedHighlights = result.highlights
387:             ?.map((highlight) => truncateSentence(highlight, 220))
388:             .filter((highlight) => Boolean(highlight));
389:           const normalizedFollowUps = result.followUpQuestions
390:             ?.map((question) => truncateSentence(question, 180))
391:             .filter((question) => Boolean(question));
392:           const payload: AiSummaryResult = {
393:             provider: result.provider,
394:             summary: normalizedSummary,
395:             highlights:
396:               normalizedHighlights && normalizedHighlights.length
397:                 ? normalizedHighlights
398:                 : undefined,
399:             followUpQuestions:
400:               normalizedFollowUps && normalizedFollowUps.length
401:                 ? normalizedFollowUps
402:                 : undefined,
403:             rawResponse: result.rawResponse,
404:             tokensUsed: result.tokensUsed,
405:           };
406:           await aiSummaryCache.set(
407:             normalizedInput.paperId,
408:             cacheKey,
409:             {
410:               provider: payload.provider,
411:               summary: payload.summary,
412:               highlights: payload.highlights,
413:               followUpQuestions: payload.followUpQuestions,
414:               tokensUsed: payload.tokensUsed,
415:             },
416:             cacheParams
417:           );
418:           const durationMs = Date.now() - startTime;
419:           return {
420:             ...payload,
421:             cached: false,
422:             rawResponse: {
423:               provider: result.provider,
424:               durationMs,
425:               data: payload.rawResponse,
426:               tokensUsed: payload.tokensUsed,
427:             },
428:           };
429:         }
430:       } catch (error) {
431:         const message =
432:           error instanceof Error
433:             ? error.message
434:             : String(error ?? "Unknown error");
435:         errors.push(`${provider.name}: ${message}`);
436:       }
437:     }
438:     return {
439:       ...heuristicResult,
440:       rawResponse: {
441:         data: heuristicResult.rawResponse,
442:         errors,
443:       },
444:     };
445:   },
446:   async generateInsight(request: AiInsightRequest): Promise<AiInsightResult> {
447:     const sanitizedHistory = sanitizeInsightHistory(request.history);
448:     const normalizedRequest: AiInsightRequest = {
449:       ...request,
450:       prompt: request.prompt.trim(),
451:       context: request.context || "",
452:       history: sanitizedHistory,
453:     };
454:     const hasContext = normalizedRequest.context.trim().length > 0;
455:     const hasHistory = sanitizedHistory.length > 0;
456:     if (!hasContext && !hasHistory) {
457:       return runInsightHeuristics(normalizedRequest);
458:     }
459:     if (!config.ai.featuresEnabled) {
460:       return runInsightHeuristics(normalizedRequest);
461:     }
462:     const providerInstances = getProviderInstances();
463:     const errors: string[] = [];
464:     for (const provider of providerInstances) {
465:       if (
466:         !provider.isEnabled() ||
467:         typeof provider.generateInsights !== "function"
468:       ) {
469:         continue;
470:       }
471:       try {
472:         const result = await provider.generateInsights(normalizedRequest);
473:         if (result) {
474:           return result;
475:         }
476:       } catch (error) {
477:         const errorMsg =
478:           error instanceof Error ? error.message : String(error ?? "Unknown");
479:         errors.push(errorMsg);
480:       }
481:     }
482:     const fallback = runInsightHeuristics(normalizedRequest);
483:     return {
484:       ...fallback,
485:       rawResponse: { errors },
486:     };
487:   },
488:   async invalidateSummaryCache(paperId: string) {
489:     await aiSummaryCache.invalidate(paperId);
490:   },
491: };
492: const shouldReplaceValue = (currentValue?: string | null) => {
493:   if (!currentValue) {
494:     return true;
495:   }
496:   const normalized = currentValue.trim().toLowerCase();
497:   return ["untitled", "unknown", ""].includes(normalized);
498: };
