253:   const formatFileSize = (bytes: number) => {
254:     if (bytes === 0) return "0 Bytes";
255:     const k = 1024;
256:     const sizes = ["Bytes", "KB", "MB", "GB"];
257:     const i = Math.floor(Math.log(bytes) / Math.log(k));
258:     return `${parseFloat((bytes / Math.pow(k, i)).toFixed(2))} ${sizes[i]}`;
259:   };
260:   return (
