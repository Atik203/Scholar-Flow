 299:   static async addMember(
 300:     requestorId: string,
 301:     id: string,
 302:     payload: { userId?: string; email?: string; role?: string }
 303:   ) {
 304:     // Only Admin/TeamLead/Owner can add
 305:     const perm = await prisma.$queryRaw<any[]>`
 306:       SELECT m.role, w."ownerId"
 307:       FROM "WorkspaceMember" m JOIN "Workspace" w ON w.id = m."workspaceId"
 308:       WHERE m."userId" = ${requestorId} AND m."workspaceId" = ${id} AND m."isDeleted" = false AND w."isDeleted" = false
 309:     `;
 310:     const member = perm[0];
 311:     if (!member) throw new ApiError(403, "Not a member of this workspace");
 312:     const isManager =
 313:       ["OWNER", "MANAGER"].includes(member.role) ||
 314:       member.ownerId === requestorId;
 315:     if (!isManager) throw new ApiError(403, "Insufficient permissions");
 316:     // Only the actual owner may mint OWNER roles
 317:     const isOwner = member.role === "OWNER" || member.ownerId === requestorId;
 318:     const requestedRole = payload.role || "EDITOR";
 319:     if (requestedRole === "OWNER" && !isOwner) {
 320:       throw new ApiError(403, "Only the workspace owner can add members as OWNER");
 321:     }
 322:     let targetUserId = payload.userId as string | undefined;
 323:     if (!targetUserId && payload.email) {
 324:       const u = await prisma.$queryRaw<any[]>`
 325:         SELECT id FROM "User" WHERE email = ${payload.email} AND "isDeleted" = false LIMIT 1
 326:       `;
 327:       if (!u[0]) throw new ApiError(404, "User not found for the given email");
 328:       targetUserId = u[0].id;
 329:     }
 330:     if (!targetUserId) throw new ApiError(400, "userId or email is required");
 331:     // Upsert membership; if exists and soft-deleted, reactivate
 332:     await prisma.$executeRaw`
 333:       INSERT INTO "WorkspaceMember" (id, "workspaceId", "userId", role, "joinedAt", "createdAt", "updatedAt", "isDeleted")
 334:       VALUES (gen_random_uuid(), ${id}, ${targetUserId}, ${requestedRole}, now(), now(), now(), false)
 335:       ON CONFLICT ("workspaceId", "userId") DO UPDATE SET role = EXCLUDED.role, "isDeleted" = false, "updatedAt" = now()
 336:     `;
 337:     await prisma.activityLogEntry.create({
 338:       data: {
 339:         userId: requestorId,
 340:         workspaceId: id,
 341:         entity: "WorkspaceMember",
 342:         entityId: targetUserId,
 343:         action: "ADD_MEMBER",
 344:         severity: "INFO",
 345:       },
 346:     });
 347:     // Notify the added user (best-effort)
 348:     try {
 349:       await notificationService.createNotification({
 350:         userId: targetUserId,
 351:         type: "INVITE",
 352:         category: "WORKSPACE",
 353:         title: "Added to workspace",
 354:         message: "You were added to a workspace on ScholarFlow.",
 355:         actionUrl: `/dashboard/workspaces/${id}`,
 356:         actorId: requestorId,
 357:         resourceId: id,
 358:       });
 359:     } catch {
 360:       // notification failures never break the main flow
 361:     }
 362:     return { success: true };
 363:   }
