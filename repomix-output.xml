 562:   async getSummarySourceText(
 563:     paperId: string,
 564:     record: PaperSummaryRecord
 565:   ): Promise<{
 566:     text: string;
 567:     source: "chunks" | "content" | "abstract" | "metadata" | "empty";
 568:     chunkCount: number;
 569:   }> {
 570:     const chunks = await prisma.$queryRaw<Array<{ content: string }>>`
 571:       SELECT content
 572:       FROM "PaperChunk"
 573:       WHERE "paperId" = ${paperId} AND "isDeleted" = false
 574:       ORDER BY idx ASC
 575:       LIMIT 200
 576:     `;
 577:     const chunkText = chunks
 578:       .map((chunk) => chunk.content?.trim())
 579:       .filter((content): content is string => Boolean(content))
 580:       .join("\n\n");
 581:     if (chunkText) {
 582:       return {
 583:         text: truncateText(chunkText, MAX_SUMMARY_SOURCE_LENGTH),
 584:         source: "chunks",
 585:         chunkCount: chunks.length,
 586:       };
 587:     }
 588:     const contentText = htmlToPlainText(record.contentHtml);
 589:     if (contentText) {
 590:       return {
 591:         text: truncateText(contentText, MAX_SUMMARY_SOURCE_LENGTH),
 592:         source: "content",
 593:         chunkCount: chunks.length,
 594:       };
 595:     }
 596:     if (record.abstract) {
 597:       return {
 598:         text: truncateText(record.abstract, MAX_SUMMARY_SOURCE_LENGTH),
 599:         source: "abstract",
 600:         chunkCount: chunks.length,
 601:       };
 602:     }
 603:     const metadataAbstract = record.metadata?.abstract;
 604:     if (typeof metadataAbstract === "string" && metadataAbstract.trim()) {
 605:       return {
 606:         text: truncateText(metadataAbstract, MAX_SUMMARY_SOURCE_LENGTH),
 607:         source: "metadata",
 608:         chunkCount: chunks.length,
 609:       };
 610:     }
 611:     return {
 612:       text: "",
 613:       source: "empty",
 614:       chunkCount: chunks.length,
 615:     };
 616:   },
