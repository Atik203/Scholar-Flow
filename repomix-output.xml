 80:     const getTrendIcon = () => {
 81:       if (!trend || !showTrend) return null;
 82:       switch (trend) {
 83:         case "up":
 84:           return <TrendingUp className="h-4 w-4 text-success" />;
 85:         case "down":
 86:           return <TrendingDown className="h-4 w-4 text-destructive" />;
 87:         case "neutral":
