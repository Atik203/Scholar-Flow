  8: import { useGetPaperCitationsQuery } from "@/redux/api/citationApi";
  9: import { useListPapersQuery } from "@/redux/api/paperApi";
 10: import { motion } from "motion/react";
 11: import {
 12:   GitGraph,
 13:   Plus,
 14:   Search,
 15:   X,
 16:   Lock,
 17: } from "lucide-react";
 18: import { useEffect, useMemo, useState } from "react";
 19: import Link from "next/link";
 20: interface GraphNode {
 21:   id: string;
 22:   title: string;
 23:   x: number;
 24:   y: number;
 25: }
 26: function PaperCitationLines({
 27:   paperId,
 28:   nodesById,
 29:   onEdges,
 30:   onError,
 31: }: {
 32:   paperId: string;
 33:   nodesById: Record<string, GraphNode>;
 34:   onEdges: (count: number) => void;
 35:   onError: () => void;
 36: }) {
 37:   const { data: citations, isError } = useGetPaperCitationsQuery(paperId, {
 38:     skip: !paperId,
 39:   });
 40:   useEffect(() => {
 41:     if (citations && citations.length > 0) {
 42:       onEdges(citations.length);
 43:     }
 44:   }, [citations, onEdges]);
 45:   useEffect(() => {
 46:     if (isError) onError();
 47:   }, [isError, onError]);
 48:   const source = nodesById[paperId];
 49:   if (!source) return null;
 50:   return (
 51:     <>
 52:       {(citations || []).map((citation) => {
 53:         const target = nodesById[citation.targetPaper.id];
 54:         if (!target) return null;
 55:         return (
 56:           <g key={citation.id}>
 57:             <line
 58:               x1={source.x}
 59:               y1={source.y}
 60:               x2={target.x}
 61:               y2={target.y}
 62:               stroke="hsl(var(--primary) / 0.35)"
 63:               strokeWidth={2}
 64:               markerEnd="url(#arrow)"
 65:             />
 66:             <title>
 67:               {source.title} cites {citation.targetPaper.title}
 68:             </title>
 69:           </g>
 70:         );
 71:       })}
 72:     </>
 73:   );
 74: }
 75: export default function CitationGraphPage() {
 76:   const { user, isLoading: isAuthLoading } = useProtectedRoute();
 77:   const isProOrAbove = hasRoleAccess(user?.role, USER_ROLES.PRO_RESEARCHER);
 78:   const { data: papersData, isLoading } = useListPapersQuery({ limit: 100 });
 79:   const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());
 80:   const [search, setSearch] = useState("");
 81:   const [edgeCount, setEdgeCount] = useState(0);
 82:   const [errorCount, setErrorCount] = useState(0);
 83:   useEffect(() => {
 84:     setEdgeCount(0);
 85:     setErrorCount(0);
 86:   }, [selectedIds]);
 87:   const onEdges = useMemo(
 88:     () => (count: number) => setEdgeCount((prev) => prev + count),
 89:     []
 90:   );
 91:   const onCitationError = useMemo(
 92:     () => () => setErrorCount((prev) => prev + 1),
 93:     []
 94:   );
 95:   const papers = useMemo(() => {
 96:     if (!papersData?.items) return [];
 97:     return papersData.items.map((p) => ({
 98:       id: p.id,
 99:       title: p.title,
100:       authors: p.metadata?.authors?.join(", ") || "Unknown",
101:       year: p.metadata?.year || null,
102:     }));
103:   }, [papersData]);
104:   const filteredPapers = useMemo(
105:     () =>
106:       search
107:         ? papers.filter((p) =>
108:             p.title.toLowerCase().includes(search.toLowerCase())
109:           )
110:         : papers,
111:     [papers, search]
112:   );
113:   const nodes: GraphNode[] = useMemo(() => {
114:     const selected = papers.filter((p) => selectedIds.has(p.id));
115:     if (selected.length === 0) return [];
116:     const centerX = 380;
117:     const centerY = 280;
118:     const radius = Math.min(centerX, centerY) * 0.7;
119:     return selected.map((p, i) => {
120:       const angle = (2 * Math.PI * i) / selected.length - Math.PI / 2;
121:       return {
122:         id: p.id,
123:         title: p.title,
124:         x: centerX + radius * Math.cos(angle),
125:         y: centerY + radius * Math.sin(angle),
126:       };
127:     });
128:   }, [papers, selectedIds]);
129:   const nodesById = useMemo(() => {
130:     const map: Record<string, GraphNode> = {};
131:     nodes.forEach((n) => {
132:       map[n.id] = n;
133:     });
134:     return map;
135:   }, [nodes]);
136:   const toggleSelect = (id: string) => {
137:     setSelectedIds((prev) => {
138:       const next = new Set(prev);
139:       if (next.has(id)) {
140:         next.delete(id);
141:       } else {
142:         next.add(id);
143:       }
144:       return next;
145:     });
146:   };
