<file path="apps/frontend/src/components/pwa/ServiceWorkerRegistration.tsx">
 1: "use client";
 2: import { useEffect } from "react";
 3: export function ServiceWorkerRegistration() {
 4:   useEffect(() => {
 5:     if (
 6:       typeof window !== "undefined" &&
 7:       "serviceWorker" in navigator &&
 8:       process.env.NODE_ENV === "production"
 9:     ) {
10:       navigator.serviceWorker
11:         .register("/sw.js")
12:         .then((registration) => {
13:           console.log(
14:             "[PWA] Service Worker registered with scope:",
15:             registration.scope
16:           );
17:           setInterval(
18:             () => {
19:               registration.update();
20:             },
21:             60 * 60 * 1000
22:           );
23:         })
24:         .catch((error) => {
25:           console.error("[PWA] Service Worker registration failed:", error);
26:         });
27:       navigator.serviceWorker.addEventListener("controllerchange", () => {
28:         console.log("[PWA] Service Worker updated, reloading page...");
29:         window.location.reload();
30:       });
31:     }
32:   }, []);
33:   return null;
34: }
</file>

