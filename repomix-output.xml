 45:   className = "",
 46: }: PdfAnnotationViewerEnhancedProps) {
 47:   // PDF State
 48:   const [numPages, setNumPages] = useState<number>(0);
 49:   const [currentPage, setCurrentPage] = useState<number>(1);
 50:   const [scale, setScale] = useState<number>(1.2);
 51:   const [rotation, setRotation] = useState<number>(0);
 52:   // Annotation State
 53:   const [selectedText, setSelectedText] = useState<string>("");
 54:   const [selection, setSelection] = useState<AnnotationAnchor | null>(null);
 55:   const [isAnnotationPopupOpen, setIsAnnotationPopupOpen] = useState(false);
 56:   const [annotationType, setAnnotationType] =
 57:     useState<AnnotationType>("HIGHLIGHT");
 58:   const [showAnnotations, setShowAnnotations] = useState(true);
 59:   const [showAnnotationList, setShowAnnotationList] = useState(true);
 60:   const [isDrawingMode, setIsDrawingMode] = useState(false);
 61:   const [drawingPoints, setDrawingPoints] = useState<
 62:     Array<{ x: number; y: number }>
 63:   >([]);
 64:   const [editingAnnotation, setEditingAnnotation] = useState<Annotation | null>(
 65:     null
 66:   );
 67:   const pageRef = useRef<HTMLDivElement>(null);
 68:   const canvasRef = useRef<HTMLCanvasElement>(null);
 69:   const { data: annotationsData, isLoading: annotationsLoading } =
 70:     useGetPaperAnnotationsQuery({
 71:       paperId,
 72:       includeReplies: true,
 73:     });
 74:   const [createAnnotation, { isLoading: isCreatingAnnotation }] =
 75:     useCreateAnnotationMutation();
 76:   const [updateAnnotation] = useUpdateAnnotationMutation();
 77:   const [deleteAnnotation] = useDeleteAnnotationMutation();
 78:   const annotations = annotationsData?.data || [];
 79:   const currentPageAnnotations = annotations.filter(
 80:     (annotation) => annotation.anchor.page === currentPage
 81:   );
 82:   const onDocumentLoadSuccess = useCallback(
 83:     ({ numPages }: { numPages: number }) => {
 84:       setNumPages(numPages);
 85:     },
 86:     []
 87:   );
 88:   const pageToViewport = useCallback(
 89:     (x: number, y: number, pageWidth: number, pageHeight: number) => {
 90:       const currentScale = scale;
 91:       const currentRotation = rotation;
 92:       let viewportX = x;
 93:       let viewportY = y;
 94:       if (currentRotation === 90) {
 95:         viewportX = y;
 96:         viewportY = pageHeight - x;
 97:       } else if (currentRotation === 180) {
 98:         viewportX = pageWidth - x;
 99:         viewportY = pageHeight - y;
100:       } else if (currentRotation === 270) {
101:         viewportX = pageWidth - y;
102:         viewportY = x;
103:       }
104:       return {
105:         x: viewportX * currentScale,
106:         y: viewportY * currentScale,
107:       };
108:     },
109:     [scale, rotation]
110:   );
111:   const viewportToPage = useCallback(
112:     (x: number, y: number, pageWidth: number, pageHeight: number) => {
113:       const currentScale = scale;
114:       const currentRotation = rotation;
115:       let pageX = x / currentScale;
116:       let pageY = y / currentScale;
117:       if (currentRotation === 90) {
118:         const temp = pageX;
119:         pageX = pageHeight - pageY;
120:         pageY = temp;
121:       } else if (currentRotation === 180) {
122:         pageX = pageWidth - pageX;
123:         pageY = pageHeight - pageY;
124:       } else if (currentRotation === 270) {
125:         const temp = pageX;
126:         pageX = pageY;
127:         pageY = pageWidth - temp;
128:       }
129:       return { x: pageX, y: pageY };
130:     },
131:     [scale, rotation]
132:   );
133:   const handleTextSelection = useCallback(() => {
134:     const windowSelection = window.getSelection();
135:     if (!windowSelection || !windowSelection.toString().trim()) return;
136:     const selectedText = windowSelection.toString().trim();
137:     const range = windowSelection.getRangeAt(0);
138:     const rect = range.getBoundingClientRect();
139:     const pageRect = pageRef.current?.getBoundingClientRect();
140:     if (!pageRect) return;
141:     const relativeX = rect.left - pageRect.left;
142:     const relativeY = rect.top - pageRect.top;
143:     const relativeWidth = rect.width;
144:     const relativeHeight = rect.height;
145:     const pageWidth = pageRect.width / scale;
146:     const pageHeight = pageRect.height / scale;
147:     const topLeft = viewportToPage(relativeX, relativeY, pageWidth, pageHeight);
148:     const bottomRight = viewportToPage(
149:       relativeX + relativeWidth,
150:       relativeY + relativeHeight,
151:       pageWidth,
152:       pageHeight
153:     );
154:     const anchor: AnnotationAnchor = {
155:       page: currentPage,
156:       coordinates: {
157:         x: topLeft.x,
158:         y: topLeft.y,
159:         width: bottomRight.x - topLeft.x,
160:         height: bottomRight.y - topLeft.y,
161:       },
162:       selectedText,
163:       viewport: {
164:         scale,
165:         rotation,
166:       },
167:     };
168:     setSelectedText(selectedText);
169:     setSelection(anchor);
170:     setIsAnnotationPopupOpen(true);
171:     windowSelection.removeAllRanges();
172:   }, [currentPage, scale, rotation, viewportToPage]);
173:   const handleAreaSelection = useCallback(
174:     (startX: number, startY: number, endX: number, endY: number) => {
175:       const pageRect = pageRef.current?.getBoundingClientRect();
176:       if (!pageRect) return;
177:       const pageWidth = pageRect.width / scale;
178:       const pageHeight = pageRect.height / scale;
179:       const topLeft = viewportToPage(
180:         Math.min(startX, endX),
181:         Math.min(startY, endY),
182:         pageWidth,
183:         pageHeight
184:       );
185:       const bottomRight = viewportToPage(
186:         Math.max(startX, endX),
187:         Math.max(startY, endY),
188:         pageWidth,
189:         pageHeight
190:       );
191:       const anchor: AnnotationAnchor = {
192:         page: currentPage,
193:         coordinates: {
194:           x: topLeft.x,
195:           y: topLeft.y,
196:           width: bottomRight.x - topLeft.x,
197:           height: bottomRight.y - topLeft.y,
198:         },
199:         selectedText: "Area Selection",
200:         viewport: {
201:           scale,
202:           rotation,
203:         },
204:       };
205:       setSelection(anchor);
206:       setIsAnnotationPopupOpen(true);
207:     },
208:     [currentPage, scale, rotation, viewportToPage]
209:   );
210:   const handleAnnotationCreate = useCallback(
211:     async (text: string) => {
212:       if (!selection) return;
213:       try {
214:         await createAnnotation({
215:           paperId,
216:           type: annotationType,
217:           anchor: selection,
218:           text: text.trim(),
219:         }).unwrap();
220:         showSuccessToast(`${annotationType} annotation created successfully`);
221:         setIsAnnotationPopupOpen(false);
222:         setSelection(null);
223:         setSelectedText("");
224:         setDrawingPoints([]);
225:       } catch (error: any) {
226:         showErrorToast(error.data?.message || "Failed to create annotation");
227:       }
228:     },
229:     [selection, annotationType, paperId, createAnnotation]
230:   );
231:   const handleAnnotationUpdate = useCallback(
232:     async (annotationId: string, text: string, anchor?: AnnotationAnchor) => {
233:       try {
234:         await updateAnnotation({
235:           id: annotationId,
236:           data: { text, anchor },
237:         }).unwrap();
238:         showSuccessToast("Annotation updated successfully");
239:         setEditingAnnotation(null);
240:       } catch (error: any) {
241:         showErrorToast(error.data?.message || "Failed to update annotation");
242:       }
243:     },
244:     [updateAnnotation]
245:   );
246:   const handleAnnotationDelete = useCallback(
247:     async (annotationId: string) => {
248:       try {
249:         await deleteAnnotation(annotationId).unwrap();
250:         showSuccessToast("Annotation deleted successfully");
251:       } catch (error: any) {
252:         showErrorToast(error.data?.message || "Failed to delete annotation");
253:       }
254:     },
255:     [deleteAnnotation]
256:   );
257:   const handleAnnotationCancel = useCallback(() => {
258:     setIsAnnotationPopupOpen(false);
259:     setSelection(null);
260:     setSelectedText("");
261:     setDrawingPoints([]);
262:   }, []);
263:   // Navigation
264:   const goToPreviousPage = useCallback(() => {
265:     setCurrentPage((prev) => Math.max(1, prev - 1));
266:   }, []);
267:   const goToNextPage = useCallback(() => {
268:     setCurrentPage((prev) => Math.min(numPages, prev + 1));
269:   }, [numPages]);
270:   // Zoom controls
271:   const zoomIn = useCallback(() => {
272:     setScale((prev) => Math.min(3.0, prev + 0.2));
273:   }, []);
274:   const zoomOut = useCallback(() => {
275:     setScale((prev) => Math.max(0.5, prev - 0.2));
276:   }, []);
277:   const resetZoom = useCallback(() => {
278:     setScale(1.2);
279:   }, []);
280:   const rotate = useCallback(() => {
281:     setRotation((prev) => (prev + 90) % 360);
282:   }, []);
283:   // Keyboard shortcuts
284:   useEffect(() => {
285:     const handleKeyPress = (e: KeyboardEvent) => {
286:       // Cmd/Ctrl + H for Highlight
287:       if ((e.metaKey || e.ctrlKey) && e.key === "h") {
288:         e.preventDefault();
289:         setAnnotationType("HIGHLIGHT");
290:       }
291:       if ((e.metaKey || e.ctrlKey) && e.key === "u") {
292:         e.preventDefault();
293:         setAnnotationType("UNDERLINE");
294:       }
295:       if ((e.metaKey || e.ctrlKey) && e.key === "m") {
296:         e.preventDefault();
297:         setAnnotationType("COMMENT");
298:       }
299:       if ((e.metaKey || e.ctrlKey) && e.key === "n") {
300:         e.preventDefault();
301:         setAnnotationType("NOTE");
302:       }
303:     };
304:     window.addEventListener("keydown", handleKeyPress);
305:     return () => window.removeEventListener("keydown", handleKeyPress);
306:   }, []);
307:   return (
308:     <div className={`flex h-full bg-gray-50 ${className}`}>
309:       {}
310:       <div className="flex-1 flex flex-col">
311:         {}
312:         <div className="flex items-center justify-between p-3 border-b bg-white shadow-sm">
313:           <div className="flex items-center gap-2">
314:             <Button
315:               variant="outline"
316:               size="sm"
317:               onClick={goToPreviousPage}
318:               disabled={currentPage <= 1}
319:             >
320:               <ChevronLeft className="h-4 w-4" />
321:             </Button>
322:             <span className="text-sm font-medium min-w-[80px] text-center">
323:               Page {currentPage} / {numPages}
324:             </span>
325:             <Button
326:               variant="outline"
327:               size="sm"
328:               onClick={goToNextPage}
329:               disabled={currentPage >= numPages}
330:             >
331:               <ChevronRight className="h-4 w-4" />
332:             </Button>
333:           </div>
334:           <div className="flex items-center gap-2">
335:             <Button variant="outline" size="sm" onClick={zoomOut}>
336:               <ZoomOut className="h-4 w-4" />
337:             </Button>
338:             <span className="text-sm font-medium min-w-[60px] text-center">
339:               {Math.round(scale * 100)}%
340:             </span>
341:             <Button variant="outline" size="sm" onClick={zoomIn}>
342:               <ZoomIn className="h-4 w-4" />
343:             </Button>
344:             <Button
345:               variant="outline"
346:               size="sm"
347:               onClick={resetZoom}
348:               title="Reset Zoom"
349:             >
350:               <Maximize2 className="h-4 w-4" />
351:             </Button>
352:             <Button variant="outline" size="sm" onClick={rotate} title="Rotate">
353:               <RotateCcw className="h-4 w-4" />
354:             </Button>
355:           </div>
356:           <div className="flex items-center gap-2">
357:             <Badge variant="outline" className="text-xs">
358:               {currentPageAnnotations.length} annotations
359:             </Badge>
360:             <Button
361:               variant={showAnnotationList ? "default" : "outline"}
362:               size="sm"
363:               onClick={() => setShowAnnotationList(!showAnnotationList)}
364:             >
365:               {showAnnotationList ? "Hide" : "Show"} List
366:             </Button>
367:           </div>
368:         </div>
369:         {}
370:         <div className="flex-1 overflow-auto bg-muted/30 p-6">
371:           <div className="flex justify-center">
372:             <div
373:               ref={pageRef}
374:               className="relative bg-background shadow-2xl"
375:               onMouseUp={handleTextSelection}
376:             >
377:               <Document
378:                 file={fileUrl}
379:                 onLoadSuccess={onDocumentLoadSuccess}
380:                 loading={
381:                   <div className="flex items-center justify-center h-96">
382:                     <div className="text-center">
383:                       <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto mb-2"></div>
384:                       <p className="text-sm text-muted-foreground">
385:                         Loading PDF...
386:                       </p>
387:                     </div>
388:                   </div>
389:                 }
390:                 error={
391:                   <div className="flex items-center justify-center h-96">
392:                     <div className="text-center">
393:                       <p className="text-sm text-destructive font-medium">
394:                         Failed to load PDF
395:                       </p>
396:                       <p className="text-xs text-muted-foreground mt-1">
397:                         Please try refreshing the page
398:                       </p>
399:                     </div>
400:                   </div>
401:                 }
402:               >
403:                 <Page
404:                   pageNumber={currentPage}
405:                   scale={scale}
406:                   rotate={rotation}
407:                   className="shadow-lg"
408:                   renderTextLayer={true}
409:                   renderAnnotationLayer={false}
410:                 />
411:               </Document>
412:               {}
413:               {showAnnotations && (
414:                 <AnnotationLayerEnhanced
415:                   annotations={currentPageAnnotations}
416:                   scale={scale}
417:                   rotation={rotation}
418:                   pageToViewport={pageToViewport}
419:                   onAnnotationClick={(annotation: Annotation) => {
420:                     setEditingAnnotation(annotation);
421:                   }}
422:                   onAnnotationEdit={(annotation: Annotation) => {
423:                     setEditingAnnotation(annotation);
424:                   }}
425:                   onAnnotationDelete={handleAnnotationDelete}
426:                 />
427:               )}
428:             </div>
429:           </div>
430:         </div>
431:         {}
432:         <AnnotationToolbar
433:           onAnnotationTypeChange={setAnnotationType}
434:           selectedType={annotationType}
435:           onToggleAnnotations={() => setShowAnnotations(!showAnnotations)}
436:           showAnnotations={showAnnotations}
437:         />
438:       </div>
439:       {}
440:       {showAnnotationList && (
441:         <div className="w-80 border-l bg-card shadow-lg">
442:           <AnnotationList
443:             annotations={annotations}
444:             currentPage={currentPage}
445:             onAnnotationClick={(annotation: Annotation) => {
446:               setCurrentPage(annotation.anchor.page);
447:             }}
448:             onAnnotationEdit={(annotation: Annotation) => {
449:               setEditingAnnotation(annotation);
450:             }}
451:             onAnnotationDelete={(annotation: Annotation) =>
452:               handleAnnotationDelete(annotation.id)
453:             }
454:           />
455:         </div>
456:       )}
457:       {}
458:       {isAnnotationPopupOpen && selection && (
459:         <AnnotationPopup
460:           selectedText={selectedText}
461:           annotationType={annotationType}
462:           onSave={handleAnnotationCreate}
463:           onCancel={handleAnnotationCancel}
464:         />
465:       )}
466:       {}
467:       {editingAnnotation && (
468:         <AnnotationEditDialog
469:           annotation={editingAnnotation}
470:           onSave={(text: string, anchor?: AnnotationAnchor) =>
471:             handleAnnotationUpdate(editingAnnotation.id, text, anchor)
472:           }
473:           onCancel={() => setEditingAnnotation(null)}
474:           onDelete={() => {
475:             handleAnnotationDelete(editingAnnotation.id);
476:             setEditingAnnotation(null);
477:           }}
478:         />
479:       )}
480:     </div>
481:   );
482: }
</file>

<file path="apps/frontend/src/components/auth/RoleBadge.tsx">
