107:       Bucket: this.bucket,
108:       Key: key,
109:     };
110:     const command = new GetObjectCommand(getObjectInput);
111:     const result = await this.s3.send(command);
112:     const chunks: Buffer[] = [];
113:     const stream = result.Body as NodeJS.ReadableStream;
114:     return new Promise((resolve, reject) => {
115:       stream.on("data", (chunk: Buffer) => chunks.push(chunk));
116:       stream.on("error", reject);
117:       stream.on("end", () => resolve(Buffer.concat(chunks)));
118:     });
119:   }
