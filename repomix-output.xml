  9:   | "SYSTEM"
 10:   | "ACHIEVEMENT";
 11: export interface NotificationActor {
 12:   name: string;
 13:   image?: string;
 14:   firstName?: string;
 15:   lastName?: string;
 16: }
 17: export interface AppNotification {
 18:   id: string;
 19:   userId: string;
 20:   type: NotificationType;
 21:   title: string;
 22:   message: string;
 23:   read: boolean;
 24:   starred: boolean;
 25:   actionUrl?: string;
 26:   actorId?: string;
 27:   resourceId?: string;
 28:   createdAt: string;
 29:   actor?: NotificationActor;
 30: }
 31: export interface GetNotificationsResponse {
 32:   success: boolean;
 33:   message: string;
 34:   data: AppNotification[];
 35:   meta: {
 36:     page: number;
 37:     limit: number;
 38:     total: number;
 39:     totalPage: number;
 40:     skip: number;
 41:   };
 42: }
 43: export interface GetUnreadCountResponse {
 44:   success: boolean;
 45:   message: string;
 46:   data: { count: number };
 47: }
 48: export interface BaseNotificationResponse {
 49:   success: boolean;
 50:   message: string;
 51:   data: AppNotification;
 52: }
 53: export const notificationApi = apiSlice
 54:   .enhanceEndpoints({ addTagTypes: ["Notification"] })
 55:   .injectEndpoints({
 56:     endpoints: (builder) => ({
 57:       getNotifications: builder.query<
 58:         GetNotificationsResponse,
 59:         { page?: number; limit?: number; type?: string; read?: string; starred?: string }
 60:       >({
 61:         query: (params) => ({
 62:           url: "/notifications",
 63:           params,
 64:         }),
 65:         providesTags: (result) =>
 66:           result?.data
 67:             ? [
 68:                 ...result.data.map(({ id }) => ({ type: "Notification" as const, id })),
 69:                 { type: "Notification", id: "LIST" },
 70:               ]
 71:             : [{ type: "Notification", id: "LIST" }],
 72:       }),
 73:       getUnreadCount: builder.query<GetUnreadCountResponse, void>({
 74:         query: () => "/notifications/unread-count",
 75:         providesTags: [{ type: "Notification", id: "UNREAD_COUNT" }],
 76:       }),
 77:       markAsRead: builder.mutation<BaseNotificationResponse, string>({
 78:         query: (id) => ({
 79:           url: `/notifications/${id}/read`,
 80:           method: "PUT",
 81:         }),
 82:         invalidatesTags: (result, error, id) => [
 83:           { type: "Notification", id },
 84:           { type: "Notification", id: "UNREAD_COUNT" },
 85:         ],
 86:       }),
 87:       markAllAsRead: builder.mutation<{ success: boolean; message: string }, void>({
 88:         query: () => ({
 89:           url: "/notifications/read-all",
 90:           method: "PUT",
 91:         }),
 92:         invalidatesTags: ["Notification"],
 93:       }),
 94:       toggleStarred: builder.mutation<BaseNotificationResponse, string>({
 95:         query: (id) => ({
 96:           url: `/notifications/${id}/star`,
 97:           method: "PUT",
 98:         }),
 99:         invalidatesTags: (result, error, id) => [
100:           { type: "Notification", id },
101:         ],
102:       }),
103:       deleteNotification: builder.mutation<{ success: boolean; message: string }, string>({
104:         query: (id) => ({
105:           url: `/notifications/${id}`,
106:           method: "DELETE",
107:         }),
108:         invalidatesTags: (result, error, id) => [
109:           { type: "Notification", id },
110:           { type: "Notification", id: "LIST" },
111:           { type: "Notification", id: "UNREAD_COUNT" },
112:         ],
113:       }),
114:       deleteBulkNotifications: builder.mutation<{ success: boolean; message: string }, string[]>({
115:         query: (ids) => ({
