 557:     const diffMins = Math.floor(diffMs / (1000 * 60));
 558:     const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
 559:     const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
 560:     if (diffMins < 1) return "Just now";
 561:     if (diffMins < 60) return `${diffMins}m ago`;
 562:     if (diffHours < 24) return `${diffHours}h ago`;
 563:     if (diffDays < 7) return `${diffDays}d ago`;
 564:     return then.toLocaleDateString();
 565:   };
