<file path="apps/frontend/src/components/auth/ProtectedRoute.tsx">
 1: "use client";
 2: import { showAccessDeniedToast } from "@/components/providers/ToastProvider";
 3: import { hasPermission, hasRoleAccess } from "@/lib/auth/roles";
 4: import { useAuth } from "@/redux/auth/useAuth";
 5: import { ReactNode } from "react";
 6: interface ProtectedRouteProps {
 7:   children: ReactNode;
 8:   requiredRole?: string;
 9:   requiredPermission?: string;
10:   fallback?: ReactNode;
11:   showToast?: boolean;
12: }
13: export function ProtectedRoute({
14:   children,
15:   requiredRole,
16:   requiredPermission,
17:   fallback,
18:   showToast = true,
19: }: ProtectedRouteProps) {
20:   const { user, isAuthenticated } = useAuth();
21:   if (!isAuthenticated || !user) {
22:     return fallback || null;
23:   }
24:   if (requiredRole && !hasRoleAccess(user.role, requiredRole)) {
25:     if (showToast) {
26:       showAccessDeniedToast(requiredRole);
27:     }
28:     return fallback || null;
29:   }
30:   if (requiredPermission && !hasPermission(user.role, requiredPermission)) {
31:     if (showToast) {
32:       showAccessDeniedToast(`permission: ${requiredPermission}`);
33:     }
34:     return fallback || null;
35:   }
36:   return <>{children}</>;
37: }
38: interface RoleGateProps {
39:   children: ReactNode;
40:   allowedRoles: string[];
41:   fallback?: ReactNode;
42:   showToast?: boolean;
43: }
44: export function RoleGate({
45:   children,
46:   allowedRoles,
47:   fallback,
48:   showToast = false,
49: }: RoleGateProps) {
50:   const { user, isAuthenticated } = useAuth();
51:   const hasAccess =
52:     isAuthenticated &&
53:     user &&
54:     allowedRoles.some((role) => hasRoleAccess(user.role, role));
55:   if (!hasAccess) {
56:     if (showToast && allowedRoles.length > 0) {
57:       showAccessDeniedToast(allowedRoles[0]);
58:     }
59:     return fallback || null;
60:   }
61:   return <>{children}</>;
62: }
63: interface PermissionGateProps {
64:   children: ReactNode;
65:   requiredPermissions: string[];
66:   requireAll?: boolean;
67:   fallback?: ReactNode;
68:   showToast?: boolean;
69: }
70: export function PermissionGate({
71:   children,
72:   requiredPermissions,
73:   requireAll = false,
74:   fallback,
75:   showToast = false,
76: }: PermissionGateProps) {
77:   const { user, isAuthenticated } = useAuth();
78:   if (!isAuthenticated || !user) {
79:     return fallback || null;
80:   }
81:   const hasAccess = requireAll
82:     ? requiredPermissions.every((permission) =>
83:         hasPermission(user.role, permission)
84:       )
85:     : requiredPermissions.some((permission) =>
86:         hasPermission(user.role, permission)
87:       );
88:   if (!hasAccess) {
89:     if (showToast) {
90:       showAccessDeniedToast(`permissions: ${requiredPermissions.join(", ")}`);
91:     }
92:     return fallback || null;
93:   }
94:   return <>{children}</>;
95: }
</file>

