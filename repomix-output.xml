  1: "use client";
  2: import {
  3:   showErrorToast,
  4:   showSuccessToast,
  5: } from "@/components/providers/ToastProvider";
  6: import { Badge } from "@/components/ui/badge";
  7: import { Button } from "@/components/ui/button";
  8: import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
  9: import {
 10:   DropdownMenu,
 11:   DropdownMenuContent,
 12:   DropdownMenuItem,
 13:   DropdownMenuSeparator,
 14:   DropdownMenuTrigger,
 15: } from "@/components/ui/dropdown-menu";
 16: import { Input } from "@/components/ui/input";
 17: import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs";
 18: import {
 19:   useDeletePaperMutation,
 20:   useListEditorPapersQuery,
 21: } from "@/redux/api/paperApi";
 22: import { useAuth } from "@/redux/auth/useAuth";
 23: import { formatDistanceToNow } from "date-fns";
 24: import {
 25:   Clock,
 26:   Edit,
 27:   FileText,
 28:   MoreVertical,
 29:   Search,
 30:   Trash2,
 31: } from "lucide-react";
 32: import { useEffect, useState } from "react";
 33: interface PapersListProps {
 34:   onPaperSelect: (paperId: string) => void;
 35: }
 36: export function PapersList({ onPaperSelect }: PapersListProps) {
 37:   const { session, status } = useAuth();
 38:   const [searchQuery, setSearchQuery] = useState("");
 39:   const [activeFilter, setActiveFilter] = useState<
 40:     "all" | "drafts" | "published"
 41:   >("all");
 42:   const getFilterParams = () => {
 43:     const params: { workspaceId?: string; isDraft?: boolean } = {};
 44:     if (activeFilter === "drafts") {
 45:       params.isDraft = true;
 46:     } else if (activeFilter === "published") {
 47:       params.isDraft = false;
 48:     }
 49:     return params;
 50:   };
 51:   const {
 52:     data: papersResponse,
 53:     isLoading,
 54:     error,
 55:     refetch,
 56:   } = useListEditorPapersQuery(getFilterParams(), {
 57:     skip: status === "loading" || !session,
 58:   });
 59:   const [deletePaper] = useDeletePaperMutation();
 60:   const papers = papersResponse?.data || [];
 61:   useEffect(() => {
 62:     if (session && refetch) {
 63:       refetch();
 64:     }
 65:   }, [activeFilter, session, refetch]);
 66:   const handleDelete = async (paperId: string) => {
 67:     if (!confirm("Are you sure you want to delete this paper?")) return;
 68:     try {
 69:       await deletePaper(paperId).unwrap();
 70:       showSuccessToast("Paper deleted successfully");
 71:       refetch();
 72:     } catch (error: any) {
 73:       console.error("Error deleting paper:", error);
 74:       showErrorToast(
 75:         "Failed to delete paper",
 76:         error?.data?.message || "Please try again later."
 77:       );
 78:     }
 79:   };
 80:   const filteredPapers = papers.filter((paper) => {
 81:     const matchesSearch = paper.title
 82:       .toLowerCase()
 83:       .includes(searchQuery.toLowerCase());
 84:     const matchesFilter =
 85:       activeFilter === "all" ||
 86:       (activeFilter === "drafts" && paper.isDraft) ||
 87:       (activeFilter === "published" && paper.isPublished);
 88:     return matchesSearch && matchesFilter;
 89:   });
 90:   if (status === "loading" || isLoading) {
 91:     return (
 92:       <div className="flex items-center justify-center py-8">
 93:         <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
 94:       </div>
 95:     );
 96:   }
 97:   if (!session) {
 98:     return (
 99:       <div className="flex items-center justify-center py-8">
100:         <p className="text-muted-foreground">
101:           Please sign in to view your papers.
102:         </p>
103:       </div>
104:     );
105:   }
106:   return (
107:     <div className="space-y-6">
108:       {}
109:       <div className="flex flex-col sm:flex-row gap-4">
110:         <div className="relative flex-1">
111:           <Search className="absolute left-3 top-3 h-4 w-4 text-muted-foreground" />
112:           <Input
113:             placeholder="Search papers..."
114:             value={searchQuery}
115:             onChange={(e) => setSearchQuery(e.target.value)}
116:             className="pl-9"
117:           />
118:         </div>
119:         <Tabs
120:           value={activeFilter}
121:           onValueChange={(value) => setActiveFilter(value as any)}
122:         >
123:           <TabsList>
124:             <TabsTrigger value="all">All</TabsTrigger>
125:             <TabsTrigger value="drafts">Drafts</TabsTrigger>
126:             <TabsTrigger value="published">Published</TabsTrigger>
127:           </TabsList>
128:         </Tabs>
129:       </div>
130:       {}
131:       {filteredPapers.length === 0 ? (
132:         <Card>
133:           <CardContent className="flex flex-col items-center justify-center py-12">
134:             <FileText className="h-12 w-12 text-muted-foreground mb-4" />
135:             <h3 className="text-lg font-semibold mb-2">No papers found</h3>
136:             <p className="text-muted-foreground text-center mb-4">
137:               {searchQuery
138:                 ? "No papers match your search criteria."
139:                 : "You haven't created any papers yet. Start by creating your first paper!"}
140:             </p>
141:           </CardContent>
142:         </Card>
143:       ) : (
144:         <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
145:           {filteredPapers.map((paper) => (
146:             <Card
147:               key={paper.id}
148:               className="hover:shadow-md transition-shadow cursor-pointer"
149:             >
150:               <CardHeader className="pb-3">
151:                 <div className="flex items-start justify-between">
152:                   <div className="flex-1 min-w-0">
153:                     <CardTitle
154:                       className="text-base line-clamp-2 hover:text-primary"
155:                       onClick={() => onPaperSelect(paper.id)}
156:                     >
157:                       {paper.title || "Untitled Paper"}
