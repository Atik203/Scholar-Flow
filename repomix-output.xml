<file path="apps/backend/src/app/modules/WebSocket/socketServer.ts">
  1: import { Server as HttpServer } from "http";
  2: import { Server, Socket } from "socket.io";
  3: import jwt from "jsonwebtoken";
  4: import prisma from "../../shared/prisma";
  5: interface AuthenticatedSocket extends Socket {
  6:   userId?: string;
  7:   userName?: string;
  8: }
  9: type RoomName = `workspace:${string}` | `paper:${string}` | `discussion:${string}`;
 10: const UUID_SOURCE = "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}";
 11: const ROOM_RE = new RegExp(
 12:   `^(paper|discussion|workspace):(${UUID_SOURCE})$`,
 13:   "i"
 14: );
 15: const guardRoom = (socket: Socket, room: unknown): room is string => {
 16:   if (typeof room === "string" && ROOM_RE.test(room) && socket.rooms.has(room)) {
 17:     return true;
 18:   }
 19:   socket.emit("room:error", {
 20:     room,
 21:     message: "Access denied: join the room first",
 22:   });
 23:   return false;
 24: };
 25: async function canAccessRoom(userId: string, room: string): Promise<boolean> {
 26:   const match = ROOM_RE.exec(room);
 27:   if (!match) return false;
 28:   const kind = match[1].toLowerCase();
 29:   const id = match[2];
 30:   switch (kind) {
 31:     case "workspace": {
 32:       const ws = await prisma.workspace.findFirst({
 33:         where: {
 34:           id,
 35:           isDeleted: false,
 36:           OR: [
 37:             { ownerId: userId },
 38:             { members: { some: { userId, isDeleted: false } } },
 39:           ],
 40:         },
 41:         select: { id: true },
 42:       });
 43:       return Boolean(ws);
 44:     }
 45:     case "paper": {
 46:       const paper = await prisma.paper.findFirst({
 47:         where: {
 48:           id,
 49:           isDeleted: false,
 50:           OR: [
 51:             { uploaderId: userId },
 52:             {
 53:               workspace: {
 54:                 isDeleted: false,
 55:                 OR: [
 56:                   { ownerId: userId },
 57:                   { members: { some: { userId, isDeleted: false } } },
 58:                 ],
 59:               },
 60:             },
 61:           ],
 62:         },
 63:         select: { id: true },
 64:       });
 65:       return Boolean(paper);
 66:     }
 67:     case "discussion": {
 68:       const thread = await prisma.discussionThread.findFirst({
 69:         where: { id, isDeleted: false },
 70:         select: { userId: true, paperId: true, collectionId: true, workspaceId: true },
 71:       });
 72:       if (!thread) return false;
 73:       if (thread.userId === userId) return true;
 74:       if (thread.paperId) return canAccessRoom(userId, `paper:${thread.paperId}`);
 75:       if (thread.collectionId) {
 76:         const col = await prisma.collection.findFirst({
 77:           where: {
 78:             id: thread.collectionId,
 79:             isDeleted: false,
 80:             OR: [
 81:               { ownerId: userId },
 82:               {
 83:                 members: {
 84:                   some: { userId, isDeleted: false, status: "ACCEPTED" },
 85:                 },
 86:               },
 87:             ],
 88:           },
 89:           select: { id: true },
 90:         });
 91:         return Boolean(col);
 92:       }
 93:       if (thread.workspaceId) {
 94:         return canAccessRoom(userId, `workspace:${thread.workspaceId}`);
 95:       }
 96:       return false;
 97:     }
 98:     default:
 99:       return false;
100:   }
101: }
102: const onlineUsers = new Map<string, Set<string>>();
103: export function setupWebSocket(server: HttpServer): Server {
104:   const io = new Server(server, {
105:     cors: {
106:       origin: process.env.FRONTEND_URL || "http://localhost:3000",
107:       methods: ["GET", "POST"],
108:       credentials: true,
109:     },
110:     pingTimeout: 60000,
111:     pingInterval: 25000,
112:   });
113:   io.use((socket: Socket, next) => {
114:     const token =
115:       socket.handshake.auth.token ||
116:       socket.handshake.headers.authorization?.replace("Bearer ", "");
117:     if (!token) {
118:       return next(new Error("Authentication required"));
119:     }
120:     const jwtSecret = process.env.NEXTAUTH_SECRET;
121:     if (!jwtSecret) {
122:       return next(new Error("JWT secret not configured"));
123:     }
124:     try {
125:       const decoded = jwt.verify(token, jwtSecret) as {
126:         sub?: string;
127:         id?: string;
128:         name?: string;
129:       };
130:       const userId = decoded.sub || decoded.id;
131:       if (!userId) {
132:         return next(new Error("Invalid token: missing user identifier"));
133:       }
134:       (socket as AuthenticatedSocket).userId = userId;
135:       (socket as AuthenticatedSocket).userName = decoded.name || "Unknown";
136:       next();
137:     } catch {
138:       next(new Error("Invalid or expired token"));
139:     }
140:   });
141:   io.on("connection", (socket: AuthenticatedSocket) => {
142:     const { userId, userName } = socket;
143:     if (!userId) {
144:       socket.disconnect(true);
145:       return;
146:     }
147:     if (!onlineUsers.has(userId)) {
148:       onlineUsers.set(userId, new Set());
149:     }
150:     onlineUsers.get(userId)!.add(socket.id);
151:     console.log(
152:       `[WS] ${userName} (${userId}) connected — ${socket.id}`
153:     );
154:     socket.broadcast.emit("presence:online", {
155:       userId,
156:       userName,
157:       timestamp: new Date().toISOString(),
158:     });
159:     socket.on("room:join", async (room: string) => {
160:       try {
161:         const allowed = await canAccessRoom(userId!, room);
162:         if (!allowed) {
163:           socket.emit("room:error", { room, message: "Access denied" });
164:           return;
165:         }
166:       } catch {
167:         socket.emit("room:error", { room, message: "Access denied" });
168:         return;
169:       }
170:       socket.join(room);
171:       const memberCount = io.sockets.adapter.rooms.get(room)?.size || 0;
172:       socket.emit("room:joined", { room, memberCount });
173:       socket.to(room).emit("presence:joined", {
174:         userId,
175:         userName,
176:         room,
177:         memberCount,
178:       });
179:     });
180:     socket.on("room:leave", (room: string) => {
181:       socket.leave(room);
182:       const memberCount = io.sockets.adapter.rooms.get(room)?.size || 0;
183:       socket.to(room).emit("presence:left", {
184:         userId,
185:         userName,
186:         room,
187:         memberCount,
188:       });
189:     });
190:     socket.on(
191:       "typing:start",
192:       ({ room, context }: { room: string; context?: string } = {} as { room: string; context?: string }) => {
193:         if (!guardRoom(socket, room)) return;
194:         socket.to(room).emit("typing:update", {
195:           userId,
196:           userName,
197:           room,
198:           isTyping: true,
199:           context,
200:         });
201:       }
202:     );
203:     socket.on("typing:stop", ({ room }: { room: string } = {} as { room: string }) => {
204:       if (!guardRoom(socket, room)) return;
205:       socket.to(room).emit("typing:update", {
206:         userId,
207:         userName,
208:         room,
209:         isTyping: false,
210:       });
211:     });
212:     socket.on(
213:       "editor:update",
214:       ({ room, update }: { room: string; update: Uint8Array } = {} as { room: string; update: Uint8Array }) => {
215:         if (!guardRoom(socket, room)) return;
216:         socket.to(room).emit("editor:update", { userId, update });
217:       }
218:     );
219:     socket.on(
220:       "editor:awareness",
221:       ({ room, state }: { room: string; state: any } = {} as { room: string; state: any }) => {
222:         if (!guardRoom(socket, room)) return;
223:         socket.to(room).emit("editor:awareness", {
224:           userId,
225:           userName,
226:           state,
227:         });
228:       }
229:     );
230:     socket.on("editor:sync-request", ({ room }: { room?: string } = {}) => {
231:       if (!guardRoom(socket, room)) return;
232:       socket.to(room).emit("editor:sync-request", { room });
233:     });
234:     socket.on(
235:       "editor:sync-response",
236:       ({ room, update }: { room: string; update: Uint8Array } = {} as { room: string; update: Uint8Array }) => {
237:         if (!guardRoom(socket, room)) return;
238:         socket.to(room).emit("editor:sync-response", { update });
239:       }
240:     );
241:     socket.on(
242:       "discussion:message",
243:       ({
244:         room,
245:         content,
246:         threadId,
247:       }: {
248:         room: string;
249:         content: string;
250:         threadId?: string;
251:       } = {} as { room: string; content: string; threadId?: string }) => {
252:         if (!guardRoom(socket, room)) return;
253:         if (typeof content !== "string" || !content.trim()) return;
254:         const message = {
255:           id: `${Date.now()}-${Math.random().toString(36).slice(2, 9)}`,
256:           userId,
257:           userName,
258:           content: content.slice(0, 5000),
259:           threadId,
260:           timestamp: new Date().toISOString(),
261:         };
262:         io.to(room).emit("discussion:message", message);
263:       }
264:     );
265:     socket.on("disconnect", () => {
266:       if (userId && onlineUsers.has(userId)) {
267:         onlineUsers.get(userId)!.delete(socket.id);
268:         if (onlineUsers.get(userId)!.size === 0) {
269:           onlineUsers.delete(userId);
270:         }
271:       }
272:       socket.broadcast.emit("presence:offline", {
273:         userId,
274:         userName,
275:         timestamp: new Date().toISOString(),
276:       });
277:       console.log(
278:         `[WS] ${userName} (${userId}) disconnected — ${socket.id}`
279:       );
280:     });
281:     socket.emit("auth:success", { userId, userName });
282:   });
283:   console.log("[WS] Socket.IO server initialized");
284:   return io;
285: }
286: export function getOnlineUsers(): Map<string, Set<string>> {
287:   return onlineUsers;
288: }
</file>

<file path="apps/backend/src/app/services/activityLog.service.ts">
  1: import prisma from "../shared/prisma";
  2: import ApiError from "../errors/ApiError";
  3: import { AuthRequest } from "../middleware/auth";
  4: export interface ActivityLogFilters {
  5:   userId?: string;
  6:   workspaceId?: string;
  7:   entity?: string;
  8:   entityId?: string;
  9:   action?: string;
 10:   severity?: 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL';
 11:   startDate?: Date;
 12:   endDate?: Date;
 13:   limit?: number;
 14:   offset?: number;
 15:   cursor?: string;
 16: }
 17: export interface ActivityLogEntry {
 18:   id: string;
 19:   userId?: string | null;
 20:   workspaceId?: string | null;
 21:   entity: string;
 22:   entityId: string;
 23:   action: string;
 24:   details?: any;
 25:   metadata?: any;
 26:   severity: 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL';
 27:   createdAt: Date;
 28:   user?: {
 29:     id: string;
 30:     name?: string | null;
 31:     firstName?: string | null;
 32:     lastName?: string | null;
 33:     image?: string | null;
 34:   } | null;
 35:   workspace?: {
 36:     id: string;
 37:     name: string;
 38:   } | null;
 39: }
 40: export class ActivityLogService {
 41:   static async logActivity(
 42:     userId: string | null,
 43:     workspaceId: string | null,
 44:     entity: string,
 45:     entityId: string,
 46:     action: string,
 47:     details?: any,
 48:     metadata?: any,
 49:     severity: 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL' = 'INFO'
 50:   ): Promise<void> {
 51:     try {
 52:       await prisma.activityLogEntry.create({
 53:         data: {
 54:           userId,
 55:           workspaceId,
 56:           entity,
 57:           entityId,
 58:           action,
 59:           details,
 60:           metadata,
 61:           severity
 62:         }
 63:       });
 64:     } catch (error) {
 65:       console.error('Failed to log activity:', error);
 66:     }
 67:   }
 68:   static async getActivityLog(
 69:     req: AuthRequest,
 70:     filters: ActivityLogFilters
 71:   ): Promise<{ entries: ActivityLogEntry[]; total: number }> {
 72:     const currentUserId = req.user?.id;
 73:     if (!currentUserId) {
 74:       throw new ApiError(401, 'User not authenticated');
 75:     }
 76:     try {
 77:       const where: any = {
 78:         isDeleted: false
 79:       };
 80:       if (filters.userId) {
 81:         if (filters.userId !== currentUserId) {
 82:           const requester = await prisma.user.findUnique({
 83:             where: { id: currentUserId },
 84:             select: { role: true },
 85:           });
 86:           if (requester?.role !== "ADMIN") {
 87:             throw new ApiError(403, "You can only view your own activity");
 88:           }
 89:         }
 90:         where.userId = filters.userId;
 91:       }
 92:       if (filters.workspaceId) {
 93:         where.workspaceId = filters.workspaceId;
 94:         const workspace = await prisma.workspace.findFirst({
 95:           where: {
 96:             id: filters.workspaceId,
 97:             isDeleted: false,
 98:             OR: [
 99:               { ownerId: currentUserId },
100:               {
101:                 members: {
102:                   some: {
103:                     userId: currentUserId,
104:                     isDeleted: false
105:                   }
106:                 }
107:               }
108:             ]
109:           }
110:         });
111:         if (!workspace) {
112:           throw new ApiError(404, 'Workspace not found or access denied');
113:         }
114:       }
115:       if (filters.entity) {
116:         where.entity = filters.entity;
117:       }
118:       if (filters.entityId) {
119:         where.entityId = filters.entityId;
120:       }
121:       if (filters.action) {
122:         where.action = filters.action;
123:       }
124:       if (filters.severity) {
125:         where.severity = filters.severity;
126:       }
127:       if (filters.startDate || filters.endDate) {
128:         where.createdAt = {};
129:         if (filters.startDate) {
130:           where.createdAt.gte = filters.startDate;
131:         }
132:         if (filters.endDate) {
133:           where.createdAt.lte = filters.endDate;
134:         }
135:       }
136:       if (!filters.workspaceId && !filters.userId) {
137:         const userWorkspaces = await prisma.workspace.findMany({
138:           where: {
139:             isDeleted: false,
140:             OR: [
141:               { ownerId: currentUserId },
142:               {
143:                 members: {
144:                   some: {
145:                     userId: currentUserId,
146:                     isDeleted: false
147:                   }
148:                 }
149:               }
150:             ]
151:           },
152:           select: { id: true }
153:         });
154:         const workspaceIds = userWorkspaces.map((w: any) => w.id);
155:         where.OR = [
156:           { workspaceId: { in: workspaceIds } },
157:           { userId: currentUserId }
158:         ];
159:       }
160:       const [entries, total] = await Promise.all([
161:         prisma.activityLogEntry.findMany({
162:           where,
163:           include: {
164:             user: {
165:               select: {
166:                 id: true,
167:                 name: true,
168:                 firstName: true,
169:                 lastName: true,
170:                 image: true
171:               }
172:             },
173:             workspace: {
174:               select: {
175:                 id: true,
176:                 name: true
177:               }
178:             }
179:           },
180:           orderBy: [
181:             { createdAt: 'desc' },
182:             { id: 'desc' },
183:           ],
184:           take: filters.limit || 50,
185:           ...(filters.cursor ? {
186:             cursor: { id: filters.cursor },
187:             skip: 1,
188:           } : filters.offset ? { skip: filters.offset } : {}),
189:         }),
190:         prisma.activityLogEntry.count({ where })
191:       ]);
192:       return { entries, total };
193:     } catch (error) {
194:       if (error instanceof ApiError) throw error;
195:       throw new ApiError(500, 'Failed to fetch activity log');
196:     }
197:   }
198:   static async getActivitySummary(
199:     req: AuthRequest,
200:     workspaceId?: string,
201:     days: number = 7
202:   ): Promise<{
203:     totalActivities: number;
204:     activitiesByType: { [key: string]: number };
205:     activitiesBySeverity: { [key: string]: number };
206:     recentActivities: ActivityLogEntry[];
207:     trends: { [key: string]: number };
208:   }> {
209:     const userId = req.user?.id;
210:     if (!userId) {
211:       throw new ApiError(401, 'User not authenticated');
212:     }
213:     const startDate = new Date();
214:     startDate.setDate(startDate.getDate() - days);
215:     try {
216:       const where: any = {
217:         isDeleted: false,
218:         createdAt: {
219:           gte: startDate
220:         }
221:       };
222:       if (workspaceId) {
223:         where.workspaceId = workspaceId;
224:         const workspace = await prisma.workspace.findFirst({
225:           where: {
226:             id: workspaceId,
227:             isDeleted: false,
228:             OR: [
229:               { ownerId: userId },
230:               {
231:                 members: {
232:                   some: {
233:                     userId: userId,
234:                     isDeleted: false
235:                   }
236:                 }
237:               }
238:             ]
239:           }
240:         });
241:         if (!workspace) {
242:           throw new ApiError(404, 'Workspace not found or access denied');
243:         }
244:       } else {
