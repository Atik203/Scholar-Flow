<file path="apps/frontend/src/app/auth/callback/magic-link/page.tsx">
 1: "use client";
 2: import { showAuthErrorToast, showAuthSuccessToast } from "@/components/providers/ToastProvider";
 3: import { setCredentials } from "@/redux/auth/authSlice";
 4: import { useAppDispatch } from "@/redux/hooks";
 5: import { Loader2 } from "lucide-react";
 6: import { useRouter, useSearchParams } from "next/navigation";
 7: import { useEffect, useRef } from "react";
 8: import type { TUser } from "@/types/user";
 9: const API_BASE_URL = process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:5000/api";
10: export default function MagicLinkCallbackPage() {
11:   const router = useRouter();
12:   const dispatch = useAppDispatch();
13:   const searchParams = useSearchParams();
14:   const hasProcessed = useRef(false);
15:   useEffect(() => {
16:     if (hasProcessed.current) return;
17:     hasProcessed.current = true;
18:     const token = searchParams.get("token");
19:     if (!token) {
20:       showAuthErrorToast("Invalid magic link");
21:       router.replace("/login");
22:       return;
23:     }
24:     const verifyMagicLink = async () => {
25:       try {
26:         const response = await fetch(`${API_BASE_URL}/auth/magic-link/verify`, {
27:           method: "POST",
28:           headers: { "Content-Type": "application/json" },
29:           body: JSON.stringify({ token }),
30:         });
31:         const data = await response.json();
32:         if (!response.ok || !data.success) {
33:           showAuthErrorToast(data.message || "Magic link expired or invalid");
34:           router.replace("/login");
35:           return;
36:         }
37:         if (data.data?.user && data.data?.accessToken) {
38:           const user = data.data.user as TUser;
39:           dispatch(setCredentials({
40:             user,
41:             accessToken: data.data.accessToken,
42:           }));
43:           showAuthSuccessToast("Signed in successfully!");
44:           const redirectTo = user.onboardingCompleted
45:             ? "/dashboard"
46:             : "/onboarding";
47:           router.replace(redirectTo);
48:         }
49:       } catch {
50:         showAuthErrorToast("Failed to verify magic link");
51:         router.replace("/login");
52:       }
53:     };
54:     verifyMagicLink();
55:   }, [router, dispatch, searchParams]);
56:   return (
57:     <div className="min-h-screen flex items-center justify-center bg-background">
58:       <div className="text-center space-y-4">
59:         <Loader2 className="h-12 w-12 animate-spin text-primary mx-auto" />
60:         <p className="text-muted-foreground">Signing you in...</p>
61:       </div>
62:     </div>
63:   );
64: }
</file>

<file path="apps/frontend/src/app/auth/callback/page.tsx">
 1: "use client";
 2: import {
 3:   showAuthErrorToast,
 4:   showAuthSuccessToast,
 5: } from "@/components/providers/ToastProvider";
 6: import { handleAuthRedirect } from "@/lib/auth/redirects";
 7: import { useAuth } from "@/redux/auth/useAuth";
 8: import { useRouter, useSearchParams } from "next/navigation";
 9: import { useEffect, useState } from "react";
10: export default function AuthCallbackPage() {
11:   const router = useRouter();
12:   const { session, status } = useAuth();
13:   const [hasRedirected, setHasRedirected] = useState(false);
14:   const searchParams = useSearchParams();
15:   useEffect(() => {
16:     if (status === "authenticated" && session?.user && !hasRedirected) {
17:       setHasRedirected(true);
18:       showAuthSuccessToast("OAuth");
19:       const redirectUrl = handleAuthRedirect(
20:         true,
21:         searchParams ?? undefined,
22:         "/login",
23:         session.user.role
24:       );
25:       window.location.href = redirectUrl;
26:     }
27:     if (status === "unauthenticated" && !hasRedirected) {
28:       setHasRedirected(true);
29:       showAuthErrorToast("OAuth session could not be established.");
30:       router.replace("/login");
31:     }
32:   }, [status, session, router, hasRedirected, searchParams]);
33:   return (
34:     <div className="min-h-screen flex items-center justify-center bg-background">
35:       <div className="text-center space-y-4">
36:         <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto"></div>
37:         <p className="text-muted-foreground">Completing sign in...</p>
38:       </div>
39:     </div>
40:   );
41: }
</file>

