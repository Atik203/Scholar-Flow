                        )}
                      </SelectContent>
                    </Select>
                    <Dialog
                      open={showCreateWorkspace}
                      onOpenChange={setShowCreateWorkspace}
                    >
                      <DialogTrigger asChild>
                        <Button type="button" variant="outline" size="icon">
                          <Plus className="h-4 w-4" />
                        </Button>
