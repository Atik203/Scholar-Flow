438:                           {shouldTruncate
439:                             ? `${chunk.content.substring(0, 300)}...`
440:                             : chunk.content}
441:                         </p>
442:                       </div>
443:                       {shouldTruncate && (
444:                         <Button
445:                           variant="link"
446:                           size="sm"
447:                           onClick={() => toggleChunkExpansion(chunk.id)}
448:                           className="p-0 h-auto text-xs mt-2"
449:                         >
450:                           Show more
451:                         </Button>
452:                       )}
453:                     </CardContent>
454:                   </Card>
455:                 );
456:               })}
457:               {filteredAndSortedChunks.length === 0 && (
458:                 <div className="text-center py-8 text-muted-foreground">
459:                   <FileText className="h-12 w-12 mx-auto mb-4 opacity-50" />
460:                   <p>No chunks match your search criteria</p>
461:                   <Button
462:                     variant="outline"
463:                     size="sm"
464:                     onClick={() => {
465:                       setSearchQuery("");
466:                       setFilterByPage(null);
467:                     }}
468:                     className="mt-2"
469:                   >
470:                     Clear filters
471:                   </Button>
472:                 </div>
473:               )}
474:             </div>
475:           )}
476:         </ScrollArea>
477:       </CardContent>
478:     </Card>
479:   );
480: }
</file>

