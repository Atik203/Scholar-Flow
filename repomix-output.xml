344:         },
345:       ];
346:       const trimmedContext = (input.context || "").trim();
347:       if (trimmedContext) {
348:         messages.push({
349:           role: "system",
350:           content: `Paper context:\n${trimmedContext}`,
351:         });
352:       }
353:       if (Array.isArray(input.history)) {
354:         messages.push(
355:           ...input.history.map((message) => ({
356:             role: message.role,
357:             content: String(message.content ?? ""),
358:           }))
359:         );
360:       }
361:       messages.push({ role: "user", content: input.prompt });
362:       const modelToUse = this.resolveModel(requestedModel);
363:       const { payload, raw, tokens } = await this.callStructuredJson(
364:         {
365:           model: modelToUse,
366:           messages,
367:           temperature: 0.4,
368:           maxTokens: 900,
369:           responseSchema: INSIGHT_RESPONSE_SCHEMA,
370:         },
371:         insightSchema
372:       );
373:       const validated = payload as RawInsight;
374:       const suggestions = normalizeStringList(validated.suggestions, 4);
375:       const rawTokens =
376:         typeof validated.tokensUsed === "string"
377:           ? Number(validated.tokensUsed)
378:           : validated.tokensUsed;
379:       const tokensUsed = Number.isFinite(rawTokens ?? NaN)
380:         ? (rawTokens as number)
381:         : tokens;
382:       return {
383:         provider: this.name,
384:         message: {
385:           role: "assistant",
386:           content: validated.answer.trim(),
387:         },
388:         suggestions: suggestions,
389:         rawResponse: raw,
390:         tokensUsed: tokensUsed ?? undefined,
391:       };
392:     } catch (error) {
393:       if (error instanceof APIError) {
394:         throw new AiError(
395:           error.status ?? 500,
396:           error.message,
397:           error.code ?? undefined
398:         );
399:       }
400:       if (error instanceof Error) {
401:         throw new AiError(502, error.message, "AI_PROVIDER_ERROR", error.stack);
402:       }
403:       throw new AiError(
404:         502,
405:         "OpenAI insight generation failed",
406:         "AI_PROVIDER_ERROR"
407:       );
408:     }
409:   }
410:   private resolveModel(model?: string): string {
411:     if (model && isValidModel(model)) {
412:       return model;
413:     }
414:     return DEFAULT_MODEL;
415:   }
416:   private useResponsesApi(model: string): boolean {
417:     return false;
418:   }
419:   private async callStructuredJson<T>(
420:     params: {
421:       model?: string;
422:       messages: Array<{
423:         role: "system" | "user" | "assistant";
424:         content: string;
425:       }>;
426:       temperature: number;
427:       maxTokens: number;
428:       responseSchema?: {
429:         name: string;
430:         schema: Record<string, unknown>;
431:         strict?: boolean;
432:       };
433:     },
434:     validator: z.ZodType<T>
435:   ): Promise<{ payload: T; raw: unknown; tokens?: number }> {
436:     if (!this.client) {
437:       throw new AiError(
438:         503,
439:         "OpenAI provider not configured",
440:         "AI_PROVIDER_DISABLED"
441:       );
442:     }
443:     const modelToUse = this.resolveModel(params.model);
444:     const responseFormat: ResponsesResponseFormat | undefined =
445:       params.responseSchema
446:         ? {
447:             type: "json_schema",
448:             json_schema: params.responseSchema,
449:           }
450:         : undefined;
451:     if (this.useResponsesApi(modelToUse) && this.client.responses) {
452:       const input = params.messages.map((message) => ({
453:         role: message.role,
454:         content: [{ type: "text", text: message.content }],
455:       })) as unknown as ResponsesInput;
456:       const responsesClient = this.client.responses as unknown as {
457:         create: (body: Record<string, unknown>) => Promise<unknown>;
458:       };
459:       const requestBody: Record<string, unknown> = {
460:         model: modelToUse,
461:         temperature: params.temperature,
462:         max_output_tokens: params.maxTokens,
463:         input,
464:       };
465:       if (responseFormat) {
466:         requestBody.text = {
467:           format: responseFormat as unknown,
468:         };
469:       }
470:       const response = await responsesClient.create(requestBody);
471:       const text = this.extractResponseText(response);
472:       const parsed = this.safeParseJson(text);
473:       const payload = validator.parse(parsed) as T;
474:       const tokens = this.extractTokenUsage((response as any).usage);
475:       return { payload, raw: response, tokens };
476:     }
477:     const completion = await this.client.chat.completions.create({
478:       model: modelToUse,
479:       temperature: params.temperature,
480:       max_tokens: params.maxTokens,
481:       messages: params.messages,
482:     });
483:     const messageContent = completion.choices[0]?.message?.content ?? "";
484:     const parsed = this.safeParseJson(messageContent);
485:     const payload = validator.parse(parsed) as T;
486:     const tokens = this.extractTokenUsage(completion.usage);
487:     return { payload, raw: completion, tokens };
488:   }
489:   private extractResponseText(response: unknown): string {
490:     if (!response || typeof response !== "object") {
491:       return "";
492:     }
493:     const outputText = (response as { output_text?: string }).output_text;
494:     if (typeof outputText === "string" && outputText.trim()) {
495:       return outputText;
496:     }
497:     const output = (response as { output?: unknown }).output;
498:     if (Array.isArray(output)) {
499:       for (const item of output) {
500:         if (
501:           item &&
502:           typeof item === "object" &&
503:           Array.isArray((item as { content?: unknown[] }).content)
504:         ) {
505:           for (const part of (item as { content: Array<{ text?: string }> })
506:             .content) {
507:             if (part && typeof part.text === "string" && part.text.trim()) {
508:               return part.text;
509:             }
510:           }
511:         }
512:       }
513:     }
514:     const choices = (response as { choices?: unknown[] }).choices;
515:     if (Array.isArray(choices) && choices.length > 0) {
516:       const firstChoice = choices[0] as
517:         | { message?: { content?: string | Array<{ text?: string }> } }
518:         | undefined;
519:       const content = firstChoice?.message?.content;
520:       if (typeof content === "string" && content.trim()) {
521:         return content;
522:       }
523:       if (Array.isArray(content)) {
524:         return content
525:           .map((entry) =>
526:             entry && typeof entry.text === "string" ? entry.text : ""
527:           )
528:           .join("")
529:           .trim();
530:       }
531:     }
532:     return "";
533:   }
534:   private extractTokenUsage(usage: unknown): number | undefined {
535:     if (!usage || typeof usage !== "object") {
536:       return undefined;
537:     }
538:     const total = (usage as { total_tokens?: number }).total_tokens;
539:     if (typeof total === "number") {
540:       return total;
541:     }
542:     const promptTokens =
543:       (
544:         usage as {
545:           prompt_tokens?: number;
546:           input_tokens?: number;
547:         }
548:       ).prompt_tokens ?? (usage as { input_tokens?: number }).input_tokens;
549:     const completionTokens =
550:       (
551:         usage as {
552:           completion_tokens?: number;
553:           output_tokens?: number;
554:           response_tokens?: number;
555:         }
556:       ).completion_tokens ??
557:       (usage as { output_tokens?: number }).output_tokens ??
558:       (usage as { response_tokens?: number }).response_tokens;
559:     const prompt = typeof promptTokens === "number" ? promptTokens : 0;
560:     const completion =
561:       typeof completionTokens === "number" ? completionTokens : 0;
562:     if (prompt === 0 && completion === 0) {
563:       return undefined;
564:     }
565:     return prompt + completion;
566:   }
567:   private buildPrompt(input: AiMetadataExtractionInput) {
568:     return [
569:       "Extract structured metadata for an academic paper.",
570:       "Respond with JSON containing: title (string), abstract (string),",
571:       "authors (array of strings), year (number), doi (string | null),",
572:       "keywords (array of strings), source (string), confidence (0-1).",
573:       input.originalTitle
574:         ? `Original title suggestion: ${input.originalTitle}`
575:         : undefined,
576:       input.existingMetadata
577:         ? `Existing metadata (JSON): ${JSON.stringify(input.existingMetadata)}`
578:         : undefined,
579:       "---",
580:       input.text,
581:     ]
582:       .filter(Boolean)
583:       .join("\n");
584:   }
585:   private buildSummaryPrompt(input: AiSummaryRequest) {
586:     const wordLimit = input.wordLimit ?? 220;
587:     const audience = input.audience ?? "researcher";
588:     const tone = input.tone ?? "academic";
589:     const focusText =
590:       input.focusAreas && input.focusAreas.length > 0
591:         ? `Focus on: ${input.focusAreas.join(", ")}`
592:         : undefined;
593:     const instructions = [
594:       `Summarise the following academic paper for a ${audience} audience.`,
595:       `Adopt a ${tone} tone.`,
596:       `Limit the overview to approximately ${wordLimit} words.`,
597:       "Return JSON with keys: summary (string), highlights (array of strings with 3-5 bullet points), followUpQuestions (array of 2-4 thoughtful next questions).",
598:       input.language
599:         ? `Respond in ${input.language}.`
600:         : "Respond in the same language as the source material if clear, otherwise use English.",
601:       focusText,
602:       input.instructions
603:         ? `Additional instructions: ${input.instructions}`
604:         : undefined,
605:       "---",
606:       input.text,
607:     ];
608:     return instructions.filter(Boolean).join("\n");
609:   }
610:   private safeParseJson(content: string): unknown {
611:     try {
612:       return JSON.parse(content);
613:     } catch (error) {
614:       const fallback = content.replace(/```json|```/g, "").trim();
615:       try {
616:         return JSON.parse(fallback);
617:       } catch (err) {
618:         throw new AiError(
619:           500,
620:           "Unable to parse AI JSON response",
621:           "AI_RESPONSE_PARSE_ERROR"
622:         );
623:       }
624:     }
625:   }
626:   private normalizeMetadata(payload: RawMetadata): AiMetadata {
627:     const rawAuthors = payload.authors as unknown;
628:     const authors = Array.isArray(rawAuthors)
629:       ? rawAuthors
630:           .map((author) =>
631:             typeof author === "string" ? author.trim() : String(author ?? "")
632:           )
633:           .filter((author) => author.length > 0)
634:       : typeof rawAuthors === "string"
635:         ? rawAuthors
636:             .split(/,|;|\band\b/gi)
637:             .map((author: string) => author.trim())
638:             .filter((author) => author.length > 0)
639:         : [];
640:     const yearValue = Number(payload.year);
641:     const year = Number.isFinite(yearValue) ? yearValue : undefined;
642:     const confidenceValue = Number(payload.confidence);
643:     const confidence = Number.isFinite(confidenceValue)
644:       ? Math.min(Math.max(confidenceValue, 0), 1)
645:       : undefined;
646:     const rawKeywords = payload.keywords as unknown;
647:     const keywords = Array.isArray(rawKeywords)
648:       ? rawKeywords
649:           .map((keyword) =>
650:             typeof keyword === "string" ? keyword.trim() : String(keyword ?? "")
651:           )
652:           .filter((keyword) => keyword.length > 0)
653:       : typeof rawKeywords === "string"
654:         ? rawKeywords
655:             .split(/,|;|\band\b/gi)
656:             .map((keyword: string) => keyword.trim())
657:             .filter((keyword) => keyword.length > 0)
658:         : [];
659:     return {
660:       title: payload.title?.toString().trim(),
661:       abstract: payload.abstract?.toString().trim(),
662:       authors,
663:       year,
664:       doi: payload.doi?.toString().trim() || undefined,
665:       keywords,
666:       source: payload.source?.toString().trim(),
667:       confidence,
668:     };
669:   }
670: }
