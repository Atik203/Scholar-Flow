 22: import {
 23:   AlertCircle,
 24:   Copy,
 25:   FileText,
 26:   Loader2,
 27:   RefreshCw,
 28:   Settings,
 29: } from "lucide-react";
 30: import { useCallback, useMemo, useState } from "react";
 31: import { DocumentPreview } from "./DocumentPreview";
 32: type PaperChunk = {
 33:   id: string;
 34:   idx: number;
 35:   page?: number;
 36:   content: string;
 37:   tokenCount?: number;
 38:   createdAt: string;
 39: };
 40: interface ExtractionViewerProps {
 41:   paperId: string;
 42:   className?: string;
 43: }
 44: export function ExtractionViewer({
 45:   paperId,
 46:   className = "",
 47: }: ExtractionViewerProps) {
 48:   const [showAdvanced, setShowAdvanced] = useState(false);
 49:   const [previewError, setPreviewError] = useState<string | null>(null);
 50:   // Get processing status to determine if extraction is complete
 51:   const {
 52:     data: processingData,
 53:     isLoading: isStatusLoading,
 54:     error: statusError,
 55:     refetch: refetchStatus,
 56:   } = useGetProcessingStatusQuery(paperId, {
 57:     refetchOnMountOrArgChange: true,
 58:   });
 59:   // Get preview URL with retry logic for 403 errors
 60:   const {
 61:     data: previewData,
 62:     isLoading: isPreviewLoading,
 63:     error: previewUrlError,
 64:     refetch: refetchPreviewUrl,
 65:   } = useGetPaperPreviewUrlQuery(paperId, {
 66:     skip: !paperId, // Only skip if we don't have a paper ID
 67:   });
 68:   // Get raw chunks for advanced view
 69:   const {
 70:     data: chunksData,
 71:     isLoading: isChunksLoading,
 72:     error: chunksError,
 73:     refetch: refetchChunks,
 74:   } = useGetAllChunksQuery(paperId, {
 75:     skip:
 76:       !showAdvanced || processingData?.data?.processingStatus !== "PROCESSED",
 77:   });
 78:   const processingStatus = processingData?.data?.processingStatus;
 79:   const chunks = useMemo(
 80:     () => chunksData?.data?.chunks ?? [],
 81:     [chunksData?.data?.chunks]
 82:   ) as PaperChunk[];
 83:   const isProcessed = processingStatus === "PROCESSED";
 84:   const handlePreviewError = useCallback(
 85:     (error: string) => {
 86:       if (error.includes("403") || error.includes("expired")) {
 87:         console.log("[ExtractionViewer] Preview URL expired, retrying...");
 88:         if (previewData !== undefined || isPreviewLoading) {
 89:           refetchPreviewUrl();
 90:         }
 91:       } else {
 92:         setPreviewError(error);
 93:         showErrorToast(`Preview error: ${error}`);
 94:       }
 95:     },
 96:     [refetchPreviewUrl, previewData, isPreviewLoading]
 97:   );
 98:   const handleCopyAllText = useCallback(async () => {
 99:     if (!chunks.length) return;
100:     try {
101:       const allText = [...chunks]
102:         .sort((a: PaperChunk, b: PaperChunk) => a.idx - b.idx)
103:         .map((chunk: PaperChunk) => chunk.content)
104:         .join("\n\n");
105:       await navigator.clipboard.writeText(allText);
106:       showSuccessToast("All extracted text copied to clipboard");
107:     } catch (error) {
108:       showErrorToast("Failed to copy text to clipboard");
109:     }
110:   }, [chunks]);
111:   const handleRetryExtraction = useCallback(() => {
112:     try {
113:       if (processingData !== undefined || isStatusLoading) {
114:         refetchStatus();
115:       }
116:       if (
117:         processingData?.data &&
118:         (previewData !== undefined || isPreviewLoading)
119:       ) {
120:         refetchPreviewUrl();
121:       }
122:       if (
123:         showAdvanced &&
124:         isProcessed &&
125:         (chunksData !== undefined || isChunksLoading)
126:       ) {
127:         refetchChunks();
128:       }
129:       showSuccessToast("Refreshing document data...");
130:     } catch (error) {
131:       console.error("[ExtractionViewer] Retry error:", error);
132:       showErrorToast("Failed to refresh document data");
133:     }
134:   }, [
135:     refetchStatus,
136:     refetchPreviewUrl,
137:     refetchChunks,
138:     showAdvanced,
139:     processingData,
140:     previewData,
141:     chunksData,
142:     isStatusLoading,
143:     isPreviewLoading,
144:     isChunksLoading,
145:     isProcessed,
146:   ]);
147:   if (!paperId) {
148:     return (
149:       <Card className={className}>
150:         <CardHeader>
151:           <CardTitle className="flex items-center gap-2">
152:             <AlertCircle className="h-5 w-5" />
153:             Invalid Paper
154:           </CardTitle>
155:         </CardHeader>
156:         <CardContent>
157:           <p className="text-muted-foreground">
158:             Unable to load document viewer - invalid paper ID.
159:           </p>
160:         </CardContent>
161:       </Card>
162:     );
163:   }
164:   if (isStatusLoading) {
165:     return (
166:       <Card className={className}>
167:         <CardHeader>
168:           <CardTitle className="flex items-center gap-2">
169:             <FileText className="h-5 w-5" />
170:             Document Preview
171:           </CardTitle>
172:         </CardHeader>
173:         <CardContent>
174:           <div className="flex items-center justify-center h-64">
175:             <div className="text-center">
176:               <Loader2 className="h-8 w-8 animate-spin mx-auto mb-4" />
177:               <p className="text-muted-foreground">
178:                 Loading document status...
179:               </p>
180:             </div>
181:           </div>
182:         </CardContent>
183:       </Card>
184:     );
185:   }
186:   if (statusError) {
187:     return (
188:       <Card className={className}>
189:         <CardHeader>
190:           <CardTitle className="flex items-center gap-2 text-destructive">
191:             <AlertCircle className="h-5 w-5" />
192:             Error Loading Document
193:           </CardTitle>
194:         </CardHeader>
195:         <CardContent>
196:           <div className="text-center space-y-4">
197:             <p className="text-muted-foreground">
198:               Unable to load document information. Please try again.
199:             </p>
200:             <Button onClick={handleRetryExtraction} variant="outline" size="sm">
201:               <RefreshCw className="h-4 w-4 mr-2" />
202:               Retry
203:             </Button>
204:           </div>
205:         </CardContent>
206:       </Card>
207:     );
208:   }
209:   return (
210:     <Card className={className}>
211:       <CardHeader>
212:         <div className="flex items-center justify-between">
213:           <div>
214:             <CardTitle className="flex items-center gap-2">
215:               <FileText className="h-5 w-5" />
216:               Document Preview
217:             </CardTitle>
218:             <CardDescription>
219:               Format-preserving document view with extracted text for search
220:             </CardDescription>
221:           </div>
222:           <div className="flex items-center gap-2">
223:             {}
224:             <Badge
225:               variant={
226:                 processingStatus === "PROCESSED"
227:                   ? "default"
228:                   : processingStatus === "PROCESSING"
229:                     ? "secondary"
230:                     : processingStatus === "FAILED"
231:                       ? "destructive"
232:                       : "outline"
233:               }
234:             >
235:               {processingStatus || "UNKNOWN"}
236:             </Badge>
237:             {}
238:             <Button
239:               variant="ghost"
240:               size="sm"
241:               onClick={() => setShowAdvanced(!showAdvanced)}
242:             >
243:               <Settings className="h-4 w-4" />
244:               Advanced
245:             </Button>
246:             <Button variant="ghost" size="sm" onClick={handleRetryExtraction}>
247:               <RefreshCw className="h-4 w-4" />
248:             </Button>
249:           </div>
250:         </div>
251:       </CardHeader>
252:       <CardContent className="space-y-6">
253:         {}
254:         {processingStatus === "PROCESSING" ? (
255:           <div className="flex items-center justify-center h-64 bg-muted/20 rounded-lg">
256:             <div className="text-center">
257:               <Loader2 className="h-8 w-8 animate-spin mx-auto mb-4" />
258:               <p className="text-muted-foreground">Processing document...</p>
259:               <p className="text-sm text-muted-foreground mt-2">
260:                 This may take a few moments for large documents
261:               </p>
262:             </div>
263:           </div>
264:         ) : processingStatus === "FAILED" ? (
265:           <div className="flex items-center justify-center h-64 bg-destructive/5 rounded-lg border border-destructive/20">
