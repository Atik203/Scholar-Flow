518:    * Search notes using $queryRaw
519:    * Source: Optimized note search with pagination
520:    */
521:   static async searchNotes(userId: string, query: SearchNotesQuery) {
522:     const { query: searchQuery, page = 1, limit = 20 } = query;
523:     const skip = (page - 1) * limit;
524:     try {
525:       const notes = await prisma.$queryRaw<any[]>`
526:         SELECT
527:           rn.id, rn."userId", rn."paperId", rn.title, rn.content, rn.tags,
528:           rn."isPrivate", rn."createdAt", rn."updatedAt",
529:           json_build_object(
530:             'id', u.id,
531:             'name', u.name,
532:             'email', u.email,
533:             'image', u.image
534:           ) as user,
535:           CASE WHEN rn."paperId" IS NOT NULL THEN
536:             json_build_object(
537:               'id', p.id,
538:               'title', p.title
539:             )
540:           ELSE NULL END as paper
541:         FROM "ResearchNote" rn
542:         LEFT JOIN "User" u ON rn."userId" = u.id
543:         LEFT JOIN "Paper" p ON rn."paperId" = p.id
544:         WHERE rn."userId" = ${userId}
545:           AND rn."isDeleted" = false
546:           AND (
547:             rn.title ILIKE ${`%${searchQuery}%`}
548:             OR rn.content ILIKE ${`%${searchQuery}%`}
549:             OR ${searchQuery} = ANY(rn.tags)
550:           )
551:         ORDER BY rn."updatedAt" DESC
552:         LIMIT ${limit} OFFSET ${skip}
553:       `;
554:       const totalResult = await prisma.$queryRaw<[{ count: bigint }]>`
555:         SELECT COUNT(*) as count
556:         FROM "ResearchNote"
557:         WHERE "userId" = ${userId}
558:           AND "isDeleted" = false
559:           AND (
560:             title ILIKE ${`%${searchQuery}%`}
561:             OR content ILIKE ${`%${searchQuery}%`}
562:             OR ${searchQuery} = ANY(tags)
563:           )
564:       `;
565:       const total = Number(totalResult[0]?.count || 0);
566:       return {
567:         notes,
568:         pagination: {
569:           page,
570:           limit,
571:           total,
572:           totalPage: Math.ceil(total / limit),
573:         },
574:       };
575:     } catch (error) {
576:       console.error("Error searching notes:", error);
