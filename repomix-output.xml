<file path="apps/frontend/src/components/providers/AuthProvider.tsx">
 1: "use client";
 2: import { apiSlice } from "@/redux/api/apiSlice";
 3: import { useGetCurrentUserQuery } from "@/redux/auth/authApi";
 4: import {
 5:   selectAccessToken,
 6:   selectCurrentUser,
 7:   selectIsAuthenticated,
 8:   setCredentials,
 9:   setLoading,
10:   updateUser,
11: } from "@/redux/auth/authSlice";
12: import { setAuthCookie, clearAuthCookie } from "@/lib/auth/authCookies";
13: import { useAppDispatch, useAppSelector } from "@/redux/hooks";
14: import { ReactNode, useEffect, useMemo, useRef } from "react";
15: interface AuthProviderProps {
16:   children: ReactNode;
17: }
18: export function AuthProvider({ children }: AuthProviderProps) {
19:   const dispatch = useAppDispatch();
20:   const isAuthenticated = useAppSelector(selectIsAuthenticated);
21:   const accessToken = useAppSelector(selectAccessToken);
22:   const currentUser = useAppSelector(selectCurrentUser);
23:   const hasInitialized = useRef(false);
24:   const lastSyncedUserVersion = useRef<string | null>(null);
25:   const previousRoleRef = useRef<string | null>(null);
26:   if (!hasInitialized.current) {
27:     hasInitialized.current = true;
28:     if (isAuthenticated && accessToken) {
29:       setAuthCookie();
30:     } else {
31:       clearAuthCookie();
32:     }
33:     if (accessToken === null) {
34:       dispatch(setLoading(false));
35:     }
36:   }
37:   const shouldFetchUser = Boolean(accessToken && accessToken.length > 0);
38:   const { data: currentUserResponse } = useGetCurrentUserQuery(undefined, {
39:     skip: !shouldFetchUser,
40:     refetchOnMountOrArgChange: true,
41:     refetchOnReconnect: true,
42:     pollingInterval: isAuthenticated ? 30000 : undefined,
43:   });
44:   const fetchedUser = currentUserResponse?.data?.user;
45:   const fetchedUserVersionKey = fetchedUser
46:     ? `${fetchedUser.id}:${fetchedUser.updatedAt ?? ""}:${fetchedUser.role ?? ""}:${fetchedUser.email ?? ""}`
47:     : null;
48:   const currentUserId = currentUser?.id ?? null;
49:   const stableFetchedUser = useMemo(
50:     () => (fetchedUserVersionKey ? (fetchedUser ?? null) : null),
51:     [fetchedUser, fetchedUserVersionKey]
52:   );
53:   useEffect(() => {
54:     if (!accessToken) {
55:       lastSyncedUserVersion.current = null;
56:     }
57:     if (accessToken && hasInitialized.current) {
58:       dispatch(setLoading(false));
59:     }
60:   }, [accessToken, dispatch]);
61:   useEffect(() => {
62:     if (!fetchedUserVersionKey || !accessToken || !stableFetchedUser) {
63:       return;
64:     }
65:     const fetchedVersionKey = fetchedUserVersionKey;
66:     if (lastSyncedUserVersion.current === fetchedVersionKey) {
67:       return;
68:     }
69:     const fetchedRole = stableFetchedUser.role;
70:     const hadRoleChange =
71:       previousRoleRef.current !== null &&
72:       previousRoleRef.current !== fetchedRole;
73:     if (hadRoleChange) {
74:       dispatch(
75:         apiSlice.util.invalidateTags(["User", "Collection", "Workspace"])
76:       );
77:     }
78:     previousRoleRef.current = fetchedRole || null;
79:     if (!currentUserId || currentUserId !== stableFetchedUser.id) {
80:       dispatch(
81:         setCredentials({
82:           user: stableFetchedUser,
83:           accessToken,
84:         })
85:       );
86:     } else {
87:       dispatch(updateUser(stableFetchedUser));
88:     }
89:     lastSyncedUserVersion.current = fetchedVersionKey;
90:   }, [
91:     accessToken,
92:     currentUserId,
93:     dispatch,
94:     fetchedUserVersionKey,
95:     stableFetchedUser,
96:   ]);
97:   return <>{children}</>;
98: }
</file>

<file path="apps/frontend/src/components/providers/BrowserCleanup.tsx">
 1: "use client";
 2: import { usePathname } from "next/navigation";
 3: import { useEffect } from "react";
 4: export function BrowserCleanup() {
 5:   const pathname = usePathname();
 6:   useEffect(() => {
 7:     if (typeof window === "undefined") return;
 8:     const authPages = ["/login", "/register", "/auth"];
 9:     const isAuthPage = authPages.some((page) => pathname?.startsWith(page));
10:     if (isAuthPage) {
11:       console.log("[BrowserCleanup] Skipping cleanup on auth page:", pathname);
12:       return;
13:     }
14:     const timeoutId = setTimeout(() => {
15:       try {
16:         const legacyCookiesToCheck = [
17:           "next-auth.session-token",
18:           "__Secure-next-auth.session-token",
19:           "next-auth.callback-url",
20:           "__Secure-next-auth.callback-url",
21:           "next-auth.csrf-token",
22:           "__Host-next-auth.csrf-token",
23:         ];
24:         const cookiesToCheck = [
25:           ...legacyCookiesToCheck,
26:           "better-auth.session_token",
27:           "__Secure-better-auth.session_token",
28:           "better-auth.csrf_token",
29:           "__Host-better-auth.csrf_token",
30:         ];
31:         document.cookie.split(";").forEach((cookie) => {
32:           const [name] = cookie.split("=");
33:           const trimmedName = name.trim();
34:           if (
35:             trimmedName.includes("next-auth") ||
36:             trimmedName.includes("__Secure-next-auth") ||
37:             trimmedName.includes("__Host-next-auth") ||
38:             trimmedName.includes("better-auth") ||
39:             trimmedName.includes("__Secure-better-auth") ||
40:             trimmedName.includes("__Host-better-auth")
41:           ) {
42:             const cookieValue = document.cookie
43:               .split("; ")
44:               .find((row) => row.startsWith(`${trimmedName}=`))
45:               ?.split("=")[1];
46:             if (
47:               !cookieValue ||
48:               cookieValue === "undefined" ||
49:               cookieValue === "null"
50:             ) {
51:               const deletionStrings = [
52:                 `${trimmedName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`,
53:                 `${trimmedName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; secure;`,
54:                 `${trimmedName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${window.location.hostname};`,
55:               ];
56:               deletionStrings.forEach((str) => (document.cookie = str));
57:             }
58:           }
59:         });
60:         const keysToCheck = [
61:           "auth-token",
62:           "user-data",
63:           "session-data",
64:           "access-token",
65:           "refresh-token",
66:         ];
67:         keysToCheck.forEach((key) => {
68:           if (localStorage.getItem(key)) {
69:             localStorage.removeItem(key);
70:             console.log(
71:               `[BrowserCleanup] Removed orphaned localStorage key: ${key}`
72:             );
73:           }
74:         });
75:         keysToCheck.forEach((key) => {
76:           if (sessionStorage.getItem(key)) {
77:             sessionStorage.removeItem(key);
78:             console.log(
79:               `[BrowserCleanup] Removed orphaned sessionStorage key: ${key}`
80:             );
81:           }
82:         });
83:       } catch (error) {
84:         if (process.env.NODE_ENV === "development") {
85:           console.error("[BrowserCleanup] Error during cleanup:", error);
86:         }
87:       }
88:     }, 1000);
89:     return () => clearTimeout(timeoutId);
90:   }, [pathname]);
91:   return null;
92: }
</file>

