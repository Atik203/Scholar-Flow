217:   static async listMembers(
218:     userId: string,
219:     id: string,
220:     limit: number,
221:     cursor: string | undefined
222:   ) {
223:     // Must be a member to view
224:     await this.getWorkspace(userId, id);
225:     const take = limit + 1;
226:     const cursorFilter = cursor
227:       ? Prisma.sql`AND m."joinedAt" < (SELECT "joinedAt" FROM "WorkspaceMember" WHERE id = ${cursor})`
228:       : Prisma.empty;
229:     const rows = await prisma.$queryRaw<any[]>`
230:       SELECT m.*, u.email, u.name
231:       FROM "WorkspaceMember" m
232:       JOIN "User" u ON u.id = m."userId"
233:       WHERE m."workspaceId" = ${id} AND m."isDeleted" = false
234:         ${cursorFilter}
235:       ORDER BY m."joinedAt" DESC
236:       LIMIT ${take}
237:     `;
238:     const hasMore = rows.length > limit;
239:     const sliced = hasMore ? rows.slice(0, -1) : rows;
240:     return {
241:       result: sliced,
242:       meta: {
243:         limit,
244:         nextCursor: hasMore ? sliced[sliced.length - 1].id : null,
245:         hasMore,
246:       },
247:     };
248:   }
