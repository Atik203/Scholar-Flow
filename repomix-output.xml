 5:   getErrorDetails,
 6:   getErrorMessage,
 7:   shouldRetryRequest,
 8:   showApiErrorToast,
 9: } from "../lib/errorHandling";
10: export interface UseErrorHandlerOptions {
11:   showToast?: boolean;
12:   logError?: boolean;
13:   onError?: (error: FetchBaseQueryError | SerializedError) => void;
14:   retryCallback?: () => void;
15: }
16: export const useErrorHandler = (
17:   error: FetchBaseQueryError | SerializedError | undefined,
18:   options: UseErrorHandlerOptions = {}
19: ) => {
20:   const { showToast = true, logError = true, onError, retryCallback } = options;
21:   useEffect(() => {
22:     if (!error) return;
23:     if (logError && process.env.NODE_ENV === "development") {
24:       console.error("API Error Details:", getErrorDetails(error));
25:     }
26:     if (showToast) {
27:       showApiErrorToast(error);
28:     }
29:     if (onError) {
30:       onError(error);
31:     }
32:     if (shouldRetryRequest(error) && retryCallback) {
33:       const retryDelay = 1000;
34:       setTimeout(() => {
35:         retryCallback();
36:       }, retryDelay);
37:     }
38:   }, [error, showToast, logError, onError, retryCallback]);
39:   return {
40:     errorMessage: getErrorMessage(error),
41:     errorDetails: getErrorDetails(error),
42:     shouldRetry: shouldRetryRequest(error),
43:   };
44: };
45: export const useMutationErrorHandler = <T = unknown>(
46:   mutationResult: {
47:     error?: FetchBaseQueryError | SerializedError;
48:     isLoading: boolean;
49:     isError: boolean;
50:     reset: () => void;
51:   },
52:   retryMutation?: () => Promise<T>,
53:   options: UseErrorHandlerOptions = {}
54: ) => {
55:   const errorHandler = useErrorHandler(mutationResult.error, {
56:     ...options,
57:     retryCallback: retryMutation
58:       ? () => {
59:           mutationResult.reset();
60:           retryMutation();
61:         }
62:       : undefined,
63:   });
64:   return {
65:     ...errorHandler,
66:     retry: retryMutation
67:       ? async () => {
68:           mutationResult.reset();
69:           return await retryMutation();
70:         }
71:       : undefined,
72:     isRetryable: shouldRetryRequest(mutationResult.error),
73:   };
74: };
75: export const useQueryErrorHandler = (
76:   queryResult: {
77:     error?: FetchBaseQueryError | SerializedError;
78:     isLoading: boolean;
79:     isError: boolean;
80:     refetch: () => void;
81:   },
82:   options: UseErrorHandlerOptions = {}
83: ) => {
84:   const errorHandler = useErrorHandler(queryResult.error, {
85:     ...options,
86:     retryCallback: queryResult.refetch,
87:   });
88:   return {
89:     ...errorHandler,
90:     retry: queryResult.refetch,
91:     isRetryable: shouldRetryRequest(queryResult.error),
92:   };
93: };
</file>

