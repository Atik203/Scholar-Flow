  category: SearchCategory;
  timestamp: string;
  resultsCount: number;
  filters?: {
    dateRange?: string;
    authors?: string[];
    tags?: string[];
    type?: string;
  };
  starred: boolean;
  lastResultClicked?: {
    id: string;
    title: string;
    type: "paper" | "collection" | "user";
  };
}

// Mock search history data
const mockSearchHistory: SearchHistoryItem[] = [
