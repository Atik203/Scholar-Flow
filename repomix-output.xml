 51: const getTimeAgo = (dateString: string) => {
 52:   const seconds = Math.floor((Date.now() - new Date(dateString).getTime()) / 1000);
 53:   if (seconds < 60) return "Just now";
 54:   const minutes = Math.floor(seconds / 60);
 55:   if (minutes < 60) return `${minutes}m ago`;
 56:   const hours = Math.floor(minutes / 60);
 57:   if (hours < 24) return `${hours}h ago`;
 58:   const days = Math.floor(hours / 24);
 59:   if (days < 30) return `${days}d ago`;
 60:   return new Date(dateString).toLocaleDateString();
 61: };
 62: const getExpiresIn = (dateString?: string) => {
