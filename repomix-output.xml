 80:             SELECT id, email, role, "isDeleted"
 81:             FROM "User"
 82:             WHERE LOWER(email) = LOWER(${userEmail}) AND "isDeleted" = false
 83:             LIMIT 1
 84:           `;
 85:           console.log(
