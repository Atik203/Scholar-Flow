126:     const increment = target / steps;
127:     let current = 0;
128:     const timer = setInterval(
129:       () => {
130:         current += increment;
131:         if (current >= target) {
132:           setCount(target);
133:           clearInterval(timer);
134:         } else {
135:           setCount(
136:             decimals > 0
137:               ? parseFloat(current.toFixed(decimals))
138:               : Math.floor(current),
139:           );
140:         }
141:       },
142:       (duration * 1000) / steps,
143:     );
144:     return () => clearInterval(timer);
145:   }, [isVisible, target, duration, decimals]);
146:   return (
147:     <span ref={ref}>
148:       {decimals > 0 ? count.toFixed(decimals) : count.toLocaleString()}
149:       {suffix}
150:     </span>
151:   );
