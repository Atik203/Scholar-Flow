  1: "use client";
  2: import { useState } from "react";
  3: import { Button } from "@/components/ui/button";
  4: import {
  5:   Card,
  6:   CardContent,
  7:   CardHeader,
  8:   CardTitle,
  9: } from "@/components/ui/card";
 10: import { Input } from "@/components/ui/input";
 11: import { Label } from "@/components/ui/label";
 12: import { Textarea } from "@/components/ui/textarea";
 13: import { Skeleton } from "@/components/ui/skeleton";
 14: import {
 15:   Select,
 16:   SelectContent,
 17:   SelectItem,
 18:   SelectTrigger,
 19:   SelectValue,
 20: } from "@/components/ui/select";
 21: import {
 22:   useAiComparePapersMutation,
 23:   useAiLiteratureReviewMutation,
 24:   useAiRewriteTextMutation,
 25:   useListPapersQuery,
 26: } from "@/redux/api/paperApi";
 27: import { showErrorToast } from "@/components/providers/ToastProvider";
 28: import {
 29:   BookOpenCheck,
 30:   PenLine,
 31:   Scale,
 32:   Loader2,
 33: } from "lucide-react";
 34: type Tool = "rewrite" | "compare" | "review";
 35: const TOOLS: Array<{ key: Tool; label: string; icon: typeof PenLine }> = [
 36:   { key: "rewrite", label: "Rewrite", icon: PenLine },
 37:   { key: "compare", label: "Compare", icon: Scale },
 38:   { key: "review", label: "Literature Review", icon: BookOpenCheck },
 39: ];
 40: function renderToolOutput(tool: Tool, data: unknown): React.ReactNode {
 41:   const obj = data as Record<string, unknown> | null;
 42:   if (tool === "rewrite") {
 43:     const rewritten = obj?.rewritten;
 44:     if (typeof rewritten === "string" && rewritten.trim()) {
 45:       return <span className="whitespace-pre-wrap">{rewritten}</span>;
 46:     }
 47:   }
 48:   if (tool === "compare") {
 49:     const raw = obj?.comparison;
 50:     if (typeof raw === "string" && raw.trim()) {
 51:       try {
 52:         const parsed: any = JSON.parse(raw);
 53:         const cmp = parsed?.comparison ?? parsed;
 54:         const sections: Array<[string, unknown]> = [
 55:           ["Agreements", cmp?.agreements],
 56:           ["Disagreements", cmp?.disagreements],
 57:           ["Complementary findings", cmp?.complementary_findings],
 58:           ["Conflicting conclusions", cmp?.conflicting_conclusions],
 59:         ];
 60:         const hasAny = sections.some(
 61:           ([, value]) => Array.isArray(value) && value.length > 0,
 62:         );
 63:         if (hasAny) {
 64:           return (
 65:             <div className="space-y-3">
 66:               {sections.map(
 67:                 ([label, value]) =>
 68:                   Array.isArray(value) && value.length > 0 ? (
 69:                     <div key={label}>
 70:                       <p className="font-medium text-foreground">{label}</p>
 71:                       <ul className="list-disc pl-5 mt-1 space-y-1">
 72:                         {value.map((item, i) => (
 73:                           <li key={i}>
 74:                             {typeof item === "string"
 75:                               ? item
 76:                               : JSON.stringify(item)}
 77:                           </li>
 78:                         ))}
 79:                       </ul>
 80:                     </div>
 81:                   ) : null,
 82:               )}
 83:             </div>
 84:           );
 85:         }
 86:       } catch {
 87:       }
 88:       return <span className="whitespace-pre-wrap">{raw}</span>;
 89:     }
 90:   }
 91:   if (tool === "review") {
 92:     const review = obj?.review;
 93:     if (typeof review === "string" && review.trim()) {
 94:       return <span className="whitespace-pre-wrap">{review}</span>;
 95:     }
 96:   }
 97:   return typeof data === "string"
 98:     ? data
 99:     : JSON.stringify(data, null, 2);
100: }
101: interface AiToolsCardProps {
102:   paperId: string;
103:   paperTitle: string;
104: }
105: export function AiToolsCard({ paperId, paperTitle }: AiToolsCardProps) {
106:   const [tool, setTool] = useState<Tool>("rewrite");
107:   const [text, setText] = useState("");
108:   const [tone, setTone] = useState("");
109:   const [otherPaperId, setOtherPaperId] = useState("");
110:   const [topic, setTopic] = useState("");
111:   const [output, setOutput] = useState<unknown>(null);
112:   const { data: papersData, isLoading: papersLoading } = useListPapersQuery({
113:     limit: 100,
114:   });
115:   const [rewrite, { isLoading: isRewriting }] = useAiRewriteTextMutation();
116:   const [compare, { isLoading: isComparing }] = useAiComparePapersMutation();
117:   const [review, { isLoading: isReviewing }] = useAiLiteratureReviewMutation();
118:   const isRunning = isRewriting || isComparing || isReviewing;
119:   const papers = (papersData?.items ?? []).filter((p) => p.id !== paperId);
120:   const otherPaper = papers.find((p) => p.id === otherPaperId);
121:   const run = async (fn: () => Promise<unknown>) => {
122:     setOutput(null);
123:     try {
124:       const result = (await fn()) as any;
125:       setOutput(result?.data ?? result);
126:     } catch {
127:       showErrorToast("AI tool failed", "Please try again");
128:     }
129:   };
130:   const handleRewrite = () =>
131:     run(() =>
132:       rewrite({
133:         text: text || paperTitle,
134:         tone: tone || undefined,
135:       }).unwrap()
136:     );
137:   const handleCompare = () =>
138:     run(() => compare({ paper1Id: paperId, paper2Id: otherPaperId }).unwrap());
139:   const handleReview = () =>
140:     run(() => review({ paperIds: [paperId, ...(otherPaperId ? [otherPaperId] : [])], topic: topic || undefined }).unwrap());
141:   return (
142:     <Card>
143:       <CardHeader className="pb-2">
144:         <CardTitle className="text-lg flex items-center gap-2">
145:           <PenLine className="h-5 w-5 text-primary" />
146:           AI Tools
147:         </CardTitle>
148:         <p className="text-sm text-muted-foreground">
149:           Rewrite, compare, or review papers with AI
150:         </p>
151:       </CardHeader>
152:       <CardContent className="space-y-4">
153:         <div className="flex flex-wrap gap-2">
154:           {TOOLS.map((t) => {
155:             const Icon = t.icon;
156:             return (
157:               <Button
158:                 key={t.key}
159:                 size="sm"
160:                 variant={tool === t.key ? "default" : "outline"}
161:                 className="gap-1.5"
162:                 onClick={() => {
163:                   setTool(t.key);
164:                   setOutput(null);
165:                 }}
166:               >
167:                 <Icon className="h-3.5 w-3.5" />
168:                 {t.label}
169:               </Button>
170:             );
171:           })}
172:         </div>
173:         <div className="space-y-3">
174:           {tool === "rewrite" && (
175:             <div className="space-y-2">
176:               <Label htmlFor="ai-tool-text">Text to rewrite</Label>
177:               <Textarea
178:                 id="ai-tool-text"
179:                 rows={4}
180:                 value={text}
181:                 onChange={(e) => setText(e.target.value)}
182:                 placeholder={`Defaults to the paper title: "${paperTitle}"`}
183:               />
184:               <div className="space-y-2">
185:                 <Label htmlFor="ai-tool-tone">Tone (optional)</Label>
186:                 <Input
187:                   id="ai-tool-tone"
188:                   value={tone}
189:                   onChange={(e) => setTone(e.target.value)}
190:                   placeholder="e.g. academic, casual, concise"
191:                 />
192:               </div>
193:             </div>
194:           )}
195:           {(tool === "compare" || tool === "review") && (
196:             <div className="space-y-2">
197:               <Label>Compare with / include paper</Label>
198:               {papersLoading ? (
199:                 <Skeleton className="h-10 w-full" />
200:               ) : (
201:                 <Select value={otherPaperId} onValueChange={setOtherPaperId}>
202:                   <SelectTrigger>
203:                     <SelectValue placeholder="Select another paper..." />
204:                   </SelectTrigger>
205:                   <SelectContent>
206:                     {papers.map((p) => (
207:                       <SelectItem key={p.id} value={p.id}>
208:                         {p.title}
209:                       </SelectItem>
210:                     ))}
211:                   </SelectContent>
212:                 </Select>
213:               )}
214:             </div>
215:           )}
216:           {tool === "review" && (
217:             <div className="space-y-2">
218:               <Label htmlFor="ai-tool-topic">Topic (optional)</Label>
219:               <Input
220:                 id="ai-tool-topic"
221:                 value={topic}
222:                 onChange={(e) => setTopic(e.target.value)}
223:                 placeholder="e.g. transformer architectures"
224:               />
225:             </div>
226:           )}
227:           <Button
228:             disabled={isRunning || (tool === "compare" && !otherPaperId)}
229:             onClick={() => {
230:               if (tool === "rewrite") handleRewrite();
231:               else if (tool === "compare") handleCompare();
232:               else handleReview();
233:             }}
234:           >
235:             {isRunning ? (
236:               <Loader2 className="mr-2 h-4 w-4 animate-spin" />
237:             ) : null}
238:             {isRunning
239:               ? "Working..."
240:               : tool === "rewrite"
241:                 ? "Rewrite"
242:                 : tool === "compare"
243:                   ? "Compare papers"
244:                   : "Generate review"}
245:           </Button>
246:         </div>
247:         {output !== null && (
248:           <div className="rounded-lg border bg-muted/40 p-4 text-sm max-h-80 overflow-y-auto">
249:             {renderToolOutput(tool, output)}
250:           </div>
251:         )}
252:       </CardContent>
253:     </Card>
254:   );
255: }
</file>

