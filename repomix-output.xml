106: const getOrCreateStripeCustomer = async (
107:   userId: string,
108:   email: string,
109:   name?: string
110: ): Promise<string> => {
111:   const user = await prismaClient.$queryRaw<
112:     Array<{ stripeCustomerId: string | null }>
113:   >`
114:     SELECT "stripeCustomerId"
115:     FROM "User"
116:     WHERE id = ${userId}
117:     LIMIT 1
118:   `;
119:   if (user[0]?.stripeCustomerId) {
120:     return user[0].stripeCustomerId;
121:   }
122:   try {
123:     const customer = await stripe.customers.create({
124:       email,
125:       name: name || undefined,
126:       metadata: {
127:         userId,
128:       },
129:     });
130:     await prismaClient.$executeRaw`
131:       UPDATE "User"
132:       SET "stripeCustomerId" = ${customer.id}, "updatedAt" = NOW()
133:       WHERE id = ${userId}
134:     `;
135:     return customer.id;
136:   } catch (error) {
137:     if (isStripeError(error)) {
138:       logStripeError(error, "getOrCreateStripeCustomer");
139:     }
140:     throw BillingError.checkoutSessionCreationFailed(
141:       "Failed to create Stripe customer"
142:     );
143:   }
144: };
145: /**
146:  * Create a Stripe Checkout session for plan upgrade
147:  * Simplified to accept priceId directly (matches example project pattern)
148:  */
149: export const createCheckoutSession = async (
150:   userId: string,
151:   email: string,
152:   name: string | undefined,
153:   input: CreateCheckoutSessionInput
154: ): Promise<{ sessionId: string; url: string }> => {
155:   const { priceId, workspaceId, successUrl, cancelUrl } = input;
156:   // Resolve the plan from the DB (plan edits repoint stripePriceId at newly
157:   // created Stripe prices, so the env list alone is stale). Env-configured
158:   // price IDs remain valid as a legacy fallback for plans without a row.
159:   const planRow = await prismaClient.$queryRaw<Array<{ active: boolean; code: string }>>`
160:     SELECT active, code
161:     FROM "Plan"
162:     WHERE "stripePriceId" = ${priceId}
163:       AND "isDeleted" = false
164:     LIMIT 1
165:   `;
166:   let planTier: string;
167:   if (planRow.length > 0) {
168:     // A plan deactivated in the admin panel must not accept new checkouts
169:     if (!planRow[0].active) {
170:       throw BillingError.planUnavailable();
171:     }
172:     // Tier from the stable plan code (e.g. pro_monthly -> pro) — the price ID
173:     // itself changes whenever the plan price is edited.
174:     planTier = planRow[0].code.split("_")[0];
175:   } else {
176:     if (!isValidPriceId(priceId)) {
177:       throw BillingError.checkoutSessionCreationFailed(
178:         `Invalid or unconfigured Stripe price ID: ${priceId}. Update STRIPE_PRICE_* env variables.`
179:       );
180:     }
181:     planTier = getPlanTierFromPriceId(priceId);
182:   }
183:   // Get or create Stripe customer
184:   const customerId = await getOrCreateStripeCustomer(userId, email, name);
185:   // Check if user already has an active subscription
186:   const existingSubscription = await prismaClient.$queryRaw<
187:     Array<{ id: string; status: string }>
188:   >`
189:     SELECT id, status
190:     FROM "Subscription"
191:     WHERE "userId" = ${userId}
192:       AND status = 'ACTIVE'
193:       AND "isDeleted" = false
194:     LIMIT 1
195:   `;
196:   if (existingSubscription.length > 0) {
197:     throw BillingError.alreadySubscribed(userId);
198:   }
199:   // Verify workspace ownership/membership when a workspace is attached
200:   if (workspaceId) {
201:     const access = await prismaClient.$queryRaw<Array<{ isMember: boolean }>>`
202:       SELECT EXISTS (
203:         SELECT 1
204:         FROM "Workspace" w
205:         WHERE w.id = ${workspaceId}
206:           AND w."isDeleted" = false
207:           AND (
208:             w."ownerId" = ${userId}
209:             OR EXISTS (
210:               SELECT 1
211:               FROM "WorkspaceMember" m
212:               WHERE m."workspaceId" = w.id
213:                 AND m."userId" = ${userId}
214:                 AND m."isDeleted" = false
215:             )
216:           )
217:       ) AS "isMember"
218:     `;
219:     if (!access[0]?.isMember) {
220:       throw BillingError.workspaceAccessDenied(workspaceId);
221:     }
222:   }
223:   // Determine trial eligibility
224:   const hasUsedTrial = await prismaClient.$queryRaw<Array<{ count: bigint }>>`
225:     SELECT COUNT(*)::int as count
226:     FROM "Subscription"
227:     WHERE "userId" = ${userId}
228:       AND "trialEnd" IS NOT NULL
229:       AND "isDeleted" = false
230:   `;
231:   const allowTrial =
232:     Number(hasUsedTrial[0]?.count || 0) === 0 &&
233:     existingSubscription.length === 0;
234:   try {
235:     // Create Checkout session with stable idempotency key
236:     // (unique per user+price+workspace — retries reuse it, preventing duplicates)
237:     const idempotencyKey = `checkout_${userId}_${priceId}_${workspaceId || "personal"}`;
238:     const session = await stripe.checkout.sessions.create(
239:       {
240:         customer: customerId,
241:         mode: "subscription",
242:         payment_method_types: ["card"],
243:         line_items: [
244:           {
245:             price: priceId,
246:             quantity: 1,
247:           },
248:         ],
249:         success_url:
250:           successUrl ||
251:           `${(config.reset_pass_link || config.frontend_url || "http://localhost:3000").replace("/reset-password", "")}/dashboard/billing?session_id={CHECKOUT_SESSION_ID}`,
252:         cancel_url:
253:           cancelUrl ||
254:           `${(config.reset_pass_link || config.frontend_url || "http:
255:         subscription_data: allowTrial
256:           ? {
257:               trial_period_days: TRIAL_PERIOD_DAYS,
258:               metadata: {
259:                 userId,
260:                 workspaceId: workspaceId || "",
261:                 planTier,
262:               },
263:             }
264:           : {
265:               metadata: {
266:                 userId,
267:                 workspaceId: workspaceId || "",
268:                 planTier,
269:               },
270:             },
271:         metadata: {
272:           userId,
273:           workspaceId: workspaceId || "",
274:           planTier,
275:           priceId,
276:         },
277:         allow_promotion_codes: true,
278:         billing_address_collection: "auto",
279:       },
280:       {
281:         idempotencyKey,
282:       }
283:     );
284:     if (!session.url) {
285:       throw BillingError.checkoutSessionCreationFailed(
286:         "No session URL returned"
287:       );
288:     }
289:     return {
290:       sessionId: session.id,
291:       url: session.url,
292:     };
293:   } catch (error) {
294:     if (isStripeError(error)) {
295:       logStripeError(error, "createCheckoutSession");
296:     }
297:     throw BillingError.checkoutSessionCreationFailed(
298:       error instanceof Error ? error.message : "Unknown error"
299:     );
300:   }
301: };
302: export const createPortalSession = async (
303:   userId: string,
304:   input: CreatePortalSessionInput
305: ): Promise<{ url: string }> => {
306:   const { returnUrl } = input;
307:   const user = await prismaClient.$queryRaw<
308:     Array<{ stripeCustomerId: string | null }>
309:   >`
310:     SELECT "stripeCustomerId"
311:     FROM "User"
312:     WHERE id = ${userId}
313:     LIMIT 1
314:   `;
315:   if (!user[0]?.stripeCustomerId) {
316:     throw BillingError.stripeCustomerNotFound(userId);
317:   }
318:   try {
319:     const session = await stripe.billingPortal.sessions.create({
320:       customer: user[0].stripeCustomerId,
321:       return_url: returnUrl || config.stripe.billingPortalReturnUrl,
322:     });
323:     return {
324:       url: session.url,
325:     };
326:   } catch (error) {
327:     if (isStripeError(error)) {
328:       logStripeError(error, "createPortalSession");
329:     }
330:     throw BillingError.portalSessionCreationFailed(
331:       error instanceof Error ? error.message : "Unknown error"
332:     );
333:   }
334: };
335: export const getUserSubscription = async (
336:   userId: string,
337:   workspaceId?: string
338: ) => {
339:   const subscription = await prismaClient.$queryRaw<
340:     Array<{
341:       id: string;
342:       status: string;
343:       planId: string;
344:       currentPeriodEnd: Date | null;
345:       cancelAtPeriodEnd: boolean;
346:       trialEnd: Date | null;
347:       seats: number;
348:       providerSubscriptionId: string | null;
349:     }>
350:   >`
351:     SELECT
352:       s.id,
353:       s.status,
354:       s."planId",
355:       s."currentPeriodEnd",
356:       s."cancelAtPeriodEnd",
357:       s."trialEnd",
358:       s.seats,
359:       s."providerSubscriptionId"
360:     FROM "Subscription" s
361:     WHERE s."userId" = ${userId}
362:       ${workspaceId ? Prisma.sql`AND s."workspaceId" = ${workspaceId}` : Prisma.empty}
363:       AND s."isDeleted" = false
364:     ORDER BY
365:       CASE s.status
366:         WHEN 'ACTIVE' THEN 0
367:         WHEN 'PAST_DUE' THEN 1
368:         ELSE 2
369:       END,
370:       s."createdAt" DESC
371:     LIMIT 1
372:   `;
373:   if (subscription.length === 0) {
374:     return null;
375:   }
376:   const plan = await prismaClient.$queryRaw<
377:     Array<{
378:       code: string;
379:       name: string;
380:       features: any;
381:     }>
382:   >`
383:     SELECT code, name, features
384:     FROM "Plan"
385:     WHERE id = ${subscription[0].planId}
386:       AND "isDeleted" = false
387:     LIMIT 1
388:   `;
389:   return {
390:     ...subscription[0],
391:     plan: plan[0] || null,
392:     features: getPlanFeatures(plan[0]?.code),
393:   };
394: };
395: const getPlanFeatures = (planCode?: string | null): Record<string, unknown> => {
396:   if (!planCode) {
397:     return {};
398:   }
399:   const tier = planCode.split("_")[0] as keyof typeof PLAN_FEATURES;
400:   return PLAN_FEATURES[tier] || {};
401: };
402: export const cancelSubscription = async (
403:   userId: string,
404:   workspaceId?: string
405: ): Promise<void> => {
406:   const subscription = await getUserSubscription(userId, workspaceId);
407:   if (!subscription) {
408:     throw BillingError.subscriptionNotFound(userId);
409:   }
410:   if (!subscription.providerSubscriptionId) {
411:     throw new Error("Subscription missing Stripe subscription ID");
412:   }
413:   try {
414:     await stripe.subscriptions.update(subscription.providerSubscriptionId, {
415:       cancel_at_period_end: true,
416:     });
417:     await prismaClient.$executeRaw`
418:       UPDATE "Subscription"
419:       SET "cancelAtPeriodEnd" = true, "updatedAt" = NOW()
420:       WHERE id = ${subscription.id}
421:     `;
422:   } catch (error) {
423:     if (isStripeError(error)) {
424:       logStripeError(error, "cancelSubscription");
425:     }
426:     throw new Error(
427:       `Failed to cancel subscription: ${error instanceof Error ? error.message : "Unknown error"}`
428:     );
429:   }
430: };
431: /**
432:  * Reactivate a canceled subscription
433:  */
434: export const reactivateSubscription = async (
435:   userId: string,
436:   workspaceId?: string
437: ): Promise<void> => {
438:   const subscription = await getUserSubscription(userId, workspaceId);
439:   if (!subscription) {
440:     throw BillingError.subscriptionNotFound(userId);
441:   }
442:   if (!subscription.providerSubscriptionId) {
443:     throw new Error("Subscription missing Stripe subscription ID");
444:   }
445:   try {
446:     // Reactivate via Stripe
447:     await stripe.subscriptions.update(subscription.providerSubscriptionId, {
448:       cancel_at_period_end: false,
449:     });
450:     // Update local record
451:     await prismaClient.$executeRaw`
452:       UPDATE "Subscription"
453:       SET "cancelAtPeriodEnd" = false, "updatedAt" = NOW()
454:       WHERE id = ${subscription.id}
455:     `;
456:   } catch (error) {
457:     if (isStripeError(error)) {
458:       logStripeError(error, "reactivateSubscription");
459:     }
460:     throw new Error(
461:       `Failed to reactivate subscription: ${error instanceof Error ? error.message : "Unknown error"}`
462:     );
463:   }
464: };
465: export const billingService = {
466:   createCheckoutSession,
467:   createPortalSession,
468:   getUserSubscription,
469:   cancelSubscription,
470:   reactivateSubscription,
471:   getOrCreateStripeCustomer,
472:   getAvailablePrices,
473:   getPublicCatalog,
474: };
