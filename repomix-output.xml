 1: import type { TUser } from "@/types/user";
 2: import { createSlice, PayloadAction } from "@reduxjs/toolkit";
 3: import { clearAuthCookie, setAuthCookie } from "@/lib/auth/authCookies";
 4: export interface AuthState {
 5:   user: TUser | null;
 6:   accessToken: string | null;
 7:   isAuthenticated: boolean;
 8:   isLoading: boolean;
 9: }
10: const initialState: AuthState = {
11:   user: null,
12:   accessToken: null,
13:   isAuthenticated: false,
14:   isLoading: true,
15: };
16: const authSlice = createSlice({
17:   name: "auth",
18:   initialState,
19:   reducers: {
20:     setCredentials: (
21:       state,
22:       action: PayloadAction<{ user: TUser; accessToken: string }>
23:     ) => {
24:       state.user = action.payload.user;
25:       state.accessToken = action.payload.accessToken;
26:       state.isAuthenticated = true;
27:       state.isLoading = false;
28:       setAuthCookie();
29:     },
30:     clearCredentials: (state) => {
31:       state.user = null;
32:       state.accessToken = null;
33:       state.isAuthenticated = false;
34:       state.isLoading = false;
35:       clearAuthCookie();
36:     },
37:     setLoading: (state, action: PayloadAction<boolean>) => {
38:       state.isLoading = action.payload;
39:     },
40:     updateUser: (state, action: PayloadAction<Partial<TUser>>) => {
41:       if (state.user) {
42:         state.user = { ...state.user, ...action.payload };
43:       }
44:     },
45:   },
46: });
47: export const { setCredentials, clearCredentials, setLoading, updateUser } =
48:   authSlice.actions;
49: export default authSlice.reducer;
50: export const selectCurrentUser = (state: { auth: AuthState }) =>
51:   state.auth.user;
52: export const selectAccessToken = (state: { auth: AuthState }) =>
53:   state.auth.accessToken;
54: export const selectIsAuthenticated = (state: { auth: AuthState }) =>
55:   state.auth.isAuthenticated;
56: export const selectAuthLoading = (state: { auth: AuthState }) =>
57:   state.auth.isLoading;
