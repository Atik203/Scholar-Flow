<file path="apps/backend/src/app/modules/Billing/webhook.controller.ts">
  1: import { Prisma } from "@prisma/client";
  2: import { Request, Response } from "express";
  3: import Stripe from "stripe";
  4: import config from "../../config";
  5: import catchAsync from "../../shared/catchAsync";
  6: import prismaClient from "../../shared/prisma";
  7: import stripe, { getRoleFromPriceId } from "../../shared/stripe";
  8: import { STRIPE_WEBHOOK_EVENTS, SUBSCRIPTION_STATUS } from "./billing.constant";
  9: import { BillingError } from "./billing.error";
 10: type RawBodyRequest = Request & { rawBody?: Buffer | string };
 11: type MutableRawBodyRequest = RawBodyRequest & { body?: unknown };
 12: type StripeWebhookEventType =
 13:   (typeof STRIPE_WEBHOOK_EVENTS)[keyof typeof STRIPE_WEBHOOK_EVENTS];
 14: const logDebug = (...args: unknown[]) => {
 15:   if (process.env.NODE_ENV !== "production") {
 16:     console.log(...args);
 17:   }
 18: };
 19: export const handleStripeWebhook = catchAsync(
 20:   async (req: Request, res: Response): Promise<void> => {
 21:     const sig = req.headers["stripe-signature"];
 22:     if (!sig) {
 23:       throw BillingError.webhookSignatureVerificationFailed();
 24:     }
 25:     if (!config.stripe.webhook_secret) {
 26:       throw new Error("STRIPE_WEBHOOK_SECRET not configured");
 27:     }
 28:     const rawBody = await getRawBodyBuffer(req as RawBodyRequest);
 29:     let event: Stripe.Event;
 30:     try {
 31:       event = stripe.webhooks.constructEvent(
 32:         rawBody,
 33:         sig,
 34:         config.stripe.webhook_secret
 35:       );
 36:     } catch (error) {
 37:       const errorMessage =
 38:         error instanceof Error ? error.message : "Unknown verification error";
 39:       console.error("Webhook signature verification failed", {
 40:         message: errorMessage,
 41:       });
 42:       throw BillingError.webhookSignatureVerificationFailed();
 43:     }
 44:     if (process.env.NODE_ENV === "development") {
 45:       console.log(`Received webhook event: ${event.type}`);
 46:     }
 47:     const existingEvent = await prismaClient.$queryRaw<Array<{ id: string }>>`
 48:       SELECT id
 49:       FROM "WebhookEvent"
 50:       WHERE provider = 'STRIPE'
 51:         AND "eventId" = ${event.id}
 52:       LIMIT 1
 53:     `;
 54:     if (existingEvent.length > 0) {
 55:       if (process.env.NODE_ENV !== "production") {
 56:         console.log(`Duplicate webhook event: ${event.id}, skipping`);
 57:       }
 58:       res.status(200).json({ received: true, duplicate: true });
 59:       return;
 60:     }
 61:     await prismaClient.$executeRaw`
 62:       INSERT INTO "WebhookEvent" (id, provider, "eventId", type, payload, status, "receivedAt", "createdAt", "updatedAt", "isDeleted")
 63:       VALUES (
 64:         gen_random_uuid(),
 65:         'STRIPE',
 66:         ${event.id},
 67:         ${event.type},
 68:         ${JSON.stringify(event)}::jsonb,
 69:         'pending',
 70:         NOW(),
 71:         NOW(),
 72:         NOW(),
 73:         false
 74:       )
 75:     `;
 76:     // Process event
 77:     try {
 78:       await processStripeEvent(event);
 79:       // Mark event as processed
 80:       await prismaClient.$executeRaw`
 81:         UPDATE "WebhookEvent"
 82:         SET status = 'processed', "processedAt" = NOW(), "updatedAt" = NOW()
 83:         WHERE "eventId" = ${event.id} AND provider = 'STRIPE'
 84:       `;
 85:     } catch (error) {
 86:       // Mark event as failed
 87:       const errorMessage =
 88:         error instanceof Error ? error.message : "Unknown error";
 89:       await prismaClient.$executeRaw`
 90:         UPDATE "WebhookEvent"
 91:         SET status = 'failed', error = ${errorMessage}, attempts = attempts + 1, "updatedAt" = NOW()
 92:         WHERE "eventId" = ${event.id} AND provider = 'STRIPE'
 93:       `;
 94:       console.error(`Failed to process webhook event ${event.id}:`, error);
 95:     }
 96:     res.status(200).json({ received: true });
 97:   }
 98: );
 99: /**
100:  * Process Stripe webhook events
101:  */
102: async function processStripeEvent(event: Stripe.Event): Promise<void> {
103:   switch (event.type) {
104:     case STRIPE_WEBHOOK_EVENTS.CHECKOUT_SESSION_COMPLETED:
105:       await handleCheckoutSessionCompleted(
106:         event.data.object as Stripe.Checkout.Session
107:       );
108:       break;
109:     case STRIPE_WEBHOOK_EVENTS.CUSTOMER_SUBSCRIPTION_CREATED:
110:     case STRIPE_WEBHOOK_EVENTS.CUSTOMER_SUBSCRIPTION_UPDATED:
111:       await handleSubscriptionUpdated(
112:         event.data.object as Stripe.Subscription,
113:         event.type as StripeWebhookEventType
114:       );
115:       break;
116:     case STRIPE_WEBHOOK_EVENTS.CUSTOMER_SUBSCRIPTION_DELETED:
117:       await handleSubscriptionDeleted(event.data.object as Stripe.Subscription);
118:       break;
119:     case STRIPE_WEBHOOK_EVENTS.INVOICE_PAID:
120:       await handleInvoicePaid(event.data.object as Stripe.Invoice);
121:       break;
122:     case STRIPE_WEBHOOK_EVENTS.INVOICE_PAYMENT_FAILED:
123:       await handleInvoicePaymentFailed(event.data.object as Stripe.Invoice);
124:       break;
125:     default:
126:       logDebug(`Unhandled event type: ${event.type}`);
127:   }
128: }
129: /**
130:  * Extract raw body buffer from request for Stripe signature verification
131:  * Handles both local (express.raw) and Vercel serverless (direct Buffer) cases
132:  */
133: async function getRawBodyBuffer(req: RawBodyRequest): Promise<Buffer> {
134:   // Case 1: Check rawBody property (custom middleware)
135:   const possibleRawBody = req.rawBody;
136:   if (Buffer.isBuffer(possibleRawBody)) {
137:     logDebug("[Webhook] Raw body extracted from req.rawBody (Buffer)");
138:     (req as RawBodyRequest).rawBody = possibleRawBody;
139:     return possibleRawBody;
140:   }
141:   if (typeof possibleRawBody === "string") {
142:     logDebug("[Webhook] Raw body extracted from req.rawBody (string)");
143:     const buffer = Buffer.from(possibleRawBody, "utf8");
144:     (req as RawBodyRequest).rawBody = buffer;
145:     (req as MutableRawBodyRequest).body = buffer;
146:     return buffer;
147:   }
148:   // Case 2: Check req.body (Vercel serverless or express.raw)
149:   if (Buffer.isBuffer(req.body)) {
150:     logDebug(
151:       "[Webhook] Raw body extracted from req.body (Buffer) - Vercel mode"
152:     );
153:     (req as RawBodyRequest).rawBody = req.body;
154:     return req.body;
155:   }
156:   if (typeof req.body === "string") {
157:     logDebug("[Webhook] Raw body extracted from req.body (string)");
158:     const buffer = Buffer.from(req.body, "utf8");
159:     (req as RawBodyRequest).rawBody = buffer;
160:     (req as MutableRawBodyRequest).body = buffer;
161:     return buffer;
162:   }
163:   // Case 3: Check if body is already parsed JSON (should not happen, but handle gracefully)
164:   if (req.body && typeof req.body === "object") {
165:     console.error(
166:       "[Webhook] Body already parsed as JSON - cannot verify signature"
167:     );
168:     console.error(
169:       "[Webhook] This indicates body parsing middleware is running before webhook route"
170:     );
171:     throw BillingError.webhookRawBodyMissing();
172:   }
173:   // Case 4: Attempt to read from request stream if not yet consumed (e.g., serverless environments)
174:   if (!req.readableEnded && req.readable !== false) {
175:     const chunks: Buffer[] = [];
176:     for await (const chunk of req) {
177:       if (typeof chunk === "string") {
178:         chunks.push(Buffer.from(chunk));
179:       } else {
180:         chunks.push(Buffer.from(chunk));
181:       }
182:     }
183:     if (chunks.length > 0) {
184:       const buffer = Buffer.concat(chunks);
185:       (req as RawBodyRequest).rawBody = buffer;
186:       (req as MutableRawBodyRequest).body = buffer;
187:       logDebug("[Webhook] Raw body captured by manual stream read");
188:       return buffer;
189:     }
190:   }
191:   console.error(
192:     "[Webhook] No raw body found in req stream after fallback attempts"
193:   );
194:   throw BillingError.webhookRawBodyMissing();
195: }
196: /**
197:  * Handle checkout.session.completed event
198:  */
199: async function handleCheckoutSessionCompleted(
200:   session: Stripe.Checkout.Session
201: ): Promise<void> {
202:   const userId = session.metadata?.userId;
203:   const workspaceId = session.metadata?.workspaceId || null;
204:   const stripePriceId = session.metadata?.priceId;
205:   const planTier = session.metadata?.planTier ?? null;
206:   if (!userId || !stripePriceId) {
207:     throw new Error("Missing required metadata in checkout session");
208:   }
209:   // Get subscription from Stripe
210:   if (!session.subscription) {
211:     throw new Error("No subscription in checkout session");
212:   }
213:   const subscriptionId =
214:     typeof session.subscription === "string"
215:       ? session.subscription
216:       : session.subscription.id;
217:   const stripeSubscription = (await stripe.subscriptions.retrieve(
218:     subscriptionId
219:   )) as Stripe.Subscription;
220:   const { currentPeriodStart, currentPeriodEnd } =
221:     getSubscriptionPeriodBounds(stripeSubscription);
222:   const stripeCustomerId =
223:     typeof stripeSubscription.customer === "string"
224:       ? stripeSubscription.customer
225:       : (stripeSubscription.customer?.id ?? null);
226:   if (currentPeriodEnd === null) {
227:     throw BillingError.webhookProcessingFailed(
228:       STRIPE_WEBHOOK_EVENTS.CHECKOUT_SESSION_COMPLETED,
229:       "Stripe subscription missing current period end"
230:     );
231:   }
232:   // Determine billing interval (month/year) from Stripe subscription
233:   const subscriptionInterval =
234:     stripeSubscription.items.data[0]?.plan?.interval ?? "month";
235:   const normalizedInterval =
236:     subscriptionInterval === "year" ? "annual" : "monthly";
237:   // Find plan by Stripe price ID
238:   const planByPrice = await prismaClient.$queryRaw<
239:     Array<{ id: string; code: string }>
240:   >`
241:     SELECT id, code
242:     FROM "Plan"
243:     WHERE "stripePriceId" = ${stripePriceId}
244:       AND "isDeleted" = false
245:     LIMIT 1
246:   `;
247:   let planId = planByPrice[0]?.id ?? null;
248:   if (!planId && planTier) {
249:     const fallbackCode = `${planTier}_${normalizedInterval}`;
250:     const fallbackPlan = await prismaClient.$queryRaw<Array<{ id: string }>>`
251:       SELECT id
252:       FROM "Plan"
253:       WHERE code = ${fallbackCode}
254:         AND "isDeleted" = false
255:       LIMIT 1
256:     `;
257:     planId = fallbackPlan[0]?.id ?? null;
258:   }
259:   if (!planId) {
260:     throw new Error(`Plan not found for Stripe price ID: ${stripePriceId}`);
261:   }
262:   // Create subscription record
263:   const status = mapStripeStatus(stripeSubscription.status);
264:   const existingSubscription = await prismaClient.$queryRaw<
265:     Array<{ id: string }>
266:   >`
267:     SELECT id
268:     FROM "Subscription"
269:     WHERE "providerSubscriptionId" = ${stripeSubscription.id}
270:       AND "isDeleted" = false
271:     LIMIT 1
272:   `;
273:   const canceledAtSql =
274:     stripeSubscription.canceled_at != null
275:       ? Prisma.sql`to_timestamp(${Number(stripeSubscription.canceled_at)})`
276:       : Prisma.sql`NULL`;
277:   if (existingSubscription.length > 0) {
278:     await prismaClient.$executeRaw`
279:       UPDATE "Subscription"
280:       SET
281:         "planId" = ${planId},
282:         "workspaceId" = ${workspaceId},
283:         status = ${status}::"SubscriptionStatus",
284:         provider = 'STRIPE',
285:         "providerCustomerId" = ${stripeCustomerId},
286:         "providerSubscriptionId" = ${stripeSubscription.id},
287:         "cancelAtPeriodEnd" = ${stripeSubscription.cancel_at_period_end},
288:         "currentPeriodStart" = ${toTimestampSql(currentPeriodStart)},
289:         "currentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
290:         "trialStart" = ${toTimestampSql(stripeSubscription.trial_start ?? null)},
291:         "trialEnd" = ${toTimestampSql(stripeSubscription.trial_end ?? null)},
292:         "canceledAt" = ${canceledAtSql},
293:         "expiresAt" = ${toTimestampSql(currentPeriodEnd)},
294:         "updatedAt" = NOW()
295:       WHERE id = ${existingSubscription[0].id}
296:     `;
297:   } else {
298:     await prismaClient.$executeRaw`
299:       INSERT INTO "Subscription" (
300:         id,
301:         "userId",
302:         "workspaceId",
303:         "planId",
304:         status,
305:         provider,
306:         "providerCustomerId",
307:         "providerSubscriptionId",
308:         "cancelAtPeriodEnd",
309:         "currentPeriodStart",
310:         "currentPeriodEnd",
311:         "trialStart",
312:         "trialEnd",
313:         "startedAt",
314:         "expiresAt",
315:         "createdAt",
316:         "updatedAt",
317:         "isDeleted"
318:       ) VALUES (
319:         gen_random_uuid(),
320:         ${userId},
321:         ${workspaceId},
322:         ${planId},
323:         ${status}::"SubscriptionStatus",
324:         'STRIPE',
325:         ${stripeCustomerId},
326:         ${stripeSubscription.id},
327:         ${stripeSubscription.cancel_at_period_end},
328:         ${toTimestampSql(currentPeriodStart)},
329:         ${toTimestampSql(currentPeriodEnd)},
330:         ${toTimestampSql(stripeSubscription.trial_start ?? null)},
331:         ${toTimestampSql(stripeSubscription.trial_end ?? null)},
332:         NOW(),
333:         ${toTimestampSql(currentPeriodEnd)},
334:         NOW(),
335:         NOW(),
336:         false
337:       )
338:     `;
339:   }
340:   // Update user role and Stripe subscription fields based on price ID
341:   // stripePriceId comes from session metadata at function start
342:   const userRole = getRoleFromPriceId(stripePriceId);
343:   await prismaClient.$executeRaw`
344:     UPDATE "User"
345:     SET
346:       role = ${userRole}::"Role",
347:       "stripeSubscriptionId" = ${stripeSubscription.id},
348:       "stripePriceId" = ${stripePriceId},
349:       "stripeCurrentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
350:       "updatedAt" = NOW()
351:     WHERE id = ${userId}
352:   `;
353:   logDebug(
354:     `User ${userId} role updated to ${userRole} with subscription ${stripeSubscription.id}`
355:   );
356:   logDebug(
357:     `Subscription created/updated for user ${userId}: ${stripeSubscription.id}`
358:   );
359: }
360: /**
361:  * Handle subscription updated event
362:  */
363: async function handleSubscriptionUpdated(
364:   subscription: Stripe.Subscription,
365:   eventType: StripeWebhookEventType
366: ): Promise<void> {
367:   const status = mapStripeStatus(subscription.status);
368:   const { currentPeriodStart, currentPeriodEnd } =
369:     getSubscriptionPeriodBounds(subscription);
370:   if (currentPeriodEnd === null) {
371:     throw BillingError.webhookProcessingFailed(
372:       eventType,
373:       "Stripe subscription missing current period end"
374:     );
375:   }
376:   await prismaClient.$executeRaw`
377:     UPDATE "Subscription"
378:     SET
379:       status = ${status}::"SubscriptionStatus",
380:       "currentPeriodStart" = ${toTimestampSql(currentPeriodStart)},
381:       "currentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
382:       "cancelAtPeriodEnd" = ${subscription.cancel_at_period_end},
383:       "canceledAt" = ${subscription.canceled_at ? Prisma.sql`to_timestamp(${Number(subscription.canceled_at)})` : null},
384:       "expiresAt" = ${toTimestampSql(currentPeriodEnd)},
385:       "updatedAt" = NOW()
386:     WHERE "providerSubscriptionId" = ${subscription.id}
387:   `;
388:   const stripePriceId = subscription.items.data[0]?.price?.id || null;
389:   if (stripePriceId) {
390:     const user = await prismaClient.$queryRaw<Array<{ id: string }>>`
391:       SELECT id
392:       FROM "User"
393:       WHERE "stripeCustomerId" = ${subscription.customer as string}
394:       LIMIT 1
395:     `;
396:     if (user.length > 0) {
397:       const userId = user[0].id;
398:       const userRole = getRoleFromPriceId(stripePriceId);
399:       if (status === SUBSCRIPTION_STATUS.ACTIVE) {
400:         await prismaClient.$executeRaw`
401:           UPDATE "User"
402:           SET
403:             role = ${userRole}::"Role",
404:             "stripeSubscriptionId" = ${subscription.id},
405:             "stripePriceId" = ${stripePriceId},
406:             "stripeCurrentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
407:             "updatedAt" = NOW()
408:           WHERE id = ${userId}
409:         `;
410:         logDebug(`User ${userId} role updated to ${userRole}`);
411:       } else {
412:         // Just update subscription fields without changing role
413:         await prismaClient.$executeRaw`
414:           UPDATE "User"
415:           SET
416:             "stripeSubscriptionId" = ${subscription.id},
417:             "stripePriceId" = ${stripePriceId},
418:             "stripeCurrentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
419:             "updatedAt" = NOW()
420:           WHERE id = ${userId}
421:         `;
422:       }
423:     }
424:   }
425:   logDebug(`Subscription updated: ${subscription.id}`);
426: }
427: /**
428:  * Handle subscription deleted event
429:  */
430: async function handleSubscriptionDeleted(
431:   subscription: Stripe.Subscription
432: ): Promise<void> {
433:   await prismaClient.$executeRaw`
434:     UPDATE "Subscription"
435:     SET
436:       status = 'CANCELED'::"SubscriptionStatus",
437:       "canceledAt" = NOW(),
438:       "updatedAt" = NOW()
439:     WHERE "providerSubscriptionId" = ${subscription.id}
440:   `;
441:   // Find user by Stripe customer ID and revert to free tier
442:   const user = await prismaClient.$queryRaw<Array<{ id: string }>>`
443:     SELECT id
444:     FROM "User"
445:     WHERE "stripeCustomerId" = ${subscription.customer as string}
446:     LIMIT 1
447:   `;
448:   if (user.length > 0) {
449:     const userId = user[0].id;
450:     // Revert user to RESEARCHER role (free tier) and clear Stripe fields
451:     await prismaClient.$executeRaw`
452:       UPDATE "User"
453:       SET
454:         role = 'RESEARCHER',
455:         "stripeSubscriptionId" = NULL,
456:         "stripePriceId" = NULL,
457:         "stripeCurrentPeriodEnd" = NULL,
458:         "updatedAt" = NOW()
459:       WHERE id = ${userId}
460:     `;
461:     logDebug(`User ${userId} role reverted to RESEARCHER (free tier)`);
462:   }
463:   logDebug(`Subscription canceled: ${subscription.id}`);
464: }
465: /**
466:  * Handle invoice paid event
467:  */
468: async function handleInvoicePaid(invoice: Stripe.Invoice): Promise<void> {
469:   const subscriptionField = getSubscriptionFromInvoice(invoice);
470:   if (!subscriptionField) {
471:     return;
472:   }
473:   const subscriptionId =
474:     typeof subscriptionField === "string"
475:       ? subscriptionField
476:       : subscriptionField.id;
477:   // Find subscription
478:   const subscription = await prismaClient.$queryRaw<
479:     Array<{ id: string; userId: string }>
480:   >`
481:     SELECT id, "userId"
482:     FROM "Subscription"
483:     WHERE "providerSubscriptionId" = ${subscriptionId}
484:       AND "isDeleted" = false
485:     LIMIT 1
486:   `;
487:   if (subscription.length === 0) {
488:     console.warn(`Subscription not found for invoice: ${invoice.id}`);
489:     return;
490:   }
491:   // Record payment
492:   await prismaClient.$executeRaw`
493:     INSERT INTO "Payment" (
494:       id,
495:       "userId",
496:       "subscriptionId",
497:       provider,
498:       "amountCents",
499:       currency,
500:       "transactionId",
501:       status,
502:       raw,
503:       "createdAt",
504:       "updatedAt",
505:       "isDeleted"
506:     ) VALUES (
507:       gen_random_uuid(),
508:       ${subscription[0].userId},
509:       ${subscription[0].id},
510:       'STRIPE',
511:       ${invoice.amount_paid},
512:       ${invoice.currency.toUpperCase()},
513:       ${invoice.id},
514:       'SUCCEEDED',
515:       ${JSON.stringify(invoice)}::jsonb,
516:       NOW(),
517:       NOW(),
518:       false
519:     )
520:     ON CONFLICT ("transactionId")
521:     DO UPDATE SET
522:       status = 'SUCCEEDED',
523:       "updatedAt" = NOW()
524:   `;
525:   logDebug(`Invoice paid recorded: ${invoice.id}`);
526: }
527: /**
528:  * Handle invoice payment failed event
529:  */
530: async function handleInvoicePaymentFailed(
531:   invoice: Stripe.Invoice
532: ): Promise<void> {
533:   const subscriptionField = getSubscriptionFromInvoice(invoice);
534:   if (!subscriptionField) {
535:     return;
536:   }
537:   const subscriptionId =
538:     typeof subscriptionField === "string"
539:       ? subscriptionField
540:       : subscriptionField.id;
541:   // Update subscription status
542:   await prismaClient.$executeRaw`
543:     UPDATE "Subscription"
544:     SET
545:       status = 'PAST_DUE'::"SubscriptionStatus",
546:       "updatedAt" = NOW()
547:     WHERE "providerSubscriptionId" = ${subscriptionId}
548:   `;
549:   // TODO: Send notification to user about failed payment
550:   logDebug(`Invoice payment failed: ${invoice.id}`);
551: }
552: /**
553:  * Map Stripe subscription status to our enum
554:  */
555: function mapStripeStatus(stripeStatus: Stripe.Subscription.Status): string {
556:   switch (stripeStatus) {
557:     case "active":
558:     case "trialing":
559:       return SUBSCRIPTION_STATUS.ACTIVE;
560:     case "past_due":
561:       return SUBSCRIPTION_STATUS.PAST_DUE;
562:     case "canceled":
563:     case "unpaid":
564:       return SUBSCRIPTION_STATUS.CANCELED;
565:     case "incomplete":
566:     case "incomplete_expired":
567:       return SUBSCRIPTION_STATUS.EXPIRED;
568:     default:
569:       return SUBSCRIPTION_STATUS.EXPIRED;
570:   }
571: }
572: type SubscriptionPeriodBounds = {
573:   currentPeriodStart: number | null;
574:   currentPeriodEnd: number | null;
575: };
576: function toTimestampSql(seconds: number | null | undefined): Prisma.Sql {
577:   return seconds != null
578:     ? Prisma.sql`to_timestamp(${seconds})`
579:     : Prisma.sql`NULL`;
580: }
581: function getSubscriptionPeriodBounds(
582:   subscription: Stripe.Subscription
583: ): SubscriptionPeriodBounds {
584:   const items = subscription.items?.data ?? [];
585:   const referenceItem = items.reduce<Stripe.SubscriptionItem | undefined>(
586:     (latest, item) => {
587:       if (!latest) {
588:         return item;
589:       }
590:       return item.current_period_end > latest.current_period_end
591:         ? item
592:         : latest;
593:     },
594:     undefined
595:   );
596:   if (!referenceItem) {
597:     return {
598:       currentPeriodStart: null,
599:       currentPeriodEnd: null,
600:     };
601:   }
602:   return {
603:     currentPeriodStart: referenceItem.current_period_start ?? null,
604:     currentPeriodEnd: referenceItem.current_period_end ?? null,
605:   };
606: }
607: function getSubscriptionFromInvoice(
608:   invoice: Stripe.Invoice
609: ): string | Stripe.Subscription | null {
610:   const subscriptionDetails = invoice.parent?.subscription_details;
611:   if (!subscriptionDetails?.subscription) {
612:     return null;
613:   }
614:   return subscriptionDetails.subscription;
615: }
