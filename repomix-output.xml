    },
    {
      title: "Research Hours",
      value: "42h",
      change: "+8h",
      icon: Clock,
      color: "text-orange-600",
      bgColor: "bg-orange-100 dark:bg-orange-900/30",
    },
  ];

  if (role === "admin") {
    return [
      {
        title: "Total Users",
