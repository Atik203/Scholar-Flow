157:     runSummary({ ...lastRequest, refresh: true });
158:   };
159:   const handleSubmitForm = async (values: GenerateSummaryFormInput) => {
160:     const payload: PaperSummaryRequest = {
161:       instructions: values.instructions?.trim() || undefined,
162:       focusAreas: (values.focusAreas || []).map((area) => area.trim()),
163:       tone: values.tone,
164:       audience: values.audience,
165:       language: values.language?.trim() || undefined,
166:       wordLimit: values.wordLimit,
167:     };
