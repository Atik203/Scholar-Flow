14:   'AWS_BUCKET_NAME',
15:   'AWS_REGION',
16: ];
17: const missing = requiredEnv.filter((k) => !process.env[k]);
18: if (missing.length) {
19:   console.error('Missing env vars:', missing.join(', '));
20:   process.exit(1);
21: }
22: const bucket = process.env.AWS_BUCKET_NAME;
23: const region = process.env.AWS_REGION;
24: const s3 = new S3Client({
25:   region,
