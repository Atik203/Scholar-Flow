608:         VALUES (gen_random_uuid()::text, ${user.id}, ${theme}, ${language}, ${timezone},
609:                 ${emailDigest}, ${defaultCitationStyle}, ${compactMode},
610:                 ${metadata}::jsonb, NOW(), NOW())
611:       `;
