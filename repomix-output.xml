386:             WHEN cm."permission" = 'EDIT' AND cm.status = 'ACCEPTED' THEN 'EDIT'
387:             WHEN cm."permission" = 'VIEW' AND cm.status = 'ACCEPTED' THEN 'VIEW'
388:             ELSE NULL
