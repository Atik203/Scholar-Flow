484:       AND "isDeleted" = false
485:     LIMIT 1
486:   `;
487:   if (subscription.length === 0) {
488:     console.warn(`Subscription not found for invoice: ${invoice.id}`);
489:     return;
490:   }
491:   // Record payment
492:   await prismaClient.$executeRaw`
493:     INSERT INTO "Payment" (
494:       id,
495:       "userId",
496:       "subscriptionId",
497:       provider,
498:       "amountCents",
499:       currency,
500:       "transactionId",
501:       status,
502:       raw,
503:       "createdAt",
504:       "updatedAt",
505:       "isDeleted"
506:     ) VALUES (
507:       gen_random_uuid(),
508:       ${subscription[0].userId},
509:       ${subscription[0].id},
510:       'STRIPE',
511:       ${invoice.amount_paid},
512:       ${invoice.currency.toUpperCase()},
513:       ${invoice.id},
514:       'SUCCEEDED',
515:       ${JSON.stringify(invoice)}::jsonb,
516:       NOW(),
517:       NOW(),
518:       false
519:     )
520:     ON CONFLICT ("transactionId")
521:     DO UPDATE SET
522:       status = 'SUCCEEDED',
523:       "updatedAt" = NOW()
524:   `;
525:   logDebug(`Invoice paid recorded: ${invoice.id}`);
526: }
527: /**
528:  * Handle invoice payment failed event
529:  */
530: async function handleInvoicePaymentFailed(
531:   invoice: Stripe.Invoice
532: ): Promise<void> {
533:   const subscriptionField = getSubscriptionFromInvoice(invoice);
534:   if (!subscriptionField) {
535:     return;
536:   }
537:   const subscriptionId =
538:     typeof subscriptionField === "string"
539:       ? subscriptionField
540:       : subscriptionField.id;
541:   // Update subscription status
542:   await prismaClient.$executeRaw`
543:     UPDATE "Subscription"
544:     SET
545:       status = 'PAST_DUE'::"SubscriptionStatus",
546:       "updatedAt" = NOW()
547:     WHERE "providerSubscriptionId" = ${subscriptionId}
548:   `;
549:   // TODO: Send notification to user about failed payment
550:   logDebug(`Invoice payment failed: ${invoice.id}`);
551: }
552: /**
553:  * Map Stripe subscription status to our enum
554:  */
555: function mapStripeStatus(stripeStatus: Stripe.Subscription.Status): string {
556:   switch (stripeStatus) {
557:     case "active":
558:     case "trialing":
559:       return SUBSCRIPTION_STATUS.ACTIVE;
560:     case "past_due":
561:       return SUBSCRIPTION_STATUS.PAST_DUE;
562:     case "canceled":
563:     case "unpaid":
564:       return SUBSCRIPTION_STATUS.CANCELED;
565:     case "incomplete":
566:     case "incomplete_expired":
567:       return SUBSCRIPTION_STATUS.EXPIRED;
568:     default:
569:       return SUBSCRIPTION_STATUS.EXPIRED;
570:   }
571: }
572: type SubscriptionPeriodBounds = {
573:   currentPeriodStart: number | null;
574:   currentPeriodEnd: number | null;
575: };
576: function toTimestampSql(seconds: number | null | undefined): Prisma.Sql {
577:   return seconds != null
578:     ? Prisma.sql`to_timestamp(${seconds})`
579:     : Prisma.sql`NULL`;
580: }
581: function getSubscriptionPeriodBounds(
582:   subscription: Stripe.Subscription
583: ): SubscriptionPeriodBounds {
584:   const items = subscription.items?.data ?? [];
585:   const referenceItem = items.reduce<Stripe.SubscriptionItem | undefined>(
586:     (latest, item) => {
587:       if (!latest) {
588:         return item;
589:       }
590:       return item.current_period_end > latest.current_period_end
591:         ? item
592:         : latest;
593:     },
594:     undefined
595:   );
596:   if (!referenceItem) {
597:     return {
598:       currentPeriodStart: null,
599:       currentPeriodEnd: null,
600:     };
601:   }
602:   return {
603:     currentPeriodStart: referenceItem.current_period_start ?? null,
604:     currentPeriodEnd: referenceItem.current_period_end ?? null,
605:   };
606: }
607: function getSubscriptionFromInvoice(
608:   invoice: Stripe.Invoice
609: ): string | Stripe.Subscription | null {
610:   const subscriptionDetails = invoice.parent?.subscription_details;
611:   if (!subscriptionDetails?.subscription) {
612:     return null;
613:   }
614:   return subscriptionDetails.subscription;
615: }
