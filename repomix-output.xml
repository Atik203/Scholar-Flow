 318: export class SearchService {
 319:   static async globalSearch(
 320:     userId: string,
 321:     query: string,
 322:     type: GlobalSearchType = "all",
 323:     limit: number,
 324:     skip: number,
 325:     workspaceId?: string,
 326:     role?: string
 327:   ) {
 328:     const results: Record<string, any> = {};
 329:     const q = query.toLowerCase();
 330:     if (type === "all" || type === "papers") {
 331:       const workspaceFilter = workspaceId
 332:         ? Prisma.sql`AND p."workspaceId" = ${workspaceId}`
 333:         : Prisma.empty;
 334:       // Access control: only papers the user uploaded, or that live in a
 335:       // non-deleted workspace where they are owner or an active member.
 336:       // Mirrors the access checks applied to collections/workspaces below
 337:       // and the semantic search filter (uploaderId).
 338:       const items = await prisma.$queryRaw<any[]>`
 339:         SELECT
 340:           p.id,
 341:           p.title,
 342:           p.abstract,
 343:           p.metadata,
 344:           p.source,
 345:           p."workspaceId",
 346:           p."createdAt",
 347:           GREATEST(
 348:             COALESCE(similarity(p.title, ${q}), 0),
 349:             COALESCE(similarity(p.abstract, ${q}), 0)
 350:           ) AS "matchScore"
 351:         FROM "Paper" p
 352:         WHERE p."isDeleted" = false
 353:           AND (
 354:             p.title % ${q}
 355:             OR p.abstract % ${q}
 356:           )
 357:           AND (
 358:             p."uploaderId" = ${userId}
 359:             OR EXISTS (
 360:               SELECT 1
 361:               FROM "Workspace" w
 362:               WHERE w.id = p."workspaceId"
 363:                 AND w."isDeleted" = false
 364:                 AND (
 365:                   w."ownerId" = ${userId}
 366:                   OR EXISTS (
 367:                     SELECT 1 FROM "WorkspaceMember" wm
 368:                     WHERE wm."workspaceId" = w.id
 369:                       AND wm."userId" = ${userId}
 370:                       AND wm."isDeleted" = false
 371:                   )
 372:                 )
 373:             )
 374:           )
 375:           ${workspaceFilter}
 376:         ORDER BY "matchScore" DESC, p."createdAt" DESC
 377:         LIMIT ${limit} OFFSET ${skip}
 378:       `;
 379:       const totalCount = await prisma.paper.count({
 380:         where: {
 381:           isDeleted: false,
 382:           AND: [
 383:             {
 384:               OR: [
 385:                 { title: { contains: q, mode: "insensitive" } },
 386:                 { abstract: { contains: q, mode: "insensitive" } },
 387:               ],
 388:             },
 389:             ...(workspaceId ? [{ workspaceId }] : []),
 390:             {
 391:               OR: [
 392:                 { uploaderId: userId },
 393:                 {
 394:                   workspace: {
 395:                     isDeleted: false,
 396:                     OR: [
 397:                       { ownerId: userId },
 398:                       { members: { some: { userId, isDeleted: false } } },
 399:                     ],
 400:                   },
 401:                 },
 402:               ],
 403:             },
 404:           ],
 405:         },
 406:       });
 407:       results.papers = { total: totalCount, items };
 408:     }
 409:     // 2. Search Collections
 410:     if (type === "all" || type === "collections") {
 411:       const collAndConditions: Prisma.CollectionWhereInput[] = [
 412:         { isDeleted: false },
 413:         {
 414:           OR: [
 415:             { name: { contains: q, mode: "insensitive" } },
 416:             { description: { contains: q, mode: "insensitive" } },
 417:           ]
 418:         },
 419:         {
 420:           OR: [
 421:             { ownerId: userId },
 422:             { members: { some: { userId, isDeleted: false } } },
 423:             { isPublic: true }
 424:           ]
 425:         }
 426:       ];
 427:       if (workspaceId) {
 428:         collAndConditions.push({ workspaceId });
 429:       }
 430:       const finalCollectionWhere: Prisma.CollectionWhereInput = {
 431:          AND: collAndConditions
 432:       };
 433:       const [totalCount, items] = await Promise.all([
 434:         prisma.collection.count({ where: finalCollectionWhere }),
 435:         prisma.collection.findMany({
 436:           where: finalCollectionWhere,
 437:           take: limit,
 438:           skip,
 439:           orderBy: { createdAt: "desc" },
 440:           select: {
 441:             id: true,
 442:             name: true,
 443:             description: true,
 444:             isPublic: true,
 445:             workspaceId: true,
 446:           }
 447:         }),
 448:       ]);
 449:       results.collections = { total: totalCount, items };
 450:     }
 451:     // 3. Search Workspaces
 452:     if (type === "all" || type === "workspaces") {
 453:       const workspaceWhere: Prisma.WorkspaceWhereInput = {
 454:         AND: [
 455:           { isDeleted: false },
 456:           {
 457:             OR: [
 458:               { name: { contains: q, mode: "insensitive" } },
 459:               { description: { contains: q, mode: "insensitive" } },
 460:             ]
 461:           },
 462:           {
 463:             OR: [
 464:               { ownerId: userId },
 465:               { members: { some: { userId, isDeleted: false } } }
 466:             ]
 467:           }
 468:         ]
 469:       };
 470:       const [totalCount, items] = await Promise.all([
 471:         prisma.workspace.count({ where: workspaceWhere }),
 472:         prisma.workspace.findMany({
 473:           where: workspaceWhere,
 474:           take: limit,
 475:           skip,
 476:           orderBy: { createdAt: "desc" },
 477:           select: {
 478:             id: true,
 479:             name: true,
 480:             description: true,
 481:           }
 482:         }),
 483:       ]);
 484:       results.workspaces = { total: totalCount, items };
 485:     }
 486:     // 4. Search Notes (Phase 6 ResearchNote)
 487:     if (type === "all" || type === "notes") {
 488:       const noteWhere: Prisma.ResearchNoteWhereInput = {
 489:         isDeleted: false,
 490:         userId,
 491:         OR: [
 492:           { title: { contains: q, mode: "insensitive" } },
 493:           { content: { contains: q, mode: "insensitive" } },
 494:         ],
 495:       };
 496:       const [totalCount, items] = await Promise.all([
 497:         prisma.researchNote.count({ where: noteWhere }),
 498:         prisma.researchNote.findMany({
 499:           where: noteWhere,
 500:           take: limit,
 501:           skip,
 502:           orderBy: { updatedAt: "desc" },
 503:           select: {
 504:             id: true,
 505:             title: true,
 506:             excerpt: true,
 507:             noteType: true,
 508:             visibility: true,
 509:             updatedAt: true,
 510:           },
 511:         }),
 512:       ]);
 513:       results.notes = { total: totalCount, items };
 514:     }
 515:     // 5. Search People (Users) — ADMIN only, scoped to the admin's team
 516:     // members (users sharing a workspace with them). Non-admins get an
 517:     // empty result set — never a 403 — because the "all" search runs
 518:     // every branch in a single request.
 519:     if (type === "all" || type === "people") {
 520:       if (role !== USER_ROLES.ADMIN) {
 521:         results.people = { total: 0, items: [] };
 522:       } else {
 523:         const myWorkspaceIds = await prisma.workspace.findMany({
 524:           where: {
 525:             isDeleted: false,
 526:             OR: [
 527:               { ownerId: userId },
 528:               { members: { some: { userId, isDeleted: false } } },
 529:             ],
 530:           },
 531:           select: { id: true },
 532:         });
 533:         // Team members only: exclude soft-deleted users and self, never
 534:         // expose the password hash.
 535:         const peopleWhere: Prisma.UserWhereInput = {
 536:           isDeleted: false,
 537:           id: { not: userId },
 538:           OR: [
 539:             { name: { contains: q, mode: "insensitive" } },
 540:             { email: { contains: q, mode: "insensitive" } },
 541:             { firstName: { contains: q, mode: "insensitive" } },
 542:             { lastName: { contains: q, mode: "insensitive" } },
 543:           ],
 544:           memberships: {
 545:             some: {
 546:               workspaceId: { in: myWorkspaceIds.map((w) => w.id) },
 547:               isDeleted: false,
 548:             },
 549:           },
 550:         };
 551:         const [totalCount, items] = await Promise.all([
 552:           prisma.user.count({ where: peopleWhere }),
 553:           prisma.user.findMany({
 554:             where: peopleWhere,
 555:             take: limit,
 556:             skip,
 557:             orderBy: { name: "asc" },
 558:             select: {
 559:               id: true,
 560:               name: true,
 561:               email: true,
 562:               image: true,
 563:               role: true,
 564:               institution: true,
 565:             },
 566:           }),
 567:         ]);
 568:         results.people = { total: totalCount, items };
 569:       }
 570:     }
 571:     // Determine the total results sum
 572:     let aggregateTotal = 0;
 573:     if (results.papers) aggregateTotal += results.papers.total;
 574:     if (results.collections) aggregateTotal += results.collections.total;
 575:     if (results.workspaces) aggregateTotal += results.workspaces.total;
 576:     if (results.notes) aggregateTotal += results.notes.total;
 577:     if (results.people) aggregateTotal += results.people.total;
 578:     // Auto-record to search history so the history page is populated.
 579:     // Failure must never break the search response.
 580:     try {
 581:       await SearchService.saveSearchQuery(userId, q, { type }, {
 582:         total: aggregateTotal,
 583:         papers: results.papers?.total ?? 0,
 584:         collections: results.collections?.total ?? 0,
 585:         workspaces: results.workspaces?.total ?? 0,
 586:         notes: results.notes?.total ?? 0,
 587:         people: results.people?.total ?? 0,
 588:       });
 589:     } catch (historyError) {
 590:       if (process.env.NODE_ENV !== "production") {
 591:         console.error("[SearchService] history record failed:", historyError);
 592:       }
 593:     }
 594:     return {
 595:       results,
 596:       meta: { limit, skip, total: aggregateTotal },
 597:     };
 598:   }
 599:   /**
 600:    * Save a search query to history
 601:    */
 602:   static async saveSearchQuery(
 603:     userId: string,
 604:     query: string,
 605:     filters?: any,
 606:     searchResultsSummary?: any
 607:   ) {
 608:     if (!query || query.trim().length === 0) return null;
 609:     return prisma.searchHistory.create({
 610:       data: {
 611:         userId,
 612:         query: query.trim(),
 613:         filters: filters || null,
 614:         results: searchResultsSummary || null,
 615:       }
 616:     });
 617:   }
 618:   /**
 619:    * Get search history for a user
 620:    */
 621:   static async getSearchHistory(
 622:     userId: string,
 623:     limit: number,
 624:     skip: number
 625:   ) {
 626:     const where: Prisma.SearchHistoryWhereInput = {
 627:       userId,
 628:       isDeleted: false
 629:     };
 630:     const [total, data] = await Promise.all([
 631:       prisma.searchHistory.count({ where }),
 632:       prisma.searchHistory.findMany({
 633:         where,
 634:         take: limit,
 635:         skip,
 636:         orderBy: { createdAt: "desc" },
 637:       }),
 638:     ]);
 639:     return {
 640:       meta: { total, skip, limit },
 641:       result: data,
 642:     };
 643:   }
 644:   /**
 645:    * Get top sources (papers + collections + workspaces) for a query.
 646:    * Used by the AI summary endpoint to attach citations.
 647:    */
 648:   static async getTopSources(
 649:     userId: string,
 650:     query: string,
 651:     limit: number,
 652:     workspaceId?: string,
 653:     role?: string
 654:   ): Promise<
 655:     Array<{
 656:       id: string;
 657:       type: "paper" | "collection" | "workspace";
 658:       title: string;
 659:       description?: string | null;
 660:       href: string;
 661:     }>
 662:   > {
 663:     // Re-use globalSearch for the three core categories.
 664:     const result = await SearchService.globalSearch(
 665:       userId,
 666:       query,
 667:       "all",
 668:       limit,
 669:       0,
 670:       workspaceId,
 671:       role
 672:     );
 673:     const out: Array<{
 674:       id: string;
 675:       type: "paper" | "collection" | "workspace";
 676:       title: string;
 677:       description?: string | null;
 678:       href: string;
 679:     }> = [];
 680:     for (const p of result.results.papers?.items ?? []) {
 681:       out.push({
 682:         id: p.id,
 683:         type: "paper",
 684:         title: p.title ?? "Untitled paper",
 685:         description: p.abstract ?? null,
 686:         href: `/dashboard/papers/${p.id}`,
 687:       });
 688:     }
 689:     for (const c of result.results.collections?.items ?? []) {
 690:       out.push({
 691:         id: c.id,
 692:         type: "collection",
 693:         title: c.name ?? "Untitled collection",
 694:         description: c.description ?? null,
 695:         href: `/dashboard/collections/${c.id}`,
 696:       });
 697:     }
 698:     for (const w of result.results.workspaces?.items ?? []) {
 699:       out.push({
 700:         id: w.id,
 701:         type: "workspace",
 702:         title: w.name ?? "Untitled workspace",
 703:         description: w.description ?? null,
 704:         href: `/dashboard/workspaces/${w.id}`,
 705:       });
 706:     }
 707:     return out.slice(0, limit);
 708:   }
 709:   /**
 710:    * Summarize a query using OpenAI with the top internal sources
 711:    * attached as citations. Returns a short prose summary plus the
 712:    * source list. Used by the global search Perplexity-style AI panel.
 713:    *
 714:    * Implementation note: uses raw fetch against the OpenAI Chat
 715:    * Completions API (no streaming) so this code path has no SDK
 716:    * dependency. If OPENAI_API_KEY is missing, returns a
 717:    * deterministic stub summary that points at the sources so the
 718:    * UI still renders a useful response.
 719:    */
 720:   static async aiSummarize(
 721:     userId: string,
 722:     query: string,
 723:     workspaceId?: string,
 724:     model = "gpt-4o-mini",
 725:     role?: string
 726:   ): Promise<{
 727:     summary: string;
 728:     sources: Array<{
 729:       id: string;
 730:       type: "paper" | "collection" | "workspace";
 731:       title: string;
 732:       href: string;
 733:     }>;
 734:     fallback: string | null;
 735:   }> {
 736:     const sources = await SearchService.getTopSources(userId, query, 5, workspaceId, role);
 737:     const apiKey = process.env.OPENAI_API_KEY;
 738:     if (!apiKey) {
 739:       return {
 740:         summary: `AI summary is unavailable because the backend has no OPENAI_API_KEY configured. Here are the top matching results instead.\n\nQuery: "${query}"`,
 741:         sources: sources.map((s) => ({
 742:           id: s.id,
 743:           type: s.type,
 744:           title: s.title,
 745:           href: s.href,
 746:         })),
 747:         fallback: "OPENAI_KEY_MISSING",
 748:       };
 749:     }
 750:     try {
 751:       const contextLines = sources
 752:         .map(
 753:           (s, i) =>
 754:             `[${i + 1}] (${s.type}) ${s.title}${
 755:               s.description ? ` — ${String(s.description).slice(0, 200)}` : ""
 756:             }`
 757:         )
 758:         .join("\n");
 759:       const prompt = `You are a research assistant. Summarize the following internal sources to answer the user's query in 2-4 sentences. Use the numbered citations inline (e.g., [1], [2]). Do not invent sources.\n\nSources:\n${contextLines}\n\nQuery: ${query}\n\nSummary:`;
 760:       const controller = new AbortController();
 761:       const timeout = setTimeout(() => controller.abort(), 20000);
 762:       const response = await fetch("https://api.openai.com/v1/chat/completions", {
 763:         method: "POST",
 764:         headers: {
 765:           "Content-Type": "application/json",
 766:           Authorization: `Bearer ${apiKey}`,
 767:         },
 768:         body: JSON.stringify({
 769:           model,
 770:           messages: [
 771:             { role: "system", content: "You answer research questions using only the provided sources." },
 772:             { role: "user", content: prompt },
 773:           ],
 774:           max_tokens: 500,
 775:           temperature: 0.2,
 776:         }),
 777:         signal: controller.signal,
 778:       });
 779:       clearTimeout(timeout);
 780:       if (!response.ok) {
 781:         return {
 782:           summary: `AI summary failed (OpenAI returned ${response.status}). Showing top matching results instead.`,
 783:           sources: sources.map((s) => ({
 784:             id: s.id,
 785:             type: s.type,
 786:             title: s.title,
 787:             href: s.href,
 788:           })),
 789:           fallback: "OPENAI_REQUEST_FAILED",
 790:         };
 791:       }
 792:       const data = (await response.json()) as {
 793:         choices: Array<{ message: { content: string } }>;
 794:       };
 795:       const summary =
 796:         data.choices?.[0]?.message?.content?.trim() ??
 797:         "No summary could be generated.";
 798:       return {
 799:         summary,
 800:         sources: sources.map((s) => ({
 801:           id: s.id,
 802:           type: s.type,
 803:           title: s.title,
 804:           href: s.href,
 805:         })),
 806:         fallback: null,
 807:       };
 808:     } catch {
 809:       return {
 810:         summary: `AI summary failed (network error). Showing top matching results instead.`,
 811:         sources: sources.map((s) => ({
 812:           id: s.id,
 813:           type: s.type,
 814:           title: s.title,
 815:           href: s.href,
 816:         })),
 817:         fallback: "OPENAI_REQUEST_FAILED",
 818:       };
 819:     }
 820:   }
 821:   static async getExplore(
 822:     category: string,
 823:     page: number,
 824:     limit: number
 825:   ): Promise<ExploreResult> {
 826:     const cap = Math.min(20, Math.max(1, limit));
 827:     const start = (page - 1) * cap;
 828:     const items = await fetchArxivFeed(category, start, cap);
 829:     return {
 830:       items,
 831:       meta: {
 832:         page,
 833:         limit: cap,
 834:         total: items.length,
 835:         totalPage: Math.max(1, Math.ceil(items.length / cap)),
 836:       },
 837:     };
 838:   }
