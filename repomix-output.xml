205: const formatTimeAgo = (dateString: string) => {
206:   const date = new Date(dateString);
207:   const now = new Date();
208:   const diffMs = now.getTime() - date.getTime();
209:   const diffMins = Math.floor(diffMs / (1000 * 60));
210:   const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
211:   const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
212:   if (diffMins < 1) return "Just now";
213:   if (diffMins < 60) return `${diffMins}m ago`;
214:   if (diffHours < 24) return `${diffHours}h ago`;
215:   if (diffDays === 1) return "Yesterday";
216:   if (diffDays < 7) return `${diffDays}d ago`;
217:   return date.toLocaleDateString();
218: };
219: const groupNotificationsByDate = (notifications: Notification[]) => {
220:   const groups: { [key: string]: Notification[] } = {};
221:   notifications.forEach((notification) => {
222:     const date = new Date(notification.createdAt);
223:     const now = new Date();
224:     const diffDays = Math.floor(
225:       (now.getTime() - date.getTime()) / (1000 * 60 * 60 * 24)
226:     );
227:     let groupKey: string;
228:     if (diffDays === 0) {
229:       groupKey = "Today";
230:     } else if (diffDays === 1) {
231:       groupKey = "Yesterday";
232:     } else if (diffDays < 7) {
233:       groupKey = "This Week";
234:     } else if (diffDays < 30) {
235:       groupKey = "This Month";
236:     } else {
237:       groupKey = "Older";
238:     }
239:     if (!groups[groupKey]) {
240:       groups[groupKey] = [];
241:     }
242:     groups[groupKey].push(notification);
243:   });
244:   return groups;
245: };
