162:     filename: string;
163:     mimeType: string;
164:     content: string;
165:     size: number;
166:   }> {
167:     const report = await prisma.adminReport.findFirst({
168:       where: { id, isDeleted: false },
169:     });
170:     if (!report) throw new ApiError(404, "Report not found");
171:     await prisma.adminReport.update({
172:       where: { id },
173:       data: { status: "GENERATING" },
174:     });
175:     try {
176:       const rows = await this.fetchReportRows(report.type, MAX_ROWS);
177:       const capped = rows.length > MAX_ROWS ? rows.slice(0, MAX_ROWS) : rows;
178:       const filename = `${this.slugify(report.name)}-${
179:         new Date().toISOString().split("T")[0]
180:       }.${report.format.toLowerCase()}`;
181:       const mimeType = report.format === "JSON" ? "application/json" : "text/csv";
182:       const content =
183:         report.format === "JSON"
184:           ? JSON.stringify(capped, null, 2)
185:           : buildCsv(capped);
186:       await prisma.adminReport.update({
187:         where: { id },
188:         data: {
189:           status: "READY",
190:           generatedAt: new Date(),
191:           fileSize: formatBytes(content.length),
192:         },
193:       });
194:       return {
195:         filename,
196:         mimeType,
197:         content,
198:         size: content.length,
199:       };
200:     } catch (err) {
201:       await prisma.adminReport.update({
202:         where: { id },
203:         data: { status: "FAILED" },
204:       });
205:       throw err;
206:     }
207:   },
208:   async fetchReportRows(
209:     type: "USAGE" | "FINANCIAL" | "USER" | "CONTENT" | "SYSTEM",
210:     limit: number
211:   ): Promise<ReportRow[]> {
212:     switch (type) {
213:       case "USER": {
214:         const users = await prisma.user.findMany({
215:           where: { isDeleted: false },
216:           take: limit,
217:           orderBy: { createdAt: "desc" },
218:           select: {
219:             id: true,
220:             email: true,
221:             name: true,
222:             role: true,
223:             createdAt: true,
224:             emailVerified: true,
225:           },
226:         });
227:         return users.map((u) => ({
228:           id: u.id,
229:           email: u.email,
230:           name: u.name,
231:           role: u.role,
232:           emailVerified: u.emailVerified ? "yes" : "no",
233:           createdAt: u.createdAt.toISOString(),
234:         }));
235:       }
236:       case "FINANCIAL": {
237:         const payments = await prisma.payment.findMany({
238:           where: { isDeleted: false },
239:           take: limit,
240:           orderBy: { createdAt: "desc" },
241:           select: {
242:             id: true,
243:             userId: true,
244:             amountCents: true,
245:             currency: true,
246:             status: true,
247:             createdAt: true,
248:             provider: true,
249:           },
250:         });
251:         return payments.map((p) => ({
252:           id: p.id,
253:           userId: p.userId,
254:           amount: (p.amountCents / 100).toFixed(2),
255:           currency: p.currency,
256:           status: p.status,
257:           provider: p.provider,
258:           createdAt: p.createdAt.toISOString(),
259:         }));
260:       }
261:       case "CONTENT": {
262:         const papers = await prisma.paper.findMany({
263:           where: { isDeleted: false },
264:           take: limit,
265:           orderBy: { createdAt: "desc" },
266:           select: {
267:             id: true,
268:             title: true,
269:             uploaderId: true,
270:             processingStatus: true,
271:             citationCount: true,
272:             createdAt: true,
273:           },
274:         });
275:         return papers.map((p) => ({
276:           id: p.id,
277:           title: p.title,
278:           uploaderId: p.uploaderId,
279:           processingStatus: p.processingStatus,
280:           citationCount: p.citationCount,
281:           createdAt: p.createdAt.toISOString(),
282:         }));
283:       }
284:       case "USAGE": {
285:         const events = await prisma.usageEvent.findMany({
286:           where: { isDeleted: false },
287:           take: limit,
288:           orderBy: { createdAt: "desc" },
289:           select: {
290:             id: true,
291:             userId: true,
292:             kind: true,
293:             units: true,
294:             createdAt: true,
295:           },
296:         });
297:         return events.map((e) => ({
298:           id: e.id,
299:           userId: e.userId,
300:           kind: e.kind,
301:           units: e.units,
302:           createdAt: e.createdAt.toISOString(),
303:         }));
304:       }
305:       case "SYSTEM": {
306:         const sessions = await prisma.session.findMany({
307:           where: { isDeleted: false },
308:           take: limit,
309:           orderBy: { createdAt: "desc" },
310:           select: {
311:             id: true,
312:             userId: true,
313:             sessionToken: true,
314:             expires: true,
315:           },
316:         });
317:         return sessions.map((s) => ({
318:           id: s.id,
319:           userId: s.userId,
320:           expiresAt: s.expires.toISOString(),
321:           tokenPrefix: s.sessionToken.slice(0, 12) + "...",
322:         }));
323:       }
324:       default:
325:         return [];
326:     }
327:   },
328:   slugify(s: string): string {
329:     return s
330:       .toLowerCase()
331:       .replace(/[^a-z0-9]+/g, "-")
332:       .replace(/(^-|-$)+/g, "")
333:       .slice(0, 60);
334:   },
335: };
