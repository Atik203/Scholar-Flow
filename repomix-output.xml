<file path="apps/backend/prisma/sql/admin/getPaperStats.sql">
 1: SELECT
 2:   COUNT(*)::int as "totalPapers",
 3:   COUNT(*) FILTER (WHERE "processingStatus" = 'PROCESSING')::int as "processingPapers",
 4:   COUNT(*) FILTER (WHERE "processingStatus" = 'PROCESSED')::int as "completedPapers",
 5:   COUNT(*) FILTER (WHERE "processingStatus" = 'FAILED')::int as "failedPapers",
 6:   COALESCE(AVG(
 7:     CASE
 8:       WHEN "processingStatus" = 'PROCESSED' AND "processedAt" IS NOT NULL
 9:       THEN EXTRACT(EPOCH FROM ("processedAt" - "createdAt"))
10:       ELSE NULL
11:     END
12:   ), 0)::int as "averageProcessingTime"
13: FROM "Paper"
14: WHERE "isDeleted" = false;
</file>

