<file path=".github/workflows/auto-create-pr-dev-to-main.yml">
  1: name: Auto Create Pull Request from Dev to Main
  2: on:
  3:   push:
  4:     branches:
  5:       - dev
  6: permissions:
  7:   contents: write
  8:   pull-requests: write
  9:   issues: write
 10:   actions: read
 11:   checks: read
 12:   repository-projects: write
 13: jobs:
 14:   create-pull-request:
 15:     runs-on: ubuntu-latest
 16:     steps:
 17:       - name: Checkout code
 18:         uses: actions/checkout@v4
 19:         with:
 20:           fetch-depth: 0
 21:       - name: Get commit details
 22:         id: get-commit
 23:         run: |
 24:           echo "COMMIT_MESSAGE=$(git log -1 --pretty=format:'%s')" >> $GITHUB_ENV
 25:           echo "COMMIT_AUTHOR=$(git log -1 --pretty=format:'%an')" >> $GITHUB_ENV
 26:           echo "COMMIT_URL=https://github.com/${{ github.repository }}/commit/$(git log -1 --pretty=format:'%H')" >> $GITHUB_ENV
 27:           echo "COMMIT_HASH=$(git log -1 --pretty=format:'%H')" >> $GITHUB_ENV
 28:       - name: Check if PR already exists
 29:         id: check-pr
 30:         run: |
 31:           pr_data=$(gh pr list --head dev --base main --state open --limit 1 --json number 2>/dev/null || echo "[]")
 32:           pr_number=$(echo "$pr_data" | jq -r '.[0].number // empty')
 33:           if [ -n "$pr_number" ] && [ "$pr_number" != "null" ]; then
 34:             echo "Found existing PR #$pr_number"
 35:             echo "pr_exists=true" >> $GITHUB_OUTPUT
 36:             echo "pr_number=$pr_number" >> $GITHUB_OUTPUT
 37:           else
 38:             echo "No existing PR found"
 39:             echo "pr_exists=false" >> $GITHUB_OUTPUT
 40:           fi
 41:         env:
 42:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
 43:       - name: Check for commits between branches
 44:         id: check-commits
 45:         run: |
 46:           git fetch origin main
 47:           git fetch origin dev
 48:           commits_ahead=$(git rev-list --count origin/main..origin/dev)
 49:           commits_behind=$(git rev-list --count origin/dev..origin/main)
 50:           echo "Commits ahead (dev ahead of main): $commits_ahead"
 51:           echo "Commits behind (main ahead of dev): $commits_behind"
 52:           if [ "$commits_ahead" -gt 0 ]; then
 53:             echo "has_changes=true" >> $GITHUB_OUTPUT
 54:             echo "✅ Found $commits_ahead new commits in dev branch"
 55:             echo "### New commits to be merged:" >> commit_summary.txt
 56:             git log --oneline origin/main..origin/dev >> commit_summary.txt
 57:           else
 58:             echo "has_changes=false" >> $GITHUB_OUTPUT
 59:             echo "ℹ️ No new commits found - branches are in sync"
 60:           fi
 61:       - name: Create Pull Request
 62:         if: steps.check-pr.outputs.pr_exists == 'false' && steps.check-commits.outputs.has_changes == 'true'
 63:         id: create-pr
 64:         run: |
 65:           if [ -f commit_summary.txt ]; then
 66:             commit_list=$(cat commit_summary.txt)
 67:           else
 68:             commit_list="No specific commit details available"
 69:           fi
 70:           pr_body="### Pull Request Details
 71:           **Description:** ${COMMIT_MESSAGE}
 72:           **Author:** ${COMMIT_AUTHOR}
 73:           **Source Branch:** dev
 74:           **Target Branch:** main
 75:           **Latest Commit:** [${COMMIT_HASH:0:7}](${COMMIT_URL})
 76:           ### Changes Made
 77:           ${COMMIT_MESSAGE}
 78:           ### Commits in this PR
 79:           \`\`\`
 80:           $commit_list
 81:           \`\`\`
 82:           ### Auto-Merge Status
 83:           This pull request will be automatically merged after successful checks.
 84:           ---
 85:           *Auto-generated on $(date)*"
 86:           gh pr create \
 87:             --title "Auto PR: ${COMMIT_MESSAGE}" \
 88:             --body "$pr_body" \
 89:             --head dev \
 90:             --base main \
 91:             --label "auto-generated" \
 92:             --assignee "Atik203"
 93:           echo "✅ Created new pull request"
 94:         env:
 95:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
 96:       - name: Update existing PR
 97:         if: steps.check-pr.outputs.pr_exists == 'true'
 98:         run: |
 99:           pr_body="### Pull Request Details
100:           **Description:** ${COMMIT_MESSAGE}
101:           **Author:** ${COMMIT_AUTHOR}
102:           **Source Branch:** dev
103:           **Target Branch:** main
104:           **Latest Commit:** [${COMMIT_HASH:0:7}](${COMMIT_URL})
105:           ### Changes Made
106:           ${COMMIT_MESSAGE}
107:           ### Auto-Merge Status
108:           This pull request will be automatically merged after successful checks.
109:           ---
110:           *Last updated on $(date)*"
111:           gh pr edit ${{ steps.check-pr.outputs.pr_number }} \
112:             --title "Auto PR: ${COMMIT_MESSAGE}" \
113:             --body "$pr_body"
114:           gh pr comment ${{ steps.check-pr.outputs.pr_number }} \
115:             --body "🔄 **Updated with latest changes**
116:           **New commit:** [${COMMIT_HASH:0:7}](${COMMIT_URL})
117:           **Message:** ${COMMIT_MESSAGE}
118:           **Author:** ${COMMIT_AUTHOR}"
119:           echo "✅ Updated existing pull request #${{ steps.check-pr.outputs.pr_number }}"
120:         env:
121:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
122:       - name: No changes to merge
123:         if: steps.check-commits.outputs.has_changes == 'false'
124:         run: |
125:           echo "ℹ️ **No Pull Request needed**"
126:           echo ""
127:           echo "The dev and main branches are currently in sync."
128:           echo "No new commits found in dev branch that aren't already in main."
129:           echo ""
130:           echo "This is normal after a successful merge and indicates that:"
131:           echo "- Previous PR was successfully merged"
132:           echo "- No new changes have been made to dev branch yet"
133:           echo "- Branches are properly synchronized"
134:           echo ""
135:           echo "A new PR will be created automatically when new commits are pushed to dev."
</file>

<file path=".github/workflows/auto-merge-atik-to-dev.yml">
 1: name: Auto Merge atik → dev (One-Way Flow Only)
 2: on:
 3:   push:
 4:     branches:
 5:       - atik
 6: permissions:
 7:   contents: write
 8:   pull-requests: write
 9: jobs:
10:   merge-atik-to-dev:
11:     runs-on: ubuntu-latest
12:     steps:
13:       - name: Checkout repository
14:         uses: actions/checkout@v4
15:         with:
16:           fetch-depth: 0
17:           token: ${{ secrets.GH_TOKEN }}
18:       - name: Setup Git identity
19:         run: |
20:           git config user.name "GitHub Actions"
21:           git config user.email "actions@github.com"
22:       - name: Ensure branches are up to date
23:         run: |
24:           echo "🔄 Starting atik → dev merge (one-way flow)"
25:           echo "📋 Branch flow: atik → dev → main"
26:           echo "🚫 Note: dev should NEVER merge back into atik"
27:           git fetch --all --prune
28:           git checkout dev
29:           git pull origin dev
30:           git fetch origin atik:refs/remotes/origin/atik
31:       - name: Merge atik into dev (one-way only)
32:         id: merge
33:         run: |
34:           set -e
35:           echo "Merging origin/atik into dev (ONE-WAY FLOW)"
36:           echo "🚫 This workflow enforces: atik → dev (never dev → atik)"
37:           if git merge --no-edit origin/atik; then
38:             echo "merge_result=success" >> $GITHUB_OUTPUT
39:             echo "✅ Successfully merged atik into dev"
40:           else
41:             echo "merge_result=conflict" >> $GITHUB_OUTPUT
42:             echo "❌ Merge conflicts detected"
43:           fi
44:       - name: Push dev after successful merge
45:         if: steps.merge.outputs.merge_result == 'success'
46:         run: |
47:           git push origin dev
48:           echo "✅ atik → dev merge pushed successfully"
49:           echo "📝 Next: dev → main PR will be auto-created and merged"
50:           echo "🔄 Complete flow: atik → dev → main"
51:       - name: Handle merge conflicts by opening PR atik → dev
52:         if: steps.merge.outputs.merge_result == 'conflict'
53:         env:
54:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
55:         run: |
56:           echo "⚠️ Merge conflicts detected when merging atik → dev"
57:           echo "🚫 IMPORTANT: Do NOT merge dev back into atik to resolve conflicts"
58:           echo "✅ Instead: Resolve conflicts in the atik branch or manually in the PR"
59:           git merge --abort || true
60:           pr_number=$(gh pr list --head atik --base dev --state open --json number -q '.[0].number' || echo "")
61:           pr_body="
62:           **Branch Flow:** atik → dev (ONE-WAY ONLY)
63:           - Never merge dev into atik to resolve conflicts
64:           - This would break the intended branch flow
65:           - Always resolve conflicts in the source branch (atik) or in this PR
66:           1. **Option A:** Resolve conflicts in this PR directly
67:           2. **Option B:** Checkout atik branch locally, resolve conflicts, push to atik
68:           3. **Option C:** Create a separate branch from atik, resolve conflicts, merge back to atik
69:           atik → dev → main (one direction only)
70:           **Automated PR due to merge conflicts when merging atik into dev.**"
71:           if [ -n "$pr_number" ]; then
72:             gh pr comment "$pr_number" --body "🔁 **Update:** New commits pushed to atik. Conflicts still need resolution. **Remember:** Never merge dev → atik. Resolve conflicts in atik branch or this PR directly."
73:             echo "ℹ️ Updated existing PR #$pr_number with conflict resolution guidance"
74:           else
75:             gh pr create \
76:               --title "🔄 Auto PR: atik → dev (resolve conflicts - ONE-WAY FLOW)" \
77:               --body "$pr_body" \
78:               --head atik \
79:               --base dev \
80:               --label "auto-generated,conflicts" \
81:               --assignee "Atik203"
82:             echo "📌 Created new PR for conflict resolution with one-way flow guidance"
83:           fi
</file>

<file path=".github/workflows/auto-merge-pr.yml">
  1: name: Auto Merge Pull Request (dev → main only)
  2: on:
  3:   pull_request:
  4:     types: [opened, synchronize, reopened]
  5:     branches:
  6:       - main
  7: permissions:
  8:   contents: write
  9:   pull-requests: write
 10: jobs:
 11:   auto-merge:
 12:     runs-on: ubuntu-latest
 13:     if: contains(github.event.pull_request.labels.*.name, 'auto-generated') && github.event.pull_request.head.ref == 'dev'
 14:     steps:
 15:       - name: Checkout code
 16:         uses: actions/checkout@v4
 17:         with:
 18:           fetch-depth: 0
 19:           token: ${{ secrets.GH_TOKEN }}
 20:       - name: Wait before merging
 21:         run: |
 22:           echo "🔄 Auto-merge workflow started for dev → main"
 23:           echo "📋 Expected branch flow: atik → dev → main"
 24:           echo "Waiting 10 seconds to allow any checks to start..."
 25:           sleep 10
 26:       - name: Setup Git
 27:         run: |
 28:           git config user.name "GitHub Actions"
 29:           git config user.email "actions@github.com"
 30:       - name: Verify branch flow (atik → dev → main only)
 31:         run: |
 32:           git fetch origin main
 33:           git fetch origin dev
 34:           echo "✅ Branch flow verification complete."
 35:           echo "📋 Expected flow: atik → dev → main"
 36:           echo "🚫 No reverse merging allowed (main should not merge back into dev)"
 37:           echo "💡 If conflicts exist, they should be resolved in the source branches, not by reverse merging"
 38:       - name: Check PR status
 39:         id: pr-status
 40:         run: |
 41:           sleep 5
 42:           for i in {1..3}; do
 43:             if pr_state=$(gh pr view ${{ github.event.pull_request.number }} --json state --jq '.state') && \
 44:                mergeable=$(gh pr view ${{ github.event.pull_request.number }} --json mergeable --jq '.mergeable'); then
 45:               break
 46:             fi
 47:             echo "Attempt $i failed, retrying..."
 48:             sleep 10
 49:           done
 50:           echo "PR State: $pr_state"
 51:           echo "Mergeable: $mergeable"
 52:           if [ "$pr_state" = "OPEN" ] && [ "$mergeable" = "MERGEABLE" ]; then
 53:             echo "can_merge=true" >> $GITHUB_OUTPUT
 54:             echo "✅ PR is ready for merge"
 55:           else
 56:             echo "can_merge=false" >> $GITHUB_OUTPUT
 57:             echo "❌ PR cannot be merged. State: $pr_state, Mergeable: $mergeable"
 58:           fi
 59:         env:
 60:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
 61:       - name: Add comment before merging
 62:         if: steps.pr-status.outputs.can_merge == 'true'
 63:         run: |
 64:           gh pr comment ${{ github.event.pull_request.number }} \
 65:             --body "🤖 **Auto-merging this pull request from dev to main...**
 66:           ✅ All checks passed - proceeding with automatic merge."
 67:         env:
 68:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
 69:       - name: Auto-merge PR
 70:         if: steps.pr-status.outputs.can_merge == 'true'
 71:         run: |
 72:           echo "Auto-merging PR #${{ github.event.pull_request.number }}"
 73:           if gh pr merge ${{ github.event.pull_request.number }} --merge --delete-branch=false; then
 74:             echo "✅ Successfully merged PR #${{ github.event.pull_request.number }} with merge commit"
 75:           elif gh pr merge ${{ github.event.pull_request.number }} --squash --delete-branch=false; then
 76:             echo "✅ Successfully merged PR #${{ github.event.pull_request.number }} with squash merge"
 77:           else
 78:             echo "❌ All merge strategies failed"
 79:             exit 1
 80:           fi
 81:           echo "📝 Dev branch preserved for continued development"
 82:         env:
 83:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
 84:       - name: Handle merge failure
 85:         if: failure() || steps.pr-status.outputs.can_merge == 'false'
 86:         run: |
 87:           echo "Merge failed or PR not ready. Getting more details..."
 88:           pr_checks=$(gh pr view ${{ github.event.pull_request.number }} --json statusCheckRollup --jq '.statusCheckRollup[]?.state' | sort | uniq -c || echo "No checks")
 89:           pr_reviews=$(gh pr view ${{ github.event.pull_request.number }} --json reviewDecision --jq '.reviewDecision' || echo "No reviews")
 90:           gh pr comment ${{ github.event.pull_request.number }} \
 91:             --body "⚠️ **Auto-merge failed or cannot proceed**
 92:           **Status Details:**
 93:           - Check Status: \`$pr_checks\`
 94:           - Review Status: \`$pr_reviews\`
 95:           **Possible reasons:**
 96:           - Merge conflicts need to be resolved
 97:           - PR is not in a mergeable state
 98:           - Required status checks are failing
 99:           - Rebase strategy failed (branch history conflicts)
100:           **Next steps:**
101:           1. Check for merge conflicts and resolve them
102:           2. Ensure all required checks pass
103:           3. Try manual merge with different strategy (merge commit or squash)
104:           Please review and merge manually when ready."
105:         env:
106:           GH_TOKEN: ${{ secrets.GH_TOKEN }}
</file>

<file path=".github/workflows/branch-flow-guard.yml">
 1: name: Branch Flow Guard (Prevent Reverse Merges)
 2: on:
 3:   pull_request:
 4:     types: [opened, synchronize, reopened]
 5:     branches:
 6:       - atik
 7:       - dev
 8: permissions:
 9:   contents: read
10:   pull-requests: write
11: jobs:
12:   check-branch-flow:
13:     runs-on: ubuntu-latest
14:     steps:
15:       - name: Check for invalid branch flow
16:         id: flow-check
17:         run: |
18:           echo "🔍 Checking branch flow for PR #${{ github.event.pull_request.number }}"
19:           echo "Source: ${{ github.event.pull_request.head.ref }}"
20:           echo "Target: ${{ github.event.pull_request.base.ref }}"
21:           invalid_flow=false
22:           error_message=""
23:           # Prevent dev → atik (reverse flow)
24:           if [ "${{ github.event.pull_request.head.ref }}" = "dev" ] && [ "${{ github.event.pull_request.base.ref }}" = "atik" ]; then
25:             invalid_flow=true
26:             error_message="🚫 Invalid flow: dev → atik. Expected flow: atik → dev → main"
27:           fi
28:           if [ "${{ github.event.pull_request.head.ref }}" = "main" ] && [ "${{ github.event.pull_request.base.ref }}" = "dev" ]; then
29:             invalid_flow=true
30:             error_message="🚫 Invalid flow: main → dev. Expected flow: atik → dev → main"
31:           fi
32:           if [ "${{ github.event.pull_request.head.ref }}" = "main" ] && [ "${{ github.event.pull_request.base.ref }}" = "atik" ]; then
