  1: import {
  2:   showErrorToast,
  3:   showSuccessToast,
  4: } from "@/components/providers/ToastProvider";
  5: import { Button } from "@/components/ui/button";
  6: import {
  7:   Popover,
  8:   PopoverContent,
  9:   PopoverTrigger,
 10: } from "@/components/ui/popover";
 11: import { NodeViewWrapper, ReactNodeViewRenderer } from "@tiptap/react";
 12: import {
 13:   AlignCenter,
 14:   AlignLeft,
 15:   AlignRight,
 16:   Copy,
 17:   GripHorizontal,
 18:   Image as ImageIcon,
 19:   Move,
 20:   Trash2,
 21:   Type,
 22:   WrapText,
 23: } from "lucide-react";
 24: import React, {
 25:   useCallback,
 26:   useEffect,
 27:   useMemo,
 28:   useRef,
 29:   useState,
 30: } from "react";
 31: import {
 32:   ResizableImage,
 33:   ResizableImageComponent,
 34:   ResizableImageNodeViewRendererProps,
 35: } from "tiptap-extension-resizable-image";
 36: type WrapMode = "inline" | "break";
 37: const NodeView = (props: ResizableImageNodeViewRendererProps) => {
 38:   const editor = (props as any).editor;
 39:   const [isDragging, setIsDragging] = useState(false);
 40:   const [dragOffset, setDragOffset] = useState({ x: 0, y: 0 });
 41:   const [caption, setCaption] = useState<string>(
 42:     (props.node.attrs["data-caption"] as string) || ""
 43:   );
 44:   const [wrapMode, setWrapMode] = useState<WrapMode>(
 45:     (props.node.attrs["data-wrap"] as WrapMode) || "inline"
 46:   );
 47:   const posX = Number(props.node.attrs["data-position-x"] ?? 0) || 0;
 48:   const posY = Number(props.node.attrs["data-position-y"] ?? 0) || 0;
 49:   const align =
 50:     (props.node.attrs["data-align"] as string) || "center";
 51:   const containerRef = useRef<HTMLDivElement>(null);
 52:   const dragFrameRef = useRef<number>(0);
 53:   const updateAttrs = useCallback(
 54:     (attrs: Record<string, unknown>) => {
 55:       const { getPos } = props as any;
 56:       if (typeof getPos !== "function") return;
 57:       const pos = getPos();
 58:       if (typeof pos !== "number") return;
 59:       editor
 60:         .chain()
 61:         .focus()
 62:         .command(({ tr }: { tr: any }) => {
 63:           tr.setNodeMarkup(pos, undefined, {
 64:             ...props.node.attrs,
 65:             ...attrs,
 66:           });
 67:           return true;
 68:         })
 69:         .run();
 70:     },
 71:     [editor, props]
 72:   );
 73:   const handleDragStart = useCallback(
 74:     (e: React.MouseEvent) => {
 75:       e.preventDefault();
 76:       e.stopPropagation();
 77:       setIsDragging(true);
 78:       setDragOffset({
 79:         x: e.clientX - posX,
 80:         y: e.clientY - posY,
 81:       });
 82:     },
 83:     [posX, posY]
 84:   );
 85:   useEffect(() => {
 86:     if (!isDragging) return;
 87:     const handleDrag = (e: MouseEvent) => {
 88:       if (dragFrameRef.current) return;
 89:       dragFrameRef.current = requestAnimationFrame(() => {
 90:         const nx = Math.max(-200, Math.min(e.clientX - dragOffset.x, window.innerWidth - 200));
 91:         const ny = Math.max(-200, Math.min(e.clientY - dragOffset.y, window.innerHeight - 200));
 92:         updateAttrs({
 93:           "data-position-x": Math.round(nx),
 94:           "data-position-y": Math.round(ny),
 95:         });
 96:         dragFrameRef.current = 0;
 97:       });
 98:     };
 99:     const handleUp = () => {
100:       setIsDragging(false);
101:       if (dragFrameRef.current) {
102:         cancelAnimationFrame(dragFrameRef.current);
103:         dragFrameRef.current = 0;
104:       }
105:     };
106:     document.addEventListener("mousemove", handleDrag, { passive: true });
107:     document.addEventListener("mouseup", handleUp, { once: true });
108:     return () => {
109:       document.removeEventListener("mousemove", handleDrag);
110:       document.removeEventListener("mouseup", handleUp);
111:       if (dragFrameRef.current) {
112:         cancelAnimationFrame(dragFrameRef.current);
113:       }
114:     };
115:   }, [isDragging, dragOffset, updateAttrs]);
116:   const setAlignment = useCallback(
117:     (value: string) => {
118:       updateAttrs({ "data-align": value });
119:     },
120:     [updateAttrs]
121:   );
122:   const saveCaption = useCallback(() => {
123:     const trimmed = caption.trim();
124:     updateAttrs({ "data-caption": trimmed || null });
125:   }, [caption, updateAttrs]);
126:   const toggleWrap = useCallback(() => {
127:     const next: WrapMode = wrapMode === "inline" ? "break" : "inline";
128:     setWrapMode(next);
129:     updateAttrs({ "data-wrap": next });
130:   }, [wrapMode, updateAttrs]);
131:   const copyImageUrl = useCallback(async () => {
132:     try {
133:       await navigator.clipboard.writeText(props.node.attrs.src);
134:       showSuccessToast("Image URL copied");
135:     } catch {
136:       showErrorToast("Failed to copy");
137:     }
138:   }, [props.node.attrs.src]);
139:   const deleteImage = useCallback(() => {
140:     requestAnimationFrame(() => {
141:       editor.chain().focus().deleteSelection().run();
142:     });
143:   }, [editor]);
144:   const resetPosition = useCallback(() => {
145:     updateAttrs({ "data-position-x": 0, "data-position-y": 0 });
146:   }, [updateAttrs]);
147:   const imageStyle: React.CSSProperties = {
148:     display: wrapMode === "break" ? "block" : "inline-block",
149:     marginLeft: align === "center" && wrapMode === "break" ? "auto" : undefined,
150:     marginRight: align === "center" && wrapMode === "break" ? "auto" : undefined,
151:     transform: `translate(${posX}px, ${posY}px)`,
152:     transition: isDragging ? "none" : "transform 0.15s ease-out",
153:     willChange: isDragging ? "transform" : "auto",
154:     position: "relative",
155:     cursor: isDragging ? "grabbing" : "grab",
156:     zIndex: isDragging ? 1000 : 1,
157:     textAlign: wrapMode === "break" ? (align as React.CSSProperties["textAlign"]) : undefined,
158:   };
159:   return (
160:     <NodeViewWrapper
161:       className={`scholar-image ${isDragging ? "is-dragging" : ""} wrap-${wrapMode}`}
162:       data-drag-handle
163:       ref={containerRef}
164:       style={imageStyle}
165:     >
166:       <Popover>
167:         <PopoverTrigger asChild>
168:           <div
169:             className="image-body"
170:             onMouseDown={handleDragStart}
171:             style={{ display: "inline-block", position: "relative", outline: "none" }}
172:           >
173:             {}
174:             <div className="image-drag-overlay">
175:               <GripHorizontal className="h-4 w-4" />
176:             </div>
177:             {}
178:             <ResizableImageComponent {...props} />
179:             {}
180:             {caption && (
181:               <figcaption
182:                 className="image-caption-display"
183:                 onMouseDown={(e) => e.stopPropagation()}
184:               >
185:                 {caption}
186:               </figcaption>
187:             )}
188:           </div>
189:         </PopoverTrigger>
190:         <PopoverContent className="w-64 p-3" side="bottom" align="center" sideOffset={8}>
191:           <div className="space-y-2">
192:             {}
193:             <div className="flex items-center gap-1.5">
194:               <Type className="h-3.5 w-3.5 text-muted-foreground flex-shrink-0" />
195:               <input
196:                 type="text"
197:                 value={caption}
198:                 onChange={(e) => setCaption(e.target.value)}
199:                 onBlur={saveCaption}
200:                 onKeyDown={(e) => e.key === "Enter" && saveCaption()}
201:                 placeholder="Add caption..."
202:                 className="flex-1 text-xs border rounded px-2 py-1 bg-background focus:outline-none focus:ring-1 focus:ring-primary"
203:                 onMouseDown={(e) => e.stopPropagation()}
204:               />
205:             </div>
206:             {}
207:             <div className="flex items-center gap-1">
208:               <span className="text-xs text-muted-foreground mr-1 w-10">Align:</span>
209:               <Button variant="outline" size="sm" className="h-7 w-7 p-0" onClick={() => setAlignment("left")} title="Left">
210:                 <AlignLeft className="h-3.5 w-3.5" />
211:               </Button>
212:               <Button variant="outline" size="sm" className="h-7 w-7 p-0" onClick={() => setAlignment("center")} title="Center">
213:                 <AlignCenter className="h-3.5 w-3.5" />
214:               </Button>
215:               <Button variant="outline" size="sm" className="h-7 w-7 p-0" onClick={() => setAlignment("right")} title="Right">
216:                 <AlignRight className="h-3.5 w-3.5" />
217:               </Button>
218:             </div>
219:             {}
220:             <div className="flex items-center gap-1">
221:               <span className="text-xs text-muted-foreground mr-1 w-10">Wrap:</span>
222:               <Button
223:                 variant={wrapMode === "inline" ? "default" : "outline"}
224:                 size="sm"
225:                 className="h-7 text-xs"
226:                 onClick={toggleWrap}
227:               >
228:                 <WrapText className="h-3.5 w-3.5 mr-1" />
229:                 {wrapMode === "inline" ? "Inline" : "Break"}
230:               </Button>
231:             </div>
232:             <div className="border-t pt-2 flex items-center gap-1 flex-wrap">
233:               <Button variant="outline" size="sm" className="h-7 text-xs" onClick={copyImageUrl}>
234:                 <Copy className="h-3 w-3 mr-1" /> Copy
235:               </Button>
236:               <Button variant="outline" size="sm" className="h-7 text-xs" onClick={resetPosition}>
237:                 <Move className="h-3 w-3 mr-1" /> Reset
238:               </Button>
239:               <Button variant="destructive" size="sm" className="h-7 text-xs" onClick={deleteImage}>
240:                 <Trash2 className="h-3 w-3 mr-1" /> Delete
241:               </Button>
242:             </div>
243:           </div>
244:         </PopoverContent>
245:       </Popover>
246:     </NodeViewWrapper>
247:   );
248: };
249: export const ResizableImageWithPopover = ResizableImage.extend({
250:   addAttributes() {
251:     return {
252:       ...this.parent?.(),
253:       "data-position-x": {
254:         default: 0,
255:         parseHTML: (el) => parseFloat(el.getAttribute("data-position-x") || "0"),
256:         renderHTML: (attrs) => ({ "data-position-x": attrs["data-position-x"] }),
257:       },
258:       "data-position-y": {
259:         default: 0,
260:         parseHTML: (el) => parseFloat(el.getAttribute("data-position-y") || "0"),
261:         renderHTML: (attrs) => ({ "data-position-y": attrs["data-position-y"] }),
262:       },
263:       "data-align": {
264:         default: "center",
265:         parseHTML: (el) => el.getAttribute("data-align") || "center",
266:         renderHTML: (attrs) => ({ "data-align": attrs["data-align"] }),
267:       },
268:       "data-caption": {
269:         default: null,
270:         parseHTML: (el) => el.getAttribute("data-caption") || null,
271:         renderHTML: (attrs) => {
272:           if (!attrs["data-caption"]) return {};
273:           return { "data-caption": attrs["data-caption"] };
274:         },
275:       },
276:       "data-wrap": {
277:         default: "inline",
278:         parseHTML: (el) => el.getAttribute("data-wrap") || "inline",
279:         renderHTML: (attrs) => ({ "data-wrap": attrs["data-wrap"] }),
280:       },
281:     };
282:   },
283:   addNodeView() {
284:     return ReactNodeViewRenderer(
285:       (props) => NodeView(props as unknown as ResizableImageNodeViewRendererProps)
286:     );
287:   },
288: });
