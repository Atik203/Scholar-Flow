454:         success: false,
455:         error:
456:           error instanceof Error ? error.message : "DOCX extraction failed",
457:       };
458:     }
459:   }
460:   private createStructuredChunks(
461:     text: string,
462:     pageCount: number,
463:     chunkSize: number
464:   ): Array<{
465:     idx: number;
466:     page?: number;
467:     content: string;
468:     tokenCount?: number;
469:   }> {
470:     if (!text) return [];
471:     const chunks: Array<{
472:       idx: number;
473:       page?: number;
474:       content: string;
475:       tokenCount?: number;
476:     }> = [];
477:     const sections = this.identifyDocumentSections(text);
478:     let chunkIndex = 0;
479:     const safePageCount = Math.max(1, pageCount);
480:     for (const section of sections) {
481:       const sectionChunks = this.splitIntoChunks(section.content, chunkSize);
482:       for (const chunkText of sectionChunks) {
483:         const sanitized = this.sanitizeText(chunkText);
484:         if (sanitized.length > 0) {
485:           const estimatedPage = Math.min(
486:             Math.ceil((chunkIndex + 1) * (safePageCount / sections.length)),
487:             safePageCount
488:           );
489:           chunks.push({
490:             idx: chunkIndex++,
491:             page: estimatedPage,
492:             content: sanitized,
493:             tokenCount: this.estimateTokenCount(sanitized),
494:           });
495:         }
496:       }
497:     }
498:     return chunks;
499:   }
500:   private createStructuredChunksFromHtml(
501:     plainText: string,
502:     htmlContent: string,
503:     chunkSize: number
504:   ): Array<{
505:     idx: number;
506:     page?: number;
507:     content: string;
508:     htmlContent?: string;
509:     tokenCount?: number;
510:   }> {
511:     if (!plainText) return [];
512:     const chunks: Array<{
513:       idx: number;
514:       page?: number;
515:       content: string;
516:       htmlContent?: string;
517:       tokenCount?: number;
518:     }> = [];
519:     const htmlSections = this.parseHtmlSections(htmlContent);
520:     const textSections = this.identifyDocumentSections(plainText);
521:     let chunkIndex = 0;
522:     for (
523:       let i = 0;
524:       i < Math.max(htmlSections.length, textSections.length);
525:       i++
526:     ) {
527:       const htmlSection = htmlSections[i];
528:       const textSection = textSections[i];
529:       const content = textSection?.content || "";
530:       const htmlPart = htmlSection?.html || "";
531:       if (content.length > 0) {
532:         const contentChunks = this.splitIntoChunks(content, chunkSize);
533:         const htmlChunks = htmlPart
534:           ? this.splitHtmlIntoChunks(htmlPart, chunkSize)
535:           : [];
536:         for (let j = 0; j < contentChunks.length; j++) {
537:           const sanitizedContent = this.sanitizeText(contentChunks[j]);
538:           const sanitizedHtml = htmlChunks[j]
539:             ? this.sanitizeText(htmlChunks[j])
540:             : undefined;
541:           if (sanitizedContent.length > 0) {
542:             chunks.push({
543:               idx: chunkIndex++,
544:               page: 1, // DOCX is treated as single page
545:               content: sanitizedContent,
546:               htmlContent: sanitizedHtml,
547:               tokenCount: this.estimateTokenCount(sanitizedContent),
548:             });
549:           }
550:         }
551:       }
552:     }
553:     return chunks;
554:   }
555:   /**
556:    * Identify document sections based on headings and structure
557:    */
558:   private identifyDocumentSections(
559:     text: string
560:   ): Array<{ type: string; content: string }> {
561:     const sections: Array<{ type: string; content: string }> = [];
562:     // Split by common section patterns
563:     const sectionPatterns = [
564:       /^(abstract|summary|introduction|background|methodology|results|conclusion|references?|bibliography)[\s\n]/im,
565:       /^[IVX]+\.\s+/m, // Roman numerals
566:       /^\d+\.\s+/m, // Numbered sections
567:       /^#+\s+/m, // Markdown-style headers
568:     ];
569:     let currentSection = { type: "content", content: "" };
570:     const lines = text.split("\n");
571:     for (const line of lines) {
572:       let isNewSection = false;
573:       for (const pattern of sectionPatterns) {
574:         if (pattern.test(line)) {
575:           if (currentSection.content.trim().length > 0) {
576:             sections.push(currentSection);
577:           }
578:           currentSection = {
579:             type: line
580:               .trim()
581:               .toLowerCase()
582:               .replace(/[^\w\s]/g, "")
583:               .substring(0, 20),
584:             content: line + "\n",
585:           };
586:           isNewSection = true;
587:           break;
588:         }
589:       }
590:       if (!isNewSection) {
591:         currentSection.content += line + "\n";
592:       }
593:     }
594:     if (currentSection.content.trim().length > 0) {
595:       sections.push(currentSection);
596:     }
597:     if (sections.length === 0) {
598:       sections.push({ type: "content", content: text });
599:     }
600:     return sections;
601:   }
602:   private parseHtmlSections(
603:     html: string
604:   ): Array<{ type: string; html: string }> {
605:     const sections: Array<{ type: string; html: string }> = [];
606:     const htmlSectionRegex =
607:       /<(h[1-6]|div|section|article|p)([^>]*)>(.*?)<\/\1>/gis;
608:     let match;
609:     let lastIndex = 0;
610:     while ((match = htmlSectionRegex.exec(html)) !== null) {
611:       const [fullMatch, tag] = match;
612:       if (match.index > lastIndex) {
613:         const beforeContent = html.slice(lastIndex, match.index).trim();
614:         if (beforeContent) {
615:           sections.push({ type: "content", html: beforeContent });
616:         }
617:       }
618:       sections.push({
619:         type: tag.toLowerCase(),
620:         html: fullMatch,
621:       });
622:       lastIndex = match.index + fullMatch.length;
623:     }
624:     if (lastIndex < html.length) {
625:       const remainingContent = html.slice(lastIndex).trim();
626:       if (remainingContent) {
627:         sections.push({ type: "content", html: remainingContent });
628:       }
629:     }
630:     return sections;
631:   }
632:   private splitHtmlIntoChunks(html: string, maxSize: number): string[] {
633:     const chunks: string[] = [];
634:     const elements = html.split(/(<\/(?:p|div|h[1-6]|section|article)>)/i);
635:     let currentChunk = "";
636:     for (const element of elements) {
637:       if (
638:         currentChunk.length + element.length > maxSize &&
639:         currentChunk.length > 0
640:       ) {
641:         chunks.push(currentChunk.trim());
642:         currentChunk = element;
643:       } else {
644:         currentChunk += element;
645:       }
646:     }
647:     if (currentChunk.trim().length > 0) {
648:       chunks.push(currentChunk.trim());
649:     }
650:     return chunks;
651:   }
652:   /**
653:    * Split text into chunks while preserving sentence boundaries
654:    */
655:   private splitIntoChunks(text: string, maxSize: number): string[] {
656:     const chunks: string[] = [];
657:     let currentChunk = "";
658:     // Split by sentences first, then by paragraphs if needed
659:     const sentences = text.split(/(?<=[.!?])\s+/);
660:     for (const sentence of sentences) {
661:       if (
662:         currentChunk.length + sentence.length > maxSize &&
663:         currentChunk.length > 0
664:       ) {
665:         chunks.push(currentChunk.trim());
666:         currentChunk = sentence;
667:       } else {
668:         currentChunk += (currentChunk ? " " : "") + sentence;
669:       }
670:     }
671:     if (currentChunk.trim().length > 0) {
672:       chunks.push(currentChunk.trim());
673:     }
674:     return chunks;
675:   }
676:   /**
677:    * Estimate token count (rough approximation)
678:    */
679:   private estimateTokenCount(text: string): number {
680:     // Rough estimation: 1 token ≈ 4 characters
681:     return Math.ceil(text.length / 4);
682:   }
683:   /**
684:    * Sanitize text content to remove problematic characters
685:    */
686:   private sanitizeText(text: string): string {
687:     if (!text) return "";
688:     // Fast path: replace explicit null bytes first
689:     let cleaned = text.replace(/\0/g, "");
690:     // Filter out remaining problematic code points while preserving common whitespace
691:     const builder: string[] = [];
692:     for (const ch of cleaned) {
693:       const code = ch.codePointAt(0)!;
694:       // Remove C0 controls except tab (9), LF (10), CR (13)
695:       if (code < 32 && code !== 9 && code !== 10 && code !== 13) continue;
696:       // Delete DEL
697:       if (code === 127) continue;
698:       // Remove surrogate halves (invalid in UTF-8/UTF-32 strings)
699:       if (code >= 0xd800 && code <= 0xdfff) continue;
700:       // Remove non-characters U+FFFE, U+FFFF
701:       if (code === 0xfffe || code === 0xffff) continue;
702:       builder.push(ch);
703:     }
704:     cleaned = builder.join("");
705:     return cleaned.trim();
706:   }
707:   /**
708:    * Store chunks in database with enhanced content support
709:    */
710:   private async storeChunks(
711:     paperId: string,
712:     chunks: Array<{
713:       idx: number;
714:       page?: number;
715:       content: string;
716:       htmlContent?: string;
717:       tokenCount?: number;
718:     }>
719:   ): Promise<void> {
720:     // Prepare chunks for insertion
721:     const prepared = chunks
722:       .map((chunk) => ({
723:         paperId,
724:         idx: chunk.idx,
725:         page: chunk.page,
726:         content: this.sanitizeText(chunk.content),
727:         // Note: Add htmlContent field to schema if needed for HTML storage
728:         tokenCount: chunk.tokenCount,
729:       }))
730:       .filter((c) => c.content && c.content.length > 0);
731:     // Delete + insert atomically — an interruption must not leave the paper
732:     // with a half-written chunk set.
733:     await prisma.$transaction(async (tx) => {
734:       await tx.$executeRaw`
735:         DELETE FROM "PaperChunk"
736:         WHERE "paperId" = ${paperId}
737:       `;
738:       if (prepared.length > 0) {
739:         const values = prepared.map(
740:           (chunk) =>
741:             Prisma.sql`(gen_random_uuid(), ${paperId}, ${chunk.idx}, ${chunk.page ?? null}, ${chunk.content}, ${chunk.tokenCount ?? null}, NOW(), NOW(), false)`
742:         );
743:         await tx.$executeRaw(
744:           Prisma.sql`
745:             INSERT INTO "PaperChunk" (id, "paperId", "idx", "page", "content", "tokenCount", "createdAt", "updatedAt", "isDeleted")
746:             VALUES ${Prisma.join(values)}
747:           `
748:         );
749:       }
750:     });
751:   }
752:   /**
753:    * Process all unprocessed papers with the new extraction service
754:    */
755:   async processUnprocessedPapers(): Promise<void> {
756:     const unprocessedPapers = await this.fetchUnprocessedPapers();
757:     console.log(
758:       `[DocumentExtraction] Found ${unprocessedPapers.length} unprocessed papers`
759:     );
760:     for (const paper of unprocessedPapers) {
761:       if (paper.file) {
