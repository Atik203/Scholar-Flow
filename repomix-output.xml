320: export const aiService = {
321:   async getProviderStatuses(): Promise<ProviderStatus[]> {
322:     let dbRows: any[];
323:     try {
324:       dbRows = await prisma.aIProvider.findMany({
325:         where: { isDeleted: false },
326:         orderBy: [{ provider: "asc" }, { displayOrder: "asc" }],
327:       });
328:     } catch (err: any) {
329:       if (err?.code === "P2021") {
330:         dbRows = [];
331:       } else {
332:         throw err;
333:       }
334:     }
335:     if (dbRows.length === 0) {
336:       return ALL_PROVIDERS.map((provider) => {
337:         const instance = providers[provider];
338:         const configured = Boolean(instance?.isEnabled());
339:         return {
340:           provider,
341:           configured,
342:           models: configured
343:             ? PROVIDER_MODEL_MAP[provider] ?? EMPTY_MODELS
344:             : EMPTY_MODELS,
345:         };
346:       });
347:     }
348:     const byProvider = new Map<string, typeof dbRows>();
349:     for (const row of dbRows) {
350:       const arr = byProvider.get(row.provider) ?? [];
351:       arr.push(row);
352:       byProvider.set(row.provider, arr);
353:     }
354:     const statuses: ProviderStatus[] = [];
355:     for (const [providerKey, rows] of byProvider.entries()) {
356:       const knownInstance = (providers as Record<string, BaseAiProvider | null>)[providerKey];
357:       const providerConfigured = knownInstance
358:         ? Boolean(knownInstance.isEnabled())
359:         : rows.some((r) => r.apiKeyEnvName && Boolean(process.env[r.apiKeyEnvName]));
360:       const models: ProviderModel[] = rows.map((row) => ({
361:         value: row.model,
362:         label: row.displayName,
363:         description: row.description ?? "",
364:         provider: row.provider,
365:       }));
366:       statuses.push({
367:         provider: providerKey as ProviderName,
368:         configured: providerConfigured,
369:         models: providerConfigured
370:           ? models
371:           : [],
372:       });
373:     }
374:     // Preserve the original static provider order so the UI's fallback
375:     // ordering matches what users saw before the catalog existed.
376:     statuses.sort((a, b) => {
377:       const ai = ALL_PROVIDERS.indexOf(a.provider as ProviderName);
378:       const bi = ALL_PROVIDERS.indexOf(b.provider as ProviderName);
379:       if (ai === -1 && bi === -1) return 0;
380:       if (ai === -1) return 1;
381:       if (bi === -1) return -1;
382:       return ai - bi;
383:     });
