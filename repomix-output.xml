<file path="apps/frontend/src/components/discussions/CreateDiscussionDialog.tsx">
  1: "use client";
  2: import { useState } from "react";
  3: import { Button } from "@/components/ui/button";
  4: import {
  5:   Dialog,
  6:   DialogContent,
  7:   DialogDescription,
  8:   DialogHeader,
  9:   DialogTitle,
 10:   DialogTrigger,
 11: } from "@/components/ui/dialog";
 12: import {
 13:   Form,
 14:   FormControl,
 15:   FormField,
 16:   FormItem,
 17:   FormLabel,
 18:   FormMessage,
 19: } from "@/components/ui/form";
 20: import { Input } from "@/components/ui/input";
 21: import { Textarea } from "@/components/ui/textarea";
 22: import { Badge } from "@/components/ui/badge";
 23: import { showErrorToast, showSuccessToast } from "@/components/providers/ToastProvider";
 24: import { useCreateDiscussionMutation } from "@/redux/api/discussionApi";
 25: import { MessageSquare, Plus, Pin, CheckCircle, XCircle } from "lucide-react";
 26: import { useForm } from "react-hook-form";
 27: import { zodResolver } from "@hookform/resolvers/zod";
 28: import { z } from "zod";
 29: const discussionFormSchema = z.object({
 30:   title: z.string().min(1, "Title is required").max(200, "Title too long"),
 31:   content: z.string().min(1, "Content is required").max(5000, "Content too long"),
 32:   tags: z.string().optional(),
 33: });
 34: type DiscussionFormData = z.infer<typeof discussionFormSchema>;
 35: interface CreateDiscussionDialogProps {
 36:   paperId?: string;
 37:   collectionId?: string;
 38:   workspaceId?: string;
 39:   paperTitle?: string;
 40:   collectionName?: string;
 41:   workspaceName?: string;
 42:   trigger?: React.ReactNode;
 43:   onDiscussionCreated?: () => void;
 44: }
 45: export function CreateDiscussionDialog({
 46:   paperId,
 47:   collectionId,
 48:   workspaceId,
 49:   paperTitle,
 50:   collectionName,
 51:   workspaceName,
 52:   trigger,
 53:   onDiscussionCreated
 54: }: CreateDiscussionDialogProps) {
 55:   const [isOpen, setIsOpen] = useState(false);
 56:   const [createDiscussion, { isLoading: isCreating }] =
 57:     useCreateDiscussionMutation();
 58:   const form = useForm<DiscussionFormData>({
 59:     resolver: zodResolver(discussionFormSchema),
 60:     defaultValues: {
 61:       title: "",
 62:       content: "",
 63:       tags: "",
 64:     },
 65:   });
 66:   const getContextInfo = () => {
 67:     if (paperId) return { type: "Paper", name: paperTitle || "Unknown Paper" };
 68:     if (collectionId) return { type: "Collection", name: collectionName || "Unknown Collection" };
 69:     if (workspaceId) return { type: "Workspace", name: workspaceName || "Unknown Workspace" };
 70:     return { type: "General", name: "Discussion" };
 71:   };
 72:   const handleCreateDiscussion = async (data: DiscussionFormData) => {
 73:     try {
 74:       const tags = data.tags ? data.tags.split(',').map(tag => tag.trim()).filter(tag => tag) : [];
 75:       await createDiscussion({
 76:         title: data.title,
 77:         content: data.content,
 78:         tags,
 79:         ...(paperId && { paperId }),
 80:         ...(collectionId && { collectionId }),
 81:         ...(workspaceId && { workspaceId }),
 82:       }).unwrap();
 83:       showSuccessToast('Discussion created successfully');
 84:       setIsOpen(false);
 85:       form.reset();
 86:       onDiscussionCreated?.();
 87:     } catch (error: unknown) {
 88:       showErrorToast('Failed to create discussion. Please try again.');
 89:     }
 90:   };
 91:   const contextInfo = getContextInfo();
 92:   return (
 93:     <Dialog open={isOpen} onOpenChange={setIsOpen}>
 94:       <DialogTrigger asChild>
 95:         {trigger || (
 96:           <Button variant="outline" size="sm">
 97:             <MessageSquare className="h-4 w-4 mr-2" />
 98:             Start Discussion
 99:           </Button>
100:         )}
101:       </DialogTrigger>
102:       <DialogContent className="max-w-2xl">
103:         <DialogHeader>
104:           <DialogTitle className="flex items-center gap-2">
105:             <MessageSquare className="h-5 w-5" />
106:             Create Discussion
107:           </DialogTitle>
108:           <DialogDescription>
109:             Start a new discussion for {contextInfo.type}: {contextInfo.name}
110:           </DialogDescription>
111:         </DialogHeader>
112:         <Form {...form}>
113:           <form onSubmit={form.handleSubmit(handleCreateDiscussion)} className="space-y-4">
114:             <FormField
115:               control={form.control}
116:               name="title"
117:               render={({ field }: { field: any }) => (
118:                 <FormItem>
119:                   <FormLabel>Discussion Title</FormLabel>
120:                   <FormControl>
121:                     <Input
122:                       placeholder="Enter a descriptive title for your discussion"
123:                       {...field}
124:                     />
125:                   </FormControl>
126:                   <FormMessage />
127:                 </FormItem>
128:               )}
129:             />
130:             <FormField
131:               control={form.control}
132:               name="content"
133:               render={({ field }: { field: any }) => (
134:                 <FormItem>
135:                   <FormLabel>Discussion Content</FormLabel>
136:                   <FormControl>
137:                     <Textarea
138:                       placeholder="Share your thoughts, questions, or insights..."
139:                       className="min-h-[150px]"
140:                       {...field}
141:                     />
142:                   </FormControl>
143:                   <FormMessage />
144:                 </FormItem>
145:               )}
146:             />
147:             <FormField
148:               control={form.control}
149:               name="tags"
150:               render={({ field }: { field: any }) => (
151:                 <FormItem>
152:                   <FormLabel>Tags (optional)</FormLabel>
153:                   <FormControl>
154:                     <Input
155:                       placeholder="Enter tags separated by commas (e.g., methodology, results, question)"
156:                       {...field}
157:                     />
158:                   </FormControl>
159:                   <FormMessage />
160:                 </FormItem>
161:               )}
162:             />
163:             <div className="flex justify-end gap-2">
164:               <Button
165:                 type="button"
166:                 variant="outline"
167:                 onClick={() => setIsOpen(false)}
168:               >
169:                 Cancel
170:               </Button>
171:               <Button type="submit" disabled={isCreating}>
172:                 {isCreating ? (
173:                   <>
174:                     <div className="h-4 w-4 mr-2 animate-spin rounded-full border-2 border-current border-t-transparent" />
175:                     Creating...
176:                   </>
177:                 ) : (
178:                   <>
179:                     <Plus className="h-4 w-4 mr-2" />
180:                     Create Discussion
181:                   </>
182:                 )}
183:               </Button>
184:             </div>
185:           </form>
186:         </Form>
187:       </DialogContent>
188:     </Dialog>
189:   );
190: }
</file>

<file path="apps/frontend/src/components/discussions/DiscussionThreadCard.tsx">
  1: "use client";
  2: import { Button } from "@/components/ui/button";
  3: import {
  4:   Card,
  5:   CardContent,
  6:   CardDescription,
  7:   CardHeader,
  8:   CardTitle,
  9: } from "@/components/ui/card";
 10: import { Badge } from "@/components/ui/badge";
 11: import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
 12: import {
 13:   DropdownMenu,
 14:   DropdownMenuContent,
 15:   DropdownMenuItem,
 16:   DropdownMenuTrigger,
 17: } from "@/components/ui/dropdown-menu";
 18: import { showErrorToast, showSuccessToast } from "@/components/providers/ToastProvider";
 19: import type { DiscussionThread } from "@/redux/api/discussionApi";
 20: import {
 21:   useTogglePinMutation,
 22:   useToggleResolveMutation,
 23:   useDeleteDiscussionMutation,
 24: } from "@/redux/api/discussionApi";
 25: import { useAuth } from "@/redux/auth/useAuth";
 26: import {
 27:   MessageSquare,
 28:   Pin,
 29:   CheckCircle,
 30:   XCircle,
 31:   MoreVertical,
 32:   Edit,
 33:   Trash2,
 34:   Reply,
 35:   Calendar,
 36:   User,
 37: } from "lucide-react";
 38: import { formatDistanceToNow } from "date-fns";
 39: type MessageAuthor = DiscussionThread["author"];
 40: interface DiscussionThreadCardProps {
 41:   thread: DiscussionThread;
 42:   currentUserId?: string;
 43:   onThreadUpdate?: () => void;
 44:   onThreadDelete?: () => void;
 45:   onReply?: (threadId: string) => void;
 46: }
 47: export function DiscussionThreadCard({
 48:   thread,
 49:   currentUserId,
 50:   onThreadUpdate,
 51:   onThreadDelete,
 52:   onReply
 53: }: DiscussionThreadCardProps) {
 54:   const { user: authUser } = useAuth();
 55:   const effectiveUserId = currentUserId ?? authUser?.id;
 56:   const [toggleResolve, { isLoading: isTogglingResolve }] =
 57:     useToggleResolveMutation();
 58:   const [togglePin, { isLoading: isTogglingPin }] = useTogglePinMutation();
 59:   const [deleteThread, { isLoading: isDeleting }] =
 60:     useDeleteDiscussionMutation();
 61:   const isUpdating = isTogglingResolve || isTogglingPin || isDeleting;
 62:   const getUserDisplayName = (user: DiscussionThread['author']) => {
 63:     if (user.firstName && user.lastName) {
 64:       return `${user.firstName} ${user.lastName}`;
 65:     }
 66:     return user.name || 'Unknown User';
 67:   };
 68:   const getUserInitials = (user: DiscussionThread['author']) => {
 69:     if (user.firstName && user.lastName) {
 70:       return `${user.firstName[0]}${user.lastName[0]}`.toUpperCase();
 71:     }
 72:     if (user.name) {
 73:       return user.name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
 74:     }
 75:     return 'U';
 76:   };
 77:   const handleToggleResolved = async () => {
 78:     try {
 79:       await toggleResolve(thread.id).unwrap();
 80:       showSuccessToast(
 81:         thread.isResolved ? 'Discussion marked as unresolved' : 'Discussion marked as resolved'
 82:       );
 83:       onThreadUpdate?.();
 84:     } catch (error: unknown) {
 85:       showErrorToast('Failed to update discussion. Please try again.');
 86:     }
 87:   };
 88:   const handleTogglePinned = async () => {
 89:     try {
 90:       await togglePin(thread.id).unwrap();
 91:       showSuccessToast(
 92:         thread.isPinned ? 'Discussion unpinned' : 'Discussion pinned'
 93:       );
 94:       onThreadUpdate?.();
 95:     } catch (error: unknown) {
 96:       showErrorToast('Failed to update discussion. Please try again.');
 97:     }
 98:   };
 99:   const handleDelete = async () => {
100:     if (!confirm('Are you sure you want to delete this discussion? This action cannot be undone.')) {
101:       return;
102:     }
103:     try {
104:       await deleteThread(thread.id).unwrap();
105:       showSuccessToast('Discussion deleted successfully');
106:       onThreadDelete?.();
107:     } catch (error: unknown) {
108:       showErrorToast('Failed to delete discussion. Please try again.');
109:     }
110:   };
111:   const isOwner = effectiveUserId === thread.author.id;
112:   return (
113:     <Card className={`transition-all hover:shadow-md ${thread.isPinned ? 'border-primary' : ''}`}>
114:       <CardHeader className="pb-3">
115:         <div className="flex items-start justify-between">
116:           <div className="flex-1 min-w-0">
117:             <div className="flex items-center gap-2 mb-2">
118:               {thread.isPinned && (
119:                 <Pin className="h-4 w-4 text-primary" />
120:               )}
121:               <CardTitle className="text-lg leading-tight">
122:                 {thread.title}
123:               </CardTitle>
124:               {thread.isResolved && (
125:                 <Badge variant="secondary" className="ml-2">
126:                   <CheckCircle className="h-3 w-3 mr-1" />
127:                   Resolved
128:                 </Badge>
129:               )}
130:             </div>
131:             <CardDescription className="line-clamp-2">
132:               {thread.content}
133:             </CardDescription>
134:           </div>
135:           {isOwner && (
136:             <DropdownMenu>
137:               <DropdownMenuTrigger asChild>
138:                 <Button variant="ghost" size="sm" className="h-8 w-8 p-0">
139:                   <MoreVertical className="h-4 w-4" />
140:                 </Button>
141:               </DropdownMenuTrigger>
142:               <DropdownMenuContent align="end">
143:                 <DropdownMenuItem onClick={handleToggleResolved} disabled={isUpdating}>
144:                   {thread.isResolved ? (
145:                     <>
146:                       <XCircle className="h-4 w-4 mr-2" />
147:                       Mark as Unresolved
148:                     </>
149:                   ) : (
150:                     <>
151:                       <CheckCircle className="h-4 w-4 mr-2" />
152:                       Mark as Resolved
153:                     </>
154:                   )}
155:                 </DropdownMenuItem>
156:                 <DropdownMenuItem onClick={handleTogglePinned} disabled={isUpdating}>
157:                   <Pin className="h-4 w-4 mr-2" />
158:                   {thread.isPinned ? 'Unpin' : 'Pin'} Discussion
159:                 </DropdownMenuItem>
160:                 <DropdownMenuItem onClick={handleDelete} disabled={isUpdating} className="text-destructive">
161:                   <Trash2 className="h-4 w-4 mr-2" />
162:                   Delete
163:                 </DropdownMenuItem>
164:               </DropdownMenuContent>
165:             </DropdownMenu>
166:           )}
167:         </div>
168:         {}
169:         {thread.tags.length > 0 && (
170:           <div className="flex flex-wrap gap-1 mt-2">
171:             {thread.tags.map((tag, index) => (
172:               <Badge key={index} variant="outline" className="text-xs">
173:                 {tag}
174:               </Badge>
175:             ))}
176:           </div>
177:         )}
178:       </CardHeader>
179:       <CardContent className="pt-0">
180:         <div className="flex items-center justify-between text-sm text-muted-foreground">
181:           <div className="flex items-center gap-4">
182:             <div className="flex items-center gap-2">
183:               <Avatar className="h-6 w-6">
184:                 <AvatarImage src={thread.author.image} />
185:                 <AvatarFallback className="text-xs">
186:                   {getUserInitials(thread.author)}
187:                 </AvatarFallback>
188:               </Avatar>
189:               <span>{getUserDisplayName(thread.author)}</span>
190:             </div>
191:             <div className="flex items-center gap-1">
192:               <Calendar className="h-3 w-3" />
193:               <span>{formatDistanceToNow(new Date(thread.createdAt), { addSuffix: true })}</span>
194:             </div>
195:             <div className="flex items-center gap-1">
196:               <MessageSquare className="h-3 w-3" />
197:               <span>{thread._count.messages} message{thread._count.messages !== 1 ? 's' : ''}</span>
198:             </div>
199:           </div>
200:           <Button
201:             variant="outline"
202:             size="sm"
203:             onClick={() => onReply?.(thread.id)}
204:           >
205:             <Reply className="h-3 w-3 mr-1" />
206:             Reply
207:           </Button>
208:         </div>
209:         {}
210:         {thread.messages && thread.messages.length > 0 && (
211:           <div className="mt-3 p-2 bg-muted rounded-md">
212:             <div className="flex items-center gap-2 text-xs text-muted-foreground mb-1">
213:               <User className="h-3 w-3" />
214:               <span>{getUserDisplayName(thread.messages[0]?.user || thread.author)}</span>
215:               <span>•</span>
216:               <span>{formatDistanceToNow(new Date(thread.messages[0].createdAt), { addSuffix: true })}</span>
217:             </div>
218:             <div className="text-sm line-clamp-2">
219:               {thread.messages[0].content}
220:             </div>
221:           </div>
222:         )}
223:       </CardContent>
224:     </Card>
225:   );
226: }
</file>

<file path="apps/frontend/src/components/discussions/LiveDiscussionFeed.tsx">
  1: "use client";
  2: import { useDiscussionSocket, DiscussionMessage } from "@/hooks/useDiscussionSocket";
  3: import { cn } from "@/lib/utils";
  4: import { MessageCircle, Users } from "lucide-react";
  5: import { useCallback, useEffect, useRef, useState } from "react";
  6: import { Input } from "@/components/ui/input";
  7: import { Button } from "@/components/ui/button";
  8: import { ScrollArea } from "@/components/ui/scroll-area";
  9: import { Badge } from "@/components/ui/badge";
 10: import { Send } from "lucide-react";
 11: interface LiveDiscussionFeedProps {
 12:   room: string;
 13: }
 14: export function LiveDiscussionFeed({ room }: LiveDiscussionFeedProps) {
 15:   const [messages, setMessages] = useState<DiscussionMessage[]>([]);
 16:   const [input, setInput] = useState("");
 17:   const scrollRef = useRef<HTMLDivElement>(null);
 18:   const onMessage = useCallback((msg: DiscussionMessage) => {
 19:     setMessages((prev) => [...prev, msg]);
 20:   }, []);
 21:   const { connected, memberCount, typingUsers, sendMessage, sendTyping } =
 22:     useDiscussionSocket({
 23:       room,
 24:       enabled: true,
 25:       onMessage,
 26:     });
 27:   useEffect(() => {
 28:     if (scrollRef.current) {
 29:       scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
 30:     }
 31:   }, [messages]);
 32:   const handleSend = () => {
 33:     const trimmed = input.trim();
 34:     if (!trimmed) return;
 35:     sendMessage(trimmed);
 36:     setInput("");
 37:   };
 38:   const handleTyping = (value: string) => {
 39:     setInput(value);
 40:     sendTyping(value.length > 0);
 41:   };
 42:   return (
 43:     <div className="flex flex-col border rounded-lg bg-card h-[400px]">
 44:       {/* Header */}
 45:       <div className="flex items-center justify-between px-4 py-2 border-b bg-muted/20">
 46:         <div className="flex items-center gap-2">
 47:           <MessageCircle className="h-4 w-4 text-primary" />
 48:           <span className="text-sm font-medium">Live Discussion</span>
 49:           {connected ? (
 50:             <Badge variant="outline" className="text-xs h-5 bg-green-50 text-green-700 border-green-200">
 51:               Live
 52:             </Badge>
 53:           ) : (
 54:             <Badge variant="outline" className="text-xs h-5 bg-red-50 text-red-700 border-red-200">
 55:               Offline
 56:             </Badge>
 57:           )}
 58:         </div>
 59:         <div className="flex items-center gap-1 text-xs text-muted-foreground">
 60:           <Users className="h-3 w-3" />
 61:           {memberCount}
 62:         </div>
 63:       </div>
 64:       {}
 65:       <ScrollArea className="flex-1 p-4" ref={scrollRef}>
 66:         {messages.length === 0 ? (
 67:           <p className="text-sm text-muted-foreground text-center py-8">
 68:             No messages yet. Start the conversation!
 69:           </p>
 70:         ) : (
 71:           <div className="space-y-3">
 72:             {messages.map((msg) => (
 73:               <div
 74:                 key={msg.id}
 75:                 className={cn(
 76:                   "text-sm",
 77:                   msg.userName === "You" ? "text-right" : "text-left"
 78:                 )}
 79:               >
 80:                 <div
 81:                   className={cn(
 82:                     "inline-block max-w-[85%] p-2.5 rounded-lg",
 83:                     msg.userName === "You"
 84:                       ? "bg-primary text-primary-foreground"
 85:                       : "bg-muted"
 86:                   )}
 87:                 >
 88:                   {msg.userName !== "You" && (
 89:                     <p className="text-xs font-medium mb-0.5 opacity-70">
 90:                       {msg.userName}
 91:                     </p>
 92:                   )}
 93:                   <p className="whitespace-pre-wrap break-words">{msg.content}</p>
 94:                   <p className="text-[10px] opacity-50 mt-1">
 95:                     {new Date(msg.timestamp).toLocaleTimeString()}
 96:                   </p>
 97:                 </div>
 98:               </div>
 99:             ))}
100:           </div>
101:         )}
102:         {}
103:         {typingUsers.length > 0 && (
104:           <div className="text-xs text-muted-foreground italic mt-2">
105:             {typingUsers.map((u) => u.userName).join(", ")} typing...
106:           </div>
107:         )}
108:       </ScrollArea>
109:       {}
110:       <div className="flex gap-2 p-3 border-t">
111:         <Input
112:           value={input}
113:           onChange={(e) => handleTyping(e.target.value)}
114:           onKeyDown={(e) => e.key === "Enter" && handleSend()}
115:           placeholder="Type a message..."
