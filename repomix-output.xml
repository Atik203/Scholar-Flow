  80:         const workspace = await tx.$queryRaw<any[]>`
  81:           INSERT INTO "Workspace" (id, name, "ownerId", color, visibility, "createdAt", "updatedAt", "isDeleted")
  82:           VALUES (gen_random_uuid(), ${name}, ${ownerId}, ${color}, ${visibility}::"WorkspaceVisibility", now(), now(), false)
  83:           RETURNING *
  84:         `;
