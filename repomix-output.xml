 62: const normalizeStringList = (
 63:   value: unknown,
 64:   maxItems = 8
 65: ): string[] | undefined => {
 66:   if (Array.isArray(value)) {
 67:     const normalized = value
 68:       .map((entry) => entry?.toString().trim())
 69:       .filter((entry): entry is string => Boolean(entry));
 70:     return normalized.length ? normalized.slice(0, maxItems) : undefined;
 71:   }
 72:   if (typeof value === "string") {
 73:     const split = value
 74:       .split(/\n|\.|;|\r|,/)
 75:       .map((entry) => entry.trim())
 76:       .filter((entry) => entry.length > 0 && entry.length <= 240);
 77:     return split.length ? split.slice(0, maxItems) : undefined;
 78:   }
 79:   return undefined;
