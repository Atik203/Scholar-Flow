147:     }
148:     return 'U';
149:   };
150:   const getEntityIcon = (entity: string) => {
151:     const Icon = entityIcons[entity as keyof typeof entityIcons] || Activity;
152:     return <Icon className="h-4 w-4" />;
153:   };
154:   const getSeverityIcon = (severity: string) => {
