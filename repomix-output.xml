const getReasonIcon = (reason: RecommendedPaper["reasonIcon"]) => {
  const icons = {
    similar: {
      icon: FileText,
      color: "text-blue-500",
      bg: "bg-blue-100 dark:bg-blue-900/30",
    },
    trending: {
      icon: TrendingUp,
      color: "text-orange-500",
      bg: "bg-orange-100 dark:bg-orange-900/30",
    },
    author: {
      icon: Users,
      color: "text-green-500",
