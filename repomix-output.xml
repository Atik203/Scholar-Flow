209: export function PapersList({ searchTerm = "", workspaceId }: PapersListProps) {
210:   const limit = 10;
211:   // Get papers (workspace-scoped if workspaceId provided)
212:   const {
213:     data: papersData,
214:     isLoading,
215:     isError,
216:     error,
217:     refetch,
218:   } = useListPapersQuery({
219:     limit,
220:     workspaceId,
221:   });
222:   const [deletePaper, { isLoading: isDeleting }] = useDeletePaperMutation();
223:   const [processPDF, { isLoading: isProcessing }] = useProcessPDFMutation();
224:   const [previewPaperId, setPreviewPaperId] = useState<string | null>(null);
225:   const { data: previewUrlData, isFetching: previewLoading } =
226:     useGetPaperFileUrlQuery(previewPaperId || "", { skip: !previewPaperId });
227:   // Filter papers based on search term - memoized to prevent recalculation on every render
228:   const filteredPapers: Paper[] = useMemo(() => {
229:     if (!papersData?.items || !searchTerm.trim()) {
230:       return papersData?.items || [];
231:     }
232:     const searchTermLower = searchTerm.toLowerCase();
233:     return papersData.items.filter(
234:       (paper) =>
235:         paper.title.toLowerCase().includes(searchTermLower) ||
236:         paper.abstract?.toLowerCase().includes(searchTermLower) ||
237:         paper.metadata?.authors?.some((author) =>
238:           author.toLowerCase().includes(searchTermLower)
239:         )
240:     );
241:   }, [papersData?.items, searchTerm]);
242:   // Memoized handlers to prevent recreation on every render
243:   const handleDeletePaper = useCallback(
244:     async (paperId: string, paperTitle: string) => {
245:       try {
246:         await deletePaper(paperId).unwrap();
247:         showSuccessToast(`Paper "${paperTitle}" deleted successfully`);
248:       } catch (error) {
249:         showErrorToast("Failed to delete paper");
250:         console.error("Delete error:", error);
251:       }
252:     },
253:     [deletePaper]
254:   );
255:   const handleProcessPDF = useCallback(
256:     async (paperId: string, paperTitle: string) => {
257:       try {
258:         await processPDF(paperId).unwrap();
259:         showSuccessToast(`PDF processing started for "${paperTitle}"`);
260:       } catch (error) {
261:         showErrorToast("Failed to start PDF processing");
262:         console.error("Processing error:", error);
263:       }
264:     },
265:     [processPDF]
266:   );
267:   const getProcessingStatusBadge = useCallback((status: string) => {
268:     const statusMap = {
269:       UPLOADED: { variant: "secondary" as const, label: "Uploaded" },
270:       PROCESSING: { variant: "default" as const, label: "Processing" },
271:       PROCESSED: { variant: "outline" as const, label: "Processed" },
272:       FAILED: { variant: "destructive" as const, label: "Failed" },
273:     };
274:     return statusMap[status as keyof typeof statusMap] || statusMap.UPLOADED;
275:   }, []);
276:   const formatDate = useCallback((dateString: string) => {
277:     return new Date(dateString).toLocaleDateString("en-US", {
278:       year: "numeric",
279:       month: "short",
280:       day: "numeric",
281:     });
282:   }, []);
283:   const formatFileSize = useCallback((bytes?: number) => {
284:     if (!bytes) return "N/A";
285:     const mb = bytes / (1024 * 1024);
286:     return mb < 1 ? `${(bytes / 1024).toFixed(1)} KB` : `${mb.toFixed(1)} MB`;
287:   }, []);
288:   if (isLoading) {
289:     return (
290:       <Card>
291:         <CardHeader>
292:           <CardTitle>Papers</CardTitle>
293:           <CardDescription>Loading your research papers...</CardDescription>
294:         </CardHeader>
295:         <CardContent>
296:           <div className="space-y-3">
297:             {[...Array(5)].map((_, i) => (
298:               <div key={i} className="flex items-center space-x-4">
299:                 <Skeleton className="h-12 w-12 rounded-lg" />
300:                 <div className="space-y-2 flex-1">
301:                   <Skeleton className="h-4 w-[200px]" />
302:                   <Skeleton className="h-4 w-[150px]" />
303:                 </div>
304:                 <div className="flex space-x-2">
305:                   <Skeleton className="h-9 w-16" />
306:                   <Skeleton className="h-9 w-16" />
307:                 </div>
308:               </div>
309:             ))}
310:           </div>
311:         </CardContent>
312:       </Card>
313:     );
314:   }
315:   if (isError) {
316:     return (
317:       <Card>
318:         <CardHeader>
319:           <CardTitle>Papers</CardTitle>
320:           <CardDescription>Failed to load papers</CardDescription>
321:         </CardHeader>
322:         <CardContent>
323:           <div className="flex flex-col items-center justify-center py-8 text-center">
324:             <FileText className="h-12 w-12 text-muted-foreground mb-4" />
325:             <p className="text-sm text-muted-foreground mb-4">
326:               Unable to load papers. Please try again.
327:             </p>
328:             <Button onClick={() => refetch()}>Retry</Button>
329:           </div>
330:         </CardContent>
331:       </Card>
332:     );
333:   }
334:   const papers = filteredPapers;
335:   if (papers.length === 0) {
336:     const isSearching = searchTerm.trim().length > 0;
337:     const hasWorkspace = workspaceId && workspaceId.trim().length > 0;
338:     return (
339:       <Card>
340:         <CardHeader>
341:           <CardTitle>Papers</CardTitle>
342:           <CardDescription>
343:             {isSearching
344:               ? "No papers match your search criteria"
345:               : hasWorkspace
346:                 ? "No papers found in this workspace"
347:                 : "Select a workspace to view papers"}
348:           </CardDescription>
349:         </CardHeader>
350:         <CardContent>
351:           <div className="flex flex-col items-center justify-center py-8 text-center">
352:             <FileText className="h-12 w-12 text-muted-foreground mb-4" />
353:             <p className="text-sm text-muted-foreground mb-4">
354:               {isSearching
355:                 ? "Try adjusting your search terms or filters."
356:                 : hasWorkspace
357:                   ? "Upload your first paper to get started with ScholarFlow."
358:                   : "Choose a workspace from the dropdown above to see papers."}
359:             </p>
360:             {hasWorkspace && !isSearching && (
361:               <Button asChild>
362:                 <Link
363:                   href={`/dashboard/papers/upload${workspaceId ? `?workspaceId=${workspaceId}` : ""}`}
364:                 >
365:                   Upload Paper
366:                 </Link>
367:               </Button>
368:             )}
369:           </div>
370:         </CardContent>
371:       </Card>
372:     );
373:   }
374:   return (
375:     <Card>
376:       <CardHeader>
377:         <CardTitle>Your Papers</CardTitle>
378:         <CardDescription>
379:           {searchTerm.trim()
380:             ? `${papers.length} paper${papers.length !== 1 ? "s" : ""} found matching "${searchTerm}"`
381:             : `${papers.length} paper${papers.length !== 1 ? "s" : ""} found`}
382:         </CardDescription>
383:       </CardHeader>
384:       <CardContent>
385:         <Table>
386:           <TableHeader>
387:             <TableRow>
388:               <TableHead>Title</TableHead>
389:               <TableHead>Status</TableHead>
390:               <TableHead>File Info</TableHead>
391:               <TableHead>Created</TableHead>
392:               <TableHead className="text-right">Actions</TableHead>
393:             </TableRow>
394:           </TableHeader>
395:           <TableBody>
396:             {papers.map((paper) => (
397:               <PaperRow
398:                 key={paper.id}
399:                 paper={paper}
400:                 isDeleting={isDeleting}
401:                 isProcessing={isProcessing}
402:                 previewPaperId={previewPaperId}
403:                 previewLoading={previewLoading}
404:                 previewUrlData={previewUrlData}
405:                 onDelete={handleDeletePaper}
406:                 onProcess={handleProcessPDF}
407:                 onPreviewChange={setPreviewPaperId}
408:                 formatDate={formatDate}
409:                 formatFileSize={formatFileSize}
410:                 getProcessingStatusBadge={getProcessingStatusBadge}
411:               />
412:             ))}
413:           </TableBody>
414:         </Table>
415:       </CardContent>
416:     </Card>
417:   );
418: }
