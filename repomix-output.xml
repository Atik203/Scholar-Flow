130:   async uploadFile(
131:     buffer: Buffer,
132:     originalName: string,
133:     contentType: string
134:   ): Promise<{ url: string; filename: string; key: string }> {
135:     const uploadStart = Date.now();
136:     const timestamp = Date.now();
137:     const fileExtension = originalName.split(".").pop();
138:     const filename = `editor-images/${timestamp}-${Math.random().toString(36).substring(2)}.${fileExtension}`;
139:     console.log(
140:       `[StorageService] Uploading image: ${filename}, size: ${buffer.length} bytes, type: ${contentType}`
141:     );
142:     try {
143:       const putObjectInput: PutObjectCommandInput = {
144:         Bucket: this.bucket,
145:         Key: filename,
146:         Body: buffer,
147:         ContentType: contentType,
148:       };
149:       const command = new PutObjectCommand(putObjectInput);
150:       await this.s3.send(command);
151:       const uploadTime = Date.now() - uploadStart;
152:       console.log(`[StorageService] S3 putObject completed in ${uploadTime}ms`);
153:       const presignedStart = Date.now();
154:       const url = await this.getSignedUrl(filename, 604800);
155:       const presignedTime = Date.now() - presignedStart;
156:       const totalTime = Date.now() - uploadStart;
157:       console.log(
158:         `[StorageService] Presigned URL generated in ${presignedTime}ms with 7-day expiry`
159:       );
160:       console.log(`[StorageService] Image upload completed in ${totalTime}ms`);
161:       return {
162:         url: url,
163:         filename: originalName,
164:         key: filename,
165:       };
166:     } catch (error) {
167:       const uploadTime = Date.now() - uploadStart;
168:       console.error(
169:         `[StorageService] Image upload failed after ${uploadTime}ms:`,
170:         error
171:       );
172:       throw error;
173:     }
174:   }
175: }
