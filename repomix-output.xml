255: @layer base {
256:   * {
257:     @apply border-border outline-ring/50 min-w-0;
258:   }
259:   body {
260:     @apply bg-background text-foreground min-h-[100dvh];
261:   }
262:   html {
263:     text-rendering: optimizelegibility;
264:   }
265:   input::placeholder,
266:   textarea::placeholder {
267:     @apply text-muted-foreground;
268:   }
269:   button:not(:disabled),
270:   [role="button"]:not(:disabled) {
271:     @apply cursor-pointer;
272:   }
273: }
274: @layer components {
275:   .btn-hover-glow {
276:     @apply transition-all duration-300 hover:scale-[1.02] active:scale-[0.98];
277:   }
278:   .dark .btn-hover-glow:hover {
279:     @apply shadow-2xl;
280:   }
281:   .dark button:focus-visible,
282:   .dark [role="button"]:focus-visible {
283:     @apply ring-2 ring-primary/60 ring-offset-2 ring-offset-background;
284:   }
285:   .btn-shine::before {
286:     content: "";
287:     position: absolute;
288:     top: 0;
289:     left: -100%;
290:     width: 100%;
291:     height: 100%;
292:     background: linear-gradient(
293:       90deg,
294:       transparent,
295:       rgba(255, 255, 255, 0.2),
296:       transparent
297:     );
298:     transition: left 0.5s;
299:   }
300:   .btn-shine:hover::before {
301:     left: 100%;
302:   }
303:   /* Enhanced dark mode shadows */
304:   .dark .shadow-primary-glow {
305:     box-shadow:
306:       0 0 20px rgba(136, 58, 234, 0.3),
307:       0 0 40px rgba(136, 58, 234, 0.1);
308:   }
309:   .dark .shadow-chart-glow {
310:     box-shadow:
311:       0 0 20px rgba(255, 107, 107, 0.3),
312:       0 0 40px rgba(255, 107, 107, 0.1);
313:   }
314:   /* Button border glow effects */
315:   .btn-border-glow {
316:     @apply relative;
317:   }
318:   .btn-border-glow::after {
319:     content: "";
320:     position: absolute;
321:     inset: -2px;
322:     background: linear-gradient(
323:       45deg,
324:       var(--primary),
325:       var(--chart-1),
326:       var(--primary)
327:     );
328:     border-radius: inherit;
329:     z-index: -1;
330:     opacity: 0;
331:     transition: opacity 0.3s ease;
332:   }
333:   .btn-border-glow:hover::after {
334:     opacity: 1;
335:   }
336:   /* Dark mode specific button enhancements */
337:   .dark .btn-hover-glow:hover {
338:     @apply shadow-2xl;
339:   }
340:   /* Enhanced dark mode button shadows */
341:   .dark button[variant="gradient"]:hover {
342:     box-shadow:
343:       0 0 25px rgba(136, 58, 234, 0.4),
344:       0 0 50px rgba(136, 58, 234, 0.2),
345:       0 0 75px rgba(136, 58, 234, 0.1);
346:   }
347:   .dark button[variant="outline"]:hover {
348:     box-shadow:
349:       0 0 20px rgba(255, 255, 255, 0.1),
350:       0 0 40px rgba(255, 255, 255, 0.05);
351:   }
352:   .dark .btn-pulse {
353:     animation: pulse-glow 2s infinite;
354:   }
355:   @keyframes pulse-glow {
356:     0%,
357:     100% {
358:       box-shadow: 0 0 20px rgba(136, 58, 234, 0.3);
359:     }
360:     50% {
361:       box-shadow: 0 0 30px rgba(136, 58, 234, 0.6);
362:     }
363:   }
364:   .dark button:active {
365:     @apply scale-95;
366:   }
367:   .btn-inner-glow {
368:     @apply relative overflow-hidden;
369:   }
370:   .btn-inner-glow::before {
371:     content: "";
372:     position: absolute;
373:     inset: 0;
374:     background: radial-gradient(
375:       circle at center,
376:       rgba(255, 255, 255, 0.1) 0%,
377:       transparent 70%
378:     );
379:     opacity: 0;
380:     transition: opacity 0.3s ease;
381:   }
382:   .btn-inner-glow:hover::before {
383:     opacity: 1;
384:   }
