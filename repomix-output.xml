148:     return (
149:       <div className="flex items-center justify-center min-h-[400px]">
150:         <div className="h-8 w-8 border-4 border-muted-foreground/30 border-t-primary rounded-full animate-spin" />
151:       </div>
152:     );
153:   }
154:   if (!isProOrAbove) {
