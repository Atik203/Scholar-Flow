278:       VALUES (gen_random_uuid(), ${id}, ${targetUserId}, ${payload.role || "EDITOR"}, now(), now(), now(), false)
279:       ON CONFLICT ("workspaceId", "userId") DO UPDATE SET role = EXCLUDED.role, "isDeleted" = false, "updatedAt" = now()
280:     `;
281:     await prisma.$executeRaw`
282:       INSERT INTO "ActivityLog" (id, "userId", "workspaceId", entity, "entityId", action, details, "createdAt", "updatedAt", "isDeleted")
283:       VALUES (gen_random_uuid(), ${requestorId}, ${id}, 'WorkspaceMember', ${id}, 'ADD_MEMBER', '{}'::jsonb, now(), now(), false)
