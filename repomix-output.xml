  1: "use client";
  2: import {
  3:   showErrorToast,
  4:   showSuccessToast,
  5: } from "@/components/providers/ToastProvider";
  6: import { Badge } from "@/components/ui/badge";
  7: import { Button } from "@/components/ui/button";
  8: import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
  9: import {
 10:   DropdownMenu,
 11:   DropdownMenuContent,
 12:   DropdownMenuItem,
 13:   DropdownMenuSeparator,
 14:   DropdownMenuTrigger,
 15: } from "@/components/ui/dropdown-menu";
 16: import { Input } from "@/components/ui/input";
 17: import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs";
 18: import {
 19:   useDeletePaperMutation,
 20:   useListEditorPapersQuery,
 21: } from "@/redux/api/paperApi";
 22: import { useAuth } from "@/redux/auth/useAuth";
 23: import { formatDistanceToNow } from "date-fns";
 24: import {
 25:   Clock,
 26:   Edit,
 27:   Eye,
 28:   FileText,
 29:   MoreVertical,
 30:   Search,
 31:   Share,
 32:   Trash2,
 33: } from "lucide-react";
 34: import { useEffect, useState } from "react";
 35: interface PapersListProps {
 36:   onPaperSelect: (paperId: string) => void;
 37: }
 38: export function PapersList({ onPaperSelect }: PapersListProps) {
 39:   const { session, status } = useAuth();
 40:   const [searchQuery, setSearchQuery] = useState("");
 41:   const [activeFilter, setActiveFilter] = useState<
 42:     "all" | "drafts" | "published"
 43:   >("all");
 44:   const getFilterParams = () => {
 45:     const params: { workspaceId?: string; isDraft?: boolean } = {};
 46:     if (activeFilter === "drafts") {
 47:       params.isDraft = true;
 48:     } else if (activeFilter === "published") {
 49:       params.isDraft = false;
 50:     }
 51:     return params;
 52:   };
 53:   const {
 54:     data: papersResponse,
 55:     isLoading,
 56:     error,
 57:     refetch,
 58:   } = useListEditorPapersQuery(getFilterParams(), {
 59:     skip: status === "loading" || !session,
 60:   });
 61:   const [deletePaper] = useDeletePaperMutation();
 62:   const papers = papersResponse?.data || [];
 63:   useEffect(() => {
 64:     if (session && refetch) {
 65:       refetch();
 66:     }
 67:   }, [activeFilter, session, refetch]);
 68:   const handleDelete = async (paperId: string) => {
 69:     if (!confirm("Are you sure you want to delete this paper?")) return;
 70:     try {
 71:       await deletePaper(paperId).unwrap();
 72:       showSuccessToast("Paper deleted successfully");
 73:       refetch();
 74:     } catch (error: any) {
 75:       console.error("Error deleting paper:", error);
 76:       showErrorToast(
 77:         "Failed to delete paper",
 78:         error?.data?.message || "Please try again later."
 79:       );
 80:     }
 81:   };
 82:   const filteredPapers = papers.filter((paper) => {
 83:     const matchesSearch = paper.title
 84:       .toLowerCase()
 85:       .includes(searchQuery.toLowerCase());
 86:     const matchesFilter =
 87:       activeFilter === "all" ||
 88:       (activeFilter === "drafts" && paper.isDraft) ||
 89:       (activeFilter === "published" && paper.isPublished);
 90:     return matchesSearch && matchesFilter;
 91:   });
 92:   if (status === "loading" || isLoading) {
 93:     return (
 94:       <div className="flex items-center justify-center py-8">
 95:         <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
 96:       </div>
 97:     );
 98:   }
 99:   if (!session) {
100:     return (
101:       <div className="flex items-center justify-center py-8">
102:         <p className="text-muted-foreground">
103:           Please sign in to view your papers.
104:         </p>
105:       </div>
106:     );
107:   }
108:   return (
109:     <div className="space-y-6">
110:       {}
111:       <div className="flex flex-col sm:flex-row gap-4">
112:         <div className="relative flex-1">
113:           <Search className="absolute left-3 top-3 h-4 w-4 text-muted-foreground" />
114:           <Input
115:             placeholder="Search papers..."
116:             value={searchQuery}
117:             onChange={(e) => setSearchQuery(e.target.value)}
118:             className="pl-9"
119:           />
120:         </div>
121:         <Tabs
122:           value={activeFilter}
123:           onValueChange={(value) => setActiveFilter(value as any)}
124:         >
125:           <TabsList>
126:             <TabsTrigger value="all">All</TabsTrigger>
127:             <TabsTrigger value="drafts">Drafts</TabsTrigger>
128:             <TabsTrigger value="published">Published</TabsTrigger>
129:           </TabsList>
130:         </Tabs>
131:       </div>
132:       {}
133:       {filteredPapers.length === 0 ? (
134:         <Card>
135:           <CardContent className="flex flex-col items-center justify-center py-12">
136:             <FileText className="h-12 w-12 text-muted-foreground mb-4" />
137:             <h3 className="text-lg font-semibold mb-2">No papers found</h3>
138:             <p className="text-muted-foreground text-center mb-4">
139:               {searchQuery
140:                 ? "No papers match your search criteria."
141:                 : "You haven't created any papers yet. Start by creating your first paper!"}
142:             </p>
143:           </CardContent>
144:         </Card>
145:       ) : (
146:         <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
147:           {filteredPapers.map((paper) => (
148:             <Card
149:               key={paper.id}
150:               className="hover:shadow-md transition-shadow cursor-pointer"
151:             >
152:               <CardHeader className="pb-3">
153:                 <div className="flex items-start justify-between">
154:                   <div className="flex-1 min-w-0">
155:                     <CardTitle
156:                       className="text-base line-clamp-2 hover:text-primary"
157:                       onClick={() => onPaperSelect(paper.id)}
158:                     >
159:                       {paper.title || "Untitled Paper"}
160:                     </CardTitle>
161:                     <div className="flex items-center gap-2 mt-2">
162:                       <Badge
163:                         variant={paper.isDraft ? "secondary" : "default"}
164:                         className="text-xs"
165:                       >
166:                         {paper.isDraft ? "Draft" : "Published"}
167:                       </Badge>
168:                       <div className="flex items-center gap-1 text-xs text-muted-foreground">
169:                         <Clock className="h-3 w-3" />
170:                         {formatDistanceToNow(new Date(paper.updatedAt), {
171:                           addSuffix: true,
172:                         })}
173:                       </div>
174:                     </div>
175:                   </div>
176:                   <DropdownMenu>
177:                     <DropdownMenuTrigger asChild>
178:                       <Button variant="ghost" size="sm" className="h-8 w-8 p-0">
179:                         <MoreVertical className="h-4 w-4" />
180:                       </Button>
181:                     </DropdownMenuTrigger>
182:                     <DropdownMenuContent align="end">
183:                       <DropdownMenuItem onClick={() => onPaperSelect(paper.id)}>
184:                         <Edit className="h-4 w-4 mr-2" />
185:                         Edit
186:                       </DropdownMenuItem>
187:                       <DropdownMenuItem>
188:                         <Eye className="h-4 w-4 mr-2" />
189:                         Preview
190:                       </DropdownMenuItem>
191:                       <DropdownMenuItem>
192:                         <Share className="h-4 w-4 mr-2" />
193:                         Share
194:                       </DropdownMenuItem>
195:                       <DropdownMenuSeparator />
196:                       <DropdownMenuItem
197:                         className="text-red-600"
198:                         onClick={() => handleDelete(paper.id)}
199:                       >
200:                         <Trash2 className="h-4 w-4 mr-2" />
201:                         Delete
202:                       </DropdownMenuItem>
203:                     </DropdownMenuContent>
204:                   </DropdownMenu>
205:                 </div>
206:               </CardHeader>
207:               <CardContent className="pt-0">
208:                 <div className="flex items-center justify-between mt-4 text-xs text-muted-foreground">
209:                   <span>
210:                     Created{" "}
211:                     {formatDistanceToNow(new Date(paper.createdAt), {
212:                       addSuffix: true,
213:                     })}
214:                   </span>
215:                   <Button
216:                     variant="ghost"
217:                     size="sm"
218:                     className="h-6 px-2"
219:                     onClick={() => onPaperSelect(paper.id)}
220:                   >
221:                     Open →
222:                   </Button>
223:                 </div>
224:               </CardContent>
225:             </Card>
226:           ))}
227:         </div>
228:       )}
229:     </div>
230:   );
231: }
