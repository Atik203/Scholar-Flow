288:                                   }
289:                                 }}
290:                               >
291:                                 <XCircle className="h-3 w-3" />
292:                               </Button>
293:                             )}
294:                             {busy && (
295:                               <RefreshCw className="h-3 w-3 animate-spin text-muted-foreground" />
296:                             )}
297:                           </div>
298:                         </TableCell>
299:                       </TableRow>
300:                     );
301:                   })}
302:                 </TableBody>
303:               </Table>
304:             </div>
305:           )}
306:         </CardContent>
307:       </Card>
308:       {totalPages > 1 && (
