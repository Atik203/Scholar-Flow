 243:         f."originalFilename",
 244:         f."extractedAt"
 245:       FROM inserted_paper p
 246:       LEFT JOIN inserted_file f ON f."paperId" = p.id
 247:     `;
 248:       const createdRow = createdRows[0];
 249:       if (!createdRow) {
 250:         throw new Error("Failed to create paper record");
 251:       }
 252:       const created = {
 253:         id: createdRow.id,
 254:         workspaceId: createdRow.workspaceId,
 255:         uploaderId: createdRow.uploaderId,
 256:         title: createdRow.title,
