  4: import { Badge } from "../ui/badge";
  5: import { Button } from "../ui/button";
  6: import { Input } from "../ui/input";
  7: export interface CommandItem {
  8:   id: string;
  9:   title: string;
 10:   description?: string;
 11:   keywords?: string[];
 12:   icon?: React.ComponentType<{ className?: string }>;
