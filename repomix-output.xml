<file path="apps/frontend/src/components/discussions/CreateDiscussionDialog.tsx">
  1: "use client";
  2: import { useState } from "react";
  3: import { Button } from "@/components/ui/button";
  4: import {
  5:   Dialog,
  6:   DialogContent,
  7:   DialogDescription,
  8:   DialogHeader,
  9:   DialogTitle,
 10:   DialogTrigger,
 11: } from "@/components/ui/dialog";
 12: import {
 13:   Form,
 14:   FormControl,
 15:   FormField,
 16:   FormItem,
 17:   FormLabel,
 18:   FormMessage,
 19: } from "@/components/ui/form";
 20: import { Input } from "@/components/ui/input";
 21: import { Textarea } from "@/components/ui/textarea";
 22: import { Badge } from "@/components/ui/badge";
 23: import { showErrorToast, showSuccessToast } from "@/components/providers/ToastProvider";
 24: import { MessageSquare, Plus, Pin, CheckCircle, XCircle } from "lucide-react";
 25: import { useForm } from "react-hook-form";
 26: import { zodResolver } from "@hookform/resolvers/zod";
 27: import { z } from "zod";
 28: const discussionFormSchema = z.object({
 29:   title: z.string().min(1, "Title is required").max(200, "Title too long"),
 30:   content: z.string().min(1, "Content is required").max(5000, "Content too long"),
 31:   tags: z.string().optional(),
 32: });
 33: type DiscussionFormData = z.infer<typeof discussionFormSchema>;
 34: interface CreateDiscussionDialogProps {
 35:   paperId?: string;
 36:   collectionId?: string;
 37:   workspaceId?: string;
 38:   paperTitle?: string;
 39:   collectionName?: string;
 40:   workspaceName?: string;
 41:   trigger?: React.ReactNode;
 42:   onDiscussionCreated?: () => void;
 43: }
 44: export function CreateDiscussionDialog({
 45:   paperId,
 46:   collectionId,
 47:   workspaceId,
 48:   paperTitle,
 49:   collectionName,
 50:   workspaceName,
 51:   trigger,
 52:   onDiscussionCreated
 53: }: CreateDiscussionDialogProps) {
 54:   const [isOpen, setIsOpen] = useState(false);
 55:   const [isCreating, setIsCreating] = useState(false);
 56:   const form = useForm<DiscussionFormData>({
 57:     resolver: zodResolver(discussionFormSchema),
 58:     defaultValues: {
 59:       title: "",
 60:       content: "",
 61:       tags: "",
 62:     },
 63:   });
 64:   const getContextInfo = () => {
 65:     if (paperId) return { type: "Paper", name: paperTitle || "Unknown Paper" };
 66:     if (collectionId) return { type: "Collection", name: collectionName || "Unknown Collection" };
 67:     if (workspaceId) return { type: "Workspace", name: workspaceName || "Unknown Workspace" };
 68:     return { type: "General", name: "Discussion" };
 69:   };
 70:   const handleCreateDiscussion = async (data: DiscussionFormData) => {
 71:     setIsCreating(true);
 72:     try {
 73:       const tags = data.tags ? data.tags.split(',').map(tag => tag.trim()).filter(tag => tag) : [];
 74:       const response = await fetch('/api/discussions', {
 75:         method: 'POST',
 76:         headers: {
 77:           'Content-Type': 'application/json',
 78:         },
 79:         body: JSON.stringify({
 80:           ...data,
 81:           tags,
 82:           ...(paperId && { paperId }),
 83:           ...(collectionId && { collectionId }),
 84:           ...(workspaceId && { workspaceId }),
 85:         }),
 86:       });
 87:       if (!response.ok) {
 88:         throw new Error('Failed to create discussion');
 89:       }
 90:       const result = await response.json();
 91:       showSuccessToast('Discussion created successfully');
 92:       setIsOpen(false);
 93:       form.reset();
 94:       onDiscussionCreated?.();
 95:     } catch (error) {
 96:       console.error('Create discussion error:', error);
 97:       showErrorToast('Failed to create discussion. Please try again.');
 98:     } finally {
 99:       setIsCreating(false);
100:     }
101:   };
102:   const contextInfo = getContextInfo();
103:   return (
104:     <Dialog open={isOpen} onOpenChange={setIsOpen}>
105:       <DialogTrigger asChild>
106:         {trigger || (
107:           <Button variant="outline" size="sm">
108:             <MessageSquare className="h-4 w-4 mr-2" />
109:             Start Discussion
110:           </Button>
111:         )}
112:       </DialogTrigger>
113:       <DialogContent className="max-w-2xl">
114:         <DialogHeader>
115:           <DialogTitle className="flex items-center gap-2">
116:             <MessageSquare className="h-5 w-5" />
117:             Create Discussion
118:           </DialogTitle>
119:           <DialogDescription>
120:             Start a new discussion for {contextInfo.type}: {contextInfo.name}
121:           </DialogDescription>
122:         </DialogHeader>
123:         <Form {...form}>
124:           <form onSubmit={form.handleSubmit(handleCreateDiscussion)} className="space-y-4">
125:             <FormField
126:               control={form.control}
127:               name="title"
128:               render={({ field }: { field: any }) => (
129:                 <FormItem>
130:                   <FormLabel>Discussion Title</FormLabel>
131:                   <FormControl>
132:                     <Input
133:                       placeholder="Enter a descriptive title for your discussion"
134:                       {...field}
135:                     />
136:                   </FormControl>
137:                   <FormMessage />
138:                 </FormItem>
139:               )}
140:             />
141:             <FormField
142:               control={form.control}
143:               name="content"
144:               render={({ field }: { field: any }) => (
145:                 <FormItem>
146:                   <FormLabel>Discussion Content</FormLabel>
147:                   <FormControl>
148:                     <Textarea
149:                       placeholder="Share your thoughts, questions, or insights..."
150:                       className="min-h-[150px]"
151:                       {...field}
152:                     />
153:                   </FormControl>
154:                   <FormMessage />
155:                 </FormItem>
156:               )}
157:             />
158:             <FormField
159:               control={form.control}
160:               name="tags"
161:               render={({ field }: { field: any }) => (
162:                 <FormItem>
163:                   <FormLabel>Tags (optional)</FormLabel>
164:                   <FormControl>
165:                     <Input
166:                       placeholder="Enter tags separated by commas (e.g., methodology, results, question)"
167:                       {...field}
168:                     />
169:                   </FormControl>
170:                   <FormMessage />
171:                 </FormItem>
172:               )}
173:             />
174:             <div className="flex justify-end gap-2">
175:               <Button
176:                 type="button"
177:                 variant="outline"
178:                 onClick={() => setIsOpen(false)}
179:               >
180:                 Cancel
181:               </Button>
182:               <Button type="submit" disabled={isCreating}>
183:                 {isCreating ? (
184:                   <>
185:                     <div className="h-4 w-4 mr-2 animate-spin rounded-full border-2 border-current border-t-transparent" />
186:                     Creating...
187:                   </>
188:                 ) : (
189:                   <>
190:                     <Plus className="h-4 w-4 mr-2" />
191:                     Create Discussion
192:                   </>
193:                 )}
194:               </Button>
195:             </div>
196:           </form>
197:         </Form>
198:       </DialogContent>
199:     </Dialog>
200:   );
201: }
