169:     setIsSettingsOpen(false);
170:   };
171:   useEffect(() => {
172:     if (!aiEnabled || hasAttemptedInitialLoad) {
173:       return;
174:     }
175:     setHasAttemptedInitialLoad(true);
176:     runSummary(DEFAULT_OPTIONS);
177:   }, [aiEnabled]);
178:   if (!aiEnabled) {
179:     return (
180:       <Card className="border-dashed">
181:         <CardHeader>
182:           <CardTitle className="flex items-center gap-2 text-base">
