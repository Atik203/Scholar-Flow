 41:       error: uploadErrorData,
 42:       reset: resetUpload,
 43:     },
 44:   ] = useUploadPaperMutation();
 45:   const {
 46:     errorMessage: uploadErrorMessage,
 47:     retry: retryUpload,
 48:     isRetryable: canRetryUpload,
 49:   } = useMutationErrorHandler(
 50:     {
 51:       error: uploadErrorData,
 52:       isLoading: uploadLoading,
 53:       isError: uploadError,
 54:       reset: resetUpload,
