13: export function withAuthProtection<P extends object>(
14:   Component: ComponentType<P>,
15:   options?: {
16:     redirectTo?: string;
17:     loadingComponent?: ComponentType;
18:   }
19: ) {
20:   const {
21:     redirectTo = "/login",
22:     loadingComponent: LoadingComponent = AuthLoadingComponent,
23:   } = options || {};
24:   return function AuthProtectedComponent(props: P) {
25:     const { isLoading } = useProtectedRoute(redirectTo);
26:     if (isLoading) {
27:       return <LoadingComponent />;
28:     }
29:     return <Component {...props} />;
30:   };
31: }
32: export function withAuthRedirection<P extends object>(
33:   Component: ComponentType<P>,
34:   options?: {
35:     redirectTo?: string;
36:     loadingComponent?: ComponentType;
37:   }
38: ) {
39:   const {
40:     redirectTo = "/dashboard",
41:     loadingComponent: LoadingComponent = AuthLoadingComponent,
42:   } = options || {};
43:   return function AuthRedirectedComponent(props: P) {
44:     const { isLoading } = useAuthRoute(redirectTo);
45:     if (isLoading) {
46:       return <LoadingComponent />;
47:     }
48:     return <Component {...props} />;
