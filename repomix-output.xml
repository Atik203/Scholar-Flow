1295: // Editor-specific paper service functions
1296: export const editorPaperService = {
1297:   // Create a new editor-based paper (draft by default)
1298:   async createEditorPaper(input: CreateEditorPaperInput, uploaderId: string) {
1299:     const sanitizedContent = input.content
1300:       ? sanitizeHtml(input.content, sanitizeOptions)
1301:       : "";
1302:     // Workspace gate: only the owner or an active member may plant papers
1303:     // in a workspace. Without this, any authenticated user could inject
1304:     // papers into arbitrary workspaces (workspace-IDOR).
1305:     if (input.workspaceId) {
1306:       const allowed = await prisma.$queryRaw<Array<{ allowed: boolean }>>`
1307:         SELECT EXISTS (
1308:           SELECT 1 FROM "Workspace" w
1309:           WHERE w.id = ${input.workspaceId}
1310:             AND w."isDeleted" = false
1311:             AND (
1312:               w."ownerId" = ${uploaderId}
1313:               OR EXISTS (
1314:                 SELECT 1 FROM "WorkspaceMember" wm
1315:                 WHERE wm."workspaceId" = w.id
1316:                   AND wm."userId" = ${uploaderId}
1317:                   AND wm."isDeleted" = false
1318:               )
1319:             )
1320:         ) AS "allowed"
1321:       `;
1322:       if (!allowed[0]?.allowed) {
1323:         throw new ApiError(
1324:           403,
1325:           "You are not a member of this workspace or the workspace does not exist"
1326:         );
1327:       }
1328:     }
1329:     // Create metadata with authors
1330:     const metadata = {
1331:       source: "editor",
1332:       createdInEditor: true,
1333:       authors: input.authors || [],
1334:     };
1335:     const result = await prisma.$queryRaw<
1336:       {
1337:         id: string;
1338:         title: string;
1339:         isDraft: boolean;
1340:         isPublished: boolean;
1341:         createdAt: Date;
1342:       }[]
1343:     >`
1344:       INSERT INTO "Paper" (
1345:         id, "workspaceId", "uploaderId", title, "contentHtml",
1346:         source, "isDraft", "isPublished", "processingStatus",
1347:         metadata, "createdAt", "updatedAt", "isDeleted"
1348:       ) VALUES (
1349:         gen_random_uuid(), ${input.workspaceId}, ${uploaderId},
1350:         ${input.title}, ${sanitizedContent}, 'editor',
1351:         ${input.isDraft ?? true}, false, 'PROCESSED',
1352:         ${JSON.stringify(metadata)}::jsonb,
1353:         NOW(), NOW(), false
1354:       )
1355:       RETURNING id, title, "isDraft", "isPublished", "createdAt"
1356:     `;
1357:     return result[0]; // Return the first (and only) result
