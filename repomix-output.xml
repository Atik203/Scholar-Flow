@layer base {
  * {
    @apply border-border outline-ring/50 min-w-0;
  }
  body {
    @apply bg-background text-foreground min-h-[100dvh];
  }
  html {
    text-rendering: optimizelegibility;
  }
  input::placeholder,
  textarea::placeholder {
    @apply text-muted-foreground;
  }
  button:not(:disabled),
  [role="button"]:not(:disabled) {
    @apply cursor-pointer;
  }
}

/* Enhanced Button Styles for Dark Mode */
@layer components {
  /* Button hover effects with enhanced shadows */
  .btn-hover-glow {
    @apply transition-all duration-300 hover:scale-[1.02] active:scale-[0.98];
  }

  /* Dark mode button enhancements */
  .dark .btn-hover-glow:hover {
    @apply shadow-2xl;
  }

  /* Enhanced focus states for dark mode */
  .dark button:focus-visible,
  .dark [role="button"]:focus-visible {
    @apply ring-2 ring-primary/60 ring-offset-2 ring-offset-background;
  }

  /* Button shine effect */
  .btn-shine::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    transition: left 0.5s;
  }

  .btn-shine:hover::before {
    left: 100%;
  }

  /* Enhanced dark mode shadows */
  .dark .shadow-primary-glow {
    box-shadow:
      0 0 20px rgba(136, 58, 234, 0.3),
      0 0 40px rgba(136, 58, 234, 0.1);
  }

  .dark .shadow-chart-glow {
    box-shadow:
      0 0 20px rgba(255, 107, 107, 0.3),
      0 0 40px rgba(255, 107, 107, 0.1);
  }

  /* Button border glow effects */
  .btn-border-glow {
    @apply relative;
  }

  .btn-border-glow::after {
    content: "";
    position: absolute;
    inset: -2px;
    background: linear-gradient(
      45deg,
      var(--primary),
      var(--chart-1),
      var(--primary)
    );
    border-radius: inherit;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .btn-border-glow:hover::after {
    opacity: 1;
  }

  /* Dark mode specific button enhancements */
  .dark .btn-hover-glow:hover {
    @apply shadow-2xl;
  }

  /* Enhanced dark mode button shadows */
  .dark button[variant="gradient"]:hover {
    box-shadow:
      0 0 25px rgba(136, 58, 234, 0.4),
      0 0 50px rgba(136, 58, 234, 0.2),
      0 0 75px rgba(136, 58, 234, 0.1);
  }

  .dark button[variant="outline"]:hover {
    box-shadow:
      0 0 20px rgba(255, 255, 255, 0.1),
      0 0 40px rgba(255, 255, 255, 0.05);
  }

  /* Button pulse effect for dark mode */
  .dark .btn-pulse {
    animation: pulse-glow 2s infinite;
  }

  @keyframes pulse-glow {
    0%,
    100% {
      box-shadow: 0 0 20px rgba(136, 58, 234, 0.3);
    }
    50% {
      box-shadow: 0 0 30px rgba(136, 58, 234, 0.6);
    }
  }

  /* Enhanced button states for dark mode */
  .dark button:active {
    @apply scale-95;
  }

  /* Button inner glow effect */
  .btn-inner-glow {
    @apply relative overflow-hidden;
  }

  .btn-inner-glow::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.1) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .btn-inner-glow:hover::before {
    opacity: 1;
  }

  /* Dark mode text color overrides for better visibility */
  .dark button {
    @apply text-white;
  }

  .dark button[variant="outline"] {
    @apply text-white;
  }

  .dark button[variant="ghost"] {
    @apply text-white;
  }

  .dark button[variant="link"] {
    @apply text-white;
  }

  /* Ensure SVG icons are also white in dark mode */
  .dark button svg {
    @apply text-white;
  }

  /* Enhanced button text contrast in dark mode */
  .dark button[variant="gradient"] {
    @apply text-white font-semibold;
  }

  .dark button[variant="default"] {
    @apply text-white font-semibold;
  }

  .dark button[variant="destructive"] {
    @apply text-white font-semibold;
  }
}

@layer utilities {
  .bg-dashed {
    background-image: linear-gradient(
      45deg,
      var(--border) 12.5%,
      transparent 12.5%,
      transparent 50%,
      var(--border) 50%,
      var(--border) 62.5%,
      transparent 62.5%,
      transparent 100%
    );
    background-size: 0.25rem 0.25rem;
  }
}

@keyframes move-x {
  0% {
    transform: translateX(var(--move-x-from));
  }
  100% {
    transform: translateX(var(--move-x-to));
  }
}

h1,
h2,
h3 {
  @apply tracking-tight;
}

/* Fix Fumadocs theme toggle icons */
[data-theme-toggle] svg {
  @apply fill-none;
}

#nd-subnav [data-active="true"] {
  @apply font-medium text-primary;
}

#nd-subnav > div {
  @apply container border-x;
}

#nd-docs-layout {
  @apply container mx-auto p-0 border-x;
}

#nd-tocnav {
  @apply translate-y-px;
}

#nd-sidebar [data-hide-if-empty] {
  @apply hidden;
}

/* Hide unnecessary links on mobile */
#nd-sidebar-mobile a[href="/"],
#nd-sidebar-mobile a[href="/docs"].lg\:hidden {
  @apply hidden;
}

.landing-page #nd-subnav button[data-search] + button {
  @apply hidden;
}

/* Phase 3: Animation Enhancements */

/* Shimmer animation */
@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

/* Hover effects library */
.hover-lift {
  @apply transition-transform duration-300 hover:-translate-y-1;
}

.hover-glow {
  @apply transition-shadow duration-300 hover:shadow-lg hover:shadow-primary/20;
}

.hover-scale {
  @apply transition-transform duration-300 hover:scale-105;
}

/* Enhanced Sidebar Animations */
.sidebar-transition {
  transition: width 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Smooth sidebar content transitions */
[data-sidebar="sidebar"] {
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Ensure proper layout flow for sidebar and content */
.group\/sidebar-wrapper {
  display: flex;
  min-height: 100vh;
  width: 100%;
}

/* Sidebar inset content proper spacing */
[data-sidebar="inset"] {
  flex: 1;
  min-width: 0;
  transition: margin-left 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Improved sidebar trigger hover effect */
[data-sidebar="trigger"] {
  transition: all 200ms ease-in-out;
}

[data-sidebar="trigger"]:hover {
  background-color: hsl(var(--sidebar-accent));
  color: hsl(var(--sidebar-accent-foreground));
}

/* Better sidebar menu item animations */
[data-sidebar="menu-button"] {
  transition: all 200ms ease-in-out;
}

/* Ensure sidebar header is always visible */
[data-sidebar="header"] {
  display: flex !important;
  opacity: 1 !important;
  visibility: visible !important;
}

/* Force sidebar logo and content visibility */
.sidebar-logo {
  display: flex !important;
  align-items: center !important;
  gap: 0.5rem !important;
}

/* Modern scrolling behavior */
html {
  scroll-behavior: smooth;
}

/* Fixed sidebar layout */
.sidebar-fixed {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  overflow-y: auto;
  z-index: 30;
}

/* Main content offset - only for large screens */
@media (min-width: 1024px) {
  .content-offset {
    margin-left: 16rem; /* 64 * 0.25rem = 16rem for w-64 */
  }
}

/* Smooth backdrop blur for headers */
.header-blur {
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

/* Mobile & Tablet navigation improvements */
@media (max-width: 1023px) {
  .mobile-nav-header {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}

/* Custom scrollbar for sidebar */
.sidebar-scroll::-webkit-scrollbar {
  width: 4px;
}

.sidebar-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.sidebar-scroll::-webkit-scrollbar-thumb {
  background: hsl(var(--sidebar-border));
  border-radius: 2px;
}

.sidebar-scroll::-webkit-scrollbar-thumb:hover {
  background: hsl(var(--sidebar-accent));
}

/* Smooth collapsible animations */
[data-state="open"] [data-sidebar="menu-sub"] {
  animation: slide-down 200ms ease-out;
}

[data-state="closed"] [data-sidebar="menu-sub"] {
  animation: slide-up 200ms ease-out;
}

@keyframes slide-down {
  from {
    height: 0;
    opacity: 0;
  }
  to {
    height: var(--radix-collapsible-content-height);
    opacity: 1;
  }
}

@keyframes slide-up {
  from {
    height: var(--radix-collapsible-content-height);
    opacity: 1;
  }
  to {
    height: 0;
    opacity: 0;
  }
}

/* TipTap Image Upload Styles */
.tiptap-image-upload {
  margin: 2rem 0;
}

.tiptap-image-upload input[type="file"] {
  display: none;
}

.tiptap-image-upload-dropzone {
  position: relative;
  width: 3.125rem;
  height: 3.75rem;
  display: inline-flex;
  align-items: flex-start;
  justify-content: center;
  user-select: none;
}

.tiptap-image-upload-icon {
  color: hsl(var(--muted-foreground));
}

.tiptap-image-upload-dropzone-rect-primary {
  fill: hsl(var(--border));
  stroke: hsl(var(--border));
}

.tiptap-image-upload-dropzone-rect-secondary {
  fill: hsl(var(--muted));
}

.tiptap-image-upload-drag-area {
  border: 2px dashed hsl(var(--border));
  border-radius: 0.75rem;
  padding: 2rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
  background: hsl(var(--muted) / 0.5);
}

.tiptap-image-upload-drag-area:hover {
  border-color: hsl(var(--primary));
  background: hsl(var(--muted) / 0.8);
}

.tiptap-image-upload-drag-area.drag-active {
  border-color: hsl(var(--primary));
  background: hsl(var(--primary) / 0.1);
}

.tiptap-image-upload-drag-area.drag-over {
  border-color: hsl(var(--primary));
  background: hsl(var(--primary) / 0.05);
}

.tiptap-image-upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.tiptap-image-upload-text {
  font-weight: 500;
  color: hsl(var(--foreground));
}

.tiptap-image-upload-subtext {
  font-size: 0.875rem;
  color: hsl(var(--muted-foreground));
}

.tiptap-image-upload-preview {
  position: relative;
  border-radius: 0.5rem;
  overflow: hidden;
  border: 1px solid hsl(var(--border));
  background: hsl(var(--card));
  padding: 1rem;
  margin: 0.5rem 0;
}

.tiptap-image-upload-progress {
  width: 100%;
  height: 4px;
  background: hsl(var(--muted));
  border-radius: 2px;
  overflow: hidden;
  margin-bottom: 0.75rem;
}

.tiptap-image-upload-progress::after {
  content: "";
  display: block;
  height: 100%;
  background: hsl(var(--primary));
  border-radius: 2px;
  transition: width 0.3s ease;
}

.tiptap-image-upload-preview-content {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.tiptap-image-upload-file-info {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex: 1;
}

.tiptap-image-upload-file-icon {
  width: 2rem;
  height: 2rem;
  background: hsl(var(--muted));
  border-radius: 0.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: hsl(var(--muted-foreground));
}

.tiptap-image-upload-details {
  flex: 1;
}

.tiptap-image-upload-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.tiptap-image-upload-progress-text {
  font-size: 0.75rem;
  color: hsl(var(--muted-foreground));
}

.tiptap-image-upload-previews {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.tiptap-image-upload-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem;
  background: hsl(var(--muted) / 0.5);
  border-radius: 0.375rem;
  margin-bottom: 0.5rem;
}

.tiptap-image-upload-icon-container {
  margin-bottom: 0.75rem;
