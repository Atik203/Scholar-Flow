15: function clearBetterAuthCookies(): void {
16:   if (typeof document === "undefined") return;
17:   const hostname = window.location.hostname;
18:   const paths = ["/"];
19:   const expirations = [
20:     "Thu, 01 Jan 1970 00:00:00 GMT",
21:   ];
22:   for (const name of BETTER_AUTH_COOKIES) {
23:     for (const path of paths) {
24:       document.cookie = `${name}=; expires=${expirations[0]}; path=${path};`;
25:       document.cookie = `${name}=; expires=${expirations[0]}; path=${path}; secure;`;
26:       document.cookie = `${name}=; expires=${expirations[0]}; path=${path}; domain=${hostname};`;
27:     }
28:   }
29: }
30: async function purgePersistedState(): Promise<void> {
31:   const persistor = getPersistor();
32:   if (!persistor) return;
33:   await new Promise<void>((resolve) => {
34:     persistor.purge();
35:     setTimeout(resolve, 0);
36:   });
37: }
38: async function flushPersistedState(): Promise<void> {
39:   const persistor = getPersistor();
40:   if (!persistor) return;
41:   await persistor.flush();
42: }
43: async function invalidateBackendSession(): Promise<void> {
44:   const store = getAppStore();
45:   if (!store) return;
46:   const token = store.getState().auth.accessToken;
47:   if (!token) return;
48:   const controller = new AbortController();
49:   const timeoutId = setTimeout(() => controller.abort(), 2000);
50:   try {
51:     await fetch(`${API_BASE_URL}/auth/session/delete`, {
52:       method: "DELETE",
53:       headers: {
54:         "Content-Type": "application/json",
55:         Authorization: `Bearer ${token}`,
56:       },
57:       body: JSON.stringify({ token }),
58:       signal: controller.signal,
59:     });
60:   } catch {
61:   } finally {
62:     clearTimeout(timeoutId);
63:   }
64: }
65: export async function handleSignOut(redirectUrl: string = "/"): Promise<void> {
66:   const store = getAppStore();
67:   if (store) {
68:     store.dispatch(apiSlice.util.resetApiState());
69:   }
70:   closeNotificationStream();
71:   await purgePersistedState();
72:   if (store) {
73:     store.dispatch(clearCredentials());
74:   }
75:   await flushPersistedState();
76:   clearAuthCookie();
77:   clearBetterAuthCookies();
78:   await invalidateBackendSession();
79:   if (typeof window !== "undefined") {
80:     window.location.href = redirectUrl;
81:   }
82: }
83: export async function handleSignOutWithLoading(
84:   setLoading: (loading: boolean) => void,
85:   redirectUrl: string = "/"
86: ): Promise<void> {
87:   setLoading(true);
88:   try {
89:     await handleSignOut(redirectUrl);
90:   } catch (error) {
91:     if (process.env.NODE_ENV !== "production") {
92:       console.error("Signout error:", error);
93:     }
94:     if (typeof window !== "undefined") {
95:       window.location.href = redirectUrl;
96:     }
97:   }
98: }
