29:   VIEWER:
30:     "bg-gray-500/10 text-gray-600 border-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700",
31:   OWNER:
32:     "bg-emerald-500/10 text-emerald-600 border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-400 dark:border-emerald-800",
33: };
34: const ROLE_ICONS: Record<TeamRole, React.ComponentType<{ className?: string }>> = {
35:   ADMIN: Shield,
36:   TEAM_LEAD: Crown,
37:   PRO_RESEARCHER: UserIcon,
38:   RESEARCHER: UserIcon,
39:   MANAGER: UserIcon,
40:   EDITOR: UserIcon,
41:   VIEWER: Eye,
42:   OWNER: Crown,
43: };
44: const ROLE_ALIASES: Record<string, string> = {
45:   member: "RESEARCHER",
46:   user: "RESEARCHER",
47:   viewer: "VIEWER",
48:   editor: "EDITOR",
49:   manager: "MANAGER",
50:   owner: "OWNER",
51:   admin: "ADMIN",
52:   team_lead: "TEAM_LEAD",
53:   teamlead: "TEAM_LEAD",
54:   pro_researcher: "PRO_RESEARCHER",
55:   proresearcher: "PRO_RESEARCHER",
56: };
57: function normalizeRole(role: string): string {
58:   const upper = role.toUpperCase();
59:   return ROLE_ALIASES[upper] || upper;
60: }
61: export function getRoleLabel(role: string): string {
62:   return ROLE_LABELS[normalizeRole(role) as TeamRole] || role;
63: }
64: export function getRoleColor(role: string): string {
65:   return ROLE_COLORS[normalizeRole(role) as TeamRole] || ROLE_COLORS.RESEARCHER;
66: }
67: export function getRoleIcon(role: string) {
68:   return ROLE_ICONS[normalizeRole(role) as TeamRole] || UserIcon;
69: }
70: export function RoleBadge({ role, className }: { role: string; className?: string }) {
71:   const Icon = getRoleIcon(role);
72:   return (
