 74:   try {
 75:     console.log(`🔐 Completing ${provider} OAuth with code...`);
 76:     const response = await fetch(
 77:       `${API_BASE_URL}/auth/oauth/${provider}/callback`,
 78:       {
 79:         method: "POST",
 80:         headers: { "Content-Type": "application/json" },
 81:         body: JSON.stringify({ code }),
 82:       }
 83:     );
 84:     const data: AuthResponse = await response.json();
 85:     console.log(`📥 ${provider} OAuth response:`, {
 86:       success: data.success,
 87:       hasUser: !!data.data?.user,
 88:       hasToken: !!data.data?.accessToken,
 89:     });
 90:     if (!response.ok || !data.success) {
 91:       console.error(`❌ ${provider} OAuth failed:`, data.message);
 92:       return {
 93:         success: false,
 94:         error: data.message || `${provider} authentication failed`,
 95:       };
 96:     }
 97:     if (!data.data?.user || !data.data?.accessToken) {
 98:       console.error(`❌ ${provider} OAuth incomplete response:`, data);
 99:       return {
100:         success: false,
101:         error: "Authentication response was incomplete",
102:       };
103:     }
104:     console.log(`✅ Storing ${provider} OAuth credentials in Redux`);
105:     dispatch(
106:       setCredentials({
107:         user: data.data.user,
108:         accessToken: data.data.accessToken,
109:         sessionToken: data.data.sessionToken,
110:       })
111:     );
112:     document.cookie = `sf_last_auth=${provider}; path=/; max-age=604800; samesite=lax`;
113:     await flushAuthState();
114:     return { success: true, user: data.data.user };
115:   } catch (error) {
116:     console.error(`${provider} OAuth error:`, error);
117:     return {
118:       success: false,
119:       error: "An unexpected error occurred during authentication",
120:     };
121:   }
122: }
123: async function flushAuthState(): Promise<void> {
