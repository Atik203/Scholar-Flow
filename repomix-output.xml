123:       body.q,
124:       body.workspaceId,
125:       body.model,
126:       authReq.user.role
127:     );
128:     sendSuccessResponse(res, result, "AI summary generated");
129:   }),
130:   getSources: catchAsync(async (req: Request, res: Response) => {
131:     const authReq = req as AuthenticatedRequest;
132:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
133:     const q = sourcesQuerySchema.parse(req.query);
134:     const limit = Math.min(10, parseInt(q.limit || "5", 10));
135:     const sources = await SearchService.getTopSources(
136:       authReq.user.id,
137:       q.q,
138:       limit,
139:       q.workspaceId,
140:       authReq.user.role
141:     );
142:     sendSuccessResponse(res, { sources }, "Sources retrieved");
143:   }),
144: };
145: export default SearchController;
