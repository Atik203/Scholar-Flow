  4: import stripe, { isStripeError, logStripeError } from "../../shared/stripe";
  5: export const adminPaymentsService = {
  6:   async listPayments(params: {
  7:     page: number;
  8:     limit: number;
  9:     status?: string;
 10:     provider?: string;
 11:     search?: string;
 12:   }) {
 13:     const where: Prisma.PaymentWhereInput = { isDeleted: false };
 14:     if (params.status) where.status = params.status as Prisma.EnumPaymentStatusFilter;
 15:     if (params.provider) where.provider = params.provider as Prisma.EnumPaymentProviderFilter;
 16:     if (params.search) {
 17:       where.OR = [
 18:         { transactionId: { contains: params.search, mode: "insensitive" } },
 19:         { user: { email: { contains: params.search, mode: "insensitive" } } },
 20:       ];
 21:     }
 22:     const [total, items] = await Promise.all([
 23:       prisma.payment.count({ where }),
 24:       prisma.payment.findMany({
 25:         where,
 26:         orderBy: { createdAt: "desc" },
 27:         skip: (params.page - 1) * params.limit,
 28:         take: params.limit,
 29:         include: {
 30:           user: { select: { id: true, name: true, email: true } },
 31:           subscription: {
 32:             include: { plan: { select: { name: true, code: true } } },
 33:           },
 34:         },
 35:       }),
 36:     ]);
 37:     return {
 38:       items,
 39:       meta: {
 40:         page: params.page,
 41:         limit: params.limit,
 42:         total,
 43:         totalPage: Math.max(1, Math.ceil(total / params.limit)),
 44:       },
 45:     };
 46:   },
 47:   async refundPayment(paymentId: string, actorId: string) {
 48:     const payment = await prisma.payment.findFirst({
 49:       where: { id: paymentId, isDeleted: false },
 50:     });
 51:     if (!payment) throw new ApiError(404, "Payment not found");
 52:     if (payment.status === "REFUNDED") {
 53:       throw new ApiError(400, "Payment already refunded");
 54:     }
 55:     if (payment.status !== "SUCCEEDED") {
 56:       throw new ApiError(
 57:         400,
 58:         `Only successful payments can be refunded (current status: ${payment.status})`
 59:       );
 60:     }
 61:     const raw = (payment.raw ?? {}) as { payment_intent?: string | null };
 62:     let paymentIntentId = raw.payment_intent ?? null;
 63:     if (!paymentIntentId) {
 64:       const invoice = await stripe.invoices.retrieve(payment.transactionId);
 65:       const rawIntent = (
 66:         invoice as unknown as { payment_intent?: string | { id?: string } | null }
 67:       ).payment_intent;
 68:       paymentIntentId =
 69:         typeof rawIntent === "string" ? rawIntent : (rawIntent?.id ?? null);
 70:     }
 71:     if (!paymentIntentId) {
 72:       throw new ApiError(
 73:         400,
 74:         "No charge reference found for this payment — it cannot be refunded through Stripe"
 75:       );
 76:     }
 77:     try {
 78:       await stripe.refunds.create({ payment_intent: paymentIntentId });
 79:     } catch (error) {
 80:       if (isStripeError(error)) {
 81:         logStripeError(error, "admin refund");
 82:       }
 83:       throw new ApiError(
 84:         400,
 85:         `Stripe refund failed: ${error instanceof Error ? error.message : "Unknown error"}`
 86:       );
 87:     }
 88:     const updated = await prisma.$transaction(async (tx) => {
 89:       const updatedRow = await tx.payment.update({
 90:         where: { id: paymentId },
 91:         data: {
 92:           status: "REFUNDED",
 93:           raw: {
 94:             ...((payment.raw as object) ?? {}),
 95:             refundedAt: new Date().toISOString(),
 96:             refundedBy: actorId,
 97:           } as Prisma.InputJsonValue,
 98:         },
 99:       });
100:       await tx.activityLogEntry.create({
101:         data: {
102:           userId: actorId,
103:           entity: "payment",
104:           entityId: paymentId,
105:           action: "refunded",
106:           severity: "WARNING",
107:           details: {
108:             amountCents: payment.amountCents,
109:             currency: payment.currency,
110:             userId: payment.userId,
111:           },
112:         },
113:       });
114:       return updatedRow;
115:     });
116:     return updated;
117:   },
118: };
