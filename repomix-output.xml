 66: function formatRelativeTime(dateString: string): string {
 67:   const date = new Date(dateString);
 68:   const now = new Date();
 69:   const diffMs = now.getTime() - date.getTime();
 70:   const diffMins = Math.floor(diffMs / 60000);
 71:   const diffHours = Math.floor(diffMs / 3600000);
 72:   const diffDays = Math.floor(diffMs / 86400000);
 73:   if (diffMins < 1) return "Just now";
 74:   if (diffMins < 60) return `${diffMins}m ago`;
 75:   if (diffHours < 24) return `${diffHours}h ago`;
 76:   if (diffDays < 7) return `${diffDays}d ago`;
 77:   return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
 78: }
