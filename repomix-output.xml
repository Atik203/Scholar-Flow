142:   private chunkText(
143:     text: string,
144:     pageCount: number
145:   ): Array<{
146:     idx: number;
147:     page?: number;
148:     content: string;
149:     tokenCount?: number;
150:   }> {
151:     const chunks: Array<{
152:       idx: number;
153:       page?: number;
154:       content: string;
155:       tokenCount?: number;
156:     }> = [];
157:     if (!text) {
158:       return [];
159:     }
160:     const safePages = Math.max(1, Number.isFinite(pageCount) ? pageCount : 1);
161:     const textPerPage = Math.ceil(text.length / safePages);
162:     const pages = [];
163:     for (let i = 0; i < safePages; i++) {
164:       const start = i * textPerPage;
165:       const end = Math.min(start + textPerPage, text.length);
166:       pages.push(text.slice(start, end));
167:     }
168:     let chunkIndex = 0;
169:     pages.forEach((pageText, pageIndex) => {
170:       const maxChunkSize = 2000;
171:       const pageChunks = this.splitIntoChunks(pageText, maxChunkSize);
172:       pageChunks.forEach((chunkText) => {
173:         const sanitized = this.sanitizeText(chunkText);
174:         if (sanitized.length > 0) {
175:           chunks.push({
176:             idx: chunkIndex++,
177:             page: pageIndex + 1,
178:             content: sanitized,
179:             tokenCount: this.estimateTokenCount(sanitized),
180:           });
181:         }
182:       });
183:     });
184:     return chunks;
185:   }
186:   private splitIntoChunks(text: string, maxSize: number): string[] {
187:     const chunks: string[] = [];
188:     let currentChunk = "";
189:     const sentences = text.split(/[.!?]+/);
190:     for (const sentence of sentences) {
191:       if (
192:         currentChunk.length + sentence.length > maxSize &&
193:         currentChunk.length > 0
194:       ) {
195:         chunks.push(currentChunk.trim());
196:         currentChunk = sentence;
197:       } else {
198:         currentChunk += sentence + ".";
199:       }
200:     }
201:     if (currentChunk.trim().length > 0) {
