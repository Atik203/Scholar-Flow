 19: function timeAgo(dateStr: string) {
 20:   const diffMs = Date.now() - new Date(dateStr).getTime();
 21:   const mins = Math.floor(diffMs / 60000);
 22:   if (mins < 1) return "Just now";
 23:   if (mins < 60) return `${mins}m ago`;
 24:   const hours = Math.floor(mins / 60);
 25:   if (hours < 24) return `${hours}h ago`;
 26:   return new Date(dateStr).toLocaleDateString("en-US", { month: "short", day: "numeric" });
 27: }
