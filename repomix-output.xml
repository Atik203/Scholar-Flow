212:     const updatedConv = await prisma.aIConversation.findUnique({
213:       where: { id: conversationId },
214:       include: {
215:         messages: {
216:           orderBy: { createdAt: "asc" },
217:           select: { role: true, content: true },
218:           take: 15,
219:         },
