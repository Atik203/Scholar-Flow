  5: import { useTiptapEditor } from "@/hooks/use-tiptap-editor"
  6: import {
  7:   findNodePosition,
  8:   isNodeInSchema,
  9:   isNodeTypeSelected,
 10:   isValidPosition,
 11: } from "@/lib/tiptap-utils"
 12: import { HeadingOneIcon } from "@/components/tiptap-icons/heading-one-icon"
 13: import { HeadingTwoIcon } from "@/components/tiptap-icons/heading-two-icon"
 14: import { HeadingThreeIcon } from "@/components/tiptap-icons/heading-three-icon"
 15: import { HeadingFourIcon } from "@/components/tiptap-icons/heading-four-icon"
 16: import { HeadingFiveIcon } from "@/components/tiptap-icons/heading-five-icon"
 17: import { HeadingSixIcon } from "@/components/tiptap-icons/heading-six-icon"
 18: export type Level = 1 | 2 | 3 | 4 | 5 | 6
 19: export interface UseHeadingConfig {
 20:   editor?: Editor | null
 21:   level: Level
 22:   hideWhenUnavailable?: boolean
 23:   onToggled?: () => void
 24: }
 25: export const headingIcons = {
 26:   1: HeadingOneIcon,
 27:   2: HeadingTwoIcon,
 28:   3: HeadingThreeIcon,
 29:   4: HeadingFourIcon,
 30:   5: HeadingFiveIcon,
 31:   6: HeadingSixIcon,
 32: }
 33: export const HEADING_SHORTCUT_KEYS: Record<Level, string> = {
 34:   1: "ctrl+alt+1",
 35:   2: "ctrl+alt+2",
 36:   3: "ctrl+alt+3",
 37:   4: "ctrl+alt+4",
 38:   5: "ctrl+alt+5",
 39:   6: "ctrl+alt+6",
 40: }
 41: export function canToggle(
 42:   editor: Editor | null,
 43:   level?: Level,
 44:   turnInto: boolean = true
 45: ): boolean {
 46:   if (!editor || !editor.isEditable) return false
 47:   if (
 48:     !isNodeInSchema("heading", editor) ||
 49:     isNodeTypeSelected(editor, ["image"])
 50:   )
 51:     return false
 52:   if (!turnInto) {
 53:     return level
 54:       ? editor.can().setNode("heading", { level })
 55:       : editor.can().setNode("heading")
 56:   }
 57:   try {
 58:     const view = editor.view
 59:     const state = view.state
 60:     const selection = state.selection
 61:     if (selection.empty || selection instanceof TextSelection) {
 62:       const pos = findNodePosition({
 63:         editor,
 64:         node: state.selection.$anchor.node(1),
 65:       })?.pos
 66:       if (!isValidPosition(pos)) return false
 67:     }
 68:     return true
 69:   } catch {
 70:     return false
 71:   }
 72: }
 73: export function isHeadingActive(
 74:   editor: Editor | null,
 75:   level?: Level | Level[]
 76: ): boolean {
 77:   if (!editor || !editor.isEditable) return false
 78:   if (Array.isArray(level)) {
 79:     return level.some((l) => editor.isActive("heading", { level: l }))
 80:   }
 81:   return level
 82:     ? editor.isActive("heading", { level })
 83:     : editor.isActive("heading")
 84: }
 85: export function toggleHeading(
 86:   editor: Editor | null,
 87:   level: Level | Level[]
 88: ): boolean {
 89:   if (!editor || !editor.isEditable) return false
 90:   const levels = Array.isArray(level) ? level : [level]
 91:   const toggleLevel = levels.find((l) => canToggle(editor, l))
 92:   if (!toggleLevel) return false
 93:   try {
 94:     const view = editor.view
 95:     let state = view.state
 96:     let tr = state.tr
 97:     if (state.selection.empty || state.selection instanceof TextSelection) {
 98:       const pos = findNodePosition({
 99:         editor,
100:         node: state.selection.$anchor.node(1),
101:       })?.pos
102:       if (!isValidPosition(pos)) return false
103:       tr = tr.setSelection(NodeSelection.create(state.doc, pos))
104:       view.dispatch(tr)
105:       state = view.state
106:     }
107:     const selection = state.selection
108:     let chain = editor.chain().focus()
109:     if (selection instanceof NodeSelection) {
110:       const firstChild = selection.node.firstChild?.firstChild
111:       const lastChild = selection.node.lastChild?.lastChild
112:       const from = firstChild
113:         ? selection.from + firstChild.nodeSize
114:         : selection.from + 1
115:       const to = lastChild
116:         ? selection.to - lastChild.nodeSize
117:         : selection.to - 1
118:       chain = chain.setTextSelection({ from, to }).clearNodes()
119:     }
120:     const isActive = levels.some((l) =>
121:       editor.isActive("heading", { level: l })
122:     )
123:     const toggle = isActive
124:       ? chain.setNode("paragraph")
125:       : chain.setNode("heading", { level: toggleLevel })
126:     toggle.run()
127:     editor.chain().focus().selectTextblockEnd().run()
128:     return true
129:   } catch {
130:     return false
131:   }
132: }
133: export function shouldShowButton(props: {
134:   editor: Editor | null
135:   level?: Level | Level[]
136:   hideWhenUnavailable: boolean
137: }): boolean {
138:   const { editor, level, hideWhenUnavailable } = props
139:   if (!editor || !editor.isEditable) return false
140:   if (!isNodeInSchema("heading", editor)) return false
141:   if (hideWhenUnavailable && !editor.isActive("code")) {
142:     if (Array.isArray(level)) {
143:       return level.some((l) => canToggle(editor, l))
144:     }
145:     return canToggle(editor, level)
146:   }
147:   return true
148: }
149: export function useHeading(config: UseHeadingConfig) {
150:   const {
151:     editor: providedEditor,
152:     level,
153:     hideWhenUnavailable = false,
154:     onToggled,
155:   } = config
156:   const { editor } = useTiptapEditor(providedEditor)
157:   const [isVisible, setIsVisible] = React.useState<boolean>(true)
158:   const canToggleState = canToggle(editor, level)
159:   const isActive = isHeadingActive(editor, level)
160:   React.useEffect(() => {
161:     if (!editor) return
162:     const handleSelectionUpdate = () => {
163:       setIsVisible(shouldShowButton({ editor, level, hideWhenUnavailable }))
164:     }
165:     handleSelectionUpdate()
166:     editor.on("selectionUpdate", handleSelectionUpdate)
167:     return () => {
168:       editor.off("selectionUpdate", handleSelectionUpdate)
169:     }
170:   }, [editor, level, hideWhenUnavailable])
171:   const handleToggle = React.useCallback(() => {
172:     if (!editor) return false
173:     const success = toggleHeading(editor, level)
174:     if (success) {
175:       onToggled?.()
176:     }
177:     return success
178:   }, [editor, level, onToggled])
179:   return {
180:     isVisible,
181:     isActive,
182:     handleToggle,
183:     canToggle: canToggleState,
184:     label: `Heading ${level}`,
185:     shortcutKeys: HEADING_SHORTCUT_KEYS[level],
186:     Icon: headingIcons[level],
187:   }
188: }
</file>

