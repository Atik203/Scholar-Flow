<file path="apps/frontend/src/lib/downloadBlob.ts">
 1: import { getApiBaseUrl } from "@/lib/apiUrl";
 2: export async function downloadAuthenticatedFile(
 3:   path: string,
 4:   token: string | null,
 5:   fallbackName: string
 6: ): Promise<void> {
 7:   const res = await fetch(`${getApiBaseUrl()}${path}`, {
 8:     headers: token ? { Authorization: `Bearer ${token}` } : {},
 9:   });
10:   if (!res.ok) {
11:     throw new Error(`Download failed (${res.status})`);
12:   }
13:   const disposition = res.headers.get("Content-Disposition") ?? "";
14:   const match = /filename="?([^";]+)"?/.exec(disposition);
15:   const blob = await res.blob();
16:   const url = URL.createObjectURL(blob);
17:   const link = document.createElement("a");
18:   link.href = url;
19:   link.download = match?.[1] ?? fallbackName;
20:   document.body.appendChild(link);
21:   link.click();
22:   document.body.removeChild(link);
23:   URL.revokeObjectURL(url);
24: }
</file>

