<file path="apps/frontend/src/components/comments/CommentSection.tsx">
 1: "use client";
 2: import { useState } from "react";
 3: import { Button } from "@/components/ui/button";
 4: import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
 5: import { Textarea } from "@/components/ui/textarea";
 6: import { Badge } from "@/components/ui/badge";
 7: import { ScrollArea } from "@/components/ui/scroll-area";
 8: import { Separator } from "@/components/ui/separator";
 9: import { CommentForm } from "./CommentForm";
10: import { CommentItem } from "./CommentItem";
11: import { useGetPaperAnnotationsQuery } from "@/redux/api/annotationApi";
12: import { formatDistanceToNow } from "date-fns";
13: import { MessageSquare, Plus } from "lucide-react";
14: interface CommentSectionProps {
15:   paperId: string;
16:   className?: string;
17: }
18: export function CommentSection({ paperId, className = "" }: CommentSectionProps) {
19:   const [showCommentForm, setShowCommentForm] = useState(false);
20:   // Fetch comments (using annotations with type COMMENT)
21:   const { data: annotationsData, isLoading } = useGetPaperAnnotationsQuery({
22:     paperId,
23:     type: "COMMENT",
24:     includeReplies: true,
25:   });
26:   const comments = annotationsData?.data || [];
27:   const topLevelComments = comments.filter(comment => !comment.parentId);
28:   const repliesByParent = comments.reduce((acc, comment) => {
29:     if (comment.parentId) {
30:       if (!acc[comment.parentId]) {
31:         acc[comment.parentId] = [];
32:       }
33:       acc[comment.parentId].push(comment);
34:     }
35:     return acc;
36:   }, {} as Record<string, typeof comments>);
37:   return (
38:     <Card className={className}>
39:       <CardHeader>
40:         <div className="flex items-center justify-between">
41:           <div className="flex items-center gap-2">
42:             <MessageSquare className="h-5 w-5" />
43:             <CardTitle className="text-lg">Comments</CardTitle>
44:             <Badge variant="secondary">{comments.length}</Badge>
45:           </div>
46:           <Button
47:             variant="outline"
48:             size="sm"
49:             onClick={() => setShowCommentForm(!showCommentForm)}
50:             className="gap-2"
51:           >
52:             <Plus className="h-4 w-4" />
53:             Add Comment
54:           </Button>
55:         </div>
56:       </CardHeader>
57:       <CardContent className="space-y-4">
58:         {}
59:         {showCommentForm && (
60:           <CommentForm
61:             paperId={paperId}
62:             onSuccess={() => setShowCommentForm(false)}
63:             onCancel={() => setShowCommentForm(false)}
64:           />
65:         )}
66:         {}
67:         <ScrollArea className="h-96">
68:           <div className="space-y-4">
69:             {topLevelComments.length === 0 ? (
70:               <div className="text-center py-8 text-muted-foreground">
71:                 <MessageSquare className="h-8 w-8 mx-auto mb-2 opacity-50" />
72:                 <p className="text-sm">No comments yet</p>
73:                 <p className="text-xs">Be the first to start a discussion</p>
74:               </div>
75:             ) : (
76:               topLevelComments.map((comment) => (
77:                 <div key={comment.id} className="space-y-2">
78:                   <CommentItem
79:                     comment={comment}
80:                     replies={repliesByParent[comment.id] || []}
81:                     paperId={paperId}
82:                   />
83:                   {topLevelComments.indexOf(comment) < topLevelComments.length - 1 && (
84:                     <Separator />
85:                   )}
86:                 </div>
87:               ))
88:             )}
89:           </div>
90:         </ScrollArea>
91:       </CardContent>
92:     </Card>
93:   );
94: }
</file>

