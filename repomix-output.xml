130:       <div className="flex items-start justify-between">
131:         <div className="flex-1">
132:           <p
133:             className={`text-muted-foreground font-medium ${sizeConfig.title}`}
134:           >
135:             {title}
136:           </p>
137:           <p className={`font-bold mt-2 ${sizeConfig.value}`}>{displayValue}</p>
138:           {}
139:           {displayChange && (
140:             <div
141:               className={`flex items-center gap-1 mt-2 ${getChangeColor()} ${sizeConfig.change}`}
142:             >
143:               {getChangeIcon()}
144:               <span>{displayChange}</span>
145:               {getTrendIcon()}
146:             </div>
147:           )}
148:           {}
149:           {description && (
150:             <p
151:               className={`text-muted-foreground mt-2 ${sizeConfig.description}`}
152:             >
153:               {description}
154:             </p>
155:           )}
156:         </div>
157:         {}
158:         {Icon && (
159:           <div className="p-3 rounded-lg bg-primary/10">
160:             <Icon className={`text-primary ${iconSizes[currentSize]}`} />
161:           </div>
162:         )}
163:       </div>
164:     </div>
