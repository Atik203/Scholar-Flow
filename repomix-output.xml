  1: import prisma from "../../shared/prisma";
  2: export type NotificationCategory =
  3:   | "PAPERS"
  4:   | "DISCUSSIONS"
  5:   | "COLLECTIONS"
  6:   | "WORKSPACE"
  7:   | "TEAM"
  8:   | "BILLING"
  9:   | "SECURITY"
 10:   | "ACHIEVEMENT"
 11:   | "SYSTEM";
 12: export type NotificationChannel = "inApp" | "email" | "push";
 13: export interface CategoryChannelSetting {
 14:   email: boolean;
 15:   push: boolean;
 16:   inApp: boolean;
 17: }
 18: export type NotificationPreferences = {
 19:   channels: {
 20:     inApp: boolean;
 21:     email: boolean;
 22:     push: boolean;
 23:   };
 24:   categories: Record<NotificationCategory, CategoryChannelSetting>;
 25:   quietHours: {
 26:     enabled: boolean;
 27:     startTime: string;
 28:     endTime: string;
 29:     days: string[];
 30:   };
 31:   digestFrequency: "instant" | "daily" | "weekly";
 32:   muteAll: boolean;
 33: };
 34: const DEFAULT_PREFERENCES: NotificationPreferences = {
 35:   channels: { inApp: true, email: true, push: false },
 36:   categories: {
 37:     PAPERS: { email: true, push: true, inApp: true },
 38:     DISCUSSIONS: { email: true, push: true, inApp: true },
 39:     COLLECTIONS: { email: true, push: false, inApp: true },
 40:     WORKSPACE: { email: true, push: true, inApp: true },
 41:     TEAM: { email: true, push: true, inApp: true },
 42:     BILLING: { email: true, push: false, inApp: true },
 43:     SECURITY: { email: true, push: true, inApp: true },
 44:     ACHIEVEMENT: { email: false, push: false, inApp: true },
 45:     SYSTEM: { email: true, push: false, inApp: true },
 46:   },
 47:   quietHours: {
 48:     enabled: false,
 49:     startTime: "22:00",
 50:     endTime: "08:00",
 51:     days: [],
 52:   },
 53:   digestFrequency: "instant",
 54:   muteAll: false,
 55: };
 56: export const notificationSettingsService = {
 57:   async getPreferences(userId: string): Promise<NotificationPreferences> {
 58:     const pref = await prisma.userPreference.upsert({
 59:       where: { userId },
 60:       create: {
 61:         userId,
 62:         notificationPreferences: DEFAULT_PREFERENCES as unknown as object,
 63:       },
 64:       update: {},
 65:       select: { notificationPreferences: true },
 66:     });
 67:     if (!pref.notificationPreferences) {
 68:       return DEFAULT_PREFERENCES;
 69:     }
 70:     const stored = pref.notificationPreferences as Partial<NotificationPreferences>;
 71:     return {
 72:       ...DEFAULT_PREFERENCES,
 73:       ...stored,
 74:       channels: { ...DEFAULT_PREFERENCES.channels, ...(stored.channels ?? {}) },
 75:       categories: {
 76:         ...DEFAULT_PREFERENCES.categories,
 77:         ...(stored.categories ?? {}),
 78:       } as NotificationPreferences["categories"],
 79:       quietHours: { ...DEFAULT_PREFERENCES.quietHours, ...(stored.quietHours ?? {}) },
 80:     };
 81:   },
 82:   async getPreferencesLite(userId: string): Promise<NotificationPreferences> {
 83:     try {
 84:       const row = await prisma.userPreference.findUnique({
 85:         where: { userId },
 86:         select: { notificationPreferences: true },
 87:       });
 88:       const stored = row?.notificationPreferences as
 89:         | Partial<NotificationPreferences>
 90:         | null
 91:         | undefined;
 92:       if (!stored) return DEFAULT_PREFERENCES;
 93:       return {
 94:         ...DEFAULT_PREFERENCES,
 95:         ...stored,
 96:         channels: {
 97:           ...DEFAULT_PREFERENCES.channels,
 98:           ...(stored.channels ?? {}),
 99:         },
100:         categories: {
101:           ...DEFAULT_PREFERENCES.categories,
102:           ...(stored.categories ?? {}),
103:         } as NotificationPreferences["categories"],
104:         quietHours: {
105:           ...DEFAULT_PREFERENCES.quietHours,
106:           ...(stored.quietHours ?? {}),
107:         },
108:       };
109:     } catch {
110:       return DEFAULT_PREFERENCES;
111:     }
112:   },
113:   async updatePreferences(
114:     userId: string,
115:     patch: Partial<NotificationPreferences> & {
116:       categories?: Record<
117:         string,
118:         Partial<CategoryChannelSetting> | undefined
119:       >;
120:     }
121:   ): Promise<NotificationPreferences> {
122:     const current = await this.getPreferences(userId);
123:     const mergedCategories: NotificationPreferences["categories"] = {
124:       ...current.categories,
125:     };
126:     if (patch.categories) {
127:       for (const [key, value] of Object.entries(patch.categories)) {
128:         if (!value) continue;
129:         const existing =
130:           mergedCategories[key as keyof typeof mergedCategories];
131:         if (existing) {
132:           (mergedCategories as Record<string, CategoryChannelSetting>)[key] = {
133:             ...existing,
134:             ...value,
135:           };
136:         }
137:       }
138:     }
139:     const merged: NotificationPreferences = {
140:       ...current,
141:       ...patch,
142:       channels: { ...current.channels, ...(patch.channels ?? {}) },
143:       categories: mergedCategories,
144:       quietHours: { ...current.quietHours, ...(patch.quietHours ?? {}) },
145:     };
146:     await prisma.userPreference.upsert({
147:       where: { userId },
148:       create: {
149:         userId,
150:         notificationPreferences: merged as unknown as object,
151:       },
152:       update: {
153:         notificationPreferences: merged as unknown as object,
154:       },
155:       select: { id: true },
156:     });
157:     return merged;
158:   },
159: };
160: export { DEFAULT_PREFERENCES };
</file>

