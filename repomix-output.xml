 1: import { TErrorSources, TGenericErrorResponse } from "../interfaces/error";
 2: const handleDuplicateError = (error: any): TGenericErrorResponse => {
 3:   const statusCode = 400;
 4:   const match = error.message.match(/"([^"]*)"/);
 5:   const extractedMessage = match && match[1];
 6:   const errorSources: TErrorSources = [
 7:     {
 8:       path: "",
 9:       message: `${extractedMessage} already exists`,
10:     },
11:   ];
12:   return {
13:     message: "Duplicate value entered",
14:     statusCode,
15:     errorSources,
16:   };
17: };
18: export default handleDuplicateError;
</file>

