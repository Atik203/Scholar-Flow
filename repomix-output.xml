  1: "use client";
  2: import { useRouter } from "next/navigation";
  3: import { useEffect } from "react";
  4: import { getCallbackUrl, getRoleDashboardUrl } from "@/lib/auth/redirects";
  5: import { useAuth } from "@/redux/auth/useAuth";
  6: interface UseAuthGuardOptions {
  7:   redirectTo?: string;
  8:   requireAuth?: boolean;
  9:   redirectAuthenticatedTo?: string;
 10: }
 11: export function useAuthGuard(options: UseAuthGuardOptions = {}) {
 12:   const {
 13:     redirectTo = "/login",
 14:     requireAuth = true,
 15:     redirectAuthenticatedTo,
 16:   } = options;
 17:   const { user, status, isAuthenticated, isLoading } = useAuth();
 18:   const router = useRouter();
 19:   useEffect(() => {
 20:     if (status === "loading") return;
 21:     if (requireAuth && !isAuthenticated) {
 22:       const currentPath = window.location.pathname;
 23:       const loginUrl = new URL(redirectTo, window.location.origin);
 24:       if (currentPath !== "/" && currentPath !== redirectTo) {
 25:         loginUrl.searchParams.set("callbackUrl", currentPath);
 26:       }
 27:       router.replace(loginUrl.toString());
 28:       return;
 29:     }
 30:     if (!requireAuth && isAuthenticated && redirectAuthenticatedTo) {
 31:       let destination = redirectAuthenticatedTo;
 32:       if (typeof window !== "undefined") {
 33:         const params = new URLSearchParams(window.location.search);
 34:         const callback = getCallbackUrl(params, destination);
 35:         if (callback) {
 36:           destination = callback;
 37:         }
 38:       }
 39:       if (
 40:         user?.role &&
 41:         (destination === "/dashboard" || destination === "/dashboard/")
 42:       ) {
 43:         destination = getRoleDashboardUrl(user.role);
 44:       }
 45:       router.replace(destination);
 46:       return;
 47:     }
 48:   }, [isAuthenticated, status, requireAuth, redirectTo, redirectAuthenticatedTo, router, user?.role]);
 49:   return {
 50:     isAuthenticated,
 51:     status,
 52:     isLoading,
 53:     session: isAuthenticated ? { user } : null,
 54:     user: isAuthenticated ? user : null,
 55:   };
 56: }
 57: export function useProtectedRoute(redirectTo: string = "/login") {
 58:   return useAuthGuard({
 59:     requireAuth: true,
 60:     redirectTo,
 61:   });
 62: }
 63: export function useAuthRoute(redirectTo: string = "/dashboard") {
 64:   return useAuthGuard({
 65:     requireAuth: false,
 66:     redirectAuthenticatedTo: redirectTo,
 67:   });
 68: }
 69: export function usePublicRoute() {
 70:   const { user, isAuthenticated, isLoading, status } = useAuth();
 71:   return {
 72:     isAuthenticated,
 73:     isLoading,
 74:     status,
 75:     session: isAuthenticated ? { user } : null,
 76:     user: isAuthenticated ? user : null,
 77:   };
 78: }
 79: export function useOnboardingGuard() {
 80:   const { user, isAuthenticated, isLoading, status } = useAuth();
 81:   const router = useRouter();
 82:   useEffect(() => {
 83:     if (isLoading) return;
 84:     if (
 85:       isAuthenticated &&
 86:       user &&
 87:       !user.onboardingCompleted &&
 88:       typeof window !== "undefined" &&
 89:       window.location.pathname !== "/onboarding"
 90:     ) {
 91:       router.replace("/onboarding");
 92:     }
 93:   }, [isAuthenticated, isLoading, user, router]);
 94:   return {
 95:     isAuthenticated,
 96:     isLoading,
 97:     status,
 98:     user,
 99:   };
100: }
</file>

