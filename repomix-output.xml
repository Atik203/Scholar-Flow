<file path="apps/frontend/src/middleware.ts">
 1: import { NextResponse } from "next/server";
 2: import type { NextRequest } from "next/server";
 3: export function middleware(request: NextRequest) {
 4:   const { pathname, searchParams } = request.nextUrl;
 5:   if (pathname.startsWith("/api/")) {
 6:     return NextResponse.next();
 7:   }
 8:   if (
 9:     pathname.startsWith("/_next/") ||
10:     pathname.startsWith("/static/") ||
11:     pathname.includes(".")
12:   ) {
13:     return NextResponse.next();
14:   }
15:   if (pathname.startsWith("/dashboard")) {
16:     const authCookie = request.cookies.get("sf_auth")?.value;
17:     if (!authCookie) {
18:       const callbackUrl = searchParams.get("callbackUrl");
19:       if (!callbackUrl) {
20:         const loginUrl = new URL("/login", request.url);
21:         loginUrl.searchParams.set("callbackUrl", pathname);
22:         return NextResponse.redirect(loginUrl);
23:       }
24:     }
25:   }
26:   if (pathname === "/login" || pathname === "/register") {
27:     const authCookie = request.cookies.get("sf_auth")?.value;
28:     if (authCookie) {
29:       return NextResponse.redirect(new URL("/dashboard", request.url));
30:     }
31:   }
32:   return NextResponse.next();
33: }
34: export const config = {
35:   matcher: [
36:     "/((?!api|_next/static|_next/image|favicon.ico|.*\\..*$).*)",
37:   ],
38: };
</file>

