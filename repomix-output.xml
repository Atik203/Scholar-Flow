 99:       q,
100:       limit,
101:       workspaceId
102:     );
103:     sendSuccessResponse(res, result, "Semantic search completed");
104:   }),
105:   getExplore: catchAsync(async (req: Request, res: Response) => {
106:     const authReq = req as AuthenticatedRequest;
107:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
108:     const q = exploreQuerySchema.parse(req.query);
