 29:       FROM "Subscription" s
 30:       JOIN "Plan" p ON s."planId" = p.id
 31:       WHERE s."isDeleted" = false
 32:         AND s.status = 'ACTIVE'
 33:       GROUP BY p.name
 34:       ORDER BY count DESC
 35:     `;
 36:     const mrrData = await prisma.$queryRaw<
 37:       Array<{ totalMrr: string; currency: string }>
 38:     >`
 39:       SELECT
 40:         SUM(
 41:           CASE
 42:             WHEN p.interval = 'month' THEN p."priceCents"
 43:             WHEN p.interval = 'year' THEN p."priceCents" / 12
 44:             ELSE 0
 45:           END
 46:         )::numeric / 100 as "totalMrr",
 47:         p.currency
 48:       FROM "Subscription" s
 49:       JOIN "Plan" p ON s."planId" = p.id
 50:       WHERE s."isDeleted" = false
 51:         AND s.status = 'ACTIVE'
 52:         AND s."cancelAtPeriodEnd" = false
 53:       GROUP BY p.currency
 54:     `;
