313: /**
314:  * Get comprehensive user analytics including papers, collections, storage, and tokens
315:  */
316: const getUserAnalytics = async (user: IAuthUser) => {
317:   try {
318:     // Verify user exists
319:     const existingUsers = await prisma.$queryRaw<any[]>`
320:       SELECT id, email, role, "stripeSubscriptionId", "stripePriceId", "isDeleted"
321:       FROM "User"
322:       WHERE id = ${user.id} AND "isDeleted" = false
323:       LIMIT 1
324:     `;
325:     if (existingUsers.length === 0) {
326:       throw new ApiError(404, "User not found or account deleted");
327:     }
328:     const userData = existingUsers[0];
329:     // Determine user plan from subscription state (not just stripeSubscriptionId,
330:     // which persists after cancellation). ACTIVE/PAST_DUE = paid tier by role.
331:     let plan = "FREE";
332:     if (userData.stripeSubscriptionId) {
333:       const sub = await prisma.$queryRaw<Array<{ status: string }>>`
334:         SELECT status
335:         FROM "Subscription"
336:         WHERE "userId" = ${user.id}
337:           AND "providerSubscriptionId" = ${userData.stripeSubscriptionId}
338:           AND "isDeleted" = false
339:         LIMIT 1
340:       `;
341:       if (sub[0]?.status === "ACTIVE" || sub[0]?.status === "PAST_DUE") {
342:         plan = userData.role === "TEAM_LEAD" ? "TEAM" : "PRO";
343:       }
344:     }
345:     // Get papers count and storage used
346:     const paperStats = await prisma.$queryRaw<any[]>`
347:       SELECT
348:         COUNT(DISTINCT p.id)::INTEGER as "totalPapers",
349:         COALESCE(SUM(pf."sizeBytes"), 0)::BIGINT as "totalStorage"
350:       FROM "Paper" p
351:       LEFT JOIN "PaperFile" pf ON p.id = pf."paperId" AND pf."isDeleted" = false
352:       WHERE p."uploaderId" = ${user.id} AND p."isDeleted" = false
353:     `;
354:     // Get collections count
355:     const collectionStats = await prisma.$queryRaw<any[]>`
356:       SELECT COUNT(*)::INTEGER as "totalCollections"
357:       FROM "Collection"
358:       WHERE "ownerId" = ${user.id} AND "isDeleted" = false
359:     `;
360:     // Get AI tokens usage (from UsageEvent)
361:     // Sum units for AI-related events (ai_summarize, semantic_search, etc.)
362:     const tokenStats = await prisma.$queryRaw<any[]>`
363:       SELECT
364:         COALESCE(SUM("units"), 0)::INTEGER as "totalTokensUsed"
365:       FROM "UsageEvent"
366:       WHERE "userId" = ${user.id}
367:         AND "isDeleted" = false
368:         AND ("kind" LIKE 'ai_%' OR "kind" = 'semantic_search')
369:     `;
370:     // Get papers uploaded over time (last 30 days for chart)
371:     const papersOverTime = await prisma.$queryRaw<any[]>`
372:       SELECT
373:         DATE("createdAt") as date,
374:         COUNT(*)::INTEGER as count
375:       FROM "Paper"
376:       WHERE "uploaderId" = ${user.id}
377:         AND "isDeleted" = false
378:         AND "createdAt" >= NOW() - INTERVAL '30 days'
379:       GROUP BY DATE("createdAt")
380:       ORDER BY date ASC
381:     `;
382:     // Get collections created over time (last 30 days)
383:     const collectionsOverTime = await prisma.$queryRaw<any[]>`
384:       SELECT
385:         DATE("createdAt") as date,
386:         COUNT(*)::INTEGER as count
387:       FROM "Collection"
388:       WHERE "ownerId" = ${user.id}
389:         AND "isDeleted" = false
390:         AND "createdAt" >= NOW() - INTERVAL '30 days'
391:       GROUP BY DATE("createdAt")
392:       ORDER BY date ASC
393:     `;
394:     // Get storage usage by month (last 6 months)
395:     const storageOverTime = await prisma.$queryRaw<any[]>`
396:       SELECT
397:         DATE_TRUNC('month', p."createdAt") as month,
398:         COALESCE(SUM(pf."sizeBytes"), 0)::BIGINT as "totalSize"
399:       FROM "Paper" p
400:       LEFT JOIN "PaperFile" pf ON p.id = pf."paperId" AND pf."isDeleted" = false
401:       WHERE p."uploaderId" = ${user.id}
402:         AND p."isDeleted" = false
403:         AND p."createdAt" >= NOW() - INTERVAL '6 months'
404:       GROUP BY DATE_TRUNC('month', p."createdAt")
405:       ORDER BY month ASC
406:     `;
407:     // Get papers by processing status
408:     const papersByStatus = await prisma.$queryRaw<any[]>`
409:       SELECT
410:         "processingStatus",
411:         COUNT(*)::INTEGER as count
412:       FROM "Paper"
413:       WHERE "uploaderId" = ${user.id} AND "isDeleted" = false
414:       GROUP BY "processingStatus"
415:     `;
416:     // Convert storage from bytes to MB for easier reading
417:     const totalStorageMB =
418:       Number(paperStats[0]?.totalStorage || 0) / (1024 * 1024);
419:     // Plan limits
420:     const planLimits = {
421:       FREE: {
422:         maxPapers: 50,
423:         maxStorage: 1024, // 1GB in MB
424:         maxTokens: 10000,
425:         maxCollections: 10,
426:       },
427:       PRO: {
428:         maxPapers: -1, // Unlimited
429:         maxStorage: 51200, // 50GB in MB
430:         maxTokens: 1000000,
431:         maxCollections: -1, // Unlimited
432:       },
433:     };
434:     const limits = planLimits[plan as keyof typeof planLimits];
435:     return {
436:       plan,
437:       limits,
438:       usage: {
439:         papers: {
440:           total: Number(paperStats[0]?.totalPapers || 0),
441:           limit: limits.maxPapers,
442:           percentage:
443:             limits.maxPapers === -1
444:               ? 0
445:               : (Number(paperStats[0]?.totalPapers || 0) / limits.maxPapers) *
446:                 100,
447:         },
448:         collections: {
449:           total: Number(collectionStats[0]?.totalCollections || 0),
450:           limit: limits.maxCollections,
451:           percentage:
452:             limits.maxCollections === -1
453:               ? 0
454:               : (Number(collectionStats[0]?.totalCollections || 0) /
455:                   limits.maxCollections) *
456:                 100,
457:         },
458:         storage: {
459:           used: totalStorageMB,
460:           limit: limits.maxStorage,
461:           percentage: (totalStorageMB / limits.maxStorage) * 100,
462:           unit: "MB",
463:         },
464:         tokens: {
465:           used: Number(tokenStats[0]?.totalTokensUsed || 0),
466:           limit: limits.maxTokens,
467:           percentage:
468:             (Number(tokenStats[0]?.totalTokensUsed || 0) / limits.maxTokens) *
469:             100,
470:         },
471:       },
472:       charts: {
473:         papersOverTime: papersOverTime.map((row) => ({
474:           date: row.date,
475:           count: Number(row.count),
476:         })),
477:         collectionsOverTime: collectionsOverTime.map((row) => ({
478:           date: row.date,
479:           count: Number(row.count),
480:         })),
481:         storageOverTime: storageOverTime.map((row) => ({
482:           month: row.month,
483:           size: Number(row.totalSize) / (1024 * 1024), // Convert to MB
484:         })),
485:         papersByStatus: papersByStatus.map((row) => ({
486:           status: row.processingStatus,
487:           count: Number(row.count),
488:         })),
489:       },
490:     };
491:   } catch (error) {
492:     console.error("Error fetching user analytics:", error);
493:     if (error instanceof ApiError) {
494:       throw error;
495:     }
496:     throw new ApiError(500, "Failed to fetch user analytics");
497:   }
498: };
