  1: import { PrismaClient } from "@prisma/client";
  2: export class QueryOptimizer {
  3:   constructor(private prisma: PrismaClient) {}
  4:   async explainAnalyze(
  5:     query: string,
  6:     params: any[] = []
  7:   ): Promise<{
  8:     planningTime: number;
  9:     executionTime: number;
 10:     totalTime: number;
 11:     plan: any[];
 12:   }> {
 13:     try {
 14:       const explainQuery = `EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON) ${query}`;
 15:       const result = await this.prisma.$queryRawUnsafe<any[]>(
 16:         explainQuery,
 17:         ...params
 18:       );
 19:       const plan = result[0]["QUERY PLAN"][0];
 20:       const planningTime = plan["Planning Time"] || 0;
 21:       const executionTime = plan["Execution Time"] || 0;
 22:       return {
 23:         planningTime,
 24:         executionTime,
 25:         totalTime: planningTime + executionTime,
 26:         plan: result,
 27:       };
 28:     } catch (error) {
 29:       console.error("Error analyzing query:", error);
 30:       throw error;
 31:     }
 32:   }
 33:   async explain(query: string, params: any[] = []): Promise<any[]> {
 34:     try {
 35:       const explainQuery = `EXPLAIN (FORMAT JSON) ${query}`;
 36:       const result = await this.prisma.$queryRawUnsafe<any[]>(
 37:         explainQuery,
 38:         ...params
 39:       );
 40:       return result;
 41:     } catch (error) {
 42:       console.error("Error explaining query:", error);
 43:       throw error;
 44:     }
 45:   }
 46:   async profileQuery<T>(
 47:     queryFn: () => Promise<T>
 48:   ): Promise<{ result: T; duration: number }> {
 49:     const startTime = performance.now();
 50:     const result = await queryFn();
 51:     const endTime = performance.now();
 52:     const duration = endTime - startTime;
 53:     if (duration > 100) {
 54:       console.warn(`Slow query detected: ${duration.toFixed(2)}ms`);
 55:     }
 56:     return { result, duration };
 57:   }
 58:   async getTableStats(tableName: string): Promise<{
 59:     rowCount: bigint;
 60:     tableSize: string;
 61:     indexSize: string;
 62:     totalSize: string;
 63:   }> {
 64:     const stats = await this.prisma.$queryRaw<
 65:       Array<{
 66:         table_name: string;
 67:         row_count: bigint;
 68:         table_size: string;
 69:         index_size: string;
 70:         total_size: string;
 71:       }>
 72:     >`
 73:       SELECT
 74:         schemaname || '.' || tablename AS table_name,
 75:         n_live_tup AS row_count,
 76:         pg_size_pretty(pg_total_relation_size(schemaname || '.' || tablename)) AS total_size,
 77:         pg_size_pretty(pg_relation_size(schemaname || '.' || tablename)) AS table_size,
 78:         pg_size_pretty(pg_total_relation_size(schemaname || '.' || tablename) - pg_relation_size(schemaname || '.' || tablename)) AS index_size
 79:       FROM pg_stat_user_tables
 80:       WHERE tablename = ${tableName}
 81:     `;
 82:     if (stats.length === 0) {
 83:       throw new Error(`Table ${tableName} not found`);
 84:     }
 85:     return {
 86:       rowCount: stats[0].row_count,
 87:       tableSize: stats[0].table_size,
 88:       indexSize: stats[0].index_size,
 89:       totalSize: stats[0].total_size,
 90:     };
 91:   }
 92:   async findMissingIndexes(): Promise<
 93:     Array<{
 94:       table: string;
 95:       column: string;
 96:       seqScans: bigint;
 97:       seqTuples: bigint;
 98:       indexScans: bigint;
 99:       suggestion: string;
100:     }>
101:   > {
102:     const results = await this.prisma.$queryRaw<
103:       Array<{
104:         schemaname: string;
105:         tablename: string;
106:         attname: string;
107:         seq_scan: bigint;
108:         seq_tup_read: bigint;
109:         idx_scan: bigint | null;
110:         suggestion: string;
111:       }>
112:     >`
113:       SELECT
114:         schemaname,
115:         tablename,
116:         attname,
117:         seq_scan,
118:         seq_tup_read,
119:         idx_scan,
120:         CASE
121:           WHEN seq_scan > 100 AND (idx_scan IS NULL OR idx_scan < seq_scan / 10)
122:           THEN 'Consider adding index on ' || schemaname || '.' || tablename || '(' || attname || ')'
123:           ELSE 'Index exists or not needed'
124:         END AS suggestion
125:       FROM pg_stat_user_tables st
126:       JOIN pg_attribute a ON a.attrelid = st.relid
127:       WHERE schemaname NOT IN ('pg_catalog', 'information_schema')
128:         AND a.attnum > 0
129:         AND NOT a.attisdropped
130:         AND seq_scan > 100
131:       ORDER BY seq_scan DESC, seq_tup_read DESC
132:       LIMIT 20
133:     `;
134:     return results.map((r) => ({
135:       table: `${r.schemaname}.${r.tablename}`,
136:       column: r.attname,
137:       seqScans: r.seq_scan,
138:       seqTuples: r.seq_tup_read,
139:       indexScans: r.idx_scan || BigInt(0),
140:       suggestion: r.suggestion,
141:     }));
142:   }
143:   async getSlowQueries(limit: number = 10): Promise<
144:     Array<{
145:       query: string;
146:       calls: bigint;
147:       totalTime: number;
148:       meanTime: number;
149:       maxTime: number;
150:     }>
151:   > {
152:     try {
153:       const results = await this.prisma.$queryRaw<
154:         Array<{
155:           query: string;
156:           calls: bigint;
157:           total_exec_time: number;
158:           mean_exec_time: number;
159:           max_exec_time: number;
160:         }>
161:       >`
162:         SELECT
163:           query,
164:           calls,
165:           total_exec_time,
166:           mean_exec_time,
167:           max_exec_time
168:         FROM pg_stat_statements
169:         WHERE query NOT LIKE '%pg_stat_statements%'
170:         ORDER BY mean_exec_time DESC
171:         LIMIT ${limit}
172:       `;
173:       return results.map((r) => ({
174:         query: r.query,
175:         calls: r.calls,
176:         totalTime: r.total_exec_time,
177:         meanTime: r.mean_exec_time,
178:         maxTime: r.max_exec_time,
179:       }));
180:     } catch (error) {
181:       console.warn(
182:         "pg_stat_statements extension not available. Install it to track slow queries."
183:       );
184:       return [];
185:     }
186:   }
187:   async getConnectionStats(): Promise<{
188:     totalConnections: number;
189:     activeConnections: number;
190:     idleConnections: number;
191:     maxConnections: number;
192:   }> {
193:     const results = await this.prisma.$queryRaw<
194:       Array<{
195:         total: bigint;
196:         active: bigint;
197:         idle: bigint;
198:         max_conn: number;
199:       }>
200:     >`
201:       SELECT
202:         COUNT(*) as total,
203:         COUNT(*) FILTER (WHERE state = 'active') as active,
204:         COUNT(*) FILTER (WHERE state = 'idle') as idle,
205:         (SELECT setting::int FROM pg_settings WHERE name = 'max_connections') as max_conn
206:       FROM pg_stat_activity
207:       WHERE datname = current_database()
208:     `;
209:     return {
210:       totalConnections: Number(results[0].total),
211:       activeConnections: Number(results[0].active),
212:       idleConnections: Number(results[0].idle),
