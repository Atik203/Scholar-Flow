<file path="apps/backend/src/app/modules/Reports/report.service.ts">
  1: import { Prisma } from "../../shared/prisma";
  2: import prisma from "../../shared/prisma";
  3: import ApiError from "../../errors/ApiError";
  4: const MAX_ROWS = 10000;
  5: export type ReportRow = Record<string, string | number | boolean | null>;
  6: const buildCsv = (rows: ReportRow[]): string => {
  7:   if (rows.length === 0) return "";
  8:   const headers = Object.keys(rows[0]);
  9:   const escape = (v: unknown) => {
 10:     if (v === null || v === undefined) return "";
 11:     let s = String(v);
 12:     // Neutralize CSV formula injection: cells starting with = + - @
 13:     // execute as formulas when the export is opened in Excel.
 14:     if (/^[=+\-@]/.test(s)) {
 15:       s = `'${s}`;
 16:     }
 17:     if (s.includes(",") || s.includes('"') || s.includes("\n")) {
 18:       return `"${s.replace(/"/g, '""')}"`;
 19:     }
 20:     return s;
 21:   };
 22:   const lines: string[] = [];
 23:   lines.push(headers.join(","));
 24:   for (const row of rows) {
 25:     lines.push(headers.map((h) => escape(row[h])).join(","));
 26:   }
 27:   return lines.join("\n");
 28: };
 29: const formatBytes = (n: number): string => {
 30:   if (n < 1024) return `${n} B`;
 31:   if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
 32:   return `${(n / (1024 * 1024)).toFixed(2)} MB`;
 33: };
 34: export const reportService = {
 35:   async listReports(params: {
 36:     type?: "USAGE" | "FINANCIAL" | "USER" | "CONTENT" | "SYSTEM";
 37:     status?: "READY" | "GENERATING" | "SCHEDULED" | "FAILED";
 38:     enabled?: boolean;
 39:     search?: string;
 40:     page: number;
 41:     limit: number;
 42:   }) {
 43:     const where: Prisma.AdminReportWhereInput = { isDeleted: false };
 44:     if (params.type) where.type = params.type;
 45:     if (params.status) where.status = params.status;
 46:     if (params.enabled !== undefined) where.enabled = params.enabled;
 47:     if (params.search) {
 48:       where.OR = [
 49:         { name: { contains: params.search, mode: "insensitive" } },
 50:         { description: { contains: params.search, mode: "insensitive" } },
 51:       ];
 52:     }
 53:     const [total, items] = await Promise.all([
 54:       prisma.adminReport.count({ where }),
