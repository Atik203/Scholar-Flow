 56:       mrrData.length > 0 ? parseFloat(mrrData[0].totalMrr || "0") * 12 : 0;
 57:     const mrr = mrrData.length > 0 ? parseFloat(mrrData[0].totalMrr || "0") : 0;
 58:     const revenueData = await prisma.$queryRaw<
 59:       Array<{ totalRevenue: string; currency: string }>
 60:     >`
