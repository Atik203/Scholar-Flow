1548:       201
1549:     );
1550:   }),
1551:   // Remove paper from collection
1552:   removePaper: catchAsync(async (req: Request, res: Response) => {
1553:     const authReq = req as AuthenticatedRequest;
1554:     if (!authReq.user?.id) {
1555:       throw new ApiError(401, "Authentication required");
1556:     }
1557:     const { collectionId, paperId } = req.params;
1558:     const userId = authReq.user.id;
1559:     // Check if collection exists
1560:     const collectionRows = await prisma.$queryRaw<Array<{ id: string }>>`
1561:       SELECT id
1562:       FROM "Collection"
1563:       WHERE id = ${collectionId}
1564:         AND "isDeleted" = false
