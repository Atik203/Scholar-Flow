  1: import {
  2:   showErrorToast,
  3:   showSuccessToast,
  4: } from "@/components/providers/ToastProvider";
  5: import { Button } from "@/components/ui/button";
  6: import {
  7:   Popover,
  8:   PopoverContent,
  9:   PopoverTrigger,
 10: } from "@/components/ui/popover";
 11: import { NodeViewWrapper, ReactNodeViewRenderer } from "@tiptap/react";
 12: import {
 13:   AlignCenter,
 14:   AlignLeft,
 15:   AlignRight,
 16:   Copy,
 17:   Move,
 18:   Trash2,
 19: } from "lucide-react";
 20: import React, {
 21:   useCallback,
 22:   useEffect,
 23:   useMemo,
 24:   useRef,
 25:   useState,
 26: } from "react";
 27: import {
 28:   ResizableImage,
 29:   ResizableImageComponent,
 30:   ResizableImageNodeViewRendererProps,
 31: } from "tiptap-extension-resizable-image";
 32: const NodeView = (props: ResizableImageNodeViewRendererProps) => {
 33:   const editor = props.editor;
 34:   const [isDragging, setIsDragging] = useState(false);
 35:   const [dragStart, setDragStart] = useState({ x: 0, y: 0 });
 36:   const dataPosX = props.node.attrs["data-position-x"] as
 37:     | number
 38:     | string
 39:     | undefined;
 40:   const dataPosY = props.node.attrs["data-position-y"] as
 41:     | number
 42:     | string
 43:     | undefined;
 44:   const position = useMemo(
 45:     () => ({
 46:       x: Number(dataPosX ?? 0) || 0,
 47:       y: Number(dataPosY ?? 0) || 0,
 48:     }),
 49:     [dataPosX, dataPosY]
 50:   );
 51:   const containerRef = useRef<HTMLDivElement>(null);
 52:   const setTextAlign = useCallback(
 53:     (textAlign: string) => {
 54:       requestAnimationFrame(() => {
 55:         editor.chain().focus().setTextAlign(textAlign).run();
 56:       });
 57:     },
 58:     [editor]
 59:   );
 60:   const copyImageUrl = useCallback(async () => {
 61:     try {
 62:       await navigator.clipboard.writeText(props.node.attrs.src);
 63:       showSuccessToast("Image URL copied to clipboard");
 64:     } catch (error) {
 65:       showErrorToast("Failed to copy image URL");
 66:     }
 67:   }, [props.node.attrs.src]);
 68:   const deleteImage = useCallback(() => {
 69:     requestAnimationFrame(() => {
 70:       editor.chain().focus().deleteSelection().run();
 71:     });
 72:   }, [editor]);
 73:   const updatePosition = useCallback(
 74:     (newPosition: { x: number; y: number }) => {
 75:       requestAnimationFrame(() => {
 76:         const { getPos } = props;
 77:         if (typeof getPos === "function") {
 78:           const pos = getPos();
 79:           if (typeof pos === "number") {
 80:             editor
 81:               .chain()
 82:               .focus()
 83:               .command(({ tr }) => {
 84:                 tr.setNodeMarkup(pos, undefined, {
 85:                   ...props.node.attrs,
 86:                   "data-position-x": newPosition.x,
 87:                   "data-position-y": newPosition.y,
 88:                 });
 89:                 return true;
 90:               })
 91:               .run();
 92:           }
 93:         }
 94:       });
 95:     },
 96:     [editor, props]
 97:   );
 98:   const resetPosition = useCallback(() => {
 99:     updatePosition({ x: 0, y: 0 });
100:   }, [updatePosition]);
101:   const handleDragStart = useCallback(
102:     (e: React.MouseEvent) => {
103:       if (e.target !== e.currentTarget) return;
104:       e.preventDefault();
105:       setIsDragging(true);
106:       setDragStart({
107:         x: e.clientX - position.x,
108:         y: e.clientY - position.y,
109:       });
110:     },
111:     [position]
112:   );
113:   const handleDrag = useCallback(
114:     (e: MouseEvent) => {
115:       if (!isDragging) return;
116:       const newPosition = {
117:         x: e.clientX - dragStart.x,
118:         y: e.clientY - dragStart.y,
119:       };
120:       const maxX = window.innerWidth - 200;
121:       const maxY = window.innerHeight - 200;
122:       const constrainedPosition = {
123:         x: Math.max(0, Math.min(newPosition.x, maxX)),
124:         y: Math.max(0, Math.min(newPosition.y, maxY)),
125:       };
126:       updatePosition(constrainedPosition);
127:     },
128:     [isDragging, dragStart, updatePosition]
129:   );
130:   const handleDragEnd = useCallback(() => {
131:     setIsDragging(false);
132:   }, []);
133:   useEffect(() => {
134:     if (isDragging) {
135:       document.addEventListener("mousemove", handleDrag);
136:       document.addEventListener("mouseup", handleDragEnd);
137:       return () => {
138:         document.removeEventListener("mousemove", handleDrag);
139:         document.removeEventListener("mouseup", handleDragEnd);
140:       };
141:     }
142:   }, [isDragging, handleDrag, handleDragEnd]);
143:   return (
144:     <NodeViewWrapper
145:       className={`image-component ${isDragging ? "dragging" : ""}`}
146:       data-drag-handle
147:       ref={containerRef}
148:       style={{
149:         transform: `translate(${position.x}px, ${position.y}px)`,
150:         transition: isDragging ? "none" : "transform 0.2s ease",
151:         position: isDragging ? "relative" : "static",
152:         zIndex: isDragging ? 1000 : "auto",
153:       }}
154:     >
155:       <Popover>
156:         <PopoverTrigger asChild>
157:           <div
158:             style={{
159:               display: "inline-flex",
160:               cursor: "pointer",
161:               position: "relative",
162:             }}
163:           >
164:             {}
165:             <div
166:               className="drag-handle"
167:               onMouseDown={handleDragStart}
168:               style={{
169:                 position: "absolute",
170:                 top: "4px",
171:                 left: "4px",
172:                 background: "rgba(59, 130, 246, 0.9)",
173:                 color: "white",
174:                 borderRadius: "4px",
175:                 padding: "4px",
176:                 cursor: "move",
177:                 zIndex: 10,
178:                 opacity: 0.7,
179:                 transition: "opacity 0.2s ease",
180:               }}
181:               onMouseEnter={(e) => (e.currentTarget.style.opacity = "1")}
182:               onMouseLeave={(e) => (e.currentTarget.style.opacity = "0.7")}
183:               title="Drag to move image"
184:             >
185:               <Move className="h-3 w-3" />
186:             </div>
187:             <ResizableImageComponent {...props} />
188:           </div>
189:         </PopoverTrigger>
190:         <PopoverContent className="w-auto p-2" side="bottom" align="center">
191:           <div className="flex flex-col gap-2">
192:             {}
193:             <div className="flex items-center gap-1">
194:               <span className="text-sm text-gray-600 mr-2">Align:</span>
195:               <Button
196:                 variant="outline"
197:                 size="sm"
198:                 onClick={() => setTextAlign("left")}
199:                 className="h-8 w-8 p-0"
200:                 title="Align Left"
201:               >
202:                 <AlignLeft className="h-4 w-4" />
203:               </Button>
204:               <Button
205:                 variant="outline"
206:                 size="sm"
207:                 onClick={() => setTextAlign("center")}
208:                 className="h-8 w-8 p-0"
209:                 title="Align Center"
210:               >
211:                 <AlignCenter className="h-4 w-4" />
212:               </Button>
213:               <Button
214:                 variant="outline"
215:                 size="sm"
216:                 onClick={() => setTextAlign("right")}
217:                 className="h-8 w-8 p-0"
218:                 title="Align Right"
219:               >
220:                 <AlignRight className="h-4 w-4" />
221:               </Button>
222:             </div>
223:             {}
224:             <div className="flex items-center gap-1 pt-2 border-t">
225:               <Button
226:                 variant="outline"
227:                 size="sm"
228:                 onClick={copyImageUrl}
229:                 className="flex items-center gap-2 text-xs"
230:               >
231:                 <Copy className="h-3 w-3" />
232:                 Copy URL
233:               </Button>
234:               <Button
235:                 variant="destructive"
236:                 size="sm"
237:                 onClick={deleteImage}
238:                 className="flex items-center gap-2 text-xs"
239:               >
240:                 <Trash2 className="h-3 w-3" />
241:                 Delete
242:               </Button>
243:             </div>
244:             {}
245:             <div className="flex items-center gap-1 pt-2 border-t">
246:               <Button
247:                 variant="outline"
248:                 size="sm"
249:                 onClick={resetPosition}
250:                 className="flex items-center gap-2 text-xs"
251:               >
252:                 <Move className="h-3 w-3" />
253:                 Reset Position
254:               </Button>
255:             </div>
256:           </div>
257:         </PopoverContent>
258:       </Popover>
259:     </NodeViewWrapper>
260:   );
261: };
262: export const ResizableImageWithPopover = ResizableImage.extend({
263:   addAttributes() {
264:     return {
265:       ...this.parent?.(),
266:       "data-position-x": {
267:         default: 0,
268:         parseHTML: (element) =>
269:           parseFloat(element.getAttribute("data-position-x") || "0"),
270:         renderHTML: (attributes) => {
271:           return {
272:             "data-position-x": attributes["data-position-x"],
273:           };
274:         },
275:       },
276:       "data-position-y": {
277:         default: 0,
278:         parseHTML: (element) =>
279:           parseFloat(element.getAttribute("data-position-y") || "0"),
280:         renderHTML: (attributes) => {
281:           return {
282:             "data-position-y": attributes["data-position-y"],
283:           };
284:         },
285:       },
286:     };
287:   },
288:   addNodeView() {
289:     return ReactNodeViewRenderer((props) =>
290:       NodeView(props as unknown as ResizableImageNodeViewRendererProps)
291:     );
292:   },
293: });
