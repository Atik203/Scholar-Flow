<file path="apps/frontend/src/components/providers/BrowserCleanup.tsx">
 1: "use client";
 2: import { usePathname } from "next/navigation";
 3: import { useEffect } from "react";
 4: export function BrowserCleanup() {
 5:   const pathname = usePathname();
 6:   useEffect(() => {
 7:     if (typeof window === "undefined") return;
 8:     const authPages = ["/login", "/register", "/auth"];
 9:     const isAuthPage = authPages.some((page) => pathname?.startsWith(page));
10:     if (isAuthPage) {
11:       console.log("[BrowserCleanup] Skipping cleanup on auth page:", pathname);
12:       return;
13:     }
14:     const timeoutId = setTimeout(() => {
15:       try {
16:         const cookiesToCheck = [
17:           "next-auth.session-token",
18:           "__Secure-next-auth.session-token",
19:           "next-auth.callback-url",
20:           "__Secure-next-auth.callback-url",
21:           "next-auth.csrf-token",
22:           "__Host-next-auth.csrf-token",
23:         ];
24:         document.cookie.split(";").forEach((cookie) => {
25:           const [name] = cookie.split("=");
26:           const trimmedName = name.trim();
27:           if (
28:             trimmedName.includes("next-auth") ||
29:             trimmedName.includes("__Secure-next-auth") ||
30:             trimmedName.includes("__Host-next-auth")
31:           ) {
32:             const cookieValue = document.cookie
33:               .split("; ")
34:               .find((row) => row.startsWith(`${trimmedName}=`))
35:               ?.split("=")[1];
36:             if (
37:               !cookieValue ||
38:               cookieValue === "undefined" ||
39:               cookieValue === "null"
40:             ) {
41:               const deletionStrings = [
42:                 `${trimmedName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`,
43:                 `${trimmedName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; secure;`,
44:                 `${trimmedName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${window.location.hostname};`,
45:               ];
46:               deletionStrings.forEach((str) => (document.cookie = str));
47:             }
48:           }
49:         });
50:         const keysToCheck = [
51:           "auth-token",
52:           "user-data",
53:           "session-data",
54:           "access-token",
55:           "refresh-token",
56:         ];
57:         keysToCheck.forEach((key) => {
58:           if (localStorage.getItem(key)) {
59:             localStorage.removeItem(key);
60:             console.log(
61:               `[BrowserCleanup] Removed orphaned localStorage key: ${key}`
62:             );
63:           }
64:         });
65:         keysToCheck.forEach((key) => {
66:           if (sessionStorage.getItem(key)) {
67:             sessionStorage.removeItem(key);
68:             console.log(
69:               `[BrowserCleanup] Removed orphaned sessionStorage key: ${key}`
70:             );
71:           }
72:         });
73:       } catch (error) {
74:         if (process.env.NODE_ENV === "development") {
75:           console.error("[BrowserCleanup] Error during cleanup:", error);
76:         }
77:       }
78:     }, 1000);
79:     return () => clearTimeout(timeoutId);
80:   }, [pathname]);
81:   return null;
82: }
</file>

