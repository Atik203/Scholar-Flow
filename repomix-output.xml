250: model Paper {
251:   id          String  @id @default(uuid())
252:   workspaceId String
253:   uploaderId  String
254:   title       String
255:   abstract    String?
256:   metadata    Json    @db.JsonB
257:   source      String? // 'upload' | 'arxiv' | 'openalex' | 'doi' | 'semantic-scholar' | 'editor'
258:   doi         String? @unique
259: 
260:   // Editor-specific fields
261:   isDraft     Boolean @default(false) // True for draft papers created in editor
262:   isPublished Boolean @default(false) // True when draft is published/finalized
263: 
264:   // Processing lifecycle fields
265:   processingStatus PaperProcessingStatus @default(UPLOADED)
266:   processingError  String?
267:   processedAt      DateTime?
268: 
269:   // Document preview support - for enhanced text extraction view
