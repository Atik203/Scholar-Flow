139:   private chunkText(
140:     text: string,
141:     pageCount: number
142:   ): Array<{
143:     idx: number;
144:     page?: number;
145:     content: string;
146:     tokenCount?: number;
147:   }> {
148:     const chunks: Array<{
149:       idx: number;
150:       page?: number;
151:       content: string;
152:       tokenCount?: number;
153:     }> = [];
154:     if (!text) {
155:       return [];
156:     }
157:     const safePages = Math.max(1, Number.isFinite(pageCount) ? pageCount : 1);
158:     const textPerPage = Math.ceil(text.length / safePages);
159:     const pages = [];
160:     for (let i = 0; i < safePages; i++) {
161:       const start = i * textPerPage;
162:       const end = Math.min(start + textPerPage, text.length);
163:       pages.push(text.slice(start, end));
164:     }
165:     let chunkIndex = 0;
166:     pages.forEach((pageText, pageIndex) => {
167:       const maxChunkSize = 2000;
168:       const pageChunks = this.splitIntoChunks(pageText, maxChunkSize);
169:       pageChunks.forEach((chunkText) => {
170:         const sanitized = this.sanitizeText(chunkText);
171:         if (sanitized.length > 0) {
172:           chunks.push({
173:             idx: chunkIndex++,
174:             page: pageIndex + 1,
175:             content: sanitized,
176:             tokenCount: this.estimateTokenCount(sanitized),
177:           });
178:         }
179:       });
180:     });
181:     return chunks;
182:   }
183:   private splitIntoChunks(text: string, maxSize: number): string[] {
184:     const chunks: string[] = [];
185:     let currentChunk = "";
186:     const sentences = text.split(/[.!?]+/);
187:     for (const sentence of sentences) {
188:       if (
189:         currentChunk.length + sentence.length > maxSize &&
190:         currentChunk.length > 0
191:       ) {
192:         chunks.push(currentChunk.trim());
193:         currentChunk = sentence;
194:       } else {
195:         currentChunk += sentence + ".";
196:       }
197:     }
198:     if (currentChunk.trim().length > 0) {
199:       chunks.push(currentChunk.trim());
200:     }
201:     return chunks;
202:   }
203:   /**
204:    * Estimate token count (rough approximation)
205:    */
206:   private estimateTokenCount(text: string): number {
207:     // Rough estimation: 1 token ≈ 4 characters
208:     return Math.ceil(text.length / 4);
209:   }
210:   /**
211:    * Extract abstract from the beginning of the text
212:    */
213:   private extractAbstract(text: string): string {
214:     // Look for common abstract patterns
215:     const abstractPatterns = [
216:       /abstract\s*:?\s*(.+?)(?:\n\n|\n\s*\n|introduction|1\.|background)/is,
217:       /summary\s*:?\s*(.+?)(?:\n\n|\n\s*\n|introduction|1\.|background)/is,
218:       /overview\s*:?\s*(.+?)(?:\n\n|\n\s*\n|introduction|1\.|background)/is,
219:     ];
220:     for (const pattern of abstractPatterns) {
221:       const match = text.match(pattern);
222:       if (match && match[1]) {
223:         const abstract = match[1].trim();
224:         // Limit abstract length
225:         return abstract.length > 500
226:           ? abstract.substring(0, 500) + "..."
227:           : abstract;
228:       }
229:     }
230:     // Fallback: take first paragraph
231:     const firstParagraph = text.split("\n\n")[0];
232:     if (firstParagraph && firstParagraph.length > 50) {
233:       return firstParagraph.length > 500
234:         ? firstParagraph.substring(0, 500) + "..."
235:         : firstParagraph;
236:     }
237:     return "";
238:   }
239:   /**
240:    * Sanitize text content to remove null bytes and other problematic characters
241:    */
242:   private sanitizeText(text: string): string {
243:     if (!text) return "";
244:     // Fast path: replace explicit null bytes first
245:     let cleaned = text.replace(/\0/g, "");
246:     // Filter out remaining problematic code points while preserving common whitespace
247:     const builder: string[] = [];
248:     for (const ch of cleaned) {
249:       const code = ch.codePointAt(0)!;
250:       // Remove C0 controls except tab (9), LF (10), CR (13)
251:       if (code < 32 && code !== 9 && code !== 10 && code !== 13) continue;
252:       // Delete DEL
253:       if (code === 127) continue;
254:       // Remove surrogate halves (invalid in UTF-8/UTF-32 strings)
255:       if (code >= 0xd800 && code <= 0xdfff) continue;
256:       // Remove non-characters U+FFFE, U+FFFF
257:       if (code === 0xfffe || code === 0xffff) continue;
258:       builder.push(ch);
259:     }
260:     cleaned = builder.join("");
261:     return cleaned.trim();
262:   }
263:   /**
264:    * Store chunks in database
265:    */
266:   private async storeChunks(
267:     paperId: string,
268:     chunks: Array<{
269:       idx: number;
270:       page?: number;
271:       content: string;
272:       tokenCount?: number;
273:     }>
274:   ): Promise<void> {
275:     // Delete existing chunks first
276:     await prisma.paperChunk.deleteMany({
277:       where: { paperId },
278:     });
279:     // Insert new chunks with sanitized content
280:     const prepared = chunks
281:       .map((chunk) => ({
282:         paperId,
283:         idx: chunk.idx,
284:         page: chunk.page,
285:         content: this.sanitizeText(chunk.content),
286:         tokenCount: chunk.tokenCount,
287:       }))
288:       .filter((c) => c.content && c.content.length > 0);
289:     if (prepared.length > 0) {
290:       await prisma.paperChunk.createMany({ data: prepared });
291:     }
292:   }
293:   /**
294:    * Process all unprocessed papers
295:    */
296:   async processUnprocessedPapers(): Promise<void> {
297:     const unprocessedPapers = await prisma.paper.findMany({
298:       where: {
299:         processingStatus: "UPLOADED",
300:         isDeleted: false,
301:       },
302:       include: { file: true },
303:     });
304:     console.log(`Found ${unprocessedPapers.length} unprocessed papers`);
305:     for (const paper of unprocessedPapers) {
306:       if (paper.file) {
307:         console.log(`Processing paper: ${paper.title}`);
308:         await this.extractTextFromPDF(paper.id);
309:       }
310:     }
311:   }
312: }
