124:           </div>
125:         </DialogHeader>
126:         <div className="space-y-4 py-4">
127:           {}
128:           {annotation.anchor.selectedText && (
129:             <>
130:               <div>
131:                 <label className="text-sm font-medium text-gray-700 mb-2 block">
