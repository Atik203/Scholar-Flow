 11: } from "./ai.types";
 12: const DEFAULT_MAX_CHARS = 12000;
 13: export abstract class BaseAiProvider implements AiProvider {
 14:   readonly name: ProviderName;
 15:   protected readonly apiKey?: string;
 16:   protected readonly requestTimeoutMs: number;
 17:   constructor(
 18:     name: ProviderName,
 19:     apiKey: string | undefined,
 20:     requestTimeoutMs: number
 21:   ) {
 22:     this.name = name;
 23:     this.apiKey = apiKey;
 24:     this.requestTimeoutMs = requestTimeoutMs;
 25:   }
 26:   isEnabled(): boolean {
 27:     return Boolean(this.apiKey);
 28:   }
 29:   async extractMetadata(
 30:     input: AiMetadataExtractionInput
 31:   ): Promise<AiMetadataExtractionResult | null> {
 32:     if (!this.isEnabled()) {
 33:       return null;
 34:     }
 35:     try {
 36:       const sanitizedText = this.sanitizeText(input.text);
 37:       const effectiveInput: AiMetadataExtractionInput = {
 38:         ...input,
 39:         text: sanitizedText,
 40:         timeoutMs: input.timeoutMs || this.requestTimeoutMs,
 41:       };
 42:       return await this.performExtraction(effectiveInput);
 43:     } catch (error) {
 44:       if (error instanceof AiError) {
 45:         throw error;
 46:       }
 47:       throw new AiError(
 48:         502,
 49:         `${this.name} metadata extraction failed`,
 50:         "AI_PROVIDER_ERROR",
 51:         error instanceof Error ? error.stack : undefined
 52:       );
 53:     }
 54:   }
 55:   async generateSummary(
 56:     input: AiSummaryRequest
 57:   ): Promise<AiSummaryResult | null> {
 58:     if (!this.isEnabled()) {
 59:       return null;
 60:     }
 61:     try {
 62:       const sanitizedText = this.sanitizeText(input.text);
 63:       const effectiveInput: AiSummaryRequest = {
 64:         ...input,
 65:         text: sanitizedText,
 66:         timeoutMs: input.timeoutMs || this.requestTimeoutMs,
 67:         wordLimit: input.wordLimit ?? 220,
 68:       };
 69:       return await this.performSummary(effectiveInput);
 70:     } catch (error) {
 71:       if (error instanceof AiError) {
 72:         throw error;
 73:       }
 74:       throw new AiError(
 75:         502,
 76:         `${this.name} summary generation failed`,
 77:         "AI_PROVIDER_ERROR",
 78:         error instanceof Error ? error.stack : undefined
 79:       );
 80:     }
 81:   }
 82:   async generateInsights(
 83:     input: AiInsightRequest
 84:   ): Promise<AiInsightResult | null> {
 85:     if (!this.isEnabled() || !this.performInsight) {
 86:       return null;
 87:     }
 88:     try {
 89:       const sanitizedContext = this.sanitizeText(input.context);
 90:       const effectiveInput: AiInsightRequest = {
 91:         ...input,
 92:         context: sanitizedContext,
 93:         history: input.history ?? [],
 94:         timeoutMs: input.timeoutMs || this.requestTimeoutMs,
 95:       };
 96:       return await this.performInsight(effectiveInput);
 97:     } catch (error) {
 98:       if (error instanceof AiError) {
 99:         throw error;
100:       }
101:       throw new AiError(
102:         502,
103:         `${this.name} insight generation failed`,
104:         "AI_PROVIDER_ERROR",
105:         error instanceof Error ? error.stack : undefined
106:       );
107:     }
108:   }
109:   protected sanitizeText(text: string): string {
110:     if (!text) {
111:       return "";
112:     }
113:     const trimmed = text.trim();
114:     return trimmed.length > DEFAULT_MAX_CHARS
115:       ? `${trimmed.slice(0, DEFAULT_MAX_CHARS)}\n...`
116:       : trimmed;
117:   }
118:   protected abstract performExtraction(
119:     input: AiMetadataExtractionInput
120:   ): Promise<AiMetadataExtractionResult>;
121:   protected abstract performSummary(
122:     input: AiSummaryRequest
123:   ): Promise<AiSummaryResult>;
124:   protected performInsight?(input: AiInsightRequest): Promise<AiInsightResult>;
125: }
