798:   static async getMyDiscussions(
799:     req: AuthRequest,
800:     filters: {
801:       isResolved?: boolean;
802:       isPinned?: boolean;
803:       scope?: 'all' | 'general' | 'workspace' | 'paper' | 'collection';
804:       search?: string;
805:       tags?: string[];
806:       limit?: number;
807:       offset?: number;
808:     }
809:   ): Promise<{ threads: any[]; total: number }> {
810:     const userId = req.user?.id;
811:     if (!userId) throw new ApiError(401, 'User not authenticated');
812:     try {
813:       const myWorkspaces = await prisma.workspaceMember.findMany({
814:         where: { userId, isDeleted: false },
815:         select: { workspaceId: true }
816:       });
817:       const workspaceIds = myWorkspaces.map((m) => m.workspaceId);
818:       const where: any = {
819:         isDeleted: false,
820:         OR: [
821:           { userId },
822:           { workspaceId: { in: workspaceIds } }
823:         ]
824:       };
825:       if (filters.isResolved !== undefined) {
826:         where.isResolved = filters.isResolved;
827:       }
828:       if (filters.isPinned !== undefined) {
829:         where.isPinned = filters.isPinned;
830:       }
831:       if (filters.search) {
832:         where.OR = [
833:           { userId, title: { contains: filters.search, mode: 'insensitive' } },
834:           {
835:             userId,
836:             content: { contains: filters.search, mode: 'insensitive' }
837:           },
838:           {
839:             workspaceId: { in: workspaceIds },
840:             title: { contains: filters.search, mode: 'insensitive' }
841:           },
842:           {
843:             workspaceId: { in: workspaceIds },
844:             content: { contains: filters.search, mode: 'insensitive' }
845:           }
846:         ];
847:       }
848:       if (filters.tags && filters.tags.length > 0) {
849:         where.tags = { hasSome: filters.tags };
850:       }
851:       if (filters.scope) {
852:         switch (filters.scope) {
853:           case 'general':
854:             where.AND = [
855:               { paperId: null },
856:               { collectionId: null },
857:               { workspaceId: null }
858:             ];
859:             break;
860:           case 'workspace':
861:             where.workspaceId = { not: null };
862:             break;
863:           case 'paper':
864:             where.paperId = { not: null };
865:             break;
866:           case 'collection':
867:             where.collectionId = { not: null };
868:             break;
869:         }
870:       }
871:       const limit = filters.limit ?? 20;
872:       const offset = filters.offset ?? 0;
873:       const [threads, total] = await Promise.all([
874:         prisma.discussionThread.findMany({
875:           where,
876:           orderBy: [{ isPinned: 'desc' }, { updatedAt: 'desc' }],
877:           skip: offset,
878:           take: limit,
879:           include: {
880:             user: {
881:               select: {
882:                 id: true,
883:                 name: true,
884:                 firstName: true,
885:                 lastName: true,
886:                 image: true
887:               }
888:             },
889:             paper: { select: { id: true, title: true } },
890:             collection: { select: { id: true, name: true } },
891:             workspace: { select: { id: true, name: true } },
892:             messages: {
893:               orderBy: { createdAt: 'desc' },
894:               take: 1,
895:               select: {
896:                 id: true,
897:                 content: true,
898:                 createdAt: true,
899:                 user: {
900:                   select: {
901:                     id: true,
902:                     name: true,
903:                     firstName: true,
904:                     lastName: true
905:                   }
906:                 }
907:               }
908:             },
909:             _count: { select: { messages: true } }
910:           }
911:         }),
912:         prisma.discussionThread.count({ where })
913:       ]);
914:       return {
915:         threads: threads.map((t) => ({
916:           ...t,
917:           lastReply: t.messages[0] ?? null
918:         })),
919:         total
920:       };
921:     } catch (error) {
922:       if (error instanceof ApiError) throw error;
923:       throw new ApiError(500, 'Failed to fetch personal discussions');
924:     }
