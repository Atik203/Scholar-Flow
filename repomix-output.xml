67:     document.addEventListener("visibilitychange", handleVisibilityChange);
68:     window.addEventListener("focus", handleFocus);
69:     const intervalRef = returnCheckIntervalRef.current;
70:     return () => {
71:       document.removeEventListener("visibilitychange", handleVisibilityChange);
72:       window.removeEventListener("focus", handleFocus);
73:       if (intervalRef) {
74:         clearInterval(intervalRef);
75:       }
76:     };
77:   }, [dispatch]);
78:   return (
79:     <Button
80:       onClick={handleManageSubscription}
81:       disabled={isLoading}
82:       className={className}
83:       variant={variant}
84:     >
85:       {isLoading ? (
86:         <>
87:           <Loader2 className="mr-2 h-4 w-4 animate-spin" />
88:           Loading...
89:         </>
90:       ) : (
91:         "Manage Subscription"
92:       )}
93:     </Button>
94:   );
95: }
</file>

