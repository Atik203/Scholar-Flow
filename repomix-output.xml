  7: export function getCallbackUrl(
  8:   searchParams?: URLSearchParams,
  9:   defaultUrl: string = "/dashboard"
 10: ): string {
 11:   if (typeof window === "undefined") return defaultUrl;
 12:   if (searchParams) {
 13:     const callbackUrl = searchParams.get("callbackUrl");
 14:     if (callbackUrl) {
 15:       return validateCallbackUrl(callbackUrl, defaultUrl);
 16:     }
 17:   }
 18:   const urlParams = new URLSearchParams(window.location.search);
 19:   const callbackUrl = urlParams.get("callbackUrl");
 20:   if (callbackUrl) {
 21:     return validateCallbackUrl(callbackUrl, defaultUrl);
 22:   }
 23:   return defaultUrl;
 24: }
 25: export function validateCallbackUrl(
 26:   url: string,
 27:   fallback: string = "/dashboard"
 28: ): string {
 29:   try {
 30:     if (url.startsWith("/")) {
 31:       const allowedPaths = [
 32:         "/dashboard",
 33:         "/dashboard/researcher",
 34:         "/dashboard/pro-researcher",
 35:         "/dashboard/team-lead",
 36:         "/dashboard/admin",
 37:         "/profile",
 38:         "/papers",
 39:         "/collections",
 40:         "/collaborate",
 41:         "/settings",
 42:       ];
 43:       const isAllowed = allowedPaths.some(
 44:         (path) => url === path || url.startsWith(path + "/")
 45:       );
 46:       return isAllowed ? url : fallback;
 47:     }
 48:     const parsedUrl = new URL(url);
 49:     const currentOrigin = window.location.origin;
 50:     if (parsedUrl.origin === currentOrigin) {
 51:       return validateCallbackUrl(parsedUrl.pathname, fallback);
 52:     }
 53:     return fallback;
 54:   } catch {
 55:     return fallback;
 56:   }
 57: }
 58: export function buildLoginUrl(callbackUrl?: string): string {
 59:   const loginUrl = new URL("/login", window.location.origin);
