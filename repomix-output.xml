 23:   const { user: reduxAuthUser, accessToken, status } = useAuth();
 24:   const [diagnostics, setDiagnostics] = useState<DiagnosticData | null>(null);
 25:   const [autoRefresh, setAutoRefresh] = useState(false);
 26:   const collectDiagnostics = useCallback(async () => {
 27:     let serverHasSession = null;
 28:     try {
 29:       const response = await fetch("/api/auth/session");
 30:       const serverSession = await response.json();
 31:       serverHasSession =
 32:         !!serverSession && Object.keys(serverSession).length > 0;
 33:     } catch (error) {
 34:       console.error("Failed to check server session:", error);
 35:     }
 36:     const data: DiagnosticData = {
 37:       reduxAuthUser: reduxAuthUser,
 38:       reduxAuthStatus: status,
 39:       reduxAccessToken: accessToken ?? null,
 40:       cookies: document.cookie
 41:         .split(";")
 42:         .filter((c) => c.trim())
 43:         .map((c) => c.trim()),
 44:       serverHasSession,
 45:       localStorageKeys: Object.keys(localStorage),
 46:       sessionStorageKeys: Object.keys(sessionStorage),
 47:       timestamp: new Date().toISOString(),
 48:     };
 49:     setDiagnostics(data);
 50:   }, [status, reduxAuthUser, accessToken]);
