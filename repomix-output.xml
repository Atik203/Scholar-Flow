 26:   if (typeof window === "undefined") return;
 27:   const globalWindow = window as typeof window & Record<string, boolean>;
 28:   delete globalWindow.__sfGithubOAuthProcessing;
 29:   sessionStorage.removeItem(LOCK_KEY);
 30: };
