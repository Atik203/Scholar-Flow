45:     await s3.send(putCommand);
46:     console.log('Upload OK');
47:     const headCommand = new HeadObjectCommand({ Bucket: bucket, Key: key });
48:     const head = await s3.send(headCommand);
49:     console.log('HEAD OK size=', head.ContentLength);
50:     const getCommand = new GetObjectCommand({ Bucket: bucket, Key: key });
51:     const getRes = await s3.send(getCommand);
