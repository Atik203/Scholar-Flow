30:   async (req: AuthRequest, res: Response) => {
31:     const userId = req.user!.id;
32:     const input = req.body as CreatePortalSessionInput;
33:     const session = await billingService.createPortalSession(userId, input);
34:     res.status(200).json({
35:       success: true,
36:       message: "Portal session created successfully",
37:       data: session,
38:     });
39:   }
40: );
41: const getSubscription = catchAsync(async (req: AuthRequest, res: Response) => {
42:   const userId = req.user!.id;
43:   const workspaceId = req.query.workspaceId as string | undefined;
44:   const subscription = await billingService.getUserSubscription(
45:     userId,
46:     workspaceId
47:   );
48:   res.status(200).json({
49:     success: true,
50:     message: subscription
51:       ? "Subscription retrieved successfully"
52:       : "No active subscription found",
53:     data: subscription,
54:   });
55: });
56: const managePlan = catchAsync(
57:   async (req: AuthRequest, res: Response): Promise<void> => {
58:     const userId = req.user!.id;
59:     const input = req.body as ManagePlanInput;
60:     const { action, workspaceId } = input;
61:     let result;
62:     switch (action) {
63:       case "cancel":
64:         await billingService.cancelSubscription(userId, workspaceId);
65:         result = { message: "Subscription will be canceled at period end" };
66:         break;
67:       case "reactivate":
68:         await billingService.reactivateSubscription(userId, workspaceId);
69:         result = { message: "Subscription reactivated successfully" };
70:         break;
71:       case "update_seats":
72:         result = { message: "Seat update not yet implemented" };
73:         break;
74:       default:
75:         res.status(400).json({
76:           success: false,
77:           message: "Invalid action",
78:         });
79:         return;
80:     }
81:     res.status(200).json({
82:       success: true,
83:       ...result,
84:     });
85:   }
86: );
