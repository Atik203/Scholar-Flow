<file path="apps/frontend/src/components/auth/ProtectedRoute.tsx">
  1: "use client";
  2: import { showAccessDeniedToast } from "@/components/providers/ToastProvider";
  3: import { hasPermission, hasRoleAccess } from "@/lib/auth/roles";
  4: import { useAuth } from "@/redux/auth/useAuth";
  5: import { useRouter } from "next/navigation";
  6: import { ReactNode, useEffect } from "react";
  7: interface ProtectedRouteProps {
  8:   children: ReactNode;
  9:   requiredRole?: string;
 10:   requiredPermission?: string;
 11:   fallback?: ReactNode;
 12:   showToast?: boolean;
 13: }
 14: export function ProtectedRoute({
 15:   children,
 16:   requiredRole,
 17:   requiredPermission,
 18:   fallback,
 19:   showToast = true,
 20: }: ProtectedRouteProps) {
 21:   const { user, isAuthenticated } = useAuth();
 22:   const router = useRouter();
 23:   useEffect(() => {
 24:     if (!isAuthenticated || !user) {
 25:       if (!fallback) router.replace("/login");
 26:       return;
 27:     }
 28:     if (requiredRole && !hasRoleAccess(user.role, requiredRole)) {
 29:       if (!fallback) router.replace("/dashboard");
 30:       return;
 31:     }
 32:     if (requiredPermission && !hasPermission(user.role, requiredPermission)) {
 33:       if (!fallback) router.replace("/dashboard");
 34:     }
 35:   }, [
 36:     isAuthenticated,
 37:     user,
 38:     requiredRole,
 39:     requiredPermission,
 40:     fallback,
 41:     router,
 42:   ]);
 43:   if (!isAuthenticated || !user) {
 44:     return fallback || null;
 45:   }
 46:   if (requiredRole && !hasRoleAccess(user.role, requiredRole)) {
 47:     if (showToast) {
 48:       showAccessDeniedToast(requiredRole);
 49:     }
 50:     return fallback || null;
 51:   }
 52:   if (requiredPermission && !hasPermission(user.role, requiredPermission)) {
 53:     if (showToast) {
 54:       showAccessDeniedToast(`permission: ${requiredPermission}`);
 55:     }
 56:     return fallback || null;
 57:   }
 58:   return <>{children}</>;
 59: }
 60: interface RoleGateProps {
 61:   children: ReactNode;
 62:   allowedRoles: string[];
 63:   fallback?: ReactNode;
 64:   showToast?: boolean;
 65: }
 66: export function RoleGate({
 67:   children,
 68:   allowedRoles,
 69:   fallback,
 70:   showToast = false,
 71: }: RoleGateProps) {
 72:   const { user, isAuthenticated } = useAuth();
 73:   const hasAccess =
 74:     isAuthenticated &&
 75:     user &&
 76:     allowedRoles.some((role) => hasRoleAccess(user.role, role));
 77:   if (!hasAccess) {
 78:     if (showToast && allowedRoles.length > 0) {
 79:       showAccessDeniedToast(allowedRoles[0]);
 80:     }
 81:     return fallback || null;
 82:   }
 83:   return <>{children}</>;
 84: }
 85: interface PermissionGateProps {
 86:   children: ReactNode;
 87:   requiredPermissions: string[];
 88:   requireAll?: boolean;
 89:   fallback?: ReactNode;
 90:   showToast?: boolean;
 91: }
 92: export function PermissionGate({
 93:   children,
 94:   requiredPermissions,
 95:   requireAll = false,
 96:   fallback,
 97:   showToast = false,
 98: }: PermissionGateProps) {
 99:   const { user, isAuthenticated } = useAuth();
100:   if (!isAuthenticated || !user) {
101:     return fallback || null;
102:   }
103:   const hasAccess = requireAll
104:     ? requiredPermissions.every((permission) =>
105:         hasPermission(user.role, permission)
106:       )
107:     : requiredPermissions.some((permission) =>
108:         hasPermission(user.role, permission)
109:       );
110:   if (!hasAccess) {
111:     if (showToast) {
112:       showAccessDeniedToast(`permissions: ${requiredPermissions.join(", ")}`);
113:     }
114:     return fallback || null;
115:   }
116:   return <>{children}</>;
117: }
</file>

