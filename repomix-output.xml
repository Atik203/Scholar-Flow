238: export const validateForm = <T>(
239:   schema: z.ZodSchema<T>,
240:   data: unknown
241: ):
242:   | { success: true; data: T }
243:   | { success: false; errors: Record<string, string> } => {
244:   try {
245:     const result = schema.parse(data);
246:     return { success: true, data: result };
247:   } catch (error) {
248:     if (error instanceof z.ZodError) {
249:       const errors: Record<string, string> = {};
250:       error.errors.forEach((err) => {
251:         const path = err.path.join(".");
252:         errors[path] = err.message;
253:       });
254:       return { success: false, errors };
255:     }
256:     return { success: false, errors: { form: "Validation failed" } };
257:   }
