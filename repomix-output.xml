 18: export interface BreadcrumbsProps {
 19:   items: BreadcrumbItem[];
 20:   separator?: React.ReactNode;
 21:   maxItems?: number;
 22:   showHome?: boolean;
 23:   className?: string;
 24:   itemClassName?: string;
