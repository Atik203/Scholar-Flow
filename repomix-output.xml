195: interface ImageUploadDragAreaProps {
196:   onFile: (files: File[]) => void;
197:   children?: React.ReactNode;
198: }
199: const ImageUploadDragArea: React.FC<ImageUploadDragAreaProps> = ({
200:   onFile,
201:   children,
202: }) => {
203:   const [isDragOver, setIsDragOver] = React.useState(false);
204:   const [isDragActive, setIsDragActive] = React.useState(false);
205:   const handleDragEnter = (e: React.DragEvent) => {
206:     e.preventDefault();
207:     e.stopPropagation();
208:     setIsDragActive(true);
209:   };
210:   const handleDragLeave = (e: React.DragEvent) => {
211:     e.preventDefault();
212:     e.stopPropagation();
213:     if (!e.currentTarget.contains(e.relatedTarget as Node)) {
214:       setIsDragActive(false);
215:       setIsDragOver(false);
216:     }
217:   };
218:   const handleDragOver = (e: React.DragEvent) => {
219:     e.preventDefault();
220:     e.stopPropagation();
221:     setIsDragOver(true);
222:   };
223:   const handleDrop = (e: React.DragEvent) => {
224:     e.preventDefault();
225:     e.stopPropagation();
226:     setIsDragActive(false);
227:     setIsDragOver(false);
228:     const files = Array.from(e.dataTransfer.files);
229:     if (files.length > 0) {
230:       onFile(files);
231:     }
232:   };
233:   return (
234:     <div
235:       className={`tiptap-image-upload-drag-area ${isDragActive ? "drag-active" : ""} ${isDragOver ? "drag-over" : ""}`}
236:       onDragEnter={handleDragEnter}
237:       onDragLeave={handleDragLeave}
238:       onDragOver={handleDragOver}
239:       onDrop={handleDrop}
240:     >
241:       {children}
242:     </div>
243:   );
244: };
245: interface ImageUploadPreviewProps {
