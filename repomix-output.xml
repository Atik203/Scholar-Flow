  1: import {
  2:   GetObjectCommand,
  3:   GetObjectCommandInput,
  4:   PutObjectCommand,
  5:   PutObjectCommandInput,
  6:   S3Client,
  7: } from "@aws-sdk/client-s3";
  8: import { getSignedUrl } from "@aws-sdk/s3-request-presigner";
  9: export interface PutObjectParams {
 10:   key: string;
 11:   body: Buffer | Uint8Array | string;
 12:   contentType?: string;
 13: }
 14: export class StorageService {
 15:   private s3: S3Client;
 16:   private bucket: string;
 17:   constructor() {
 18:     const bucket = process.env.AWS_BUCKET_NAME || process.env.S3_BUCKET;
 19:     if (!bucket)
 20:       throw new Error(
 21:         "StorageService: bucket env var (AWS_BUCKET_NAME or S3_BUCKET) not set"
 22:       );
 23:     const region = process.env.AWS_REGION || "us-east-1";
 24:     this.s3 = new S3Client({
 25:       region,
 26:       credentials: {
 27:         accessKeyId:
 28:           process.env.AWS_ACCESS_KEY_ID || process.env.S3_ACCESS_KEY || "",
 29:         secretAccessKey:
 30:           process.env.AWS_SECRET_ACCESS_KEY || process.env.S3_SECRET_KEY || "",
 31:       },
 32:       requestHandler: {
 33:         requestTimeout: 60000, // 60 second timeout for large uploads
 34:         connectionTimeout: 15000, // 15 second connection timeout
 35:       },
 36:       maxAttempts: 3, // Allow more retries for reliability
 37:       retryMode: "adaptive",
 38:     });
 39:     this.bucket = bucket;
 40:     console.log(
 41:       `[StorageService] Initialized with bucket: ${bucket}, region: ${region}`
 42:     );
 43:     this.testConnection().catch((error) => {
 44:       console.warn(
 45:         `[StorageService] Initial connection test failed:`,
 46:         error.message
 47:       );
 48:     });
 49:   }
 50:   async testConnection(): Promise<boolean> {
 51:     try {
 52:       console.log(`[StorageService] Testing S3 connection...`);
 53:       const { HeadBucketCommand } = await import("@aws-sdk/client-s3");
 54:       const command = new HeadBucketCommand({ Bucket: this.bucket });
 55:       await this.s3.send(command);
 56:       console.log(`[StorageService] S3 connection test successful`);
 57:       return true;
 58:     } catch (error) {
 59:       console.error(`[StorageService] S3 connection test failed:`, error);
 60:       return false;
 61:     }
 62:   }
 63:   async putObject(params: PutObjectParams) {
 64:     const uploadStart = Date.now();
 65:     console.log(
 66:       `[StorageService] Starting S3 putObject for key: ${params.key}, size: ${params.body.length} bytes`
 67:     );
 68:     try {
 69:       const putObjectInput: PutObjectCommandInput = {
 70:         Bucket: this.bucket,
 71:         Key: params.key,
 72:         Body: params.body,
 73:         ContentType: params.contentType || "application/octet-stream",
 74:       };
 75:       const command = new PutObjectCommand(putObjectInput);
 76:       await this.s3.send(command);
 77:       const uploadTime = Date.now() - uploadStart;
 78:       const sizeMB = (params.body.length / 1024 / 1024).toFixed(2);
 79:       console.log(
 80:         `[StorageService] S3 putObject completed in ${uploadTime}ms for ${sizeMB}MB file`
 81:       );
 82:       return { key: params.key };
 83:     } catch (error) {
 84:       const uploadTime = Date.now() - uploadStart;
 85:       console.error(
 86:         `[StorageService] S3 putObject failed after ${uploadTime}ms:`,
 87:         error
 88:       );
 89:       if (error instanceof Error) {
 90:         console.error(`[StorageService] Error name: ${error.name}`);
 91:         console.error(`[StorageService] Error message: ${error.message}`);
 92:         if ("code" in error) {
 93:           console.error(`[StorageService] Error code: ${(error as any).code}`);
 94:         }
 95:         if ("$metadata" in error) {
 96:           console.error(
 97:             `[StorageService] Error metadata:`,
 98:             (error as any).$metadata
 99:           );
100:         }
101:       }
102:       throw error;
103:     }
104:   }
105:   async getObject(key: string): Promise<Buffer> {
106:     const getObjectInput: GetObjectCommandInput = {
107:       Bucket: this.bucket,
108:       Key: key,
109:     };
110:     const command = new GetObjectCommand(getObjectInput);
111:     const result = await this.s3.send(command);
112:     const chunks: Buffer[] = [];
113:     const stream = result.Body as NodeJS.ReadableStream;
114:     return new Promise((resolve, reject) => {
115:       stream.on("data", (chunk: Buffer) => chunks.push(chunk));
116:       stream.on("error", reject);
117:       stream.on("end", () => resolve(Buffer.concat(chunks)));
118:     });
119:   }
120:   async getSignedUrl(key: string, expiresSeconds = 300): Promise<string> {
121:     const getObjectInput: GetObjectCommandInput = {
122:       Bucket: this.bucket,
123:       Key: key,
124:     };
125:     const command = new GetObjectCommand(getObjectInput);
126:     return await getSignedUrl(this.s3, command, {
127:       expiresIn: expiresSeconds,
128:     });
129:   }
130:   async uploadFile(
131:     buffer: Buffer,
132:     originalName: string,
133:     contentType: string
134:   ): Promise<{ url: string; filename: string; key: string }> {
135:     const uploadStart = Date.now();
136:     const timestamp = Date.now();
137:     const fileExtension = originalName.split(".").pop();
138:     const filename = `editor-images/${timestamp}-${Math.random().toString(36).substring(2)}.${fileExtension}`;
139:     console.log(
140:       `[StorageService] Uploading image: ${filename}, size: ${buffer.length} bytes, type: ${contentType}`
141:     );
142:     try {
143:       const putObjectInput: PutObjectCommandInput = {
144:         Bucket: this.bucket,
145:         Key: filename,
146:         Body: buffer,
147:         ContentType: contentType,
148:       };
149:       const command = new PutObjectCommand(putObjectInput);
150:       await this.s3.send(command);
151:       const uploadTime = Date.now() - uploadStart;
152:       console.log(`[StorageService] S3 putObject completed in ${uploadTime}ms`);
153:       const presignedStart = Date.now();
154:       const url = await this.getSignedUrl(filename, 604800);
155:       const presignedTime = Date.now() - presignedStart;
156:       const totalTime = Date.now() - uploadStart;
157:       console.log(
158:         `[StorageService] Presigned URL generated in ${presignedTime}ms with 7-day expiry`
159:       );
160:       console.log(`[StorageService] Image upload completed in ${totalTime}ms`);
161:       return {
162:         url: url,
163:         filename: originalName,
164:         key: filename,
165:       };
166:     } catch (error) {
167:       const uploadTime = Date.now() - uploadStart;
168:       console.error(
169:         `[StorageService] Image upload failed after ${uploadTime}ms:`,
170:         error
171:       );
172:       throw error;
173:     }
174:   }
175: }
</file>

