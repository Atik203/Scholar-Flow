   6:   static async listUserWorkspaces(
   7:     userId: string,
   8:     limit: number,
   9:     cursor: string | undefined,
  10:     scope: "all" | "owned" | "shared" = "all"
  11:   ) {
  12:     const whereOwned = scope === "owned";
  13:     const whereShared = scope === "shared";
  14:     const take = limit + 1;
  15:     const cursorFilter = cursor
  16:       ? Prisma.sql`AND fw."createdAt" < (SELECT "createdAt" FROM "Workspace" WHERE id = ${cursor})`
  17:       : Prisma.empty;
  18:     const rows = await prisma.$queryRaw<any[]>`
  19:       WITH filtered_workspaces AS (
  20:         SELECT w.*
  21:         FROM "Workspace" w
  22:         JOIN "WorkspaceMember" m ON m."workspaceId" = w.id AND m."isDeleted" = false
  23:         WHERE m."userId" = ${userId}
  24:           AND w."isDeleted" = false
  25:           AND (${whereOwned} = false OR w."ownerId" = ${userId})
  26:           AND (${whereShared} = false OR w."ownerId" != ${userId})
  27:       )
  28:       SELECT
  29:         fw.*,
  30:         (fw."ownerId" = ${userId})::boolean AS "isOwner",
  31:         COALESCE(member_counts.member_count, 0)::int AS "memberCount",
  32:         COALESCE(collection_counts.collection_count, 0)::int AS "collectionCount",
  33:         COALESCE(paper_counts.paper_count, 0)::int AS "paperCount"
  34:       FROM filtered_workspaces fw
  35:       LEFT JOIN (
  36:         SELECT "workspaceId", COUNT(*)::int AS member_count
  37:         FROM "WorkspaceMember"
  38:         WHERE "isDeleted" = false
  39:         GROUP BY "workspaceId"
  40:       ) member_counts ON member_counts."workspaceId" = fw.id
  41:       LEFT JOIN (
  42:         SELECT "workspaceId", COUNT(*)::int AS collection_count
  43:         FROM "Collection"
  44:         WHERE "isDeleted" = false
  45:         GROUP BY "workspaceId"
  46:       ) collection_counts ON collection_counts."workspaceId" = fw.id
  47:       LEFT JOIN (
  48:         SELECT "workspaceId", COUNT(*)::int AS paper_count
  49:         FROM "Paper"
  50:         WHERE "isDeleted" = false
  51:         GROUP BY "workspaceId"
  52:       ) paper_counts ON paper_counts."workspaceId" = fw.id
  53:       WHERE true
  54:         ${cursorFilter}
  55:       ORDER BY fw."createdAt" DESC
  56:       LIMIT ${take}
  57:     `;
  58:     const hasMore = rows.length > limit;
  59:     const sliced = hasMore ? rows.slice(0, -1) : rows;
  60:     return {
  61:       result: sliced,
  62:       meta: {
  63:         limit,
  64:         nextCursor: hasMore ? sliced[sliced.length - 1].id : null,
  65:         hasMore,
  66:       },
  67:     };
  68:   }
  69:   static async createWorkspace(
