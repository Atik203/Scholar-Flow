 31:   description,
 32:   onClick,
 33:   loading = false,
 34:   formatValue,
 35:   showTrend = true,
 36:   size = "md",
 37:   variant = "default",
 38:   padding = "md",
 39:   hover = "none",
 40: }: StatCardProps) {
 41:   const sizeClasses = {
 42:     sm: "p-4",
 43:     md: "p-6",
 44:     lg: "p-8",
 45:   };
 46:   const iconSizes = {
 47:     sm: "h-8 w-8",
 48:     md: "h-10 w-10",
 49:     lg: "h-12 w-12",
 50:   };
 51:   const textSizes = {
 52:     sm: {
 53:       title: "text-sm",
 54:       value: "text-2xl",
 55:       change: "text-xs",
 56:       description: "text-xs",
 57:     },
 58:     md: {
 59:       title: "text-sm",
 60:       value: "text-3xl",
 61:       change: "text-sm",
 62:       description: "text-sm",
 63:     },
 64:     lg: {
 65:       title: "text-base",
 66:       value: "text-4xl",
 67:       change: "text-base",
 68:       description: "text-sm",
 69:     },
 70:   };
 71:   const currentSize = (size as "sm" | "md" | "lg") || "md";
 72:   const sizeConfig = textSizes[currentSize] || textSizes.md;
 73:   const getTrendIcon = () => {
 74:     if (!trend || !showTrend) return null;
 75:     switch (trend) {
 76:       case "up":
 77:         return <TrendingUp className="h-4 w-4 text-green-500" />;
 78:       case "down":
 79:         return <TrendingDown className="h-4 w-4 text-red-500" />;
 80:       case "neutral":
 81:         return <Minus className="h-4 w-4 text-muted-foreground" />;
 82:       default:
 83:         return null;
 84:     }
 85:   };
 86:   const getChangeIcon = () => {
 87:     if (change === undefined) return null;
 88:     if (change > 0) {
 89:       return <ArrowUpRight className="h-4 w-4" />;
 90:     } else if (change < 0) {
 91:       return <ArrowDownRight className="h-4 w-4" />;
 92:     }
