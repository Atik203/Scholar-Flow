  4: import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
  5: import { Input } from "@/components/ui/input";
  6: import { Textarea } from "@/components/ui/textarea";
  7: import { Badge } from "@/components/ui/badge";
  8: import { Label } from "@/components/ui/label";
  9: import { Switch } from "@/components/ui/switch";
 10: import { useGetNoteQuery, useCreateNoteMutation, useUpdateNoteMutation } from "@/redux/api/noteApi";
 11: import { showErrorToast, showSuccessToast } from "@/components/providers/ToastProvider";
 12: import { formatDistanceToNow } from "date-fns";
 13: import {
 14:   Save,
 15:   X,
 16:   Tag,
 17:   Lock,
 18:   Globe,
 19:   FileText,
 20:   Loader2
 21: } from "lucide-react";
 22: interface NoteEditorProps {
 23:   noteId?: string | null;
 24:   paperId?: string;
 25:   onClose: () => void;
 26:   className?: string;
 27: }
 28: export function NoteEditor({
 29:   noteId,
 30:   paperId,
 31:   onClose,
 32:   className = ""
 33: }: NoteEditorProps) {
 34:   const [title, setTitle] = useState("");
 35:   const [content, setContent] = useState("");
 36:   const [tags, setTags] = useState<string[]>([]);
 37:   const [tagInput, setTagInput] = useState("");
 38:   const [isPrivate, setIsPrivate] = useState(true);
 39:   const [isSaving, setIsSaving] = useState(false);
 40:   const isEditing = !!noteId;
 41:   // Fetch note data if editing
 42:   const { data: noteData, isLoading } = useGetNoteQuery(noteId!, {
 43:     skip: !noteId,
 44:   });
 45:   const [createNote] = useCreateNoteMutation();
 46:   const [updateNote] = useUpdateNoteMutation();
 47:   // Load note data when editing
 48:   useEffect(() => {
 49:     if (noteData?.data) {
 50:       const note = noteData.data;
 51:       setTitle(note.title);
 52:       setContent(note.content);
 53:       setTags(note.tags);
 54:       setIsPrivate(note.isPrivate);
 55:     }
 56:   }, [noteData]);
 57:   const handleSave = async () => {
 58:     if (!title.trim() || !content.trim()) {
 59:       showErrorToast("Title and content are required");
 60:       return;
 61:     }
 62:     setIsSaving(true);
 63:     try {
 64:       if (isEditing) {
 65:         await updateNote({
 66:           id: noteId!,
 67:           data: {
 68:             title: title.trim(),
 69:             content: content.trim(),
 70:             tags,
 71:             isPrivate,
 72:           },
 73:         }).unwrap();
 74:         showSuccessToast("Note updated successfully");
 75:       } else {
 76:         await createNote({
 77:           paperId,
 78:           title: title.trim(),
 79:           content: content.trim(),
 80:           tags,
 81:           isPrivate,
 82:         }).unwrap();
 83:         showSuccessToast("Note created successfully");
 84:       }
 85:       onClose();
 86:     } catch (error: any) {
 87:       showErrorToast(error.data?.message || "Failed to save note");
 88:     } finally {
 89:       setIsSaving(false);
 90:     }
 91:   };
 92:   const handleAddTag = () => {
 93:     const tag = tagInput.trim().toLowerCase();
 94:     if (tag && !tags.includes(tag)) {
 95:       setTags([...tags, tag]);
 96:       setTagInput("");
 97:     }
 98:   };
 99:   const handleRemoveTag = (tagToRemove: string) => {
100:     setTags(tags.filter(tag => tag !== tagToRemove));
101:   };
102:   const handleKeyDown = (e: React.KeyboardEvent) => {
103:     if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
104:       handleSave();
105:     } else if (e.key === "Escape") {
106:       onClose();
107:     }
108:   };
109:   if (isLoading) {
110:     return (
111:       <div className="flex items-center justify-center h-64">
112:         <Loader2 className="h-8 w-8 animate-spin" />
113:       </div>
114:     );
115:   }
116:   return (
117:     <div className={`flex flex-col h-full ${className}`}>
118:       <CardHeader className="pb-3">
119:         <div className="flex items-center justify-between">
120:           <CardTitle className="text-lg">
121:             {isEditing ? "Edit Note" : "Create Note"}
122:           </CardTitle>
123:           <div className="flex items-center gap-2">
124:             {isEditing && noteData?.data && (
125:               <span className="text-xs text-muted-foreground">
126:                 Updated {formatDistanceToNow(new Date(noteData.data.updatedAt), { addSuffix: true })}
127:               </span>
128:             )}
129:             <Button variant="ghost" size="sm" onClick={onClose}>
130:               <X className="h-4 w-4" />
131:             </Button>
132:           </div>
133:         </div>
134:       </CardHeader>
135:       <CardContent className="flex-1 flex flex-col space-y-4">
136:         {}
137:         <div className="space-y-2">
138:           <Label htmlFor="note-title">Title</Label>
139:           <Input
140:             id="note-title"
141:             value={title}
142:             onChange={(e) => setTitle(e.target.value)}
143:             placeholder="Enter note title..."
144:             onKeyDown={handleKeyDown}
145:             disabled={isSaving}
146:           />
147:         </div>
148:         {}
149:         <div className="space-y-2">
150:           <Label>Tags</Label>
151:           <div className="flex items-center gap-2">
152:             <Input
153:               value={tagInput}
154:               onChange={(e) => setTagInput(e.target.value)}
155:               placeholder="Add a tag..."
156:               onKeyPress={(e) => e.key === "Enter" && handleAddTag()}
157:               disabled={isSaving}
158:             />
159:             <Button
160:               type="button"
161:               variant="outline"
162:               size="sm"
163:               onClick={handleAddTag}
164:               disabled={!tagInput.trim() || isSaving}
165:             >
166:               <Tag className="h-4 w-4" />
167:             </Button>
168:           </div>
169:           {tags.length > 0 && (
170:             <div className="flex flex-wrap gap-1">
171:               {tags.map((tag) => (
172:                 <Badge
173:                   key={tag}
174:                   variant="secondary"
175:                   className="text-xs cursor-pointer hover:bg-destructive hover:text-destructive-foreground"
176:                   onClick={() => handleRemoveTag(tag)}
177:                 >
178:                   {tag} ×
179:                 </Badge>
180:               ))}
181:             </div>
182:           )}
183:         </div>
184:         {}
185:         <div className="flex items-center justify-between">
186:           <div className="flex items-center gap-2">
187:             {isPrivate ? (
188:               <Lock className="h-4 w-4 text-muted-foreground" />
189:             ) : (
190:               <Globe className="h-4 w-4 text-muted-foreground" />
191:             )}
192:             <Label htmlFor="note-privacy">
193:               {isPrivate ? "Private Note" : "Public Note"}
194:             </Label>
195:           </div>
196:           <Switch
197:             id="note-privacy"
198:             checked={!isPrivate}
199:             onCheckedChange={(checked) => setIsPrivate(!checked)}
200:             disabled={isSaving}
201:           />
202:         </div>
203:         {}
204:         <div className="flex-1 space-y-2">
205:           <Label htmlFor="note-content">Content</Label>
206:           <Textarea
207:             id="note-content"
208:             value={content}
209:             onChange={(e) => setContent(e.target.value)}
210:             placeholder="Write your research notes here..."
211:             className="flex-1 min-h-[300px] resize-none"
212:             onKeyDown={handleKeyDown}
213:             disabled={isSaving}
214:           />
215:           <div className="text-xs text-muted-foreground">
216:             Press Ctrl+Enter to save, Esc to cancel
217:           </div>
218:         </div>
219:         {}
220:         <div className="flex items-center justify-end gap-2 pt-4 border-t">
221:           <Button variant="outline" onClick={onClose} disabled={isSaving}>
222:             Cancel
223:           </Button>
224:           <Button onClick={handleSave} disabled={isSaving || !title.trim() || !content.trim()}>
225:             {isSaving ? (
226:               <Loader2 className="h-4 w-4 mr-2 animate-spin" />
227:             ) : (
228:               <Save className="h-4 w-4 mr-2" />
229:             )}
230:             {isEditing ? "Update" : "Create"} Note
231:           </Button>
232:         </div>
233:       </CardContent>
234:     </div>
235:   );
236: }
</file>

