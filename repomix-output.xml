 11: function cn(...classes: (string | undefined | null | false)[]): string { return classes.filter(Boolean).join(" "); }
 12: export default function SearchPapersPage() {
 13:   const [query, setQuery] = useState("");
 14:   const [activeQuery, setActiveQuery] = useState("");
 15:   const [statusFilter, setStatusFilter] = useState<string>("all");
 16:   const { data: papersData, isLoading } = useListPapersQuery({ limit: 100 });
 17:   const papers = papersData?.items || [];
 18:   const results = useMemo(() => {
 19:     if (!activeQuery) return [];
 20:     const q = activeQuery.toLowerCase();
 21:     return papers
 22:       .filter((p) => {
 23:         const matches = p.title.toLowerCase().includes(q) ||
 24:           (p.abstract || "").toLowerCase().includes(q) ||
 25:           (p.metadata?.authors || []).some((a: string) => a.toLowerCase().includes(q)) ||
 26:           (p.tags || []).some((t) => t.toLowerCase().includes(q));
 27:         const matchesStatus = statusFilter === "all" || p.processingStatus === statusFilter;
 28:         return matches && matchesStatus;
 29:       })
 30:       .map((p) => ({
 31:         ...p,
 32:         relevanceScore: Math.min(100, Math.floor(
 33:           ((p.title.toLowerCase().includes(q) ? 50 : 0) + ((p.abstract || "").toLowerCase().includes(q) ? 30 : 0) +
 34:             ((p.tags || []).some((t) => t.toLowerCase().includes(q)) ? 20 : 0))
 35:         )),
 36:       }))
 37:       .sort((a, b) => (b.relevanceScore || 0) - (a.relevanceScore || 0));
 38:   }, [activeQuery, papers, statusFilter]);
 39:   const handleSearch = () => { if (query.trim()) setActiveQuery(query.trim()); };
