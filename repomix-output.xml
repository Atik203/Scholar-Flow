  92: function parseArxivEntries(
  93:   xml: string
  94: ): Array<{
  95:   id: string;
  96:   title: string;
  97:   summary: string;
  98:   published: string;
  99:   authors: string[];
 100: }> {
 101:   const entries = xml.match(/<entry>[\s\S]*?<\/entry>/g) ?? [];
 102:   const results: Array<{
 103:     id: string;
 104:     title: string;
 105:     summary: string;
 106:     published: string;
 107:     authors: string[];
 108:   }> = [];
 109:   for (const entry of entries) {
 110:     const content = (tag: string): string => {
 111:       const m = entry.match(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)<\\/${tag}>`));
 112:       if (!m) return "";
 113:       return decodeXmlEntities(m[1].replace(/<[^>]*>/g, " "))
 114:         .replace(/\s+/g, " ")
 115:         .trim();
 116:     };
 117:     const id = content("id");
 118:     const title = content("title");
 119:     if (!id || !title) continue;
 120:     const authorMatches = entry.matchAll(
 121:       /<author>[\s\S]*?<name[^>]*>(.*?)<\/name>[\s\S]*?<\/author>/g
 122:     );
 123:     const authors = [...authorMatches]
 124:       .map((m) => decodeXmlEntities(m[1].replace(/<[^>]*>/g, " ")).replace(/\s+/g, " ").trim())
 125:       .filter(Boolean);
 126:     results.push({
 127:       id,
 128:       title,
 129:       summary: content("summary"),
 130:       published: content("published"),
 131:       authors,
 132:     });
 133:   }
 134:   return results;
 135: }
 136: function reconstructOpenAlexAbstract(
 137:   inverted: Record<string, number[]> | undefined
 138: ): string | null {
 139:   if (!inverted) return null;
 140:   const words: string[] = [];
 141:   for (const [word, positions] of Object.entries(inverted)) {
 142:     for (const pos of positions) words[pos] = word;
 143:   }
 144:   return words.join(" ").trim() || null;
 145: }
