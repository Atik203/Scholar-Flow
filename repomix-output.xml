<file path="apps/frontend/src/hooks/use-element-rect.ts">
  1: "use client"
  2: import * as React from "react"
  3: import { useThrottledCallback } from "./use-throttled-callback"
  4: export type RectState = Omit<DOMRect, "toJSON">
  5: export interface ElementRectOptions {
  6:   element?: Element | React.RefObject<Element> | string | null
  7:   enabled?: boolean
  8:   throttleMs?: number
  9:   useResizeObserver?: boolean
 10: }
 11: const initialRect: RectState = {
 12:   x: 0,
 13:   y: 0,
 14:   width: 0,
 15:   height: 0,
 16:   top: 0,
 17:   right: 0,
 18:   bottom: 0,
 19:   left: 0,
 20: }
 21: const isSSR = typeof window === "undefined"
 22: const hasResizeObserver = !isSSR && typeof ResizeObserver !== "undefined"
 23: const isClientSide = (): boolean => !isSSR
 24: export function useElementRect({
 25:   element,
 26:   enabled = true,
 27:   throttleMs = 100,
 28:   useResizeObserver = true,
 29: }: ElementRectOptions = {}): RectState {
 30:   const [rect, setRect] = React.useState<RectState>(initialRect)
 31:   const getTargetElement = React.useCallback((): Element | null => {
 32:     if (!enabled || !isClientSide()) return null
 33:     if (!element) {
 34:       return document.body
 35:     }
 36:     if (typeof element === "string") {
 37:       return document.querySelector(element)
 38:     }
 39:     if ("current" in element) {
 40:       return element.current
 41:     }
 42:     return element
 43:   }, [element, enabled])
 44:   const updateRect = useThrottledCallback(
 45:     () => {
 46:       if (!enabled || !isClientSide()) return
 47:       const targetElement = getTargetElement()
 48:       if (!targetElement) {
 49:         setRect(initialRect)
 50:         return
 51:       }
 52:       const newRect = targetElement.getBoundingClientRect()
 53:       setRect({
 54:         x: newRect.x,
 55:         y: newRect.y,
 56:         width: newRect.width,
 57:         height: newRect.height,
 58:         top: newRect.top,
 59:         right: newRect.right,
 60:         bottom: newRect.bottom,
 61:         left: newRect.left,
 62:       })
 63:     },
 64:     throttleMs,
 65:     [enabled, getTargetElement],
 66:     { leading: true, trailing: true }
 67:   )
 68:   React.useEffect(() => {
 69:     if (!enabled || !isClientSide()) {
 70:       setRect(initialRect)
 71:       return
 72:     }
 73:     const targetElement = getTargetElement()
 74:     if (!targetElement) return
 75:     updateRect()
 76:     const cleanup: (() => void)[] = []
 77:     if (useResizeObserver && hasResizeObserver) {
 78:       const resizeObserver = new ResizeObserver(() => {
 79:         window.requestAnimationFrame(updateRect)
 80:       })
 81:       resizeObserver.observe(targetElement)
 82:       cleanup.push(() => resizeObserver.disconnect())
 83:     }
 84:     const handleUpdate = () => updateRect()
 85:     window.addEventListener("scroll", handleUpdate, { passive: true })
 86:     window.addEventListener("resize", handleUpdate, { passive: true })
 87:     cleanup.push(() => {
 88:       window.removeEventListener("scroll", handleUpdate)
 89:       window.removeEventListener("resize", handleUpdate)
 90:     })
 91:     return () => {
 92:       cleanup.forEach((fn) => fn())
 93:       setRect(initialRect)
 94:     }
 95:   }, [enabled, getTargetElement, updateRect, useResizeObserver])
 96:   return rect
 97: }
 98: export function useBodyRect(
 99:   options: Omit<ElementRectOptions, "element"> = {}
100: ): RectState {
101:   return useElementRect({
102:     ...options,
103:     element: isClientSide() ? document.body : null,
104:   })
105: }
106: export function useRefRect<T extends Element>(
107:   ref: React.RefObject<T>,
108:   options: Omit<ElementRectOptions, "element"> = {}
109: ): RectState {
110:   return useElementRect({ ...options, element: ref })
111: }
</file>

<file path="apps/frontend/src/hooks/use-keyboard-shortcut.ts">
 1: import { useCallback, useEffect } from "react";
 2: export type KeyCombo = string[];
 3: export type KeyboardShortcutHandler = (e: KeyboardEvent) => void;
 4: export interface KeyboardShortcutOptions {
 5:   preventDefault?: boolean;
 6:   stopPropagation?: boolean;
 7:   target?: EventTarget;
 8: }
 9: export function useKeyboardShortcut(
10:   keys: KeyCombo,
11:   handler: KeyboardShortcutHandler,
12:   options: KeyboardShortcutOptions = {}
13: ) {
14:   const {
15:     preventDefault = true,
16:     stopPropagation = false,
17:     target = document,
18:   } = options;
19:   const handleKeyDown = useCallback(
20:     (e: Event) => {
21:       const keyboardEvent = e as KeyboardEvent;
22:       const pressedKeys = [
23:         keyboardEvent.ctrlKey && "Ctrl",
24:         keyboardEvent.altKey && "Alt",
25:         keyboardEvent.shiftKey && "Shift",
26:         keyboardEvent.metaKey && "Meta",
27:         keyboardEvent.key !== "Control" &&
28:           keyboardEvent.key !== "Alt" &&
29:           keyboardEvent.key !== "Shift" &&
30:           keyboardEvent.key !== "Meta" &&
31:           keyboardEvent.key,
32:       ].filter(Boolean) as string[];
33:       const isMatch =
34:         keys.every((key) => pressedKeys.includes(key)) &&
35:         pressedKeys.length === keys.length;
36:       if (isMatch) {
37:         if (preventDefault) {
38:           keyboardEvent.preventDefault();
39:         }
40:         if (stopPropagation) {
41:           keyboardEvent.stopPropagation();
42:         }
43:         handler(keyboardEvent);
44:       }
45:     },
46:     [keys, handler, preventDefault, stopPropagation]
47:   );
48:   useEffect(() => {
49:     target.addEventListener("keydown", handleKeyDown);
50:     return () => target.removeEventListener("keydown", handleKeyDown);
51:   }, [target, handleKeyDown]);
52: }
53: export function useCtrlK(handler: () => void) {
54:   useKeyboardShortcut(["Ctrl", "k"], () => handler());
55: }
56: export function useEscape(handler: () => void) {
57:   useKeyboardShortcut(["Escape"], () => handler());
58: }
59: export function useEnter(handler: () => void) {
60:   useKeyboardShortcut(["Enter"], () => handler());
61: }
62: export function useDelete(handler: () => void) {
63:   useKeyboardShortcut(["Delete"], () => handler());
64: }
65: export function useBackspace(handler: () => void) {
66:   useKeyboardShortcut(["Backspace"], () => handler());
67: }
</file>

<file path="apps/frontend/src/hooks/use-local-storage.ts">
 1: import { useState } from "react";
 2: export function useLocalStorage<T>(
 3:   key: string,
 4:   initialValue: T
 5: ): [T, (value: T | ((val: T) => T)) => void] {
 6:   const [storedValue, setStoredValue] = useState<T>(() => {
 7:     if (typeof window === "undefined") {
 8:       return initialValue;
 9:     }
10:     try {
11:       const item = window.localStorage.getItem(key);
12:       return item ? JSON.parse(item) : initialValue;
13:     } catch (error) {
14:       console.log(error);
15:       return initialValue;
16:     }
17:   });
18:   const setValue = (value: T | ((val: T) => T)) => {
19:     try {
20:       const valueToStore =
21:         value instanceof Function ? value(storedValue) : value;
22:       setStoredValue(valueToStore);
23:       if (typeof window !== "undefined") {
24:         window.localStorage.setItem(key, JSON.stringify(valueToStore));
25:       }
26:     } catch (error) {
