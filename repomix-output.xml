 1: import { Prisma } from "../../shared/prisma";
 2: import prisma from "../../shared/prisma";
 3: import ApiError from "../../errors/ApiError";
 4: export const systemAlertsService = {
 5:   async listAlerts(params: {
 6:     category?: "USER" | "BILLING" | "SECURITY" | "STORAGE" | "PROCESSING" | "SYSTEM";
 7:     severity?: "INFO" | "WARNING" | "CRITICAL";
 8:     resolved?: boolean;
 9:     page: number;
10:     limit: number;
11:   }) {
12:     const where: Prisma.SystemAlertWhereInput = {};
13:     if (params.category) where.category = params.category;
14:     if (params.severity) where.severity = params.severity;
15:     if (params.resolved !== undefined) where.resolved = params.resolved;
16:     const [total, items, unresolvedCount, criticalCount] = await Promise.all([
17:       prisma.systemAlert.count({ where }),
18:       prisma.systemAlert.findMany({
19:         where,
20:         orderBy: [{ resolved: "asc" }, { createdAt: "desc" }],
21:         skip: (params.page - 1) * params.limit,
22:         take: params.limit,
23:         include: {
24:           resolvedBy: { select: { id: true, name: true, email: true } },
25:         },
26:       }),
27:       prisma.systemAlert.count({ where: { ...where, resolved: false } }),
28:       prisma.systemAlert.count({
29:         where: { ...where, severity: "CRITICAL", resolved: false },
30:       }),
31:     ]);
32:     return {
33:       items,
34:       meta: {
35:         page: params.page,
36:         limit: params.limit,
37:         total,
38:         totalPage: Math.max(1, Math.ceil(total / params.limit)),
39:       },
40:       summary: { unresolved: unresolvedCount, critical: criticalCount },
41:     };
42:   },
43:   async getCounts() {
44:     const [unresolved, critical, info, warning] = await Promise.all([
45:       prisma.systemAlert.count({ where: { resolved: false } }),
46:       prisma.systemAlert.count({
47:         where: { resolved: false, severity: "CRITICAL" },
48:       }),
49:       prisma.systemAlert.count({
50:         where: { resolved: false, severity: "INFO" },
51:       }),
52:       prisma.systemAlert.count({
53:         where: { resolved: false, severity: "WARNING" },
54:       }),
55:     ]);
56:     return { unresolved, critical, info, warning };
57:   },
58:   async resolveAlert(id: string, actorId: string) {
59:     const alert = await prisma.systemAlert.findUnique({ where: { id } });
60:     if (!alert) throw new ApiError(404, "System alert not found");
61:     return prisma.systemAlert.update({
62:       where: { id },
63:       data: {
64:         resolved: true,
65:         resolvedAt: new Date(),
66:         resolvedById: actorId,
67:       },
68:     });
69:   },
70:   async createAlert(data: {
71:     category: "USER" | "BILLING" | "SECURITY" | "STORAGE" | "PROCESSING" | "SYSTEM";
72:     severity: "INFO" | "WARNING" | "CRITICAL";
73:     title: string;
74:     message: string;
75:     metadata?: Record<string, unknown>;
76:   }) {
77:     return prisma.systemAlert.create({
78:       data: {
79:         category: data.category,
80:         severity: data.severity,
81:         title: data.title,
