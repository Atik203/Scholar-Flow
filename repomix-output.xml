443:   private createStructuredChunks(
444:     text: string,
445:     pageCount: number,
446:     chunkSize: number
447:   ): Array<{
448:     idx: number;
449:     page?: number;
450:     content: string;
451:     tokenCount?: number;
452:   }> {
453:     if (!text) return [];
454:     const chunks: Array<{
455:       idx: number;
456:       page?: number;
457:       content: string;
458:       tokenCount?: number;
459:     }> = [];
460:     const sections = this.identifyDocumentSections(text);
461:     let chunkIndex = 0;
462:     const safePageCount = Math.max(1, pageCount);
463:     for (const section of sections) {
464:       const sectionChunks = this.splitIntoChunks(section.content, chunkSize);
465:       for (const chunkText of sectionChunks) {
466:         const sanitized = this.sanitizeText(chunkText);
467:         if (sanitized.length > 0) {
468:           const estimatedPage = Math.min(
469:             Math.ceil((chunkIndex + 1) * (safePageCount / sections.length)),
470:             safePageCount
471:           );
472:           chunks.push({
473:             idx: chunkIndex++,
474:             page: estimatedPage,
475:             content: sanitized,
476:             tokenCount: this.estimateTokenCount(sanitized),
477:           });
478:         }
479:       }
480:     }
481:     return chunks;
482:   }
483:   private createStructuredChunksFromHtml(
484:     plainText: string,
485:     htmlContent: string,
486:     chunkSize: number
487:   ): Array<{
488:     idx: number;
489:     page?: number;
490:     content: string;
491:     htmlContent?: string;
492:     tokenCount?: number;
493:   }> {
494:     if (!plainText) return [];
495:     const chunks: Array<{
496:       idx: number;
497:       page?: number;
498:       content: string;
499:       htmlContent?: string;
500:       tokenCount?: number;
501:     }> = [];
502:     const htmlSections = this.parseHtmlSections(htmlContent);
503:     const textSections = this.identifyDocumentSections(plainText);
504:     let chunkIndex = 0;
505:     for (
506:       let i = 0;
507:       i < Math.max(htmlSections.length, textSections.length);
508:       i++
509:     ) {
510:       const htmlSection = htmlSections[i];
511:       const textSection = textSections[i];
512:       const content = textSection?.content || "";
513:       const htmlPart = htmlSection?.html || "";
514:       if (content.length > 0) {
515:         const contentChunks = this.splitIntoChunks(content, chunkSize);
516:         const htmlChunks = htmlPart
517:           ? this.splitHtmlIntoChunks(htmlPart, chunkSize)
518:           : [];
519:         for (let j = 0; j < contentChunks.length; j++) {
520:           const sanitizedContent = this.sanitizeText(contentChunks[j]);
521:           const sanitizedHtml = htmlChunks[j]
522:             ? this.sanitizeText(htmlChunks[j])
523:             : undefined;
524:           if (sanitizedContent.length > 0) {
525:             chunks.push({
526:               idx: chunkIndex++,
527:               page: 1, // DOCX is treated as single page
528:               content: sanitizedContent,
529:               htmlContent: sanitizedHtml,
530:               tokenCount: this.estimateTokenCount(sanitizedContent),
531:             });
532:           }
533:         }
534:       }
535:     }
536:     return chunks;
537:   }
538:   /**
539:    * Identify document sections based on headings and structure
540:    */
541:   private identifyDocumentSections(
542:     text: string
543:   ): Array<{ type: string; content: string }> {
544:     const sections: Array<{ type: string; content: string }> = [];
545:     // Split by common section patterns
546:     const sectionPatterns = [
547:       /^(abstract|summary|introduction|background|methodology|results|conclusion|references?|bibliography)[\s\n]/im,
548:       /^[IVX]+\.\s+/m, // Roman numerals
549:       /^\d+\.\s+/m, // Numbered sections
550:       /^#+\s+/m, // Markdown-style headers
551:     ];
552:     let currentSection = { type: "content", content: "" };
553:     const lines = text.split("\n");
554:     for (const line of lines) {
555:       let isNewSection = false;
556:       for (const pattern of sectionPatterns) {
557:         if (pattern.test(line)) {
558:           if (currentSection.content.trim().length > 0) {
559:             sections.push(currentSection);
560:           }
561:           currentSection = {
562:             type: line
563:               .trim()
564:               .toLowerCase()
565:               .replace(/[^\w\s]/g, "")
566:               .substring(0, 20),
567:             content: line + "\n",
568:           };
569:           isNewSection = true;
570:           break;
571:         }
572:       }
573:       if (!isNewSection) {
574:         currentSection.content += line + "\n";
575:       }
576:     }
577:     if (currentSection.content.trim().length > 0) {
578:       sections.push(currentSection);
579:     }
580:     if (sections.length === 0) {
581:       sections.push({ type: "content", content: text });
582:     }
583:     return sections;
584:   }
585:   private parseHtmlSections(
586:     html: string
587:   ): Array<{ type: string; html: string }> {
588:     const sections: Array<{ type: string; html: string }> = [];
589:     const htmlSectionRegex =
590:       /<(h[1-6]|div|section|article|p)([^>]*)>(.*?)<\/\1>/gis;
591:     let match;
592:     let lastIndex = 0;
593:     while ((match = htmlSectionRegex.exec(html)) !== null) {
594:       const [fullMatch, tag] = match;
595:       if (match.index > lastIndex) {
596:         const beforeContent = html.slice(lastIndex, match.index).trim();
597:         if (beforeContent) {
598:           sections.push({ type: "content", html: beforeContent });
599:         }
600:       }
601:       sections.push({
602:         type: tag.toLowerCase(),
603:         html: fullMatch,
604:       });
605:       lastIndex = match.index + fullMatch.length;
606:     }
607:     if (lastIndex < html.length) {
608:       const remainingContent = html.slice(lastIndex).trim();
609:       if (remainingContent) {
610:         sections.push({ type: "content", html: remainingContent });
611:       }
612:     }
613:     return sections;
614:   }
615:   private splitHtmlIntoChunks(html: string, maxSize: number): string[] {
616:     const chunks: string[] = [];
617:     const elements = html.split(/(<\/(?:p|div|h[1-6]|section|article)>)/i);
618:     let currentChunk = "";
619:     for (const element of elements) {
620:       if (
621:         currentChunk.length + element.length > maxSize &&
622:         currentChunk.length > 0
623:       ) {
624:         chunks.push(currentChunk.trim());
625:         currentChunk = element;
626:       } else {
627:         currentChunk += element;
628:       }
629:     }
630:     if (currentChunk.trim().length > 0) {
631:       chunks.push(currentChunk.trim());
632:     }
633:     return chunks;
634:   }
635:   /**
636:    * Split text into chunks while preserving sentence boundaries
637:    */
638:   private splitIntoChunks(text: string, maxSize: number): string[] {
639:     const chunks: string[] = [];
640:     let currentChunk = "";
641:     // Split by sentences first, then by paragraphs if needed
642:     const sentences = text.split(/(?<=[.!?])\s+/);
643:     for (const sentence of sentences) {
644:       if (
645:         currentChunk.length + sentence.length > maxSize &&
646:         currentChunk.length > 0
647:       ) {
648:         chunks.push(currentChunk.trim());
649:         currentChunk = sentence;
650:       } else {
651:         currentChunk += (currentChunk ? " " : "") + sentence;
652:       }
653:     }
654:     if (currentChunk.trim().length > 0) {
655:       chunks.push(currentChunk.trim());
656:     }
657:     return chunks;
658:   }
659:   /**
660:    * Estimate token count (rough approximation)
661:    */
662:   private estimateTokenCount(text: string): number {
663:     // Rough estimation: 1 token ≈ 4 characters
664:     return Math.ceil(text.length / 4);
665:   }
666:   /**
667:    * Sanitize text content to remove problematic characters
668:    */
669:   private sanitizeText(text: string): string {
670:     if (!text) return "";
671:     // Fast path: replace explicit null bytes first
672:     let cleaned = text.replace(/\0/g, "");
673:     // Filter out remaining problematic code points while preserving common whitespace
674:     const builder: string[] = [];
675:     for (const ch of cleaned) {
676:       const code = ch.codePointAt(0)!;
677:       // Remove C0 controls except tab (9), LF (10), CR (13)
678:       if (code < 32 && code !== 9 && code !== 10 && code !== 13) continue;
679:       // Delete DEL
680:       if (code === 127) continue;
681:       // Remove surrogate halves (invalid in UTF-8/UTF-32 strings)
682:       if (code >= 0xd800 && code <= 0xdfff) continue;
683:       // Remove non-characters U+FFFE, U+FFFF
684:       if (code === 0xfffe || code === 0xffff) continue;
685:       builder.push(ch);
686:     }
687:     cleaned = builder.join("");
688:     return cleaned.trim();
689:   }
690:   /**
691:    * Store chunks in database with enhanced content support
692:    */
693:   private async storeChunks(
694:     paperId: string,
695:     chunks: Array<{
696:       idx: number;
697:       page?: number;
698:       content: string;
699:       htmlContent?: string;
700:       tokenCount?: number;
701:     }>
702:   ): Promise<void> {
703:     // Delete existing chunks first
704:     await prisma.$executeRaw`
705:       DELETE FROM "PaperChunk"
706:       WHERE "paperId" = ${paperId}
707:     `;
708:     // Prepare chunks for insertion
709:     const prepared = chunks
710:       .map((chunk) => ({
711:         paperId,
