136:                     "{annotation.anchor.selectedText}"
137:                   </p>
138:                 </div>
139:               </div>
140:               <Separator />
141:             </>
142:           )}
143:           {}
144:           <div>
145:             <label className="text-sm font-medium text-gray-700 mb-2 block">
146:               Annotation Text
147:             </label>
148:             <Textarea
