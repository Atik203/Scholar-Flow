  9: import rateLimit from "express-rate-limit";
 10: import helmet from "helmet";
 11: import morgan from "morgan";
 12: import config from "./app/config";
 13: import globalErrorHandler from "./app/middleware/globalErrorHandler";
 14: import router from "./app/routes";
 15: import {
 16:   captureStripeRawBody,
 17:   isStripeWebhookPath,
 18: } from "./app/utils/stripeWebhook";
 19: const app: import("express").Express = express();
 20: const PORT = config.port || 5000;
 21: app.use(helmet() as unknown as RequestHandler);
 22: app.use(compression() as unknown as RequestHandler);
 23: const allowedOrigins = [
 24:   process.env.FRONTEND_URL || "http://localhost:3000",
 25:   "https://scholar-flow-ai.vercel.app",
 26: ];
 27: app.use(
 28:   cors({
 29:     origin: (origin, callback) => {
 30:       if (!origin || allowedOrigins.includes(origin)) {
 31:         callback(null, true);
 32:       } else {
 33:         callback(new Error("Not allowed by CORS"));
 34:       }
 35:     },
 36:     credentials: true,
 37:   }) as unknown as RequestHandler
 38: );
 39: const limiter = rateLimit({
 40:   windowMs: 15 * 60 * 1000,
 41:   max: 100,
 42:   message: "Too many requests from this IP, please try again later.",
 43: });
 44: app.use("/api/", limiter as unknown as RequestHandler);
 45: import { webhookController } from "./app/modules/Billing/webhook.controller";
 46: app.post(
 47:   "/webhooks/stripe",
 48:   express.raw({ type: "application/json" }),
 49:   captureStripeRawBody,
 50:   webhookController.handleStripeWebhook as unknown as RequestHandler
 51: );
 52: const jsonParser = express.json({ limit: "50mb" });
 53: const urlencodedParser = express.urlencoded({
 54:   extended: true,
 55:   limit: "50mb",
 56: });
 57: app.use((req: Request, res: Response, next: NextFunction) => {
 58:   if (isStripeWebhookPath(req)) {
 59:     return next();
 60:   }
 61:   return jsonParser(req, res, next);
 62: });
 63: app.use((req: Request, res: Response, next: NextFunction) => {
 64:   if (isStripeWebhookPath(req)) {
 65:     return next();
 66:   }
 67:   return urlencodedParser(req, res, next);
 68: });
 69: if (config.env !== "production") {
 70:   app.use(morgan("dev") as unknown as RequestHandler);
 71: }
 72: app.get("/", (req, res) => {
 73:   res.status(200).json({
 74:     success: true,
 75:     message: "Welcome to Scholar-Flow API",
 76:   });
 77: });
 78: app.get("/health", (req, res) => {
 79:   res.status(200).json({
 80:     success: true,
 81:     message: "Scholar-Flow API is running!",
 82:     timestamp: new Date().toISOString(),
 83:   });
 84: });
 85: app.use("/api", router);
 86: app.use(globalErrorHandler as unknown as RequestHandler);
 87: app.use("*", ((
 88:   req: import("express").Request,
