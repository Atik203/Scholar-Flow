  8: const getAllFromDB = async (params: any, options: IPaginationOptions) => {
  9:   const limit = options.limit || 10;
 10:   const page = options.page || 1;
 11:   const skip = (page - 1) * limit;
 12:   try {
 13:     let users: any[];
 14:     let totalResult: [{ count: bigint }];
 15:     if (params.search) {
 16:       users = await prisma.$queryRaw<any[]>`
 17:         SELECT id, email, role, "createdAt", "updatedAt"
 18:         FROM "User"
 19:         WHERE "isDeleted" = false
 20:           AND (email ILIKE ${`%${params.search}%`} OR role ILIKE ${`%${params.search}%`})
 21:         ORDER BY "createdAt" DESC
 22:         LIMIT ${limit} OFFSET ${skip}
 23:       `;
 24:       totalResult = await prisma.$queryRaw<[{ count: bigint }]>`
 25:         SELECT COUNT(*) as count
 26:         FROM "User"
 27:         WHERE "isDeleted" = false
 28:           AND (email ILIKE ${`%${params.search}%`} OR role ILIKE ${`%${params.search}%`})
 29:       `;
 30:     } else {
 31:       users = await prisma.$queryRaw<any[]>`
 32:         SELECT id, email, role, "createdAt", "updatedAt"
 33:         FROM "User"
 34:         WHERE "isDeleted" = false
 35:         ORDER BY "createdAt" DESC
 36:         LIMIT ${limit} OFFSET ${skip}
 37:       `;
 38:       totalResult = await prisma.$queryRaw<[{ count: bigint }]>`
 39:         SELECT COUNT(*) as count
 40:         FROM "User"
 41:         WHERE "isDeleted" = false
 42:       `;
 43:     }
 44:     const total = Number(totalResult[0]?.count || 0);
 45:     const totalPage = Math.ceil(total / limit);
 46:     return {
 47:       result: users,
 48:       meta: {
 49:         page,
 50:         limit,
 51:         total,
 52:         totalPage,
 53:       },
 54:     };
 55:   } catch (error) {
