100:                 draft.cancelAtPeriodEnd = true;
101:               } else if (arg.action === "reactivate") {
102:                 draft.cancelAtPeriodEnd = false;
103:               }
104:             }
105:           )
106:         );
107:         try {
108:           await queryFulfilled;
109:           dispatch(apiSlice.util.invalidateTags(["User"]));
110:         } catch {
111:           patchResult.undo();
112:         }
113:       },
114:       invalidatesTags: ["User"],
115:     }),
116:   }),
117: });
