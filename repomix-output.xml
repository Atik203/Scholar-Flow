350: }
351: async function findOAPdfByDoi(doi: string): Promise<Buffer | null> {
352:   try {
353:     const unpaywall = await axios.get(
354:       `https://api.unpaywall.org/v2/${encodeURIComponent(doi)}?email=dev@scholarflow.com`,
355:       { timeout: 8000 },
356:     );
357:     const bestLocation = unpaywall.data.best_oa_location || unpaywall.data.oa_locations?.[0];
358:     if (bestLocation?.url_for_pdf) {
359:       console.log(`[Import] Unpaywall found OA PDF for DOI ${doi}: ${bestLocation.url_for_pdf}`);
360:       return await downloadPdf(bestLocation.url_for_pdf);
361:     }
362:   } catch {
363:     console.warn(`[Import] Unpaywall lookup failed for DOI ${doi}`);
364:   }
365:   try {
366:     const ssRes = await axios.get(
367:       `https://api.semanticscholar.org/graph/v1/paper/DOI:${encodeURIComponent(doi)}?fields=openAccessPdf`,
368:       { timeout: 8000 },
369:     );
370:     const pdfUrl = ssRes.data?.openAccessPdf?.url;
371:     if (pdfUrl) {
372:       console.log(`[Import] Semantic Scholar found PDF for DOI ${doi}: ${pdfUrl}`);
373:       return await downloadPdf(pdfUrl);
374:     }
375:   } catch {
376:     console.warn(`[Import] Semantic Scholar lookup failed for DOI ${doi}`);
377:   }
378:   return null;
379: }
380: function detectSourceFromUrl(url: string): string {
381:   let hostname = "";
382:   let pathname = "";
383:   try {
384:     const parsed = new URL(url);
385:     hostname = parsed.hostname.replace("www.", "");
386:     pathname = parsed.pathname;
387:   } catch {
388:     return "unknown";
389:   }
390:   if (hostname.includes("arxiv.org")) return "arxiv";
391:   if (hostname.includes("ieeexplore.ieee.org")) return "ieee";
392:   if (hostname.includes("researchgate.net")) return "researchgate";
393:   if (hostname.includes("scholar.google.com")) return "google_scholar";
394:   if (hostname.includes("semanticscholar.org")) return "semantic_scholar";
395:   if (pathname.toLowerCase().endsWith(".pdf")) return "pdf";
396:   return "unknown";
397: }
398: async function extractMetadataFromHtml(url: string, html?: string): Promise<{
399:   title: string;
400:   authors: string[];
401:   year: number;
402:   abstract: string;
403:   doi: string | null;
404:   pdfUrl: string | null;
405: }> {
406:   try {
407:     const body =
408:       html ??
409:       ((await axios.get(url, { timeout: 15000, responseType: "text" })).data as string);
410:     const meta = parseMetaTags(body);
411:     const titleTag = stripHtmlTags(
412:       decodeEntities(body.match(/<title[^>]*>([\s\S]*?)<\/title>/i)?.[1] ?? ""),
413:     );
414:     const title =
415:       findMeta(meta, ["citation_title", "og:title", "twitter:title", "dc.title", "dcterms.title"]) ||
416:       titleTag ||
417:       "Untitled";
418:     const authors = [
419:       ...new Set(
420:         findMeta(meta, ["citation_author", "author", "article:author", "dc.creator"])
421:           .split("\u0000")
422:           .flatMap((a) => a.split(";"))
423:           .map((a) => decodeEntities(a).trim())
424:           .filter(Boolean),
425:       ),
426:     ];
427:     const dateStr = findMeta(meta, [
428:       "citation_publication_date",
429:       "citation_date",
430:       "article:published_time",
431:       "dc.date",
432:       "date",
433:     ]);
434:     const year = parseInt(dateStr.match(/\d{4}/)?.[0] || "", 10) || new Date().getFullYear();
435:     const abstract = stripHtmlTags(
436:       findMeta(meta, ["citation_abstract", "og:description", "twitter:description", "description"]),
437:     );
438:     const doi = findMeta(meta, ["citation_doi", "doi", "prism.doi"]) || null;
439:     let pdfUrl = findMeta(meta, ["citation_pdf_url"]) || null;
440:     if (pdfUrl && !pdfUrl.startsWith("http")) {
441:       try {
442:         pdfUrl = new URL(pdfUrl, url).toString();
443:       } catch {
444:         pdfUrl = null;
445:       }
446:     }
447:     return { title, authors, year, abstract, doi, pdfUrl };
448:   } catch {
449:     return { title: "Untitled", authors: [], year: new Date().getFullYear(), abstract: "", doi: null, pdfUrl: null };
450:   }
451: }
452: export class ImportService {
453:   static async importByDOI(input: string, workspaceId: string, uploaderId: string): Promise<ImportResult> {
454:     const cleanDoi = input
455:       .trim()
456:       .replace(/^https?:\/\/(dx\.)?doi\.org\//i, "")
457:       .replace(/^doi:\s*/i, "")
458:       .replace(/\/+$/, "");
459:     // arXiv DataCite DOIs (10.48550/arXiv.*) return 404 from Crossref —
460:     // route them through the arXiv importer instead.
461:     if (cleanDoi.toLowerCase().startsWith("10.48550/arxiv.")) {
462:       return this.importByArxiv(cleanDoi, workspaceId, uploaderId);
463:     }
464:     if (!/^10\.\d{4,9}\/[\w.()/:;<>\[\]_-]+$/i.test(cleanDoi)) {
465:       throw new ApiError(400, `Invalid DOI: "${input}"`);
466:     }
467:     const existing = await findExistingPaper(workspaceId, { doi: cleanDoi });
468:     if (existing) {
469:       console.log(`[Import] DOI ${cleanDoi}: already imported — returning existing paper`);
470:       return {
471:         paper: existing,
472:         source: "doi",
473:         externalId: cleanDoi,
474:         hasPdf: await paperHasPdf(existing.id),
475:         alreadyImported: true,
476:       };
477:     }
478:     let title = "";
479:     let authors: string[] = [];
480:     let year: number | null = null;
481:     let abstract = "";
482:     let keywords: string[] = [];
483:     let citedBy = 0;
484:     try {
485:       const res = await axios.get(
486:         `https://api.crossref.org/works/${encodeURIComponent(cleanDoi)}`,
487:         { headers: { "User-Agent": "ScholarFlow/1.0 (mailto:dev@scholarflow.com)" }, timeout: 10000 },
488:       );
489:       const msg = res.data.message;
490:       title = msg.title?.[0] || "";
491:       authors = (msg.author || [])
492:         .map((a: any) => `${a.given || ""} ${a.family || ""}`.trim())
493:         .filter(Boolean);
494:       year = msg.created?.["date-parts"]?.[0]?.[0] || msg.issued?.["date-parts"]?.[0]?.[0] || null;
495:       abstract = msg.abstract
496:         ? stripHtmlTags(decodeEntities(msg.abstract))
497:         : "";
498:       keywords = msg.subject || [];
499:       citedBy = msg["is-referenced-by-count"] || 0;
500:     } catch (err) {
501:       const status = (err as any)?.response?.status;
502:       if (status !== 404) throw err;
503:       try {
504:         const dc = await fetchDataCiteByDoi(cleanDoi);
505:         title = dc.title;
506:         authors = dc.authors;
507:         year = dc.year;
508:         abstract = dc.abstract;
509:       } catch (dcErr) {
510:         console.warn(`[Import] DOI ${cleanDoi}: DataCite fallback failed`, (dcErr as Error).message);
511:         throw new ApiError(404, `Paper not found for DOI ${cleanDoi} (Crossref and DataCite)`);
512:       }
513:     }
514:     if (!abstract || !authors.length || !title) {
515:       try {
516:         const oa = await fetchOpenAlexByDoi(cleanDoi);
517:         if (oa) {
518:           if (!title) title = oa.title;
519:           if (!authors.length) authors = oa.authors;
520:           if (!year) year = oa.year;
521:           if (!abstract) abstract = oa.abstract;
522:           if (!citedBy) citedBy = oa.citedBy;
523:         }
524:       } catch {
525:       }
526:     }
527:     if (!title) {
528:       throw new ApiError(404, `Could not fetch metadata for DOI ${cleanDoi}`);
529:     }
530:     const metadata = { authors, year: year || new Date().getFullYear(), source: "doi", doi: cleanDoi, keywords };
531:     const paper = await prisma.$queryRaw<any[]>`
532:       INSERT INTO "Paper" (id, "workspaceId", "uploaderId", title, abstract, metadata, source, doi, tags, language, "citationCount", "processingStatus", "createdAt", "updatedAt", "isDeleted")
533:       VALUES (gen_random_uuid(), ${workspaceId}, ${uploaderId}, ${title}, ${abstract || null}, ${JSON.stringify(metadata)}::jsonb, 'doi', ${cleanDoi}, ${keywords}::text[], null, ${citedBy}, 'UPLOADED', NOW(), NOW(), false)
534:       RETURNING id, title, source, doi
535:     `;
536:     const paperId = paper[0].id;
537:     let hasPdf = false;
538:     try {
539:       const pdfBuffer = await findOAPdfByDoi(cleanDoi);
540:       if (pdfBuffer) {
