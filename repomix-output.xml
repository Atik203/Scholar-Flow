220:                   {thread.isResolved ? (
221:                     <>
222:                       <XCircle className="h-4 w-4 mr-2" />
223:                       Mark as Unresolved
224:                     </>
225:                   ) : (
226:                     <>
227:                       <CheckCircle className="h-4 w-4 mr-2" />
