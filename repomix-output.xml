s\n  role                   Role      @default(RESEARCHER)\n  emailVerified          DateTime? // When email was verified\n  emailVerificationToken String? // For email verification\n\n  // Onboarding flow fields (Phase 2)\n  onboardingCompleted Boolean @default(false)\n  onboardingStep      Int     @default(0)\n\n  // Two-factor authentication (TOTP) — encrypted at rest\n  twoFactorSecret  String? // AES-256-GCM ciphertext (iv:tag:cipher)\n  twoFactorEnabled Boolean @default(false)\n\n  // Stripe subscription fields\n  stripeCustomerId       String?   @unique\n  stripeSubscriptionId   String?   @unique\n  stripePriceId          String? // The price ID of the current subscription\n  stripeCurrentPeriodEnd DateTime? // When the current subscription period ends\n\n  // Auth.js relations\n  accounts Account[]\n  sessions Session[]\n\n  // App relations\n  memberships               WorkspaceMember[]\n  workspacesOwned           Workspace[]           @relation(\"WorkspaceOwner\")\n  uploadedPapers            Paper[]               @relation(\"PaperUploader\")\n  annotations               Annotation[]\n  collections               Collection[]          @relation(\"CollectionOwner\")\n  subscriptions             Subscription[]\n  payments                  Payment[]\n  searchHistory             SearchHistory[]\n  notifications             Notification[]        @relation(\"UserNotifications\")\n  triggeredNotifications    Notification[]        @relation(\"NotificationActor\")\n  usageEvents               UsageEvent[]\n  activities                ActivityLog[]\n  aiInsightThreads          AIInsightThread[]\n  aiInsightMessagesAuthored AIInsightMessage[]    @relation(\"AIInsightMessageAuthor\")\n  // Sharing relations\n  collectionInvitesSent     CollectionMember[]    @relation(\"CollectionMemberInvitedBy\")\n  workspaceInvitesReceived  WorkspaceInvitation[] @relation(\"WorkspaceInvitationUser\")\n  workspaceInvitesSent      WorkspaceInvitation[] @relation(\"WorkspaceInvitationInvitedBy\")\n\n  // Token relations\n  tokens        UserToken[]\n  researchNotes ResearchNote[]\n\n  // Phase 6 - Notebook hierarchy\n  notebooks        Notebook[]\n  notebookSections NotebookSection[]\n\n  // New Phase 2 features\n  citationExports    CitationExport[]\n  discussionThreads  DiscussionThread[]\n  discussionMessages DiscussionMessage[]\n  activityLogEntries ActivityLogEntry[]\n\n  // Phase 10 — Paper version history\n  paperVersions PaperVersion[]\n\n  // Phase 10 — Global AI assistant conversations\n  aiConversations AIConversation[]\n\n  // Email sharing — papers shared to an email with view/edit permission\n  paperSharesShared PaperShare[] @relation(\"PaperShareSharedBy\")\n\n  // Phase 3 - User preferences\n  preference UserPreference?\n\n  createdAt         DateTime            @default(now())\n  updatedAt         DateTime            @updatedAt\n  isDeleted         Boolean             @default(false)\n  AnnotationVersion AnnotationVersion[]\n  CollectionPaper   CollectionPaper[]\n  CollectionMember  CollectionMember[]\n\n  // Phase 7 - admin / moderation / alerts / api keys\n  adminReportsCreated    AdminReport[]   @relation(\"AdminReportCreator\")\n  resolvedSystemAlerts   SystemAlert[]   @relation(\"SystemAlertResolver\")\n  apiKeysCreated         ApiKey[]        @relation(\"ApiKeyCreator\")\n  contentReportsFiled    ContentReport[] @relation(\"ContentReporter\")\n  contentReportsAssigned ContentReport[] @relation(\"ContentReportAssignee\")\n  contentReportsResolved ContentReport[] @relation(\"ContentReportResolver\")\n\n  // Login tracking\n  lastLoginProvider String? // \"google\" | \"github\" | \"credentials\" | \"magic-link\"\n  loginHistory      LoginHistory[]\n\n  // Optimized indexes for common query patterns\n  @@index([isDeleted, createdAt]) // For listing active users sorted by creation\n  @@index([role, isDeleted, createdAt]) // For role-filtered queries\n  @@index([email, isDeleted]) // For email lookups with deletion filter\n}\n\nmodel Workspace {\n  id          String                @id @default(uuid())\n  name        String\n  description String?\n  ownerId     String\n  owner       User                  @relation(\"WorkspaceOwner\", fields: [ownerId], references: [id])\n  members     WorkspaceMember[]\n  invitations WorkspaceInvitation[]\n  collections Collection[]\n  papers      Paper[]\n  activities  ActivityLog[]\n\n  // New Phase 2 features\n  discussionThreads  DiscussionThread[]\n  activityLogEntries ActivityLogEntry[]\n  aiContextCaches    AIContextCache[]\n\n  // Phase 5 - denormalized color and visibility for fast list/sort without settings join\n  color      String              @default(\"blue\")\n  visibility WorkspaceVisibility @default(PRIVATE)\n  settings   WorkspaceSettings?\n\n  createdAt    DateTime       @default(now())\n  updatedAt    DateTime       @updatedAt\n  isDeleted    Boolean        @default(false)\n  Subscription Subscription[]\n  UsageEvent   UsageEvent[]\n\n  @@index([ownerId, isDeleted, createdAt]) // For user's active workspaces\n  @@index([isDeleted, visibility]) // For visibility-filtered listings\n}\n\nmodel WorkspaceMember {\n  id          String        @id @default(uuid())\n  workspaceId String\n  userId      String\n  role        WorkspaceRole @default(EDITOR)\n  joinedAt    DateTime      @default(now())\n\n  workspace Workspace @relation(fields: [workspaceId], references: [id])\n  user      User      @relation(fields: [userId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([workspaceId, userId])\n  @@index([userId, isDeleted]) // For user's workspace lookups\n  @@index([workspaceId, isDeleted, role]) // For workspace member filtering by role\n}\n\nmodel WorkspaceInvitation {\n  id          String           @id @default(uuid())\n  workspaceId String\n  userId      String\n  role        WorkspaceRole    @default(EDITOR)\n  invitedAt   DateTime         @default(now())\n  // Invitation workflow fields\n  status      MembershipStatus @default(PENDING)\n  invitedById String?\n  acceptedAt  DateTime?\n  declinedAt  DateTime?\n  expiresAt   DateTime? // Invites expire (INVITE_EXPIRY_DAYS); swept hourly by invitationSweeper\n\n  workspace Workspace @relation(fields: [workspaceId], references: [id])\n  user      User      @relation(\"WorkspaceInvitationUser\", fields: [userId], references: [id])\n  invitedBy User?     @relation(\"WorkspaceInvitationInvitedBy\", fields: [invitedById], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([workspaceId, userId])\n  @@index([workspaceId, status, isDeleted]) // For pending invitation lookups\n  @@index([userId, status, isDeleted]) // For user's pending invitations\n}\n\n// Phase 5 - Workspace settings (1:1 with Workspace)\n// Source of truth for advanced workspace configuration.\n// Color and visibility are denormalized on Workspace for fast list rendering.\nmodel WorkspaceSettings {\n  id          String    @id @default(uuid())\n  workspaceId String    @unique\n  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)\n\n  // Visual identity\n  color         String  @default(\"blue\") // blue | purple | green | orange | pink\n  coverImageKey String? // S3 key for optional banner\n  iconKey       String? // S3 key for optional icon\n\n  // Privacy & sharing\n  allowExternalSharing Boolean @default(false)\n  allowDownload        Boolean @default(true)\n\n  // Member defaults\n  defaultMemberRole      WorkspaceRole @default(EDITOR)\n  requireApprovalForJoin Boolean       @default(false)\n\n  // Team feature toggles\n  allowMemberInvites     Boolean @default(true)\n  allowPublicCollections Boolean @default(true)\n  aiFeaturesEnabled      Boolean @default(true)\n\n  // Security\n  enforce2FAForMembers Boolean  @default(false)\n  allowedEmailDomains  String[] @default([])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([workspaceId, isDeleted])\n}\n\nmodel Paper {\n  id          String  @id @default(uuid())\n  workspaceId String\n  uploaderId  String\n  title       String\n  abstract    String?\n  metadata    Json    @db.JsonB\n  source      String? // 'upload' | 'arxiv' | 'openalex' | 'doi' | 'semantic-scholar' | 'editor'\n  doi         String? @unique\n\n  // Editor-specific fields\n  isDraft     Boolean @default(false) // True for draft papers created in editor\n  isPublished Boolean @default(false) // True when draft is published/finalized\n\n  // Processing lifecycle fields\n  processingStatus PaperProcessingStatus @default(UPLOADED)\n  processingError  String?\n  processedAt      DateTime?\n\n  // Document preview support - for enhanced text extraction view\n  previewFileKey      String? // S3 key for preview PDF (converted from DOCX)\n  previewMimeType     String? // MIME type of preview file (usually application/pdf)\n  originalMimeType    String? // Original uploaded MIME type (preserves DOCX, DOC, PDF)\n  originalFormat      String? // \"pdf\" | \"docx\" | \"doc\" — the format the user uploaded\n  processingStage     String? // Current stage: \"extracting\" | \"ocr\" | \"converting\" | \"chunking\" | \"embedding\"\n  processingStartedAt DateTime? // When processing began (for timeout detection)\n  contentHtml         String? // Sanitized HTML content for rich text editor\n  extractionVersion   Int       @default(1) // Version for extraction algorithm\n\n  // Phase 4 - Enhanced metadata for figma-make UI\n  tags          String[] @default([]) // User-defined tags for filtering and grouping\n  language      String? // ISO language code (e.g., \"en\", \"es\", \"fr\")\n  citationCount Int      @default(0) // External citation count (populated on import/extraction)\n\n  uploader          User               @relation(\"PaperUploader\", fields: [uploaderId], references: [id])\n  workspace         Workspace          @relation(fields: [workspaceId], references: [id])\n  file              PaperFile?\n  chunks            PaperChunk[]\n  citationsFrom     Citation[]         @relation(\"CitationsFrom\")\n  citationsTo       Citation[]         @relation(\"CitationsTo\")\n  annotations       Annotation[]\n  collectionJoins   CollectionPaper[]\n  aiSummaries       AISummary[]\n  aiInsightThreads  AIInsightThread[]\n  aiInsightMessages AIInsightMessage[]\n  researchNotes     ResearchNote[]\n  aiKeyPoints       AIKeyPoint[]\n  aiMetadata        AIMetadata?\n  aiContextCaches   AIContextCache[]\n  paperShares       PaperShare[]\n\n  // New Phase 2 features\n  citationExports   CitationExport[]\n  discussionThreads DiscussionThread[]\n\n  createdAt    DateTime       @default(now())\n  updatedAt    DateTime       @updatedAt\n  isDeleted    Boolean        @default(false)\n  UsageEvent   UsageEvent[]\n  PaperVersion PaperVersion[]\n\n  // Optimized indexes for common query patterns\n  @@index([processingStatus, createdAt]) // For processing status dashboards\n  @@index([uploaderId, workspaceId, isDeleted, createdAt]) // Hot path: user's papers in workspace\n  @@index([workspaceId, isDeleted, createdAt]) // Workspace paper listings\n  @@index([uploaderId, isDeleted]) // User's all papers (cross-workspace)\n  @@index([isDraft, isDeleted]) // Filter draft papers\n  @@index([doi, isDeleted]) // DOI lookups\n  @@index([tags]) // Tag-based filtering (figma-make UI)\n}\n\n/**\n * Email sharing — grants view/edit access to a paper for a specific email.\n * One row per paper+email (upserted); soft-delete revokes access.\n */\nmodel PaperShare {\n  id         String   @id @default(uuid())\n  paperId    String\n  email      String\n  permission String // \"view\" | \"edit\"\n  sharedById String\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n  isDeleted  Boolean  @default(false)\n\n  paper    Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)\n  sharedBy User  @relation(\"PaperShareSharedBy\", fields: [sharedById], references: [id])\n\n  @@unique([paperId, email])\n  @@index([email, isDeleted])\n}\n\nmodel PaperFile {\n  id               String    @id @default(uuid())\n  paperId          String    @unique\n  storageProvider  String // s3 | gcs | local\n  objectKey        String\n  contentType      String?\n  sizeBytes        Int?\n  pageCount        Int?\n  checksum         String?\n  originalFilename String? // Original uploaded filename\n  extractedAt      DateTime? // When text extraction completed\n\n  paper Paper @relation(fields: [paperId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n}\n\nmodel PaperChunk {\n  id         String                 @id @default(uuid())\n  paperId    String\n  idx        Int\n  page       Int?\n  content    String\n  embedding  Unsupported(\"vector\")?\n  tokenCount Int?\n\n  paper Paper @relation(fields: [paperId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([paperId, idx])\n  @@index([paperId])\n}\n\nmodel PaperVersion {\n  id          String   @id @default(uuid())\n  paperId     String\n  contentHtml String\n  title       String?\n  version     Int\n  savedAt     DateTime @default(now())\n  savedById   String?\n  sizeBytes   Int?\n\n  paper   Paper? @relation(fields: [paperId], references: [id], onDelete: Cascade)\n  savedBy User?  @relation(fields: [savedById], references: [id], onDelete: SetNull)\n\n  @@unique([paperId, version])\n  @@index([paperId, savedAt(sort: Desc)])\n  @@index([savedById])\n}\n\nmodel Citation {\n  id            String  @id @default(uuid())\n  sourcePaperId String\n  targetPaperId String\n  context       String?\n  location      String?\n\n  sourcePaper Paper @relation(\"CitationsFrom\", fields: [sourcePaperId], references: [id])\n  targetPaper Paper @relation(\"CitationsTo\", fields: [targetPaperId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([sourcePaperId, targetPaperId, context])\n  @@index([targetPaperId, isDeleted]) // For citation lookups\n  @@index([sourcePaperId, isDeleted]) // Implicit from unique, but explicit for clarity\n}\n\nmodel Annotation {\n  id            String         @id @default(uuid())\n  paperId       String\n  userId        String\n  type          AnnotationType @default(HIGHLIGHT)\n  anchor        Json           @db.JsonB\n  text          String\n  version       Int            @default(1)\n  parentId      String?\n  color         String         @default(\"#FFEB3B\")\n  positionIndex Int            @default(0)\n  metadata      Json?\n\n  parent   Annotation?  @relation(\"AnnotationThread\", fields: [parentId], references: [id])\n  children Annotation[] @relation(\"AnnotationThread\")\n\n  paper    Paper               @relation(fields: [paperId], references: [id])\n  user     User                @relation(fields: [userId], references: [id])\n  versions AnnotationVersion[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([paperId, isDeleted, createdAt]) // For paper annotations sorted by date\n  @@index([userId, isDeleted]) // For user's annotations\n  @@index([parentId, isDeleted]) // For annotation threads\n  @@index([userId, paperId]) // For user's annotations on a specific paper\n}\n\nmodel AnnotationVersion {\n  id           String   @id @default(uuid())\n  annotationId String\n  version      Int\n  text         String\n  changedById  String\n  timestamp    DateTime @default(now())\n\n  annotation Annotation @relation(fields: [annotationId], references: [id])\n  changedBy  User       @relation(fields: [changedById], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([annotationId, version])\n}\n\nmodel Collection {\n  id          String               @id @default(uuid())\n  workspaceId String\n  ownerId     String\n  name        String\n  description String?\n  // @deprecated Phase 4: kept for backward compat, will be removed in Phase 9.\n  // Prefer `visibility` field (CollectionVisibility enum) instead.\n  isPublic    Boolean              @default(false)\n  // Phase 4 - figma-make UI: replaces isPublic with a 3-state enum\n  visibility  CollectionVisibility @default(PRIVATE)\n  tags        String[]             @default([]) // User-defined tags for filtering\n  coverImage  String? // S3 key or URL for the collection cover image\n  color       String? // UI accent color (e.g., \"blue\", \"purple\", \"green\", \"orange\", \"pink\")\n\n  owner     User      @relation(\"CollectionOwner\", fields: [ownerId], references: [id])\n  workspace Workspace @relation(fields: [workspaceId], references: [id])\n\n  papers  CollectionPaper[]\n  members CollectionMember[]\n\n  // New Phase 2 features\n  citationExports   CitationExport[]\n  discussionThreads DiscussionThread[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([workspaceId, isDeleted])\n  @@index([ownerId, isDeleted, createdAt]) // Optimized for getUserCollections query\n  @@index([tags]) // Tag-based filtering (figma-make UI)\n  @@index([visibility, isDeleted]) // Visibility-filtered collection listings\n}\n\nmodel CollectionPaper {\n  id           String                @id @default(uuid())\n  collectionId String\n  paperId      String\n  addedById    String\n  addedAt      DateTime              @default(now())\n  // Phase 4 - figma-make UI: per-user reading status and star toggle\n  status       CollectionPaperStatus @default(TO_READ)\n  isStarred    Boolean               @default(false)\n\n  collection Collection @relation(fields: [collectionId], references: [id])\n  paper      Paper      @relation(fields: [paperId], references: [id])\n  addedBy    User       @relation(fields: [addedById], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([collectionId, paperId])\n  @@index([collectionId, isDeleted, addedAt]) // Collection's papers sorted by add date\n  @@index([paperId, isDeleted]) // Paper's collections lookup\n  @@index([addedById, isDeleted]) // Papers added by specific user\n  @@index([collectionId, status, isStarred, isDeleted]) // Filter by status/starred in figma-make collection detail\n}\n\nmodel CollectionMember {\n  id           String               @id @default(uuid())\n  collectionId String\n  userId       String\n  role         Role                 @default(RESEARCHER) // mirrors User.role; added 2026-08-10 (raw SQL used it since Phase 4 but the column was never migrated)\n  permission   CollectionPermission @default(EDIT) // Collection-specific permission (VIEW or EDIT)\n  invitedAt    DateTime             @default(now())\n  // Invitation workflow fields\n  status       MembershipStatus     @default(PENDING)\n  invitedById  String?\n  acceptedAt   DateTime?\n  declinedAt   DateTime?\n  expiresAt    DateTime? // Invites expire (INVITE_EXPIRY_DAYS); swept hourly by invitationSweeper\n\n  collection Collection @relation(fields: [collectionId], references: [id])\n  user       User       @relation(fields: [userId], references: [id])\n  invitedBy  User?      @relation(\"CollectionMemberInvitedBy\", fields: [invitedById], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([collectionId, userId])\n  @@index([collectionId, status, isDeleted]) // For active member lookups\n  @@index([userId, isDeleted]) // For user's collection memberships\n}\n\nmodel SearchHistory {\n  id      String @id @default(uuid())\n  userId  String\n  query   String\n  filters Json?  @db.JsonB\n  results Json?  @db.JsonB\n\n  user User @relation(fields: [userId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([userId, createdAt])\n}\n\nmodel AISummary {\n  id         String @id @default(uuid())\n  paperId    String\n  model      String\n  summary    String\n  promptHash String\n\n  paper Paper @relation(fields: [paperId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([paperId, model, promptHash])\n}\n\nmodel AIInsightThread {\n  id       String  @id @default(uuid())\n  paperId  String\n  userId   String\n  title    String?\n  metadata Json?   @db.JsonB\n\n  paper    Paper              @relation(fields: [paperId], references: [id])\n  user     User               @relation(fields: [userId], references: [id])\n  messages AIInsightMessage[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([paperId, userId, isDeleted], map: \"idx_ai_insight_thread_lookup\")\n  @@index([userId, createdAt], map: \"idx_ai_insight_thread_user\")\n}\n\nmodel AIInsightMessage {\n  id          String  @id @default(uuid())\n  threadId    String\n  paperId     String\n  role        String\n  content     String\n  metadata    Json?   @db.JsonB\n  createdById String?\n\n  thread    AIInsightThread @relation(fields: [threadId], references: [id])\n  paper     Paper           @relation(fields: [paperId], references: [id])\n  createdBy User?           @relation(\"AIInsightMessageAuthor\", fields: [createdById], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([threadId, createdAt], map: \"idx_ai_insight_msg_thread\")\n  @@index([paperId, createdAt], map: \"idx_ai_insight_msg_paper\")\n}\n\n// Phase 10 — Global AI Assistant (floating chat)\nmodel AIConversation {\n  id          String  @id @default(uuid())\n  userId      String\n  title       String?\n  model       String? // e.g. \"gpt-4o-mini\", \"gemini-2.5-flash-lite\"\n  workspaceId String?\n  context     Json?   @db.JsonB // { type: \"paper\"|\"collection\"|\"workspace\", id: \"...\", title: \"...\" }\n\n  user     User                    @relation(fields: [userId], references: [id])\n  messages AIConversationMessage[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([userId, updatedAt(sort: Desc)])\n}\n\nmodel AIConversationMessage {\n  id             String  @id @default(uuid())\n  conversationId String\n  role           String // \"user\" | \"assistant\"\n  content        String\n  model          String? // which model generated this response\n  tokensUsed     Int?\n  costCents      Float?\n  metadata       Json?   @db.JsonB\n\n  conversation AIConversation @relation(fields: [conversationId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([conversationId, createdAt])\n}\n\n// Phase 10 — Admin-managed AI provider catalog.\n// Lets admins enable / disable individual models, set the default for\n// the floating AI assistant, and reorder display via displayOrder.\n// Add-only migration; no destructive changes to existing tables.\nmodel AIProvider {\n  id              String  @id @default(uuid())\n  // Logical provider key: openai | anthropic | google | deepseek | minimax\n  provider        String\n  // Model identifier passed to the SDK (e.g. \"gpt-4o-mini\", \"claude-3-5-sonnet-latest\")\n  model           String\n  // Human-readable label shown in UI dropdowns (e.g. \"GPT-4o Mini (OpenAI - Fast)\")\n  displayName     String\n  enabled         Boolean @default(true)\n  isDefault       Boolean @default(false)\n  description     String?\n  // Env-var name to look up the API key (e.g. \"OPENAI_API_KEY\").\n  // Optional so a provider can be configured without a key (e.g. for catalog-only display).\n  apiKeyEnvName   String?\n  // Cost per 1K tokens (in USD cents) for cost tracking in analytics.\n  inputCostPer1k  Float?\n  outputCostPer1k Float?\n  // Lower values appear first in admin lists and user dropdowns.\n  displayOrder    Int     @default(0)\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([provider, model])\n  @@index([enabled, displayOrder])\n  @@index([isDefault])\n}\n\n// Phase 10 — Persisted AI Key Points extracted from papers.\n// Caches key findings/claims so they're reused across page loads\n// instead of being regenerated on every click.\nmodel AIKeyPoint {\n  id         String   @id @default(uuid())\n  paperId    String\n  content    String\n  category   String? // \"claim\" | \"finding\" | \"methodology\" | \"limitation\" | \"contribution\"\n  order      Int\n  model      String?\n  tokensUsed Int?\n  paper      Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n  isDeleted  Boolean  @default(false)\n\n  @@unique([paperId, order])\n  @@index([paperId, isDeleted])\n}\n\n// Phase 10 — AI-generated / improved paper metadata.\n// Separate from Paper.metadata JSONB for typed access, avoiding\n// the \"WHERE metadata->>'aiTitle' IS NULL\" anti-pattern.\n// User can accept, modify, or reject AI suggestions here.\nmodel AIMetadata {\n  id                String   @id @default(uuid())\n  paperId           String\n  title             String? // AI-improved title\n  abstract          String? // AI-generated abstract\n  keywords          String[]\n  tags              String[]\n  researchDomain    String? // \"computer-science\" | \"biology\" etc.\n  publicationType   String? // \"journal\" | \"conference\" | \"preprint\" | \"thesis\"\n  readingLevel      String? // \"beginner\" | \"intermediate\" | \"advanced\"\n  methodology       String?\n  researchQuestions String[]\n  contributions     String[]\n  limitations       String[]\n  futureWork        String[]\n  model             String?\n  tokensUsed        Int?\n  paper             Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)\n  createdAt         DateTime @default(now())\n  updatedAt         DateTime @updatedAt\n  isDeleted         Boolean  @default(false)\n\n  @@unique([paperId])\n}\n\n// Phase 10 — Generic AI context cache.\n// Stores parsed text, structured document representations, and other\n// pre-processed content so downstream AI features don't re-read / re-chunk\n// the same paper text. Keeps token usage predictable.\nmodel AIContextCache {\n  id          String     @id @default(uuid())\n  paperId     String?\n  workspaceId String?\n  contentType String // \"parsed_text\" | \"structured_doc\" | \"chunks_index\" | \"summary_snapshot\"\n  content     String\n  tokenCount  Int?\n  model       String?\n  expiresAt   DateTime?\n  paper       Paper?     @relation(fields: [paperId], references: [id], onDelete: Cascade)\n  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)\n  createdAt   DateTime   @default(now())\n  updatedAt   DateTime   @updatedAt\n\n  @@index([paperId, contentType])\n  @@index([workspaceId, contentType])\n  @@index([expiresAt])\n}\n\nmodel Plan {\n  id            String  @id @default(uuid())\n  code          String  @unique\n  name          String\n  priceCents    Int\n  currency      String\n  interval      String // month, year, etc.\n  stripePriceId String?\n  features      Json?   @db.JsonB\n  active        Boolean @default(true)\n\n  subscriptions Subscription[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n}\n\nmodel Subscription {\n  id                     String             @id @default(uuid())\n  userId                 String\n  workspaceId            String?\n  planId                 String\n  status                 SubscriptionStatus\n  provider               PaymentProvider\n  providerCustomerId     String? // Stripe customer ID\n  providerSubscriptionId String? // Stripe subscription ID\n  cancelAtPeriodEnd      Boolean            @default(false)\n  currentPeriodStart     DateTime?\n  currentPeriodEnd       DateTime?\n  canceledAt             DateTime?\n  trialStart             DateTime?\n  trialEnd               DateTime?\n  seats                  Int                @default(1) // Number of seats/team members\n  startedAt              DateTime           @default(now())\n  expiresAt              DateTime\n\n  user      User       @relation(fields: [userId], references: [id])\n  workspace Workspace? @relation(fields: [workspaceId], references: [id])\n  plan      Plan       @relation(fields: [planId], references: [id])\n  payments  Payment[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([userId, status, isDeleted]) // For user's active subscriptions\n  @@index([workspaceId, status, isDeleted]) // For workspace subscriptions\n  @@index([status, expiresAt]) // For expiration checks\n  @@index([providerSubscriptionId]) // For Stripe subscription lookups\n  @@index([providerCustomerId, status]) // For customer subscription queries\n}\n\nmodel Payment {\n  id             String          @id @default(uuid())\n  userId         String\n  subscriptionId String?\n  provider       PaymentProvider\n  amountCents    Int\n  currency       String\n  transactionId  String          @unique\n  status         PaymentStatus\n  raw            Json?           @db.JsonB\n\n  user         User          @relation(fields: [userId], references: [id])\n  subscription Subscription? @relation(fields: [subscriptionId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([userId, createdAt])\n}\n\nmodel WebhookEvent {\n  id          String          @id @default(uuid())\n  provider    PaymentProvider\n  eventId     String // Stripe event ID (e.g., evt_xxx)\n  type        String // Event type (e.g., checkout.session.completed)\n  payload     Json            @db.JsonB\n  receivedAt  DateTime        @default(now())\n  processedAt DateTime?\n  status      String // pending, processed, failed\n  error       String?\n  attempts    Int             @default(0) // Number of processing attempts\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([provider, eventId])\n  @@index([status, receivedAt]) // For retry queries\n  @@index([type, processedAt]) // For event type analytics\n}\n\nmodel UsageEvent {\n  id          String  @id @default(uuid())\n  userId      String\n  workspaceId String?\n  kind        String // \"upload\", \"ai_summarize\", \"semantic_search\", etc.\n  units       Int     @default(1)\n  paperId     String?\n\n  user      User       @relation(fields: [userId], references: [id])\n  workspace Workspace? @relation(fields: [workspaceId], references: [id])\n  paper     Paper?     @relation(fields: [paperId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([userId, createdAt])\n}\n\nmodel ActivityLog {\n  id          String  @id @default(uuid())\n  userId      String?\n  workspaceId String?\n  entity      String\n  entityId    String\n  action      String\n  details     Json?   @db.JsonB\n\n  user      User?      @relation(fields: [userId], references: [id])\n  workspace Workspace? @relation(fields: [workspaceId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([workspaceId, createdAt])\n}\n\n// -------- Auth.js (NextAuth) models --------\n\nmodel Account {\n  id                String  @id @default(uuid())\n  userId            String\n  type              String\n  provider          String\n  providerAccountId String\n  refresh_token     String? @db.Text\n  access_token      String? @db.Text\n  expires_at        Int?\n  token_type        String?\n  scope             String?\n  id_token          String? @db.Text\n  session_state     String?\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([provider, providerAccountId])\n  @@index([userId])\n}\n\nmodel Session {\n  id           String   @id @default(uuid())\n  sessionToken String   @unique\n  userId       String\n  expires      DateTime\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  // Optimized index - composite is sufficient for session lookups\n  @@index([userId, expires])\n  @@index([expires, isDeleted]) // For cleanup queries\n}\n\nmodel LoginHistory {\n  id        String   @id @default(uuid())\n  userId    String\n  provider  String // \"google\" | \"github\" | \"credentials\" | \"magic-link\"\n  ip        String?\n  userAgent String?\n  device    String? // derived from user-agent (e.g. \"Chrome on MacOS\")\n  location  String? // geocoded from IP (e.g. \"New York, USA\")\n  createdAt DateTime @default(now())\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId, createdAt])\n}\n\nmodel VerificationToken {\n  id         String   @id @default(uuid())\n  identifier String\n  token      String   @unique\n  expires    DateTime\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@unique([identifier, token])\n}\n\nmodel UserToken {\n  id        String    @id @default(uuid())\n  userId    String\n  token     String    @unique // Hashed token\n  type      TokenType\n  expiresAt DateTime\n  used      Boolean   @default(false)\n  createdAt DateTime  @default(now())\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([token, used]) // For token validation\n  @@index([userId, type, used]) // For user's active tokens by type\n  @@index([expiresAt, used]) // For cleanup queries\n}\n\nenum TokenType {\n  PASSWORD_RESET\n  EMAIL_VERIFICATION\n  MAGIC_LINK\n}\n\n// Invitation/member status for collection sharing\nenum MembershipStatus {\n  PENDING\n  ACCEPTED\n  DECLINED\n  EXPIRED\n}\n\nmodel ResearchNote {\n  id        String   @id @default(uuid())\n  userId    String\n  paperId   String? // Optional - can be general notes\n  title     String\n  content   String\n  tags      String[] // Array of tags\n  isPrivate Boolean  @default(true)\n\n  // Phase 6 - Optional notebook/section organization (matches figma ResearchNotesPage)\n  notebookId String?\n  sectionId  String?\n  noteType   NoteType       @default(QUICK)\n  visibility NoteVisibility @default(PRIVATE)\n  isStarred  Boolean        @default(false)\n  wordCount  Int            @default(0)\n  excerpt    String?\n\n  user     User             @relation(fields: [userId], references: [id])\n  paper    Paper?           @relation(fields: [paperId], references: [id])\n  notebook Notebook?        @relation(fields: [notebookId], references: [id], onDelete: SetNull)\n  section  NotebookSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([userId, isDeleted, updatedAt]) // For user's notes sorted by update\n  @@index([paperId, isDeleted]) // For paper-specific notes\n  @@index([paperId, userId]) // For notes on a paper filtered by user\n  @@index([tags]) // For tag-based searches\n  @@index([notebookId, isDeleted, updatedAt]) // Phase 6: notebook-scoped note listing\n  @@index([sectionId, isDeleted]) // Phase 6: section-scoped note listing\n  @@index([noteType, isDeleted]) // Phase 6: type filter chip\n  @@index([userId, isStarred, isDeleted]) // Phase 6: starred notes\n}\n\n// Phase 6 - Notebook hierarchy (matches figma folders + IMPLEMENTATION.md)\nmodel Notebook {\n  id          String  @id @default(uuid())\n  userId      String\n  name        String\n  description String?\n  color       String  @default(\"blue\") // blue|green|purple|orange|pink\n  isStarred   Boolean @default(false)\n\n  user     User              @relation(fields: [userId], references: [id])\n  sections NotebookSection[]\n  notes    ResearchNote[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([userId, isDeleted, updatedAt]) // For user's notebooks sorted by update\n}\n\nmodel NotebookSection {\n  id         String @id @default(uuid())\n  notebookId String\n  userId     String\n  name       String\n  order      Int    @default(0)\n\n  notebook Notebook       @relation(fields: [notebookId], references: [id], onDelete: Cascade)\n  user     User           @relation(fields: [userId], references: [id])\n  notes    ResearchNote[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([notebookId, isDeleted, order]) // Sections within a notebook, ordered\n}\n\n// Citation Export System\nmodel CitationExport {\n  id           String         @id @default(uuid())\n  userId       String\n  paperId      String?\n  collectionId String?\n  format       CitationFormat\n  content      String // The actual citation content\n  metadata     Json?          @db.JsonB // Additional format-specific metadata\n  exportedAt   DateTime       @default(now())\n\n  user       User        @relation(fields: [userId], references: [id])\n  paper      Paper?      @relation(fields: [paperId], references: [id])\n  collection Collection? @relation(fields: [collectionId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([userId, exportedAt]) // For user's export history\n  @@index([paperId, format]) // For paper-specific exports\n  @@index([collectionId, format]) // For collection exports\n  @@index([userId, isDeleted]) // For deletion-filtered user export queries\n}\n\nenum CitationFormat {\n  BIBTEX\n  ENDNOTE\n  APA\n  MLA\n  IEEE\n  CHICAGO\n  HARVARD\n  VANCOUVER\n  ACS\n}\n\n// Threaded Research Discussions\nmodel DiscussionThread {\n  id           String   @id @default(uuid())\n  paperId      String?\n  collectionId String?\n  workspaceId  String?\n  userId       String\n  title        String\n  content      String\n  isResolved   Boolean  @default(false)\n  isPinned     Boolean  @default(false)\n  tags         String[] // Discussion tags for categorization\n\n  paper      Paper?              @relation(fields: [paperId], references: [id])\n  collection Collection?         @relation(fields: [collectionId], references: [id])\n  workspace  Workspace?          @relation(fields: [workspaceId], references: [id])\n  user       User                @relation(fields: [userId], references: [id])\n  messages   DiscussionMessage[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([paperId, isDeleted, createdAt]) // For paper discussions\n  @@index([collectionId, isDeleted, createdAt]) // For collection discussions\n  @@index([workspaceId, isDeleted, createdAt]) // For workspace discussions\n  @@index([userId, isDeleted]) // For user's discussions\n  @@index([isResolved, isDeleted]) // For resolved/unresolved filtering\n  @@index([isPinned, isDeleted]) // For pinned discussions\n  @@index([isPinned, createdAt(sort: Desc)]) // For pinned threads sorted by date\n}\n\nmodel DiscussionMessage {\n  id          String  @id @default(uuid())\n  threadId    String\n  userId      String\n  content     String\n  parentId    String? // For threaded replies\n  isEdited    Boolean @default(false)\n  editHistory Json?   @db.JsonB // Store edit history\n\n  thread  DiscussionThread    @relation(fields: [threadId], references: [id])\n  user    User                @relation(fields: [userId], references: [id])\n  parent  DiscussionMessage?  @relation(\"MessageThread\", fields: [parentId], references: [id])\n  replies DiscussionMessage[] @relation(\"MessageThread\")\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([threadId, createdAt]) // For thread messages sorted by date\n  @@index([userId, isDeleted]) // For user's messages\n  @@index([parentId, isDeleted]) // For message replies\n}\n\n// Enhanced Activity Log\nmodel ActivityLogEntry {\n  id          String           @id @default(uuid())\n  userId      String?\n  workspaceId String?\n  entity      String // 'paper', 'collection', 'discussion', 'annotation', etc.\n  entityId    String\n  action      String // 'created', 'updated', 'deleted', 'shared', 'exported', etc.\n  details     Json?            @db.JsonB // Additional context about the action\n  metadata    Json?            @db.JsonB // Additional metadata like IP, user agent, etc.\n  severity    ActivitySeverity @default(INFO)\n\n  user      User?      @relation(fields: [userId], references: [id])\n  workspace Workspace? @relation(fields: [workspaceId], references: [id])\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  isDeleted Boolean  @default(false)\n\n  @@index([userId, createdAt]) // For user activity timeline\n  @@index([workspaceId, createdAt]) // For workspace activity\n  @@index([entity, entityId, createdAt]) // For entity-specific activity\n  @@index([action, createdAt]) // For action-based filtering\n  @@index([severity, createdAt]) // For severity-based filtering\n  @@index([userId, severity]) // For dashboard filtering by user + severity\n}\n\nenum ActivitySeverity {\n  INFO\n  WARNING\n  ERROR\n  CRITICAL\n}\n\n// -------- Public Content Models (Phase 1.9) --------\n\nenum ContactSubmissionStatus {\n  NEW\n  READ\n  REPLIED\n}\n\nmodel Faq {\n  id          String   @id @default(uuid())\n  question    String\n  answer      String\n  category    String\n  order       Int      @default(0)\n  isPublished Boolean  @default(true)\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n  isDeleted   Boolean  @default(false)\n\n  @@index([category, order])\n  @@index([isPublished, category, order])\n}\n\nmodel Testimonial {\n  id          String   @id @default(uuid())\n  name        String\n  title       String\n  company     String?\n  avatar      String?\n  content     String\n  rating      Int      @default(5)\n  order       Int      @default(0)\n  isPublished Boolean  @default(true)\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n  isDeleted   Boolean  @default(false)\n\n  @@index([isPublished, order])\n}\n\nmodel NewsletterSubscriber {\n  id           String   @id @default(uuid())\n  email        String   @unique\n  subscribedAt DateTime @default(now())\n  isActive     Boolean  @default(true)\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n  isDeleted    Boolean  @default(false)\n\n  @@index([isActive])\n  @@index([createdAt(sort: Desc)]) // For admin listing sorted by subscription date\n}\n\nmodel ContactSubmission {\n  id        String                  @id @default(uuid())\n  name      String\n  email     String\n  subject   String\n  message   String\n  status    ContactSubmissionStatus @default(NEW)\n  createdAt DateTime                @default(now())\n  updatedAt DateTime                @updatedAt\n  isDeleted Boolean                 @default(false)\n\n  @@index([status, createdAt])\n  @@index([createdAt(sort: Desc)]) // For admin listing sorted by submission date\n}\n\nmodel PageContent {\n  id          String   @id @default(uuid())\n  slug        String   @unique\n  title       String\n  content     String\n  metadata    Json?    @db.JsonB\n  isPublished Boolean  @default(true)\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n  isDeleted   Boolean  @default(false)\n\n  @@index([slug, isPublished])\n}\n\n// -------- User Preferences (Phase 3) --------\n\nmodel UserPreference {\n  id                      String   @id @default(uuid())\n  userId                  String   @unique\n  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  theme                   String   @default(\"system\") // light | dark | system\n  language                String   @default(\"en\")\n  timezone                String   @default(\"UTC\")\n  emailDigest             Boolean  @default(true)\n  defaultCitationStyle    String   @default(\"APA\")\n  compactMode             Boolean  @default(false)\n  metadata                Json?    @db.JsonB\n  // Phase 7 - Notification preferences (channels, categories, quiet hours)\n  notificationPreferences Json?    @db.JsonB\n  // Privacy settings (profileVisibility, showActivity, allowDataSharing, showInDiscover)\n  privacySettings         Json?    @db.JsonB\n  createdAt               DateTime @default(now())\n  updatedAt               DateTime @updatedAt\n\n  @@index([userId])\n}\n\n// ============================================================================\n// Phase 7 - Analytics, Notifications & Admin\n// ============================================================================\n\n// -------- Admin Reports --------\n\nenum AdminReportType {\n  USAGE\n  FINANCIAL\n  USER\n  CONTENT\n  SYSTEM\n}\n\nenum AdminReportStatus {\n  READY\n  GENERATING\n  SCHEDULED\n  FAILED\n}\n\nenum AdminReportFormat {\n  CSV\n  JSON\n}\n\nmodel AdminReport {\n  id          String            @id @default(uuid())\n  name        String\n  description String?\n  type        AdminReportType\n  status      AdminReportStatus @default(READY)\n  format      AdminReportFormat @default(CSV)\n  fileSize    String?\n  generatedAt DateTime?\n  // Scheduling\n  schedule    String? // cron-like expression\n  nextRunAt   DateTime?\n  recipients  String[]          @default([])\n  enabled     Boolean           @default(true)\n  // Config (filters, columns, etc.)\n  config      Json?             @db.JsonB\n  // Last result cached on disk\n  resultKey   String? // S3 key for the generated report file\n  createdById String\n  createdAt   DateTime          @default(now())\n  updatedAt   DateTime          @updatedAt\n  isDeleted   Boolean           @default(false)\n\n  createdBy User @relation(\"AdminReportCreator\", fields: [createdById], references: [id])\n\n  @@index([type, status, generatedAt])\n  @@index([nextRunAt, enabled])\n  @@index([createdById, isDeleted])\n}\n\n// -------- System Alerts --------\n\nenum SystemAlertSeverity {\n  INFO\n  WARNING\n  CRITICAL\n}\n\nenum SystemAlertCategory {\n  USER\n  BILLING\n  SECURITY\n  STORAGE\n  PROCESSING\n  SYSTEM\n}\n\nmodel SystemAlert {\n  id           String              @id @default(uuid())\n  category     SystemAlertCategory\n  severity     SystemAlertSeverity @default(INFO)\n  title        String\n  message      String\n  metadata     Json?               @db.JsonB\n  resolved     Boolean             @default(false)\n  resolvedAt   DateTime?\n  resolvedById String?\n  createdAt    DateTime            @default(now())\n  updatedAt    DateTime            @updatedAt\n\n  resolvedBy User? @relation(\"SystemAlertResolver\", fields: [resolvedById], references: [id])\n\n  @@index([category, createdAt])\n  @@index([resolved, createdAt])\n  @@index([severity, resolved])\n}\n\n// -------- Outbound Webhook Endpoints --------\n\nenum WebhookEndpointStatus {\n  ACTIVE\n  INACTIVE\n  ERROR\n}\n\nenum WebhookDeliveryStatus {\n  SUCCESS\n  FAILED\n  PENDING\n}\n\nmodel WebhookEndpoint {\n  id               String                @id @default(uuid())\n  name             String\n  url              String\n  description      String?\n  // Stored as HMAC-SHA256(secret + WEBHOOK_PEPPER); raw secret only returned on create\n  secretHash       String\n  // First 8 chars of the raw secret for display (e.g., \"whsec_xx\")\n  secretPrefix     String\n  events           String[]              @default([])\n  status           WebhookEndpointStatus @default(ACTIVE)\n  lastTriggered    DateTime?\n  totalDeliveries  Int                   @default(0)\n  failedDeliveries Int                   @default(0)\n  createdAt        DateTime              @default(now())\n  updatedAt        DateTime              @updatedAt\n  isDeleted        Boolean               @default(false)\n\n  deliveries WebhookDelivery[]\n\n  @@index([status, isDeleted])\n}\n\nmodel WebhookDelivery {\n  id           String                @id @default(uuid())\n  endpointId   String\n  event        String\n  payload      Json                  @db.JsonB\n  status       WebhookDeliveryStatus\n  statusCode   Int?\n  responseBody String?               @db.Text\n  durationMs   Int?\n  attempts     Int                   @default(1)\n  createdAt    DateTime              @default(now())\n  completedAt  DateTime?\n\n  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)\n\n  @@index([endpointId, createdAt])\n  @@index([status, createdAt])\n}\n\n// -------- API Keys --------\n\nenum ApiKeyStatus {\n  ACTIVE\n  REVOKED\n  EXPIRED\n}\n\nmodel ApiKey {\n  id            String       @id @default(uuid())\n  name          String\n  // Hashed (HMAC-SHA256 with API_KEY_PEPPER); raw key only returned on create\n  keyHash       String       @unique\n  // First 12 chars of the raw key for display (e.g., \"sf_live_abcd\")\n  keyPrefix     String\n  description   String?\n  scopes        String[]     @default([])\n  status        ApiKeyStatus @default(ACTIVE)\n  rateLimit     Int          @default(1000) // requests per hour\n  createdById   String\n  createdAt     DateTime     @default(now())\n  expiresAt     DateTime?\n  lastUsedAt    DateTime?\n  totalRequests Int          @default(0)\n  isDeleted     Boolean      @default(false)\n\n  createdBy User @relation(\"ApiKeyCreator\", fields: [createdById], references: [id])\n\n  @@index([status, isDeleted])\n  @@index([keyPrefix])\n  @@index([createdById, isDeleted])\n}\n\n// -------- Content Moderation --------\n\nenum ContentReportType {\n  PAPER\n  COMMENT\n  COLLECTION\n  PROFILE\n}\n\nenum ContentReportReason {\n  SPAM\n  HARASSMENT\n  COPYRIGHT\n  INAPPROPRIATE\n  MISINFORMATION\n  OTHER\n}\n\nenum ContentReportStatus {\n  PENDING\n  UNDER_REVIEW\n  RESOLVED\n  DISMISSED\n}\n\nmodel ContentReport {\n  id             String              @id @default(uuid())\n  contentType    ContentReportType\n  contentId      String\n  contentTitle   String?\n  contentPreview String?             @db.Text\n  reporterId     String\n  reason         ContentReportReason\n  description    String?             @db.Text\n  status         ContentReportStatus @default(PENDING)\n  assignedToId   String?\n  resolvedAt     DateTime?\n  resolvedById   String?\n  action         String? // approved | removed | warning | suspended\n  createdAt      DateTime            @default(now())\n  updatedAt      DateTime            @updatedAt\n  isDeleted      Boolean             @default(false)\n\n  reporter   User  @relation(\"ContentReporter\", fields: [reporterId], references: [id])\n  assignedTo User? @relation(\"ContentReportAssignee\", fields: [assignedToId], references: [id])\n  resolvedBy User? @relation(\"ContentReportResolver\", fields: [resolvedById], references: [id])\n\n  @@index([status, createdAt])\n  @@index([contentType, contentId])\n  @@index([reporterId, createdAt])\n  @@index([assignedToId, status])\n}\n",
