<file path="apps/frontend/proxy.ts">
 1: import { getRoleSlug } from "@/lib/auth/roles";
 2: import { NextResponse } from "next/server";
 3: const protectedRoutes = ["/dashboard"];
 4: const authRoutes = ["/login", "/register", "/auth/signin"];
 5: const publicRoutes = [
 6:   "/",
 7:   "/about",
 8:   "/features",
 9:   "/how-it-works",
10:   "/pricing",
11:   "/contact",
12:   "/faq",
13:   "/terms",
14:   "/privacy",
15:   "/papers",
16:   "/collections",
17:   "/workspaces",
18:   "/research",
19:   "/collaborations",
20:   "/collaborate",
21:   "/ai-insights",
22:   "/products",
23:   "/company",
24: ];
25: const legacyRoleSegments = [
26:   "/dashboard/researcher",
27:   "/dashboard/pro-researcher",
28:   "/dashboard/team-lead",
29: ];
30: function matchesRoute(routes: string[], path: string): boolean {
31:   return routes.some((route) => path === route || path.startsWith(route + "/"));
32: }
33: function isAuthenticated(request: Request): boolean {
34:   const cookieHeader = request.headers.get("cookie") || "";
35:   const hasSfAuth = cookieHeader.includes("sf_auth=1");
36:   const hasBetterAuth = cookieHeader.includes("better-auth.session_token");
37:   return hasSfAuth || hasBetterAuth;
38: }
39: function getRoleFromCookies(request: Request): string | undefined {
40:   const cookieHeader = request.headers.get("cookie") || "";
41:   return undefined;
42: }
43: export function proxy(request: Request) {
44:   const url = new URL(request.url);
45:   const { pathname } = url;
46:   const createRedirect = (redirectPath: string) => {
47:     return NextResponse.redirect(new URL(redirectPath, request.url));
48:   };
49:   const authenticated = isAuthenticated(request);
50:   const userRole = getRoleFromCookies(request);
51:   if (pathname.startsWith("/api/")) {
52:     return NextResponse.next();
53:   }
54:   if (
55:     pathname.startsWith("/_next/") ||
56:     pathname.startsWith("/static/") ||
57:     pathname.includes(".")
58:   ) {
59:     return NextResponse.next();
60:   }
61:   // Backward-compat: rewrite legacy role-segmented URLs to the new shared
62:   // (app)/ route group. /dashboard/admin is preserved (still an admin route).
63:   if (pathname === "/dashboard/researcher" || pathname.startsWith("/dashboard/researcher/")) {
64:     const tail = pathname.slice("/dashboard/researcher".length);
65:     return createRedirect(`/dashboard${tail}${url.search}`);
66:   }
67:   if (pathname === "/dashboard/pro-researcher" || pathname.startsWith("/dashboard/pro-researcher/")) {
68:     const tail = pathname.slice("/dashboard/pro-researcher".length);
69:     return createRedirect(`/dashboard${tail}${url.search}`);
70:   }
71:   if (pathname === "/dashboard/team-lead" || pathname.startsWith("/dashboard/team-lead/")) {
72:     const tail = pathname.slice("/dashboard/team-lead".length);
73:     return createRedirect(`/dashboard${tail}${url.search}`);
74:   }
75:   const callbackUrl = url.searchParams.get("callbackUrl");
76:   if (authenticated && matchesRoute(authRoutes, pathname)) {
77:     if (callbackUrl) {
78:       return createRedirect(callbackUrl);
79:     }
80:     const roleSlug = getRoleSlug(userRole);
81:     const dashboardPath = `/dashboard/${roleSlug}`;
82:     return createRedirect(dashboardPath);
83:   }
84:   if (!authenticated && matchesRoute(protectedRoutes, pathname)) {
85:     return NextResponse.next();
86:   }
87:   if (matchesRoute(publicRoutes, pathname)) {
88:     return NextResponse.next();
89:   }
90:   if (pathname === "/") {
91:     return NextResponse.next();
92:   }
93:   return NextResponse.next();
94: }
95: export const config = {
96:   matcher: [
97:     "/((?!api|_next/static|_next/image|favicon.ico|.*\\..*$).*)",
98:   ],
99: };
</file>

