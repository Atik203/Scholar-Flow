202:   async sendMessage(conversationId: string, userId: string, content: string) {
203:     const conv = await prisma.aIConversation.findUnique({
204:       where: { id: conversationId },
205:       select: { userId: true, model: true, context: true },
206:     });
207:     if (!conv) throw new AiError(404, "Conversation not found");
208:     if (conv.userId !== userId) throw new AiError(403, "Forbidden");
209:     await prisma.aIConversationMessage.create({
210:       data: { conversationId, role: "user", content },
