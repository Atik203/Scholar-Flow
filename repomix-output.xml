  1: import { Prisma } from "../../shared/prisma";
  2: import prisma from "../../shared/prisma";
  3: const escapeCsv = (v: unknown): string => {
  4:   if (v === null || v === undefined) return "";
  5:   let s = typeof v === "object" ? JSON.stringify(v) : String(v);
  6:   if (/^[=+\-@]/.test(s)) {
  7:     s = `'${s}`;
  8:   }
  9:   if (s.includes(",") || s.includes('"') || s.includes("\n")) {
 10:     return `"${s.replace(/"/g, '""')}"`;
 11:   }
 12:   return s;
 13: };
 14: export const auditLogService = {
 15:   async listEntries(params: {
 16:     userId?: string;
 17:     workspaceId?: string;
 18:     entity?: string;
 19:     entityId?: string;
 20:     action?: string;
 21:     severity?: "INFO" | "WARNING" | "ERROR" | "CRITICAL";
 22:     startDate?: Date;
 23:     endDate?: Date;
 24:     search?: string;
 25:     page: number;
 26:     limit: number;
 27:   }) {
 28:     const where: Prisma.ActivityLogEntryWhereInput = { isDeleted: false };
 29:     if (params.userId) where.userId = params.userId;
 30:     if (params.workspaceId) where.workspaceId = params.workspaceId;
 31:     if (params.entity) where.entity = params.entity;
 32:     if (params.entityId) where.entityId = params.entityId;
 33:     if (params.action) where.action = params.action;
 34:     if (params.severity) where.severity = params.severity;
 35:     if (params.startDate || params.endDate) {
 36:       where.createdAt = {};
 37:       if (params.startDate) where.createdAt.gte = params.startDate;
 38:       if (params.endDate) where.createdAt.lte = params.endDate;
 39:     }
 40:     if (params.search) {
 41:       where.OR = [
 42:         { action: { contains: params.search, mode: "insensitive" } },
 43:         { entity: { contains: params.search, mode: "insensitive" } },
 44:         { entityId: { contains: params.search, mode: "insensitive" } },
 45:       ];
 46:     }
 47:     const [total, items] = await Promise.all([
 48:       prisma.activityLogEntry.count({ where }),
 49:       prisma.activityLogEntry.findMany({
 50:         where,
 51:         orderBy: { createdAt: "desc" },
 52:         skip: (params.page - 1) * params.limit,
 53:         take: params.limit,
 54:         include: {
 55:           user: { select: { id: true, name: true, email: true, image: true } },
 56:           workspace: { select: { id: true, name: true } },
 57:         },
 58:       }),
 59:     ]);
 60:     return {
 61:       items,
 62:       meta: {
 63:         page: params.page,
 64:         limit: params.limit,
 65:         total,
 66:         totalPage: Math.max(1, Math.ceil(total / params.limit)),
 67:       },
 68:     };
 69:   },
 70:   async getSummary(params: {
 71:     startDate?: Date;
 72:     endDate?: Date;
 73:   }): Promise<{
 74:     total: number;
 75:     bySeverity: Array<{ severity: string; count: number }>;
 76:     byEntity: Array<{ entity: string; count: number }>;
 77:     topActors: Array<{
 78:       userId: string;
 79:       name: string | null;
 80:       email: string;
 81:       count: number;
 82:     }>;
 83:   }> {
 84:     const dateFilter: Prisma.ActivityLogEntryWhereInput = { isDeleted: false };
 85:     if (params.startDate || params.endDate) {
 86:       dateFilter.createdAt = {};
 87:       if (params.startDate) dateFilter.createdAt.gte = params.startDate;
 88:       if (params.endDate) dateFilter.createdAt.lte = params.endDate;
 89:     }
 90:     const [total, bySeverity, byEntity, topActors] = await Promise.all([
 91:       prisma.activityLogEntry.count({ where: dateFilter }),
 92:       prisma.activityLogEntry.groupBy({
 93:         by: ["severity"],
 94:         where: dateFilter,
 95:         _count: { _all: true },
 96:       }),
 97:       prisma.activityLogEntry.groupBy({
 98:         by: ["entity"],
 99:         where: dateFilter,
100:         _count: { _all: true },
101:         orderBy: { _count: { entity: "desc" } },
102:         take: 10,
103:       }),
104:       prisma.activityLogEntry.groupBy({
105:         by: ["userId"],
106:         where: { ...dateFilter, userId: { not: null } },
107:         _count: { _all: true },
108:         orderBy: { _count: { userId: "desc" } },
109:         take: 10,
110:       }),
111:     ]);
112:     const actorIds = topActors
113:       .map((a) => a.userId)
114:       .filter((id): id is string => Boolean(id));
115:     const actorUsers = actorIds.length
116:       ? await prisma.user.findMany({
117:           where: { id: { in: actorIds }, isDeleted: false },
118:           select: { id: true, name: true, email: true },
119:         })
120:       : [];
121:     const userMap = new Map(actorUsers.map((u) => [u.id, u]));
122:     return {
123:       total,
124:       bySeverity: bySeverity.map((s) => ({
125:         severity: s.severity,
126:         count: s._count._all,
127:       })),
128:       byEntity: byEntity.map((e) => ({
129:         entity: e.entity,
130:         count: e._count._all,
131:       })),
132:       topActors: topActors.map((a) => {
133:         const user = a.userId ? userMap.get(a.userId) : null;
134:         return {
135:           userId: a.userId ?? "",
136:           name: user?.name ?? null,
137:           email: user?.email ?? "",
138:           count: a._count._all,
139:         };
140:       }),
141:     };
142:   },
143:   async exportEntries(
144:     params: {
145:       userId?: string;
146:       workspaceId?: string;
147:       entity?: string;
148:       entityId?: string;
149:       action?: string;
150:       severity?: "INFO" | "WARNING" | "ERROR" | "CRITICAL";
151:       startDate?: Date;
152:       endDate?: Date;
153:       format: "json" | "csv";
154:       limit: number;
155:     }
156:   ): Promise<{ mimeType: string; filename: string; content: string }> {
157:     const where: Prisma.ActivityLogEntryWhereInput = { isDeleted: false };
158:     if (params.userId) where.userId = params.userId;
159:     if (params.workspaceId) where.workspaceId = params.workspaceId;
160:     if (params.entity) where.entity = params.entity;
161:     if (params.entityId) where.entityId = params.entityId;
162:     if (params.action) where.action = params.action;
163:     if (params.severity) where.severity = params.severity;
164:     if (params.startDate || params.endDate) {
165:       where.createdAt = {};
166:       if (params.startDate) where.createdAt.gte = params.startDate;
167:       if (params.endDate) where.createdAt.lte = params.endDate;
168:     }
169:     const entries = await prisma.activityLogEntry.findMany({
170:       where,
171:       orderBy: { createdAt: "desc" },
172:       take: params.limit,
173:       include: {
174:         user: { select: { id: true, email: true, name: true } },
175:         workspace: { select: { id: true, name: true } },
176:       },
177:     });
178:     const dateStr = new Date().toISOString().split("T")[0];
179:     if (params.format === "json") {
180:       return {
181:         mimeType: "application/json",
182:         filename: `audit-log-${dateStr}.json`,
183:         content: JSON.stringify(entries, null, 2),
184:       };
185:     }
186:     const headers = [
187:       "id",
188:       "createdAt",
189:       "severity",
190:       "entity",
191:       "entityId",
192:       "action",
193:       "userId",
194:       "userEmail",
195:       "workspaceId",
196:       "workspaceName",
197:       "details",
198:       "metadata",
199:     ];
200:     const lines: string[] = [headers.join(",")];
201:     for (const e of entries) {
202:       lines.push(
203:         [
204:           e.id,
205:           e.createdAt.toISOString(),
206:           e.severity,
207:           e.entity,
208:           e.entityId,
209:           e.action,
210:           e.userId ?? "",
211:           e.user?.email ?? "",
212:           e.workspaceId ?? "",
213:           e.workspace?.name ?? "",
214:           e.details,
215:           e.metadata,
216:         ]
217:           .map(escapeCsv)
218:           .join(",")
219:       );
220:     }
221:     return {
222:       mimeType: "text/csv",
223:       filename: `audit-log-${dateStr}.csv`,
224:       content: lines.join("\n"),
225:     };
226:   },
227:   async createEntry(
228:     actorId: string,
229:     data: {
230:       userId?: string;
231:       workspaceId?: string;
232:       entity: string;
233:       entityId: string;
234:       action: string;
235:       details?: Record<string, unknown>;
236:       metadata?: Record<string, unknown>;
237:       severity: "INFO" | "WARNING" | "ERROR" | "CRITICAL";
238:     }
239:   ) {
240:     return prisma.activityLogEntry.create({
241:       data: {
242:         userId: data.userId,
243:         workspaceId: data.workspaceId,
244:         entity: data.entity,
245:         entityId: data.entityId,
246:         action: data.action,
247:         details: data.details
248:           ? (data.details as Prisma.InputJsonValue)
249:           : Prisma.JsonNull,
250:         metadata: data.metadata
251:           ? (data.metadata as Prisma.InputJsonValue)
252:           : Prisma.JsonNull,
253:         severity: data.severity,
254:       },
255:     });
256:   },
257: };
</file>

