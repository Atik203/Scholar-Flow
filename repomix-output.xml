199:       try {
200:         await storage.set(key, newValue);
201:         setValue(newValue);
202:         setError(null);
203:       } catch (err) {
204:         setError(err instanceof Error ? err.message : "Failed to save value");
205:         console.error(`Error setting IndexedDB key "${key}":`, err);
206:         throw err;
