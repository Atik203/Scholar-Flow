  1: "use client"
  2: import * as React from "react"
  3: import type { Editor } from "@tiptap/react"
  4: import { useTiptapEditor } from "@/hooks/use-tiptap-editor"
  5: import { LinkIcon } from "@/components/tiptap-icons/link-icon"
  6: import { isMarkInSchema, sanitizeUrl } from "@/lib/tiptap-utils"
  7: export interface UseLinkPopoverConfig {
  8:   editor?: Editor | null
  9:   hideWhenUnavailable?: boolean
 10:   onSetLink?: () => void
 11: }
 12: export interface LinkHandlerProps {
 13:   editor: Editor | null
 14:   onSetLink?: () => void
 15: }
 16: export function canSetLink(editor: Editor | null): boolean {
 17:   if (!editor || !editor.isEditable) return false
 18:   return editor.can().setMark("link")
 19: }
 20: export function isLinkActive(editor: Editor | null): boolean {
 21:   if (!editor || !editor.isEditable) return false
 22:   return editor.isActive("link")
 23: }
 24: export function shouldShowLinkButton(props: {
 25:   editor: Editor | null
 26:   hideWhenUnavailable: boolean
 27: }): boolean {
 28:   const { editor, hideWhenUnavailable } = props
 29:   const linkInSchema = isMarkInSchema("link", editor)
 30:   if (!linkInSchema || !editor) {
 31:     return false
 32:   }
 33:   if (hideWhenUnavailable && !editor.isActive("code")) {
 34:     return canSetLink(editor)
 35:   }
 36:   return true
 37: }
 38: export function useLinkHandler(props: LinkHandlerProps) {
 39:   const { editor, onSetLink } = props
 40:   const [url, setUrl] = React.useState<string | null>(null)
 41:   React.useEffect(() => {
 42:     if (!editor) return
 43:     const { href } = editor.getAttributes("link")
 44:     if (isLinkActive(editor) && url === null) {
 45:       setUrl(href || "")
 46:     }
 47:   }, [editor, url])
 48:   React.useEffect(() => {
 49:     if (!editor) return
 50:     const updateLinkState = () => {
 51:       const { href } = editor.getAttributes("link")
 52:       setUrl(href || "")
 53:     }
 54:     editor.on("selectionUpdate", updateLinkState)
 55:     return () => {
 56:       editor.off("selectionUpdate", updateLinkState)
 57:     }
 58:   }, [editor])
 59:   const setLink = React.useCallback(() => {
 60:     if (!url || !editor) return
 61:     const { selection } = editor.state
 62:     const isEmpty = selection.empty
 63:     let chain = editor.chain().focus()
 64:     chain = chain.extendMarkRange("link").setLink({ href: url })
 65:     if (isEmpty) {
 66:       chain = chain.insertContent({ type: "text", text: url })
 67:     }
 68:     chain.run()
 69:     setUrl(null)
 70:     onSetLink?.()
 71:   }, [editor, onSetLink, url])
 72:   const removeLink = React.useCallback(() => {
 73:     if (!editor) return
 74:     editor
 75:       .chain()
 76:       .focus()
 77:       .extendMarkRange("link")
 78:       .unsetLink()
 79:       .setMeta("preventAutolink", true)
 80:       .run()
 81:     setUrl("")
 82:   }, [editor])
 83:   const openLink = React.useCallback(
 84:     (target: string = "_blank", features: string = "noopener,noreferrer") => {
 85:       if (!url) return
 86:       const safeUrl = sanitizeUrl(url, window.location.href)
 87:       if (safeUrl !== "#") {
 88:         window.open(safeUrl, target, features)
 89:       }
 90:     },
 91:     [url]
 92:   )
 93:   return {
 94:     url: url || "",
 95:     setUrl,
 96:     setLink,
 97:     removeLink,
 98:     openLink,
 99:   }
100: }
101: /**
102:  * Custom hook for link popover state management
103:  */
104: export function useLinkState(props: {
105:   editor: Editor | null
106:   hideWhenUnavailable: boolean
107: }) {
108:   const { editor, hideWhenUnavailable = false } = props
109:   const canSet = canSetLink(editor)
110:   const isActive = isLinkActive(editor)
111:   const [isVisible, setIsVisible] = React.useState(false)
112:   React.useEffect(() => {
113:     if (!editor) return
114:     const handleSelectionUpdate = () => {
115:       setIsVisible(
116:         shouldShowLinkButton({
117:           editor,
118:           hideWhenUnavailable,
119:         })
120:       )
121:     }
122:     handleSelectionUpdate()
123:     editor.on("selectionUpdate", handleSelectionUpdate)
124:     return () => {
125:       editor.off("selectionUpdate", handleSelectionUpdate)
126:     }
127:   }, [editor, hideWhenUnavailable])
128:   return {
129:     isVisible,
130:     canSet,
131:     isActive,
132:   }
133: }
134: export function useLinkPopover(config?: UseLinkPopoverConfig) {
135:   const {
136:     editor: providedEditor,
137:     hideWhenUnavailable = false,
138:     onSetLink,
139:   } = config || {}
140:   const { editor } = useTiptapEditor(providedEditor)
141:   const { isVisible, canSet, isActive } = useLinkState({
142:     editor,
143:     hideWhenUnavailable,
144:   })
145:   const linkHandler = useLinkHandler({
146:     editor,
147:     onSetLink,
148:   })
149:   return {
150:     isVisible,
151:     canSet,
152:     isActive,
153:     label: "Link",
154:     Icon: LinkIcon,
155:     ...linkHandler,
156:   }
157: }
</file>

