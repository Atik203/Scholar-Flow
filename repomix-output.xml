  8:   duration?: number;
  9:   delay?: number;
 10:   exit?: boolean;
 11: }
 12: const transitionVariants = {
 13:   fade: {
 14:     initial: { opacity: 0 },
 15:     animate: { opacity: 1 },
 16:     exit: { opacity: 0 },
 17:   },
 18:   slide: {
 19:     initial: { opacity: 0, x: -20 },
 20:     animate: { opacity: 1, x: 0 },
 21:     exit: { opacity: 0, x: 20 },
 22:   },
 23:   scale: {
 24:     initial: { opacity: 0, scale: 0.95 },
 25:     animate: { opacity: 1, scale: 1 },
 26:     exit: { opacity: 0, scale: 1.05 },
 27:   },
 28:   slideUp: {
 29:     initial: { opacity: 0, y: 20 },
 30:     animate: { opacity: 1, y: 0 },
 31:     exit: { opacity: 0, y: -20 },
 32:   },
 33:   slideDown: {
 34:     initial: { opacity: 0, y: -20 },
 35:     animate: { opacity: 1, y: 0 },
 36:     exit: { opacity: 0, y: 20 },
 37:   },
 38: };
 39: export const PageTransition: React.FC<PageTransitionProps> = ({
 40:   children,
 41:   className,
 42:   variant = "fade",
 43:   duration = 0.3,
 44:   delay = 0,
 45:   exit = true,
 46: }) => {
 47:   const variants = transitionVariants[variant];
 48:   if (exit) {
 49:     return (
 50:       <AnimatePresence mode="wait">
 51:         <motion.div
 52:           className={cn("w-full", className)}
 53:           initial={variants.initial}
 54:           animate={variants.animate}
 55:           exit={variants.exit}
 56:           transition={{
 57:             duration,
 58:             delay,
 59:             ease: "easeInOut",
 60:           }}
 61:         >
 62:           {children}
 63:         </motion.div>
 64:       </AnimatePresence>
 65:     );
 66:   }
 67:   return (
 68:     <motion.div
 69:       className={cn("w-full", className)}
 70:       initial={variants.initial}
 71:       animate={variants.animate}
 72:       transition={{
 73:         duration,
 74:         delay,
 75:         ease: "easeInOut",
 76:       }}
 77:     >
 78:       {children}
 79:     </motion.div>
 80:   );
 81: };
