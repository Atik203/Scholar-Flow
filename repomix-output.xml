                      </div>
                      <div className="text-sm text-slate-900 dark:text-white">
                        {selectedPayment.userName}
                      </div>
                      <div className="text-xs text-slate-500">
                        {selectedPayment.userEmail}
                      </div>
                    </div>
                    <div>
                      <div className="text-sm text-slate-500 dark:text-slate-400">
                        Status
                      </div>
                      <span
