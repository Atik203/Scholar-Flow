361:             signal: controller.signal,
362:           }
363:         );
364:       } finally {
365:         clearTimeout(timeout);
366:       }
367:       if (!response.ok) {
368:         const errorText = await response.text();
369:         throw new Error(`Gemini API error: ${response.status} - ${errorText}`);
370:       }
371:       const data = (await response.json()) as any;
372:       const parts: string[] = Array.isArray(
373:         data.candidates?.[0]?.content?.parts
374:       )
375:         ? data.candidates[0].content.parts
376:             .map((part: any) => part?.text || "")
377:             .filter((text: string) => Boolean(text))
378:         : [];
379:       const combined = stripJsonFences(parts.join("\n")).trim();
380:       if (!combined) {
