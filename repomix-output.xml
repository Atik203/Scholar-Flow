<file path="apps/backend/src/app/modules/Notification/notification.service.ts">
  1: import { Prisma, NotificationType } from "../../shared/prisma";
  2: import prisma from "../../shared/prisma";
  3: import ApiError from "../../errors/ApiError";
  4: import { notificationBroadcaster } from "./broadcast";
  5: import {
  6:   notificationSettingsService,
  7:   type NotificationCategory,
  8: } from "./notificationSettings.service";
  9: const TYPE_TO_CATEGORY: Record<NotificationType, NotificationCategory> = {
 10:   MENTION: "DISCUSSIONS",
 11:   COMMENT: "DISCUSSIONS",
 12:   SHARE: "PAPERS",
 13:   INVITE: "TEAM",
 14:   PAPER: "PAPERS",
 15:   COLLECTION: "COLLECTIONS",
 16:   SYSTEM: "SYSTEM",
 17:   ACHIEVEMENT: "ACHIEVEMENT",
 18: };
 19: const ALWAYS_DELIVER: NotificationCategory[] = ["BILLING", "SECURITY"];
 20: export const notificationService = {
 21:   async listNotifications(
 22:     userId: string,
 23:     limit: number,
 24:     cursor: string | undefined,
 25:     query: {
 26:       type?: string;
 27:       read?: string;
 28:       starred?: string;
 29:     }
 30:   ) {
 31:     const where: Prisma.NotificationWhereInput = { userId };
 32:     if (query.type && query.type !== "all") {
 33:       where.type = query.type as NotificationType;
 34:     }
 35:     if (query.read === "unread") {
 36:       where.read = false;
 37:     } else if (query.read === "read") {
 38:       where.read = true;
 39:     }
 40:     if (query.starred === "true") {
 41:       where.starred = true;
 42:     } else if (query.starred === "false") {
 43:       where.starred = false;
 44:     }
 45:     const [total, data] = await Promise.all([
 46:       prisma.notification.count({ where }),
 47:       prisma.notification.findMany({
 48:         where,
 49:         take: limit + 1,
 50:         ...(cursor ? { cursor: { id: cursor }, skip: 1 } : {}),
 51:         orderBy: [{ createdAt: "desc" }, { id: "desc" }],
 52:         include: {
 53:           actor: {
 54:             select: { name: true, image: true, firstName: true, lastName: true },
 55:           },
 56:         },
 57:       }),
 58:     ]);
 59:     const hasMore = data.length > limit;
 60:     const sliced = hasMore ? data.slice(0, -1) : data;
 61:     const formattedData = sliced.map((n) => ({
 62:       ...n,
 63:       actor: n.actor
 64:         ? {
 65:             name:
 66:               n.actor.name ||
 67:               `${n.actor.firstName || ""} ${n.actor.lastName || ""}`.trim() ||
 68:               "Unknown",
 69:             image: n.actor.image,
 70:           }
 71:         : undefined,
 72:     }));
 73:     return {
 74:       meta: {
 75:         total,
 76:         limit,
 77:         nextCursor: hasMore ? formattedData[formattedData.length - 1].id : null,
 78:         hasMore,
 79:       },
 80:       result: formattedData,
 81:     };
 82:   },
 83:   async getUnreadCount(userId: string) {
 84:     const count = await prisma.notification.count({
 85:       where: { userId, read: false },
 86:     });
 87:     return { count };
 88:   },
 89:   async markAsRead(userId: string, notificationId: string) {
 90:     const notification = await prisma.notification.findUnique({
 91:       where: { id: notificationId },
 92:     });
 93:     if (!notification || notification.userId !== userId) {
 94:       throw new ApiError(404, "Notification not found");
 95:     }
 96:     return prisma.notification.update({
 97:       where: { id: notificationId },
 98:       data: { read: true },
 99:     });
100:   },
101:   async toggleStarred(userId: string, notificationId: string) {
102:     const notification = await prisma.notification.findUnique({
103:       where: { id: notificationId },
104:     });
105:     if (!notification || notification.userId !== userId) {
106:       throw new ApiError(404, "Notification not found");
107:     }
108:     return prisma.notification.update({
109:       where: { id: notificationId },
110:       data: { starred: !notification.starred },
111:     });
112:   },
113:   async markAllAsRead(userId: string) {
114:     return prisma.notification.updateMany({
115:       where: { userId, read: false },
116:       data: { read: true },
117:     });
118:   },
119:   async deleteNotification(userId: string, notificationId: string) {
120:     const notification = await prisma.notification.findUnique({
121:       where: { id: notificationId },
122:     });
123:     if (!notification || notification.userId !== userId) {
124:       throw new ApiError(404, "Notification not found");
125:     }
126:     await prisma.notification.delete({
127:       where: { id: notificationId },
128:     });
129:     return { success: true };
130:   },
131:   async deleteBulk(userId: string, notificationIds: string[]) {
132:     await prisma.notification.deleteMany({
133:       where: {
134:         id: { in: notificationIds },
135:         userId,
136:       },
137:     });
138:     return { success: true };
139:   },
140:   async createNotification(data: {
141:     userId: string;
142:     type: NotificationType;
143:     title: string;
144:     message: string;
145:     actionUrl?: string;
146:     actorId?: string;
147:     resourceId?: string;
148:     category?: NotificationCategory;
149:   }) {
150:     const { category: explicitCategory, ...notificationData } = data;
151:     const category =
152:       explicitCategory ?? TYPE_TO_CATEGORY[data.type] ?? "SYSTEM";
153:     try {
154:       if (!ALWAYS_DELIVER.includes(category)) {
155:         const prefs = await notificationSettingsService.getPreferencesLite(
156:           data.userId
157:         );
158:         const categoryInApp = prefs.categories?.[category]?.inApp;
159:         if (
160:           prefs.muteAll ||
161:           prefs.channels?.inApp === false ||
162:           categoryInApp === false
163:         ) {
164:           return null;
165:         }
166:       }
167:     } catch {
168:     }
169:     const notification = await prisma.notification.create({
170:       data: notificationData,
171:       include: {
172:         actor: {
173:           select: { name: true, image: true, firstName: true, lastName: true },
174:         },
175:       },
176:     });
177:     try {
178:       notificationBroadcaster.publish(data.userId, {
179:         type: "notification.created",
180:         id: notification.id,
181:         data: {
182:           id: notification.id,
183:           userId: notification.userId,
184:           type: notification.type,
185:           title: notification.title,
186:           message: notification.message,
187:           read: notification.read,
188:           starred: notification.starred,
189:           actionUrl: notification.actionUrl,
190:           actorId: notification.actorId,
191:           resourceId: notification.resourceId,
192:           createdAt: notification.createdAt,
193:           actor: notification.actor
194:             ? {
195:                 name:
196:                   notification.actor.name ||
197:                   `${notification.actor.firstName || ""} ${
198:                     notification.actor.lastName || ""
199:                   }`.trim() ||
200:                   "Unknown",
201:                 image: notification.actor.image,
202:               }
203:             : undefined,
204:         },
205:       });
206:     } catch (err) {
207:       if (process.env.NODE_ENV !== "production") {
208:         console.warn("[Notification] SSE broadcast failed:", err);
209:       }
210:     }
211:     return notification;
212:   },
213: };
