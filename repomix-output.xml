 3: export interface AuthedFetchOptions extends Omit<RequestInit, "body"> {
 4:   body?: unknown;
 5:   signal?: AbortSignal;
 6: }
 7: function getAuthHeader(): Record<string, string> {
 8:   const store = getAppStore();
 9:   const token = store?.getState()?.auth?.accessToken;
10:   if (!token) return {};
11:   return { Authorization: `Bearer ${token}` };
12: }
13: export async function authedFetch(
14:   path: string,
15:   options: AuthedFetchOptions = {}
16: ): Promise<Response> {
17:   const { body, headers, ...rest } = options;
18:   const url = path.startsWith("http") ? path : `${API_BASE_URL}${path}`;
19:   return fetch(url, {
20:     ...rest,
21:     headers: {
22:       "Content-Type": "application/json",
23:       ...getAuthHeader(),
24:       ...(headers as Record<string, string> | undefined),
25:     },
26:     body: body !== undefined ? JSON.stringify(body) : undefined,
27:   });
28: }
29: export async function streamingFetch(
30:   path: string,
31:   options: AuthedFetchOptions = {}
32: ): Promise<Response> {
33:   const res = await authedFetch(path, options);
34:   if (!res.ok) {
35:     const text = await res.text().catch(() => "");
36:     throw new Error(
37:       `Stream request failed: ${res.status} ${res.statusText} ${text}`
38:     );
39:   }
40:   if (!res.body) {
41:     throw new Error("Stream response has no body");
42:   }
43:   return res;
44: }
</file>

