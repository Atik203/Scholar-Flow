438:       const newTags = data.tags !== undefined ? data.tags : existing.tags;
439:       const newIsPrivate =
440:         data.isPrivate !== undefined ? data.isPrivate : existing.isPrivate;
441:       // Execute update
442:       await prisma.$executeRaw`
443:         UPDATE "ResearchNote"
444:         SET title = ${newTitle},
445:             content = ${newContent},
446:             tags = ${newTags}::text[],
447:             "isPrivate" = ${newIsPrivate},
448:             "updatedAt" = ${now}
449:         WHERE id = ${noteId}
450:       `;
451:       // Fetch updated note
452:       const notes = await prisma.$queryRaw<any[]>`
453:         SELECT
454:           rn.id, rn."userId", rn."paperId", rn.title, rn.content, rn.tags,
455:           rn."isPrivate", rn."createdAt", rn."updatedAt",
