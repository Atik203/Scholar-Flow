129: /**
130:  * Extract raw body buffer from request for Stripe signature verification
131:  * Handles both local (express.raw) and Vercel serverless (direct Buffer) cases
132:  */
133: async function getRawBodyBuffer(req: RawBodyRequest): Promise<Buffer> {
134:   // Case 1: Check rawBody property (custom middleware)
135:   const possibleRawBody = req.rawBody;
136:   if (Buffer.isBuffer(possibleRawBody)) {
137:     logDebug("[Webhook] Raw body extracted from req.rawBody (Buffer)");
138:     (req as RawBodyRequest).rawBody = possibleRawBody;
139:     return possibleRawBody;
140:   }
141:   if (typeof possibleRawBody === "string") {
142:     logDebug("[Webhook] Raw body extracted from req.rawBody (string)");
143:     const buffer = Buffer.from(possibleRawBody, "utf8");
144:     (req as RawBodyRequest).rawBody = buffer;
145:     (req as MutableRawBodyRequest).body = buffer;
146:     return buffer;
147:   }
148:   // Case 2: Check req.body (Vercel serverless or express.raw)
149:   if (Buffer.isBuffer(req.body)) {
150:     logDebug(
151:       "[Webhook] Raw body extracted from req.body (Buffer) - Vercel mode"
152:     );
153:     (req as RawBodyRequest).rawBody = req.body;
154:     return req.body;
155:   }
156:   if (typeof req.body === "string") {
157:     logDebug("[Webhook] Raw body extracted from req.body (string)");
158:     const buffer = Buffer.from(req.body, "utf8");
159:     (req as RawBodyRequest).rawBody = buffer;
160:     (req as MutableRawBodyRequest).body = buffer;
161:     return buffer;
162:   }
163:   // Case 3: Check if body is already parsed JSON (should not happen, but handle gracefully)
164:   if (req.body && typeof req.body === "object") {
165:     console.error(
166:       "[Webhook] Body already parsed as JSON - cannot verify signature"
167:     );
168:     console.error(
169:       "[Webhook] This indicates body parsing middleware is running before webhook route"
170:     );
171:     throw BillingError.webhookRawBodyMissing();
172:   }
173:   // Case 4: Attempt to read from request stream if not yet consumed (e.g., serverless environments)
174:   if (!req.readableEnded && req.readable !== false) {
175:     const chunks: Buffer[] = [];
176:     for await (const chunk of req) {
177:       if (typeof chunk === "string") {
178:         chunks.push(Buffer.from(chunk));
179:       } else {
180:         chunks.push(Buffer.from(chunk));
181:       }
182:     }
183:     if (chunks.length > 0) {
184:       const buffer = Buffer.concat(chunks);
185:       (req as RawBodyRequest).rawBody = buffer;
186:       (req as MutableRawBodyRequest).body = buffer;
187:       logDebug("[Webhook] Raw body captured by manual stream read");
188:       return buffer;
189:     }
190:   }
191:   console.error(
192:     "[Webhook] No raw body found in req stream after fallback attempts"
193:   );
194:   throw BillingError.webhookRawBodyMissing();
195: }
196: /**
197:  * Handle checkout.session.completed event
