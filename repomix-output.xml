 63: }
 64: export const billingApi = apiSlice.injectEndpoints({
 65:   endpoints: (builder) => ({
 66:     createCheckoutSession: builder.mutation<
 67:       CheckoutSessionResponse,
 68:       CheckoutSessionRequest
 69:     >({
 70:       query: (body) => ({
 71:         url: "/billing/checkout-session",
 72:         method: "POST",
 73:         body,
 74:       }),
 75:       invalidatesTags: ["User"],
 76:       extraOptions: { maxRetries: 0 },
 77:     }),
 78:     createPortalSession: builder.mutation<
 79:       PortalSessionResponse,
 80:       PortalSessionRequest
 81:     >({
 82:       query: (body) => ({
 83:         url: "/billing/customer-portal",
 84:         method: "POST",
 85:         body,
 86:       }),
 87:     }),
 88:     getSubscription: builder.query<
 89:       Subscription | null,
 90:       { workspaceId?: string }
 91:     >({
 92:       query: ({ workspaceId }) => ({
 93:         url: "/billing/subscription",
 94:         params: workspaceId ? { workspaceId } : undefined,
 95:       }),
 96:       transformResponse: (response: {
 97:         success: boolean;
 98:         data: Subscription | null;
 99:       }) => response.data,
100:       providesTags: ["User"],
101:       keepUnusedDataFor: 60,
102:     }),
103:     getBillingPrices: builder.query<BillingPrices, void>({
104:       query: () => "/billing/prices",
105:       transformResponse: (response: { data: BillingPrices }) => response.data,
106:       keepUnusedDataFor: 300,
107:     }),
108:     getBillingCatalog: builder.query<BillingCatalog, void>({
109:       query: () => "/billing/catalog",
110:       transformResponse: (response: { data: BillingCatalog }) => response.data,
111:       keepUnusedDataFor: 30,
112:     }),
113:     managePlan: builder.mutation<{ message: string }, ManagePlanRequest>({
114:       query: (body) => ({
115:         url: "/billing/manage-plan",
116:         method: "POST",
117:         body,
118:       }),
119:       async onQueryStarted(arg, { dispatch, queryFulfilled }) {
120:         const patchResult = dispatch(
121:           billingApi.util.updateQueryData(
122:             "getSubscription",
123:             { workspaceId: arg.workspaceId },
124:             (draft) => {
125:               if (!draft) return;
126:               if (arg.action === "cancel") {
127:                 draft.cancelAtPeriodEnd = true;
128:               } else if (arg.action === "reactivate") {
129:                 draft.cancelAtPeriodEnd = false;
130:               }
131:             }
132:           )
133:         );
134:         try {
135:           await queryFulfilled;
136:           dispatch(apiSlice.util.invalidateTags(["User"]));
137:         } catch {
138:           patchResult.undo();
139:         }
140:       },
141:       invalidatesTags: ["User"],
142:     }),
143:   }),
144: });
145: export const {
146:   useCreateCheckoutSessionMutation,
147:   useCreatePortalSessionMutation,
148:   useGetSubscriptionQuery,
149:   useLazyGetSubscriptionQuery,
150:   useManagePlanMutation,
151:   useGetBillingPricesQuery,
152:   useGetBillingCatalogQuery,
153: } = billingApi;
</file>

