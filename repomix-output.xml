500:       }
501:       // Soft delete
502:       const now = new Date();
503:       await prisma.$executeRaw`
504:         UPDATE "ResearchNote"
505:         SET "isDeleted" = true, "updatedAt" = ${now}
506:         WHERE id = ${noteId}
