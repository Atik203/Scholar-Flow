293: const groupNotificationsByDate = (
294:   notifications: Notification[]
295: ): NotificationGroup[] => {
296:   const now = new Date();
297:   const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
298:   const yesterday = new Date(today.getTime() - 86400000);
299:   const lastWeek = new Date(today.getTime() - 7 * 86400000);
300:   const todayNotifs = notifications.filter(
301:     (n) => new Date(n.timestamp) >= today
302:   );
303:   const yesterdayNotifs = notifications.filter((n) => {
304:     const date = new Date(n.timestamp);
305:     return date >= yesterday && date < today;
306:   });
307:   const thisWeekNotifs = notifications.filter((n) => {
308:     const date = new Date(n.timestamp);
309:     return date >= lastWeek && date < yesterday;
310:   });
311:   const olderNotifs = notifications.filter(
312:     (n) => new Date(n.timestamp) < lastWeek
313:   );
314:   const groups: NotificationGroup[] = [];
315:   if (todayNotifs.length > 0) {
316:     groups.push({
317:       title: "Today",
318:       icon: Clock,
319:       notifications: todayNotifs,
320:       color: "from-purple-500 to-pink-500",
321:     });
322:   }
323:   if (yesterdayNotifs.length > 0) {
324:     groups.push({
325:       title: "Yesterday",
326:       icon: Calendar,
327:       notifications: yesterdayNotifs,
328:       color: "from-blue-500 to-indigo-500",
329:     });
330:   }
331:   if (thisWeekNotifs.length > 0) {
332:     groups.push({
333:       title: "This Week",
334:       icon: Calendar,
335:       notifications: thisWeekNotifs,
336:       color: "from-green-500 to-teal-500",
337:     });
338:   }
339:   if (olderNotifs.length > 0) {
340:     groups.push({
341:       title: "Earlier",
342:       icon: Archive,
343:       notifications: olderNotifs,
344:       color: "from-gray-500 to-slate-500",
345:     });
346:   }
347:   return groups;
348: };
