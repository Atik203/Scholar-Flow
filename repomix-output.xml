621:         WHERE p."isDeleted" = false
622:       `;
623:     }
624:     const total = Number(totalResult[0]?.count || 0);
625:     const totalPage = Math.ceil(total / limit);
626:     const papersWithUploader = papers.map((paper) => ({
627:       ...paper,
