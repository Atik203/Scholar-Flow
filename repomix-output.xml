<file path="apps/backend/src/app/modules/Invitation/invitationSweeper.ts">
 1: import cron from "node-cron";
 2: import prismaClient from "../../shared/prisma";
 3: const EXPIRY_DAYS = Number(process.env.INVITE_EXPIRY_DAYS || 7);
 4: export const INVITE_EXPIRY_MS = EXPIRY_DAYS * 24 * 60 * 60 * 1000;
 5: const logDebug = (...args: unknown[]) => {
 6:   if (process.env.NODE_ENV !== "production") {
 7:     console.log("[InvitationSweeper]", ...args);
 8:   }
 9: };
10: export const runInvitationSweep = async (): Promise<number> => {
11:   const expired = await prismaClient.$queryRaw<Array<{ count: number }>>`
12:     SELECT (
13:       (SELECT COUNT(*) FROM "WorkspaceInvitation"
14:        WHERE status = 'PENDING' AND "isDeleted" = false
15:          AND "expiresAt" IS NOT NULL AND "expiresAt" < NOW())
16:       +
17:       (SELECT COUNT(*) FROM "CollectionMember"
18:        WHERE status = 'PENDING' AND "isDeleted" = false
19:          AND "expiresAt" IS NOT NULL AND "expiresAt" < NOW())
20:     )::int as count
21:   `;
22:   const total = expired[0]?.count ?? 0;
23:   if (total === 0) return 0;
24:   await prismaClient.$executeRaw`
25:     UPDATE "WorkspaceInvitation"
26:     SET status = 'EXPIRED', "updatedAt" = NOW()
27:     WHERE status = 'PENDING' AND "isDeleted" = false
28:       AND "expiresAt" IS NOT NULL AND "expiresAt" < NOW()
29:   `;
30:   await prismaClient.$executeRaw`
31:     UPDATE "CollectionMember"
32:     SET status = 'EXPIRED', "updatedAt" = NOW()
33:     WHERE status = 'PENDING' AND "isDeleted" = false
34:       AND "expiresAt" IS NOT NULL AND "expiresAt" < NOW()
35:   `;
36:   logDebug(`Expired ${total} pending invitation(s)`);
37:   return total;
38: };
39: let sweeperStarted = false;
40: export const startInvitationSweeper = (): void => {
41:   if (sweeperStarted || process.env.VERCEL === "1") {
42:     return;
43:   }
44:   // Hourly at minute 15 (offset from the subscription sweeper at minute 5)
45:   cron.schedule("15 * * * *", () => {
46:     runInvitationSweep().catch((error) => {
47:       console.error("[InvitationSweeper] Sweep run failed:", error);
48:     });
49:   });
50:   sweeperStarted = true;
51:   logDebug(`Invitation sweeper started (expiry: ${EXPIRY_DAYS} days)`);
52: };
</file>

