  9: interface ModalContextValue {
 10:   isOpen: boolean;
 11:   onClose: () => void;
 12: }
 13: const ModalContext = React.createContext<ModalContextValue | undefined>(
 14:   undefined
 15: );
 16: function useModal() {
 17:   const context = React.useContext(ModalContext);
 18:   if (!context) {
 19:     throw new Error("Modal components must be used within a Modal");
 20:   }
 21:   return context;
 22: }
 23: interface ModalProps {
 24:   isOpen: boolean;
 25:   onClose: () => void;
 26:   children: React.ReactNode;
 27:   closeOnOverlayClick?: boolean;
 28:   closeOnEscape?: boolean;
 29: }
 30: export function Modal({
 31:   isOpen,
 32:   onClose,
 33:   children,
 34:   closeOnOverlayClick = true,
 35:   closeOnEscape = true,
 36: }: ModalProps) {
 37:   const [mounted, setMounted] = React.useState(false);
 38:   useEffect(() => {
 39:     setMounted(true);
 40:   }, []);
 41:   useEffect(() => {
 42:     if (!closeOnEscape || !isOpen) return;
 43:     const handleKeyDown = (e: KeyboardEvent) => {
 44:       if (e.key === "Escape") {
 45:         onClose();
 46:       }
 47:     };
 48:     document.addEventListener("keydown", handleKeyDown);
 49:     return () => document.removeEventListener("keydown", handleKeyDown);
 50:   }, [closeOnEscape, isOpen, onClose]);
 51:   useEffect(() => {
 52:     if (isOpen) {
 53:       const originalStyle = window.getComputedStyle(document.body).overflow;
 54:       document.body.style.overflow = "hidden";
 55:       return () => {
 56:         document.body.style.overflow = originalStyle;
 57:       };
 58:     }
 59:   }, [isOpen]);
 60:   if (!mounted) return null;
 61:   return createPortal(
 62:     <ModalContext.Provider value={{ isOpen, onClose }}>
 63:       <AnimatePresence mode="wait">
 64:         {isOpen && (
 65:           <div className="fixed inset-0 z-[100] flex items-center justify-center">
 66:             {}
 67:             <motion.div
 68:               initial={{ opacity: 0 }}
 69:               animate={{ opacity: 1 }}
 70:               exit={{ opacity: 0 }}
 71:               transition={{ duration: 0.2 }}
 72:               className="absolute inset-0 bg-black/60 backdrop-blur-sm"
 73:               onClick={closeOnOverlayClick ? onClose : undefined}
 74:             />
 75:             {children}
 76:           </div>
 77:         )}
 78:       </AnimatePresence>
 79:     </ModalContext.Provider>,
 80:     document.body
 81:   );
 82: }
