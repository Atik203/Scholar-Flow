 29:         console.error(
 30:           `[PDFExtraction] Paper or file not found for ID: ${paperId}`
 31:         );
 32:         return {
 33:           success: false,
 34:           error: "Paper or file not found",
 35:         };
 36:       }
 37:       console.log(
 38:         `[PDFExtraction] Found paper: ${paper.title}, file: ${paper.file.objectKey}`
 39:       );
 40:       await prisma.paper.update({
 41:         where: { id: paperId },
 42:         data: { processingStatus: "PROCESSING" },
 43:       });
 44:       console.log(
 45:         `[PDFExtraction] Updated status to PROCESSING for paper: ${paperId}`
 46:       );
 47:       console.log(
 48:         `[PDFExtraction] Downloading PDF from S3: ${paper.file.objectKey}`
 49:       );
 50:       const pdfBuffer = await this.storage.getObject(paper.file.objectKey);
 51:       console.log(
 52:         `[PDFExtraction] Downloaded PDF buffer size: ${pdfBuffer.length} bytes`
 53:       );
 54:       console.log(`[PDFExtraction] Starting text extraction with pdf-parse`);
 55:       const pdfData = await pdf(pdfBuffer, {
 56:         max: 0,
 57:         version: "v1.10.100",
 58:       });
 59:       const extractedText = pdfData.text;
 60:       const pageCount = pdfData.numpages;
 61:       console.log(
 62:         `[PDFExtraction] Extracted text length: ${extractedText.length}, pages: ${pageCount}`
 63:       );
 64:       if (!extractedText || extractedText.trim().length === 0) {
 65:         console.error(
 66:           `[PDFExtraction] No text content found in PDF for paper: ${paperId}`
 67:         );
 68:         await prisma.paper.update({
 69:           where: { id: paperId },
 70:           data: {
 71:             processingStatus: "FAILED",
 72:             processingError: "No text content found in PDF",
 73:           },
 74:         });
 75:         return {
 76:           success: false,
 77:           error: "No text content found in PDF",
 78:         };
 79:       }
 80:       const sanitizedFullText = this.sanitizeText(extractedText);
 81:       console.log(`[PDFExtraction] Creating chunks for paper: ${paperId}`);
 82:       const chunks = this.chunkText(sanitizedFullText, pageCount);
 83:       console.log(`[PDFExtraction] Created ${chunks.length} chunks`);
 84:       console.log(
 85:         `[PDFExtraction] Storing chunks in database for paper: ${paperId}`
 86:       );
 87:       await this.storeChunks(paperId, chunks);
 88:       console.log(
 89:         `[PDFExtraction] Updating paper status to PROCESSED for paper: ${paperId}`
 90:       );
 91:       await Promise.all([
 92:         prisma.paper.update({
 93:           where: { id: paperId },
 94:           data: {
 95:             processingStatus: "PROCESSED",
 96:             processedAt: new Date(),
 97:           },
 98:         }),
 99:         prisma.paperFile.update({
100:           where: { paperId },
101:           data: {
102:             pageCount,
103:             extractedAt: new Date(),
104:           },
105:         }),
106:       ]);
107:       console.log(
108:         `[PDFExtraction] Successfully completed extraction for paper: ${paperId}`
109:       );
110:       return {
111:         success: true,
112:         text: extractedText,
113:         pageCount,
