363:                     {[...Array(3)].map((_, i) => (
364:                       <Skeleton key={i} className="h-24 w-full" />
365:                     ))}
366:                   </div>
367:                 ) : chunksError ? (
368:                   <div className="text-center py-8">
369:                     <AlertCircle className="h-8 w-8 mx-auto mb-4 text-muted-foreground" />
370:                     <p className="text-muted-foreground">
371:                       Failed to load extracted text chunks
372:                     </p>
373:                     <Button
374:                       onClick={refetchChunks}
375:                       variant="outline"
376:                       size="sm"
377:                       className="mt-2"
378:                     >
379:                       <RefreshCw className="h-4 w-4 mr-2" />
