119:           <div className="h-8 bg-muted rounded w-3/4" />
120:           <div className="h-3 bg-muted rounded w-1/4" />
121:         </div>
122:       </div>
123:     );
124:   }
125:   return (
126:     <div
127:       className={`${cardVariants({ variant, padding, hover, size })} ${sizeClasses[currentSize]} ${onClick ? "cursor-pointer" : ""} ${className || ""}`}
128:       onClick={onClick}
