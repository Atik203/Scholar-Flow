1364:     try {
1365:       // Find all img tags and convert them to base64
1366:       const imgRegex = /<img[^>]+src="([^"]+)"[^>]*>/g;
1367:       const images: Array<{ original: string; base64: string }> = [];
1368:       let match;
1369:       while ((match = imgRegex.exec(processedContent)) !== null) {
1370:         const imgUrl = match[1];
1371:         // Skip if already processed or if it's already base64
1372:         if (
