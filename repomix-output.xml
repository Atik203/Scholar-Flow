<file path="apps/frontend/src/components/activity/ActivityLog.tsx">
  1: "use client";
  2: import { useMemo, useState } from "react";
  3: import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
  4: import { Badge } from "@/components/ui/badge";
  5: import { Button } from "@/components/ui/button";
  6: import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
  7: import {
  8:   Select,
  9:   SelectContent,
 10:   SelectItem,
 11:   SelectTrigger,
 12:   SelectValue,
 13: } from "@/components/ui/select";
 14: import { showErrorToast, showSuccessToast } from "@/components/providers/ToastProvider";
 15: import {
 16:   Activity,
 17:   Download,
 18:   Loader2,
 19:   User,
 20:   FileText,
 21:   BookOpen,
 22:   Layers,
 23:   MessageSquare,
 24:   AlertCircle,
 25:   Info,
 26:   AlertTriangle,
 27: } from "lucide-react";
 28: import { format } from "date-fns";
 29: import { cn } from "@/lib/utils";
 30: import {
 31:   useGetActivityLogQuery,
 32:   useLazyExportActivityLogQuery,
 33:   type ActivityLogEntry,
 34:   type ActivityLogFilters,
 35: } from "@/redux/api/discussionApi";
 36: interface ActivityLogProps {
 37:   workspaceId?: string;
 38:   entity?: string;
 39:   entityId?: string;
 40:   limit?: number;
 41: }
 42: const severityIcons = {
 43:   INFO: Info,
 44:   WARNING: AlertTriangle,
 45:   ERROR: AlertCircle,
 46:   CRITICAL: AlertCircle,
 47: };
 48: const severityColors = {
 49:   INFO: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
 50:   WARNING: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300',
 51:   ERROR: 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300',
 52:   CRITICAL: 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300',
 53: };
 54: const entityIcons = {
 55:   paper: FileText,
 56:   collection: BookOpen,
 57:   workspace: Layers,
 58:   discussion: MessageSquare,
 59:   user: User,
 60: };
 61: const actionLabels = {
 62:   created: 'Created',
 63:   updated: 'Updated',
 64:   deleted: 'Deleted',
 65:   shared: 'Shared',
 66:   exported: 'Exported',
 67:   message_added: 'Message Added',
 68:   message_updated: 'Message Updated',
 69:   message_deleted: 'Message Deleted',
 70: };
 71: export function ActivityLog({ workspaceId, entity, entityId, limit = 50 }: ActivityLogProps) {
 72:   const [filters, setFilters] = useState({
 73:     entity: entity || '',
 74:     action: '',
 75:     severity: '',
 76:   });
 77:   const queryArgs = useMemo<ActivityLogFilters>(() => {
 78:     const args: ActivityLogFilters = { limit };
 79:     if (workspaceId) args.workspaceId = workspaceId;
 80:     if (entityId) args.entityId = entityId;
 81:     if (filters.entity) args.entity = filters.entity;
 82:     if (filters.action) args.action = filters.action;
 83:     if (filters.severity) args.severity = filters.severity as ActivityLogFilters["severity"];
 84:     return args;
 85:   }, [workspaceId, entityId, filters, limit]);
 86:   const { data, isLoading, isError } = useGetActivityLogQuery(queryArgs);
 87:   const activities = data?.entries || [];
 88:   const [exportActivityLog, { isFetching: isExporting }] =
 89:     useLazyExportActivityLogQuery();
 90:   const getUserDisplayName = (user?: ActivityLogEntry['user']) => {
 91:     if (!user) return 'System';
 92:     if (user.firstName && user.lastName) {
 93:       return `${user.firstName} ${user.lastName}`;
 94:     }
 95:     return user.name || 'Unknown User';
 96:   };
 97:   const getUserInitials = (user?: ActivityLogEntry['user']) => {
 98:     if (!user) return 'S';
 99:     if (user.firstName && user.lastName) {
100:       return `${user.firstName[0]}${user.lastName[0]}`.toUpperCase();
101:     }
102:     if (user.name) {
103:       return user.name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
104:     }
105:     return 'U';
106:   };
107:   const getEntityIcon = (entity: string) => {
108:     const Icon = entityIcons[entity as keyof typeof entityIcons] || Activity;
109:     return <Icon className="h-4 w-4" />;
110:   };
111:   const getSeverityIcon = (severity: string) => {
112:     const Icon = severityIcons[severity as keyof typeof severityIcons] || Info;
113:     return <Icon className="h-3 w-3" />;
114:   };
115:   const handleExport = async () => {
116:     try {
117:       const result = await exportActivityLog({
118:         ...queryArgs,
119:         format: 'csv',
120:       }).unwrap();
121:       const blob = new Blob([result.content], { type: 'text/csv' });
122:       const url = URL.createObjectURL(blob);
123:       const link = document.createElement('a');
124:       link.href = url;
125:       link.download = result.filename || 'activity-log.csv';
126:       document.body.appendChild(link);
127:       link.click();
128:       document.body.removeChild(link);
129:       URL.revokeObjectURL(url);
130:       showSuccessToast('Activity log exported');
131:     } catch (error) {
132:       showErrorToast('Failed to export activity log');
133:     }
134:   };
135:   if (isLoading) {
136:     return (
137:       <Card>
138:         <CardHeader>
139:           <CardTitle className="flex items-center gap-2">
140:             <Activity className="h-5 w-5" />
141:             Activity Log
142:           </CardTitle>
143:         </CardHeader>
144:         <CardContent>
145:           <div className="flex items-center justify-center py-8">
146:             <Loader2 className="h-6 w-6 animate-spin" />
147:           </div>
148:         </CardContent>
149:       </Card>
150:     );
151:   }
152:   return (
153:     <Card>
154:       <CardHeader>
155:         <div className="flex items-center justify-between">
156:           <CardTitle className="flex items-center gap-2">
157:             <Activity className="h-5 w-5" />
158:             Activity Log
159:           </CardTitle>
160:           <Button onClick={handleExport} size="sm" variant="outline" disabled={isExporting}>
161:             {isExporting ? (
162:               <Loader2 className="h-4 w-4 mr-2 animate-spin" />
163:             ) : (
164:               <Download className="h-4 w-4 mr-2" />
165:             )}
166:             Export
167:           </Button>
168:         </div>
169:       </CardHeader>
170:       <CardContent className="space-y-4">
171:         {}
172:         <div className="flex flex-wrap gap-2">
173:           <Select
174:             value={filters.entity}
175:             onValueChange={(value) => setFilters(prev => ({ ...prev, entity: value }))}
176:           >
177:             <SelectTrigger className="w-[140px]">
178:               <SelectValue placeholder="Entity" />
179:             </SelectTrigger>
180:             <SelectContent>
181:               <SelectItem value="">All Entities</SelectItem>
182:               <SelectItem value="paper">Papers</SelectItem>
183:               <SelectItem value="collection">Collections</SelectItem>
184:               <SelectItem value="workspace">Workspaces</SelectItem>
185:               <SelectItem value="discussion">Discussions</SelectItem>
186:             </SelectContent>
187:           </Select>
188:           <Select
189:             value={filters.action}
190:             onValueChange={(value) => setFilters(prev => ({ ...prev, action: value }))}
191:           >
192:             <SelectTrigger className="w-[140px]">
193:               <SelectValue placeholder="Action" />
194:             </SelectTrigger>
195:             <SelectContent>
196:               <SelectItem value="">All Actions</SelectItem>
197:               <SelectItem value="created">Created</SelectItem>
198:               <SelectItem value="updated">Updated</SelectItem>
199:               <SelectItem value="deleted">Deleted</SelectItem>
200:               <SelectItem value="shared">Shared</SelectItem>
201:               <SelectItem value="exported">Exported</SelectItem>
202:             </SelectContent>
203:           </Select>
204:           <Select
205:             value={filters.severity}
206:             onValueChange={(value) => setFilters(prev => ({ ...prev, severity: value }))}
207:           >
208:             <SelectTrigger className="w-[140px]">
209:               <SelectValue placeholder="Severity" />
210:             </SelectTrigger>
211:             <SelectContent>
212:               <SelectItem value="">All Severities</SelectItem>
213:               <SelectItem value="INFO">Info</SelectItem>
214:               <SelectItem value="WARNING">Warning</SelectItem>
215:               <SelectItem value="ERROR">Error</SelectItem>
216:               <SelectItem value="CRITICAL">Critical</SelectItem>
217:             </SelectContent>
218:           </Select>
219:         </div>
220:         {}
221:         <div className="space-y-3">
222:           {isError ? (
223:             <div className="text-center py-8 text-destructive">
224:               Failed to load activity log
225:             </div>
226:           ) : activities.length === 0 ? (
227:             <div className="text-center py-8 text-muted-foreground">
228:               No activities found
229:             </div>
230:           ) : (
231:             activities.map((activity) => (
232:               <div key={activity.id} className="flex items-start gap-3 p-3 border rounded-lg">
233:                 <Avatar className="h-8 w-8">
234:                   <AvatarImage src={activity.user?.image} />
235:                   <AvatarFallback className="text-xs">
236:                     {getUserInitials(activity.user)}
237:                   </AvatarFallback>
238:                 </Avatar>
239:                 <div className="flex-1 min-w-0">
240:                   <div className="flex items-center gap-2 mb-1">
241:                     <span className="font-medium text-sm">
242:                       {getUserDisplayName(activity.user)}
243:                     </span>
244:                     <span className="text-sm text-muted-foreground">
245:                       {actionLabels[activity.action as keyof typeof actionLabels] || activity.action}
246:                     </span>
247:                     <div className="flex items-center gap-1">
248:                       {getEntityIcon(activity.entity)}
249:                       <span className="text-sm text-muted-foreground capitalize">
250:                         {activity.entity}
251:                       </span>
252:                     </div>
253:                     <Badge
254:                       variant="secondary"
255:                       className={cn("text-xs", severityColors[activity.severity])}
256:                     >
257:                       {getSeverityIcon(activity.severity)}
258:                       <span className="ml-1">{activity.severity}</span>
259:                     </Badge>
260:                   </div>
261:                   {activity.details && (
262:                     <div className="text-sm text-muted-foreground">
263:                       {typeof activity.details === 'string'
264:                         ? activity.details
265:                         : JSON.stringify(activity.details)
266:                       }
267:                     </div>
268:                   )}
269:                   <div className="text-xs text-muted-foreground mt-1">
270:                     {format(new Date(activity.createdAt), 'MMM dd, yyyy HH:mm')}
271:                   </div>
272:                 </div>
273:               </div>
274:             ))
275:           )}
276:         </div>
277:       </CardContent>
278:     </Card>
279:   );
280: }
