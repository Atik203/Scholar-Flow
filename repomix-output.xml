30:         clearInterval(pingInterval);
31:       }
32:     }, 30000);
33:     const cleanup = () => {
34:       clearInterval(pingInterval);
35:       unsubscribe();
36:     };
37:     req.on("close", cleanup);
38:     req.on("error", cleanup);
39:   },
