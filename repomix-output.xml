 45: const LEGACY_ROLE_SEGMENTS = [
 46:   "/dashboard/researcher",
 47:   "/dashboard/pro-researcher",
 48:   "/dashboard/team-lead",
 49:   "/dashboard/admin",
 50: ];
 51: function matchesRoute(routes: string[], path: string): boolean {
 52:   return routes.some((route) => path === route || path.startsWith(route + "/"));
 53: }
 54: function isAuthenticated(request: Request): boolean {
 55:   const cookieHeader = request.headers.get("cookie") || "";
 56:   const hasSfAuth = cookieHeader.includes("sf_auth=1");
 57:   const hasBetterAuth = cookieHeader.includes("better-auth.session_token");
 58:   return hasSfAuth || hasBetterAuth;
 59: }
 60: export function proxy(request: Request) {
 61:   const url = new URL(request.url);
 62:   const { pathname } = url;
 63:   const createRedirect = (redirectPath: string) => {
 64:     return NextResponse.redirect(new URL(redirectPath, request.url));
 65:   };
 66:   const authenticated = isAuthenticated(request);
 67:   if (pathname.startsWith("/api/")) {
 68:     return NextResponse.next();
 69:   }
 70:   if (
 71:     pathname.startsWith("/_next/") ||
 72:     pathname.startsWith("/static/") ||
 73:     pathname.includes(".")
 74:   ) {
 75:     return NextResponse.next();
 76:   }
 77:   for (const segment of LEGACY_ROLE_SEGMENTS) {
 78:     if (pathname === segment || pathname.startsWith(segment + "/")) {
 79:       const tail = pathname.slice(segment.length);
 80:       let target: string;
 81:       if (segment === "/dashboard/admin") {
 82:         const rest = tail.startsWith("/") ? tail.slice(1) : tail;
 83:         const firstSegment = rest.split("/")[0];
 84:         const adminResources = new Set([
 85:           "users",
 86:           "subscriptions",
 87:           "plans",
 88:           "payments",
 89:           "reports",
 90:           "audit",
 91:           "webhooks",
 92:           "api-keys",
 93:           "moderation",
 94:           "alerts",
 95:           "system",
 96:           "settings",
 97:           "analytics",
 98:         ]);
 99:         if (!firstSegment || !adminResources.has(firstSegment)) {
100:           target = `/dashboard${tail || ""}`;
101:         } else {
102:           return NextResponse.next();
103:         }
104:       } else {
105:         target = `/dashboard${tail}`;
106:       }
107:       return createRedirect(`${target}${url.search}`);
108:     }
109:   }
110:   const callbackUrl = url.searchParams.get("callbackUrl");
111:   if (authenticated && matchesRoute(authRoutes, pathname)) {
112:     if (callbackUrl) {
113:       return createRedirect(callbackUrl);
114:     }
115:     return createRedirect("/dashboard");
116:   }
117:   if (!authenticated && matchesRoute(protectedRoutes, pathname)) {
118:     return createRedirect(`/login?callbackUrl=${encodeURIComponent(pathname)}`);
119:   }
120:   if (matchesRoute(publicRoutes, pathname)) {
121:     return NextResponse.next();
122:   }
123:   if (pathname === "/") {
124:     return NextResponse.next();
125:   }
126:   return NextResponse.next();
127: }
