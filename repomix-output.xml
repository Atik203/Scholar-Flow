 12: interface AnnotationLayerEnhancedProps {
 13:   annotations: Annotation[];
 14:   scale: number;
 15:   rotation: number;
 16:   pageToViewport: (
 17:     x: number,
 18:     y: number,
 19:     pageWidth: number,
 20:     pageHeight: number
 21:   ) => { x: number; y: number };
 22:   onAnnotationClick: (annotation: Annotation) => void;
 23:   onAnnotationEdit: (annotation: Annotation) => void;
 24:   onAnnotationDelete: (annotationId: string) => void;
 25:   className?: string;
 26: }
 27: export function AnnotationLayerEnhanced({
 28:   annotations,
 29:   scale,
 30:   rotation,
 31:   pageToViewport,
 32:   onAnnotationClick,
 33:   onAnnotationEdit,
 34:   onAnnotationDelete,
 35:   className = "",
 36: }: AnnotationLayerEnhancedProps) {
 37:   const getAnnotationStyle = (annotation: Annotation) => {
 38:     const { coordinates } = annotation.anchor;
 39:     // Use stored viewport or current viewport
 40:     const annotationScale = annotation.anchor.viewport?.scale || 1;
 41:     const annotationRotation = annotation.anchor.viewport?.rotation || 0;
 42:     // Calculate position with current scale
 43:     const scaleRatio = scale / annotationScale;
 44:     const left = coordinates.x * scale;
 45:     const top = coordinates.y * scale;
 46:     const width = coordinates.width * scale;
 47:     const height = coordinates.height * scale;
 48:     const baseStyle: React.CSSProperties = {
 49:       position: "absolute",
 50:       left: `${left}px`,
 51:       top: `${top}px`,
 52:       width: `${width}px`,
 53:       height: `${height}px`,
 54:       pointerEvents: "auto",
 55:       cursor: "pointer",
 56:       transition: "opacity 0.2s",
 57:       zIndex: 10,
 58:     };
 59:     switch (annotation.type) {
 60:       case "HIGHLIGHT":
 61:         return {
 62:           ...baseStyle,
 63:           backgroundColor: "rgba(255, 255, 0, 0.35)",
 64:           border: "1px solid rgba(255, 193, 7, 0.6)",
 65:           mixBlendMode: "multiply" as const,
 66:         };
 67:       case "UNDERLINE":
 68:         return {
 69:           ...baseStyle,
 70:           height: "3px",
 71:           top: `${top + height - 3}px`,
 72:           backgroundColor: "rgba(33, 150, 243, 0.8)",
 73:           borderRadius: "1px",
 74:         };
 75:       case "STRIKETHROUGH":
 76:         return {
 77:           ...baseStyle,
 78:           height: "2px",
 79:           top: `${top + height / 2}px`,
 80:           backgroundColor: "rgba(244, 67, 54, 0.8)",
 81:           borderRadius: "1px",
 82:         };
 83:       case "AREA":
 84:         return {
 85:           ...baseStyle,
 86:           backgroundColor: "rgba(156, 39, 176, 0.15)",
 87:           border: "2px dashed rgba(156, 39, 176, 0.6)",
 88:           borderRadius: "4px",
 89:         };
 90:       case "COMMENT":
 91:         return {
 92:           ...baseStyle,
 93:           backgroundColor: "rgba(33, 150, 243, 0.2)",
 94:           border: "2px solid rgba(33, 150, 243, 0.5)",
 95:           borderRadius: "4px",
 96:         };
 97:       case "NOTE":
 98:         return {
 99:           ...baseStyle,
100:           backgroundColor: "rgba(76, 175, 80, 0.2)",
101:           border: "2px solid rgba(76, 175, 80, 0.5)",
102:           borderRadius: "4px",
103:         };
104:       case "INK":
105:         return {
106:           ...baseStyle,
107:           backgroundColor: "transparent",
108:           border: "none",
109:         };
110:       default:
111:         return {
112:           ...baseStyle,
113:           backgroundColor: "rgba(158, 158, 158, 0.2)",
114:           border: "1px solid rgba(158, 158, 158, 0.5)",
115:         };
116:     }
117:   };
118:   const getAnnotationIcon = (type: AnnotationType) => {
119:     const iconClass = "h-4 w-4";
120:     switch (type) {
121:       case "HIGHLIGHT":
122:         return <Highlighter className={iconClass} />;
123:       case "UNDERLINE":
124:         return <Underline className={iconClass} />;
125:       case "STRIKETHROUGH":
126:         return <Strikethrough className={iconClass} />;
127:       case "AREA":
128:         return <Square className={iconClass} />;
129:       case "COMMENT":
130:         return <MessageSquare className={iconClass} />;
131:       case "NOTE":
132:         return <StickyNote className={iconClass} />;
133:       case "INK":
134:         return <Pen className={iconClass} />;
135:       default:
136:         return <Square className={iconClass} />;
137:     }
138:   };
139:   const getAnnotationColor = (type: AnnotationType) => {
140:     switch (type) {
141:       case "HIGHLIGHT":
142:         return "text-yellow-700 dark:text-yellow-300 bg-yellow-50 dark:bg-yellow-900/30 border-yellow-300 dark:border-yellow-700";
143:       case "UNDERLINE":
144:         return "text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/30 border-blue-300 dark:border-blue-700";
145:       case "STRIKETHROUGH":
146:         return "text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-900/30 border-red-300 dark:border-red-700";
147:       case "AREA":
148:         return "text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-900/30 border-purple-300 dark:border-purple-700";
149:       case "COMMENT":
150:         return "text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/30 border-blue-300 dark:border-blue-700";
151:       case "NOTE":
152:         return "text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-900/30 border-green-300 dark:border-green-700";
153:       case "INK":
154:         return "text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-900/30 border-gray-300 dark:border-gray-700";
155:       default:
156:         return "text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-900/30 border-gray-300 dark:border-gray-700";
157:     }
158:   };
159:   const renderInkAnnotation = (annotation: Annotation) => {
160:     if (!annotation.anchor.points || annotation.anchor.points.length === 0) {
161:       return null;
162:     }
163:     const points = annotation.anchor.points
164:       .map((p) => `${p.x * scale},${p.y * scale}`)
165:       .join(" ");
166:     return (
167:       <svg
168:         key={annotation.id}
169:         style={{
170:           position: "absolute",
171:           left: 0,
172:           top: 0,
173:           width: "100%",
174:           height: "100%",
175:           pointerEvents: "none",
176:           zIndex: 10,
177:         }}
178:       >
179:         <polyline
180:           points={points}
181:           fill="none"
182:           stroke="rgba(33, 150, 243, 0.8)"
183:           strokeWidth="2"
184:           strokeLinecap="round"
185:           strokeLinejoin="round"
186:         />
187:       </svg>
188:     );
189:   };
190:   return (
191:     <div className={`absolute inset-0 pointer-events-none ${className}`}>
192:       {annotations.map((annotation) => {
193:         if (annotation.type === "INK") {
194:           return renderInkAnnotation(annotation);
195:         }
196:         const colorClass = getAnnotationColor(annotation.type);
197:         return (
198:           <div
199:             key={annotation.id}
200:             style={getAnnotationStyle(annotation)}
201:             onClick={(e) => {
202:               e.stopPropagation();
203:               onAnnotationClick(annotation);
204:             }}
205:             className="group hover:opacity-80 transition-opacity"
206:             title={`${annotation.type}: ${annotation.text}`}
207:           >
208:             {}
209:             <div
210:               className={`absolute -top-3 -right-3 rounded-full p-1.5 shadow-md border ${colorClass} opacity-0 group-hover:opacity-100 transition-opacity z-20`}
211:             >
212:               {getAnnotationIcon(annotation.type)}
213:             </div>
214:             {}
215:             <div className="absolute top-full left-0 mt-2 bg-card dark:bg-card border rounded-lg shadow-xl p-3 max-w-xs opacity-0 group-hover:opacity-100 transition-opacity z-30 pointer-events-none">
216:               <div className="flex items-center gap-2 mb-2">
217:                 <div className={`p-1 rounded ${colorClass}`}>
218:                   {getAnnotationIcon(annotation.type)}
219:                 </div>
220:                 <div>
221:                   <div className="text-xs font-semibold">
222:                     {annotation.user.name}
223:                   </div>
224:                   <div className="text-xs text-muted-foreground">
225:                     {new Date(annotation.createdAt).toLocaleDateString()}
226:                   </div>
227:                 </div>
228:               </div>
229:               {annotation.anchor.selectedText && (
230:                 <div className="text-xs italic mb-2 p-2 bg-muted/50 rounded border-l-2 border-muted-foreground/30">
231:                   "{annotation.anchor.selectedText}"
232:                 </div>
233:               )}
234:               <div className="text-xs line-clamp-3">
235:                 {annotation.text}
236:               </div>
237:               {annotation.children && annotation.children.length > 0 && (
238:                 <div className="text-xs text-primary mt-2 font-medium">
239:                   {annotation.children.length}{" "}
240:                   {annotation.children.length === 1 ? "reply" : "replies"}
241:                 </div>
242:               )}
243:             </div>
244:           </div>
245:         );
246:       })}
247:     </div>
248:   );
249: }
