<file path="apps/frontend/src/components/customUI/form/SelectField.tsx">
  1: import { cn } from "@/lib/utils";
  2: import { Check, ChevronDown, Search } from "lucide-react";
  3: import * as React from "react";
  4: export interface SelectOption {
  5:   value: string;
  6:   label: string;
  7:   disabled?: boolean;
  8: }
  9: export interface SelectFieldProps
 10:   extends Omit<React.ComponentProps<"div">, "onChange"> {
 11:   options: SelectOption[];
 12:   value?: string;
 13:   onChange?: (value: string) => void;
 14:   placeholder?: string;
 15:   searchable?: boolean;
 16:   disabled?: boolean;
 17:   error?: boolean;
 18:   required?: boolean;
 19:   label?: string;
 20:   helperText?: string;
 21: }
 22: export const SelectField = React.forwardRef<HTMLDivElement, SelectFieldProps>(
 23:   (
 24:     {
 25:       className,
 26:       options,
 27:       value,
 28:       onChange,
 29:       placeholder = "Select an option...",
 30:       searchable = false,
 31:       disabled = false,
 32:       error = false,
 33:       required = false,
 34:       label,
 35:       helperText,
 36:       ...props
 37:     },
 38:     ref
 39:   ) => {
 40:     const [isOpen, setIsOpen] = React.useState(false);
 41:     const [searchTerm, setSearchTerm] = React.useState("");
 42:     const [focusedIndex, setFocusedIndex] = React.useState(-1);
 43:     const containerRef = React.useRef<HTMLDivElement>(null);
 44:     const searchInputRef = React.useRef<HTMLInputElement>(null);
 45:     const selectedOption = options.find((option) => option.value === value);
 46:     const filteredOptions = searchable
 47:       ? options.filter(
 48:           (option) =>
 49:             option.label.toLowerCase().includes(searchTerm.toLowerCase()) &&
 50:             !option.disabled
 51:         )
 52:       : options.filter((option) => !option.disabled);
 53:     React.useEffect(() => {
 54:       const handleClickOutside = (event: MouseEvent) => {
 55:         if (
 56:           containerRef.current &&
 57:           !containerRef.current.contains(event.target as Node)
 58:         ) {
 59:           setIsOpen(false);
 60:           setSearchTerm("");
 61:           setFocusedIndex(-1);
 62:         }
 63:       };
 64:       document.addEventListener("mousedown", handleClickOutside);
 65:       return () =>
 66:         document.removeEventListener("mousedown", handleClickOutside);
 67:     }, []);
 68:     React.useEffect(() => {
 69:       if (isOpen && searchable && searchInputRef.current) {
 70:         searchInputRef.current.focus();
 71:       }
 72:     }, [isOpen, searchable]);
 73:     const handleSelect = (option: SelectOption) => {
 74:       if (option.disabled) return;
 75:       onChange?.(option.value);
 76:       setIsOpen(false);
 77:       setSearchTerm("");
 78:       setFocusedIndex(-1);
 79:     };
 80:     const handleKeyDown = (e: React.KeyboardEvent) => {
 81:       if (!isOpen) {
 82:         if (e.key === "Enter" || e.key === " ") {
 83:           e.preventDefault();
 84:           setIsOpen(true);
 85:         }
 86:         return;
 87:       }
 88:       switch (e.key) {
 89:         case "ArrowDown":
 90:           e.preventDefault();
 91:           setFocusedIndex((prev) =>
 92:             prev < filteredOptions.length - 1 ? prev + 1 : 0
 93:           );
 94:           break;
 95:         case "ArrowUp":
 96:           e.preventDefault();
 97:           setFocusedIndex((prev) =>
 98:             prev > 0 ? prev - 1 : filteredOptions.length - 1
 99:           );
100:           break;
101:         case "Enter":
102:           e.preventDefault();
103:           if (focusedIndex >= 0 && focusedIndex < filteredOptions.length) {
104:             handleSelect(filteredOptions[focusedIndex]);
105:           }
106:           break;
107:         case "Escape":
108:           setIsOpen(false);
109:           setSearchTerm("");
110:           setFocusedIndex(-1);
111:           break;
112:       }
113:     };
114:     return (
115:       <div className={cn("relative", className)} ref={ref} {...props}>
116:         {label && (
117:           <label className="block text-sm font-medium mb-2">
118:             {label}
119:             {required && <span className="text-destructive ml-1">*</span>}
120:           </label>
121:         )}
122:         <div ref={containerRef} className="relative">
123:           <button
124:             type="button"
125:             onClick={() => !disabled && setIsOpen(!isOpen)}
126:             onKeyDown={handleKeyDown}
127:             disabled={disabled}
128:             className={cn(
129:               "relative w-full h-10 px-3 py-2 text-left bg-background border rounded-md shadow-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50",
130:               error
131:                 ? "border-destructive focus:ring-destructive"
132:                 : "border-border",
133:               isOpen && "ring-2 ring-ring ring-offset-2"
134:             )}
135:             aria-haspopup="listbox"
136:             aria-expanded={isOpen}
137:           >
138:             <span
139:               className={cn(
140:                 "block truncate",
141:                 !selectedOption && "text-muted-foreground"
142:               )}
143:             >
144:               {selectedOption ? selectedOption.label : placeholder}
145:             </span>
146:             <ChevronDown
147:               className={cn(
148:                 "absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground transition-transform",
149:                 isOpen && "rotate-180"
150:               )}
151:             />
152:           </button>
153:           {isOpen && (
154:             <div className="absolute z-50 w-full mt-1 bg-background border border-border rounded-md shadow-lg max-h-60 overflow-auto">
155:               {searchable && (
156:                 <div className="p-2 border-b border-border">
157:                   <div className="relative">
158:                     <Search className="absolute left-2 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
159:                     <input
160:                       ref={searchInputRef}
161:                       type="text"
162:                       value={searchTerm}
163:                       onChange={(e) => setSearchTerm(e.target.value)}
164:                       placeholder="Search options..."
165:                       className="w-full pl-8 pr-3 py-2 text-sm bg-transparent border-none outline-none placeholder:text-muted-foreground"
166:                     />
167:                   </div>
168:                 </div>
169:               )}
170:               <div className="py-1">
171:                 {filteredOptions.length === 0 ? (
172:                   <div className="px-3 py-2 text-sm text-muted-foreground">
173:                     No options found
174:                   </div>
175:                 ) : (
176:                   filteredOptions.map((option, index) => (
177:                     <button
178:                       key={option.value}
179:                       type="button"
180:                       onClick={() => handleSelect(option)}
181:                       onMouseEnter={() => setFocusedIndex(index)}
182:                       className={cn(
183:                         "relative w-full px-3 py-2 text-left text-sm cursor-pointer hover:bg-accent focus:bg-accent focus:outline-none",
184:                         option.disabled &&
185:                           "opacity-50 cursor-not-allowed hover:bg-transparent",
186:                         focusedIndex === index && "bg-accent",
187:                         option.value === value &&
188:                           "bg-primary text-primary-foreground hover:bg-primary"
189:                       )}
190:                       disabled={option.disabled}
191:                     >
192:                       <span className="block truncate">{option.label}</span>
193:                       {option.value === value && (
194:                         <Check className="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4" />
195:                       )}
196:                     </button>
197:                   ))
198:                 )}
199:               </div>
200:             </div>
201:           )}
202:         </div>
203:         {helperText && (
204:           <p
205:             className={cn(
206:               "mt-1 text-xs text-muted-foreground",
207:               error && "text-destructive"
208:             )}
209:           >
210:             {helperText}
211:           </p>
212:         )}
213:       </div>
214:     );
215:   }
216: );
217: SelectField.displayName = "SelectField";
</file>

