 17:   size = "md",
 18:   variant = "soft",
 19:   className,
 20: }: RoleBadgeProps) {
 21:   const roleLabel = ROLE_LABELS[role as keyof typeof ROLE_LABELS] || role;
 22:   const sizeClasses = {
 23:     sm: "text-xs px-2 py-0.5",
 24:     md: "text-sm px-2.5 py-0.5",
 25:     lg: "text-base px-3 py-1",
 26:   };
 27:   const getVariantClasses = () => {
 28:     switch (variant) {
 29:       case "solid":
 30:         return getRoleBadgeVariant(role);
 31:       case "outline":
 32:         return (
 33:           "border-2 bg-transparent " +
 34:           getRoleColor(role).replace("bg-", "border-").replace("-50", "-200")
 35:         );
 36:       case "soft":
 37:       default:
 38:         return cn("border", getRoleColor(role));
 39:     }
 40:   };
 41:   return (
 42:     <Badge
 43:       variant={variant === "solid" ? getRoleBadgeVariant(role) : "outline"}
 44:       className={cn(
 45:         sizeClasses[size],
 46:         variant !== "solid" && getRoleColor(role),
 47:         "font-medium",
 48:         className
 49:       )}
 50:     >
 51:       {roleLabel}
 52:     </Badge>
 53:   );
 54: }
 55: interface RoleIndicatorProps {
 56:   role: string;
 57:   showLabel?: boolean;
 58:   size?: "sm" | "md" | "lg";
 59: }
 60: export function RoleIndicator({
 61:   role,
 62:   showLabel = true,
 63:   size = "md",
 64: }: RoleIndicatorProps) {
 65:   const getIndicatorColor = () => {
 66:     switch (role) {
 67:       case USER_ROLES.ADMIN:
 68:         return "bg-red-500";
 69:       case USER_ROLES.TEAM_LEAD:
 70:         return "bg-blue-500";
 71:       case USER_ROLES.PRO_RESEARCHER:
 72:         return "bg-green-500";
 73:       case USER_ROLES.RESEARCHER:
 74:       default:
 75:         return "bg-gray-500";
 76:     }
 77:   };
 78:   const getSizeClasses = () => {
 79:     switch (size) {
 80:       case "sm":
 81:         return "w-2 h-2";
 82:       case "lg":
 83:         return "w-4 h-4";
 84:       case "md":
 85:       default:
 86:         return "w-3 h-3";
 87:     }
 88:   };
 89:   return (
 90:     <div className="flex items-center gap-2">
 91:       <div
 92:         className={cn("rounded-full", getIndicatorColor(), getSizeClasses())}
 93:       />
 94:       {showLabel && (
 95:         <span
 96:           className={cn(
 97:             "font-medium",
 98:             size === "sm" ? "text-xs" : size === "lg" ? "text-base" : "text-sm"
 99:           )}
100:         >
101:           {ROLE_LABELS[role as keyof typeof ROLE_LABELS] || role}
102:         </span>
103:       )}
104:     </div>
105:   );
106: }
