559: /**
560:  * Update user preferences (upsert semantics)
561:  * Phase 3 - User preference data layer
562:  */
563: const updatePreferences = async (
564:   user: IAuthUser,
565:   payload: UpdatePreferencesInput
566: ) => {
567:   if (!user || !user.id) {
568:     throw new ApiError(401, "User authentication failed");
569:   }
570:   try {
571:     const existing = await prisma.$queryRaw<any[]>`
572:       SELECT id FROM "UserPreference" WHERE "userId" = ${user.id} LIMIT 1
573:     `;
574:     if (existing.length === 0) {
575:       // Insert with provided values (fall back to defaults)
576:       const theme = payload.theme ?? "system";
577:       const language = payload.language ?? "en";
578:       const timezone = payload.timezone ?? "UTC";
579:       const emailDigest = payload.emailDigest ?? true;
580:       const defaultCitationStyle = payload.defaultCitationStyle ?? "APA";
581:       const compactMode = payload.compactMode ?? false;
582:       const metadata = payload.metadata
583:         ? JSON.stringify(payload.metadata)
584:         : null;
585:       await prisma.$queryRaw`
586:         INSERT INTO "UserPreference" (id, "userId", theme, language, timezone,
587:                                        "emailDigest", "defaultCitationStyle",
588:                                        "compactMode", metadata, "createdAt", "updatedAt")
589:         VALUES (gen_random_uuid()::text, ${user.id}, ${theme}, ${language}, ${timezone},
590:                 ${emailDigest}, ${defaultCitationStyle}, ${compactMode},
591:                 ${metadata}::jsonb, NOW(), NOW())
592:       `;
593:     } else {
594:       // Build dynamic update
595:       const sets: string[] = [];
596:       const params: any[] = [];
597:       let idx = 1;
598:       if (payload.theme !== undefined) {
599:         sets.push(`theme = $${idx++}`);
600:         params.push(payload.theme);
601:       }
602:       if (payload.language !== undefined) {
603:         sets.push(`language = $${idx++}`);
604:         params.push(payload.language);
605:       }
606:       if (payload.timezone !== undefined) {
607:         sets.push(`timezone = $${idx++}`);
608:         params.push(payload.timezone);
609:       }
610:       if (payload.emailDigest !== undefined) {
611:         sets.push(`"emailDigest" = $${idx++}`);
612:         params.push(payload.emailDigest);
613:       }
614:       if (payload.defaultCitationStyle !== undefined) {
615:         sets.push(`"defaultCitationStyle" = $${idx++}`);
616:         params.push(payload.defaultCitationStyle);
617:       }
618:       if (payload.compactMode !== undefined) {
619:         sets.push(`"compactMode" = $${idx++}`);
620:         params.push(payload.compactMode);
621:       }
622:       if (payload.metadata !== undefined) {
623:         sets.push(`metadata = $${idx++}::jsonb`);
624:         params.push(JSON.stringify(payload.metadata));
625:       }
626:       if (sets.length > 0) {
627:         if (payload.theme !== undefined) {
628:           await prisma.$executeRaw`
629:             UPDATE "UserPreference"
630:             SET theme = ${payload.theme}, "updatedAt" = NOW()
631:             WHERE "userId" = ${user.id}
632:           `;
633:         }
634:         if (payload.language !== undefined) {
635:           await prisma.$executeRaw`
636:             UPDATE "UserPreference"
637:             SET language = ${payload.language}, "updatedAt" = NOW()
638:             WHERE "userId" = ${user.id}
639:           `;
640:         }
641:         if (payload.timezone !== undefined) {
642:           await prisma.$executeRaw`
643:             UPDATE "UserPreference"
644:             SET timezone = ${payload.timezone}, "updatedAt" = NOW()
645:             WHERE "userId" = ${user.id}
646:           `;
647:         }
648:         if (payload.emailDigest !== undefined) {
649:           await prisma.$executeRaw`
650:             UPDATE "UserPreference"
651:             SET "emailDigest" = ${payload.emailDigest}, "updatedAt" = NOW()
652:             WHERE "userId" = ${user.id}
653:           `;
654:         }
655:         if (payload.defaultCitationStyle !== undefined) {
656:           await prisma.$executeRaw`
657:             UPDATE "UserPreference"
658:             SET "defaultCitationStyle" = ${payload.defaultCitationStyle}, "updatedAt" = NOW()
659:             WHERE "userId" = ${user.id}
660:           `;
661:         }
662:         if (payload.compactMode !== undefined) {
663:           await prisma.$executeRaw`
664:             UPDATE "UserPreference"
665:             SET "compactMode" = ${payload.compactMode}, "updatedAt" = NOW()
666:             WHERE "userId" = ${user.id}
667:           `;
668:         }
669:         if (payload.metadata !== undefined) {
670:           await prisma.$executeRaw`
671:             UPDATE "UserPreference"
672:             SET metadata = ${JSON.stringify(payload.metadata)}::jsonb, "updatedAt" = NOW()
673:             WHERE "userId" = ${user.id}
674:           `;
675:         }
676:       }
677:     }
678:     // Return updated row
679:     const updated = await prisma.$queryRaw<any[]>`
680:       SELECT id, "userId", theme, language, timezone, "emailDigest",
681:              "defaultCitationStyle", "compactMode", metadata,
682:              "createdAt", "updatedAt"
