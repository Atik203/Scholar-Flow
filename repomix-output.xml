167:                       textSizes[size].description
168:                     )}
169:                   >
170:                     {description}
171:                   </p>
172:                 )}
173:               </>
174:             )}
175:           </div>
176:           {change !== undefined && showTrend && !loading && (
177:             <div className="flex items-center gap-1">
