1511:       paperId: inserted.cp_paperId,
1512:       addedById: inserted.cp_addedById,
1513:       addedAt: inserted.cp_addedAt,
1514:       createdAt: inserted.cp_createdAt,
1515:       updatedAt: inserted.cp_updatedAt,
1516:       paper: {
