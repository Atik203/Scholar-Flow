  padding = "md",
  children,
  ...props
}: CardWithVariantsProps) {
  return (
    <div
      className={cn(
        "rounded-xl text-card-foreground",
        cardVariantStyles[variant],
        cardHoverStyles[hover],
        cardPaddingStyles[padding],
        className
      )}
      {...props}
    >
      {children}
    </div>
  );
}
