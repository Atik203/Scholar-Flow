289:       }
290:       if (error instanceof Error) {
291:         throw new AiError(
292:           502,
293:           error.message,
294:           "AI_PROVIDER_ERROR",
295:           error.stack
296:         );
297:       }
298:       throw new AiError(
299:         502,
300:         "Gemini metadata extraction failed",
301:         "AI_PROVIDER_ERROR"
302:       );
303:     }
