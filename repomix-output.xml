111:           <Button
112:             variant="secondary"
113:             size="sm"
114:             onClick={handleDownload}
115:             className="opacity-80 hover:opacity-100"
116:             title="Download PDF"
117:           >
118:             <Download className="h-3 w-3" />
119:           </Button>
120:         </div>
121:       </div>
122:     </div>
123:   );
124: }
