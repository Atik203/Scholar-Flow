213:                         </TableCell>
214:                         <TableCell>
215:                           {formatCurrency(s.totalSpent, "USD")}
216:                         </TableCell>
217:                         <TableCell className="text-right">
218:                           <div className="flex justify-end gap-1">
219:                             {s.status === "ACTIVE" && !s.cancelAtPeriodEnd && (
220:                               <Button
