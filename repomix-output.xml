 1: import type { Request, Response } from "express";
 2: import { AuthRequest } from "../../middleware/auth";
 3: import { notificationBroadcaster } from "./broadcast";
 4: export const notificationSseController = {
 5:   stream: (req: Request, res: Response): void => {
 6:     const authReq = req as AuthRequest;
 7:     const userId = authReq.user?.id || authReq.user?.userId;
 8:     if (!userId) {
 9:       res.status(401).json({ success: false, message: "Unauthorized" });
10:       return;
11:     }
12:     res.status(200);
13:     res.setHeader("Content-Type", "text/event-stream");
14:     res.setHeader("Cache-Control", "no-cache, no-transform");
15:     res.setHeader("Connection", "keep-alive");
16:     res.setHeader("X-Accel-Buffering", "no");
17:     res.flushHeaders?.();
18:     res.write(`retry: 5000\n\n`);
19:     res.write(
20:       `event: connected\ndata: ${JSON.stringify({
21:         userId,
22:         connectedAt: new Date().toISOString(),
23:       })}\n\n`
24:     );
25:     const unsubscribe = notificationBroadcaster.subscribe(userId, res);
26:     const pingInterval = setInterval(() => {
27:       try {
28:         res.write(`: ping ${Date.now()}\n\n`);
