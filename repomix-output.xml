 17: }
 18: const sizeClasses = {
 19:   sm: "max-w-md",
 20:   md: "max-w-lg",
 21:   lg: "max-w-2xl",
 22:   xl: "max-w-4xl",
 23:   full: "max-w-full h-full",
 24: };
 25: export const Modal: React.FC<ModalProps> = ({
 26:   isOpen,
 27:   onClose,
 28:   children,
 29:   title,
 30:   description,
 31:   size = "md",
 32:   closeOnOverlayClick = true,
 33:   closeOnEscape = true,
 34:   showCloseButton = true,
 35:   className,
 36:   overlayClassName,
 37: }) => {
 38:   const modalRef = React.useRef<HTMLDivElement>(null);
 39:   const previousFocusRef = React.useRef<HTMLElement | null>(null);
 40:   React.useEffect(() => {
 41:     if (isOpen) {
 42:       previousFocusRef.current = document.activeElement as HTMLElement;
 43:       modalRef.current?.focus();
 44:       document.body.style.overflow = "hidden";
 45:     } else {
 46:       document.body.style.overflow = "unset";
 47:       if (previousFocusRef.current) {
 48:         previousFocusRef.current.focus();
 49:       }
 50:     }
 51:     return () => {
 52:       document.body.style.overflow = "unset";
 53:     };
 54:   }, [isOpen]);
 55:   React.useEffect(() => {
 56:     const handleEscape = (e: KeyboardEvent) => {
 57:       if (closeOnEscape && e.key === "Escape") {
 58:         onClose();
 59:       }
 60:     };
 61:     if (isOpen) {
 62:       document.addEventListener("keydown", handleEscape);
 63:     }
 64:     return () => {
 65:       document.removeEventListener("keydown", handleEscape);
 66:     };
 67:   }, [isOpen, closeOnEscape, onClose]);
 68:   const handleOverlayClick = (e: React.MouseEvent) => {
 69:     if (closeOnOverlayClick && e.target === e.currentTarget) {
 70:       onClose();
 71:     }
 72:   };
 73:   const handleModalClick = (e: React.MouseEvent) => {
 74:     e.stopPropagation();
 75:   };
 76:   if (!isOpen) return null;
 77:   return (
 78:     <div
 79:       className={cn(
 80:         "fixed inset-0 z-50 flex items-center justify-center p-4",
 81:         overlayClassName
 82:       )}
 83:       onClick={handleOverlayClick}
 84:     >
 85:       {}
 86:       <div className="absolute inset-0 bg-black/50 backdrop-blur-sm" />
 87:       {}
 88:       <div
 89:         ref={modalRef}
 90:         className={cn(
 91:           "relative bg-background rounded-lg shadow-xl border max-h-[90vh] overflow-hidden",
 92:           sizeClasses[size],
 93:           className
 94:         )}
 95:         onClick={handleModalClick}
 96:         tabIndex={-1}
 97:         role="dialog"
 98:         aria-modal="true"
 99:         aria-labelledby={title ? "modal-title" : undefined}
100:         aria-describedby={description ? "modal-description" : undefined}
101:       >
102:         {}
103:         {(title || showCloseButton) && (
