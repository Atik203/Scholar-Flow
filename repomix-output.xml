  1: import prisma from "../../shared/prisma";
  2: import ApiError from "../../errors/ApiError";
  3: type TimeRange = "week" | "month" | "quarter" | "year";
  4: const rangeToDays: Record<TimeRange, number> = {
  5:   week: 7,
  6:   month: 30,
  7:   quarter: 90,
  8:   year: 365,
  9: };
 10: const dayKey = (d: Date): string => d.toISOString().split("T")[0];
 11: export const personalAnalyticsService = {
 12:   async getSummary(userId: string, timeRange: TimeRange = "month") {
 13:     const days = rangeToDays[timeRange];
 14:     const since = new Date(Date.now() - days * 24 * 60 * 60 * 1000);
 15:     const paperViews = await prisma.usageEvent.findMany({
 16:       where: {
 17:         userId,
 18:         kind: "paper_view",
 19:         createdAt: { gte: since },
 20:         isDeleted: false,
 21:       },
 22:       select: { paperId: true, createdAt: true },
 23:     });
 24:     const uniquePapersRead = new Set(paperViews.map((e) => e.paperId)).size;
 25:     const annotationsCount = await prisma.annotation.count({
 26:       where: { userId, isDeleted: false, createdAt: { gte: since } },
 27:     });
 28:     const discussionsCount = await prisma.discussionMessage.count({
 29:       where: { userId, isDeleted: false, createdAt: { gte: since } },
 30:     });
 31:     const readingEvents = await prisma.usageEvent.findMany({
 32:       where: {
 33:         userId,
 34:         kind: "reading_session",
 35:         createdAt: { gte: since },
 36:         isDeleted: false,
 37:       },
 38:       select: { units: true, createdAt: true },
 39:     });
 40:     const readingMinutes = readingEvents.reduce(
 41:       (sum, e) => sum + (e.units ?? 0),
 42:       0
 43:     );
 44:     const allViews = await prisma.usageEvent.findMany({
 45:       where: { userId, kind: "paper_view", isDeleted: false },
 46:       select: { createdAt: true },
 47:       take: 5000,
 48:     });
 49:     const productivityHours = buildHourHistogram(allViews.map((v) => v.createdAt));
 50:     const weeklyActivity = await buildWeeklyActivity(userId, since);
 51:     const streak = await computeStreak(userId);
 52:     const topPapers = await buildTopPapers(paperViews);
 53:     return {
 54:       timeRange,
 55:       stats: {
 56:         papersRead: uniquePapersRead,
 57:         annotations: annotationsCount,
 58:         discussions: discussionsCount,
 59:         readingMinutes,
 60:       },
 61:       streak,
 62:       productivityHours,
 63:       weeklyActivity,
 64:       topPapers,
 65:       achievements: ACHIEVEMENTS,
 66:     };
 67:   },
 68:   async startReadingSession(userId: string, paperId?: string) {
 69:     const workspaceId = paperId
 70:       ? (
 71:           await prisma.paper.findFirst({
 72:             where: { id: paperId, isDeleted: false },
 73:             select: { workspaceId: true },
 74:           })
 75:         )?.workspaceId ?? undefined
 76:       : undefined;
 77:     return prisma.usageEvent.create({
 78:       data: {
 79:         userId,
 80:         kind: "reading_session",
 81:         units: 0,
 82:         paperId,
 83:         ...(workspaceId ? { workspaceId } : {}),
 84:       },
 85:     });
 86:   },
 87:   async recordPaperView(userId: string, paperId: string) {
 88:     const paper = await prisma.paper.findFirst({
 89:       where: {
 90:         id: paperId,
 91:         isDeleted: false,
 92:         OR: [
 93:           { uploaderId: userId },
 94:           {
 95:             workspace: {
 96:               isDeleted: false,
 97:               OR: [
 98:                 { ownerId: userId },
 99:                 { members: { some: { userId, isDeleted: false } } },
100:               ],
101:             },
102:           },
103:         ],
104:       },
105:       select: { id: true, workspaceId: true },
106:     });
107:     if (!paper) return null;
108:     const windowStart = new Date(Date.now() - 24 * 60 * 60 * 1000);
109:     const existing = await prisma.usageEvent.findFirst({
110:       where: {
111:         userId,
112:         paperId: paper.id,
113:         kind: "paper_view",
114:         createdAt: { gte: windowStart },
115:         isDeleted: false,
116:       },
117:       select: { id: true },
118:     });
119:     if (existing) return existing;
120:     return prisma.usageEvent.create({
121:       data: {
122:         userId,
123:         paperId: paper.id,
124:         workspaceId: paper.workspaceId,
125:         kind: "paper_view",
126:         units: 1,
127:       },
128:     });
129:   },
130:   async stopReadingSession(userId: string, eventId: string, units: number) {
131:     const owned = await prisma.usageEvent.findFirst({
132:       where: { id: eventId, userId },
133:       select: { id: true },
134:     });
135:     if (!owned) {
136:       throw new ApiError(404, "Reading session not found");
137:     }
138:     return prisma.usageEvent.update({
139:       where: { id: eventId },
140:       data: { units: Math.max(0, Math.floor(units)) },
141:     });
142:   },
143: };
144: const buildHourHistogram = (
145:   dates: Date[]
146: ): Array<{ hour: string; value: number }> => {
147:   const buckets = new Array<string>(24).fill("0");
148:   for (const d of dates) {
149:     const h = d.getUTCHours();
150:     const cur = parseInt(buckets[h], 10);
151:     buckets[h] = String(cur + 1);
152:   }
153:   const result: Array<{ hour: string; value: number }> = [];
154:   for (let h = 0; h < 24; h += 1) {
155:     if (h % 2 === 0) {
156:       result.push({ hour: formatHour(h), value: parseInt(buckets[h], 10) });
157:     }
158:   }
159:   return result;
160: };
161: const formatHour = (h: number) => {
162:   if (h === 0) return "12AM";
163:   if (h < 12) return `${h}AM`;
164:   if (h === 12) return "12PM";
165:   return `${h - 12}PM`;
166: };
167: const buildWeeklyActivity = async (
168:   userId: string,
169:   since: Date
170: ): Promise<
171:   Array<{ day: string; papers: number; annotations: number; discussions: number }>
172: > => {
173:   const since7 = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
174:   const [views, annotations, messages] = await Promise.all([
175:     prisma.usageEvent.findMany({
176:       where: {
177:         userId,
178:         kind: "paper_view",
179:         createdAt: { gte: since7 },
180:         isDeleted: false,
181:       },
182:       select: { paperId: true, createdAt: true },
183:     }),
184:     prisma.annotation.findMany({
185:       where: { userId, isDeleted: false, createdAt: { gte: since7 } },
186:       select: { createdAt: true },
187:     }),
188:     prisma.discussionMessage.findMany({
189:       where: { userId, isDeleted: false, createdAt: { gte: since } },
190:       select: { createdAt: true },
191:     }),
192:   ]);
193:   const days: Array<{
194:     day: string;
195:     papers: number;
196:     annotations: number;
197:     discussions: number;
198:   }> = [];
199:   for (let i = 6; i >= 0; i -= 1) {
200:     const d = new Date(Date.now() - i * 24 * 60 * 60 * 1000);
201:     const key = dayKey(d);
202:     const day = d.toLocaleDateString("en-US", { weekday: "short" });
203:     days.push({
204:       day,
205:       papers: new Set(views.filter((v) => dayKey(v.createdAt) === key).map((v) => v.paperId)).size,
206:       annotations: annotations.filter((a) => dayKey(a.createdAt) === key).length,
207:       discussions: messages.filter((m) => dayKey(m.createdAt) === key).length,
208:     });
209:   }
210:   return days;
211: };
212: const computeStreak = async (userId: string) => {
213:   const events = await prisma.usageEvent.findMany({
214:     where: { userId, isDeleted: false },
215:     select: { createdAt: true },
216:     orderBy: { createdAt: "desc" },
217:     take: 2000,
218:   });
219:   if (events.length === 0) return { days: 0, lastSevenDays: [] as boolean[] };
220:   const activeDays = new Set(events.map((e) => dayKey(e.createdAt)));
221:   const today = new Date();
222:   let streak = 0;
223:   for (let i = 0; i < 30; i += 1) {
224:     const d = new Date(today.getTime() - i * 24 * 60 * 60 * 1000);
225:     if (activeDays.has(dayKey(d))) {
226:       streak += 1;
227:     } else if (i > 0) {
228:       break;
229:     }
230:   }
231:   const lastSevenDays: boolean[] = [];
232:   for (let i = 27; i >= 0; i -= 1) {
233:     const d = new Date(today.getTime() - i * 24 * 60 * 60 * 1000);
234:     lastSevenDays.push(activeDays.has(dayKey(d)));
235:   }
236:   return { days: streak, lastSevenDays };
237: };
238: const buildTopPapers = async (
239:   views: Array<{ paperId: string | null; createdAt: Date }>
240: ) => {
241:   if (views.length === 0) return [];
242:   const counts = new Map<string, number>();
243:   for (const v of views) {
244:     if (!v.paperId) continue;
245:     counts.set(v.paperId, (counts.get(v.paperId) ?? 0) + 1);
246:   }
247:   const top = Array.from(counts.entries())
248:     .sort((a, b) => b[1] - a[1])
249:     .slice(0, 5);
250:   if (top.length === 0) return [];
251:   const papers = await prisma.paper.findMany({
252:     where: { id: { in: top.map((t) => t[0]) }, isDeleted: false },
253:     select: {
254:       id: true,
255:       title: true,
256:       citationCount: true,
257:     },
258:   });
259:   return papers.map((p) => {
260:     const c = top.find((t) => t[0] === p.id)?.[1] ?? 0;
261:     return {
262:       id: p.id,
263:       title: p.title,
264:       views: c,
265:       citations: p.citationCount,
266:     };
267:   });
268: };
