<file path="apps/frontend/src/components/annotations/PdfAnnotationViewer.tsx">
  1: "use client";
  2: import {
  3:   showErrorToast,
  4:   showSuccessToast,
  5: } from "@/components/providers/ToastProvider";
  6: import { Badge } from "@/components/ui/badge";
  7: import { Button } from "@/components/ui/button";
  8: import {
  9:   AnnotationAnchor,
 10:   AnnotationType,
 11:   useCreateAnnotationMutation,
 12:   useGetPaperAnnotationsQuery,
 13: } from "@/redux/api/annotationApi";
 14: import {
 15:   ChevronLeft,
 16:   ChevronRight,
 17:   RotateCcw,
 18:   ZoomIn,
 19:   ZoomOut,
 20: } from "lucide-react";
 21: import { useCallback, useRef, useState } from "react";
 22: import { Document, Page, pdfjs } from "react-pdf";
 23: import "react-pdf/dist/Page/AnnotationLayer.css";
 24: import "react-pdf/dist/Page/TextLayer.css";
 25: import { AnnotationLayer } from "./AnnotationLayer";
 26: import { AnnotationList } from "./AnnotationList";
 27: import { AnnotationPopup } from "./AnnotationPopup";
 28: import { AnnotationToolbar } from "./AnnotationToolbar";
 29: pdfjs.GlobalWorkerOptions.workerSrc = `https://cdn.jsdelivr.net/npm/pdfjs-dist@${pdfjs.version}/build/pdf.worker.min.mjs`;
 30: interface PdfAnnotationViewerProps {
 31:   fileUrl: string;
 32:   paperId: string;
 33:   className?: string;
 34: }
 35: export function PdfAnnotationViewer({
 36:   fileUrl,
 37:   paperId,
 38:   className = "",
 39: }: PdfAnnotationViewerProps) {
 40:   // Debug logging
 41:   console.log("PdfAnnotationViewer props:", { fileUrl, paperId, className });
 42:   const [numPages, setNumPages] = useState<number>(0);
 43:   const [currentPage, setCurrentPage] = useState<number>(1);
 44:   const [scale, setScale] = useState<number>(1.0);
 45:   const [rotation, setRotation] = useState<number>(0);
 46:   const [selectedText, setSelectedText] = useState<string>("");
 47:   const [selection, setSelection] = useState<AnnotationAnchor | null>(null);
 48:   const [isAnnotationPopupOpen, setIsAnnotationPopupOpen] = useState(false);
 49:   const [annotationType, setAnnotationType] =
 50:     useState<AnnotationType>("HIGHLIGHT");
 51:   const [showAnnotations, setShowAnnotations] = useState(true);
 52:   const [showAnnotationList, setShowAnnotationList] = useState(false);
 53:   const pageRef = useRef<HTMLDivElement>(null);
 54:   const textLayerRef = useRef<HTMLDivElement>(null);
 55:   const { data: annotationsData, isLoading: annotationsLoading } =
 56:     useGetPaperAnnotationsQuery({
 57:       paperId,
 58:       includeReplies: true,
 59:     });
 60:   const [createAnnotation, { isLoading: isCreatingAnnotation }] =
 61:     useCreateAnnotationMutation();
 62:   const annotations = annotationsData?.data || [];
 63:   const currentPageAnnotations = annotations.filter(
 64:     (annotation) => annotation.anchor.page === currentPage
 65:   );
 66:   const onDocumentLoadSuccess = useCallback(
 67:     ({ numPages }: { numPages: number }) => {
 68:       setNumPages(numPages);
 69:     },
 70:     []
 71:   );
 72:   const handleTextSelection = useCallback(() => {
 73:     const selection = window.getSelection();
 74:     if (selection && selection.toString().trim()) {
 75:       const selectedText = selection.toString().trim();
 76:       setSelectedText(selectedText);
 77:       const range = selection.getRangeAt(0);
 78:       const rect = range.getBoundingClientRect();
 79:       const pageRect = pageRef.current?.getBoundingClientRect();
 80:       if (pageRect) {
 81:         const anchor: AnnotationAnchor = {
 82:           page: currentPage,
 83:           coordinates: {
 84:             x: (rect.left - pageRect.left) / scale,
 85:             y: (rect.top - pageRect.top) / scale,
 86:             width: rect.width / scale,
 87:             height: rect.height / scale,
 88:           },
 89:           textRange: {
 90:             start: range.startOffset,
 91:             end: range.endOffset,
 92:           },
 93:           selectedText,
 94:         };
 95:         setSelection(anchor);
 96:         setIsAnnotationPopupOpen(true);
 97:       }
 98:     }
 99:   }, [currentPage, scale]);
100:   const onPageLoadSuccess = useCallback(
101:     (page: any) => {
102:       const textLayer = page.textLayer;
103:       if (textLayer) {
104:         textLayer.textDivs.forEach((textDiv: HTMLElement) => {
105:           textDiv.addEventListener("mouseup", handleTextSelection);
106:         });
107:       }
108:     },
109:     [handleTextSelection]
110:   );
111:   const handleAnnotationCreate = useCallback(
112:     async (text: string) => {
113:       if (selection) {
114:         try {
115:           await createAnnotation({
116:             paperId,
117:             type: annotationType,
118:             anchor: selection,
119:             text: text.trim(),
120:           }).unwrap();
121:           showSuccessToast("Annotation saved successfully");
122:           setIsAnnotationPopupOpen(false);
123:           setSelection(null);
124:           setSelectedText("");
125:         } catch (error: any) {
126:           showErrorToast(error.data?.message || "Failed to save annotation");
127:         }
128:       }
129:     },
130:     [selection, annotationType, paperId, createAnnotation]
131:   );
132:   const handleAnnotationCancel = useCallback(() => {
133:     setIsAnnotationPopupOpen(false);
134:     setSelection(null);
135:     setSelectedText("");
136:   }, []);
137:   const goToPreviousPage = useCallback(() => {
138:     setCurrentPage((prev) => Math.max(1, prev - 1));
139:   }, []);
140:   const goToNextPage = useCallback(() => {
141:     setCurrentPage((prev) => Math.min(numPages, prev + 1));
142:   }, [numPages]);
143:   const zoomIn = useCallback(() => {
144:     setScale((prev) => Math.min(3.0, prev + 0.2));
145:   }, []);
146:   const zoomOut = useCallback(() => {
147:     setScale((prev) => Math.max(0.5, prev - 0.2));
148:   }, []);
149:   const resetZoom = useCallback(() => {
150:     setScale(1.0);
151:     setRotation(0);
152:   }, []);
153:   const rotate = useCallback(() => {
154:     setRotation((prev) => (prev + 90) % 360);
155:   }, []);
156:   return (
157:     <div className={`flex h-full ${className}`}>
158:       {/* Main PDF Viewer */}
159:       <div className="flex-1 flex flex-col">
160:         {}
161:         <div className="flex items-center justify-between p-4 border-b bg-background">
162:           <div className="flex items-center gap-2">
163:             <Button
164:               variant="outline"
165:               size="sm"
166:               onClick={goToPreviousPage}
167:               disabled={currentPage <= 1}
168:             >
169:               <ChevronLeft className="h-4 w-4" />
170:             </Button>
171:             <span className="text-sm font-medium">
172:               {currentPage} of {numPages}
173:             </span>
174:             <Button
175:               variant="outline"
176:               size="sm"
177:               onClick={goToNextPage}
178:               disabled={currentPage >= numPages}
179:             >
180:               <ChevronRight className="h-4 w-4" />
181:             </Button>
182:           </div>
183:           <div className="flex items-center gap-2">
184:             <Button variant="outline" size="sm" onClick={zoomOut}>
185:               <ZoomOut className="h-4 w-4" />
186:             </Button>
187:             <span className="text-sm font-medium">
188:               {Math.round(scale * 100)}%
189:             </span>
190:             <Button variant="outline" size="sm" onClick={zoomIn}>
191:               <ZoomIn className="h-4 w-4" />
192:             </Button>
193:             <Button variant="outline" size="sm" onClick={resetZoom}>
194:               <RotateCcw className="h-4 w-4" />
195:             </Button>
196:             <Button variant="outline" size="sm" onClick={rotate}>
197:               Rotate
198:             </Button>
199:           </div>
200:           <div className="flex items-center gap-2">
201:             <Badge variant="outline">
202:               {currentPageAnnotations.length} annotations
203:             </Badge>
204:             <Button
205:               variant="outline"
206:               size="sm"
207:               onClick={() => setShowAnnotationList(!showAnnotationList)}
208:             >
209:               {showAnnotationList ? "Hide" : "Show"} List
210:             </Button>
211:           </div>
212:         </div>
213:         {}
214:         <div className="flex-1 overflow-auto bg-gray-100 p-4">
215:           <div className="flex justify-center">
216:             <div ref={pageRef} className="relative">
217:               <Document
218:                 file={fileUrl}
219:                 onLoadSuccess={onDocumentLoadSuccess}
220:                 loading={
221:                   <div className="flex items-center justify-center h-96">
222:                     <div className="text-center">
223:                       <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto mb-2"></div>
224:                       <p className="text-sm text-muted-foreground">
225:                         Loading PDF...
226:                       </p>
227:                     </div>
228:                   </div>
229:                 }
230:                 error={
231:                   <div className="flex items-center justify-center h-96">
232:                     <div className="text-center">
233:                       <p className="text-sm text-destructive">
234:                         Failed to load PDF
235:                       </p>
236:                     </div>
237:                   </div>
238:                 }
239:               >
240:                 <Page
241:                   pageNumber={currentPage}
242:                   scale={scale}
243:                   rotate={rotation}
244:                   onLoadSuccess={onPageLoadSuccess}
245:                   className="shadow-lg"
246:                 />
247:               </Document>
248:               {}
249:               {showAnnotations && (
250:                 <AnnotationLayer
251:                   annotations={currentPageAnnotations}
252:                   scale={scale}
253:                   onAnnotationClick={(annotation) => {
254:                     console.log("Annotation clicked:", annotation);
255:                   }}
256:                 />
257:               )}
258:             </div>
259:           </div>
260:         </div>
261:         {}
262:         <AnnotationToolbar
263:           onAnnotationTypeChange={setAnnotationType}
264:           selectedType={annotationType}
265:           onToggleAnnotations={() => setShowAnnotations(!showAnnotations)}
266:           showAnnotations={showAnnotations}
267:         />
268:       </div>
269:       {}
270:       {showAnnotationList && (
271:         <div className="w-80 border-l bg-background">
272:           <AnnotationList
273:             annotations={annotations}
274:             currentPage={currentPage}
275:             onAnnotationClick={(annotation) => {
276:               setCurrentPage(annotation.anchor.page);
277:             }}
278:             onAnnotationEdit={(annotation) => {
279:               console.log("Edit annotation:", annotation);
280:             }}
281:             onAnnotationDelete={(annotation) => {
282:               console.log("Delete annotation:", annotation);
283:             }}
284:           />
285:         </div>
286:       )}
287:       {}
288:       {isAnnotationPopupOpen && selection && (
289:         <AnnotationPopup
290:           selectedText={selectedText}
291:           annotationType={annotationType}
292:           onSave={handleAnnotationCreate}
293:           onCancel={handleAnnotationCancel}
294:         />
295:       )}
296:     </div>
297:   );
298: }
</file>

