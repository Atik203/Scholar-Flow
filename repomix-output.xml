248: function generateCitation(paper: Paper, format: string): string {
249:   const authors = paper.authors.join(", ");
250:   const authorsShort =
251:     paper.authors.length > 3 ? `${paper.authors[0]} et al.` : authors;
252:   switch (format) {
253:     case "BibTeX":
254:       return `@article{${paper.id},
255:   title     = {${paper.title}},
256:   author    = {${paper.authors.join(" and ")}},
257:   journal   = {${paper.journal || "Journal"}},
258:   year      = {${paper.year}},
259:   doi       = {${paper.doi || ""}}
260: }`;
261:     case "APA 7th":
262:       return `${authorsShort} (${paper.year}). ${paper.title}. ${paper.journal || "Journal"}. https://doi.org/${paper.doi || ""}`;
263:     case "MLA 9th":
264:       return `${authorsShort}. "${paper.title}." ${paper.journal || "Journal"}, ${paper.year}.`;
265:     case "IEEE":
266:       return `${authorsShort}, "${paper.title}," ${paper.journal || "Journal"}, ${paper.year}.`;
267:     case "Chicago":
268:       return `${authorsShort}. "${paper.title}." ${paper.journal || "Journal"} (${paper.year}).`;
269:     case "Harvard":
270:       return `${authorsShort} (${paper.year}) '${paper.title}', ${paper.journal || "Journal"}.`;
271:     default:
272:       return paper.title;
273:   }
274: }
