 1: import { combineReducers, configureStore } from "@reduxjs/toolkit";
 2: import {
 3:   FLUSH,
 4:   PAUSE,
 5:   PERSIST,
 6:   persistReducer,
 7:   persistStore,
 8:   PURGE,
 9:   REGISTER,
10:   REHYDRATE,
11: } from "redux-persist";
12: import { apiSlice } from "./api/apiSlice";
13: import authReducer from "./auth/authSlice";
14: const createNoopStorage = () => {
15:   return {
16:     getItem(_key: string) {
17:       return Promise.resolve(null);
18:     },
19:     setItem(_key: string, value: any) {
20:       return Promise.resolve(value);
21:     },
22:     removeItem(_key: string) {
23:       return Promise.resolve();
24:     },
25:   };
26: };
27: const createLocalStorage = () => {
28:   return {
29:     getItem(key: string) {
30:       return Promise.resolve(window.localStorage.getItem(key));
31:     },
32:     setItem(key: string, value: string) {
33:       return Promise.resolve(window.localStorage.setItem(key, value));
34:     },
35:     removeItem(key: string) {
36:       return Promise.resolve(window.localStorage.removeItem(key));
37:     },
38:   };
39: };
40: const storage =
41:   typeof window !== "undefined" ? createLocalStorage() : createNoopStorage();
42: const authPersistConfig = {
43:   key: "scholarflow-auth",
44:   storage,
45:   whitelist: ["user", "accessToken", "sessionToken", "isAuthenticated"],
46: };
47: const persistedAuthReducer = persistReducer(authPersistConfig, authReducer);
48: const rootReducer = combineReducers({
49:   auth: persistedAuthReducer,
50:   [apiSlice.reducerPath]: apiSlice.reducer,
51: });
52: export const makeStore = () => {
53:   return configureStore({
54:     reducer: rootReducer,
55:     middleware: (getDefaultMiddleware) =>
56:       getDefaultMiddleware({
57:         serializableCheck: {
58:           ignoredActions: [
59:             FLUSH,
60:             REHYDRATE,
61:             PAUSE,
62:             PERSIST,
63:             PURGE,
64:             REGISTER,
65:             "api/executeQuery/pending",
66:             "api/executeQuery/fulfilled",
67:             "api/executeQuery/rejected",
68:             "api/executeMutation/pending",
69:             "api/executeMutation/fulfilled",
70:             "api/executeMutation/rejected",
71:           ],
72:           ignoredActionsPaths: ["meta.arg", "payload.timestamp"],
73:           ignoredPaths: [
74:             "api.queries",
75:             "api.mutations",
76:             "api.provided",
77:             "api.subscriptions",
78:             "api.config",
79:           ],
80:         },
81:       }).concat(apiSlice.middleware),
82:     devTools: process.env.NODE_ENV !== "production",
83:   });
84: };
85: export type AppStore = ReturnType<typeof makeStore>;
86: export type RootState = ReturnType<AppStore["getState"]>;
87: export type AppDispatch = AppStore["dispatch"];
88: export const createPersistor = (store: AppStore) => persistStore(store);
</file>

