  1: "use client"
  2: import * as React from "react"
  3: import { type Editor } from "@tiptap/react"
  4: import { useHotkeys } from "react-hotkeys-hook"
  5: import { useTiptapEditor } from "@/hooks/use-tiptap-editor"
  6: import { useIsMobile } from "@/hooks/use-mobile"
  7: import { isMarkInSchema, isNodeTypeSelected } from "@/lib/tiptap-utils"
  8: import { HighlighterIcon } from "@/components/tiptap-icons/highlighter-icon"
  9: export const COLOR_HIGHLIGHT_SHORTCUT_KEY = "mod+shift+h"
 10: export const HIGHLIGHT_COLORS = [
 11:   {
 12:     label: "Default background",
 13:     value: "var(--tt-bg-color)",
 14:     border: "var(--tt-bg-color-contrast)",
 15:   },
 16:   {
 17:     label: "Gray background",
 18:     value: "var(--tt-color-highlight-gray)",
 19:     border: "var(--tt-color-highlight-gray-contrast)",
 20:   },
 21:   {
 22:     label: "Brown background",
 23:     value: "var(--tt-color-highlight-brown)",
 24:     border: "var(--tt-color-highlight-brown-contrast)",
 25:   },
 26:   {
 27:     label: "Orange background",
 28:     value: "var(--tt-color-highlight-orange)",
 29:     border: "var(--tt-color-highlight-orange-contrast)",
 30:   },
 31:   {
 32:     label: "Yellow background",
 33:     value: "var(--tt-color-highlight-yellow)",
 34:     border: "var(--tt-color-highlight-yellow-contrast)",
 35:   },
 36:   {
 37:     label: "Green background",
 38:     value: "var(--tt-color-highlight-green)",
 39:     border: "var(--tt-color-highlight-green-contrast)",
 40:   },
 41:   {
 42:     label: "Blue background",
 43:     value: "var(--tt-color-highlight-blue)",
 44:     border: "var(--tt-color-highlight-blue-contrast)",
 45:   },
 46:   {
 47:     label: "Purple background",
 48:     value: "var(--tt-color-highlight-purple)",
 49:     border: "var(--tt-color-highlight-purple-contrast)",
 50:   },
 51:   {
 52:     label: "Pink background",
 53:     value: "var(--tt-color-highlight-pink)",
 54:     border: "var(--tt-color-highlight-pink-contrast)",
 55:   },
 56:   {
 57:     label: "Red background",
 58:     value: "var(--tt-color-highlight-red)",
 59:     border: "var(--tt-color-highlight-red-contrast)",
 60:   },
 61: ]
 62: export type HighlightColor = (typeof HIGHLIGHT_COLORS)[number]
 63: export interface UseColorHighlightConfig {
 64:   editor?: Editor | null
 65:   highlightColor?: string
 66:   label?: string
 67:   hideWhenUnavailable?: boolean
 68:   onApplied?: ({ color, label }: { color: string; label: string }) => void
 69: }
 70: export function pickHighlightColorsByValue(values: string[]) {
 71:   const colorMap = new Map(
 72:     HIGHLIGHT_COLORS.map((color) => [color.value, color])
 73:   )
 74:   return values
 75:     .map((value) => colorMap.get(value))
 76:     .filter((color): color is (typeof HIGHLIGHT_COLORS)[number] => !!color)
 77: }
 78: export function canColorHighlight(editor: Editor | null): boolean {
 79:   if (!editor || !editor.isEditable) return false
 80:   if (
 81:     !isMarkInSchema("highlight", editor) ||
 82:     isNodeTypeSelected(editor, ["image"])
 83:   )
 84:     return false
 85:   return editor.can().setMark("highlight")
 86: }
 87: export function isColorHighlightActive(
 88:   editor: Editor | null,
 89:   highlightColor?: string
 90: ): boolean {
 91:   if (!editor || !editor.isEditable) return false
 92:   return highlightColor
 93:     ? editor.isActive("highlight", { color: highlightColor })
 94:     : editor.isActive("highlight")
 95: }
 96: export function removeHighlight(editor: Editor | null): boolean {
 97:   if (!editor || !editor.isEditable) return false
 98:   if (!canColorHighlight(editor)) return false
 99:   return editor.chain().focus().unsetMark("highlight").run()
100: }
101: export function shouldShowButton(props: {
102:   editor: Editor | null
103:   hideWhenUnavailable: boolean
104: }): boolean {
105:   const { editor, hideWhenUnavailable } = props
106:   if (!editor || !editor.isEditable) return false
107:   if (!isMarkInSchema("highlight", editor)) return false
108:   if (hideWhenUnavailable && !editor.isActive("code")) {
109:     return canColorHighlight(editor)
110:   }
111:   return true
112: }
113: export function useColorHighlight(config: UseColorHighlightConfig) {
114:   const {
115:     editor: providedEditor,
116:     label,
117:     highlightColor,
118:     hideWhenUnavailable = false,
119:     onApplied,
120:   } = config
121:   const { editor } = useTiptapEditor(providedEditor)
122:   const isMobile = useIsMobile()
123:   const [isVisible, setIsVisible] = React.useState<boolean>(true)
124:   const canColorHighlightState = canColorHighlight(editor)
125:   const isActive = isColorHighlightActive(editor, highlightColor)
126:   React.useEffect(() => {
127:     if (!editor) return
128:     const handleSelectionUpdate = () => {
129:       setIsVisible(shouldShowButton({ editor, hideWhenUnavailable }))
130:     }
131:     handleSelectionUpdate()
132:     editor.on("selectionUpdate", handleSelectionUpdate)
133:     return () => {
134:       editor.off("selectionUpdate", handleSelectionUpdate)
135:     }
136:   }, [editor, hideWhenUnavailable])
137:   const handleColorHighlight = React.useCallback(() => {
138:     if (!editor || !canColorHighlightState || !highlightColor || !label)
139:       return false
140:     if (editor.state.storedMarks) {
141:       const highlightMarkType = editor.schema.marks.highlight
142:       if (highlightMarkType) {
143:         editor.view.dispatch(
144:           editor.state.tr.removeStoredMark(highlightMarkType)
145:         )
146:       }
147:     }
148:     setTimeout(() => {
149:       const success = editor
150:         .chain()
151:         .focus()
152:         .toggleMark("highlight", { color: highlightColor })
153:         .run()
154:       if (success) {
155:         onApplied?.({ color: highlightColor, label })
156:       }
157:       return success
158:     }, 0)
159:   }, [canColorHighlightState, highlightColor, editor, label, onApplied])
160:   const handleRemoveHighlight = React.useCallback(() => {
161:     const success = removeHighlight(editor)
162:     if (success) {
163:       onApplied?.({ color: "", label: "Remove highlight" })
164:     }
165:     return success
166:   }, [editor, onApplied])
167:   useHotkeys(
168:     COLOR_HIGHLIGHT_SHORTCUT_KEY,
169:     (event) => {
170:       event.preventDefault()
171:       handleColorHighlight()
172:     },
173:     {
174:       enabled: isVisible && canColorHighlightState,
175:       enableOnContentEditable: !isMobile,
176:       enableOnFormTags: true,
177:     }
178:   )
179:   return {
180:     isVisible,
181:     isActive,
182:     handleColorHighlight,
183:     handleRemoveHighlight,
184:     canColorHighlight: canColorHighlightState,
185:     label: label || `Highlight`,
186:     shortcutKeys: COLOR_HIGHLIGHT_SHORTCUT_KEY,
187:     Icon: HighlighterIcon,
188:   }
189: }
</file>

