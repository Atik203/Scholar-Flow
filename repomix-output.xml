 15: export const SearchController = {
 16:   globalSearch: catchAsync(async (req: Request, res: Response) => {
 17:     const authReq = req as AuthenticatedRequest;
 18:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
 19:     const q = globalSearchQuerySchema.parse(req.query);
 20:     const page = parseInt(q.page || "1", 10);
 21:     const limit = Math.min(50, parseInt(q.limit || "10", 10));
 22:     const skip = (page - 1) * limit;
 23:     const result = await SearchService.globalSearch(
 24:       authReq.user.id,
 25:       q.q,
 26:       q.type as any,
 27:       limit,
 28:       skip,
 29:       q.workspaceId,
 30:       authReq.user.role
 31:     );
 32:     if (page === 1) {
 33:       SearchService.saveSearchQuery(authReq.user.id, q.q, { type: q.type, workspaceId: q.workspaceId }, result.meta).catch(console.error);
 34:     }
 35:     res.status(200).json({
 36:       success: true,
 37:       statusCode: 200,
 38:       message: "Search results retrieved successfully",
 39:       meta: { ...result.meta, page },
 40:       data: result.results
 41:     });
 42:   }),
 43:   saveSearchQuery: catchAsync(async (req: Request, res: Response) => {
 44:     const authReq = req as AuthenticatedRequest;
 45:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
 46:     const body = saveSearchHistorySchema.parse(req.body);
 47:     const result = await SearchService.saveSearchQuery(
 48:       authReq.user.id,
 49:       body.query,
 50:       body.filters,
 51:       body.results
 52:     );
 53:     sendSuccessResponse(res, result, "Search query saved");
 54:   }),
 55:   getSearchHistory: catchAsync(async (req: Request, res: Response) => {
 56:     const authReq = req as AuthenticatedRequest;
 57:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
 58:     const q = searchHistoryQuerySchema.parse(req.query);
 59:     const page = parseInt(q.page || "1", 10);
 60:     const limit = Math.min(50, parseInt(q.limit || "10", 10));
 61:     const skip = (page - 1) * limit;
 62:     const result = await SearchService.getSearchHistory(
 63:       authReq.user.id,
 64:       limit,
 65:       skip
 66:     );
 67:     sendPaginatedResponse(
 68:       res,
 69:       result.result,
 70:       { ...result.meta, page, limit, totalPage: Math.ceil(result.meta.total / limit) },
 71:       "Search history retrieved successfully"
 72:     );
 73:   }),
 74:   getTrending: catchAsync(async (req: Request, res: Response) => {
 75:     const authReq = req as AuthenticatedRequest;
 76:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
 77:     const limit = Math.min(20, parseInt((req.query.limit as string) || "10", 10));
 78:     const result = await SearchService.getTrendingPapers(authReq.user.id, limit);
 79:     sendSuccessResponse(res, result, "Trending retrieved successfully");
 80:   }),
 81:   getRecommendations: catchAsync(async (req: Request, res: Response) => {
 82:     const authReq = req as AuthenticatedRequest;
 83:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
 84:     const limit = Math.min(20, parseInt((req.query.limit as string) || "10", 10));
 85:     const result = await SearchService.getRecommendations(authReq.user.id, limit);
 86:     sendSuccessResponse(res, result, "Recommendations retrieved successfully");
 87:   }),
 88:   semanticSearch: catchAsync(async (req: Request, res: Response) => {
 89:     const authReq = req as AuthenticatedRequest;
 90:     if (!authReq.user?.id) throw new ApiError(401, "Authentication required");
 91:     const q = (req.query.q as string) || "";
 92:     const limit = Math.min(20, parseInt((req.query.limit as string) || "10", 10));
 93:     const workspaceId = req.query.workspaceId as string | undefined;
 94:     if (!q.trim()) {
