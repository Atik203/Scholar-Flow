498:             WHERE pc."paperId" = p.id
499:           ) as "chunkCount"
500:         FROM "Paper" p
501:         WHERE p."uploaderId" = ${userId} AND p."isDeleted" = false
502:         ORDER BY p."createdAt" DESC
503:         LIMIT ${limit} OFFSET ${skip}
504:       `;
505:       totalResult = await prisma.$queryRaw<any[]>`
506:         SELECT COUNT(*) as count
507:         FROM "Paper" p
508:         WHERE p."uploaderId" = ${userId} AND p."isDeleted" = false
509:       `;
510:     }
511:     const total = Number(totalResult[0]?.count || 0);
512:     const totalPage = Math.ceil(total / limit);
513:     // Add chunks data to each paper
514:     const papersWithChunks = papers.map((paper) => ({
515:       ...paper,
516:       chunks: Array.from({ length: Number(paper.chunkCount) }, (_, i) => ({
517:         id: `chunk_${i}`,
518:       })),
519:     }));
520:     const response = {
521:       result: papersWithChunks,
522:       meta: {
523:         page,
524:         limit,
525:         total,
526:         totalPage,
527:       },
528:     };
529:     // Cache the result for 5 minutes if no search
530:     if (!params.search) {
531:       await cacheService.set(cacheKey, response, CacheTTL.MEDIUM);
532:     }
533:     return response;
534:   }
535:   /**
536:    * Get papers with date range filtering using $queryRaw for optimized date queries
537:    * Source: optimized date range filtering with uploader information
538:    */
539:   static async getByDateRange(
540:     startDate?: string,
541:     endDate?: string,
542:     options: IPaginationOptions = {}
543:   ) {
544:     const limit = options.limit || 10;
545:     const page = options.page || 1;
546:     const skip = (page - 1) * limit;
547:     let papers: any[];
548:     let totalResult: any[];
549:     // Build date conditions
550:     if (startDate && endDate) {
551:       papers = await prisma.$queryRaw<any[]>`
552:         SELECT
553:           p.*,
554:           u.id as "uploaderId", u.email as "uploaderEmail"
555:         FROM "Paper" p
556:         LEFT JOIN "User" u ON p."uploaderId" = u.id
557:         WHERE p."isDeleted" = false
558:           AND p."createdAt" >= ${new Date(startDate)}
559:           AND p."createdAt" <= ${new Date(endDate)}
560:         ORDER BY p."createdAt" DESC
561:         LIMIT ${limit} OFFSET ${skip}
562:       `;
563:       totalResult = await prisma.$queryRaw<any[]>`
564:         SELECT COUNT(*) as count
565:         FROM "Paper" p
566:         WHERE p."isDeleted" = false
567:           AND p."createdAt" >= ${new Date(startDate)}
568:           AND p."createdAt" <= ${new Date(endDate)}
569:       `;
570:     } else if (startDate) {
571:       papers = await prisma.$queryRaw<any[]>`
572:         SELECT
573:           p.*,
574:           u.id as "uploaderId", u.email as "uploaderEmail"
575:         FROM "Paper" p
576:         LEFT JOIN "User" u ON p."uploaderId" = u.id
577:         WHERE p."isDeleted" = false
578:           AND p."createdAt" >= ${new Date(startDate)}
579:         ORDER BY p."createdAt" DESC
580:         LIMIT ${limit} OFFSET ${skip}
581:       `;
582:       totalResult = await prisma.$queryRaw<any[]>`
583:         SELECT COUNT(*) as count
584:         FROM "Paper" p
585:         WHERE p."isDeleted" = false
586:           AND p."createdAt" >= ${new Date(startDate)}
587:       `;
588:     } else if (endDate) {
589:       papers = await prisma.$queryRaw<any[]>`
590:         SELECT
591:           p.*,
592:           u.id as "uploaderId", u.email as "uploaderEmail"
593:         FROM "Paper" p
594:         LEFT JOIN "User" u ON p."uploaderId" = u.id
595:         WHERE p."isDeleted" = false
596:           AND p."createdAt" <= ${new Date(endDate)}
597:         ORDER BY p."createdAt" DESC
598:         LIMIT ${limit} OFFSET ${skip}
599:       `;
600:       totalResult = await prisma.$queryRaw<any[]>`
601:         SELECT COUNT(*) as count
602:         FROM "Paper" p
603:         WHERE p."isDeleted" = false
604:           AND p."createdAt" <= ${new Date(endDate)}
605:       `;
606:     } else {
607:       // No date filtering
608:       papers = await prisma.$queryRaw<any[]>`
609:         SELECT
610:           p.*,
611:           u.id as "uploaderId", u.email as "uploaderEmail"
612:         FROM "Paper" p
613:         LEFT JOIN "User" u ON p."uploaderId" = u.id
614:         WHERE p."isDeleted" = false
615:         ORDER BY p."createdAt" DESC
616:         LIMIT ${limit} OFFSET ${skip}
617:       `;
618:       totalResult = await prisma.$queryRaw<any[]>`
619:         SELECT COUNT(*) as count
