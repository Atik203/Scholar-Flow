  1: import { mergeAttributes, Node } from "@tiptap/react"
  2: import { ReactNodeViewRenderer } from "@tiptap/react"
  3: import { ImageUploadNode as ImageUploadNodeComponent } from "@/components/tiptap-node/image-upload-node/image-upload-node"
  4: import type { NodeType } from "@tiptap/pm/model"
  5: export type UploadFunction = (
  6:   file: File,
  7:   onProgress?: (event: { progress: number }) => void,
  8:   abortSignal?: AbortSignal
  9: ) => Promise<string>
 10: export interface ImageUploadNodeOptions {
 11:   type?: string | NodeType | undefined
 12:   accept?: string
 13:   limit?: number
 14:   maxSize?: number
 15:   upload?: UploadFunction
 16:   onError?: (error: Error) => void
 17:   onSuccess?: (url: string) => void
 18:   HTMLAttributes: Record<string, any>
 19: }
 20: declare module "@tiptap/react" {
 21:   interface Commands<ReturnType> {
 22:     imageUpload: {
 23:       setImageUploadNode: (options?: ImageUploadNodeOptions) => ReturnType
 24:     }
 25:   }
 26: }
 27: export const ImageUploadNode = Node.create<ImageUploadNodeOptions>({
 28:   name: "imageUpload",
 29:   group: "block",
 30:   draggable: true,
 31:   atom: true,
 32:   addOptions() {
 33:     return {
 34:       type: "image",
 35:       accept: "image/*",
 36:       limit: 1,
 37:       maxSize: 0,
 38:       upload: undefined,
 39:       onError: undefined,
 40:       onSuccess: undefined,
 41:       HTMLAttributes: {},
 42:     }
 43:   },
 44:   addAttributes() {
 45:     return {
 46:       accept: {
 47:         default: this.options.accept,
 48:       },
 49:       limit: {
 50:         default: this.options.limit,
 51:       },
 52:       maxSize: {
 53:         default: this.options.maxSize,
 54:       },
 55:     }
 56:   },
 57:   parseHTML() {
 58:     return [{ tag: 'div[data-type="image-upload"]' }]
 59:   },
 60:   renderHTML({ HTMLAttributes }) {
 61:     return [
 62:       "div",
 63:       mergeAttributes({ "data-type": "image-upload" }, HTMLAttributes),
 64:     ]
 65:   },
 66:   addNodeView() {
 67:     return ReactNodeViewRenderer(ImageUploadNodeComponent)
 68:   },
 69:   addCommands() {
 70:     return {
 71:       setImageUploadNode:
 72:         (options) =>
 73:         ({ commands }) => {
 74:           return commands.insertContent({
 75:             type: this.name,
 76:             attrs: options,
 77:           })
 78:         },
 79:     }
 80:   },
 81:   addKeyboardShortcuts() {
 82:     return {
 83:       Enter: ({ editor }) => {
 84:         const { selection } = editor.state
 85:         const { nodeAfter } = selection.$from
 86:         if (
 87:           nodeAfter &&
 88:           nodeAfter.type.name === "imageUpload" &&
 89:           editor.isActive("imageUpload")
 90:         ) {
 91:           const nodeEl = editor.view.nodeDOM(selection.$from.pos)
 92:           if (nodeEl && nodeEl instanceof HTMLElement) {
 93:             const firstChild = nodeEl.firstChild
 94:             if (firstChild && firstChild instanceof HTMLElement) {
 95:               firstChild.click()
 96:               return true
 97:             }
 98:           }
 99:         }
100:         return false
101:       },
102:     }
103:   },
104: })
105: export default ImageUploadNode
</file>

