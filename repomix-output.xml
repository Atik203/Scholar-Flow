 82:     googleAuthUrl.searchParams.append("redirect_uri", redirectUri);
 83:     googleAuthUrl.searchParams.append("response_type", "code");
 84:     googleAuthUrl.searchParams.append("scope", "openid email profile");
 85:     googleAuthUrl.searchParams.append("state", state);
 86:     googleAuthUrl.searchParams.append("access_type", "offline");
 87:     googleAuthUrl.searchParams.append("prompt", "consent");
