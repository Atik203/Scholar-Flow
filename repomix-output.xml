<file path="apps/backend/src/app/middleware/requireRole.ts">
 1: import { NextFunction, Request, Response } from "express";
 2: import ApiError from "../errors/ApiError";
 3: import { AuthRequest } from "./auth";
 4: import { ROLE_HIERARCHY, USER_ROLES } from "../modules/Auth/auth.constant";
 5: export const requireRole = (requiredRole: keyof typeof USER_ROLES) => {
 6:   return (req: Request, res: Response, next: NextFunction): void => {
 7:     const authReq = req as AuthRequest;
 8:     const userRole = authReq.user?.role;
 9:     if (!userRole) {
10:       return next(new ApiError(401, "Authentication required"));
11:     }
12:     const userLevel = ROLE_HIERARCHY[userRole as keyof typeof ROLE_HIERARCHY] || 0;
13:     const requiredLevel = ROLE_HIERARCHY[requiredRole] || 0;
14:     if (userLevel < requiredLevel) {
15:       return next(
16:         new ApiError(
17:           403,
18:           `Insufficient permissions. Required: ${requiredRole}, got: ${userRole}`
19:         )
20:       );
21:     }
22:     next();
23:   };
24: };
25: export const requireTeamLead = requireRole("TEAM_LEAD");
26: export const requireAdmin = requireRole("ADMIN");
</file>

<file path="apps/backend/src/app/middleware/validateRequest.ts">
 1: import { NextFunction, Request, Response } from "express";
 2: import { AnyZodObject, ZodError } from "zod";
 3: import ApiError from "../errors/ApiError";
 4: export const validateRequest = (schema: AnyZodObject) => {
 5:   return async (req: Request, res: Response, next: NextFunction) => {
 6:     try {
 7:       await schema.parseAsync({
 8:         body: req.body,
 9:         query: req.query,
10:         params: req.params,
11:         cookies: req.cookies,
12:       });
13:       next();
14:     } catch (error) {
15:       if (error instanceof ZodError) {
16:         const validationErrors = error.issues
17:           .map((issue) => `${issue.path.join(".")}: ${issue.message}`)
18:           .join(", ");
19:         return next(
20:           new ApiError(400, `Validation failed: ${validationErrors}`)
21:         );
22:       }
23:       next(error);
24:     }
25:   };
26: };
27: export const validateRequestBody = (schema: AnyZodObject) => {
28:   return async (req: Request, res: Response, next: NextFunction) => {
29:     try {
30:       const validatedData = await schema.parseAsync(req.body);
31:       req.body = validatedData;
32:       next();
33:     } catch (error) {
34:       if (error instanceof ZodError) {
35:         const validationErrors = error.issues
36:           .map((issue) => `${issue.path.join(".")}: ${issue.message}`)
37:           .join(", ");
38:         return next(
39:           new ApiError(
40:             400,
41:             `Request body validation failed: ${validationErrors}`
42:           )
43:         );
44:       }
45:       next(error);
46:     }
47:   };
48: };
