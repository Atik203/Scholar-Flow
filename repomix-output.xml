 6: type TeamRole = "ADMIN" | "TEAM_LEAD" | "PRO_RESEARCHER" | "RESEARCHER" | "VIEWER" | "EDITOR" | "MANAGER" | "OWNER";
 7: const ROLE_LABELS: Record<TeamRole, string> = {
