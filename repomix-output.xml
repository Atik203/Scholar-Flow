1497:         pf."sizeBytes" AS "file_sizeBytes",
1498:         pf."originalFilename" AS "file_originalFilename",
1499:         pf."extractedAt" AS "file_extractedAt"
1500:       FROM inserted i
1501:       JOIN "Paper" p ON p.id = i."paperId"
1502:       LEFT JOIN "PaperFile" pf ON pf."paperId" = p.id AND pf."isDeleted" = false
1503:     `;
1504:     const inserted = insertedRows[0];
