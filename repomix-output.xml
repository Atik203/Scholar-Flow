619:   private static formatAuthorsAPA(authors: string[]): string {
620:     if (authors.length === 1) return authors[0];
621:     if (authors.length === 2) return `${authors[0]} & ${authors[1]}`;
622:     if (authors.length <= 7)
623:       return `${authors.slice(0, -1).join(", ")}, & ${authors[authors.length - 1]}`;
624:     return `${authors.slice(0, 6).join(", ")}, ... ${authors[authors.length - 1]}`;
625:   }
