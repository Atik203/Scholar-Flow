  1: "use client"
  2: import * as React from "react"
  3: import { type Editor } from "@tiptap/react"
  4: import { NodeSelection, TextSelection } from "@tiptap/pm/state"
  5: import { useTiptapEditor } from "@/hooks/use-tiptap-editor"
  6: import { ListIcon } from "@/components/tiptap-icons/list-icon"
  7: import { ListOrderedIcon } from "@/components/tiptap-icons/list-ordered-icon"
  8: import { ListTodoIcon } from "@/components/tiptap-icons/list-todo-icon"
  9: import {
 10:   findNodePosition,
 11:   isNodeInSchema,
 12:   isNodeTypeSelected,
 13:   isValidPosition,
 14: } from "@/lib/tiptap-utils"
 15: export type ListType = "bulletList" | "orderedList" | "taskList"
 16: export interface UseListConfig {
 17:   editor?: Editor | null
 18:   type: ListType
 19:   hideWhenUnavailable?: boolean
 20:   onToggled?: () => void
 21: }
 22: export const listIcons = {
 23:   bulletList: ListIcon,
 24:   orderedList: ListOrderedIcon,
 25:   taskList: ListTodoIcon,
 26: }
 27: export const listLabels: Record<ListType, string> = {
 28:   bulletList: "Bullet List",
 29:   orderedList: "Ordered List",
 30:   taskList: "Task List",
 31: }
 32: export const LIST_SHORTCUT_KEYS: Record<ListType, string> = {
 33:   bulletList: "mod+shift+8",
 34:   orderedList: "mod+shift+7",
 35:   taskList: "mod+shift+9",
 36: }
 37: export function canToggleList(
 38:   editor: Editor | null,
 39:   type: ListType,
 40:   turnInto: boolean = true
 41: ): boolean {
 42:   if (!editor || !editor.isEditable) return false
 43:   if (!isNodeInSchema(type, editor) || isNodeTypeSelected(editor, ["image"]))
 44:     return false
 45:   if (!turnInto) {
 46:     switch (type) {
 47:       case "bulletList":
 48:         return editor.can().toggleBulletList()
 49:       case "orderedList":
 50:         return editor.can().toggleOrderedList()
 51:       case "taskList":
 52:         return editor.can().toggleList("taskList", "taskItem")
 53:       default:
 54:         return false
 55:     }
 56:   }
 57:   try {
 58:     const view = editor.view
 59:     const state = view.state
 60:     const selection = state.selection
 61:     if (selection.empty || selection instanceof TextSelection) {
 62:       const pos = findNodePosition({
 63:         editor,
 64:         node: state.selection.$anchor.node(1),
 65:       })?.pos
 66:       if (!isValidPosition(pos)) return false
 67:     }
 68:     return true
 69:   } catch {
 70:     return false
 71:   }
 72: }
 73: export function isListActive(editor: Editor | null, type: ListType): boolean {
 74:   if (!editor || !editor.isEditable) return false
 75:   switch (type) {
 76:     case "bulletList":
 77:       return editor.isActive("bulletList")
 78:     case "orderedList":
 79:       return editor.isActive("orderedList")
 80:     case "taskList":
 81:       return editor.isActive("taskList")
 82:     default:
 83:       return false
 84:   }
 85: }
 86: export function toggleList(editor: Editor | null, type: ListType): boolean {
 87:   if (!editor || !editor.isEditable) return false
 88:   if (!canToggleList(editor, type)) return false
 89:   try {
 90:     const view = editor.view
 91:     let state = view.state
 92:     let tr = state.tr
 93:     if (state.selection.empty || state.selection instanceof TextSelection) {
 94:       const pos = findNodePosition({
 95:         editor,
 96:         node: state.selection.$anchor.node(1),
 97:       })?.pos
 98:       if (!isValidPosition(pos)) return false
 99:       tr = tr.setSelection(NodeSelection.create(state.doc, pos))
100:       view.dispatch(tr)
101:       state = view.state
102:     }
103:     const selection = state.selection
104:     let chain = editor.chain().focus()
105:     if (selection instanceof NodeSelection) {
106:       const firstChild = selection.node.firstChild?.firstChild
107:       const lastChild = selection.node.lastChild?.lastChild
108:       const from = firstChild
109:         ? selection.from + firstChild.nodeSize
110:         : selection.from + 1
111:       const to = lastChild
112:         ? selection.to - lastChild.nodeSize
113:         : selection.to - 1
114:       chain = chain.setTextSelection({ from, to }).clearNodes()
115:     }
116:     if (editor.isActive(type)) {
117:       chain
118:         .liftListItem("listItem")
119:         .lift("bulletList")
120:         .lift("orderedList")
121:         .lift("taskList")
122:         .run()
123:     } else {
124:       const toggleMap: Record<ListType, () => typeof chain> = {
125:         bulletList: () => chain.toggleBulletList(),
126:         orderedList: () => chain.toggleOrderedList(),
127:         taskList: () => chain.toggleList("taskList", "taskItem"),
128:       }
129:       const toggle = toggleMap[type]
130:       if (!toggle) return false
131:       toggle().run()
132:     }
133:     editor.chain().focus().selectTextblockEnd().run()
134:     return true
135:   } catch {
136:     return false
137:   }
138: }
139: export function shouldShowButton(props: {
140:   editor: Editor | null
141:   type: ListType
142:   hideWhenUnavailable: boolean
143: }): boolean {
144:   const { editor, type, hideWhenUnavailable } = props
145:   if (!editor || !editor.isEditable) return false
146:   if (!isNodeInSchema(type, editor)) return false
147:   if (hideWhenUnavailable && !editor.isActive("code")) {
148:     return canToggleList(editor, type)
149:   }
150:   return true
151: }
152: export function useList(config: UseListConfig) {
153:   const {
154:     editor: providedEditor,
155:     type,
156:     hideWhenUnavailable = false,
157:     onToggled,
158:   } = config
159:   const { editor } = useTiptapEditor(providedEditor)
160:   const [isVisible, setIsVisible] = React.useState<boolean>(true)
161:   const canToggle = canToggleList(editor, type)
162:   const isActive = isListActive(editor, type)
163:   React.useEffect(() => {
164:     if (!editor) return
165:     const handleSelectionUpdate = () => {
166:       setIsVisible(shouldShowButton({ editor, type, hideWhenUnavailable }))
167:     }
168:     handleSelectionUpdate()
169:     editor.on("selectionUpdate", handleSelectionUpdate)
170:     return () => {
171:       editor.off("selectionUpdate", handleSelectionUpdate)
172:     }
173:   }, [editor, type, hideWhenUnavailable])
174:   const handleToggle = React.useCallback(() => {
175:     if (!editor) return false
176:     const success = toggleList(editor, type)
177:     if (success) {
178:       onToggled?.()
179:     }
180:     return success
181:   }, [editor, type, onToggled])
182:   return {
183:     isVisible,
184:     isActive,
185:     handleToggle,
186:     canToggle,
187:     label: listLabels[type],
188:     shortcutKeys: LIST_SHORTCUT_KEYS[type],
189:     Icon: listIcons[type],
190:   }
191: }
</file>

