166:   protected async performExtraction(
167:     input: AiMetadataExtractionInput
168:   ): Promise<AiMetadataExtractionResult> {
169:     if (!this.apiKey) {
170:       throw new AiError(
171:         503,
172:         "Gemini provider not configured",
173:         "AI_PROVIDER_DISABLED"
174:       );
175:     }
176:     const model = DEFAULT_MODEL;
177:     const systemPrompt = `You are an academic metadata extraction expert. Extract the following fields from the provided paper text. Respond ONLY with a valid JSON object matching this TypeScript type: { "title"?: string; "abstract"?: string; "authors"?: string[]; "year"?: number; "doi"?: string; "keywords"?: string[]; "confidence"?: number }. If a field cannot be determined, omit it. Use the original title if supplied and no better title is found.`;
178:     let promptText = `Extract metadata from this paper text:\n\n${input.text.slice(0, 16000)}`;
179:     if (input.originalTitle?.trim()) {
180:       promptText += `\n\n(Original filename/title: ${input.originalTitle})`;
181:     }
182:     const controller = new AbortController();
183:     const timeout = setTimeout(() => controller.abort(), this.requestTimeoutMs);
184:     try {
185:       let response: Awaited<ReturnType<typeof fetch>>;
186:       try {
187:         response = await fetch(
188:           `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${this.apiKey}`,
189:           {
190:             method: "POST",
191:             headers: { "Content-Type": "application/json" },
192:             body: JSON.stringify({
193:               contents: [
194:                 {
195:                   role: "user",
196:                   parts: [
197:                     {
198:                       text: [systemPrompt, promptText]
199:                         .filter(Boolean)
200:                         .join("\n\n"),
201:                     },
202:                   ],
203:                 },
204:               ],
205:               generationConfig: {
206:                 temperature: 0.2,
207:                 maxOutputTokens: 800,
208:                 topP: 0.9,
209:                 topK: 40,
210:                 responseMimeType: "application/json",
211:               },
212:             }),
213:             signal: controller.signal,
214:           }
215:         );
216:       } finally {
217:         clearTimeout(timeout);
218:       }
219:       if (!response.ok) {
220:         const errorText = await response.text();
221:         throw new Error(
222:           `Gemini API error: ${response.status} - ${errorText}`
223:         );
224:       }
225:       const data = (await response.json()) as {
226:         candidates?: Array<{
227:           content?: { parts?: Array<{ text?: string }> };
228:         }>;
229:       };
230:       const parts = Array.isArray(data.candidates?.[0]?.content?.parts)
