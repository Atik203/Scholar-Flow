      },
      {
        title: "User Management",
        description: "Manage platform users",
        icon: Users,
        href: "/admin/users",
        color: "bg-blue-500 hover:bg-blue-600",
      },
      {
        title: "System Settings",
        description: "Configure platform",
        icon: Zap,
