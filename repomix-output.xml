1393:         paper_metadata: unknown;
1394:         paper_source: string | null;
1395:         paper_doi: string | null;
1396:         paper_processingStatus: string;
1397:         paper_createdAt: Date;
1398:         paper_updatedAt: Date;
1399:         file_id: string | null;
1400:         file_storageProvider: string | null;
