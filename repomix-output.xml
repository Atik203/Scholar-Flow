432:         console.log(
433:           `[DocumentExtraction] DOCX conversion warnings:`,
434:           mammothResult.messages
435:         );
436:       }
437:       const sanitizedText = this.sanitizeText(extractedText);
438:       const sanitizedHtml = this.sanitizeText(htmlContent);
439:       const chunks = this.createStructuredChunksFromHtml(
440:         sanitizedText,
441:         sanitizedHtml,
442:         options.chunkSize || 2000
443:       );
444:       return {
445:         success: true,
446:         text: sanitizedText,
447:         htmlContent: sanitizedHtml,
448:         pageCount: 1,
449:         chunks,
450:       };
451:     } catch (error) {
452:       console.error(`[DocumentExtraction] DOCX extraction failed:`, error);
