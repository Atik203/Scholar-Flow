60:           ignoredActions: [
61:             FLUSH,
62:             REHYDRATE,
63:             PAUSE,
64:             PERSIST,
65:             PURGE,
66:             REGISTER,
67:             "api/executeQuery/pending",
68:             "api/executeQuery/fulfilled",
69:             "api/executeQuery/rejected",
70:             "api/executeMutation/pending",
71:             "api/executeMutation/fulfilled",
72:             "api/executeMutation/rejected",
73:           ],
74:           ignoredActionsPaths: ["meta.arg", "payload.timestamp"],
75:           ignoredPaths: [
76:             "api.queries",
77:             "api.mutations",
78:             "api.provided",
79:             "api.subscriptions",
80:             "api.config",
81:           ],
82:         },
83:       }).concat(apiSlice.middleware, phase2Api.middleware),
84:     devTools: process.env.NODE_ENV !== "production",
