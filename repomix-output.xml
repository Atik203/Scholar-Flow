 1: import { createClient, RedisClientOptions } from "redis";
 2: import config from "../config";
 3: export type RedisInstance = ReturnType<typeof createClient> | null;
 4: let client: RedisInstance = null;
 5: let connectingPromise: Promise<RedisInstance> | null = null;
 6: let connectionFailed = false;
 7: const buildRedisOptions = (): RedisClientOptions | null => {
 8:   const { host, port, password, username, db, tls } = config.redis;
 9:   if (!host || !port) {
10:     return null;
11:   }
12:   const baseOptions: RedisClientOptions = {
13:     socket: {
14:       host,
15:       port,
16:       connectTimeout: 10000,
17:       reconnectStrategy: (retries) => {
18:         if (retries > 3) {
19:           connectionFailed = true;
20:           return new Error("Max reconnection attempts reached");
21:         }
22:         return Math.min(retries * 1000, 3000);
23:       },
24:     },
25:     password: password || undefined,
26:     username: username || undefined,
27:     database: typeof db === "number" ? db : 0,
28:   };
29:   if (tls && baseOptions.socket) {
30:     (baseOptions.socket as any).tls = {};
31:   }
32:   return baseOptions;
33: };
34: export const getRedisClient = async (): Promise<RedisInstance> => {
35:   if (client) {
36:     return client;
37:   }
38:   if (connectionFailed) {
39:     return null;
40:   }
41:   const options = buildRedisOptions();
42:   if (!options) {
43:     return null;
44:   }
45:   if (!connectingPromise) {
46:     const redisClient = createClient(options);
47:     redisClient.on("error", (error) => {
48:       if (process.env.NODE_ENV !== "test") {
49:         console.error("[Redis] Connection error:", error.message);
50:       }
51:     });
52:     connectingPromise = redisClient
53:       .connect()
54:       .then(() => {
55:         if (process.env.NODE_ENV !== "test") {
56:           const socket = options.socket as { host?: string; port?: number };
57:           console.log(
58:             `✅ Connected to Redis at ${socket?.host}:${socket?.port} (db ${options.database ?? 0})`
59:           );
60:         }
61:         client = redisClient;
62:         return client;
63:       })
64:       .catch((error) => {
65:         connectionFailed = true;
66:         if (process.env.NODE_ENV !== "test") {
67:           console.warn(
68:             "⚠️  Redis connection failed. Continuing without cache:",
69:             error.message
70:           );
71:         }
72:         return null;
73:       })
74:       .finally(() => {
75:         connectingPromise = null;
76:       });
77:   }
78:   return connectingPromise;
79: };
80: export const disconnectRedis = async () => {
81:   if (client) {
82:     await client.quit();
83:     client = null;
84:   }
85: };
86: export const isRedisConfigured = () => {
87:   const options = buildRedisOptions();
88:   return Boolean(options);
89: };
