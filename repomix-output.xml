128: const getPasswordStrength = (password: string) => {
129:   if (!password) return { strength: 0, text: "", width: "0%" };
130:   let strength = 0;
131:   if (password.length >= 8) strength++;
132:   if (/[a-z]/.test(password)) strength++;
133:   if (/[A-Z]/.test(password)) strength++;
134:   if (/\d/.test(password)) strength++;
135:   if (/[^a-zA-Z\d]/.test(password)) strength++;
136:   const width = `${(strength / 5) * 100}%`;
137:   if (strength <= 2) return { strength, text: "Weak", color: "bg-red-500", textColor: "text-red-500", width };
138:   if (strength <= 3) return { strength, text: "Fair", color: "bg-yellow-500", textColor: "text-yellow-500", width };
139:   if (strength <= 4) return { strength, text: "Good", color: "bg-green-500", textColor: "text-green-500", width };
140:   return { strength, text: "Strong", color: "bg-green-600", textColor: "text-green-600", width };
141: };
