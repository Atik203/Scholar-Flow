<file path="apps/frontend/src/hooks/useDiscussionSocket.ts">
  1: "use client";
  2: import { useCallback, useEffect, useRef, useState } from "react";
  3: import { io, Socket } from "socket.io-client";
  4: import { getAppStore } from "@/redux/storeAccess";
  5: const SOCKET_URL = process.env.NEXT_PUBLIC_WS_URL || "http://localhost:5001";
  6: function getAuthToken(): string | null {
  7:   try {
  8:     const store = getAppStore();
  9:     if (store) return store.getState().auth?.accessToken || null;
 10:   } catch {}
 11:   return null;
 12: }
 13: export interface DiscussionMessage {
 14:   id: string;
 15:   userId: string;
 16:   userName: string;
 17:   content: string;
 18:   threadId?: string;
 19:   timestamp: string;
 20: }
 21: interface UseDiscussionSocketOptions {
 22:   room: string;
 23:   enabled: boolean;
 24:   onMessage?: (msg: DiscussionMessage) => void;
 25: }
 26: export function useDiscussionSocket({
 27:   room,
 28:   enabled,
 29:   onMessage,
 30: }: UseDiscussionSocketOptions) {
 31:   const socketRef = useRef<Socket | null>(null);
 32:   const [connected, setConnected] = useState(false);
 33:   const [memberCount, setMemberCount] = useState(0);
 34:   const [typingUsers, setTypingUsers] = useState<
 35:     { userId: string; userName: string }[]
 36:   >([]);
 37:   useEffect(() => {
 38:     if (!enabled || !room) return;
 39:     const token = getAuthToken();
 40:     if (!token) return;
 41:     const socket = io(SOCKET_URL, {
 42:       auth: { token },
 43:       transports: ["websocket"],
 44:     });
 45:     socketRef.current = socket;
 46:     socket.on("connect", () => {
 47:       setConnected(true);
 48:       socket.emit("room:join", room);
 49:     });
 50:     socket.on("connect_error", (error: Error) => {
 51:       setConnected(false);
 52:       if (process.env.NODE_ENV !== "production") {
 53:         console.warn("[DiscussionSocket] connect error:", error.message);
 54:       }
 55:     });
 56:     socket.on("room:error", (payload: unknown) => {
 57:       if (process.env.NODE_ENV !== "production") {
 58:         console.warn("[DiscussionSocket] room error:", payload);
 59:       }
 60:     });
 61:     socket.on("room:joined", ({ memberCount: count }: { memberCount: number }) => {
 62:       setMemberCount(count);
 63:     });
 64:     socket.on("presence:joined", ({ memberCount: count }: { memberCount: number }) => {
 65:       setMemberCount(count);
 66:     });
 67:     socket.on("presence:left", ({ memberCount: count }: { memberCount: number }) => {
 68:       setMemberCount(count);
 69:     });
 70:     socket.on("discussion:message", (msg: DiscussionMessage) => {
 71:       onMessage?.(msg);
 72:     });
 73:     socket.on(
 74:       "typing:update",
 75:       ({
 76:         userId,
 77:         userName,
 78:         isTyping,
 79:       }: {
 80:         userId: string;
 81:         userName: string;
 82:         isTyping: boolean;
 83:       }) => {
 84:         setTypingUsers((prev) => {
 85:           if (isTyping) {
 86:             const exists = prev.find((u) => u.userId === userId);
 87:             if (exists) return prev;
 88:             return [...prev, { userId, userName }];
 89:           }
 90:           return prev.filter((u) => u.userId !== userId);
 91:         });
 92:       }
 93:     );
 94:     socket.on("disconnect", () => {
 95:       setConnected(false);
 96:     });
 97:     return () => {
 98:       socket.emit("room:leave", room);
 99:       socket.disconnect();
100:       socketRef.current = null;
101:       setConnected(false);
102:     };
103:   }, [room, enabled, onMessage]);
104:   const sendMessage = useCallback(
105:     (content: string, threadId?: string) => {
106:       if (!socketRef.current || !connected) return;
107:       socketRef.current.emit("discussion:message", {
108:         room,
109:         content,
110:         threadId,
111:       });
112:     },
113:     [room, connected]
114:   );
115:   const sendTyping = useCallback(
116:     (isTyping: boolean) => {
117:       if (!socketRef.current || !connected) return;
118:       if (isTyping) {
119:         socketRef.current.emit("typing:start", { room });
120:       } else {
121:         socketRef.current.emit("typing:stop", { room });
122:       }
123:     },
124:     [room, connected]
125:   );
126:   return { connected, memberCount, typingUsers, sendMessage, sendTyping };
127: }
</file>

<file path="apps/frontend/src/hooks/useNotificationStream.ts">
  1: "use client";
  2: import { useEffect, useRef } from "react";
  3: import { getApiBaseUrl } from "@/lib/apiUrl";
  4: import { useSelector } from "react-redux";
  5: import { useDispatch } from "react-redux";
  6: import type { RootState } from "@/redux/store";
  7: import { apiSlice } from "@/redux/api/apiSlice";
  8: import { notificationApi } from "@/redux/api/notificationApi";
  9: import { showSuccessToast } from "@/components/providers/ToastProvider";
 10: import type { AppNotification } from "@/redux/api/notificationApi";
 11: export interface SseNotificationEvent {
 12:   id: string;
 13:   type: "notification.created";
 14:   data: AppNotification;
 15: }
 16: export interface UseNotificationStreamOptions {
 17:   onEvent?: (event: SseNotificationEvent) => void;
 18:   enabled?: boolean;
 19: }
 20: let _activeSource: EventSource | null = null;
 21: let _activeToken: string | null = null;
 22: let _refCount = 0;
 23: const _listeners = new Set<(event: SseNotificationEvent) => void>();
 24: let _reconnectTimer: ReturnType<typeof setTimeout> | null = null;
 25: let _retryDelay = 1000;
 26: const MAX_RETRY_DELAY = 30000;
 27: let _generation = 0;
 28: let _dispatchRef: ((action: unknown) => void) | null = null;
 29: const scheduleReconnect = () => {
 30:   if (_reconnectTimer) clearTimeout(_reconnectTimer);
 31:   _reconnectTimer = setTimeout(() => {
 32:     _retryDelay = Math.min(_retryDelay * 2, MAX_RETRY_DELAY);
 33:     ensureConnection();
 34:   }, _retryDelay);
 35: };
 36: const ensureConnection = () => {
 37:   const gen = _generation;
 38:   const token = _activeToken;
 39:   if (!token || _refCount <= 0) return;
 40:   if (_activeSource) return;
 41:   const base = getApiBaseUrl();
 42:   const url = `${base}/notifications/stream?token=${encodeURIComponent(token)}`;
 43:   let es: EventSource;
 44:   try {
 45:     es = new EventSource(url, { withCredentials: false });
 46:   } catch (err) {
 47:     if (process.env.NODE_ENV !== "production") {
 48:       console.warn("[SSE] Failed to construct EventSource:", err);
 49:     }
 50:     scheduleReconnect();
 51:     return;
 52:   }
 53:   _activeSource = es;
 54:   es.addEventListener("connected", () => {
 55:     _retryDelay = 1000;
 56:   });
 57:   es.addEventListener("notification.created", (ev) => {
 58:     if (gen !== _generation) return;
 59:     try {
 60:       const data = JSON.parse((ev as MessageEvent).data);
 61:       _dispatchRef?.(notificationApi.util.invalidateTags(["Notification"]));
 62:       _dispatchRef?.(apiSlice.util.invalidateTags([{ type: "Notification", id: "UNREAD_COUNT" }]));
 63:       _dispatchRef?.(apiSlice.util.invalidateTags([{ type: "Team", id: "ACCESS" }]));
 64:       showSuccessToast(data.title ?? "New notification", data.message);
 65:       const event: SseNotificationEvent = {
 66:         id: (ev as MessageEvent).lastEventId || data.id,
 67:         type: "notification.created",
 68:         data,
 69:       };
 70:       _listeners.forEach((listener) => listener(event));
 71:     } catch (err) {
 72:       if (process.env.NODE_ENV !== "production") {
 73:         console.warn("[SSE] Bad event payload:", err);
 74:       }
 75:     }
 76:   });
 77:   es.onerror = () => {
 78:     if (_activeSource === es) {
 79:       _activeSource.close();
 80:       _activeSource = null;
 81:     }
 82:     scheduleReconnect();
 83:   };
 84: };
 85: const teardownConnection = () => {
 86:   _generation += 1;
 87:   if (_reconnectTimer) {
 88:     clearTimeout(_reconnectTimer);
 89:     _reconnectTimer = null;
 90:   }
 91:   if (_activeSource) {
 92:     try {
 93:       _activeSource.close();
 94:     } catch {
 95:     }
 96:     _activeSource = null;
 97:   }
 98:   _activeToken = null;
 99: };
100: export function closeNotificationStream(): void {
101:   teardownConnection();
102: }
103: export function useNotificationStream(
104:   options: UseNotificationStreamOptions = {}
105: ) {
106:   const { onEvent, enabled = true } = options;
107:   const accessToken = useSelector(
108:     (s: RootState) => s.auth.accessToken
109:   );
110:   const dispatch = useDispatch();
111:   const onEventRef = useRef(onEvent);
112:   onEventRef.current = onEvent;
113:   useEffect(() => {
114:     _dispatchRef = dispatch as unknown as (action: unknown) => void;
115:   }, [dispatch]);
116:   useEffect(() => {
117:     if (!enabled || !accessToken) return;
118:     if (onEventRef.current) {
119:       _listeners.add(onEventRef.current);
120:     }
121:     _refCount += 1;
122:     if (_activeToken && _activeToken !== accessToken) {
123:       teardownConnection();
124:     }
125:     _activeToken = accessToken;
126:     ensureConnection();
127:     return () => {
128:       if (onEventRef.current) {
129:         _listeners.delete(onEventRef.current);
130:       }
131:       _refCount = Math.max(0, _refCount - 1);
132:       if (_refCount === 0) {
133:         teardownConnection();
134:       }
135:     };
136:   }, [accessToken, enabled]);
137:   return null;
138: }
139: export default useNotificationStream;
