219:                     onClick={() => onPaperSelect(paper.id)}
220:                   >
221:                     Open →
222:                   </Button>
223:                 </div>
224:               </CardContent>
225:             </Card>
226:           ))}
227:         </div>
228:       )}
229:     </div>
230:   );
231: }
