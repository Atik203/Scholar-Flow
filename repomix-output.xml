<file path="apps/frontend/src/components/tiptap-ui/code-block-button/use-code-block.ts">
  1: "use client"
  2: import * as React from "react"
  3: import { type Editor } from "@tiptap/react"
  4: import { NodeSelection, TextSelection } from "@tiptap/pm/state"
  5: import { useTiptapEditor } from "@/hooks/use-tiptap-editor"
  6: import {
  7:   findNodePosition,
  8:   isNodeInSchema,
  9:   isNodeTypeSelected,
 10:   isValidPosition,
 11: } from "@/lib/tiptap-utils"
 12: import { CodeBlockIcon } from "@/components/tiptap-icons/code-block-icon"
 13: export const CODE_BLOCK_SHORTCUT_KEY = "mod+alt+c"
 14: export interface UseCodeBlockConfig {
 15:   editor?: Editor | null
 16:   hideWhenUnavailable?: boolean
 17:   onToggled?: () => void
 18: }
 19: export function canToggle(
 20:   editor: Editor | null,
 21:   turnInto: boolean = true
 22: ): boolean {
 23:   if (!editor || !editor.isEditable) return false
 24:   if (
 25:     !isNodeInSchema("codeBlock", editor) ||
 26:     isNodeTypeSelected(editor, ["image"])
 27:   )
 28:     return false
 29:   if (!turnInto) {
 30:     return editor.can().toggleNode("codeBlock", "paragraph")
 31:   }
 32:   try {
 33:     const view = editor.view
 34:     const state = view.state
 35:     const selection = state.selection
 36:     if (selection.empty || selection instanceof TextSelection) {
 37:       const pos = findNodePosition({
 38:         editor,
 39:         node: state.selection.$anchor.node(1),
 40:       })?.pos
 41:       if (!isValidPosition(pos)) return false
 42:     }
 43:     return true
 44:   } catch {
 45:     return false
 46:   }
 47: }
 48: export function toggleCodeBlock(editor: Editor | null): boolean {
 49:   if (!editor || !editor.isEditable) return false
 50:   if (!canToggle(editor)) return false
 51:   try {
 52:     const view = editor.view
 53:     let state = view.state
 54:     let tr = state.tr
 55:     if (state.selection.empty || state.selection instanceof TextSelection) {
 56:       const pos = findNodePosition({
 57:         editor,
 58:         node: state.selection.$anchor.node(1),
 59:       })?.pos
 60:       if (!isValidPosition(pos)) return false
 61:       tr = tr.setSelection(NodeSelection.create(state.doc, pos))
 62:       view.dispatch(tr)
 63:       state = view.state
 64:     }
 65:     const selection = state.selection
 66:     let chain = editor.chain().focus()
 67:     if (selection instanceof NodeSelection) {
 68:       const firstChild = selection.node.firstChild?.firstChild
 69:       const lastChild = selection.node.lastChild?.lastChild
 70:       const from = firstChild
 71:         ? selection.from + firstChild.nodeSize
 72:         : selection.from + 1
 73:       const to = lastChild
 74:         ? selection.to - lastChild.nodeSize
 75:         : selection.to - 1
 76:       chain = chain.setTextSelection({ from, to }).clearNodes()
 77:     }
 78:     const toggle = editor.isActive("codeBlock")
 79:       ? chain.setNode("paragraph")
 80:       : chain.toggleNode("codeBlock", "paragraph")
 81:     toggle.run()
 82:     editor.chain().focus().selectTextblockEnd().run()
 83:     return true
 84:   } catch {
 85:     return false
 86:   }
 87: }
 88: export function shouldShowButton(props: {
 89:   editor: Editor | null
 90:   hideWhenUnavailable: boolean
 91: }): boolean {
 92:   const { editor, hideWhenUnavailable } = props
 93:   if (!editor || !editor.isEditable) return false
 94:   if (!isNodeInSchema("codeBlock", editor)) return false
 95:   if (hideWhenUnavailable && !editor.isActive("code")) {
 96:     return canToggle(editor)
 97:   }
 98:   return true
 99: }
100: export function useCodeBlock(config?: UseCodeBlockConfig) {
101:   const {
102:     editor: providedEditor,
103:     hideWhenUnavailable = false,
104:     onToggled,
105:   } = config || {}
106:   const { editor } = useTiptapEditor(providedEditor)
107:   const [isVisible, setIsVisible] = React.useState<boolean>(true)
108:   const canToggleState = canToggle(editor)
109:   const isActive = editor?.isActive("codeBlock") || false
110:   React.useEffect(() => {
111:     if (!editor) return
112:     const handleSelectionUpdate = () => {
113:       setIsVisible(shouldShowButton({ editor, hideWhenUnavailable }))
114:     }
115:     handleSelectionUpdate()
116:     editor.on("selectionUpdate", handleSelectionUpdate)
117:     return () => {
118:       editor.off("selectionUpdate", handleSelectionUpdate)
119:     }
120:   }, [editor, hideWhenUnavailable])
121:   const handleToggle = React.useCallback(() => {
122:     if (!editor) return false
123:     const success = toggleCodeBlock(editor)
124:     if (success) {
125:       onToggled?.()
126:     }
127:     return success
128:   }, [editor, onToggled])
129:   return {
130:     isVisible,
131:     isActive,
132:     handleToggle,
133:     canToggle: canToggleState,
134:     label: "Code Block",
135:     shortcutKeys: CODE_BLOCK_SHORTCUT_KEY,
136:     Icon: CodeBlockIcon,
137:   }
138: }
</file>

