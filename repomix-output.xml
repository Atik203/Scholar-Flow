                        </button>
                      </Badge>
                    </motion.div>
                  ))}
                </AnimatePresence>

                {showAddInterest ? (
                  <motion.div
                    initial={{ opacity: 0, width: 0 }}
                    animate={{ opacity: 1, width: "auto" }}
                    className="flex items-center gap-2"
                  >
                    <Input
                      value={newInterest}
                      onChange={(e) => setNewInterest(e.target.value)}
                      placeholder="Add interest..."
                      className="h-8 w-40"
                      onKeyDown={(e) =>
                        e.key === "Enter" && handleAddInterest()
