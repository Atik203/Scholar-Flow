 78:       console.log(`[PDFExtraction] Creating chunks for paper: ${paperId}`);
 79:       const chunks = this.chunkText(sanitizedFullText, pageCount);
 80:       console.log(`[PDFExtraction] Created ${chunks.length} chunks`);
