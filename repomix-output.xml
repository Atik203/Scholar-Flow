600:                           {item.badge}
601:                         </span>
602:                       )}
603:                     </Button>
604:                   );
605:                 })}
606:               </nav>
607:               <div className="my-3 border-t border-gray-100 dark:border-gray-800" />
608:             </div>
609:             <div className="mb-4">
610:               <h3 className="px-3 mb-2 text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
611:                 Features
612:               </h3>
613:               <nav className="space-y-0.5">
614:                 {resolvedNavigationItems.map((item) => {
615:                   const sectionActive = item.items
616:                     ? item.items.some((subItem) => pathname.startsWith(subItem.href))
617:                     : pathname === item.href || pathname.startsWith(`${item.href}/`);
618:                   if (item.items && item.items.length > 0) {
619:                     return (
620:                       <CollapsibleSection
621:                         key={item.title}
622:                         item={item}
623:                         isActive={sectionActive ?? false}
624:                         pathname={pathname}
625:                       />
626:                     );
627:                   }
628:                   return (
629:                     <Button
630:                       key={item.title}
631:                       variant="ghost"
632:                       onClick={() => handleLinkClick(item.href)}
633:                       className={`w-full justify-start px-3 py-2.5 h-auto font-normal text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white transition-colors duration-200 ${
634:                         sectionActive
635:                           ? "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary"
636:                           : ""
637:                       }`}
638:                     >
639:                       <item.icon className="mr-3 h-4 w-4" />
640:                       <span>{item.title}</span>
641:                       {item.badge && (
642:                         <span className="ml-auto rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">
643:                           {item.badge}
644:                         </span>
645:                       )}
646:                     </Button>
647:                   );
648:                 })}
649:               </nav>
650:             </div>
651:           </>
652:         )}
653:       </div>
654:       <div className="p-4 border-t border-gray-200 dark:border-gray-800">
655:         <div className="text-xs font-medium text-gray-500 dark:text-gray-400 text-center">
