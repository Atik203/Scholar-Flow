  1: import { randomUUID } from "crypto";
  2: import ApiError from "../../errors/ApiError";
  3: import prisma from "../../shared/prisma";
  4: import {
  5:   CreateAnnotationInput,
  6:   CreateAnnotationReplyInput,
  7:   GetAnnotationsQuery,
  8:   UpdateAnnotationInput,
  9: } from "./annotation.types";
 10: export class AnnotationService {
 11:   static async createAnnotation(userId: string, data: CreateAnnotationInput) {
 12:     const annotationId = randomUUID();
 13:     const now = new Date();
 14:     try {
 15:       const positionIndex =
 16:         data.anchor.coordinates.y != null
 17:           ? Math.round(data.anchor.coordinates.y * 1000)
 18:           : 0;
 19:       await prisma.$executeRaw`
 20:         INSERT INTO "Annotation" (
 21:           id, "paperId", "userId", type, anchor, text, "parentId", version,
 22:           color, "positionIndex", metadata,
 23:           "createdAt", "updatedAt", "isDeleted"
 24:         )
 25:         VALUES (
 26:           ${annotationId}, ${data.paperId}, ${userId}, ${data.type}::"AnnotationType",
 27:           ${JSON.stringify(data.anchor)}::jsonb, ${data.text}, ${data.parentId || null},
 28:           1, ${data.color || "#FFEB3B"}, ${positionIndex},
 29:           ${data.metadata ? JSON.stringify(data.metadata) : null}::jsonb,
 30:           ${now}, ${now}, false
 31:         )
 32:       `;
 33:       // Fetch the created annotation with all related data using $queryRaw
 34:       const annotations = await prisma.$queryRaw<any[]>`
 35:         SELECT
 36:           a.id, a."paperId", a."userId", a.type, a.anchor, a.text, a.version,
 37:           a.color, a."positionIndex", a.metadata,
 38:           a."parentId", a."createdAt", a."updatedAt",
 39:           json_build_object(
 40:             'id', u.id,
 41:             'name', u.name,
 42:             'email', u.email,
 43:             'image', u.image
 44:           ) as user,
 45:           json_build_object(
 46:             'id', p.id,
 47:             'title', p.title
 48:           ) as paper,
 49:           CASE WHEN a."parentId" IS NOT NULL THEN
 50:             json_build_object(
 51:               'id', parent_a.id,
 52:               'text', parent_a.text,
 53:               'user', json_build_object(
 54:                 'id', parent_u.id,
 55:                 'name', parent_u.name,
 56:                 'email', parent_u.email,
 57:                 'image', parent_u.image
 58:               )
 59:             )
 60:           ELSE NULL END as parent,
 61:           COALESCE(
 62:             (
 63:               SELECT json_agg(
 64:                 json_build_object(
 65:                   'id', child_a.id,
 66:                   'text', child_a.text,
 67:                   'createdAt', child_a."createdAt",
 68:                   'user', json_build_object(
 69:                     'id', child_u.id,
 70:                     'name', child_u.name,
 71:                     'email', child_u.email,
 72:                     'image', child_u.image
 73:                   )
 74:                 ) ORDER BY child_a."createdAt" ASC
 75:               )
 76:               FROM "Annotation" child_a
 77:               LEFT JOIN "User" child_u ON child_a."userId" = child_u.id
 78:               WHERE child_a."parentId" = a.id AND child_a."isDeleted" = false
 79:             ),
 80:             '[]'::json
 81:           ) as children
 82:         FROM "Annotation" a
 83:         LEFT JOIN "User" u ON a."userId" = u.id
 84:         LEFT JOIN "Paper" p ON a."paperId" = p.id
 85:         LEFT JOIN "Annotation" parent_a ON a."parentId" = parent_a.id
 86:         LEFT JOIN "User" parent_u ON parent_a."userId" = parent_u.id
 87:         WHERE a.id = ${annotationId}
 88:         LIMIT 1
 89:       `;
 90:       if (annotations.length === 0) {
 91:         throw new ApiError(500, "Failed to create annotation");
 92:       }
 93:       return annotations[0];
 94:     } catch (error) {
 95:       console.error("Error creating annotation:", error);
 96:       throw new ApiError(500, "Failed to create annotation");
 97:     }
 98:   }
 99:   /**
100:    * Get annotations for a paper using standard Prisma client with pagination
101:    */
102:   static async getPaperAnnotations(query: GetAnnotationsQuery) {
103:     try {
104:       const { paperId, page: pageFilter, type, limit = 50, pageNum = 1 } = query;
105:       const skip = (pageNum - 1) * limit;
106:       const where: Record<string, unknown> = {
107:         paperId,
108:         isDeleted: false,
109:       };
110:       // Filter by PDF page number stored in JSONB anchor
111:       if (pageFilter !== undefined) {
112:         where.anchor = { path: ['page'], equals: pageFilter };
113:       }
114:       if (type) {
115:         where.type = type;
116:       }
117:       const [annotations, total] = await Promise.all([
118:         prisma.annotation.findMany({
119:           where,
120:           select: {
121:             id: true,
122:             paperId: true,
123:             userId: true,
124:             type: true,
125:             anchor: true,
126:             text: true,
127:             version: true,
128:             parentId: true,
129:             color: true,
130:             positionIndex: true,
131:             metadata: true,
132:             createdAt: true,
133:             updatedAt: true,
134:             user: {
135:               select: { id: true, name: true, email: true, image: true },
136:             },
137:             children: {
138:               where: { isDeleted: false },
139:               orderBy: { createdAt: 'asc' },
140:               select: {
141:                 id: true,
142:                 text: true,
143:                 color: true,
144:                 createdAt: true,
145:                 updatedAt: true,
146:                 user: {
147:                   select: { id: true, name: true, email: true, image: true },
148:                 },
149:               },
150:             },
151:             versions: {
152:               orderBy: { timestamp: 'desc' },
153:               take: 5,
154:               select: {
155:                 id: true,
156:                 version: true,
157:                 text: true,
158:                 timestamp: true,
159:                 changedBy: {
160:                   select: { id: true, name: true, email: true },
161:                 },
162:               },
163:             },
164:           },
165:           orderBy: { createdAt: 'asc' },
166:           take: Math.min(limit, 100),
167:           skip,
168:         }),
169:         prisma.annotation.count({ where }),
170:       ]);
171:       return {
172:         annotations,
173:         pagination: {
174:           page: pageNum,
175:           limit,
176:           total,
177:           totalPage: Math.ceil(total / limit),
178:         },
179:       };
180:     } catch (error) {
181:       console.error("Error fetching paper annotations:", error);
182:       throw new ApiError(500, "Failed to fetch annotations");
183:     }
184:   }
185:   /**
186:    * Update an annotation using raw SQL
187:    * Source: Optimized annotation update with version history
188:    */
189:   static async updateAnnotation(
190:     annotationId: string,
191:     userId: string,
192:     data: UpdateAnnotationInput
193:   ) {
194:     try {
195:       // Get current annotation using $queryRaw
196:       const currentAnnotations = await prisma.$queryRaw<any[]>`
197:         SELECT id, "userId", text, version, anchor
198:         FROM "Annotation"
199:         WHERE id = ${annotationId} AND "isDeleted" = false
200:         LIMIT 1
201:       `;
202:       if (currentAnnotations.length === 0) {
203:         throw new ApiError(404, "Annotation not found");
204:       }
205:       const currentAnnotation = currentAnnotations[0];
206:       if (currentAnnotation.userId !== userId) {
207:         throw new ApiError(403, "Unauthorized to update this annotation");
208:       }
209:       // Create version record if text is being updated
210:       if (data.text !== undefined) {
211:         const versionId = randomUUID();
212:         const now = new Date();
213:         await prisma.$executeRaw`
214:           INSERT INTO "AnnotationVersion" (
215:             id, "annotationId", version, text, "changedById", timestamp,
216:             "createdAt", "updatedAt", "isDeleted"
217:           )
218:           VALUES (
219:             ${versionId}, ${annotationId}, ${currentAnnotation.version},
220:             ${currentAnnotation.text}, ${userId}, ${now}, ${now}, ${now}, false
221:           )
222:         `;
223:       }
224:       // Update annotation using $executeRaw
225:       const now = new Date();
226:       const newVersion = data.text !== undefined
227:         ? currentAnnotation.version + 1
228:         : currentAnnotation.version;
229:       // Empty string is a valid value: it clears an optional note.
230:       const newText = data.text !== undefined ? data.text : currentAnnotation.text;
231:       const newAnchor = data.anchor
232:         ? JSON.stringify(data.anchor)
233:         : JSON.stringify(currentAnnotation.anchor);
234:       const newColor = data.color || currentAnnotation.color;
235:       const newMetadata = data.metadata
236:         ? JSON.stringify(data.metadata)
237:         : JSON.stringify(currentAnnotation.metadata);
238:       await prisma.$executeRaw`
239:         UPDATE "Annotation"
240:         SET text = ${newText},
241:             version = ${newVersion},
242:             anchor = ${newAnchor}::jsonb,
243:             color = ${newColor},
244:             metadata = ${newMetadata}::jsonb,
245:             "updatedAt" = ${now}
246:         WHERE id = ${annotationId}
247:       `;
248:       // Fetch updated annotation with relations
249:       const updatedAnnotations = await prisma.$queryRaw<any[]>`
250:         SELECT
251:           a.id, a."paperId", a."userId", a.type, a.anchor, a.text, a.version,
252:           a.color, a."positionIndex", a.metadata,
253:           a."parentId", a."createdAt", a."updatedAt",
254:           json_build_object(
255:             'id', u.id,
256:             'name', u.name,
257:             'email', u.email,
258:             'image', u.image
259:           ) as user,
260:           COALESCE(
261:             (
262:               SELECT json_agg(
263:                 json_build_object(
264:                   'id', child_a.id,
265:                   'text', child_a.text,
266:                   'createdAt', child_a."createdAt",
267:                   'updatedAt', child_a."updatedAt",
268:                   'user', json_build_object(
269:                     'id', child_u.id,
270:                     'name', child_u.name,
271:                     'email', child_u.email,
272:                     'image', child_u.image
273:                   )
274:                 ) ORDER BY child_a."createdAt" ASC
275:               )
276:               FROM "Annotation" child_a
277:               LEFT JOIN "User" child_u ON child_a."userId" = child_u.id
278:               WHERE child_a."parentId" = a.id AND child_a."isDeleted" = false
279:             ),
280:             '[]'::json
281:           ) as children
282:         FROM "Annotation" a
283:         LEFT JOIN "User" u ON a."userId" = u.id
284:         WHERE a.id = ${annotationId}
285:         LIMIT 1
286:       `;
287:       return updatedAnnotations[0];
288:     } catch (error) {
289:       if (error instanceof ApiError) {
290:         throw error;
291:       }
292:       console.error("Error updating annotation:", error);
293:       throw new ApiError(500, "Failed to update annotation");
294:     }
295:   }
296:   /**
297:    * Delete an annotation using raw SQL (soft delete)
298:    * Source: Optimized soft delete for annotations
299:    */
300:   static async deleteAnnotation(annotationId: string, userId: string) {
301:     try {
302:       // Check annotation exists and belongs to user
303:       const annotations = await prisma.$queryRaw<any[]>`
304:         SELECT id, "userId"
305:         FROM "Annotation"
306:         WHERE id = ${annotationId} AND "isDeleted" = false
307:         LIMIT 1
308:       `;
309:       if (annotations.length === 0) {
310:         throw new ApiError(404, "Annotation not found");
311:       }
312:       if (annotations[0].userId !== userId) {
313:         throw new ApiError(403, "Unauthorized to delete this annotation");
314:       }
315:       // Soft delete
316:       const now = new Date();
317:       await prisma.$executeRaw`
318:         UPDATE "Annotation"
319:         SET "isDeleted" = true, "updatedAt" = ${now}
320:         WHERE id = ${annotationId}
321:       `;
322:       return { success: true };
323:     } catch (error) {
324:       if (error instanceof ApiError) {
325:         throw error;
326:       }
327:       console.error("Error deleting annotation:", error);
328:       throw new ApiError(500, "Failed to delete annotation");
329:     }
330:   }
331:   /**
332:    * Create a reply to an annotation using raw SQL
333:    * Source: Optimized annotation reply creation
334:    */
335:   static async createAnnotationReply(
336:     annotationId: string,
337:     userId: string,
338:     data: CreateAnnotationReplyInput
339:   ) {
340:     try {
341:       // Verify parent annotation exists
342:       const parentAnnotations = await prisma.$queryRaw<any[]>`
343:         SELECT id, "paperId", anchor
344:         FROM "Annotation"
345:         WHERE id = ${annotationId} AND "isDeleted" = false
346:         LIMIT 1
347:       `;
348:       if (parentAnnotations.length === 0) {
349:         throw new ApiError(404, "Parent annotation not found");
350:       }
351:       const parentAnnotation = parentAnnotations[0];
352:       const replyId = randomUUID();
353:       const now = new Date();
354:       // Create reply annotation
355:       await prisma.$executeRaw`
356:         INSERT INTO "Annotation" (
357:           id, "paperId", "userId", type, anchor, text, "parentId", version,
358:           color, "positionIndex", metadata,
359:           "createdAt", "updatedAt", "isDeleted"
360:         )
361:         VALUES (
362:           ${replyId}, ${parentAnnotation.paperId}, ${userId},
363:           'COMMENT'::"AnnotationType", ${JSON.stringify(parentAnnotation.anchor)}::jsonb,
364:           ${data.text}, ${annotationId}, 1,
365:           ${data.color || "#2196F3"}, 0, NULL::jsonb,
366:           ${now}, ${now}, false
367:         )
368:       `;
369:       // Fetch created reply with relations
370:       const replies = await prisma.$queryRaw<any[]>`
371:         SELECT
372:           a.id, a."paperId", a."userId", a.type, a.anchor, a.text, a.version,
373:           a.color, a."positionIndex", a.metadata,
374:           a."parentId", a."createdAt", a."updatedAt",
375:           json_build_object(
376:             'id', u.id,
377:             'name', u.name,
378:             'email', u.email,
379:             'image', u.image
380:           ) as user,
381:           json_build_object(
382:             'id', parent_a.id,
383:             'text', parent_a.text,
384:             'user', json_build_object(
385:               'id', parent_u.id,
386:               'name', parent_u.name,
387:               'email', parent_u.email,
388:               'image', parent_u.image
389:             )
390:           ) as parent
391:         FROM "Annotation" a
392:         LEFT JOIN "User" u ON a."userId" = u.id
393:         LEFT JOIN "Annotation" parent_a ON a."parentId" = parent_a.id
394:         LEFT JOIN "User" parent_u ON parent_a."userId" = parent_u.id
395:         WHERE a.id = ${replyId}
396:         LIMIT 1
397:       `;
398:       return replies[0];
399:     } catch (error) {
400:       if (error instanceof ApiError) {
401:         throw error;
402:       }
403:       console.error("Error creating annotation reply:", error);
404:       throw new ApiError(500, "Failed to create annotation reply");
405:     }
406:   }
407:   /**
408:    * Get annotation versions/history using raw SQL
409:    * Source: Optimized version history retrieval
410:    */
411:   static async getAnnotationVersions(annotationId: string) {
412:     try {
413:       const versions = await prisma.$queryRaw<any[]>`
414:         SELECT
415:           av.id, av."annotationId", av.version, av.text, av.timestamp,
416:           json_build_object(
417:             'id', u.id,
418:             'name', u.name,
419:             'email', u.email
420:           ) as "changedBy"
421:         FROM "AnnotationVersion" av
422:         LEFT JOIN "User" u ON av."changedById" = u.id
423:         WHERE av."annotationId" = ${annotationId} AND av."isDeleted" = false
424:         ORDER BY av.timestamp DESC
425:       `;
426:       return versions;
427:     } catch (error) {
428:       console.error("Error fetching annotation versions:", error);
429:       throw new ApiError(500, "Failed to fetch annotation versions");
430:     }
431:   }
432:   /**
433:    * Get user's annotations across all papers using raw SQL
434:    * Source: Optimized user annotations retrieval with pagination
435:    */
436:   static async getUserAnnotations(userId: string, page = 1, limit = 20) {
437:     const skip = (page - 1) * limit;
438:     try {
439:       const annotations = await prisma.$queryRaw<any[]>`
440:         SELECT
441:           a.id, a."paperId", a."userId", a.type, a.anchor, a.text, a.version,
442:           a.color, a."positionIndex", a.metadata,
443:           a."parentId", a."createdAt", a."updatedAt",
444:           json_build_object(
445:             'id', p.id,
446:             'title', p.title
447:           ) as paper,
448:           COALESCE(
449:             (
450:               SELECT json_agg(
451:                 json_build_object(
452:                   'id', child_a.id,
453:                   'text', child_a.text,
454:                   'createdAt', child_a."createdAt",
455:                   'user', json_build_object(
456:                     'id', child_u.id,
457:                     'name', child_u.name,
458:                     'email', child_u.email,
459:                     'image', child_u.image
460:                   )
461:                 ) ORDER BY child_a."createdAt" ASC
462:               )
463:               FROM "Annotation" child_a
464:               LEFT JOIN "User" child_u ON child_a."userId" = child_u.id
465:               WHERE child_a."parentId" = a.id AND child_a."isDeleted" = false
466:             ),
467:             '[]'::json
468:           ) as children
469:         FROM "Annotation" a
470:         LEFT JOIN "Paper" p ON a."paperId" = p.id
471:         WHERE a."userId" = ${userId} AND a."isDeleted" = false
472:         ORDER BY a."createdAt" DESC
473:         LIMIT ${limit} OFFSET ${skip}
474:       `;
475:       const totalResult = await prisma.$queryRaw<[{ count: bigint }]>`
476:         SELECT COUNT(*) as count
477:         FROM "Annotation"
478:         WHERE "userId" = ${userId} AND "isDeleted" = false
479:       `;
480:       const total = Number(totalResult[0]?.count || 0);
481:       return {
482:         annotations,
483:         pagination: {
484:           page,
485:           limit,
486:           total,
487:           totalPage: Math.ceil(total / limit),
488:         },
489:       };
490:     } catch (error) {
491:       console.error("Error fetching user annotations:", error);
492:       throw new ApiError(500, "Failed to fetch user annotations");
493:     }
494:   }
495: }
