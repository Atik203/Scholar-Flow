  86:         workspaceId = w.id;
  87:         await tx.$executeRaw`
  88:           INSERT INTO "WorkspaceMember" (id, "workspaceId", "userId", role, "joinedAt", "createdAt", "updatedAt", "isDeleted")
  89:           VALUES (gen_random_uuid(), ${w.id}, ${ownerId}, 'OWNER', now(), now(), now(), false)
  90:         `;
  91:         // Create default WorkspaceSettings row
  92:         await tx.$executeRaw`
  93:           INSERT INTO "WorkspaceSettings" (id, "workspaceId", color, "createdAt", "updatedAt", "isDeleted")
  94:           VALUES (gen_random_uuid(), ${w.id}, ${color}, now(), now(), false)
  95:           ON CONFLICT ("workspaceId") DO NOTHING
  96:         `;
  97:         await tx.activityLogEntry.create({
  98:           data: {
  99:             userId: ownerId,
 100:             workspaceId: w.id,
 101:             entity: "Workspace",
 102:             entityId: w.id,
 103:             action: "CREATE",
 104:             severity: "INFO",
 105:           },
 106:         });
 107:       });
