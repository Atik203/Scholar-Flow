 21:   const originalFetch = global.fetch;
 22:   beforeEach(() => {
 23:     provider = new TestableGeminiProvider(apiKey, timeoutMs);
 24:     fetchMock = jest.fn() as unknown as jest.MockedFunction<typeof fetch>;
 25:     (global as any).fetch = fetchMock;
 26:   });
 27:   afterEach(() => {
 28:     (global as any).fetch = originalFetch;
 29:     jest.clearAllMocks();
 30:   });
 31:   const buildRequest = (
 32:     overrides: Partial<AiSummaryRequest> = {}
 33:   ): AiSummaryRequest => ({
 34:     paperId: "paper-123",
 35:     text: "Section 1 discusses methodology. Section 2 outlines findings.",
 36:     wordLimit: 200,
 37:     ...overrides,
 38:   });
 39:   it("returns structured summary data when JSON payload is provided", async () => {
 40:     fetchMock.mockResolvedValueOnce(
 41:       new Response(
 42:         JSON.stringify({
 43:           candidates: [
 44:             {
 45:               content: {
 46:                 parts: [
 47:                   {
 48:                     text: '{"summary":"Clear summary","highlights":["Point A"],"followUpQuestions":["Next step?"],"tokensUsed":321}',
 49:                   },
 50:                 ],
 51:               },
 52:             },
 53:           ],
 54:           usageMetadata: { totalTokenCount: 321 },
 55:         }),
 56:         {
 57:           status: 200,
 58:           headers: { "Content-Type": "application/json" },
 59:         }
 60:       )
 61:     );
