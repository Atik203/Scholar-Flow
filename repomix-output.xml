409:                                 {chunk.tokenCount} tokens
410:                               </Badge>
411:                             )}
412:                           </div>
413:                           <div className="text-sm text-muted-foreground leading-relaxed">
414:                             {chunk.content}
415:                           </div>
416:                         </Card>
417:                       ))}
418:                   </div>
419:                 )}
420:               </div>
421:             </CollapsibleContent>
422:           </Collapsible>
423:         )}
424:       </CardContent>
425:     </Card>
426:   );
427: }
