<file path="apps/frontend/src/components/papers/PdfViewerFallback.tsx">
  1: "use client";
  2: import { Button } from "@/components/ui/button";
  3: import { AlertCircle, Download, ExternalLink, RefreshCw } from "lucide-react";
  4: import { useState, useEffect } from "react";
  5: interface PdfViewerFallbackProps {
  6:   fileUrl: string;
  7:   className?: string;
  8:   originalFilename?: string;
  9: }
 10: export function PdfViewerFallback({
 11:   fileUrl,
 12:   className,
 13:   originalFilename = "document.pdf",
 14: }: PdfViewerFallbackProps) {
 15:   const [error, setError] = useState<string | null>(null);
 16:   const [isLoading, setIsLoading] = useState(true);
 17:   const [retryCount, setRetryCount] = useState(0);
 18:   const handleIframeError = () => {
 19:     console.error("PDF iframe failed to load:", fileUrl);
 20:     setError("PDF preview unavailable - browser may not support PDF viewing");
 21:     setIsLoading(false);
 22:   };
 23:   const handleIframeLoad = () => {
 24:     console.log("PDF iframe loaded successfully");
 25:     setIsLoading(false);
 26:     setError(null);
 27:   };
 28:   const handleRetry = () => {
 29:     setRetryCount(prev => prev + 1);
 30:     setError(null);
 31:     setIsLoading(true);
 32:   };
 33:   const handleDownload = () => {
 34:     const link = document.createElement("a");
 35:     link.href = fileUrl;
 36:     link.download = originalFilename;
 37:     link.target = "_blank";
 38:     document.body.appendChild(link);
 39:     link.click();
 40:     document.body.removeChild(link);
 41:   };
 42:   const handleOpenInNewTab = () => {
 43:     window.open(fileUrl, "_blank");
 44:   };
 45:   useEffect(() => {
 46:     setError(null);
 47:     setIsLoading(true);
 48:     setRetryCount(0);
 49:   }, [fileUrl]);
 50:   if (error) {
 51:     return (
 52:       <div
 53:         className={`flex flex-col items-center justify-center h-64 text-center ${className}`}
 54:       >
 55:         <AlertCircle className="h-8 w-8 mb-2 text-muted-foreground" />
 56:         <p className="text-sm text-muted-foreground mb-2">{error}</p>
 57:         <p className="text-xs text-muted-foreground mb-4">
 58:           Try opening in a new tab or downloading the file
 59:         </p>
 60:         <div className="flex gap-2">
 61:           <Button variant="outline" size="sm" onClick={handleRetry}>
 62:             <RefreshCw className="h-4 w-4 mr-2" />
 63:             Retry
 64:           </Button>
 65:           <Button variant="outline" size="sm" onClick={handleOpenInNewTab}>
 66:             <ExternalLink className="h-4 w-4 mr-2" />
 67:             Open in New Tab
 68:           </Button>
 69:           <Button variant="outline" size="sm" onClick={handleDownload}>
 70:             <Download className="h-4 w-4 mr-2" />
 71:             Download
 72:           </Button>
 73:         </div>
 74:       </div>
 75:     );
 76:   }
 77:   return (
 78:     <div className={className}>
 79:       <div className="relative border rounded-lg overflow-hidden">
 80:         {isLoading && (
 81:           <div className="absolute inset-0 bg-background/80 flex items-center justify-center z-10">
 82:             <div className="flex flex-col items-center gap-2">
 83:               <RefreshCw className="h-6 w-6 animate-spin text-muted-foreground" />
 84:               <p className="text-sm text-muted-foreground">Loading PDF...</p>
 85:             </div>
 86:           </div>
 87:         )}
 88:         <iframe
 89:           key={retryCount}
 90:           src={`${fileUrl}#toolbar=0&navpanes=0&scrollbar=0`}
 91:           className="w-full h-96"
 92:           onError={handleIframeError}
 93:           onLoad={handleIframeLoad}
 94:           title="PDF Preview"
 95:           style={{
 96:             border: 'none',
 97:             minHeight: '384px'
 98:           }}
 99:         />
100:         <div className="absolute top-2 right-2 flex gap-2">
101:           <Button
102:             variant="secondary"
103:             size="sm"
104:             onClick={handleOpenInNewTab}
105:             className="opacity-80 hover:opacity-100"
106:             title="Open in new tab"
107:           >
108:             <ExternalLink className="h-3 w-3" />
109:           </Button>
110:           <Button
111:             variant="secondary"
112:             size="sm"
113:             onClick={handleDownload}
114:             className="opacity-80 hover:opacity-100"
115:             title="Download PDF"
116:           >
117:             <Download className="h-3 w-3" />
118:           </Button>
119:         </div>
120:       </div>
121:     </div>
122:   );
123: }
</file>

