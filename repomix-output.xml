    type: "citation" | "reference" | "related";
    index: number;
  }) => {
    const relevance =
      "relevance" in cardPaper
        ? cardPaper.relevance
        : "similarity" in cardPaper
          ? cardPaper.similarity
          : 0;

    return (
      <motion.div
        initial={{ opacity: 0, y: 20 }}
