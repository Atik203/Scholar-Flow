 44: } from "@/components/ui/table";
 45: import { PageHeader } from "@/components/customUI/PageHeader";
 46: import { showErrorToast, showSuccessToast } from "@/components/providers/ToastProvider";
 47: import {
 48:   useCancelSubscriberAtPeriodEndMutation,
 49:   useCancelSubscriberNowMutation,
 50:   useChangeSubscriberPlanMutation,
 51:   useListPlansQuery,
 52:   useListSubscribersQuery,
 53:   useReactivateSubscriberMutation,
 54: } from "@/redux/api/adminExtendedApi";
 55: import { formatCurrency } from "@/lib/utils";
 56: const STATUS_BADGE: Record<string, string> = {
 57:   ACTIVE: "border-emerald-500/40 text-emerald-600 dark:text-emerald-400",
 58:   PAST_DUE: "border-amber-500/40 text-amber-600 dark:text-amber-400",
 59:   CANCELED: "border-rose-500/40 text-rose-600 dark:text-rose-400",
 60:   EXPIRED: "text-muted-foreground",
 61: };
 62: export default function AdminSubscribersPage() {
 63:   const [status, setStatus] = useState<string>("all");
 64:   const [page, setPage] = useState(1);
 65:   const [actionId, setActionId] = useState<string | null>(null);
 66:   const [changePlanTarget, setChangePlanTarget] = useState<{
 67:     id: string;
 68:     name: string;
 69:   } | null>(null);
 70:   const [newPriceId, setNewPriceId] = useState<string>("");
 71:   const { data, isLoading, refetch } = useListSubscribersQuery({
 72:     page,
 73:     limit: 25,
 74:     status: status === "all" ? undefined : status,
 75:   });
 76:   const { data: plansData } = useListPlansQuery();
 77:   const [cancelAtEnd] = useCancelSubscriberAtPeriodEndMutation();
 78:   const [reactivate] = useReactivateSubscriberMutation();
 79:   const [cancelNow] = useCancelSubscriberNowMutation();
 80:   const [changePlan] = useChangeSubscriberPlanMutation();
 81:   const subscribers = data?.data ?? [];
 82:   const total = data?.meta?.total ?? 0;
 83:   const totalPages = data?.meta?.totalPage ?? 1;
 84:   const changeablePlans = (plansData?.data ?? []).filter(
 85:     (p) => p.active && p.stripePriceId
 86:   );
