128:       throw new Error(`Claude extraction response was not valid JSON: ${cleaned.slice(0, 200)}`);
129:     }
130:     const metadata = {
131:       title:
132:         typeof parsed.title === "string" && parsed.title.trim()
133:           ? parsed.title.trim()
