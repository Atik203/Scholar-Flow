<file path="apps/frontend/src/components/customUI/form/SearchInput.tsx">
 1: import { cn } from "@/lib/utils";
 2: import { Search, X } from "lucide-react";
 3: import * as React from "react";
 4: export interface SearchInputProps
 5:   extends Omit<React.ComponentProps<"input">, "onChange"> {
 6:   onSearch?: (value: string) => void;
 7:   onClear?: () => void;
 8:   placeholder?: string;
 9:   className?: string;
10:   showClearButton?: boolean;
11:   loading?: boolean;
12: }
13: export const SearchInput = React.forwardRef<HTMLInputElement, SearchInputProps>(
14:   (
15:     {
16:       className,
17:       onSearch,
18:       onClear,
19:       placeholder = "Search...",
20:       showClearButton = true,
21:       loading = false,
22:       ...props
23:     },
24:     ref
25:   ) => {
26:     const [value, setValue] = React.useState("");
27:     const [isFocused, setIsFocused] = React.useState(false);
28:     const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
29:       const newValue = e.target.value;
30:       setValue(newValue);
31:       onSearch?.(newValue);
32:     };
33:     const handleClear = () => {
34:       setValue("");
35:       onClear?.();
36:       onSearch?.("");
37:     };
38:     const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
39:       if (e.key === "Enter") {
40:         onSearch?.(value);
41:       }
42:     };
43:     return (
44:       <div className={cn("relative", className)}>
45:         <div className="relative">
46:           <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
47:           <input
48:             ref={ref}
49:             type="text"
50:             value={value}
51:             onChange={handleChange}
52:             onKeyDown={handleKeyDown}
53:             onFocus={() => setIsFocused(true)}
54:             onBlur={() => setIsFocused(false)}
55:             placeholder={placeholder}
56:             className={cn(
57:               "w-full pl-10 pr-10 h-10 rounded-md border bg-background text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50",
58:               isFocused && "ring-2 ring-ring ring-offset-2",
59:               className
60:             )}
61:             {...props}
62:           />
63:           {showClearButton && value && (
