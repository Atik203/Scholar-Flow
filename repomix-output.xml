 20: }
 21: async function assertPaperAccess(paperId: string, userId: string): Promise<void> {
 22:   const access = await prisma.$queryRaw<Array<{ allowed: boolean }>>`
 23:     SELECT EXISTS (
 24:       SELECT 1
 25:       FROM "Paper" p
 26:       LEFT JOIN "Workspace" w
 27:         ON w.id = p."workspaceId" AND w."isDeleted" = false
 28:       LEFT JOIN "WorkspaceMember" m
 29:         ON m."workspaceId" = p."workspaceId"
 30:         AND m."userId" = ${userId}
 31:         AND m."isDeleted" = false
 32:       WHERE p.id = ${paperId}
 33:         AND p."isDeleted" = false
 34:         AND (
 35:           p."uploaderId" = ${userId}
 36:           OR w."ownerId" = ${userId}
 37:           OR m.id IS NOT NULL
 38:         )
 39:     ) AS "allowed"
 40:   `;
 41:   if (access[0]?.allowed !== true) {
 42:     throw new ApiError(403, "You do not have access to this paper");
 43:   }
 44: }
 45: export const citationInsertService = {
 46:   async insertCitation(userId: string, input: InsertCitationInput) {
 47:     await assertPaperAccess(input.sourcePaperId, userId);
 48:     await assertPaperAccess(input.targetPaperId, userId);
 49:     const existing = await prisma.citation.findFirst({
 50:       where: {
 51:         sourcePaperId: input.sourcePaperId,
 52:         targetPaperId: input.targetPaperId,
 53:         context: input.context ?? null,
 54:         isDeleted: false,
 55:       },
 56:     });
 57:     if (existing) return existing;
 58:     return prisma.citation.create({
 59:       data: {
 60:         sourcePaperId: input.sourcePaperId,
 61:         targetPaperId: input.targetPaperId,
 62:         context: input.context,
 63:         location: input.location,
 64:       },
 65:       include: {
 66:         targetPaper: {
 67:           select: { id: true, title: true, metadata: true, doi: true },
 68:         },
 69:       },
 70:     });
 71:   },
 72:   async listCitationsForPaper(
 73:     userId: string,
 74:     sourcePaperId: string
 75:   ): Promise<CitationWithTarget[]> {
 76:     await assertPaperAccess(sourcePaperId, userId);
 77:     return prisma.citation.findMany({
 78:       where: { sourcePaperId, isDeleted: false },
 79:       orderBy: { createdAt: "asc" },
 80:       select: {
 81:         id: true,
 82:         context: true,
 83:         location: true,
 84:         createdAt: true,
 85:         targetPaper: {
 86:           select: { id: true, title: true, metadata: true, doi: true },
 87:         },
 88:       },
 89:     });
 90:   },
 91:   async deleteCitation(userId: string, id: string) {
 92:     const citation = await prisma.citation.findFirst({
 93:       where: { id, isDeleted: false },
 94:       select: { id: true, sourcePaperId: true },
 95:     });
 96:     if (!citation) {
 97:       throw new ApiError(404, "Citation not found");
 98:     }
 99:     await assertPaperAccess(citation.sourcePaperId, userId);
100:     return prisma.citation.update({
101:       where: { id },
102:       data: { isDeleted: true },
103:     });
104:   },
105: };
