304: /**
305:  * Get comprehensive user analytics including papers, collections, storage, and tokens
306:  */
307: const getUserAnalytics = async (user: IAuthUser) => {
308:   try {
309:     // Verify user exists
310:     const existingUsers = await prisma.$queryRaw<any[]>`
311:       SELECT id, email, role, "stripeSubscriptionId", "stripePriceId", "isDeleted"
312:       FROM "User"
313:       WHERE id = ${user.id} AND "isDeleted" = false
314:       LIMIT 1
315:     `;
316:     if (existingUsers.length === 0) {
317:       throw new ApiError(404, "User not found or account deleted");
318:     }
319:     const userData = existingUsers[0];
320:     // Determine user plan (Free or Pro based on Stripe subscription)
321:     const plan = userData.stripeSubscriptionId ? "PRO" : "FREE";
322:     // Get papers count and storage used
323:     const paperStats = await prisma.$queryRaw<any[]>`
324:       SELECT
325:         COUNT(DISTINCT p.id)::INTEGER as "totalPapers",
326:         COALESCE(SUM(pf."sizeBytes"), 0)::BIGINT as "totalStorage"
327:       FROM "Paper" p
328:       LEFT JOIN "PaperFile" pf ON p.id = pf."paperId" AND pf."isDeleted" = false
329:       WHERE p."uploaderId" = ${user.id} AND p."isDeleted" = false
330:     `;
331:     // Get collections count
332:     const collectionStats = await prisma.$queryRaw<any[]>`
333:       SELECT COUNT(*)::INTEGER as "totalCollections"
334:       FROM "Collection"
335:       WHERE "ownerId" = ${user.id} AND "isDeleted" = false
336:     `;
337:     // Get AI tokens usage (from UsageEvent)
338:     // Sum units for AI-related events (ai_summarize, semantic_search, etc.)
339:     const tokenStats = await prisma.$queryRaw<any[]>`
340:       SELECT
341:         COALESCE(SUM("units"), 0)::INTEGER as "totalTokensUsed"
342:       FROM "UsageEvent"
343:       WHERE "userId" = ${user.id}
344:         AND "isDeleted" = false
345:         AND ("kind" LIKE 'ai_%' OR "kind" = 'semantic_search')
346:     `;
347:     // Get papers uploaded over time (last 30 days for chart)
348:     const papersOverTime = await prisma.$queryRaw<any[]>`
349:       SELECT
350:         DATE("createdAt") as date,
351:         COUNT(*)::INTEGER as count
352:       FROM "Paper"
353:       WHERE "uploaderId" = ${user.id}
354:         AND "isDeleted" = false
355:         AND "createdAt" >= NOW() - INTERVAL '30 days'
356:       GROUP BY DATE("createdAt")
357:       ORDER BY date ASC
358:     `;
359:     // Get collections created over time (last 30 days)
360:     const collectionsOverTime = await prisma.$queryRaw<any[]>`
361:       SELECT
362:         DATE("createdAt") as date,
363:         COUNT(*)::INTEGER as count
364:       FROM "Collection"
365:       WHERE "ownerId" = ${user.id}
366:         AND "isDeleted" = false
367:         AND "createdAt" >= NOW() - INTERVAL '30 days'
368:       GROUP BY DATE("createdAt")
369:       ORDER BY date ASC
370:     `;
371:     // Get storage usage by month (last 6 months)
372:     const storageOverTime = await prisma.$queryRaw<any[]>`
373:       SELECT
374:         DATE_TRUNC('month', p."createdAt") as month,
375:         COALESCE(SUM(pf."sizeBytes"), 0)::BIGINT as "totalSize"
376:       FROM "Paper" p
377:       LEFT JOIN "PaperFile" pf ON p.id = pf."paperId" AND pf."isDeleted" = false
378:       WHERE p."uploaderId" = ${user.id}
379:         AND p."isDeleted" = false
380:         AND p."createdAt" >= NOW() - INTERVAL '6 months'
381:       GROUP BY DATE_TRUNC('month', p."createdAt")
382:       ORDER BY month ASC
383:     `;
384:     // Get papers by processing status
385:     const papersByStatus = await prisma.$queryRaw<any[]>`
386:       SELECT
387:         "processingStatus",
388:         COUNT(*)::INTEGER as count
389:       FROM "Paper"
390:       WHERE "uploaderId" = ${user.id} AND "isDeleted" = false
391:       GROUP BY "processingStatus"
392:     `;
393:     // Convert storage from bytes to MB for easier reading
394:     const totalStorageMB =
395:       Number(paperStats[0]?.totalStorage || 0) / (1024 * 1024);
396:     // Plan limits
397:     const planLimits = {
398:       FREE: {
399:         maxPapers: 50,
400:         maxStorage: 1024, // 1GB in MB
401:         maxTokens: 10000,
402:         maxCollections: 10,
403:       },
404:       PRO: {
405:         maxPapers: -1, // Unlimited
406:         maxStorage: 51200, // 50GB in MB
407:         maxTokens: 1000000,
408:         maxCollections: -1, // Unlimited
409:       },
410:     };
411:     const limits = planLimits[plan as keyof typeof planLimits];
412:     return {
413:       plan,
414:       limits,
415:       usage: {
416:         papers: {
417:           total: Number(paperStats[0]?.totalPapers || 0),
418:           limit: limits.maxPapers,
419:           percentage:
420:             limits.maxPapers === -1
421:               ? 0
422:               : (Number(paperStats[0]?.totalPapers || 0) / limits.maxPapers) *
423:                 100,
424:         },
425:         collections: {
426:           total: Number(collectionStats[0]?.totalCollections || 0),
427:           limit: limits.maxCollections,
428:           percentage:
429:             limits.maxCollections === -1
430:               ? 0
431:               : (Number(collectionStats[0]?.totalCollections || 0) /
432:                   limits.maxCollections) *
433:                 100,
434:         },
435:         storage: {
436:           used: totalStorageMB,
437:           limit: limits.maxStorage,
438:           percentage: (totalStorageMB / limits.maxStorage) * 100,
439:           unit: "MB",
440:         },
441:         tokens: {
442:           used: Number(tokenStats[0]?.totalTokensUsed || 0),
443:           limit: limits.maxTokens,
444:           percentage:
445:             (Number(tokenStats[0]?.totalTokensUsed || 0) / limits.maxTokens) *
446:             100,
447:         },
448:       },
449:       charts: {
450:         papersOverTime: papersOverTime.map((row) => ({
451:           date: row.date,
452:           count: Number(row.count),
453:         })),
454:         collectionsOverTime: collectionsOverTime.map((row) => ({
455:           date: row.date,
456:           count: Number(row.count),
457:         })),
458:         storageOverTime: storageOverTime.map((row) => ({
459:           month: row.month,
460:           size: Number(row.totalSize) / (1024 * 1024), // Convert to MB
461:         })),
462:         papersByStatus: papersByStatus.map((row) => ({
463:           status: row.processingStatus,
464:           count: Number(row.count),
465:         })),
466:       },
467:     };
468:   } catch (error) {
469:     console.error("Error fetching user analytics:", error);
470:     if (error instanceof ApiError) {
471:       throw error;
472:     }
473:     throw new ApiError(500, "Failed to fetch user analytics");
474:   }
475: };
