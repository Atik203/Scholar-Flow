1058:              inviter."firstName", inviter."lastName"
1059:       FROM "WorkspaceInvitation" wi
1060:       JOIN "Workspace" w ON w.id = wi."workspaceId"
1061:       JOIN "User" inviter ON inviter.id = wi."invitedById"
1062:       WHERE wi.id = ${invitationId} AND wi."isDeleted" = false AND wi.status = 'PENDING'
