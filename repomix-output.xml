<file path="apps/frontend/src/components/navigation/PrefetchLink.tsx">
  1: "use client";
  2: import Link from "next/link";
  3: import { useRouter } from "next/navigation";
  4: import {
  5:   AnchorHTMLAttributes,
  6:   forwardRef,
  7:   useCallback,
  8:   useEffect,
  9:   useRef,
 10:   useState,
 11: } from "react";
 12: interface PrefetchLinkProps
 13:   extends Omit<AnchorHTMLAttributes<HTMLAnchorElement>, "href"> {
 14:   href: string;
 15:   prefetch?: boolean;
 16:   prefetchOnHover?: boolean;
 17:   prefetchOnVisible?: boolean;
 18:   children: React.ReactNode;
 19: }
 20: export const PrefetchLink = forwardRef<HTMLAnchorElement, PrefetchLinkProps>(
 21:   (
 22:     {
 23:       href,
 24:       prefetch = true,
 25:       prefetchOnHover = true,
 26:       prefetchOnVisible = false,
 27:       children,
 28:       ...props
 29:     },
 30:     ref
 31:   ) => {
 32:     const router = useRouter();
 33:     const [isPrefetched, setIsPrefetched] = useState(false);
 34:     const linkRef = useRef<HTMLAnchorElement>(null);
 35:     const prefetchTimerRef = useRef<NodeJS.Timeout | undefined>(undefined);
 36:     const doPrefetch = useCallback(() => {
 37:       if (!isPrefetched && href) {
 38:         router.prefetch(href);
 39:         setIsPrefetched(true);
 40:       }
 41:     }, [href, isPrefetched, router]);
 42:     const handleMouseEnter = useCallback(() => {
 43:       if (prefetchOnHover && !isPrefetched) {
 44:         prefetchTimerRef.current = setTimeout(() => {
 45:           doPrefetch();
 46:         }, 100);
 47:       }
 48:     }, [prefetchOnHover, isPrefetched, doPrefetch]);
 49:     const handleMouseLeave = useCallback(() => {
 50:       if (prefetchTimerRef.current) {
 51:         clearTimeout(prefetchTimerRef.current);
 52:       }
 53:     }, []);
 54:     const handleTouchStart = useCallback(() => {
 55:       if (prefetchOnHover && !isPrefetched) {
 56:         doPrefetch();
 57:       }
 58:     }, [prefetchOnHover, isPrefetched, doPrefetch]);
 59:     useEffect(() => {
 60:       if (!prefetchOnVisible || isPrefetched) return;
 61:       const element = linkRef.current;
 62:       if (!element) return;
 63:       const observer = new IntersectionObserver(
 64:         (entries) => {
 65:           entries.forEach((entry) => {
 66:             if (entry.isIntersecting) {
 67:               doPrefetch();
 68:               observer.disconnect();
 69:             }
 70:           });
 71:         },
 72:         {
 73:           rootMargin: "50px",
 74:         }
 75:       );
 76:       observer.observe(element);
 77:       return () => {
 78:         observer.disconnect();
 79:       };
 80:     }, [prefetchOnVisible, isPrefetched, doPrefetch]);
 81:     useEffect(() => {
 82:       return () => {
 83:         if (prefetchTimerRef.current) {
 84:           clearTimeout(prefetchTimerRef.current);
 85:         }
 86:       };
 87:     }, []);
 88:     return (
 89:       <Link
 90:         ref={(node) => {
 91:           if (typeof ref === "function") {
 92:             ref(node);
 93:           } else if (ref) {
 94:             ref.current = node;
 95:           }
 96:           (linkRef as any).current = node;
 97:         }}
 98:         href={href}
 99:         prefetch={prefetch}
100:         onMouseEnter={handleMouseEnter}
101:         onMouseLeave={handleMouseLeave}
102:         onTouchStart={handleTouchStart}
103:         {...props}
104:       >
105:         {children}
106:       </Link>
107:     );
108:   }
109: );
110: PrefetchLink.displayName = "PrefetchLink";
111: export function usePrefetch() {
112:   const router = useRouter();
113:   const prefetchedRoutes = useRef<Set<string>>(new Set());
114:   const prefetch = useCallback(
115:     (href: string) => {
116:       if (!prefetchedRoutes.current.has(href)) {
117:         router.prefetch(href);
118:         prefetchedRoutes.current.add(href);
119:       }
120:     },
121:     [router]
122:   );
123:   const prefetchMultiple = useCallback(
124:     (hrefs: string[]) => {
125:       hrefs.forEach((href) => prefetch(href));
126:     },
127:     [prefetch]
128:   );
129:   return { prefetch, prefetchMultiple };
130: }
131: export function useSmartPrefetch(routes: string[], delay: number = 2000) {
132:   const { prefetchMultiple } = usePrefetch();
133:   const [hasInteracted, setHasInteracted] = useState(false);
134:   useEffect(() => {
135:     const handleInteraction = () => {
136:       setHasInteracted(true);
137:     };
138:     window.addEventListener("mousemove", handleInteraction, { once: true });
139:     window.addEventListener("touchstart", handleInteraction, { once: true });
140:     window.addEventListener("scroll", handleInteraction, { once: true });
141:     return () => {
142:       window.removeEventListener("mousemove", handleInteraction);
143:       window.removeEventListener("touchstart", handleInteraction);
144:       window.removeEventListener("scroll", handleInteraction);
145:     };
146:   }, []);
147:   useEffect(() => {
148:     if (!hasInteracted) return;
149:     const timer = setTimeout(() => {
150:       prefetchMultiple(routes);
151:     }, delay);
152:     return () => clearTimeout(timer);
153:   }, [hasInteracted, routes, delay, prefetchMultiple]);
154: }
155: export function usePrefetchNavigation(currentPath: string) {
156:   const { prefetchMultiple } = usePrefetch();
157:   useEffect(() => {
158:     const getLikelyRoutes = (path: string): string[] => {
159:       if (path.includes("/dashboard")) {
160:         return [
161:           "/dashboard/papers",
162:           "/dashboard/collections",
163:           "/dashboard/papers/upload",
164:         ];
165:       }
166:       if (path.includes("/papers")) {
167:         return ["/dashboard/papers/search", "/dashboard/collections"];
168:       }
169:       if (path === "/") {
170:         return ["/login", "/register", "/features"];
171:       }
172:       return [];
173:     };
174:     const routes = getLikelyRoutes(currentPath);
175:     if (routes.length > 0) {
176:       const timer = setTimeout(() => {
177:         prefetchMultiple(routes);
178:       }, 1000);
179:       return () => clearTimeout(timer);
180:     }
181:   }, [currentPath, prefetchMultiple]);
182: }
</file>

