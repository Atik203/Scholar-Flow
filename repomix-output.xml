229: function ThemeToggle() {
230:   const [theme, setTheme] = useState<"light" | "dark">("light");
231:   const toggleTheme = () => {
232:     const newTheme = theme === "dark" ? "light" : "dark";
233:     setTheme(newTheme);
234:     if (newTheme === "dark") {
235:       document.documentElement.classList.add("dark");
236:     } else {
237:       document.documentElement.classList.remove("dark");
238:     }
239:   };
240:   return (
241:     <Button variant="ghost" size="icon" onClick={toggleTheme}>
242:       {theme === "dark" ? (
243:         <Sun className="h-4 w-4" />
244:       ) : (
245:         <Moon className="h-4 w-4" />
246:       )}
247:       <span className="sr-only">Toggle theme</span>
248:     </Button>
249:   );
250: }
251: function Breadcrumbs({ currentPath }: { currentPath?: string }) {
252:   if (!currentPath) return null;
253:   const segments = currentPath.split("/").filter(Boolean);
254:   const breadcrumbs = segments.map((segment, index) => {
255:     const href = "/" + segments.slice(0, index + 1).join("/");
256:     const label = segment
257:       .split("-")
258:       .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
259:       .join(" ");
260:     return { label, href };
261:   });
262:   return (
263:     <nav className="flex items-center gap-1 text-sm">
264:       {breadcrumbs.map((crumb, index) => (
265:         <span key={crumb.href} className="flex items-center gap-1">
266:           {index > 0 && (
267:             <ChevronRight className="h-4 w-4 text-muted-foreground" />
268:           )}
269:           {index === breadcrumbs.length - 1 ? (
270:             <span className="font-medium">{crumb.label}</span>
271:           ) : (
272:             <span className="text-muted-foreground hover:text-foreground cursor-pointer">
273:               {crumb.label}
274:             </span>
275:           )}
276:         </span>
277:       ))}
278:     </nav>
279:   );
280: }
