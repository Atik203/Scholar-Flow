1101:         VALUES (gen_random_uuid(), ${inv[0].workspaceId}, ${userId}, ${inv[0].role}, now(), now(), now(), false)
1102:         ON CONFLICT ("workspaceId", "userId") DO UPDATE SET role = ${inv[0].role}, "isDeleted" = false, "joinedAt" = now()
1103:       `;
1104:       await tx.activityLogEntry.create({
