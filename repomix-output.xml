122:                 variant="ghost"
123:                 size="sm"
124:                 onClick={onClose}
125:                 className="ml-4"
126:                 aria-label="Close modal"
127:               >
128:                 <X className="h-4 w-4" />
129:               </Button>
130:             )}
131:           </div>
132:         )}
133:         {}
134:         <div className="p-6 overflow-y-auto">{children}</div>
135:       </div>
136:     </div>
137:   );
138: };
