172:   createReply: catchAsync(async (req: Request, res: Response) => {
173:     const authReq = req as AuthRequest;
174:     const userId = authReq.user?.id;
175:     if (!userId) {
176:       res.status(401).json({
177:         success: false,
178:         message: "Authentication required",
179:       });
180:       return;
181:     }
182:     const { id } = req.params;
183:     const parsed = createAnnotationReplySchema.safeParse(req.body);
184:     if (!parsed.success) {
185:       res.status(400).json({
186:         success: false,
187:         message: "Invalid reply data",
188:         errors: parsed.error.issues,
189:       });
190:       return;
191:     }
192:     try {
193:       const reply = await AnnotationService.createAnnotationReply(
194:         id,
195:         userId,
196:         parsed.data
197:       );
198:       sendSuccessResponse(res, reply, "Reply created successfully");
199:     } catch (error: any) {
200:       res.status(400).json({
201:         success: false,
202:         message: error.message,
203:       });
204:     }
205:   }),
206:   getVersions: catchAsync(async (req: Request, res: Response) => {
207:     const { id } = req.params;
208:     try {
209:       const versions = await AnnotationService.getAnnotationVersions(id);
210:       sendSuccessResponse(
211:         res,
212:         versions,
213:         "Annotation versions retrieved successfully"
214:       );
215:     } catch (error: any) {
216:       res.status(400).json({
217:         success: false,
218:         message: error.message,
219:       });
220:     }
221:   }),
222:   getUserAnnotations: catchAsync(async (req: Request, res: Response) => {
223:     const authReq = req as AuthRequest;
224:     const userId = authReq.user?.id;
225:     if (!userId) {
226:       res.status(401).json({
227:         success: false,
228:         message: "Authentication required",
229:       });
230:       return;
