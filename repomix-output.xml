        SELECT COUNT(*)::bigint as count
        FROM "User"
        WHERE "isDeleted" = ${!activeStatus}
          AND role = ${role}::"Role"
          AND (name ILIKE ${`%${searchQuery}%`} OR email ILIKE ${`%${searchQuery}%`})
      `;

      users = await prisma.$queryRaw`
