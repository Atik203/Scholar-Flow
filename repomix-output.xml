 55: export const getPublicCatalog = async (): Promise<{
 56:   free: CatalogPlan;
 57:   pro: { monthly: CatalogPlan | null; annual: CatalogPlan | null };
 58:   team: { monthly: CatalogPlan | null; annual: CatalogPlan | null };
 59: }> => {
 60:   const plans = await prismaClient.$queryRaw<
 61:     Array<{
 62:       code: string;
 63:       name: string;
