 122:     const { input, file, uploaderId, workspaceId, objectKey } = args;
 123:     console.log("Creating uploaded paper with authors:", input.authors);
 124:     try {
 125:       const createStart = Date.now();
 126:       const metadata = {
 127:         authors: input.authors || [],
 128:         year: input.year,
 129:         source: input.source || "upload",
 130:       };
 131:       const createdRows = await prisma.$queryRaw<
 132:         Array<{
 133:           id: string;
 134:           workspaceId: string;
 135:           uploaderId: string;
 136:           title: string;
 137:           abstract: string | null;
 138:           metadata: unknown;
 139:           source: string | null;
 140:           doi: string | null;
 141:           processingStatus: string;
 142:           createdAt: Date;
 143:           updatedAt: Date;
 144:           previewFileKey: string | null;
 145:           previewMimeType: string | null;
 146:           originalMimeType: string | null;
 147:           file_id: string | null;
 148:           storageProvider: string | null;
 149:           objectKey: string | null;
 150:           contentType: string | null;
 151:           sizeBytes: number | null;
 152:           originalFilename: string | null;
 153:           extractedAt: Date | null;
 154:         }>
 155:       >`
 156:       WITH inserted_paper AS (
 157:         INSERT INTO "Paper" (
 158:           id, "workspaceId", "uploaderId", title, metadata, source,
 159:           "processingStatus", "createdAt", "updatedAt", "isDeleted"
 160:         ) VALUES (
 161:           gen_random_uuid(),
 162:           ${workspaceId},
 163:           ${uploaderId},
 164:           ${input.title || file.originalname},
 165:           ${JSON.stringify(metadata)}::jsonb,
 166:           ${input.source || "upload"},
 167:           'UPLOADED'::"PaperProcessingStatus",
 168:           NOW(),
 169:           NOW(),
 170:           false
 171:         )
 172:         RETURNING
 173:           id,
 174:           "workspaceId",
 175:           "uploaderId",
 176:           title,
 177:           abstract,
 178:           metadata,
 179:           source,
 180:           doi,
 181:           "processingStatus",
 182:           "createdAt",
 183:           "updatedAt",
 184:           "previewFileKey",
 185:           "previewMimeType",
 186:           "originalMimeType"
 187:       ),
 188:       inserted_file AS (
 189:         INSERT INTO "PaperFile" (
 190:           id,
 191:           "paperId",
 192:           "storageProvider",
 193:           "objectKey",
 194:           "contentType",
 195:           "sizeBytes",
 196:           "originalFilename",
 197:           "createdAt",
 198:           "updatedAt",
 199:           "isDeleted"
 200:         )
 201:         SELECT
 202:           gen_random_uuid(),
 203:           p.id,
 204:           's3',
 205:           ${objectKey},
 206:           ${file.mimetype},
 207:           ${file.size},
 208:           ${file.originalname},
 209:           NOW(),
 210:           NOW(),
 211:           false
 212:         FROM inserted_paper p
 213:         RETURNING
 214:           id,
 215:           "paperId",
 216:           "storageProvider",
 217:           "objectKey",
 218:           "contentType",
 219:           "sizeBytes",
 220:           "originalFilename",
 221:           "extractedAt"
 222:       )
 223:       SELECT
 224:         p.id,
 225:         p."workspaceId",
 226:         p."uploaderId",
 227:         p.title,
 228:         p.abstract,
 229:         p.metadata,
 230:         p.source,
 231:         p.doi,
 232:         p."processingStatus",
 233:         p."createdAt",
 234:         p."updatedAt",
 235:         p."previewFileKey",
 236:         p."previewMimeType",
 237:         p."originalMimeType",
