 17: export function CommentForm({
 18:   paperId,
 19:   parentId,
 20:   onSuccess,
 21:   onCancel,
 22:   placeholder = "Write your comment...",
 23:   className = "",
 24: }: CommentFormProps) {
 25:   const [text, setText] = useState("");
 26:   const [isSubmitting, setIsSubmitting] = useState(false);
