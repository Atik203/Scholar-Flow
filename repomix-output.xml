351:   /**
352:    * Extract text from PDF with tiered extraction:
353:    *   poppler (native C) → OCR (tesseract) → unpdf (JS) → pdf-parse (legacy)
354:    */
355:   private async extractFromPDF(
356:     buffer: Buffer,
357:     options: DocumentProcessingOptions
358:   ): Promise<DocumentExtractionResult> {
359:     try {
360:       console.log(`[DocumentExtraction] Starting tiered PDF extraction`);
361:       const result = await extractPdfText(buffer);
362:       if (!result.success || !result.text || result.text.trim().length === 0) {
363:         return {
364:           success: false,
365:           error: result.error || "No text content found in PDF",
366:         };
367:       }
368:       console.log(
369:         `[DocumentExtraction] PDF extraction via ${result.method}. Text length: ${result.text.length}`
370:       );
371:       let pageCount = result.pageCount;
372:       if (!pageCount) {
373:         try {
374:           const pdfData = await pdf(buffer, { max: 0, version: "v1.10.100" });
375:           pageCount = pdfData.numpages;
376:         } catch {
377:           pageCount = 1;
378:         }
379:       }
380:       const sanitizedText = this.sanitizeText(result.text);
381:       const chunks = this.createStructuredChunks(
382:         sanitizedText,
383:         pageCount,
384:         options.chunkSize || 2000
385:       );
386:       return {
387:         success: true,
388:         text: sanitizedText,
389:         pageCount,
