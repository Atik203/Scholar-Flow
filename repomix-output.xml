 17: export interface CommandPaletteProps {
 18:   isOpen: boolean;
 19:   onClose: () => void;
 20:   items: CommandItem[];
 21:   placeholder?: string;
 22:   className?: string;
 23: }
 24: export const CommandPalette: React.FC<CommandPaletteProps> = ({
 25:   isOpen,
 26:   onClose,
 27:   items,
 28:   placeholder = "Search commands, files, and more...",
 29:   className,
 30: }) => {
 31:   const [searchQuery, setSearchQuery] = React.useState("");
 32:   const [selectedIndex, setSelectedIndex] = React.useState(0);
 33:   const [recentSearches, setRecentSearches] = React.useState<string[]>([]);
 34:   const inputRef = React.useRef<HTMLInputElement>(null);
 35:   const listRef = React.useRef<HTMLDivElement>(null);
 36:   // Filter items based on search query
 37:   const filteredItems = React.useMemo(() => {
 38:     if (!searchQuery.trim()) {
 39:       return items;
 40:     }
 41:     const query = searchQuery.toLowerCase();
 42:     return items.filter((item) => {
 43:       const searchableText = [
 44:         item.title.toLowerCase(),
 45:         item.description?.toLowerCase(),
 46:         ...(item.keywords?.map((k) => k.toLowerCase()) || []),
 47:       ].join(" ");
 48:       return searchableText.includes(query);
 49:     });
 50:   }, [items, searchQuery]);
 51:   // Group items by category
 52:   const groupedItems = React.useMemo(() => {
 53:     const groups: Record<string, CommandItem[]> = {};
 54:     filteredItems.forEach((item) => {
 55:       const category = item.category || "General";
 56:       if (!groups[category]) {
 57:         groups[category] = [];
 58:       }
 59:       groups[category].push(item);
 60:     });
 61:     return groups;
 62:   }, [filteredItems]);
 63:   const handleKeyDown = React.useCallback(
 64:     (e: KeyboardEvent) => {
 65:       if (!isOpen) return;
 66:       switch (e.key) {
 67:         case "ArrowDown":
 68:           e.preventDefault();
 69:           setSelectedIndex((prev) =>
 70:             prev < filteredItems.length - 1 ? prev + 1 : 0
 71:           );
 72:           break;
 73:         case "ArrowUp":
 74:           e.preventDefault();
 75:           setSelectedIndex((prev) =>
 76:             prev > 0 ? prev - 1 : filteredItems.length - 1
 77:           );
 78:           break;
 79:         case "Enter":
 80:           e.preventDefault();
 81:           if (filteredItems[selectedIndex]) {
 82:             filteredItems[selectedIndex].action();
 83:             onClose();
 84:           }
 85:           break;
 86:         case "Escape":
 87:           e.preventDefault();
 88:           onClose();
 89:           break;
 90:       }
 91:     },
 92:     [isOpen, filteredItems, selectedIndex, onClose]
 93:   );
 94:   const handleSearch = (query: string) => {
 95:     setSearchQuery(query);
 96:     setSelectedIndex(0);
 97:     if (query.trim() && !recentSearches.includes(query)) {
 98:       setRecentSearches((prev) => [query, ...prev.slice(0, 4)]);
 99:     }
100:   };
101:   const handleItemSelect = (item: CommandItem) => {
102:     item.action();
103:     onClose();
104:     setSearchQuery("");
105:   };
106:   // Reset selection when search changes
107:   React.useEffect(() => {
108:     setSelectedIndex(0);
109:   }, [searchQuery]);
110:   // Focus input when opened
111:   React.useEffect(() => {
112:     if (isOpen) {
113:       inputRef.current?.focus();
114:       setSearchQuery("");
115:       setSelectedIndex(0);
116:     }
117:   }, [isOpen]);
118:   // Add keyboard event listeners
119:   React.useEffect(() => {
120:     document.addEventListener("keydown", handleKeyDown);
121:     return () => document.removeEventListener("keydown", handleKeyDown);
122:   }, [handleKeyDown]);
123:   React.useEffect(() => {
124:     if (listRef.current && selectedIndex >= 0) {
125:       const selectedElement = listRef.current.children[
126:         selectedIndex
127:       ] as HTMLElement;
128:       if (selectedElement) {
129:         selectedElement.scrollIntoView({ block: "nearest" });
130:       }
131:     }
132:   }, [selectedIndex]);
133:   if (!isOpen) return null;
134:   return (
135:     <div className="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm">
136:       <div className="flex items-start justify-center pt-[20vh] p-4">
137:         <div
138:           className={cn(
139:             "w-full max-w-2xl bg-background rounded-lg shadow-2xl border",
140:             className
141:           )}
142:         >
143:           {}
144:           <div className="flex items-center gap-3 p-4 border-b">
145:             <Search className="h-5 w-5 text-muted-foreground" />
146:             <Input
147:               ref={inputRef}
148:               placeholder={placeholder}
149:               value={searchQuery}
150:               onChange={(e) => handleSearch(e.target.value)}
151:               className="border-0 shadow-none focus-visible:ring-0 text-lg"
152:             />
153:             <div className="flex items-center gap-1">
154:               <Badge variant="secondary" className="text-xs">
155:                 <Command className="h-3 w-3 mr-1" />K
156:               </Badge>
157:             </div>
158:           </div>
159:           {}
160:           <div className="max-h-96 overflow-y-auto">
161:             {searchQuery ? (
162:               <div ref={listRef}>
163:                 {Object.entries(groupedItems).map(
164:                   ([category, categoryItems]) => (
165:                     <div key={category}>
166:                       <div className="px-4 py-2 text-xs font-medium text-muted-foreground bg-muted/50">
167:                         {category}
168:                       </div>
169:                       {categoryItems.map((item, index) => {
170:                         const globalIndex = filteredItems.indexOf(item);
171:                         const isSelected = globalIndex === selectedIndex;
172:                         return (
173:                           <div
174:                             key={item.id}
175:                             className={cn(
176:                               "flex items-center gap-3 px-4 py-3 cursor-pointer transition-colors",
177:                               isSelected && "bg-accent"
178:                             )}
179:                             onClick={() => handleItemSelect(item)}
180:                           >
181:                             {item.icon && (
182:                               <item.icon className="h-4 w-4 text-muted-foreground" />
183:                             )}
184:                             <div className="flex-1 min-w-0">
185:                               <div className="font-medium">{item.title}</div>
186:                               {item.description && (
187:                                 <div className="text-sm text-muted-foreground truncate">
188:                                   {item.description}
189:                                 </div>
190:                               )}
191:                             </div>
192:                             {item.shortcut && (
193:                               <div className="flex items-center gap-1">
194:                                 {item.shortcut.map((key, i) => (
195:                                   <React.Fragment key={key}>
196:                                     <Badge
197:                                       variant="outline"
198:                                       className="text-xs px-1 py-0"
199:                                     >
200:                                       {key}
201:                                     </Badge>
202:                                     {i < item.shortcut!.length - 1 && (
203:                                       <span className="text-muted-foreground">
204:                                         +
205:                                       </span>
206:                                     )}
207:                                   </React.Fragment>
208:                                 ))}
209:                               </div>
210:                             )}
211:                           </div>
212:                         );
213:                       })}
214:                     </div>
215:                   )
216:                 )}
217:               </div>
218:             ) : (
219:               <div className="p-4 space-y-4">
220:                 {recentSearches.length > 0 && (
221:                   <div>
222:                     <h3 className="text-sm font-medium text-muted-foreground mb-2">
223:                       Recent Searches
224:                     </h3>
225:                     <div className="space-y-1">
226:                       {recentSearches.map((search, index) => (
227:                         <div
228:                           key={index}
229:                           className="flex items-center gap-2 px-3 py-2 rounded-md hover:bg-accent cursor-pointer"
230:                           onClick={() => handleSearch(search)}
231:                         >
232:                           <Search className="h-4 w-4 text-muted-foreground" />
233:                           <span className="text-sm">{search}</span>
234:                         </div>
235:                       ))}
236:                     </div>
237:                   </div>
238:                 )}
239:                 <div>
240:                   <h3 className="text-sm font-medium text-muted-foreground mb-2">
241:                     Quick Actions
242:                   </h3>
243:                   <div className="grid grid-cols-2 gap-2">
244:                     {items.slice(0, 6).map((item) => (
245:                       <Button
