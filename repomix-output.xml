 714:     `;
 715:     if (!manager[0]) {
 716:       throw new ApiError(403, "Only the author can manage shares");
 717:     }
 718:     return prisma.$queryRaw<
 719:       Array<{
 720:         id: string;
 721:         email: string;
 722:         permission: string;
 723:         createdAt: Date;
 724:       }>
 725:     >`
 726:       SELECT id, email, permission, "createdAt"
 727:       FROM "PaperShare"
 728:       WHERE "paperId" = ${paperId} AND "isDeleted" = false
 729:       ORDER BY "createdAt" DESC
 730:     `;
