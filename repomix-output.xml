  5: function cn(...classes: (string | undefined | null | false)[]): string {
  6:   return classes.filter(Boolean).join(" ");
  7: }
  8: export interface SearchInputProps
  9:   extends Omit<React.InputHTMLAttributes<HTMLInputElement>, "onChange"> {
 10:   onSearch?: (value: string) => void;
 11:   onClear?: () => void;
 12:   placeholder?: string;
 13:   className?: string;
 14:   showClearButton?: boolean;
 15:   loading?: boolean;
 16:   debounceMs?: number;
 17: }
 18: export const SearchInput = React.forwardRef<HTMLInputElement, SearchInputProps>(
 19:   (
 20:     {
 21:       className,
 22:       onSearch,
 23:       onClear,
 24:       placeholder = "Search...",
 25:       showClearButton = true,
 26:       loading = false,
 27:       debounceMs = 300,
 28:       ...props
 29:     },
 30:     ref
 31:   ) => {
 32:     const [value, setValue] = React.useState("");
 33:     const [isFocused, setIsFocused] = React.useState(false);
 34:     const debounceRef = React.useRef<NodeJS.Timeout>();
 35:     const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
 36:       const newValue = e.target.value;
 37:       setValue(newValue);
 38:       // Debounce search
 39:       if (debounceRef.current) {
 40:         clearTimeout(debounceRef.current);
 41:       }
 42:       debounceRef.current = setTimeout(() => {
 43:         onSearch?.(newValue);
 44:       }, debounceMs);
 45:     };
 46:     const handleClear = () => {
 47:       setValue("");
 48:       onClear?.();
 49:       onSearch?.("");
 50:       if (debounceRef.current) {
 51:         clearTimeout(debounceRef.current);
 52:       }
 53:     };
 54:     const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
 55:       if (e.key === "Enter") {
 56:         if (debounceRef.current) {
 57:           clearTimeout(debounceRef.current);
 58:         }
 59:         onSearch?.(value);
 60:       }
 61:       if (e.key === "Escape" && value) {
 62:         handleClear();
 63:       }
 64:     };
 65:     React.useEffect(() => {
 66:       return () => {
 67:         if (debounceRef.current) {
 68:           clearTimeout(debounceRef.current);
 69:         }
 70:       };
 71:     }, []);
 72:     return (
 73:       <div className={cn("relative", className)}>
 74:         <div className="relative">
 75:           <motion.div
 76:             initial={false}
 77:             animate={{
 78:               color: isFocused ? "var(--primary)" : "var(--muted-foreground)",
 79:             }}
 80:             className="absolute left-3 top-1/2 -translate-y-1/2"
 81:           >
 82:             <Search className="h-4 w-4" />
 83:           </motion.div>
 84:           <input
 85:             ref={ref}
 86:             type="text"
 87:             value={value}
 88:             onChange={handleChange}
 89:             onKeyDown={handleKeyDown}
 90:             onFocus={() => setIsFocused(true)}
 91:             onBlur={() => setIsFocused(false)}
 92:             placeholder={placeholder}
 93:             className={cn(
 94:               "w-full pl-10 pr-10 h-10 rounded-lg border bg-background",
 95:               "text-sm ring-offset-background",
 96:               "placeholder:text-muted-foreground",
 97:               "focus-visible:outline-none focus-visible:ring-2",
 98:               "focus-visible:ring-ring focus-visible:ring-offset-2",
 99:               "disabled:cursor-not-allowed disabled:opacity-50",
100:               "transition-all duration-200"
101:             )}
102:             {...props}
103:           />
104:           <AnimatePresence mode="wait">
105:             {loading ? (
106:               <motion.div
107:                 key="loading"
108:                 initial={{ opacity: 0, scale: 0.8 }}
109:                 animate={{ opacity: 1, scale: 1 }}
110:                 exit={{ opacity: 0, scale: 0.8 }}
111:                 className="absolute right-3 top-1/2 -translate-y-1/2"
112:               >
113:                 <Loader2 className="h-4 w-4 animate-spin text-primary" />
114:               </motion.div>
115:             ) : showClearButton && value ? (
116:               <motion.button
117:                 key="clear"
118:                 initial={{ opacity: 0, scale: 0.8 }}
119:                 animate={{ opacity: 1, scale: 1 }}
120:                 exit={{ opacity: 0, scale: 0.8 }}
121:                 whileHover={{ scale: 1.1 }}
122:                 whileTap={{ scale: 0.9 }}
123:                 type="button"
124:                 onClick={handleClear}
125:                 className={cn(
126:                   "absolute right-3 top-1/2 -translate-y-1/2",
127:                   "p-1 rounded-full hover:bg-muted transition-colors"
128:                 )}
129:                 aria-label="Clear search"
130:               >
131:                 <X className="h-4 w-4 text-muted-foreground hover:text-foreground" />
132:               </motion.button>
133:             ) : null}
134:           </AnimatePresence>
135:         </div>
136:       </div>
137:     );
138:   }
139: );
140: SearchInput.displayName = "SearchInput";
141: export default SearchInput;
</file>

<file path="figma-make/components/form/select-field.tsx">
  1: "use client";
  2: import { Check, ChevronDown, Search } from "lucide-react";
  3: import { AnimatePresence, motion } from "motion/react";
  4: import React from "react";
  5: function cn(...classes: (string | undefined | null | false)[]): string {
  6:   return classes.filter(Boolean).join(" ");
  7: }
  8: export interface SelectOption {
  9:   value: string;
 10:   label: string;
 11:   disabled?: boolean;
 12: }
 13: export interface SelectFieldProps {
 14:   options: SelectOption[];
 15:   value?: string;
 16:   onChange?: (value: string) => void;
 17:   placeholder?: string;
 18:   searchable?: boolean;
 19:   disabled?: boolean;
 20:   error?: boolean;
 21:   required?: boolean;
 22:   label?: string;
 23:   helperText?: string;
 24:   className?: string;
 25: }
 26: export const SelectField = React.forwardRef<HTMLDivElement, SelectFieldProps>(
 27:   (
 28:     {
 29:       className,
 30:       options,
 31:       value,
 32:       onChange,
 33:       placeholder = "Select an option...",
 34:       searchable = false,
 35:       disabled = false,
 36:       error = false,
 37:       required = false,
 38:       label,
 39:       helperText,
 40:     },
 41:     ref
 42:   ) => {
 43:     const [isOpen, setIsOpen] = React.useState(false);
 44:     const [searchTerm, setSearchTerm] = React.useState("");
 45:     const [focusedIndex, setFocusedIndex] = React.useState(-1);
 46:     const containerRef = React.useRef<HTMLDivElement>(null);
 47:     const searchInputRef = React.useRef<HTMLInputElement>(null);
 48:     const selectedOption = options.find((option) => option.value === value);
 49:     const filteredOptions = searchable
 50:       ? options.filter(
 51:           (option) =>
 52:             option.label.toLowerCase().includes(searchTerm.toLowerCase()) &&
 53:             !option.disabled
 54:         )
 55:       : options.filter((option) => !option.disabled);
 56:     // Close on click outside
 57:     React.useEffect(() => {
 58:       const handleClickOutside = (event: MouseEvent) => {
 59:         if (
 60:           containerRef.current &&
 61:           !containerRef.current.contains(event.target as Node)
 62:         ) {
 63:           setIsOpen(false);
 64:           setSearchTerm("");
 65:           setFocusedIndex(-1);
 66:         }
 67:       };
 68:       document.addEventListener("mousedown", handleClickOutside);
 69:       return () =>
 70:         document.removeEventListener("mousedown", handleClickOutside);
 71:     }, []);
 72:     React.useEffect(() => {
 73:       if (isOpen && searchable && searchInputRef.current) {
 74:         searchInputRef.current.focus();
 75:       }
 76:     }, [isOpen, searchable]);
 77:     const handleSelect = (option: SelectOption) => {
 78:       if (option.disabled) return;
 79:       onChange?.(option.value);
 80:       setIsOpen(false);
 81:       setSearchTerm("");
 82:       setFocusedIndex(-1);
 83:     };
 84:     const handleKeyDown = (e: React.KeyboardEvent) => {
 85:       if (!isOpen) {
 86:         if (e.key === "Enter" || e.key === " ") {
 87:           e.preventDefault();
 88:           setIsOpen(true);
 89:         }
 90:         return;
 91:       }
 92:       switch (e.key) {
 93:         case "ArrowDown":
 94:           e.preventDefault();
 95:           setFocusedIndex((prev) =>
 96:             prev < filteredOptions.length - 1 ? prev + 1 : 0
 97:           );
 98:           break;
 99:         case "ArrowUp":
100:           e.preventDefault();
101:           setFocusedIndex((prev) =>
102:             prev > 0 ? prev - 1 : filteredOptions.length - 1
103:           );
104:           break;
105:         case "Enter":
106:           e.preventDefault();
107:           if (focusedIndex >= 0 && focusedIndex < filteredOptions.length) {
108:             handleSelect(filteredOptions[focusedIndex]);
109:           }
110:           break;
111:         case "Escape":
112:           setIsOpen(false);
113:           setSearchTerm("");
114:           setFocusedIndex(-1);
115:           break;
116:       }
117:     };
118:     return (
119:       <div className={cn("relative", className)} ref={ref}>
120:         {label && (
121:           <label className="block text-sm font-medium mb-2">
122:             {label}
123:             {required && <span className="text-destructive ml-1">*</span>}
124:           </label>
125:         )}
126:         <div ref={containerRef} className="relative">
127:           <button
128:             type="button"
129:             onClick={() => !disabled && setIsOpen(!isOpen)}
130:             onKeyDown={handleKeyDown}
131:             disabled={disabled}
132:             className={cn(
133:               "relative w-full h-10 px-3 py-2 text-left",
134:               "bg-background border rounded-lg shadow-sm",
135:               "cursor-pointer focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2",
136:               "disabled:cursor-not-allowed disabled:opacity-50",
137:               error
138:                 ? "border-destructive focus:ring-destructive"
139:                 : "border-border",
140:               isOpen && "ring-2 ring-ring ring-offset-2"
141:             )}
142:             aria-haspopup="listbox"
143:             aria-expanded={isOpen}
144:           >
145:             <span
146:               className={cn(
147:                 "block truncate text-sm",
148:                 !selectedOption && "text-muted-foreground"
149:               )}
150:             >
151:               {selectedOption ? selectedOption.label : placeholder}
152:             </span>
153:             <motion.div
154:               animate={{ rotate: isOpen ? 180 : 0 }}
155:               transition={{ duration: 0.2 }}
156:               className="absolute right-3 top-1/2 -translate-y-1/2"
157:             >
158:               <ChevronDown className="h-4 w-4 text-muted-foreground" />
159:             </motion.div>
160:           </button>
161:           <AnimatePresence>
162:             {isOpen && (
163:               <motion.div
164:                 initial={{ opacity: 0, y: -10 }}
165:                 animate={{ opacity: 1, y: 0 }}
166:                 exit={{ opacity: 0, y: -10 }}
167:                 transition={{ duration: 0.15 }}
168:                 className={cn(
169:                   "absolute z-50 w-full mt-1",
170:                   "bg-popover border border-border rounded-lg shadow-lg",
171:                   "overflow-hidden"
172:                 )}
173:               >
174:                 {searchable && (
175:                   <div className="p-2 border-b border-border">
176:                     <div className="relative">
177:                       <Search className="absolute left-2 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
178:                       <input
179:                         ref={searchInputRef}
180:                         type="text"
181:                         value={searchTerm}
182:                         onChange={(e) => setSearchTerm(e.target.value)}
183:                         placeholder="Search options..."
184:                         className={cn(
185:                           "w-full pl-8 pr-3 py-2 text-sm",
186:                           "bg-transparent border-none outline-none",
187:                           "placeholder:text-muted-foreground"
188:                         )}
189:                       />
190:                     </div>
191:                   </div>
192:                 )}
193:                 <div className="py-1 max-h-60 overflow-auto">
194:                   {filteredOptions.length === 0 ? (
195:                     <div className="px-3 py-2 text-sm text-muted-foreground">
196:                       No options found
197:                     </div>
198:                   ) : (
199:                     filteredOptions.map((option, index) => (
200:                       <motion.button
201:                         key={option.value}
202:                         type="button"
203:                         whileHover={{ backgroundColor: "var(--accent)" }}
204:                         onClick={() => handleSelect(option)}
205:                         onMouseEnter={() => setFocusedIndex(index)}
206:                         className={cn(
207:                           "relative w-full px-3 py-2 text-left text-sm",
208:                           "cursor-pointer focus:outline-none",
209:                           option.disabled &&
210:                             "opacity-50 cursor-not-allowed hover:bg-transparent",
211:                           focusedIndex === index && "bg-accent",
212:                           option.value === value &&
213:                             "bg-primary text-primary-foreground hover:bg-primary"
214:                         )}
215:                         disabled={option.disabled}
216:                       >
217:                         <span className="block truncate">{option.label}</span>
218:                         <AnimatePresence>
219:                           {option.value === value && (
220:                             <motion.div
221:                               initial={{ opacity: 0, scale: 0 }}
222:                               animate={{ opacity: 1, scale: 1 }}
223:                               exit={{ opacity: 0, scale: 0 }}
224:                               className="absolute right-3 top-1/2 -translate-y-1/2"
225:                             >
226:                               <Check className="h-4 w-4" />
227:                             </motion.div>
228:                           )}
229:                         </AnimatePresence>
230:                       </motion.button>
231:                     ))
232:                   )}
233:                 </div>
234:               </motion.div>
235:             )}
236:           </AnimatePresence>
237:         </div>
238:         {helperText && (
239:           <p
240:             className={cn(
241:               "mt-1 text-xs text-muted-foreground",
242:               error && "text-destructive"
243:             )}
244:           >
245:             {helperText}
246:           </p>
247:         )}
248:       </div>
249:     );
250:   }
251: );
252: SelectField.displayName = "SelectField";
253: export default SelectField;
</file>

<file path="figma-make/components/form/slider-field.tsx">
  1: "use client";
  2: import { motion } from "motion/react";
  3: import React from "react";
  4: function cn(...classes: (string | undefined | null | false)[]): string {
  5:   return classes.filter(Boolean).join(" ");
  6: }
  7: export interface SliderFieldProps {
  8:   value: number[];
  9:   onValueChange: (value: number[]) => void;
 10:   min?: number;
 11:   max?: number;
 12:   step?: number;
 13:   label?: string;
 14:   helperText?: string;
 15:   error?: string;
 16:   disabled?: boolean;
 17:   showValue?: boolean;
 18:   valueFormat?: (value: number) => string;
 19:   className?: string;
 20: }
 21: export const SliderField: React.FC<SliderFieldProps> = ({
 22:   value,
 23:   onValueChange,
 24:   min = 0,
 25:   max = 100,
 26:   step = 1,
 27:   label,
 28:   helperText,
 29:   error,
 30:   disabled = false,
 31:   showValue = true,
 32:   valueFormat,
 33:   className,
 34: }) => {
 35:   const [isDragging, setIsDragging] = React.useState(false);
 36:   const trackRef = React.useRef<HTMLDivElement>(null);
 37:   const formatValue = (val: number) => {
 38:     if (valueFormat) return valueFormat(val);
 39:     return val.toString();
 40:   };
 41:   const displayValue =
 42:     value.length === 1
 43:       ? formatValue(value[0])
 44:       : `${formatValue(value[0])} - ${formatValue(value[value.length - 1])}`;
 45:   const getPercentage = (val: number) => {
 46:     return ((val - min) / (max - min)) * 100;
 47:   };
 48:   const getValueFromPosition = (clientX: number) => {
 49:     if (!trackRef.current) return value[0];
 50:     const rect = trackRef.current.getBoundingClientRect();
 51:     const percentage = Math.max(
 52:       0,
 53:       Math.min(100, ((clientX - rect.left) / rect.width) * 100)
 54:     );
 55:     const rawValue = (percentage / 100) * (max - min) + min;
 56:     const steppedValue = Math.round(rawValue / step) * step;
 57:     return Math.max(min, Math.min(max, steppedValue));
 58:   };
 59:   const handleTrackClick = (e: React.MouseEvent) => {
 60:     if (disabled) return;
 61:     const newValue = getValueFromPosition(e.clientX);
 62:     onValueChange([newValue]);
 63:   };
 64:   const handleMouseDown = (e: React.MouseEvent, thumbIndex: number) => {
 65:     if (disabled) return;
 66:     e.preventDefault();
 67:     setIsDragging(true);
 68:     const handleMouseMove = (moveEvent: MouseEvent) => {
 69:       const newValue = getValueFromPosition(moveEvent.clientX);
 70:       const newValues = [...value];
 71:       newValues[thumbIndex] = newValue;
 72:       if (newValues.length > 1) {
 73:         newValues.sort((a, b) => a - b);
 74:       }
 75:       onValueChange(newValues);
 76:     };
 77:     const handleMouseUp = () => {
 78:       setIsDragging(false);
 79:       document.removeEventListener("mousemove", handleMouseMove);
 80:       document.removeEventListener("mouseup", handleMouseUp);
 81:     };
 82:     document.addEventListener("mousemove", handleMouseMove);
 83:     document.addEventListener("mouseup", handleMouseUp);
 84:   };
 85:   const percentage0 = getPercentage(value[0]);
 86:   const percentage1 = value.length > 1 ? getPercentage(value[1]) : percentage0;
 87:   return (
 88:     <div className={cn("space-y-3", className)}>
 89:       <div className="flex items-center justify-between">
 90:         {label && (
 91:           <label className="text-sm font-medium text-foreground">{label}</label>
 92:         )}
 93:         {showValue && (
 94:           <motion.span
 95:             key={displayValue}
 96:             initial={{ opacity: 0, y: -5 }}
 97:             animate={{ opacity: 1, y: 0 }}
 98:             className="text-sm text-muted-foreground font-mono"
 99:           >
100:             {displayValue}
101:           </motion.span>
102:         )}
103:       </div>
104:       {}
105:       <div
106:         ref={trackRef}
107:         onClick={handleTrackClick}
108:         className={cn(
109:           "relative h-2 w-full rounded-full bg-secondary cursor-pointer",
110:           disabled && "opacity-50 cursor-not-allowed",
111:           error && "ring-2 ring-destructive ring-offset-2"
112:         )}
113:       >
114:         {}
115:         <motion.div
116:           initial={false}
117:           animate={{
118:             left: value.length > 1 ? `${percentage0}%` : "0%",
119:             right: `${100 - percentage1}%`,
120:           }}
121:           transition={{ type: "spring", stiffness: 300, damping: 30 }}
122:           className="absolute h-full bg-primary rounded-full"
123:         />
124:         {}
125:         {value.map((val, index) => (
126:           <motion.div
127:             key={index}
128:             initial={false}
129:             animate={{ left: `${getPercentage(val)}%` }}
130:             transition={{ type: "spring", stiffness: 300, damping: 30 }}
131:             onMouseDown={(e) => handleMouseDown(e, index)}
132:             className={cn(
133:               "absolute top-1/2 -translate-x-1/2 -translate-y-1/2",
134:               "h-5 w-5 rounded-full",
135:               "bg-background border-2 border-primary",
136:               "shadow-md cursor-grab",
137:               "focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2",
138:               "hover:scale-110 transition-transform",
139:               isDragging && "cursor-grabbing scale-110",
140:               disabled && "cursor-not-allowed"
141:             )}
142:           >
143:             {}
144:             <motion.div
145:               animate={{ scale: isDragging ? 1.2 : 1 }}
146:               className="absolute inset-1 rounded-full bg-primary"
147:             />
148:           </motion.div>
149:         ))}
150:       </div>
151:       {}
152:       <div className="flex justify-between text-xs text-muted-foreground">
153:         <span>{formatValue(min)}</span>
154:         <span>{formatValue(max)}</span>
155:       </div>
156:       {helperText && !error && (
157:         <p className="text-sm text-muted-foreground">{helperText}</p>
158:       )}
159:       {error && <p className="text-sm text-destructive">{error}</p>}
160:     </div>
161:   );
162: };
163: export default SliderField;
</file>

<file path="figma-make/components/form/toggle-field.tsx">
  1: "use client";
