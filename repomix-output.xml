 10:   "inlineSchema": "generator client {\n  provider        = \"prisma-client\"\n  output          = \"../src/generated/prisma\"\n  previewFeatures = [\"typedSql\"]\n}\n\ndatasource db {\n  provider = \"postgresql\"\n}\n\nenum Role {\n  RESEARCHER\n  PRO_RESEARCHER\n  TEAM_LEAD\n  ADMIN\n}\n\n// Workspace-level roles (separate from global application Role)\n// These describe what a user can do WITHIN a specific workspace.\nenum WorkspaceRole {\n  VIEWER // Read-only access to workspace content\n  EDITOR // Can create/edit papers and collections in workspace\n  MANAGER // Can invite/remove members, manage workspace settings\n  OWNER // Full control, can delete workspace and transfer ownership\n}\n\n// Workspace visibility for figma-make UI (Phase 5)\nenum WorkspaceVisibility {\n  PRIVATE // Only members can see this workspace\n  INVITE_ONLY // Join by invitation only\n  PUBLIC // Anyone with a link can see this workspace\n}\n\nenum CollectionPermission {\n  VIEW // Read-only access - can view collection and papers\n  EDIT // Full access - can edit, add/remove papers, delete collection\n}\n\n// Collection visibility for figma-make UI (replaces boolean isPublic in Phase 4 subtask B)\nenum CollectionVisibility {\n  PRIVATE // Only the owner can see this collection\n  TEAM // Anyone in the workspace can see this collection\n  PUBLIC // Anyone with a link can see this collection\n}\n\n// Reading status of a paper within a specific collection (figma-make design)\nenum CollectionPaperStatus {\n  TO_READ\n  READING\n  COMPLETED\n  ARCHIVED\n}\n\n// Phase 6 - Note type (matches figma ResearchNotesPage type filter)\nenum NoteType {\n  QUICK\n  LITERATURE\n  METHODOLOGY\n  FINDINGS\n  IDEA\n}\n\n// Phase 6 - Note visibility (matches figma visibility pills: Private / Workspace / Public)\nenum NoteVisibility {\n  PRIVATE\n  WORKSPACE\n  PUBLIC\n}\n\nenum AnnotationType {\n  HIGHLIGHT // Yellow highlight over text\n  UNDERLINE // Underline text\n  STRIKETHROUGH // Strike through