  5: import { z } from "zod";
  6: const router: Router = Router();
  7: const getActivityLogSchema = z.object({
  8:   query: z.object({
  9:     userId: z.string().uuid().optional(),
 10:     workspaceId: z.string().uuid().optional(),
 11:     entity: z.string().optional(),
 12:     entityId: z.string().uuid().optional(),
 13:     action: z.string().optional(),
 14:     severity: z.enum(['INFO', 'WARNING', 'ERROR', 'CRITICAL']).optional(),
 15:     startDate: z.string().datetime().optional().transform(val => val ? new Date(val) : undefined),
 16:     endDate: z.string().datetime().optional().transform(val => val ? new Date(val) : undefined),
 17:     limit: z.string().transform(Number).optional().default("50"),
 18:     offset: z.string().transform(Number).optional().default("0"),
 19:     cursor: z.string().uuid().optional()
 20:   })
 21: });
 22: const getActivitySummarySchema = z.object({
 23:   query: z.object({
 24:     workspaceId: z.string().uuid().optional(),
 25:     days: z.string().transform(Number).optional().default("7")
 26:   })
 27: });
 28: const getEntityActivitySchema = z.object({
 29:   params: z.object({
 30:     entity: z.string(),
 31:     entityId: z.string().uuid()
 32:   })
 33: });
 34: const exportActivityLogSchema = z.object({
 35:   query: z.object({
 36:     userId: z.string().uuid().optional(),
 37:     workspaceId: z.string().uuid().optional(),
 38:     entity: z.string().optional(),
 39:     entityId: z.string().uuid().optional(),
 40:     action: z.string().optional(),
 41:     severity: z.enum(['INFO', 'WARNING', 'ERROR', 'CRITICAL']).optional(),
 42:     startDate: z.string().datetime().optional().transform(val => val ? new Date(val) : undefined),
 43:     endDate: z.string().datetime().optional().transform(val => val ? new Date(val) : undefined),
 44:     format: z.enum(['json', 'csv']).optional().default('json')
 45:   })
 46: });
 47: router.get(
 48:   "/",
 49:   authMiddleware,
 50:   validateRequest(getActivityLogSchema),
 51:   async (req, res, next) => {
 52:     try {
 53:       const result = await ActivityLogService.getActivityLog(req, req.query);
 54:       res.json({
 55:         success: true,
 56:         data: result
 57:       });
 58:     } catch (error) {
 59:       next(error);
 60:     }
 61:   }
