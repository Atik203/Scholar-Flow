393:       };
394:     }
395:     const providerInstances = getProviderInstances();
396:     const errors: string[] = [];
397:     for (const provider of providerInstances) {
398:       if (!provider.isEnabled()) {
399:         continue;
400:       }
401:       try {
402:         const result = await provider.extractMetadata(input);
403:         if (result && result.metadata) {
404:           return result;
405:         }
406:       } catch (error) {
407:         errors.push(
408:           error instanceof Error ? error.message : String(error ?? "Unknown")
409:         );
410:       }
