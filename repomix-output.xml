125: function parseBibTeX(content: string): ImportedPaper[] {
126:   const entries: ImportedPaper[] = [];
127:   const regex = /@(\w+)\s*\{([^,]*),([^@]*)\}/g;
128:   let match;
129:   let idx = 0;
130:   while ((match = regex.exec(content)) !== null) {
131:     const fields = match[3];
132:     const getField = (name: string): string => {
133:       const fieldMatch = new RegExp(
134:         `${name}\\s*=\\s*[{"]([^}"]*)[}"]`,
135:         "i"
136:       ).exec(fields);
137:       return fieldMatch ? fieldMatch[1].trim() : "";
138:     };
139:     const title = getField("title");
140:     const authorStr = getField("author");
141:     const year = parseInt(getField("year")) || new Date().getFullYear();
142:     const doi = getField("doi");
143:     const journal = getField("journal") || getField("booktitle");
144:     if (title) {
145:       entries.push({
146:         id: `import-${idx++}`,
147:         title,
148:         authors: authorStr
149:           ? authorStr.split(" and ").map((a) => a.trim())
150:           : ["Unknown"],
151:         year,
152:         source: journal || "Unknown",
153:         doi: doi || undefined,
154:         status: "pending",
155:         selected: true,
156:       });
157:     }
158:   }
159:   return entries;
160: }
161: function parseRIS(content: string): ImportedPaper[] {
162:   const entries: ImportedPaper[] = [];
163:   const blocks = content.split(/^ER\s*-/m);
164:   let idx = 0;
165:   for (const block of blocks) {
166:     const getTag = (tag: string): string[] => {
167:       const matches = block.matchAll(new RegExp(`^${tag}\\s*-\\s*(.+)$`, "gm"));
168:       return Array.from(matches, (m) => m[1].trim());
169:     };
170:     const titles = getTag("TI").concat(getTag("T1"));
171:     const title = titles[0] || "";
172:     const authors = getTag("AU").concat(getTag("A1"));
173:     const year =
174:       parseInt(getTag("PY")[0] || getTag("Y1")[0] || "") ||
175:       new Date().getFullYear();
176:     const doi = getTag("DO")[0] || "";
177:     const journal = getTag("JO")[0] || getTag("T2")[0] || "";
178:     if (title) {
179:       entries.push({
180:         id: `import-${idx++}`,
181:         title,
182:         authors: authors.length > 0 ? authors : ["Unknown"],
183:         year,
184:         source: journal || "Unknown",
185:         doi: doi || undefined,
186:         status: "pending",
187:         selected: true,
188:       });
189:     }
190:   }
191:   return entries;
192: }
