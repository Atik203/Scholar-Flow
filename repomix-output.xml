275:         provider: this.name,
276:         metadata,
277:         rawResponse: data,
278:       };
279:     } catch (error) {
280:       if (error instanceof AiError) {
281:         throw error;
282:       }
283:       if (error instanceof Error && error.name === "AbortError") {
284:         throw new AiError(
285:           504,
286:           "Gemini extraction request timed out",
287:           "AI_PROVIDER_TIMEOUT"
