227:     let overallStatus: "healthy" | "unhealthy" | "degraded" = "healthy";
228:     if (healthyCounts.unhealthy > 0) {
229:       overallStatus = "unhealthy";
230:     } else if (healthyCounts.degraded > 0) {
231:       overallStatus = "degraded";
232:     }
233:     const responseTime = Date.now() - startTime;
234:     const response: HealthCheckResponse = {
235:       status: overallStatus,
236:       timestamp: new Date().toISOString(),
237:       uptime: process.uptime(),
238:       environment: process.env.NODE_ENV || "development",
239:       version: process.env.npm_package_version || "1.0.0",
240:       services,
241:       overall: healthyCounts,
242:     };
243:     let statusCode = 200;
244:     if (overallStatus === "degraded") {
245:       statusCode = 207;
246:     } else if (overallStatus === "unhealthy") {
247:       statusCode = 503;
248:     }
249:     res.setHeader("X-Health-Check-Duration", `${responseTime}ms`);
250:     res.status(statusCode).json(response);
251:   }
