265:                                   setNewPriceId("");
266:                                 }}
267:                               >
268:                                 <Crown className="h-3 w-3" />
269:                               </Button>
270:                             )}
271:                             {s.status === "ACTIVE" && (
272:                               <Button
273:                                 size="sm"
274:                                 variant="destructive"
275:                                 disabled={busy}
276:                                 title="Cancel immediately"
277:                                 onClick={() => {
278:                                   if (
279:                                     confirm(
280:                                       `Cancel ${s.userEmail}'s subscription immediately?`
281:                                     )
282:                                   ) {
283:                                     runAction(
284:                                       s.subscriptionId,
285:                                       () => cancelNow(s.subscriptionId).unwrap(),
