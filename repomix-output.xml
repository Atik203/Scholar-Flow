873:   static async updateSettings(
874:     userId: string,
875:     patch: TeamSettingsPayload
876:   ): Promise<TeamSettingsPayload> {
877:     const current = await this.getSettings(userId);
878:     const merged = this._deepMergeSettings(current, patch);
879:     const pref = await prisma.userPreference.findUnique({
880:       where: { userId },
881:       select: { metadata: true },
882:     });
883:     const meta = (pref?.metadata as Record<string, any>) || {};
884:     meta.teamSettings = merged;
885:     await prisma.userPreference.upsert({
886:       where: { userId },
887:       create: {
888:         userId,
889:         metadata: meta,
890:       },
891:       update: {
892:         metadata: meta,
893:       },
894:     });
895:     return merged;
896:   }
897:   static async getAccessInfo(userId: string) {
898:     const user = await prisma.user.findUnique({
899:       where: { id: userId },
900:       select: { role: true },
901:     });
902:     const role = (user?.role ??
903:       USER_ROLES.RESEARCHER) as keyof typeof ROLE_HIERARCHY;
904:     const isTeamLead =
905:       (ROLE_HIERARCHY[role] ?? 0) >= ROLE_HIERARCHY[USER_ROLES.TEAM_LEAD];
906:     const [memberOfOthersWorkspace, ownerWithMembers, pendingInvitation] =
907:       await Promise.all([
908:         prisma.workspaceMember.findFirst({
909:           where: {
910:             userId,
911:             isDeleted: false,
912:             workspace: { isDeleted: false, ownerId: { not: userId } },
913:           },
914:           select: { id: true },
915:         }),
916:         prisma.workspace.findFirst({
917:           where: {
918:             ownerId: userId,
919:             isDeleted: false,
920:             members: { some: { isDeleted: false, userId: { not: userId } } },
921:           },
922:           select: { id: true },
923:         }),
924:         prisma.workspaceInvitation.findFirst({
925:           where: {
926:             userId,
927:             status: "PENDING",
928:             isDeleted: false,
929:             OR: [{ expiresAt: null }, { expiresAt: { gt: new Date() } }],
930:           },
931:           select: { id: true },
932:         }),
933:       ]);
934:     return {
935:       hasAccess:
936:         isTeamLead ||
937:         Boolean(memberOfOthersWorkspace) ||
938:         Boolean(ownerWithMembers) ||
939:         Boolean(pendingInvitation),
940:       isTeamLead,
941:       hasPendingInvitation: Boolean(pendingInvitation),
942:     };
943:   }
944:   private static async _requesterWorkspaceIds(userId: string): Promise<string[]> {
945:     const workspaces = await prisma.workspace.findMany({
946:       where: {
947:         isDeleted: false,
948:         OR: [
949:           { ownerId: userId },
950:           { members: { some: { userId, isDeleted: false } } },
951:         ],
952:       },
953:       select: { id: true },
954:     });
955:     return workspaces.map((w) => w.id);
956:   }
957:   private static async _sharesWorkspace(
958:     userIdA: string,
959:     userIdB: string
960:   ): Promise<boolean> {
961:     const shared = await prisma.$queryRaw<Array<{ count: number }>>`
962:       SELECT COUNT(*)::int as count
963:       FROM "WorkspaceMember" a
964:       JOIN "WorkspaceMember" b ON b."workspaceId" = a."workspaceId"
965:         AND b."userId" = ${userIdB} AND b."isDeleted" = false
966:       JOIN "Workspace" w ON w.id = a."workspaceId" AND w."isDeleted" = false
967:       WHERE a."userId" = ${userIdA} AND a."isDeleted" = false
968:       LIMIT 1
969:     `;
970:     return (shared[0]?.count ?? 0) > 0;
971:   }
972:   private static _mergeSettings(stored: TeamSettingsPayload): TeamSettingsPayload {
973:     return {
974:       general: { ...DEFAULT_SETTINGS.general, ...stored.general },
975:       permissions: { ...DEFAULT_SETTINGS.permissions, ...stored.permissions },
976:       notifications: { ...DEFAULT_SETTINGS.notifications, ...stored.notifications },
977:       security: {
978:         ...DEFAULT_SETTINGS.security,
979:         ...stored.security,
980:         allowedDomains: stored.security?.allowedDomains || DEFAULT_SETTINGS.security!.allowedDomains,
981:       },
982:       integrations: { ...DEFAULT_SETTINGS.integrations, ...stored.integrations },
983:     };
984:   }
985:   private static _deepMergeSettings(
986:     base: TeamSettingsPayload,
987:     patch: TeamSettingsPayload
988:   ): TeamSettingsPayload {
989:     return {
990:       general: { ...base.general, ...patch.general },
991:       permissions: { ...base.permissions, ...patch.permissions },
992:       notifications: { ...base.notifications, ...patch.notifications },
993:       security: { ...base.security, ...patch.security },
994:       integrations: { ...base.integrations, ...patch.integrations },
995:     };
996:   }
