  4:   err: Prisma.PrismaClientKnownRequestError
  5: ): TGenericErrorResponse => {
  6:   let message = "Database Error";
  7:   let statusCode = 500;
  8:   let errorSources: TErrorSources = [];
  9:   switch (err.code) {
 10:     case "P2002":
 11:       statusCode = 409;
 12:       message = "Duplicate entry";
 13:       errorSources = [
 14:         {
 15:           path: (err.meta?.target as string) || "unknown",
 16:           message: `${err.meta?.target} already exists`,
 17:         },
 18:       ];
 19:       break;
 20:     case "P2025":
 21:       statusCode = 404;
 22:       message = "Record not found";
 23:       errorSources = [
 24:         {
 25:           path: "id",
 26:           message: "The requested resource was not found",
 27:         },
 28:       ];
 29:       break;
 30:     case "P2003":
 31:       statusCode = 400;
 32:       message = "Foreign key constraint failed";
 33:       errorSources = [
 34:         {
 35:           path: (err.meta?.field_name as string) || "unknown",
 36:           message: "Referenced record does not exist",
 37:         },
 38:       ];
 39:       break;
 40:     case "P2014":
 41:       statusCode = 400;
 42:       message = "Required relation missing";
 43:       errorSources = [
 44:         {
 45:           path: (err.meta?.relation_name as string) || "unknown",
 46:           message: "A required relation is missing",
 47:         },
 48:       ];
 49:       break;
 50:     case "P2011":
 51:       statusCode = 400;
 52:       message = "Null constraint violation";
 53:       errorSources = [
 54:         {
 55:           path: (err.meta?.column_name as string) || "unknown",
 56:           message: "This field is required and cannot be null",
 57:         },
 58:       ];
 59:       break;
 60:     case "P2012":
 61:       statusCode = 400;
 62:       message = "Missing required value";
 63:       errorSources = [
 64:         {
 65:           path: (err.meta?.column_name as string) || "unknown",
 66:           message: "A required value is missing",
 67:         },
 68:       ];
 69:       break;
 70:     case "P2013":
 71:       statusCode = 400;
 72:       message = "Missing required argument";
 73:       errorSources = [
 74:         {
 75:           path: (err.meta?.argument_name as string) || "unknown",
 76:           message: "A required argument is missing",
 77:         },
 78:       ];
 79:       break;
 80:     case "P2015":
 81:       statusCode = 404;
 82:       message = "Related record not found";
 83:       errorSources = [
 84:         {
 85:           path: (err.meta?.relation_name as string) || "unknown",
 86:           message: "The related record was not found",
 87:         },
 88:       ];
 89:       break;
 90:     case "P2016":
 91:       statusCode = 400;
 92:       message = "Query interpretation error";
 93:       errorSources = [
 94:         {
 95:           path: "query",
 96:           message: err.message,
 97:         },
 98:       ];
 99:       break;
100:     case "P2021":
101:       statusCode = 500;
102:       message = "Table does not exist";
103:       errorSources = [
104:         {
105:           path: (err.meta?.table as string) || "unknown",
106:           message: "The requested table does not exist in the database",
107:         },
108:       ];
109:       break;
110:     case "P2022":
111:       statusCode = 500;
112:       message = "Column does not exist";
113:       errorSources = [
114:         {
115:           path: (err.meta?.column as string) || "unknown",
116:           message: "The requested column does not exist in the database",
117:         },
118:       ];
119:       break;
120:     default:
121:       statusCode = 500;
122:       message = "Database error occurred";
123:       errorSources = [
124:         {
125:           path: "database",
126:           message: err.message,
127:         },
128:       ];
129:   }
130:   return {
131:     statusCode,
132:     message,
133:     errorSources,
134:   };
135: };
136: export default handlePrismaError;
</file>

<file path="apps/backend/src/app/middleware/globalErrorHandler.ts">
  1: import { Prisma } from "../shared/prisma";
  2: import { NextFunction, Request, Response } from "express";
  3: import { ZodError } from "zod";
  4: import config from "../config";
  5: import {
  6:   ApiError,
  7:   handleDuplicateError,
  8:   handleJWTError,
  9:   handlePostgresError,
 10:   handlePrismaError,
 11:   handleTokenExpiredError,
 12:   handleZodError,
 13: } from "../errors";
 14: import { TErrorSources } from "../interfaces/error";
 15: const globalErrorHandler = (
 16:   err: unknown,
 17:   req: Request,
 18:   res: Response,
 19:   _next: NextFunction
 20: ) => {
 21:   console.error("❌ GLOBAL ERROR HANDLER CAUGHT:", {
 22:     errorType: err?.constructor?.name,
 23:     message: (err as Error)?.message,
 24:     code: (err as any)?.code,
 25:     stack: config.env === "development" ? (err as Error)?.stack : undefined,
 26:     details: (err as any)?.detail,
 27:     column: (err as any)?.column,
 28:     constraint: (err as any)?.constraint,
 29:     table: (err as any)?.table,
 30:   });
 31:   let statusCode = 500;
 32:   let message = "Something went wrong!";
 33:   let errorSources: TErrorSources = [
 34:     {
 35:       path: "",
 36:       message: "Something went wrong!",
 37:     },
 38:   ];
 39:   // Handle Zod validation errors
 40:   if (err instanceof ZodError) {
 41:     const simplifiedError = handleZodError(err);
 42:     statusCode = simplifiedError?.statusCode;
 43:     message = simplifiedError?.message;
 44:     errorSources = simplifiedError?.errorSources;
 45:   }
 46:   // Handle Prisma known request errors
 47:   else if (err instanceof Prisma.PrismaClientKnownRequestError) {
 48:     const simplifiedError = handlePrismaError(err);
 49:     statusCode = simplifiedError?.statusCode;
 50:     message = simplifiedError?.message;
 51:     errorSources = simplifiedError?.errorSources;
 52:   }
 53:   // Handle Prisma validation errors
 54:   else if (err instanceof Prisma.PrismaClientValidationError) {
 55:     statusCode = 400;
 56:     message = "Validation Error";
 57:     errorSources = [
 58:       {
 59:         path: "validation",
 60:         message: err.message,
 61:       },
 62:     ];
 63:   }
 64:   else if ((err as any)?.code && typeof (err as any).code === "string") {
 65:     const simplifiedError = handlePostgresError(err);
 66:     statusCode = simplifiedError?.statusCode;
 67:     message = simplifiedError?.message;
 68:     errorSources = simplifiedError?.errorSources;
 69:   }
 70:   else if ((err as Error)?.name === "JsonWebTokenError") {
 71:     const simplifiedError = handleJWTError();
 72:     statusCode = simplifiedError?.statusCode;
 73:     message = simplifiedError?.message;
 74:     errorSources = simplifiedError?.errorSources;
 75:   }
 76:   else if ((err as Error)?.name === "TokenExpiredError") {
 77:     const simplifiedError = handleTokenExpiredError();
 78:     statusCode = simplifiedError?.statusCode;
 79:     message = simplifiedError?.message;
 80:     errorSources = simplifiedError?.errorSources;
 81:   }
 82:   else if ((err as any)?.code === 11000) {
 83:     const simplifiedError = handleDuplicateError(err);
 84:     statusCode = simplifiedError?.statusCode;
 85:     message = simplifiedError?.message;
 86:     errorSources = simplifiedError?.errorSources;
 87:   }
 88:   else if (err instanceof ApiError) {
 89:     statusCode = err?.statusCode;
 90:     message = err?.message;
 91:     errorSources = [
 92:       {
 93:         path: "",
 94:         message: err?.message,
 95:       },
 96:     ];
 97:   }
 98:   // Handle generic Error instances
 99:   else if (err instanceof Error) {
100:     message = err?.message;
101:     errorSources = [
102:       {
103:         path: "",
104:         message: err?.message,
105:       },
106:     ];
107:   }
108:   return res.status(statusCode).json({
109:     success: false,
110:     message,
111:     errorSources,
112:     stack: config.env === "development" ? (err as Error)?.stack : null,
113:   });
114: };
115: export default globalErrorHandler;
</file>

