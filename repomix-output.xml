127:       const store = transaction.objectStore(this.storeName);
128:       const request = store.get(key);
129:       request.onerror = () => reject(request.error);
130:       request.onsuccess = () => resolve(request.result || null);
131:     });
132:   }
133:   async set<T>(key: string, value: T): Promise<void> {
134:     if (!this.db) await this.init();
135:     return new Promise((resolve, reject) => {
136:       const transaction = this.db!.transaction([this.storeName], "readwrite");
137:       const store = transaction.objectStore(this.storeName);
138:       const request = store.put(value, key);
139:       request.onerror = () => reject(request.error);
140:       request.onsuccess = () => resolve();
141:     });
142:   }
143:   async remove(key: string): Promise<void> {
144:     if (!this.db) await this.init();
145:     return new Promise((resolve, reject) => {
146:       const transaction = this.db!.transaction([this.storeName], "readwrite");
147:       const store = transaction.objectStore(this.storeName);
148:       const request = store.delete(key);
149:       request.onerror = () => reject(request.error);
150:       request.onsuccess = () => resolve();
151:     });
152:   }
153:   async clear(): Promise<void> {
154:     if (!this.db) await this.init();
155:     return new Promise((resolve, reject) => {
156:       const transaction = this.db!.transaction([this.storeName], "readwrite");
157:       const store = transaction.objectStore(this.storeName);
158:       const request = store.clear();
159:       request.onerror = () => reject(request.error);
160:       request.onsuccess = () => resolve();
161:     });
