  1: import prisma from "../../shared/prisma";
  2: export interface AIProviderKeyStatus {
  3:   envName: string;
  4:   configured: boolean;
  5: }
  6: const TRACKED_ENV_KEYS: readonly string[] = [
  7:   "OPENAI_API_KEY",
  8:   "ANTHROPIC_API_KEY",
  9:   "GOOGLE_API_KEY",
 10:   "GEMINI_API_KEY",
 11:   "DEEPSEEK_API_KEY",
 12:   "MINIMAX_API_KEY",
 13: ] as const;
 14: export const aiProviderService = {
 15:   async list() {
 16:     return prisma.aIProvider.findMany({
 17:       where: { isDeleted: false },
 18:       orderBy: [{ displayOrder: "asc" }, { createdAt: "asc" }],
 19:     });
 20:   },
 21:   async listEnabled() {
 22:     return prisma.aIProvider.findMany({
 23:       where: { isDeleted: false, enabled: true },
 24:       orderBy: [{ displayOrder: "asc" }, { createdAt: "asc" }],
 25:     });
 26:   },
 27:   async getById(id: string) {
 28:     return prisma.aIProvider.findFirst({
 29:       where: { id, isDeleted: false },
 30:     });
 31:   },
 32:   async create(input: {
 33:     provider: string;
 34:     model: string;
 35:     displayName: string;
 36:     description?: string | null;
 37:     apiKeyEnvName?: string | null;
 38:     enabled?: boolean;
 39:     isDefault?: boolean;
 40:     displayOrder?: number;
 41:     inputCostPer1k?: number | null;
 42:     outputCostPer1k?: number | null;
 43:   }) {
 44:     if (input.isDefault) {
 45:       await prisma.aIProvider.updateMany({
 46:         where: { isDefault: true, isDeleted: false },
 47:         data: { isDefault: false },
 48:       });
 49:     }
 50:     return prisma.aIProvider.create({
 51:       data: {
 52:         provider: input.provider,
 53:         model: input.model,
 54:         displayName: input.displayName,
 55:         description: input.description ?? null,
 56:         apiKeyEnvName: input.apiKeyEnvName ?? null,
 57:         enabled: input.enabled ?? true,
 58:         isDefault: input.isDefault ?? false,
 59:         displayOrder: input.displayOrder ?? 0,
 60:         inputCostPer1k: input.inputCostPer1k ?? null,
 61:         outputCostPer1k: input.outputCostPer1k ?? null,
 62:       },
 63:     });
 64:   },
 65:   async update(
 66:     id: string,
 67:     input: {
 68:       displayName?: string;
 69:       description?: string | null;
 70:       apiKeyEnvName?: string | null;
 71:       enabled?: boolean;
 72:       displayOrder?: number;
 73:       inputCostPer1k?: number | null;
 74:       outputCostPer1k?: number | null;
 75:     }
 76:   ) {
 77:     return prisma.aIProvider.update({
 78:       where: { id },
 79:       data: {
 80:         ...(input.displayName !== undefined && { displayName: input.displayName }),
 81:         ...(input.description !== undefined && { description: input.description }),
 82:         ...(input.apiKeyEnvName !== undefined && {
 83:           apiKeyEnvName: input.apiKeyEnvName,
 84:         }),
 85:         ...(input.enabled !== undefined && { enabled: input.enabled }),
 86:         ...(input.displayOrder !== undefined && {
 87:           displayOrder: input.displayOrder,
 88:         }),
 89:         ...(input.inputCostPer1k !== undefined && {
 90:           inputCostPer1k: input.inputCostPer1k,
 91:         }),
 92:         ...(input.outputCostPer1k !== undefined && {
 93:           outputCostPer1k: input.outputCostPer1k,
 94:         }),
 95:       },
 96:     });
 97:   },
 98:   async setDefault(id: string) {
 99:     await prisma.$transaction([
100:       prisma.aIProvider.updateMany({
101:         where: { isDefault: true, isDeleted: false },
102:         data: { isDefault: false },
103:       }),
104:       prisma.aIProvider.update({
105:         where: { id },
106:         data: { isDefault: true, enabled: true },
107:       }),
108:     ]);
109:     return prisma.aIProvider.findUnique({ where: { id } });
110:   },
111:   async reorder(items: Array<{ id: string; displayOrder: number }>) {
112:     const operations = items.map(({ id, displayOrder }) =>
113:       prisma.aIProvider.update({
114:         where: { id },
115:         data: { displayOrder },
116:       })
117:     );
118:     await prisma.$transaction(operations);
119:     return this.list();
120:   },
121:   async softDelete(id: string) {
122:     const target = await prisma.aIProvider.findUnique({ where: { id } });
123:     if (target?.isDefault) {
124:       throw new Error("Cannot delete the default provider. Set another provider as default first.");
125:     }
126:     await prisma.aIProvider.update({
127:       where: { id },
128:       data: { isDeleted: true },
129:     });
130:   },
131:   async getKeyStatuses(): Promise<AIProviderKeyStatus[]> {
132:     return TRACKED_ENV_KEYS.map((envName) => ({
133:       envName,
134:       configured: Boolean(process.env[envName] && process.env[envName]!.length > 0),
135:     }));
136:   },
137:   async resolveModelForProvider(provider: string, modelHint?: string) {
138:     if (modelHint) {
139:       const match = await prisma.aIProvider.findFirst({
140:         where: { provider, model: modelHint, isDeleted: false, enabled: true },
141:       });
142:       if (match) return match.model;
143:     }
144:     const fallback = await prisma.aIProvider.findFirst({
145:       where: { provider, isDeleted: false, enabled: true },
146:       orderBy: [{ isDefault: "desc" }, { displayOrder: "asc" }],
147:     });
148:     return fallback?.model ?? null;
149:   },
150: };
