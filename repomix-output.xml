 83:   const para = paragraphType.create();
 84:   let tr = state.tr.insert(end, para);
 85:   const $inside = tr.doc.resolve(end + 1);
 86:   tr = tr.setSelection(TextSelection.near($inside)).scrollIntoView();
 87:   view.dispatch(tr);
 88:   return true;
