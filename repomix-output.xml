                      : activeTab === "references"
                        ? "Papers referenced by this paper will appear here once reference data is extracted."
                        : "Similar papers will appear here once recommendation data is available."}
                  </p>
                </CardContent>
              </Card>
            )}
          </>
        )}

        {/* Paper Detail Modal */}
        <AnimatePresence>
          {selectedPaper && (
            <motion.div
