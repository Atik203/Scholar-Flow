<file path="apps/backend/src/app/modules/Paper/embedding.service.ts">
 1: import prisma from "../../shared/prisma";
 2: export const EMBEDDING_DIM = 1536;
 3: const useVector =
 4:   process.env.USE_PGVECTOR === "true" || process.env.USE_PGVECTOR === "1";
 5: export async function saveChunkEmbedding(
 6:   paperChunkId: string,
 7:   embedding: number[]
 8: ) {
 9:   if (!useVector) {
10:     throw new Error(
11:       "Vector operations disabled. Set USE_PGVECTOR=true to enable."
12:     );
13:   }
14:   if (embedding.length !== EMBEDDING_DIM) {
15:     throw new Error(
16:       `Embedding length ${embedding.length} != expected ${EMBEDDING_DIM}`
17:     );
18:   }
19:   const literal = "[" + embedding.join(",") + "]";
20:   await prisma.$executeRaw`
21:     UPDATE "PaperChunk" SET embedding = ${literal}::vector WHERE id = ${paperChunkId}
22:   `;
23: }
24: export interface SimilarChunkResult {
25:   id: string;
26:   paperId: string;
27:   idx: number;
28:   page: number | null;
29:   content: string;
30:   distance: number;
31: }
32: export async function searchSimilarChunks(
33:   queryEmbedding: number[],
34:   limit = 10
35: ): Promise<SimilarChunkResult[]> {
36:   if (!useVector) {
37:     return [];
38:   }
39:   if (queryEmbedding.length !== EMBEDDING_DIM) {
40:     throw new Error(
41:       `Query embedding length ${queryEmbedding.length} != expected ${EMBEDDING_DIM}`
42:     );
43:   }
44:   const literal = "[" + queryEmbedding.join(",") + "]";
45:   const rows = await prisma.$queryRaw<SimilarChunkResult[]>`
46:     SELECT id, "paperId", idx, page, content, (embedding <-> ${literal}::vector) AS distance
47:     FROM "PaperChunk"
48:     WHERE embedding IS NOT NULL
49:     ORDER BY embedding <-> ${literal}::vector
50:     LIMIT ${limit}
51:   `;
52:   return rows as SimilarChunkResult[];
53: }
54: export const embeddingService = {
55:   saveChunkEmbedding,
56:   searchSimilarChunks,
57: };
</file>

