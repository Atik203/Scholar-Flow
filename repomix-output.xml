<file path="apps/backend/scripts/s3SmokeTest.ts">
  1: import {
  2:   DeleteObjectCommand,
  3:   GetObjectCommand,
  4:   HeadObjectCommand,
  5:   PutObjectCommand,
  6:   S3Client,
  7: } from "@aws-sdk/client-s3";
  8: import { getSignedUrl } from "@aws-sdk/s3-request-presigner";
  9: import crypto from "crypto";
 10: import "dotenv/config";
 11: const requiredEnv = [
 12:   "AWS_ACCESS_KEY_ID",
 13:   "AWS_SECRET_ACCESS_KEY",
 14:   "AWS_BUCKET_NAME",
 15:   "AWS_REGION",
 16: ];
 17: const missing = requiredEnv.filter((k) => !process.env[k]);
 18: if (missing.length) {
 19:   console.error(`❌ Missing required env vars: ${missing.join(", ")}`);
 20:   process.exit(1);
 21: }
 22: const bucket = process.env.AWS_BUCKET_NAME as string;
 23: const region = process.env.AWS_REGION as string;
 24: const s3 = new S3Client({
 25:   region,
 26:   credentials: {
 27:     accessKeyId: process.env.AWS_ACCESS_KEY_ID as string,
 28:     secretAccessKey: process.env.AWS_SECRET_ACCESS_KEY as string,
 29:   },
 30: });
 31: const minimalPdf = Buffer.from(
 32:   `%PDF-1.1\n1 0 obj<<>>endobj\ntrailer<<>>\n%%EOF\n`,
 33:   "utf-8"
 34: );
 35: const run = async () => {
 36:   const randomId = crypto.randomBytes(8).toString("hex");
 37:   const key = `smoke-test/s3-test-${randomId}.pdf`;
 38:   console.log(
 39:     `ℹ️  Starting S3 smoke test against bucket='${bucket}' region='${region}' key='${key}'`
 40:   );
 41:   try {
 42:     console.log("➡️  Uploading test PDF...");
 43:     const putCommand = new PutObjectCommand({
 44:       Bucket: bucket,
 45:       Key: key,
 46:       Body: minimalPdf,
 47:       ContentType: "application/pdf",
 48:       ACL: "private",
 49:     });
 50:     await s3.send(putCommand);
 51:     console.log("✅ Upload successful.");
 52:     console.log("➡️  Verifying object with HEAD...");
 53:     const headCommand = new HeadObjectCommand({
 54:       Bucket: bucket,
 55:       Key: key,
 56:     });
 57:     const head = await s3.send(headCommand);
 58:     console.log("✅ HEAD successful. Size =", head.ContentLength, "bytes");
 59:     console.log("➡️  Downloading object...");
 60:     const getCommand = new GetObjectCommand({
 61:       Bucket: bucket,
 62:       Key: key,
 63:     });
 64:     const getRes = await s3.send(getCommand);
 65:     if (!getRes.Body) {
 66:       throw new Error("Downloaded object Body is empty");
 67:     }
 68:     const chunks: Buffer[] = [];
 69:     const stream = getRes.Body as NodeJS.ReadableStream;
 70:     const downloaded = await new Promise<Buffer>((resolve, reject) => {
 71:       stream.on("data", (chunk: Buffer) => chunks.push(chunk));
 72:       stream.on("error", reject);
 73:       stream.on("end", () => resolve(Buffer.concat(chunks)));
 74:     });
 75:     if (downloaded.length !== minimalPdf.length) {
 76:       console.warn(
 77:         `⚠️  Downloaded size (${downloaded.length}) differs from uploaded (${minimalPdf.length}).`
 78:       );
 79:     } else {
 80:       console.log("✅ Download size matches uploaded size.");
 81:     }
 82:     console.log("➡️  Generating a signed URL (60s)...");
 83:     const signedGetCommand = new GetObjectCommand({
 84:       Bucket: bucket,
 85:       Key: key,
 86:     });
 87:     const signedUrl = await getSignedUrl(s3, signedGetCommand, {
 88:       expiresIn: 60,
 89:     });
 90:     console.log("🔗 Signed URL:", signedUrl);
 91:     console.log("➡️  Deleting test object...");
 92:     const deleteCommand = new DeleteObjectCommand({
 93:       Bucket: bucket,
 94:       Key: key,
 95:     });
 96:     await s3.send(deleteCommand);
 97:     console.log("✅ Deletion successful.");
 98:     console.log("\n🎉 S3 Smoke Test PASSED. Basic operations functioning.");
 99:   } catch (err: any) {
100:     console.error("\n❌ S3 Smoke Test FAILED.");
101:     console.error("Error name:", err.name);
102:     console.error("Error message:", err.message);
103:     if (err.code) console.error("AWS Error code:", err.code);
104:     console.error("Stack:", err.stack?.split("\n").slice(0, 5).join("\n"));
105:     process.exit(1);
106:   }
107: };
108: run();
</file>

