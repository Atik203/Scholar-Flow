 39:   extends Omit<React.HTMLProps<HTMLDivElement>, "ref"> {
 40:   children?: React.ReactNode
 41:   portal?: boolean
 42:   portalProps?: Omit<React.ComponentProps<typeof FloatingPortal>, "children">
 43: }
 44: interface TooltipContextValue extends UseFloatingReturn<ReferenceType> {
 45:   open: boolean
 46:   setOpen: (open: boolean) => void
 47:   getReferenceProps: (
 48:     userProps?: React.HTMLProps<HTMLElement>
 49:   ) => Record<string, unknown>
 50:   getFloatingProps: (
 51:     userProps?: React.HTMLProps<HTMLDivElement>
 52:   ) => Record<string, unknown>
 53: }
 54: function useTooltip({
 55:   initialOpen = false,
 56:   placement = "top",
 57:   open: controlledOpen,
 58:   onOpenChange: setControlledOpen,
 59:   delay = 600,
 60:   closeDelay = 0,
 61: }: Omit<TooltipProviderProps, "children"> = {}) {
 62:   const [uncontrolledOpen, setUncontrolledOpen] =
 63:     React.useState<boolean>(initialOpen)
 64:   const open = controlledOpen ?? uncontrolledOpen
 65:   const setOpen = setControlledOpen ?? setUncontrolledOpen
 66:   const data = useFloating({
 67:     placement,
 68:     open,
 69:     onOpenChange: setOpen,
 70:     whileElementsMounted: autoUpdate,
 71:     middleware: [
 72:       offset(4),
 73:       flip({
 74:         crossAxis: placement.includes("-"),
 75:         fallbackAxisSideDirection: "start",
 76:         padding: 4,
 77:       }),
 78:       shift({ padding: 4 }),
 79:     ],
 80:   })
 81:   const context = data.context
 82:   const hover = useHover(context, {
 83:     mouseOnly: true,
 84:     move: false,
 85:     restMs: delay,
 86:     enabled: controlledOpen == null,
 87:     delay: {
 88:       close: closeDelay,
 89:     },
 90:   })
 91:   const focus = useFocus(context, {
 92:     enabled: controlledOpen == null,
 93:   })
 94:   const dismiss = useDismiss(context)
 95:   const role = useRole(context, { role: "tooltip" })
 96:   const interactions = useInteractions([hover, focus, dismiss, role])
 97:   return React.useMemo(
 98:     () => ({
 99:       open,
100:       setOpen,
101:       ...interactions,
102:       ...data,
103:     }),
104:     [open, setOpen, interactions, data]
105:   )
106: }
107: const TooltipContext = React.createContext<TooltipContextValue | null>(null)
108: function useTooltipContext() {
109:   const context = React.useContext(TooltipContext)
110:   if (context == null) {
111:     throw new Error("Tooltip components must be wrapped in <TooltipProvider />")
112:   }
113:   return context
114: }
115: export function Tooltip({ children, ...props }: TooltipProviderProps) {
116:   const tooltip = useTooltip(props)
117:   if (!props.useDelayGroup) {
118:     return (
119:       <TooltipContext.Provider value={tooltip}>
120:         {children}
121:       </TooltipContext.Provider>
122:     )
123:   }
124:   return (
125:     <FloatingDelayGroup
126:       delay={{ open: props.delay ?? 0, close: props.closeDelay ?? 0 }}
127:       timeoutMs={props.timeout}
128:     >
129:       <TooltipContext.Provider value={tooltip}>
130:         {children}
131:       </TooltipContext.Provider>
132:     </FloatingDelayGroup>
133:   )
134: }
135: export const TooltipTrigger = React.forwardRef<
136:   HTMLElement,
137:   TooltipTriggerProps
138: >(function TooltipTrigger({ children, asChild = false, ...props }, propRef) {
139:   const context = useTooltipContext()
140:   const childrenRef = React.isValidElement(children)
141:     ? parseInt(React.version, 10) >= 19
142:       ?
143:         (children as { props: { ref?: React.Ref<any> } }).props.ref
144:       :
145:         (children as any).ref
146:     : undefined
147:   const ref = useMergeRefs([context.refs.setReference, propRef, childrenRef])
148:   if (asChild && React.isValidElement(children)) {
149:     const dataAttributes = {
150:       "data-tooltip-state": context.open ? "open" : "closed",
151:     }
152:     return React.cloneElement(
153:       children,
154:       context.getReferenceProps({
155:         ref,
156:         ...props,
157:         ...(typeof children.props === "object" ? children.props : {}),
158:         ...dataAttributes,
159:       })
160:     )
161:   }
162:   return (
163:     <button
164:       ref={ref}
165:       data-tooltip-state={context.open ? "open" : "closed"}
166:       {...context.getReferenceProps(props)}
167:     >
168:       {children}
169:     </button>
170:   )
171: })
172: export const TooltipContent = React.forwardRef<
173:   HTMLDivElement,
174:   TooltipContentProps
175: >(function TooltipContent(
176:   { style, children, portal = true, portalProps = {}, ...props },
177:   propRef
178: ) {
179:   const context = useTooltipContext()
180:   const ref = useMergeRefs([context.refs.setFloating, propRef])
181:   if (!context.open) return null
182:   const content = (
183:     <div
184:       ref={ref}
185:       style={{
186:         ...context.floatingStyles,
187:         ...style,
188:       }}
189:       {...context.getFloatingProps(props)}
190:       className="tiptap-tooltip"
191:     >
192:       {children}
193:     </div>
194:   )
195:   if (portal) {
196:     return <FloatingPortal {...portalProps}>{content}</FloatingPortal>
197:   }
198:   return content
199: })
