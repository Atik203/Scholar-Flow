311:   private static extractCitationData(
312:     paper: any,
313:     options: CitationExportRequest
314:   ): CitationData {
315:     const metadata = (paper.metadata as any) || {};
316:     return {
317:       title: paper.title,
318:       authors: this.parseAuthors(
319:         metadata.authors || paper.uploader?.name || "Unknown Author"
320:       ),
321:       journal: metadata.journal || metadata.publication,
322:       year:
323:         metadata.year ||
324:         metadata.publicationYear ||
325:         new Date(paper.createdAt).getFullYear(),
326:       volume: metadata.volume,
327:       issue: metadata.issue,
328:       pages: metadata.pages,
329:       doi: paper.doi || metadata.doi,
330:       url: metadata.url || metadata.link,
331:       publisher: metadata.publisher,
332:       abstract: options.includeAbstract ? paper.abstract : undefined,
333:       keywords: options.includeKeywords ? metadata.keywords : undefined,
334:     };
335:   }
336:   private static parseAuthors(authors: any): string[] {
337:     if (typeof authors === "string") {
338:       return authors
339:         .split(/[,;]/)
340:         .map((a) => a.trim())
341:         .filter((a) => a);
342:     }
343:     if (Array.isArray(authors)) {
344:       return authors
345:         .map((a) => (typeof a === "string" ? a : a.name || a))
346:         .filter((a) => a);
347:     }
348:     return ["Unknown Author"];
349:   }
350:   private static formatCitations(
351:     citations: CitationData[],
352:     format: string
353:   ): string {
354:     switch (format) {
355:       case "BIBTEX":
356:         return this.formatBibTeX(citations);
357:       case "ENDNOTE":
358:         return this.formatEndNote(citations);
359:       case "APA":
360:         return this.formatAPA(citations);
361:       case "MLA":
362:         return this.formatMLA(citations);
363:       case "IEEE":
364:         return this.formatIEEE(citations);
365:       case "CHICAGO":
366:         return this.formatChicago(citations);
367:       case "HARVARD":
368:         return this.formatHarvard(citations);
369:       case "VANCOUVER":
370:         return this.formatVancouver(citations);
371:       case "ACS":
372:         return this.formatACS(citations);
373:       default:
374:         throw new ApiError(400, "Unsupported citation format");
375:     }
376:   }
377:   private static formatVancouver(citations: CitationData[]): string {
378:     return citations
379:       .map((citation, idx) => {
380:         const authors = citation.authors.join(", ");
381:         const title = citation.title;
382:         const journal = citation.journal || "";
383:         const year = citation.year || "n.d.";
384:         const parts: string[] = [];
385:         parts.push(`${idx + 1}. ${authors}.`);
386:         parts.push(`${title}.`);
387:         if (journal) {
388:           let j = `${journal}. ${year}`;
389:           if (citation.volume) {
390:             j += `;${citation.volume}`;
391:             if (citation.issue) j += `(${citation.issue})`;
392:           }
393:           if (citation.pages) j += `:${citation.pages}`;
394:           j += ".";
395:           parts.push(j);
396:         } else {
397:           parts.push(`${year}.`);
398:         }
399:         if (citation.doi) parts.push(`doi:${citation.doi}.`);
400:         return parts.join(" ");
401:       })
402:       .join("\n\n");
403:   }
404:   private static formatACS(citations: CitationData[]): string {
405:     return citations
406:       .map((citation) => {
407:         const authors = citation.authors.join("; ");
408:         const title = citation.title;
409:         const journal = citation.journal || "";
410:         const year = citation.year || "n.d.";
411:         let acs = `${authors}. ${title}. `;
412:         if (journal) {
413:           acs += `${journal} `;
414:           if (citation.year) acs += `${year}`;
415:           if (citation.volume) acs += `, ${citation.volume}`;
416:           if (citation.issue) acs += ` (${citation.issue})`;
417:           if (citation.pages) acs += `, ${citation.pages}`;
418:           acs += ".";
419:         } else {
420:           acs += `${year}.`;
421:         }
422:         if (citation.doi) acs += ` DOI: ${citation.doi}.`;
423:         return acs;
424:       })
425:       .join("\n\n");
426:   }
427:   private static formatBibTeX(citations: CitationData[]): string {
428:     return citations
429:       .map((citation, index) => {
430:         const key = `paper${index + 1}`;
431:         const authors = citation.authors.join(" and ");
432:         let bibtex = `@article{${key},\n`;
433:         bibtex += `  title = {${citation.title}},\n`;
434:         bibtex += `  author = {${authors}},\n`;
435:         if (citation.journal) bibtex += `  journal = {${citation.journal}},\n`;
436:         if (citation.year) bibtex += `  year = {${citation.year}},\n`;
437:         if (citation.volume) bibtex += `  volume = {${citation.volume}},\n`;
438:         if (citation.issue) bibtex += `  number = {${citation.issue}},\n`;
439:         if (citation.pages) bibtex += `  pages = {${citation.pages}},\n`;
440:         if (citation.doi) bibtex += `  doi = {${citation.doi}},\n`;
441:         if (citation.url) bibtex += `  url = {${citation.url}},\n`;
442:         if (citation.publisher)
443:           bibtex += `  publisher = {${citation.publisher}},\n`;
444:         if (citation.abstract)
445:           bibtex += `  abstract = {${citation.abstract}},\n`;
446:         bibtex += "}";
447:         return bibtex;
448:       })
449:       .join("\n\n");
450:   }
451:   private static formatEndNote(citations: CitationData[]): string {
452:     return citations
453:       .map((citation) => {
454:         let endnote = `%0 Journal Article\n`;
455:         endnote += `%T ${citation.title}\n`;
456:         endnote += `%A ${citation.authors.join("\n%A ")}\n`;
457:         if (citation.journal) endnote += `%J ${citation.journal}\n`;
458:         if (citation.year) endnote += `%D ${citation.year}\n`;
459:         if (citation.volume) endnote += `%V ${citation.volume}\n`;
460:         if (citation.issue) endnote += `%N ${citation.issue}\n`;
461:         if (citation.pages) endnote += `%P ${citation.pages}\n`;
462:         if (citation.doi) endnote += `%R ${citation.doi}\n`;
463:         if (citation.url) endnote += `%U ${citation.url}\n`;
464:         if (citation.publisher) endnote += `%I ${citation.publisher}\n`;
465:         if (citation.abstract) endnote += `%X ${citation.abstract}\n`;
466:         return endnote;
467:       })
468:       .join("\n\n");
469:   }
470:   private static formatAPA(citations: CitationData[]): string {
