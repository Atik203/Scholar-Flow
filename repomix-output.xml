39: export interface ButtonProps
40:   extends React.ComponentProps<"button">,
41:     VariantProps<typeof buttonVariants> {
42:   asChild?: boolean;
43:   loading?: boolean;
44:   loadingText?: string;
45: }
46: function Button({
47:   className,
48:   variant,
49:   size,
50:   asChild = false,
51:   loading = false,
52:   loadingText,
53:   children,
54:   disabled,
55:   ...props
56: }: ButtonProps) {
57:   const isDisabled = disabled || loading;
58:   if (asChild) {
59:     return (
60:       <Slot
61:         className={cn(buttonVariants({ variant, size, className }))}
62:         {...(props as any)}
63:         disabled={isDisabled}
64:       >
65:         {loading ? (
66:           <span className="flex items-center gap-2">
67:             <Loader2 className="h-4 w-4 animate-spin" />
68:             {loadingText || children}
69:           </span>
70:         ) : (
71:           children
72:         )}
73:       </Slot>
74:     );
75:   }
76:   return (
77:     <button
78:       className={cn(buttonVariants({ variant, size, className }))}
79:       disabled={isDisabled}
80:       {...props}
81:     >
82:       {loading && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}
83:       {loading && loadingText ? loadingText : children}
84:     </button>
85:   );
86: }
87: export { Button, buttonVariants };
