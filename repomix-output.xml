  5: import { formatDistanceToNow } from "date-fns";
  6: import {
  7:   Bell,
  8:   Check,
  9:   CheckCheck,
 10:   ExternalLink,
 11:   Settings as SettingsIcon,
 12: } from "lucide-react";
 13: import { Button } from "@/components/ui/button";
 14: import {
 15:   useGetNotificationsQuery,
 16:   useGetUnreadCountQuery,
 17:   useMarkAllAsReadMutation,
 18:   useMarkAsReadMutation,
 19:   type AppNotification,
 20: } from "@/redux/api/notificationApi";
 21: import { useNotificationStream } from "@/hooks/useNotificationStream";
 22: import { showErrorToast, showSuccessToast } from "@/components/providers/ToastProvider";
 23: const TYPE_ICON: Record<string, string> = {
 24:   MENTION: "💬",
 25:   COMMENT: "💭",
 26:   SHARE: "🔗",
 27:   INVITE: "✉️",
 28:   PAPER: "📄",
 29:   COLLECTION: "📁",
 30:   ACHIEVEMENT: "⭐",
 31:   SYSTEM: "⚙️",
 32: };
 33: export function NotificationBell() {
 34:   const [isOpen, setIsOpen] = useState(false);
 35:   const containerRef = useRef<HTMLDivElement>(null);
 36:   const { data: countData } = useGetUnreadCountQuery(undefined, {
 37:     pollingInterval: 15000,
 38:   });
 39:   const { data: listData, refetch } = useGetNotificationsQuery(
 40:     { limit: 8 },
 41:     { pollingInterval: 15000 }
 42:   );
 43:   const [markAsRead] = useMarkAsReadMutation();
 44:   const [markAllAsRead] = useMarkAllAsReadMutation();
 45:   const unread = countData?.data?.count ?? 0;
 46:   const recent = (listData?.data ?? []).slice(0, 8);
 47:   useNotificationStream();
 48:   useEffect(() => {
 49:     const onClick = (e: MouseEvent) => {
 50:       if (
 51:         containerRef.current &&
 52:         !containerRef.current.contains(e.target as Node)
 53:       ) {
 54:         setIsOpen(false);
 55:       }
 56:     };
 57:     if (isOpen) document.addEventListener("mousedown", onClick);
 58:     return () => document.removeEventListener("mousedown", onClick);
 59:   }, [isOpen]);
 60:   const handleMarkAll = async () => {
 61:     try {
 62:       await markAllAsRead().unwrap();
 63:       showSuccessToast("Done", "All notifications marked as read");
 64:       refetch();
 65:     } catch {
 66:       showErrorToast("Failed", "Could not mark all as read");
 67:     }
 68:   };
 69:   const handleItemClick = async (n: AppNotification) => {
 70:     if (!n.read) {
 71:       try {
 72:         await markAsRead(n.id).unwrap();
 73:       } catch {
 74:       }
 75:     }
 76:     setIsOpen(false);
 77:   };
 78:   return (
 79:     <div ref={containerRef} className="relative">
 80:       <Button
 81:         variant="ghost"
 82:         size="icon"
 83:         onClick={() => setIsOpen(!isOpen)}
 84:         className="relative text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
 85:         aria-label="Notifications"
 86:       >
 87:         <Bell className="h-5 w-5" />
 88:         {unread > 0 && (
 89:           <span className="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] font-bold flex items-center justify-center border-2 border-white dark:border-gray-900">
 90:             {unread > 99 ? "99+" : unread}
 91:           </span>
 92:         )}
 93:       </Button>
 94:       <AnimatePresence>
 95:         {isOpen && (
 96:           <motion.div
 97:             initial={{ opacity: 0, y: -8, scale: 0.96 }}
 98:             animate={{ opacity: 1, y: 0, scale: 1 }}
 99:             exit={{ opacity: 0, y: -8, scale: 0.96 }}
100:             transition={{ duration: 0.15 }}
101:             className="absolute right-0 mt-2 w-96 max-w-[calc(100vw-2rem)] bg-card rounded-xl border shadow-xl z-50 overflow-hidden"
102:           >
103:             <div className="flex items-center justify-between px-4 py-3 border-b">
104:               <h3 className="font-semibold">Notifications</h3>
105:               <div className="flex items-center gap-1">
106:                 {unread > 0 && (
107:                   <Button
108:                     variant="ghost"
109:                     size="sm"
110:                     onClick={handleMarkAll}
111:                     className="text-xs h-7"
112:                   >
113:                     <CheckCheck className="h-3 w-3 mr-1" />
114:                     Mark all read
115:                   </Button>
116:                 )}
117:                 <Button
118:                   variant="ghost"
119:                   size="icon"
120:                   className="h-7 w-7"
121:                   asChild
122:                   onClick={() => setIsOpen(false)}
123:                 >
124:                   <Link href="/dashboard/notifications/settings">
125:                     <SettingsIcon className="h-3.5 w-3.5" />
126:                   </Link>
127:                 </Button>
128:               </div>
129:             </div>
130:             <div className="max-h-96 overflow-y-auto">
131:               {recent.length === 0 ? (
132:                 <div className="p-8 text-center text-sm text-muted-foreground">
133:                   <Bell className="w-8 h-8 mx-auto mb-2 opacity-50" />
134:                   You're all caught up
135:                 </div>
136:               ) : (
137:                 <div className="divide-y">
138:                   {recent.map((n) => (
