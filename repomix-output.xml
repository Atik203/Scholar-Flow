360: /**
361:  * Handle subscription updated event
362:  */
363: async function handleSubscriptionUpdated(
364:   subscription: Stripe.Subscription,
365:   eventType: StripeWebhookEventType
366: ): Promise<void> {
367:   const status = mapStripeStatus(subscription.status);
368:   const { currentPeriodStart, currentPeriodEnd } =
369:     getSubscriptionPeriodBounds(subscription);
370:   if (currentPeriodEnd === null) {
371:     throw BillingError.webhookProcessingFailed(
372:       eventType,
373:       "Stripe subscription missing current period end"
374:     );
375:   }
376:   await prismaClient.$executeRaw`
377:     UPDATE "Subscription"
378:     SET
379:       status = ${status}::"SubscriptionStatus",
380:       "currentPeriodStart" = ${toTimestampSql(currentPeriodStart)},
381:       "currentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
382:       "cancelAtPeriodEnd" = ${subscription.cancel_at_period_end},
383:       "canceledAt" = ${subscription.canceled_at ? Prisma.sql`to_timestamp(${Number(subscription.canceled_at)})` : null},
384:       "expiresAt" = ${toTimestampSql(currentPeriodEnd)},
385:       "updatedAt" = NOW()
386:     WHERE "providerSubscriptionId" = ${subscription.id}
387:   `;
388:   const stripePriceId = subscription.items.data[0]?.price?.id || null;
389:   if (stripePriceId) {
390:     const user = await prismaClient.$queryRaw<Array<{ id: string }>>`
391:       SELECT id
392:       FROM "User"
393:       WHERE "stripeCustomerId" = ${subscription.customer as string}
394:       LIMIT 1
395:     `;
396:     if (user.length > 0) {
397:       const userId = user[0].id;
398:       const userRole = getRoleFromPriceId(stripePriceId);
399:       if (status === SUBSCRIPTION_STATUS.ACTIVE) {
400:         await prismaClient.$executeRaw`
401:           UPDATE "User"
402:           SET
403:             role = ${userRole}::"Role",
404:             "stripeSubscriptionId" = ${subscription.id},
405:             "stripePriceId" = ${stripePriceId},
406:             "stripeCurrentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
407:             "updatedAt" = NOW()
408:           WHERE id = ${userId}
409:         `;
410:         logDebug(`User ${userId} role updated to ${userRole}`);
411:       } else {
412:         // Just update subscription fields without changing role
413:         await prismaClient.$executeRaw`
414:           UPDATE "User"
415:           SET
416:             "stripeSubscriptionId" = ${subscription.id},
417:             "stripePriceId" = ${stripePriceId},
418:             "stripeCurrentPeriodEnd" = ${toTimestampSql(currentPeriodEnd)},
419:             "updatedAt" = NOW()
420:           WHERE id = ${userId}
421:         `;
422:       }
423:     }
424:   }
425:   logDebug(`Subscription updated: ${subscription.id}`);
426: }
427: /**
428:  * Handle subscription deleted event
429:  */
430: async function handleSubscriptionDeleted(
431:   subscription: Stripe.Subscription
432: ): Promise<void> {
433:   await prismaClient.$executeRaw`
434:     UPDATE "Subscription"
435:     SET
436:       status = 'CANCELED'::"SubscriptionStatus",
437:       "canceledAt" = NOW(),
438:       "updatedAt" = NOW()
439:     WHERE "providerSubscriptionId" = ${subscription.id}
440:   `;
441:   // Find user by Stripe customer ID and revert to free tier
442:   const user = await prismaClient.$queryRaw<Array<{ id: string }>>`
443:     SELECT id
444:     FROM "User"
445:     WHERE "stripeCustomerId" = ${subscription.customer as string}
446:     LIMIT 1
447:   `;
448:   if (user.length > 0) {
449:     const userId = user[0].id;
450:     // Revert user to RESEARCHER role (free tier) and clear Stripe fields
451:     await prismaClient.$executeRaw`
452:       UPDATE "User"
453:       SET
454:         role = 'RESEARCHER',
455:         "stripeSubscriptionId" = NULL,
456:         "stripePriceId" = NULL,
457:         "stripeCurrentPeriodEnd" = NULL,
458:         "updatedAt" = NOW()
459:       WHERE id = ${userId}
460:     `;
461:     logDebug(`User ${userId} role reverted to RESEARCHER (free tier)`);
462:   }
463:   logDebug(`Subscription canceled: ${subscription.id}`);
464: }
465: /**
466:  * Handle invoice paid event
467:  */
