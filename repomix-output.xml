<file path="apps/frontend/src/hooks/use-async.ts">
 1: import * as React from "react";
 2: import { useCallback, useRef, useState } from "react";
 3: export interface AsyncState<T> {
 4:   data: T | null;
 5:   loading: boolean;
 6:   error: Error | null;
 7: }
 8: export interface AsyncActions<T> {
 9:   execute: (...args: any[]) => Promise<T>;
10:   reset: () => void;
11:   cancel: () => void;
12: }
13: export function useAsync<T>(
14:   asyncFunction: (...args: any[]) => Promise<T>,
15:   immediate = false
16: ): AsyncState<T> & AsyncActions<T> {
17:   const [state, setState] = useState<AsyncState<T>>({
18:     data: null,
19:     loading: false,
20:     error: null,
21:   });
22:   const abortControllerRef = useRef<AbortController | null>(null);
23:   const execute = useCallback(
24:     async (...args: any[]) => {
25:       setState((prev) => ({ ...prev, loading: true, error: null }));
26:       try {
27:         if (abortControllerRef.current) {
28:           abortControllerRef.current.abort();
29:         }
30:         abortControllerRef.current = new AbortController();
31:         const result = await asyncFunction(...args);
32:         if (abortControllerRef.current.signal.aborted) {
33:           throw new Error("Request was cancelled");
34:         }
35:         setState((prev) => ({ ...prev, data: result, loading: false }));
36:         return result;
37:       } catch (error) {
38:         if (abortControllerRef.current?.signal.aborted) {
39:           throw new Error("Request was cancelled");
40:         }
41:         setState((prev) => ({
42:           ...prev,
43:           error: error instanceof Error ? error : new Error(String(error)),
44:           loading: false,
45:         }));
46:         throw error;
47:       }
48:     },
49:     [asyncFunction]
50:   );
51:   const reset = useCallback(() => {
52:     setState({ data: null, loading: false, error: null });
53:   }, []);
54:   const cancel = useCallback(() => {
55:     if (abortControllerRef.current) {
56:       abortControllerRef.current.abort();
57:       setState((prev) => ({ ...prev, loading: false }));
58:     }
59:   }, []);
60:   React.useEffect(() => {
61:     if (immediate) {
62:       execute();
63:     }
64:   }, [execute, immediate]);
65:   return {
66:     ...state,
67:     execute,
68:     reset,
69:     cancel,
70:   };
71: }
72: export function useAsyncCallback<T>(
73:   asyncFunction: (...args: any[]) => Promise<T>
74: ): [AsyncState<T>, (...args: any[]) => Promise<T>] {
75:   const { execute, ...state } = useAsync(asyncFunction);
76:   return [state, execute];
77: }
78: export function useAsyncEffect<T>(
79:   asyncFunction: () => Promise<T>,
80:   deps: React.DependencyList = []
81: ): AsyncState<T> {
82:   const { execute, ...state } = useAsync(asyncFunction);
83:   React.useEffect(() => {
84:     execute().catch(() => {
85:     });
86:   }, [execute, ...deps]);
87:   return state;
88: }
</file>

<file path="apps/frontend/src/hooks/use-click-outside.ts">
 1: import { RefObject, useEffect } from "react";
 2: export function useClickOutside<T extends HTMLElement = HTMLElement>(
 3:   ref: RefObject<T>,
 4:   handler: (event: MouseEvent | TouchEvent) => void
 5: ) {
 6:   useEffect(() => {
 7:     const listener = (event: MouseEvent | TouchEvent) => {
 8:       const el = ref?.current;
 9:       if (!el || el.contains((event?.target as Node) || null)) {
10:         return;
11:       }
12:       handler(event);
13:     };
14:     document.addEventListener("mousedown", listener);
15:     document.addEventListener("touchstart", listener);
16:     return () => {
17:       document.removeEventListener("mousedown", listener);
18:       document.removeEventListener("touchstart", listener);
19:     };
20:   }, [ref, handler]);
21: }
</file>

<file path="apps/frontend/src/hooks/use-composed-ref.ts">
 1: "use client"
 2: import * as React from "react"
 3: type UserRef<T> =
 4:   | ((instance: T | null) => void)
 5:   | React.RefObject<T | null>
 6:   | null
 7:   | undefined
 8: const updateRef = <T>(ref: NonNullable<UserRef<T>>, value: T | null) => {
 9:   if (typeof ref === "function") {
10:     ref(value)
11:   } else if (ref && typeof ref === "object" && "current" in ref) {
12:     ;(ref as { current: T | null }).current = value
13:   }
14: }
15: export const useComposedRef = <T extends HTMLElement>(
16:   libRef: React.RefObject<T | null>,
17:   userRef: UserRef<T>
18: ) => {
19:   const prevUserRef = React.useRef<UserRef<T>>(null)
20:   return React.useCallback(
21:     (instance: T | null) => {
22:       if (libRef && "current" in libRef) {
23:         ;(libRef as { current: T | null }).current = instance
24:       }
25:       if (prevUserRef.current) {
26:         updateRef(prevUserRef.current, null)
27:       }
28:       prevUserRef.current = userRef
29:       if (userRef) {
30:         updateRef(userRef, instance)
31:       }
32:     },
33:     [libRef, userRef]
34:   )
35: }
36: export default useComposedRef
</file>

<file path="apps/frontend/src/hooks/use-cursor-visibility.ts">
 1: "use client"
 2: import * as React from "react"
 3: import type { Editor } from "@tiptap/react"
 4: import { useWindowSize } from "@/hooks/use-window-size"
 5: import { useBodyRect } from "./use-element-rect"
 6: export interface CursorVisibilityOptions {
 7:   editor?: Editor | null
 8:   overlayHeight?: number
 9: }
10: export function useCursorVisibility({
11:   editor,
12:   overlayHeight = 0,
13: }: CursorVisibilityOptions) {
14:   const { height: windowHeight } = useWindowSize()
15:   const rect = useBodyRect({
16:     enabled: true,
17:     throttleMs: 100,
18:     useResizeObserver: true,
19:   })
20:   React.useEffect(() => {
21:     const ensureCursorVisibility = () => {
22:       if (!editor) return
23:       const { state, view } = editor
24:       if (!view.hasFocus()) return
25:       const { from } = state.selection
26:       const cursorCoords = view.coordsAtPos(from)
27:       if (windowHeight < rect.height && cursorCoords) {
28:         const availableSpace = windowHeight - cursorCoords.top
29:         if (availableSpace < overlayHeight) {
30:           const targetCursorY = Math.max(windowHeight / 2, overlayHeight)
31:           const currentScrollY = window.scrollY
32:           const cursorAbsoluteY = cursorCoords.top + currentScrollY
33:           const newScrollY = cursorAbsoluteY - targetCursorY
34:           window.scrollTo({
35:             top: Math.max(0, newScrollY),
36:             behavior: "smooth",
37:           })
38:         }
39:       }
40:     }
41:     ensureCursorVisibility()
42:   }, [editor, overlayHeight, windowHeight, rect.height])
43:   return rect
44: }
</file>

<file path="apps/frontend/src/hooks/use-debounce.ts">
 1: import { useEffect, useState } from "react";
 2: export function useDebounce<T>(value: T, delay: number): T {
 3:   const [debouncedValue, setDebouncedValue] = useState<T>(value);
 4:   useEffect(() => {
 5:     const handler = setTimeout(() => {
 6:       setDebouncedValue(value);
 7:     }, delay);
 8:     return () => {
 9:       clearTimeout(handler);
10:     };
11:   }, [value, delay]);
12:   return debouncedValue;
13: }
</file>

<file path="apps/frontend/src/hooks/use-element-rect.ts">
  1: "use client"
  2: import * as React from "react"
  3: import { useThrottledCallback } from "./use-throttled-callback"
  4: export type RectState = Omit<DOMRect, "toJSON">
  5: export interface ElementRectOptions {
  6:   element?: Element | React.RefObject<Element> | string | null
  7:   enabled?: boolean
  8:   throttleMs?: number
  9:   useResizeObserver?: boolean
 10: }
 11: const initialRect: RectState = {
 12:   x: 0,
 13:   y: 0,
 14:   width: 0,
 15:   height: 0,
 16:   top: 0,
 17:   right: 0,
 18:   bottom: 0,
 19:   left: 0,
 20: }
 21: const isSSR = typeof window === "undefined"
 22: const hasResizeObserver = !isSSR && typeof ResizeObserver !== "undefined"
 23: const isClientSide = (): boolean => !isSSR
 24: export function useElementRect({
 25:   element,
 26:   enabled = true,
 27:   throttleMs = 100,
 28:   useResizeObserver = true,
 29: }: ElementRectOptions = {}): RectState {
 30:   const [rect, setRect] = React.useState<RectState>(initialRect)
 31:   const getTargetElement = React.useCallback((): Element | null => {
 32:     if (!enabled || !isClientSide()) return null
 33:     if (!element) {
 34:       return document.body
 35:     }
 36:     if (typeof element === "string") {
 37:       return document.querySelector(element)
 38:     }
 39:     if ("current" in element) {
 40:       return element.current
 41:     }
 42:     return element
 43:   }, [element, enabled])
 44:   const updateRect = useThrottledCallback(
 45:     () => {
 46:       if (!enabled || !isClientSide()) return
 47:       const targetElement = getTargetElement()
 48:       if (!targetElement) {
 49:         setRect(initialRect)
 50:         return
 51:       }
 52:       const newRect = targetElement.getBoundingClientRect()
 53:       setRect({
 54:         x: newRect.x,
 55:         y: newRect.y,
 56:         width: newRect.width,
 57:         height: newRect.height,
 58:         top: newRect.top,
 59:         right: newRect.right,
 60:         bottom: newRect.bottom,
 61:         left: newRect.left,
 62:       })
 63:     },
 64:     throttleMs,
 65:     [enabled, getTargetElement],
 66:     { leading: true, trailing: true }
 67:   )
 68:   React.useEffect(() => {
 69:     if (!enabled || !isClientSide()) {
 70:       setRect(initialRect)
 71:       return
 72:     }
 73:     const targetElement = getTargetElement()
 74:     if (!targetElement) return
 75:     updateRect()
 76:     const cleanup: (() => void)[] = []
 77:     if (useResizeObserver && hasResizeObserver) {
 78:       const resizeObserver = new ResizeObserver(() => {
 79:         window.requestAnimationFrame(updateRect)
 80:       })
 81:       resizeObserver.observe(targetElement)
 82:       cleanup.push(() => resizeObserver.disconnect())
 83:     }
 84:     const handleUpdate = () => updateRect()
 85:     window.addEventListener("scroll", handleUpdate, { passive: true })
 86:     window.addEventListener("resize", handleUpdate, { passive: true })
 87:     cleanup.push(() => {
 88:       window.removeEventListener("scroll", handleUpdate)
 89:       window.removeEventListener("resize", handleUpdate)
 90:     })
 91:     return () => {
 92:       cleanup.forEach((fn) => fn())
 93:       setRect(initialRect)
 94:     }
 95:   }, [enabled, getTargetElement, updateRect, useResizeObserver])
 96:   return rect
 97: }
 98: export function useBodyRect(
 99:   options: Omit<ElementRectOptions, "element"> = {}
100: ): RectState {
101:   return useElementRect({
102:     ...options,
103:     element: isClientSide() ? document.body : null,
104:   })
105: }
106: export function useRefRect<T extends Element>(
107:   ref: React.RefObject<T>,
108:   options: Omit<ElementRectOptions, "element"> = {}
109: ): RectState {
110:   return useElementRect({ ...options, element: ref })
111: }
</file>

<file path="apps/frontend/src/hooks/use-keyboard-shortcut.ts">
 1: import { useCallback, useEffect } from "react";
 2: export type KeyCombo = string[];
 3: export type KeyboardShortcutHandler = (e: KeyboardEvent) => void;
 4: export interface KeyboardShortcutOptions {
 5:   preventDefault?: boolean;
 6:   stopPropagation?: boolean;
 7:   target?: EventTarget;
 8: }
 9: export function useKeyboardShortcut(
10:   keys: KeyCombo,
11:   handler: KeyboardShortcutHandler,
12:   options: KeyboardShortcutOptions = {}
13: ) {
14:   const {
15:     preventDefault = true,
16:     stopPropagation = false,
17:     target = document,
18:   } = options;
19:   const handleKeyDown = useCallback(
20:     (e: Event) => {
21:       const keyboardEvent = e as KeyboardEvent;
22:       const pressedKeys = [
23:         keyboardEvent.ctrlKey && "Ctrl",
24:         keyboardEvent.altKey && "Alt",
25:         keyboardEvent.shiftKey && "Shift",
26:         keyboardEvent.metaKey && "Meta",
27:         keyboardEvent.key !== "Control" &&
28:           keyboardEvent.key !== "Alt" &&
29:           keyboardEvent.key !== "Shift" &&
30:           keyboardEvent.key !== "Meta" &&
31:           keyboardEvent.key,
32:       ].filter(Boolean) as string[];
33:       const isMatch =
34:         keys.every((key) => pressedKeys.includes(key)) &&
35:         pressedKeys.length === keys.length;
36:       if (isMatch) {
37:         if (preventDefault) {
38:           keyboardEvent.preventDefault();
39:         }
40:         if (stopPropagation) {
41:           keyboardEvent.stopPropagation();
42:         }
43:         handler(keyboardEvent);
44:       }
45:     },
46:     [keys, handler, preventDefault, stopPropagation]
47:   );
48:   useEffect(() => {
49:     target.addEventListener("keydown", handleKeyDown);
50:     return () => target.removeEventListener("keydown", handleKeyDown);
51:   }, [target, handleKeyDown]);
52: }
53: export function useCtrlK(handler: () => void) {
54:   useKeyboardShortcut(["Ctrl", "k"], () => handler());
55: }
56: export function useEscape(handler: () => void) {
57:   useKeyboardShortcut(["Escape"], () => handler());
58: }
59: export function useEnter(handler: () => void) {
60:   useKeyboardShortcut(["Enter"], () => handler());
61: }
62: export function useDelete(handler: () => void) {
63:   useKeyboardShortcut(["Delete"], () => handler());
64: }
65: export function useBackspace(handler: () => void) {
66:   useKeyboardShortcut(["Backspace"], () => handler());
67: }
</file>

<file path="apps/frontend/src/hooks/use-local-storage.ts">
 1: import { useState } from "react";
 2: export function useLocalStorage<T>(
 3:   key: string,
 4:   initialValue: T
 5: ): [T, (value: T | ((val: T) => T)) => void] {
 6:   const [storedValue, setStoredValue] = useState<T>(() => {
 7:     if (typeof window === "undefined") {
 8:       return initialValue;
 9:     }
10:     try {
11:       const item = window.localStorage.getItem(key);
12:       return item ? JSON.parse(item) : initialValue;
13:     } catch (error) {
14:       console.log(error);
15:       return initialValue;
16:     }
17:   });
18:   const setValue = (value: T | ((val: T) => T)) => {
19:     try {
20:       const valueToStore =
21:         value instanceof Function ? value(storedValue) : value;
22:       setStoredValue(valueToStore);
23:       if (typeof window !== "undefined") {
24:         window.localStorage.setItem(key, JSON.stringify(valueToStore));
25:       }
26:     } catch (error) {
27:       console.log(error);
28:     }
29:   };
30:   return [storedValue, setValue];
31: }
</file>

