 10: const MAX_SAMPLE_TEXT_CHARS = 3000;
 11: const MAX_RELATED_PAPERS = 5;
 12: const MAX_RECENT_PAPERS = 5;
 13: function buildSystemPrompt(
 14:   context: AiContext,
 15:   basePrompt = "You are a helpful research assistant."
 16: ): ContextInjectionResult {
 17:   let userContext = "";
 18:   let tokenEstimate = 0;
 19:   if (context.type === "paper") {
 20:     const p = context.paper;
 21:     userContext = `The user is currently viewing a research paper:
 22: Title: ${p.title}
 23: ${p.abstract ? `Abstract: ${p.abstract.slice(0, 500)}` : "No abstract available."}
 24: ${p.authors.length > 0 ? `Authors: ${p.authors.join(", ")}` : ""}
 25: ${p.tags.length > 0 ? `Tags: ${p.tags.join(", ")}` : ""}
 26: Status: ${p.processingStatus}
 27: Language: ${p.language || "unknown"}
 28: `;
 29:     if (context.aiSummary) {
 30:       userContext += `Paper summary: ${context.aiSummary.slice(0, 1000)}\n\n`;
 31:     }
 32:     if (context.aiKeyPoints.length > 0) {
 33:       userContext += `Key points extracted from this paper:\n`;
 34:       for (const kp of context.aiKeyPoints) {
 35:         userContext += `- ${kp.content}\n`;
 36:       }
 37:       userContext += "\n";
 38:     }
 39:     if (context.sampleText) {
 40:       userContext += `Paper text excerpt:\n${context.sampleText.slice(0, MAX_SAMPLE_TEXT_CHARS)}\n\n`;
 41:     }
 42:     userContext += `This paper belongs to workspace: ${context.workspace.name}.\n`;
 43:     if (context.relatedPapers.length > 0) {
 44:       userContext += `Related papers:\n`;
 45:       for (const rp of context.relatedPapers) {
 46:         userContext += `- ${rp.title}\n`;
 47:       }
 48:       userContext += "\n";
 49:     }
 50:     tokenEstimate = Math.ceil(userContext.length / 4);
 51:   } else if (context.type === "workspace") {
 52:     const w = context.workspace;
 53:     userContext = `The user is currently viewing a research workspace:
 54: Name: ${w.name}
 55: ${w.description ? `Description: ${w.description}` : ""}
 56: ${w.goals ? `Goals: ${w.goals}` : ""}
 57: Members: ${context.memberCount}
 58: Papers: ${context.paperCount}
 59: `;
 60:     if (context.recentPapers.length > 0) {
 61:       userContext += `Recent papers in this workspace:\n`;
 62:       for (const rp of context.recentPapers) {
 63:         userContext += `- ${rp.title}\n`;
 64:       }
 65:       userContext += "\n";
 66:     }
 67:     tokenEstimate = Math.ceil(userContext.length / 4);
 68:   } else {
 69:     const u = context.user;
 70:     userContext = `The user ${u.name ? `(${u.name})` : ""} is on their dashboard.
 71: Role: ${u.role}\n`;
 72:     if (context.recentPapers.length > 0) {
 73:       userContext += `Recent papers:\n`;
 74:       for (const rp of context.recentPapers) {
 75:         userContext += `- ${rp.title}\n`;
 76:       }
 77:       userContext += "\n";
 78:     }
 79:     if (context.activeWorkspaces.length > 0) {
 80:       userContext += `Active workspaces:\n`;
 81:       for (const w of context.activeWorkspaces) {
 82:         userContext += `- ${w.name}\n`;
 83:       }
 84:       userContext += "\n";
 85:     }
 86:     tokenEstimate = Math.ceil(userContext.length / 4);
 87:   }
 88:   const systemPrompt = `${basePrompt}
 89: Current page context (use this to answer naturally without the user needing to repeat information):
 90: ${userContext}`;
 91:   return { systemPrompt, userContext, tokenEstimate };
 92: }
 93: async function buildPaperContext(
 94:   paperId: string,
 95:   userId: string
 96: ): Promise<PaperContext> {
 97:   const accessRows = await prisma.$queryRaw<Array<{ allowed: boolean }>>`
 98:     SELECT EXISTS (
 99:       SELECT 1
100:       FROM "Paper" p
101:       LEFT JOIN "Workspace" w
102:         ON w.id = p."workspaceId" AND w."isDeleted" = false
103:       LEFT JOIN "WorkspaceMember" m
104:         ON m."workspaceId" = p."workspaceId"
105:         AND m."userId" = ${userId}
106:         AND m."isDeleted" = false
107:       WHERE p.id = ${paperId}
108:         AND p."isDeleted" = false
109:         AND (
110:           p."uploaderId" = ${userId}
111:           OR w."ownerId" = ${userId}
112:           OR m.id IS NOT NULL
113:         )
114:     ) AS "allowed"
115:   `;
116:   if (!accessRows[0]?.allowed) {
117:     throw new Error("You do not have access to this paper");
118:   }
119:   const paper = await prisma.paper.findUnique({
120:     where: { id: paperId, isDeleted: false },
121:     include: {
122:       workspace: { select: { id: true, name: true } },
123:       chunks: { select: { content: true }, orderBy: { idx: "asc" }, take: 2 },
124:       annotations: { select: { id: true }, where: { isDeleted: false } },
125:       researchNotes: { select: { id: true }, where: { isDeleted: false } },
126:       aiSummaries: { select: { summary: true }, orderBy: { createdAt: "desc" }, take: 1 },
127:       aiKeyPoints: {
128:         select: { content: true, category: true },
129:         where: { isDeleted: false },
130:         orderBy: { order: "asc" },
131:       },
132:       collectionJoins: {
133:         select: {
134:           collection: {
135:             select: {
136:               papers: {
137:                 select: { paper: { select: { id: true, title: true } } },
138:                 where: { paperId: { not: paperId } },
139:                 take: MAX_RELATED_PAPERS,
140:               },
141:             },
142:           },
143:         },
144:         take: 1,
145:       },
146:     },
147:   }) as Record<string, any> | null;
148:   if (!paper) throw new Error("Paper not found");
149:   const summary = paper.aiSummaries?.[0]?.summary || null;
150:   const sampleText = (paper.chunks as any[])
151:     ?.map((c: any) => c.content)
152:     .join("\n")
153:     .slice(0, MAX_SAMPLE_TEXT_CHARS);
154:   const relatedPapers =
155:     paper.collectionJoins?.[0]?.collection?.papers?.map((cp: any) => ({
156:       id: cp.paper.id,
157:       title: cp.paper.title,
158:     })) || [];
159:   return {
160:     type: "paper",
161:     paper: {
162:       id: paper.id,
163:       title: paper.title,
164:       abstract: paper.abstract,
165:       authors: (paper.metadata as any)?.authors || [],
166:       tags: paper.tags,
167:       doi: paper.doi,
168:       language: paper.language,
169:       processingStatus: paper.processingStatus,
170:     },
171:     aiSummary: summary,
172:     aiKeyPoints: (paper.aiKeyPoints || []).map((kp: any) => ({
173:       content: kp.content,
174:       category: kp.category,
175:     })),
176:     chunkCount: paper.chunks?.length || 0,
177:     sampleText,
178:     workspace: {
179:       id: paper.workspace.id,
180:       name: paper.workspace.name,
181:       aiFeaturesEnabled: true,
182:     },
183:     annotationsCount: paper.annotations?.length || 0,
184:     notesCount: paper.researchNotes?.length || 0,
185:     relatedPapers,
186:   };
187: }
188: async function buildWorkspaceContext(
189:   workspaceId: string,
190:   userId: string
191: ): Promise<WorkspaceContext> {
192:   const accessRows = await prisma.$queryRaw<Array<{ allowed: boolean }>>`
193:     SELECT EXISTS (
194:       SELECT 1
195:       FROM "Workspace" w
196:       LEFT JOIN "WorkspaceMember" m
197:         ON m."workspaceId" = w.id
198:         AND m."userId" = ${userId}
199:         AND m."isDeleted" = false
200:       WHERE w.id = ${workspaceId}
201:         AND w."isDeleted" = false
202:         AND (w."ownerId" = ${userId} OR m.id IS NOT NULL)
203:     ) AS "allowed"
204:   `;
205:   if (!accessRows[0]?.allowed) {
206:     throw new Error("You do not have access to this workspace");
207:   }
208:   const workspace = await prisma.workspace.findUnique({
209:     where: { id: workspaceId, isDeleted: false },
210:     include: {
211:       _count: { select: { members: true, papers: true } },
212:       papers: {
213:         select: { id: true, title: true, createdAt: true },
214:         where: { isDeleted: false },
215:         orderBy: { createdAt: "desc" },
216:         take: MAX_RECENT_PAPERS,
217:       },
218:     },
219:   }) as Record<string, any> | null;
220:   if (!workspace) throw new Error("Workspace not found");
221:   const recentActivity = workspace.papers?.length > 0
222:     ? `Most recent paper: "${workspace.papers[0].title}"`
223:     : "No recent activity.";
224:   return {
225:     type: "workspace",
226:     workspace: {
227:       id: workspace.id,
228:       name: workspace.name,
229:       description: workspace.description,
230:       goals: null,
231:     },
232:     memberCount: workspace._count?.members || 0,
233:     paperCount: workspace._count?.papers || 0,
234:     recentPapers: (workspace.papers || []).map((p: any) => ({
235:       id: p.id,
236:       title: p.title,
237:     })),
238:     recentActivity,
239:   };
240: }
241: async function buildDashboardContext(
242:   userId: string
243: ): Promise<DashboardContext> {
244:   const user = await prisma.user.findUnique({
245:     where: { id: userId },
246:     select: {
247:       name: true,
248:       email: true,
249:       role: true,
250:     },
251:   });
252:   if (!user) throw new Error("User not found");
253:   const [recentPapers, workspaces, unreadNotifications] = await Promise.all([
254:     prisma.paper.findMany({
255:       where: { uploaderId: userId, isDeleted: false },
256:       select: { id: true, title: true, createdAt: true },
257:       orderBy: { createdAt: "desc" },
258:       take: MAX_RECENT_PAPERS,
259:     }),
260:     prisma.workspaceMember.findMany({
261:       where: { userId, isDeleted: false },
262:       select: { workspace: { select: { id: true, name: true } } },
263:       take: MAX_RECENT_PAPERS,
264:     }),
265:     prisma.notification.count({
266:       where: { userId, read: false },
267:     }),
268:   ]);
269:   return {
270:     type: "dashboard",
271:     user: {
272:       name: user.name,
273:       email: user.email,
274:       role: user.role,
275:     },
276:     recentPapers: recentPapers.map((p) => ({
277:       id: p.id,
278:       title: p.title,
279:     })),
280:     activeWorkspaces: workspaces.map((w) => ({
281:       id: w.workspace.id,
282:       name: w.workspace.name,
283:     })),
284:     unreadNotifications,
285:   };
286: }
287: export const aiContextService = {
288:   async resolve(input: AiContextInput): Promise<AiContext> {
289:     switch (input.type) {
290:       case "paper":
291:         return await buildPaperContext(input.id, input.userId);
292:       case "workspace":
293:         return await buildWorkspaceContext(input.id, input.userId);
294:       case "dashboard":
295:         return await buildDashboardContext(input.userId);
296:       default:
297:         throw new Error("Unknown context type");
298:     }
299:   },
300:   buildSystemPrompt,
301:   injectContextIntoSystemPrompt(
302:     context: AiContext,
303:     basePrompt?: string
304:   ): ContextInjectionResult {
305:     return buildSystemPrompt(context, basePrompt);
306:   },
307: };
</file>

