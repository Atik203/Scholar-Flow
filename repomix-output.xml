1958:     const docxBlob = htmlDocx.asBlob(htmlContent) as Buffer | Blob;
1959:     if (Buffer.isBuffer(docxBlob)) {
1960:       return docxBlob;
1961:     }
1962:     if (
1963:       "arrayBuffer" in docxBlob &&
1964:       typeof docxBlob.arrayBuffer === "function"
1965:     ) {
1966:       const arrayBuffer = await docxBlob.arrayBuffer();
1967:       return Buffer.from(arrayBuffer);
1968:     }
1969:     throw new Error("DOCX export returned unsupported blob type");
1970:   },
1971: };
