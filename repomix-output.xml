 11: export interface StatCardProps
 12:   extends Omit<React.ComponentProps<"div">, "onClick">,
 13:     CardVariants {
 14:   title: string;
 15:   value: string | number;
 16:   change?: number;
 17:   changeType?: "percentage" | "absolute";
 18:   trend?: "up" | "down" | "neutral";
 19:   icon?: React.ComponentType<{ className?: string }>;
