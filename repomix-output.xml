10:   member: "Member",
11:   viewer: "Viewer",
12: };
13: const ROLE_COLORS: Record<TeamRole, string> = {
14:   admin: "bg-red-500/10 text-red-600 border-red-200 dark:bg-red-900/30 dark:text-red-400 dark:border-red-800",
15:   team_lead:
16:     "bg-purple-500/10 text-purple-600 border-purple-200 dark:bg-purple-900/30 dark:text-purple-400 dark:border-purple-800",
17:   member:
18:     "bg-blue-500/10 text-blue-600 border-blue-200 dark:bg-blue-900/30 dark:text-blue-400 dark:border-blue-800",
19:   viewer:
20:     "bg-gray-500/10 text-gray-600 border-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700",
21: };
22: const ROLE_ICONS: Record<TeamRole, React.ComponentType<{ className?: string }>> = {
23:   admin: Shield,
24:   team_lead: Crown,
25:   member: UserIcon,
26:   viewer: Eye,
27: };
28: export function getRoleLabel(role: string): string {
29:   return ROLE_LABELS[role as TeamRole] || role;
30: }
31: export function getRoleColor(role: string): string {
32:   return ROLE_COLORS[role as TeamRole] || ROLE_COLORS.member;
33: }
34: export function getRoleIcon(role: string) {
35:   return ROLE_ICONS[role as TeamRole] || UserIcon;
36: }
37: export function RoleBadge({ role, className }: { role: string; className?: string }) {
