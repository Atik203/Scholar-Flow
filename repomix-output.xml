  2: import { useCallback, useEffect, useRef, useState } from "react";
  3: import { io, Socket } from "socket.io-client";
  4: import * as Y from "yjs";
  5: import { IndexeddbPersistence } from "y-indexeddb";
  6: import { getAppStore } from "@/redux/storeAccess";
  7: const SOCKET_URL = process.env.NEXT_PUBLIC_WS_URL || "http://localhost:5001";
  8: function getAuthToken(): string | null {
  9:   try {
 10:     const store = getAppStore();
 11:     if (store) return store.getState().auth?.accessToken || null;
 12:   } catch {}
 13:   return null;
 14: }
 15: function getUserName(): string {
 16:   try {
 17:     const store = getAppStore();
 18:     if (store) return store.getState().auth?.user?.name || "Anonymous";
 19:   } catch {}
 20:   return "Anonymous";
 21: }
 22: function getUserId(): string {
 23:   try {
 24:     const store = getAppStore();
 25:     if (store) return store.getState().auth?.user?.id || "unknown";
 26:   } catch {}
 27:   return "unknown";
 28: }
 29: interface UseCollabSyncOptions {
 30:   paperId: string;
 31:   initialContent: string | null;
 32:   enabled: boolean;
 33: }
 34: interface UseCollabSyncResult {
 35:   ydoc: Y.Doc;
 36:   provider: Socket | null;
 37:   awareness: AwarenessBridge | null;
 38:   hasRemoteState: boolean;
 39: }
 40: class AwarenessBridge {
 41:   private states = new Map<number, any>();
 42:   private listeners: Array<{ event: string; cb: (...args: any[]) => void }> = [];
 43:   private localState: any = { cursor: null, user: { name: getUserName(), color: "#666" } };
 44:   private clientId: number;
 45:   private socket: Socket | null = null;
 46:   private room: string = "";
 47:   constructor(ydoc: Y.Doc) {
 48:     this.clientId = ydoc.clientID;
 49:   }
 50:   setSocket(socket: Socket) {
 51:     this.socket = socket;
 52:   }
 53:   setRoom(room: string) {
 54:     this.room = room;
 55:   }
 56:   getStates(): Map<number, any> {
 57:     return this.states;
 58:   }
 59:   setLocalState(state: any) {
 60:     this.localState = { ...this.localState, ...state };
 61:     this.states.set(this.clientId, this.localState);
 62:     this.emit("change", [{ added: [], updated: [this.clientId], removed: [] }]);
 63:     this.broadcast();
 64:   }
 65:   setLocalStateField(field: string, value: any) {
 66:     this.setLocalState({ [field]: value });
 67:   }
 68:   getLocalState() {
 69:     return this.localState;
 70:   }
 71:   applyRemoteState(clientId: number, state: any) {
 72:     if (clientId === this.clientId) return;
 73:     const prev = this.states.get(clientId);
 74:     this.states.set(clientId, state);
 75:     const updated = prev ? [clientId] : [];
 76:     const added = prev ? [] : [clientId];
 77:     this.emit("change", [{ added, updated, removed: [] }]);
 78:   }
 79:   removeClient(clientId: number) {
 80:     this.states.delete(clientId);
 81:     this.emit("change", [{ added: [], updated: [], removed: [clientId] }]);
 82:   }
 83:   removeByUserId(userId: string) {
 84:     for (const [clientId, state] of Array.from(this.states.entries())) {
 85:       if (state?.userId === userId) {
 86:         this.states.delete(clientId);
 87:         this.emit("change", [{ added: [], updated: [], removed: [clientId] }]);
 88:       }
 89:     }
 90:   }
 91:   private broadcast() {
 92:     if (!this.socket?.connected) return;
 93:     this.socket.emit("editor:awareness", {
 94:       room: this.room,
 95:       state: {
 96:         ...this.localState,
 97:         clientId: this.clientId,
 98:         userId: getUserId(),
 99:       },
100:     });
101:   }
102:   private emit(event: string, args: any[]) {
103:     this.listeners
104:       .filter((l) => l.event === event)
105:       .forEach((l) => l.cb(...args));
106:   }
107:   on(event: string, cb: (...args: any[]) => void) {
108:     this.listeners.push({ event, cb });
109:   }
110:   off(event: string, cb: (...args: any[]) => void) {
111:     this.listeners = this.listeners.filter(
112:       (l) => !(l.event === event && l.cb === cb)
113:     );
114:   }
115:   destroy() {
116:     this.listeners = [];
117:     this.states.clear();
118:   }
119: }
120: function getDocKey(paperId: string) {
121:   return `scholar-flow:collab:${paperId}`;
122: }
123: export function useCollabSync({
124:   paperId,
125:   initialContent,
126:   enabled,
127: }: UseCollabSyncOptions): UseCollabSyncResult {
128:   const ydocRef = useRef<Y.Doc>(new Y.Doc());
129:   const socketRef = useRef<Socket | null>(null);
130:   const syncedRef = useRef(false);
131:   const pendingUpdatesRef = useRef<Uint8Array[]>([]);
132:   const [awareness, setAwareness] = useState<AwarenessBridge | null>(null);
133:   const [hasRemoteState, setHasRemoteState] = useState(false);
134:   const saveSnapshot = useCallback(() => {
135:     const ydoc = ydocRef.current;
136:     const snapshot = Y.encodeStateAsUpdate(ydoc);
137:     try {
138:       localStorage.setItem(getDocKey(paperId), JSON.stringify(Array.from(snapshot)));
139:     } catch {}
140:   }, [paperId]);
141:   const restoreSnapshot = useCallback(() => {
142:     try {
143:       const raw = localStorage.getItem(getDocKey(paperId));
144:       if (!raw) return null;
145:       const arr = JSON.parse(raw) as number[];
146:       return new Uint8Array(arr);
147:     } catch {
148:       return null;
149:     }
150:   }, [paperId]);
151:   const flushPending = useCallback((ydoc: Y.Doc) => {
152:     if (pendingUpdatesRef.current.length === 0) return;
153:     const updates = pendingUpdatesRef.current.slice();
154:     pendingUpdatesRef.current = [];
155:     for (const update of updates) {
156:       try {
157:         Y.applyUpdate(ydoc, update);
158:       } catch {}
159:     }
160:   }, []);
161:   useEffect(() => {
162:     if (!enabled || !paperId) return;
163:     const token = getAuthToken();
164:     if (!token) return;
165:     const ydoc = ydocRef.current;
166:     const awarenessBridge = new AwarenessBridge(ydoc);
167:     syncedRef.current = false;
168:     setHasRemoteState(false);
169:     setAwareness(awarenessBridge);
170:     const socket = io(SOCKET_URL, {
171:       auth: { token },
172:       transports: ["websocket"],
173:       reconnection: true,
174:       reconnectionDelay: 1000,
175:       reconnectionDelayMax: 15000,
176:       reconnectionAttempts: Infinity,
177:       timeout: 20000,
178:     });
179:     socketRef.current = socket;
180:     const room = `paper:${paperId}`;
181:     let indexeddbProvider: IndexeddbPersistence | null = null;
182:     try {
183:       indexeddbProvider = new IndexeddbPersistence(getDocKey(paperId), ydoc);
184:     } catch {}
185:     const snapshot = restoreSnapshot();
186:     if (snapshot && !syncedRef.current) {
187:       Y.applyUpdate(ydoc, snapshot);
188:     }
189:     awarenessBridge.setSocket(socket);
190:     awarenessBridge.setRoom(room);
191:     socket.on("connect", () => {
192:       socket.emit("room:join", room);
193:       flushPending(ydoc);
194:       if (syncedRef.current) {
195:         socket.emit("editor:sync-request", { room });
196:       }
197:     });
198:     socket.on("disconnect", () => {
199:       saveSnapshot();
200:     });
201:     socket.on("connect_error", (error: Error) => {
202:       if (process.env.NODE_ENV !== "production") {
203:         console.warn("[CollabSync] connect error:", error.message);
204:       }
205:     });
206:     socket.on(
207:       "room:joined",
208:       ({ memberCount }: { memberCount?: number } = {}) => {
209:         if ((memberCount ?? 0) > 1) setHasRemoteState(true);
210:       }
211:     );
212:     socket.on("editor:update", ({ update }: { update: number[] }) => {
213:       setHasRemoteState(true);
214:       try {
215:         const u8 = new Uint8Array(update);
216:         Y.applyUpdate(ydoc, u8);
217:       } catch {}
218:     });
219:     socket.on("editor:sync-response", ({ update }: { update: number[] }) => {
220:       setHasRemoteState(true);
221:       if (syncedRef.current) return;
222:       syncedRef.current = true;
223:       try {
224:         const u8 = new Uint8Array(update);
225:         Y.applyUpdate(ydoc, u8);
226:       } catch {}
227:     });
228:     socket.on("editor:sync-request", () => {
229:       const state = Y.encodeStateAsUpdate(ydoc);
230:       socket.emit("editor:sync-response", {
231:         room,
232:         update: Array.from(state),
233:       });
234:     });
235:     socket.on("editor:awareness", ({ state }: { state: any }) => {
236:       const clientId =
237:         typeof state?.clientId === "number" ? state.clientId : null;
238:       if (clientId === null) return;
239:       awarenessBridge.applyRemoteState(clientId, state);
240:     });
241:     socket.on("presence:left", ({ userId }: { userId: string }) => {
242:       awarenessBridge.removeByUserId(userId);
243:     });
244:     const updateHandler = (update: Uint8Array, origin: any) => {
245:       if (origin === socket) return;
246:       if (socket.connected) {
247:         socket.emit("editor:update", {
248:           room,
249:           update: Array.from(update),
250:         });
251:       } else {
252:         pendingUpdatesRef.current.push(update);
253:       }
254:       saveSnapshot();
255:     };
256:     ydoc.on("update", updateHandler);
257:     return () => {
258:       ydoc.off("update", updateHandler);
259:       socket.emit("room:leave", room);
260:       awarenessBridge.destroy();
261:       if (indexeddbProvider) {
262:         indexeddbProvider.destroy();
263:       }
264:       socket.disconnect();
265:       socketRef.current = null;
266:       syncedRef.current = false;
267:       setAwareness(null);
268:     };
269:   }, [paperId, initialContent, enabled, saveSnapshot, restoreSnapshot, flushPending]);
270:   return {
271:     ydoc: ydocRef.current,
272:     provider: socketRef.current,
273:     awareness,
274:     hasRemoteState,
275:   };
276: }
