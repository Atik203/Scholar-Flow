 2: export function useDebounce<T>(value: T, delay: number): T {
 3:   const [debouncedValue, setDebouncedValue] = useState<T>(value);
 4:   useEffect(() => {
 5:     const handler = setTimeout(() => {
 6:       setDebouncedValue(value);
