<file path="apps/frontend/src/components/text-editor/TemplateSelector.tsx">
 1: "use client";
 2: import { Button } from "@/components/ui/button";
 3: import {
 4:   Dialog,
 5:   DialogContent,
 6:   DialogDescription,
 7:   DialogHeader,
 8:   DialogTitle,
 9:   DialogTrigger,
10: } from "@/components/ui/dialog";
11: import { ScrollArea } from "@/components/ui/scroll-area";
12: import { editorTemplates, templateToHtml, EditorTemplate } from "@/lib/editorTemplates";
13: import type { Editor } from "@tiptap/core";
14: import { FileText, LayoutTemplate } from "lucide-react";
15: import { useState } from "react";
16: interface TemplateSelectorProps {
17:   editor: Editor | null;
18: }
19: export function TemplateSelector({ editor }: TemplateSelectorProps) {
20:   const [open, setOpen] = useState(false);
21:   const handleApply = (template: EditorTemplate) => {
22:     if (!editor) return;
23:     const html = templateToHtml(template);
24:     editor
25:       .chain()
26:       .focus()
27:       .clearContent()
28:       .insertContent(html)
29:       .run();
30:     setOpen(false);
31:   };
32:   return (
33:     <Dialog open={open} onOpenChange={setOpen}>
34:       <DialogTrigger asChild>
35:         <Button variant="ghost" size="sm" title="Apply Template">
36:           <LayoutTemplate className="h-4 w-4 mr-1" />
37:           <span className="hidden sm:inline">Template</span>
38:         </Button>
39:       </DialogTrigger>
40:       <DialogContent className="max-w-md max-h-[70vh] overflow-y-auto">
41:         <DialogHeader>
42:           <DialogTitle>Choose a Template</DialogTitle>
43:           <DialogDescription>
44:             Select a pre-built template to structure your paper. This will replace the current content.
45:           </DialogDescription>
46:         </DialogHeader>
47:         <ScrollArea className="max-h-[50vh]">
48:           <div className="grid gap-2">
49:             {editorTemplates.map((template) => (
50:               <button
51:                 key={template.id}
52:                 onClick={() => handleApply(template)}
53:                 className="w-full text-left p-3 rounded-lg border hover:border-primary/50 hover:bg-accent transition-colors"
54:               >
55:                 <div className="flex items-start gap-3">
56:                   <div className="flex-shrink-0 h-9 w-9 rounded-md bg-primary/10 flex items-center justify-center mt-0.5">
57:                     <FileText className="h-4 w-4 text-primary" />
58:                   </div>
59:                   <div className="min-w-0">
60:                     <p className="text-sm font-medium">{template.name}</p>
61:                     <p className="text-xs text-muted-foreground mt-0.5">
62:                       {template.description}
63:                     </p>
64:                     <div className="flex flex-wrap gap-1 mt-1.5">
65:                       {template.sections.slice(0, 4).map((s) => (
66:                         <span
67:                           key={s}
68:                           className="inline-block text-[10px] px-1.5 py-0.5 rounded bg-muted text-muted-foreground"
69:                         >
70:                           {s.length > 30 ? s.slice(0, 30) + "..." : s}
71:                         </span>
72:                       ))}
73:                       {template.sections.length > 4 && (
74:                         <span className="text-[10px] text-muted-foreground">
75:                           +{template.sections.length - 4} more
76:                         </span>
77:                       )}
78:                     </div>
79:                   </div>
80:                 </div>
81:               </button>
82:             ))}
83:           </div>
84:         </ScrollArea>
85:       </DialogContent>
86:     </Dialog>
87:   );
88: }
</file>

<file path="apps/frontend/src/components/text-editor/VersionHistoryDialog.tsx">
  1: "use client";
  2: import { Button } from "@/components/ui/button";
  3: import {
  4:   AlertDialog,
  5:   AlertDialogAction,
  6:   AlertDialogCancel,
  7:   AlertDialogContent,
  8:   AlertDialogDescription,
  9:   AlertDialogFooter,
 10:   AlertDialogHeader,
 11:   AlertDialogTitle,
 12: } from "@/components/ui/alert-dialog";
 13: import {
 14:   Dialog,
 15:   DialogContent,
 16:   DialogDescription,
 17:   DialogHeader,
 18:   DialogTitle,
 19: } from "@/components/ui/dialog";
 20: import { Skeleton } from "@/components/ui/skeleton";
 21: import {
 22:   useGetPaperVersionsQuery,
 23:   useRestorePaperVersionMutation,
 24: } from "@/redux/api/paperApi";
 25: import { showErrorToast } from "@/components/providers/ToastProvider";
 26: import { History, RotateCcw, Clock, FileText } from "lucide-react";
 27: import { useState } from "react";
 28: interface VersionHistoryDialogProps {
 29:   paperId: string;
 30:   open: boolean;
 31:   onClose: () => void;
 32:   onRestored: () => void;
 33: }
 34: function formatBytes(bytes: number | null): string {
 35:   if (bytes == null) return "—";
 36:   if (bytes < 1024) return `${bytes} B`;
 37:   return `${(bytes / 1024).toFixed(1)} KB`;
 38: }
 39: function formatDate(dateString: string): string {
 40:   return new Date(dateString).toLocaleString("en-US", {
 41:     month: "short",
 42:     day: "numeric",
 43:     hour: "2-digit",
 44:     minute: "2-digit",
 45:   });
 46: }
 47: export function VersionHistoryDialog({
 48:   paperId,
 49:   open,
 50:   onClose,
 51:   onRestored,
 52: }: VersionHistoryDialogProps) {
 53:   const { data: versions, isLoading } = useGetPaperVersionsQuery(paperId);
 54:   const [restoreVersion, { isLoading: isRestoring }] =
 55:     useRestorePaperVersionMutation();
 56:   const [pendingRestore, setPendingRestore] = useState<{
 57:     id: string;
 58:     label: string;
 59:   } | null>(null);
 60:   const handleRestore = async () => {
 61:     if (!pendingRestore) return;
 62:     try {
 63:       await restoreVersion({ paperId, versionId: pendingRestore.id }).unwrap();
 64:       setPendingRestore(null);
 65:       onClose();
 66:       onRestored();
 67:     } catch (error: any) {
 68:       showErrorToast(error?.data?.message || "Failed to restore version");
 69:     }
 70:   };
 71:   return (
 72:     <Dialog open={open} onOpenChange={(v) => !v && onClose()}>
 73:       <DialogContent className="max-w-lg max-h-[80vh] overflow-y-auto">
 74:         <DialogHeader>
 75:           <DialogTitle className="flex items-center gap-2">
 76:             <History className="h-5 w-5" />
 77:             Version History
 78:           </DialogTitle>
 79:           <DialogDescription>
 80:             Auto-saved snapshots from each edit. Restore any previous version.
 81:           </DialogDescription>
 82:         </DialogHeader>
 83:         <div className="space-y-2 mt-2">
 84:           {isLoading ? (
 85:             Array.from({ length: 3 }).map((_, i) => (
 86:               <div key={i} className="flex items-center gap-3 p-3 border rounded-lg">
 87:                 <Skeleton className="h-8 w-8 rounded-full" />
 88:                 <div className="flex-1 space-y-1">
 89:                   <Skeleton className="h-4 w-32" />
 90:                   <Skeleton className="h-3 w-24" />
 91:                 </div>
 92:                 <Skeleton className="h-8 w-20" />
 93:               </div>
 94:             ))
 95:           ) : !versions || versions.length === 0 ? (
 96:             <div className="text-center text-muted-foreground py-8">
 97:               <History className="h-12 w-12 mx-auto mb-2 opacity-30" />
 98:               <p>No saved versions yet.</p>
 99:               <p className="text-xs mt-1">
100:                 Versions are created automatically when you save your paper.
101:               </p>
102:             </div>
103:           ) : (
104:             versions.map((v) => (
105:               <div
106:                 key={v.id}
107:                 className="flex items-center gap-3 p-3 border rounded-lg hover:bg-muted/50 transition-colors"
108:               >
109:                 <div className="h-9 w-9 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
110:                   <FileText className="h-4 w-4 text-primary" />
111:                 </div>
112:                 <div className="flex-1 min-w-0">
113:                   <p className="text-sm font-medium truncate">
114:                     {v.title || `Version ${v.version}`}
115:                   </p>
116:                   <div className="flex items-center gap-2 text-xs text-muted-foreground">
117:                     <Clock className="h-3 w-3" />
118:                     {formatDate(v.savedAt)}
119:                     <span className="text-muted-foreground/50">|</span>
120:                     {formatBytes(v.sizeBytes)}
121:                   </div>
122:                 </div>
123:                 <Button
124:                   variant="outline"
125:                   size="sm"
126:                   onClick={() =>
127:                     setPendingRestore({
128:                       id: v.id,
129:                       label: v.title || `Version ${v.version}`,
130:                     })
131:                   }
132:                   disabled={isRestoring}
133:                   className="flex-shrink-0"
134:                 >
135:                   <RotateCcw className="h-3 w-3 mr-1" />
136:                   Restore
137:                 </Button>
138:               </div>
139:             ))
140:           )}
141:         </div>
142:       </DialogContent>
143:       <AlertDialog
144:         open={pendingRestore !== null}
145:         onOpenChange={(v) => !v && setPendingRestore(null)}
146:       >
147:         <AlertDialogContent>
148:           <AlertDialogHeader>
149:             <AlertDialogTitle>Restore this version?</AlertDialogTitle>
150:             <AlertDialogDescription>
151:               Restoring <strong>{pendingRestore?.label}</strong> replaces the
152:               current editor content. Any unsaved changes will be lost.
153:             </AlertDialogDescription>
154:           </AlertDialogHeader>
155:           <AlertDialogFooter>
156:             <AlertDialogCancel disabled={isRestoring}>Cancel</AlertDialogCancel>
157:             <AlertDialogAction
158:               onClick={(e) => {
159:                 e.preventDefault();
160:                 void handleRestore();
161:               }}
162:               disabled={isRestoring}
163:             >
164:               {isRestoring ? "Restoring…" : "Restore"}
165:             </AlertDialogAction>
166:           </AlertDialogFooter>
167:         </AlertDialogContent>
168:       </AlertDialog>
169:     </Dialog>
170:   );
171: }
</file>

