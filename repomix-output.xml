<file path="apps/frontend/src/components/providers/AuthProvider.tsx">
 1: "use client";
 2: import { apiSlice } from "@/redux/api/apiSlice";
 3: import { useGetCurrentUserQuery } from "@/redux/auth/authApi";
 4: import {
 5:   selectAccessToken,
 6:   selectCurrentUser,
 7:   selectIsAuthenticated,
 8:   setCredentials,
 9:   setLoading,
10:   updateUser,
11: } from "@/redux/auth/authSlice";
12: import { setAuthCookie, clearAuthCookie } from "@/lib/auth/authCookies";
13: import { useAppDispatch, useAppSelector } from "@/redux/hooks";
14: import { ReactNode, useEffect, useMemo, useRef } from "react";
15: interface AuthProviderProps {
16:   children: ReactNode;
17: }
18: export function AuthProvider({ children }: AuthProviderProps) {
19:   const dispatch = useAppDispatch();
20:   const isAuthenticated = useAppSelector(selectIsAuthenticated);
21:   const accessToken = useAppSelector(selectAccessToken);
22:   const currentUser = useAppSelector(selectCurrentUser);
23:   const hasInitialized = useRef(false);
24:   const lastSyncedUserVersion = useRef<string | null>(null);
25:   const previousRoleRef = useRef<string | null>(null);
26:   const shouldFetchUser = Boolean(accessToken && accessToken.length > 0);
27:   const { data: currentUserResponse } = useGetCurrentUserQuery(undefined, {
28:     skip: !shouldFetchUser,
29:     refetchOnMountOrArgChange: true,
30:     refetchOnReconnect: true,
31:     pollingInterval: isAuthenticated ? 30000 : undefined,
32:   });
33:   const fetchedUser = currentUserResponse?.data?.user;
34:   const fetchedUserVersionKey = fetchedUser
35:     ? `${fetchedUser.id}:${fetchedUser.updatedAt ?? ""}:${fetchedUser.role ?? ""}:${fetchedUser.email ?? ""}`
36:     : null;
37:   const currentUserId = currentUser?.id ?? null;
38:   const stableFetchedUser = useMemo(
39:     () => (fetchedUserVersionKey ? (fetchedUser ?? null) : null),
40:     [fetchedUser, fetchedUserVersionKey]
41:   );
42:   useEffect(() => {
43:     if (!accessToken) {
44:       lastSyncedUserVersion.current = null;
45:     }
46:   }, [accessToken]);
47:   useEffect(() => {
48:     if (!hasInitialized.current) {
49:       hasInitialized.current = true;
50:       if (isAuthenticated && accessToken) {
51:         setAuthCookie();
52:       } else {
53:         clearAuthCookie();
54:       }
55:       dispatch(setLoading(false));
56:     }
57:   }, []);
58:   useEffect(() => {
59:     if (!fetchedUserVersionKey || !accessToken || !stableFetchedUser) {
60:       return;
61:     }
62:     const fetchedVersionKey = fetchedUserVersionKey;
63:     if (lastSyncedUserVersion.current === fetchedVersionKey) {
64:       return;
65:     }
66:     const fetchedRole = stableFetchedUser.role;
67:     const hadRoleChange =
68:       previousRoleRef.current !== null &&
69:       previousRoleRef.current !== fetchedRole;
70:     if (hadRoleChange) {
71:       dispatch(
72:         apiSlice.util.invalidateTags(["User", "Collection", "Workspace"])
73:       );
74:     }
75:     previousRoleRef.current = fetchedRole || null;
76:     if (!currentUserId || currentUserId !== stableFetchedUser.id) {
77:       dispatch(
78:         setCredentials({
79:           user: stableFetchedUser,
80:           accessToken,
81:         })
82:       );
83:     } else {
84:       dispatch(updateUser(stableFetchedUser));
85:     }
86:     lastSyncedUserVersion.current = fetchedVersionKey;
87:   }, [
88:     accessToken,
89:     currentUserId,
90:     dispatch,
91:     fetchedUserVersionKey,
92:     stableFetchedUser,
93:   ]);
94:   return <>{children}</>;
95: }
</file>

