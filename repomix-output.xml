440:       orderBy: [{ createdAt: "desc" }, { id: "desc" }],
441:       include: {
442:         user: {
443:           select: {
444:             id: true,
445:             name: true,
446:             firstName: true,
447:             lastName: true,
448:             image: true,
449:             role: true,
450:           },
451:         },
452:         workspace: { select: { id: true, name: true } },
453:       },
454:     });
455:     const hasMore = entries.length > limit;
456:     const sliced = hasMore ? entries.slice(0, -1) : entries;
457:     return {
458:       result: sliced,
459:       meta: {
460:         limit,
461:         hasMore,
462:         nextCursor: hasMore ? sliced[sliced.length - 1].id : null,
463:       },
464:     };
465:   }
466:   static async getActivitySummary(userId: string, days: number = 7) {
467:     const startDate = new Date();
468:     startDate.setDate(startDate.getDate() - days);
469:     const userWorkspaces = await prisma.workspace.findMany({
470:       where: {
471:         isDeleted: false,
472:         OR: [
473:           { ownerId: userId },
474:           { members: { some: { userId, isDeleted: false } } },
475:         ],
476:       },
477:       select: { id: true },
478:     });
479:     const workspaceIds = userWorkspaces.map((w) => w.id);
480:     const baseWhere: Prisma.ActivityLogEntryWhereInput = {
481:       isDeleted: false,
482:       createdAt: { gte: startDate },
483:       OR: [{ workspaceId: { in: workspaceIds } }, { userId }],
484:     };
485:     const [
486:       totalActivities,
487:       byTypeGroups,
488:       bySeverityGroups,
489:       recentActivities,
490:     ] = await Promise.all([
491:       prisma.activityLogEntry.count({ where: baseWhere }),
492:       prisma.activityLogEntry.groupBy({
493:         by: ["entity"],
494:         where: baseWhere,
495:         _count: { entity: true },
496:       }),
497:       prisma.activityLogEntry.groupBy({
498:         by: ["severity"],
499:         where: baseWhere,
500:         _count: { severity: true },
501:       }),
502:       prisma.activityLogEntry.findMany({
503:         where: baseWhere,
504:         take: 10,
505:         orderBy: { createdAt: "desc" },
506:         include: {
507:           user: {
508:             select: {
509:               id: true,
510:               name: true,
511:               firstName: true,
512:               lastName: true,
513:               image: true,
514:               role: true,
515:             },
516:           },
517:           workspace: { select: { id: true, name: true } },
518:         },
519:       }),
520:     ]);
521:     return {
522:       totalActivities,
523:       activitiesByType: byTypeGroups.reduce<Record<string, number>>((acc, g) => {
524:         acc[g.entity] = g._count.entity;
525:         return acc;
526:       }, {}),
527:       activitiesBySeverity: bySeverityGroups.reduce<Record<string, number>>(
528:         (acc, g) => {
529:           acc[g.severity] = g._count.severity;
530:           return acc;
531:         },
532:         {}
533:       ),
534:       recentActivities,
535:       days,
536:     };
537:   }
538:   static async getStats(userId: string) {
539:     const sevenDaysAgo = new Date();
540:     sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
541:     const workspaceIds = await this._requesterWorkspaceIds(userId);
542:     const memberWhere: Prisma.UserWhereInput = {
543:       isDeleted: false,
544:       ...(workspaceIds.length
545:         ? {
546:             memberships: {
547:               some: { workspaceId: { in: workspaceIds }, isDeleted: false },
548:             },
549:           }
550:         : {}),
551:     };
552:     const [
553:       totalMembers,
554:       pendingInvitations,
555:       totalPapers,
556:       totalCollections,
557:       recentActivity,
558:       usersWithActivity,
559:     ] = await Promise.all([
560:       prisma.user.count({ where: memberWhere }),
561:       prisma.workspaceInvitation.count({
562:         where: {
563:           isDeleted: false,
564:           status: "PENDING",
565:           workspaceId: { in: workspaceIds },
566:         },
567:       }),
568:       prisma.paper.count({
569:         where: { isDeleted: false, workspaceId: { in: workspaceIds } },
570:       }),
571:       prisma.collection.count({
572:         where: { isDeleted: false, workspaceId: { in: workspaceIds } },
573:       }),
574:       prisma.activityLogEntry.count({
575:         where: {
576:           isDeleted: false,
577:           createdAt: { gte: sevenDaysAgo },
578:           OR: [{ workspaceId: { in: workspaceIds } }, { userId }],
579:         },
580:       }),
581:       prisma.user.findMany({
582:         where: memberWhere,
583:         select: { id: true, createdAt: true },
584:       }),
585:     ]);
586:     const memberIds = usersWithActivity.map((u) => u.id);
587:     const activeUserIds = new Set(
588:       (
589:         await prisma.activityLogEntry.findMany({
590:           where: {
591:             isDeleted: false,
592:             createdAt: { gte: sevenDaysAgo },
593:             userId: { in: memberIds },
594:           },
595:           select: { userId: true },
596:           distinct: ["userId"],
597:         })
598:       )
599:         .map((r) => r.userId)
600:         .filter((id): id is string => !!id)
601:     );
602:     let activeMembers = 0;
603:     let inactiveMembers = 0;
604:     for (const u of usersWithActivity) {
605:       if (activeUserIds.has(u.id)) activeMembers++;
606:       else if (u.createdAt < sevenDaysAgo) inactiveMembers++;
607:     }
608:     const activityScore = Math.min(100, Math.round(50 + Math.log10(recentActivity + 1) * 12));
609:     return {
610:       totalMembers,
611:       activeMembers,
612:       inactiveMembers,
613:       pendingInvitations,
614:       totalPapers,
615:       totalCollections,
616:       activityScore,
617:       recentActivityCount: recentActivity,
618:     };
619:   }
620:   static async inviteMember(
621:     inviterId: string,
622:     payload: { email: string; role?: string; message?: string; workspaceId?: string }
623:   ) {
624:     const user = await prisma.user.findFirst({
625:       where: { email: payload.email, isDeleted: false },
626:       select: { id: true, email: true, name: true, firstName: true, lastName: true },
627:     });
628:     if (!user) {
629:       throw new ApiError(404, "No registered user with this email");
630:     }
631:     if (user.id === inviterId) {
632:       throw new ApiError(400, "You cannot invite yourself");
633:     }
634:     const inviter = await prisma.user.findUnique({
635:       where: { id: inviterId },
636:       select: { role: true, name: true, firstName: true, lastName: true, email: true },
637:     });
638:     const requestedGlobalRole = (payload.role as string) || "RESEARCHER";
639:     if (requestedGlobalRole === "ADMIN" && inviter?.role !== "ADMIN") {
640:       throw new ApiError(403, "Only admins can invite as ADMIN");
641:     }
642:     const roleMap: Record<string, string> = {
643:       RESEARCHER: "VIEWER",
644:       PRO_RESEARCHER: "EDITOR",
645:       TEAM_LEAD: "MANAGER",
646:       ADMIN: "OWNER",
647:     };
648:     const workspaceRole = roleMap[requestedGlobalRole] || "EDITOR";
649:     const inviterWorkspaces = await prisma.workspace.findMany({
650:       where: { isDeleted: false, ownerId: inviterId },
651:       select: { id: true },
652:     });
653:     if (inviterWorkspaces.length === 0) {
654:       throw new ApiError(
655:         400,
656:         "You must own at least one workspace before inviting team members"
657:       );
658:     }
659:     const targetWorkspaceId = payload.workspaceId || inviterWorkspaces[0].id;
660:     if (
661:       payload.workspaceId &&
662:       !inviterWorkspaces.some((w) => w.id === payload.workspaceId)
663:     ) {
664:       throw new ApiError(403, "You do not own the selected workspace");
665:     }
666:     const existingMembership = await prisma.workspaceMember.findFirst({
667:       where: {
668:         userId: user.id,
669:         workspaceId: targetWorkspaceId,
670:         isDeleted: false,
671:       },
672:     });
673:     if (existingMembership) {
674:       throw new ApiError(400, "User is already a member of this workspace");
675:     }
676:     const invitation = await prisma.workspaceInvitation.upsert({
677:       where: { workspaceId_userId: { workspaceId: targetWorkspaceId, userId: user.id } },
678:       create: {
679:         workspaceId: targetWorkspaceId,
680:         userId: user.id,
681:         role: workspaceRole as any,
682:         invitedById: inviterId,
683:         status: "PENDING",
684:         invitedAt: new Date(),
685:       },
686:       update: {
687:         role: workspaceRole as any,
688:         invitedById: inviterId,
689:         status: "PENDING",
690:         invitedAt: new Date(),
691:         acceptedAt: null,
692:         declinedAt: null,
693:         isDeleted: false,
694:       },
695:     });
696:     try {
697:       const { default: emailService } = await import("../../shared/emailService");
698:       await emailService.sendTeamInvitationEmail({
699:         email: user.email,
700:         name: user.name || `${user.firstName || ""} ${user.lastName || ""}`.trim() || user.email,
701:         teamName: inviter?.name || "ScholarFlow Team",
702:         inviterName:
703:           inviter?.name ||
704:           `${inviter?.firstName || ""} ${inviter?.lastName || ""}`.trim() ||
705:           inviter?.email ||
706:           "A team lead",
707:         role: invitation.role,
708:         message: payload.message,
709:         invitationId: invitation.id,
710:       });
711:     } catch (err) {
712:       if (process.env.NODE_ENV !== "production") {
713:         console.error("Team invitation email failed:", (err as any)?.message || err);
714:       }
715:     }
716:     try {
717:       const inviterName =
718:         inviter?.name ||
719:         `${inviter?.firstName || ""} ${inviter?.lastName || ""}`.trim() ||
720:         inviter?.email ||
721:         "A team lead";
722:       await notificationService.createNotification({
723:         userId: user.id,
724:         type: "INVITE",
725:         category: "TEAM",
726:         title: "Team invitation",
727:         message: `${inviterName} invited you to join their team. Review and accept it from your invitations.`,
728:         actionUrl: "/dashboard/team/invitations",
729:         actorId: inviterId,
730:         resourceId: invitation.id,
731:       });
732:     } catch {
733:     }
734:     return { invitationId: invitation.id };
735:   }
