29:   },
30: });
31: const minimalPdf = Buffer.from('%PDF-1.1\n1 0 obj<<>>endobj\ntrailer<<>>\n%%EOF\n', 'utf-8');
32: async function run() {
33:   const randomId = crypto.randomBytes(8).toString('hex');
34:   const key = `smoke-test/s3-test-${randomId}.pdf`;
35:   console.log(`Starting S3 smoke test bucket='${bucket}' region='${region}' key='${key}'`);
36:   try {
37:     console.log('Uploading...');
38:     const putCommand = new PutObjectCommand({
39:       Bucket: bucket,
40:       Key: key,
41:       Body: minimalPdf,
42:       ContentType: 'application/pdf',
43:       ACL: 'private'
44:     });
45:     await s3.send(putCommand);
