  8:   "/dashboard/team-lead",
  9:   "/dashboard/admin",
 10:   "/profile",
 11:   "/settings",
 12: ];
 13: const authRoutes = ["/login", "/register", "/auth/signin"];
 14: const publicRoutes = [
 15:   "/",
 16:   "/about",
 17:   "/features",
 18:   "/how-it-works",
 19:   "/pricing",
 20:   "/contact",
 21:   "/faq",
 22:   "/terms",
 23:   "/privacy",
 24:   "/papers",
 25:   "/collections",
 26:   "/workspaces",
 27:   "/research",
 28:   "/collaborations",
 29:   "/collaborate",
 30:   "/ai-insights",
 31:   "/products",
 32:   "/about",
 33:   "/contact",
 34:   "/company",
 35: ];
 36: export default withAuth(
 37:   function middleware(request) {
 38:     const { pathname } = request.nextUrl;
 39:     const token = (request as any).nextauth?.token;
 40:     const isAuthenticated = !!token;
 41:     const createRedirect = (url: string) => {
 42:       return NextResponse.redirect(new URL(url, request.url));
 43:     };
 44:     const matchesRoute = (routes: string[], path: string) => {
 45:       return routes.some(
 46:         (route) => path === route || path.startsWith(route + "/")
 47:       );
 48:     };
 49:     if (pathname.startsWith("/api/")) {
 50:       return NextResponse.next();
 51:     }
 52:     if (
 53:       pathname.startsWith("/_next/") ||
 54:       pathname.startsWith("/static/") ||
 55:       pathname.includes(".")
 56:     ) {
 57:       return NextResponse.next();
 58:     }
 59:     const callbackUrl = request.nextUrl.searchParams.get("callbackUrl");
 60:     if (isAuthenticated && matchesRoute(authRoutes, pathname)) {
 61:       if (callbackUrl) {
 62:         console.log(
 63:           `🔄 Authenticated user on auth page, redirecting to callback: ${callbackUrl}`
 64:         );
 65:         return createRedirect(callbackUrl);
 66:       }
 67:       const roleSlug = getRoleSlug((token as any)?.role);
 68:       const dashboardPath = `/dashboard/${roleSlug}`;
 69:       console.log(
 70:         `🔄 Redirecting authenticated user from ${pathname} to ${dashboardPath}`
 71:       );
 72:       return createRedirect(dashboardPath);
 73:     }
 74:     if (!isAuthenticated && matchesRoute(protectedRoutes, pathname)) {
 75:       console.log(
 76:         `⚠️ User appears unauthenticated for ${pathname}, allowing through for client-side check`
 77:       );
 78:       return NextResponse.next();
 79:     }
 80:     if (matchesRoute(publicRoutes, pathname)) {
 81:       return NextResponse.next();
 82:     }
 83:     if (isAuthenticated && pathname.startsWith("/dashboard/")) {
 84:       const segments = pathname.split("/").filter(Boolean);
 85:       if (segments.length > 1) {
 86:         const maybeRoleSlug = segments[1];
 87:         const hasRoleSegment = !!getRoleBySlug(maybeRoleSlug);
 88:         if (!hasRoleSegment) {
 89:           const roleSlug = getRoleSlug((token as any)?.role);
 90:           const newPath = ["/dashboard", roleSlug, ...segments.slice(1)].join(
 91:             "/"
 92:           );
 93:           const redirectUrl = new URL(
 94:             newPath + request.nextUrl.search,
 95:             request.url
 96:           );
 97:           return NextResponse.redirect(redirectUrl);
 98:         }
 99:       }
100:     }
101:     if (pathname === "/") {
102:       if (isAuthenticated) {
103:         return NextResponse.next();
104:       }
105:       return NextResponse.next();
106:     }
107:     return NextResponse.next();
108:   },
109:   {
110:     callbacks: {
111:       authorized: ({ token, req }) => {
112:         const { pathname } = req.nextUrl;
113:         if (
114:           matchesRoute(publicRoutes, pathname) ||
115:           matchesRoute(authRoutes, pathname) ||
116:           pathname.startsWith("/api/") ||
117:           pathname.startsWith("/_next/") ||
118:           pathname.startsWith("/static/") ||
119:           pathname.includes(".")
120:         ) {
121:           return true;
122:         }
123:         if (matchesRoute(protectedRoutes, pathname)) {
124:           if (!token) {
125:             console.log(
126:               `⚠️ No token in middleware for ${pathname}, allowing through for client-side check`
127:             );
128:           }
129:           return true;
130:         }
131:         return true;
132:       },
133:     },
134:     pages: {
135:       signIn: "/login",
136:     },
137:   }
138: );
139: function matchesRoute(routes: string[], path: string): boolean {
140:   return routes.some((route) => path === route || path.startsWith(route + "/"));
141: }
142: export const config = {
143:   matcher: [
144:     "/((?!api|_next/static|_next/image|favicon.ico|.*\\..*$).*)",
145:   ],
146: };
</file>

