# Socket Server Configuration
# Copy this to .env and fill in your values

PORT=5001

# Must match the NEXTAUTH_SECRET used by the backend to sign access tokens
# (apps/backend/src/app/middleware/auth.ts). JWT_SECRET is a different key —
# do NOT use it here.
# The server loads this .env automatically in development (process.loadEnvFile);
# on Render the platform environment variables take precedence.
NEXTAUTH_SECRET="your-secret-here"

# Frontend URL for CORS (comma-separated if multiple origins)
FRONTEND_URL="http://localhost:3000"
